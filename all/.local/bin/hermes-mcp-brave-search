#!/usr/bin/env bash
# Hermes - Brave Search
# Hermes Agent uses wrapper scripts that source =~/.env= for secrets, since the
# MCP subprocess environment is filtered. This wrapper is referenced from
# ~/.hermes/config.yaml under =mcp_servers.brave-search=.


# [[file:../../../mcp.org::*Hermes - Brave Search][Hermes - Brave Search:1]]
# ~/DotCortex/all/.local/bin/hermes-mcp-brave-search
set -euo pipefail

if [ -r "$HOME/.env" ]; then
  # shellcheck source=/dev/null
  . "$HOME/.env"
fi

: "${BRAVE_API_KEY:?BRAVE_API_KEY must be set in \$HOME/.env}"

if ! command -v npx >/dev/null 2>&1; then
  echo "hermes-mcp-brave-search: npx not found in PATH." >&2
  exit 1
fi

export BRAVE_API_KEY

exec npx -y @brave/brave-search-mcp-server --transport stdio
# Hermes - Brave Search:1 ends here
