#!/usr/bin/env bash
# Hermes - GenOffice
# GenOffice (Office documents: docx, xlsx, pptx, pdf read) as a stdio MCP server for Hermes. The binary is the
# pinned AppImage from =app.org= (row =genoffice=). The wrapper extracts it once per pinned hash and runs the
# bundled CLI headless on the app's own Node runtime, so it needs neither FUSE nor a display for the data tools; the render and pdf tools get a private virtual display from =xvfb-run=.

# - File access is limited with =GENOFFICE_ALLOWED_ROOTS= to the folders Aura works in. Without it the server reads
#   anything the gateway user can. The roots include the Secret Vault on purpose: the operator's chats must be able to
#   convert clinical documents. Mètsàtron's lanes are kept out of it by R2D2's =vault_block=, which since
#   2026-11-10 also inspects the arguments of =mcp__*= tools (test: =test-r2d2-vault-mcp.py=).
# - The audit log records the paths the server touches, which can be clinical file names. It lives in a 0700
#   directory under =~/.local/state= and nowhere world-readable.
# - =GENOFFICE_HOME= points at a private state directory so the server never creates or reads an app profile under
#   the real home. =search=, =image= and =media= are the only tools that call out to the internet; the Hermes
#   =tools.include= list in =~/.hermes/config.yaml= leaves them out.


# [[file:../../../agents-mcp.org::*Hermes - GenOffice][Hermes - GenOffice:1]]
# ~/DotCortex/all/.local/bin/genoffice-mcp
set -euo pipefail
umask 077

APPIMAGE="${GENOFFICE_APPIMAGE:-$HOME/.local/bin/genoffice}"
STATE="$HOME/.local/state/genoffice"
SHARE="$HOME/.local/share/genoffice"

[ -x "$APPIMAGE" ] || { echo "genoffice-mcp: $APPIMAGE missing (run: APP_ONLY=genoffice app-apply)" >&2; exit 1; }

# One extraction per AppImage content hash; a new pin extracts beside the old one.
HASH="$(sha256sum "$APPIMAGE" | cut -c1-16)"
ROOT="$SHARE/$HASH"
if [ ! -x "$ROOT/squashfs-root/resources/cli/genoffice" ]; then
  mkdir -p "$SHARE"
  TMP="$(mktemp -d "$SHARE/.extract.XXXXXX")"
  trap 'rm -rf "$TMP"' EXIT
  ( cd "$TMP" && "$APPIMAGE" --appimage-extract >/dev/null 2>&1 )
  [ -x "$TMP/squashfs-root/resources/cli/genoffice" ] || { echo "genoffice-mcp: extract failed" >&2; exit 1; }
  mv "$TMP" "$ROOT"
  trap - EXIT
fi

mkdir -p "$STATE"
chmod 700 "$STATE"

export GENOFFICE_HOME="$STATE/home"
export GENOFFICE_AUTH_DIR="$STATE/home"
export GENOFFICE_AUDIT_LOG="$STATE/audit.jsonl"
mkdir -p "$GENOFFICE_HOME"
export GENOFFICE_ALLOWED_ROOTS="${GENOFFICE_ALLOWED_ROOTS:-$HOME/Secret Vault:$HOME/Obsidian Vault:$HOME/HEEA:$HOME/Documents:$HOME/Downloads:$HOME/.hermes/cache:$HOME/.hermes/image_cache:/tmp}"

# render, convert-to-pdf and create_pdf start a hidden Electron instance that needs an X display. The gateway has
# none, so borrow a private virtual one (xvfb package, package-nala-honey.org) unless a real DISPLAY exists.
if [ -z "${DISPLAY:-}" ] && command -v xvfb-run >/dev/null 2>&1; then
  exec xvfb-run -a --server-args="-screen 0 1280x1024x24 -nolisten tcp" \
    "$ROOT/squashfs-root/resources/cli/genoffice" mcp "$@"
fi
exec "$ROOT/squashfs-root/resources/cli/genoffice" mcp "$@"
# Hermes - GenOffice:1 ends here
