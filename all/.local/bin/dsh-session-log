#!/usr/bin/env python3
# DSH Session Log Redactor

# The managed redactor that =telegram-agent-host= pipes the detached harness
# stdout through.


# [[file:../../../agents-bots.org::*DSH Session Log Redactor][DSH Session Log Redactor:1]]
"""Redact a DeepSeek Harness log stream, and keep its one-time web URL.

The harness prints `dsh web: http://host:port/?token=...` exactly once per start, and that
token is the only way a browser can obtain its `dsh-auth-*` cookie. The log must not carry
the token; the operator still needs the URL. So the stream is split here: redacted lines go
to the log, the launch URL goes to a private file owned by the operator.

    dsh --profile <p> | dsh-session-log <log-file> <url-file>
"""

from __future__ import annotations

import os
import re
import sys

REDACTIONS = (
    (re.compile(r"bot[0-9]{8,}:[A-Za-z0-9_-]{30,}"), "bot[REDACTED]"),
    (re.compile(r"chatId=-?[0-9]+"), "chatId=[REDACTED]"),
    (re.compile(r"bar-sync\(-?[0-9]+\)"), "bar-sync([REDACTED])"),
    (re.compile(r"([?&]token=)[A-Za-z0-9_-]+"), r"\1[REDACTED]"),
)
URL = re.compile(r"https?://[^\s]*?[?&]token=[A-Za-z0-9_-]+")


def _open_url_file(url_path: str) -> str:
    """Create the URL file private, wherever the seat can actually write.

    The launcher's state directory belongs to the operator while the harness runs as its own
    uid, so a write there raises EACCES and the URL would be lost. Fall back to the seat's
    own state directory; the operator reads it with privilege when they need it.
    """
    candidates = [url_path]
    home = os.environ.get("HOME")
    if home:
        candidates.append(os.path.join(home, ".local", "state", "dsh-web-url"))
    last: Exception | None = None
    for path in candidates:
        if not path:
            continue
        try:
            directory = os.path.dirname(path)
            if directory:
                os.makedirs(directory, exist_ok=True)
            fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            os.fchmod(fd, 0o600)
            os.close(fd)
            return path
        except OSError as error:
            last = error
    raise SystemExit(f"dsh-session-log: no writable url file ({last})")


def main(argv: list[str]) -> int:
    if len(argv) != 3:
        print("usage: dsh-session-log <log-file> <url-file>", file=sys.stderr)
        return 2
    log_path = argv[1]
    url_path = _open_url_file(argv[2])

    with open(log_path, "a", encoding="utf-8", errors="replace") as log:
        for raw in sys.stdin:
            match = URL.search(raw)
            if match:
                with open(url_path, "w", encoding="utf-8") as handle:
                    handle.write(match.group(0) + "\n")
            line = raw
            for pattern, replacement in REDACTIONS:
                line = pattern.sub(replacement, line)
            log.write(line)
            log.flush()
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
# DSH Session Log Redactor:1 ends here
