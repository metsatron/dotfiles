#!/usr/bin/env bash
set -euo pipefail

APPLY=0
TARGET_USER="${OPENCODE_CONTINUITY_USER:-agent-opencode}"
SOURCE="${OPENCODE_CONTINUITY_SOURCE:-}"

usage() {
    cat <<'EOF'
Usage: opencode-continuity-policy-install --source FILE [--apply]

Install one rendered private continuity policy into the target agent home.
Dry-run is the default. The source file must contain the exact allowlisted
OPENCODE_WARM_* names and no unresolved YOUR_* placeholders.
EOF
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --apply) APPLY=1 ;;
        --source) shift; SOURCE="${1:-}" ;;
        --user) shift; TARGET_USER="${1:-}" ;;
        -h|--help) usage; exit 0 ;;
        *) usage >&2; exit 2 ;;
    esac
    shift
done

[ -n "$SOURCE" ] && [ -r "$SOURCE" ] || {
    echo "continuity policy source is unreadable" >&2
    exit 1
}
id "$TARGET_USER" >/dev/null 2>&1 || {
    echo "continuity policy target user is missing" >&2
    exit 1
}

declare -A seen=()
while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    [ -z "$line" ] && continue
    case "$line" in \#*) continue ;; esac
    case "$line" in *=*) ;; *) echo "continuity policy line is invalid" >&2; exit 1 ;; esac
    key="${line%%=*}"
    value="${line#*=}"
    case "$key" in
        OPENCODE_WARM_POLICY_HELPER|OPENCODE_WARM_POLICY_ROOT|OPENCODE_WARM_POLICY_AUTHORITY_IDENTITY|\
        OPENCODE_WARM_POLICY_TELEMETRY_HOST|OPENCODE_WARM_POLICY_PROVIDER|OPENCODE_WARM_POLICY_ACCOUNT_HASH|\
        OPENCODE_WARM_POLICY_MODEL_POOL|OPENCODE_WARM_POLICY_ESTIMATED_PRESERVATION_PERCENT|\
        OPENCODE_WARM_POLICY_ESTIMATE_UNCERTAINTY_PERCENT|OPENCODE_WARM_POLICY_IN_FLIGHT_RESERVE_PERCENT|\
        OPENCODE_WARM_POLICY_CONTROL_RESERVE_PERCENT|OPENCODE_WARM_POLICY_SAFETY_MARGIN_SECONDS|\
        OPENCODE_WARM_CACHE_TTL_SECONDS|OPENCODE_WARM_NUDGE_SCHEDULER|OPENCODE_WARM_WAKEUP_ADAPTER|\
        OPENCODE_WARM_NUDGE_DELAY_SECONDS|OPENCODE_WARM_NUDGE_EXPIRY_SECONDS|OPENCODE_WARM_NUDGE_TIMEZONE)
            [ -n "$value" ] || { echo "continuity policy value is empty" >&2; exit 1; }
            case "$value" in YOUR_*) echo "continuity policy has unresolved placeholder" >&2; exit 1 ;; esac
            [ -z "${seen[$key]+x}" ] || { echo "continuity policy key is duplicated" >&2; exit 1; }
            seen["$key"]=1
            ;;
        *) echo "continuity policy key is not allowlisted" >&2; exit 1 ;;
    esac
done < "$SOURCE"

for key in \
    OPENCODE_WARM_POLICY_HELPER OPENCODE_WARM_POLICY_ROOT OPENCODE_WARM_POLICY_AUTHORITY_IDENTITY \
    OPENCODE_WARM_POLICY_TELEMETRY_HOST OPENCODE_WARM_POLICY_PROVIDER OPENCODE_WARM_POLICY_ACCOUNT_HASH \
    OPENCODE_WARM_POLICY_MODEL_POOL OPENCODE_WARM_POLICY_ESTIMATED_PRESERVATION_PERCENT \
    OPENCODE_WARM_POLICY_ESTIMATE_UNCERTAINTY_PERCENT OPENCODE_WARM_POLICY_IN_FLIGHT_RESERVE_PERCENT \
    OPENCODE_WARM_POLICY_CONTROL_RESERVE_PERCENT OPENCODE_WARM_POLICY_SAFETY_MARGIN_SECONDS \
    OPENCODE_WARM_CACHE_TTL_SECONDS OPENCODE_WARM_NUDGE_SCHEDULER OPENCODE_WARM_WAKEUP_ADAPTER \
    OPENCODE_WARM_NUDGE_DELAY_SECONDS OPENCODE_WARM_NUDGE_EXPIRY_SECONDS OPENCODE_WARM_NUDGE_TIMEZONE; do
    [ -n "${seen[$key]+x}" ] || { echo "continuity policy key is missing" >&2; exit 1; }
done

target_home="$(getent passwd "$TARGET_USER" | cut -d: -f6)"
target_group="$(id -gn "$TARGET_USER")"
destination="$target_home/.config/opencode-continuity/policy.env"
if [ "$APPLY" -eq 0 ]; then
    printf 'DRY-RUN: install policy for %s at %s\n' "$TARGET_USER" "$destination"
    exit 0
fi

sudo -n install -d -o "$TARGET_USER" -g "$target_group" -m 700 "$(dirname "$destination")"
sudo -n install -o "$TARGET_USER" -g "$target_group" -m 600 "$SOURCE" "$destination"
printf 'installed continuity policy for %s\n' "$TARGET_USER"
