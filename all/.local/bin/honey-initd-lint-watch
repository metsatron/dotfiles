#!/usr/bin/env bash
# honey-initd-lint-watch (generated by agents-bots-honey.org): run honey-initd-lint when an init script or its conf.d changed, when the lint itself changed,
# and at least once a day. Cheap enough to run from cron every few minutes: it hashes /etc/init.d and /etc/conf.d (a few hundred small files) and stops
# there when nothing moved. Read-only on the system: it writes only under its own state directory.
#   state: ${HONEY_INITD_LINT_STATE:-~/.local/state/honey-initd-lint}/{status,last.txt,last.json,history.log,sig}
#   status is ONE line: "<iso time> rc=<0|1|2> fault=<n> unparsed=<n> scanned=<n> faulting=<names>"; rc=1 means a proven fault, nothing else does.
# Alerting is opt-in and OFF: set HONEY_INITD_LINT_ALERT to a command that takes one message argument and it is called when the SET of faulting
# scripts changes (a new fault, or one cleared), never on a repeat run.
# Usage: honey-initd-lint-watch [--force] [--max-age SECONDS]    (exit status = the last lint run's: 0 clean, 1 proven fault, 2 could not run)
set -uo pipefail
HERE="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
LINT="${HONEY_INITD_LINT:-$HERE/honey-initd-lint}"
DIR="${HONEY_INITD_DIR:-/etc/init.d}"; CONFD="${HONEY_INITD_CONFD:-/etc/conf.d}"
STATE="${HONEY_INITD_LINT_STATE:-$HOME/.local/state/honey-initd-lint}"
MAX_AGE=86400; FORCE=0
while [ $# -gt 0 ]; do case "$1" in
  --force) FORCE=1;; --max-age) MAX_AGE="$2"; shift;; -h|--help) sed -n '2,12p' "$0"; exit 0;;
  *) echo "honey-initd-lint-watch: unknown option $1" >&2; exit 2;; esac; shift; done
[ -f "$LINT" ] || { echo "honey-initd-lint-watch: lint not found: $LINT" >&2; exit 2; }
mkdir -p "$STATE" || exit 2
exec 9>"$STATE/lock"; flock -n 9 || exit 0   # a run is already in progress
sig="$( { find "$DIR" "$CONFD" -maxdepth 1 -type f -print0 2>/dev/null | sort -z | xargs -0 -r sha256sum; sha256sum "$LINT"; } | sha256sum | cut -d' ' -f1)"
last_sig="$(cat "$STATE/sig" 2>/dev/null || true)"
now="$(date +%s)"; last_run="$(stat -c %Y "$STATE/status" 2>/dev/null || echo 0)"
if [ "$FORCE" = 0 ] && [ "$sig" = "$last_sig" ] && [ $((now - last_run)) -lt "$MAX_AGE" ]; then
  rc="$(sed -n 's/^[^ ]* rc=\([0-9]\).*/\1/p' "$STATE/status" 2>/dev/null | head -1)"; exit "${rc:-0}"
fi
prev_faulting="$(sed -n 's/.* faulting=//p' "$STATE/status" 2>/dev/null | head -1)"
python3 -I "$LINT" --dir "$DIR" --confd "$CONFD" > "$STATE/last.txt.new" 2>&1; rc=$?
python3 -I "$LINT" --dir "$DIR" --confd "$CONFD" --json > "$STATE/last.json.new" 2>/dev/null
mv -f "$STATE/last.txt.new" "$STATE/last.txt"; mv -f "$STATE/last.json.new" "$STATE/last.json"
summary="$(grep '^SUMMARY ' "$STATE/last.txt" | tail -1)"
num() { printf '%s\n' "$summary" | tr ' ' '\n' | sed -n "s/^$1=//p" | head -1; }
faulting="$(grep '^FAULT ' "$STATE/last.txt" | grep -v '^FAULT (inactive copy)' | sed 's|^FAULT [^ ]*/\([^/:]*\):.*|\1|' | sort -u | paste -sd, -)"
line="$(date -Is) rc=$rc fault=$(num fault) unparsed=$(num unparsed) scanned=$(num scanned) faulting=${faulting:-none}"
echo "$line" > "$STATE/status"; echo "$line" >> "$STATE/history.log"; echo "$sig" > "$STATE/sig"
if [ -n "${HONEY_INITD_LINT_ALERT:-}" ] && [ "${faulting:-none}" != "${prev_faulting:-none}" ]; then
  "$HONEY_INITD_LINT_ALERT" "honey-initd-lint: faulting init scripts changed: ${prev_faulting:-none} -> ${faulting:-none}" >/dev/null 2>&1 || true
fi
exit "$rc"
