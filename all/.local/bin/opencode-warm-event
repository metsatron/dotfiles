#!/usr/bin/env python3
"""Bridge one native OpenCode lifecycle event into the bounded controller."""

from __future__ import annotations

import argparse
from pathlib import Path
import subprocess
import sys


def invoke(binary: Path, session: str, event: str, observed_at: float, prepare: bool = False) -> int:
    command = [
        str(binary), "--session", session, "--event", event,
        "--observed-at", str(observed_at),
    ]
    if prepare:
        command.append("--prepare-only")
    completed = subprocess.run(command, text=True, capture_output=True, timeout=20, check=False)
    if completed.stdout:
        sys.stdout.write(completed.stdout)
    if completed.stderr:
        sys.stderr.write(completed.stderr)
    return completed.returncode


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--session", required=True)
    parser.add_argument("--event", required=True, choices=("session.idle", "session.compacted"))
    parser.add_argument("--observed-at", required=True, type=float)
    args = parser.parse_args()
    binary = Path(__file__).with_name("opencode-warm")
    if args.event == "session.idle":
        prepared = invoke(binary, args.session, args.event, args.observed_at, prepare=True)
        if prepared != 0:
            return prepared
    return invoke(binary, args.session, args.event, args.observed_at)


if __name__ == "__main__":
    raise SystemExit(main())
