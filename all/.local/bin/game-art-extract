#!/usr/bin/env python3
"""Extract icon art from Doom WADs and Quake PAKs, at native size.

  game-art-extract list <file> [substring]
  game-art-extract get  <file> <lump> <out.png>

The container format is sniffed from the file's magic, not its extension —
a Quake PAK named .wad would otherwise be decoded as a Doom WAD and emit
garbage rather than an error.
"""
from __future__ import annotations

import struct
import sys
from pathlib import Path

from PIL import Image


def _u32(b: bytes, o: int) -> int:
    return struct.unpack_from("<i", b, o)[0]


def _name(raw: bytes) -> str:
    return raw.split(b"\0")[0].decode("ascii", "replace")


# --------------------------------------------------------------------- Doom

def doom_dir(b: bytes) -> tuple[dict, list]:
    _, count, table = struct.unpack_from("<4sii", b, 0)
    lumps, order = {}, []
    for i in range(count):
        pos, size, raw = struct.unpack_from("<ii8s", b, table + i * 16)
        n = _name(raw)
        lumps[n] = (pos, size)  # a later lump of the same name wins, as in-engine
        order.append(n)
    return lumps, order


def doom_palette(b: bytes, lumps: dict) -> list:
    pos, _ = lumps["PLAYPAL"]
    return [tuple(b[pos + i * 3: pos + i * 3 + 3]) for i in range(256)]


def doom_pic(b: bytes, pos: int, pal: list) -> Image.Image:
    w, h, _lo, _to = struct.unpack_from("<hhhh", b, pos)
    if not (0 < w <= 4096 and 0 < h <= 4096):
        raise SystemExit("not a Doom picture lump (bad dimensions)")
    cols = struct.unpack_from(f"<{w}i", b, pos + 8)
    img = Image.new("RGBA", (w, h), (0, 0, 0, 0))
    px = img.load()
    for x in range(w):
        p = pos + cols[x]
        while b[p] != 0xFF:                 # 0xFF topdelta terminates the column
            top, length = b[p], b[p + 1]
            p += 3                          # topdelta, length, and ONE pad byte
            for i in range(length):
                y = top + i
                if 0 <= y < h:
                    px[x, y] = (*pal[b[p + i]], 255)
            p += length + 1                 # pixels, then the trailing pad byte
    return img


# -------------------------------------------------------------------- Quake

def pak_dir(b: bytes) -> dict:
    _, table, length = struct.unpack_from("<4sii", b, 0)
    out = {}
    for i in range(length // 64):
        raw, pos, size = struct.unpack_from("<56sii", b, table + i * 64)
        out[_name(raw)] = (pos, size)
    return out


def wad2_dir(b: bytes, base: int) -> dict:
    _, count, table = struct.unpack_from("<4sii", b, base)
    out = {}
    for i in range(count):
        p = base + table + i * 32
        pos, _dsz, _msz, _typ, _cmp, _pad, raw = struct.unpack_from("<iiiBBh16s", b, p)
        out[_name(raw).lower()] = base + pos
    return out


def quake_index(b: bytes) -> tuple[dict, list, dict]:
    """Return (pak entries, palette, gfx.wad lumps) — the art lives in both."""
    pak = pak_dir(b)
    pos, _ = pak["gfx/palette.lmp"]
    pal = [tuple(b[pos + i * 3: pos + i * 3 + 3]) for i in range(256)]
    gfx = wad2_dir(b, pak["gfx.wad"][0]) if "gfx.wad" in pak else {}
    return pak, pal, gfx


def quake_pic(b: bytes, pos: int, pal: list) -> Image.Image:
    w, h = struct.unpack_from("<ii", b, pos)
    if not (0 < w <= 4096 and 0 < h <= 4096):
        raise SystemExit("not a Quake picture lump (bad dimensions)")
    data = b[pos + 8: pos + 8 + w * h]
    img = Image.new("RGBA", (w, h))
    img.putdata([(*pal[c], 0 if c == 255 else 255) for c in data])
    return img


# ---------------------------------------------------------------------- CLI

def main(argv: list[str]) -> int:
    if len(argv) < 3:
        print(__doc__, file=sys.stderr)
        return 2
    verb, path = argv[1], Path(argv[2])
    b = path.read_bytes()
    magic = b[:4]

    if magic in (b"IWAD", b"PWAD"):
        lumps, order = doom_dir(b)
        if verb == "list":
            pat = (argv[3] if len(argv) > 3 else "").upper()
            print("\n".join(n for n in order if pat in n))
            return 0
        pal = doom_palette(b, lumps)
        lump = argv[3]
        if lump not in lumps:
            raise SystemExit(f"no such lump: {lump}")
        img = doom_pic(b, lumps[lump][0], pal)

    elif magic == b"PACK":
        pak, pal, gfx = quake_index(b)
        if verb == "list":
            pat = (argv[3] if len(argv) > 3 else "").lower()
            names = [n for n in pak if pat in n.lower()]
            names += [f"gfx.wad:{n}" for n in gfx if pat in n]
            print("\n".join(sorted(names)))
            return 0
        lump = argv[3]
        if lump.startswith("gfx.wad:"):
            key = lump.split(":", 1)[1].lower()
            if key not in gfx:
                raise SystemExit(f"no such gfx.wad lump: {key}")
            img = quake_pic(b, gfx[key], pal)
        else:
            if lump not in pak:
                raise SystemExit(f"no such PAK entry: {lump}")
            img = quake_pic(b, pak[lump][0], pal)

    else:
        raise SystemExit(f"unrecognised container magic: {magic!r}")

    out = Path(argv[4])
    out.parent.mkdir(parents=True, exist_ok=True)
    img.save(out)
    print(f"{lump}  {img.width}x{img.height}  ->  {out}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
