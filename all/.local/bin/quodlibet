#!/usr/bin/env bash
# quodlibet — system player fenced from Guix GStreamer (sealed 2026-08-17)

# The Debian =quodlibet= on the T480s kept blacklisting =id3demux= (and the whole plugin roster, one crash at a time): the desktop session exports =GST_PLUGIN_SYSTEM_PATH= pointing at the Guix core profile's gstreamer plugins (the Guix profile sourcing emits it whenever gstreamer is in the profile), so the SYSTEM libgstreamer scans GUIX-built plugins, the ABI mismatch crashes the scan, and GStreamer permanently blacklists each crashed filename in its registry cache — surfacing as "No GStreamer element found: ID3 tag demuxer" the moment a freshly-tagged song leads with an ID3v2 header. Clearing =~/.cache/gstreamer-1.0/registry.x86_64.bin= heals it for exactly one launch; the next desktop-launched scan re-poisons it. The fence: a PATH wrapper (=~/.local/bin= precedes =/usr/bin=) that strips the Guix GST paths and gives the system player its own registry file, plus a local =.desktop= override so menu launches resolve through the wrapper too. Guix apps keep their own GST world untouched.


# [[file:../../../tools.org::*quodlibet — system player fenced from Guix GStreamer (sealed 2026-08-17)][quodlibet — system player fenced from Guix GStreamer (sealed 2026-08-17):1]]
# ~/DotCortex/all/.local/bin/quodlibet
# Fence the SYSTEM quodlibet from the session's Guix GStreamer paths: the
# ABI mismatch crashes plugin scans and blacklists plugins (id3demux et al)
# in the shared registry. Own registry file so the two worlds never share
# cache state.
[ -x /usr/bin/quodlibet ] || { echo "quodlibet wrapper: no /usr/bin/quodlibet on this machine" >&2; exit 127; }
exec env -u GST_PLUGIN_SYSTEM_PATH -u GST_PLUGIN_PATH \
  GST_REGISTRY="$HOME/.cache/gstreamer-1.0/registry.system-ql.bin" \
  /usr/bin/quodlibet "$@"
# quodlibet — system player fenced from Guix GStreamer (sealed 2026-08-17):1 ends here
