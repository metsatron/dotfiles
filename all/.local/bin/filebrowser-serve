#!/usr/bin/env bash
# Launcher: filebrowser-serve

# Mirrors herdr-web-tailnet: derives nothing from source, binds loopback, no secrets. No =--autostart= loop here — supervision is owned by the cron contract (below), the launcher is a plain foreground =exec= for the supervisor to own.


# [[file:../../../app.org::*Launcher: filebrowser-serve][Launcher: filebrowser-serve:1]]
# ~/DotCortex/all/.local/bin/filebrowser-serve
set -euo pipefail

# FileBrowser Quantum foreground launcher: loopback-bind only, config from
# the machine-local config dir. The tailnet Caddy TLS front is the sole
# external listener; this process never binds a tailnet or LAN address.

port="${FILEBROWSER_PORT:-9090}"
config_dir="${FILEBROWSER_CONFIG:-$HOME/.config/filebrowser}"
bin="${FILEBROWSER_BIN:-$HOME/.local/bin/filebrowser}"

[ -x "$bin" ] || { echo "filebrowser-serve: missing $bin (run app-apply)" >&2; exit 1; }
[ -f "$config_dir/config.yaml" ] || { echo "filebrowser-serve: missing $config_dir/config.yaml (machine-local template in DotCortex app.org)" >&2; exit 1; }

echo "filebrowser-serve: serving 127.0.0.1:$port (loopback; Caddy TLS front is the tailnet listener)"
exec "$bin" --config "$config_dir/config.yaml"
# Launcher: filebrowser-serve:1 ends here
