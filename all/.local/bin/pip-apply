#!/usr/bin/env bash
# Apply manifest

# [[file:../../../package-pip.org::*Apply manifest][Apply manifest:1]]
# ~/DotCortex/all/.local/bin/pip-apply
set -euo pipefail

# Keep Make's historical no-argument apply behavior while sharing Loom's gate.
# Resolve beside this script so a stowed helper uses its owning checkout.
script_dir="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
exec python3 "$script_dir/dotcortex-deps" pip-apply --apply "$@"
# Apply manifest:1 ends here
