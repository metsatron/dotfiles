#!/usr/bin/env bash
# Scrub broken .desktop entries and refresh caches
# Targets the exact failure you showed ("Exec program … not been found on the PATH"), and also:

# - trashes entries whose =Exec= is an absolute path that no longer exists
# - trashes entries whose =Exec= binary name isn't on PATH
# - uses =gio trash= if available, otherwise =rm -f=
# - refreshes desktop caches at the end


# [[file:../../../appimage.org::*Scrub broken .desktop entries and refresh caches][Scrub broken .desktop entries and refresh caches:1]]
set -Eeuo pipefail

APPS="${APPS:-$HOME/Applications}"
DESK_DIR="$HOME/.local/share/applications"

echo "== scrubbing $DESK_DIR/*.desktop =="

chmod -f +x "$APPS"/*.AppImage 2>/dev/null || true
# Skip symlinks: they are stow links into ~/DotCortex, and chmod would follow
# them and dirty the tracked source. See the same guard in appimage-update.
find "$DESK_DIR" -maxdepth 1 -type f -name '*.desktop' -exec chmod +x {} + 2>/dev/null || true

shopt -s nullglob
for f in "$DESK_DIR"/*.desktop; do
    # NEVER trash a symlink: it is a stow link into ~/DotCortex, i.e. a launcher
    # this repo *declares*. A missing Exec on THIS machine means the binary is
    # not installed here — a per-host fact, not a broken entry. Trashing it
    # deletes the deployed launcher, the next stow puts it straight back, and the
    # sweep quietly fights the repo forever. It ate cool-retro-term and
    # jellyfin-toggle on T480s (2026-07-10) and again on T480 (2026-07-14).
    # This scrub exists for the orphaned entries appimaged itself writes; those
    # are real files, and only those are ours to remove.
    if [[ -L "$f" ]]; then
        continue
    fi
    exec_line="$(awk -F= '/^Exec=/{print $2; exit}' "$f")"
    if [[ -n "$exec_line" && "$exec_line" == /* ]]; then
        exe="${exec_line%% *}"
        if [[ ! -e "$exe" ]]; then
            echo "trash: $f [missing absolute Exec: $exe]"
            gio trash "$f" 2>/dev/null || rm -f -- "$f"
        fi
    fi
done
shopt -u nullglob

update-desktop-database "$DESK_DIR" >/dev/null 2>&1 || true
update-mime-database "$HOME/.local/share/mime" >/dev/null 2>&1 || true
echo "== done =="
# Scrub broken .desktop entries and refresh caches:1 ends here
