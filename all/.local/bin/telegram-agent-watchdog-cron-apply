#!/usr/bin/env bash
set -euo pipefail

TAG="telegram-agent-watchdog-cron-apply"
TARGET="/etc/cron.d/dotcortex-telegram-agent-watchdog"
EXPECTED_HOST=""
DRY=0
REMOVE=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --host) [ "$#" -ge 2 ] || { echo "$TAG: --host requires a value" >&2; exit 2; }; EXPECTED_HOST="$2"; shift ;;
    --dry-run) DRY=1 ;;
    --remove) REMOVE=1 ;;
    -h|--help|help) echo "Usage: $TAG --host EXACT_HOST [--dry-run] [--remove]"; exit 0 ;;
    *) echo "$TAG: unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done

run_priv() { if [ "$(id -u)" = 0 ]; then "$@"; else sudo -n "$@"; fi; }

if [ "$REMOVE" = 1 ]; then
  if [ "$DRY" = 1 ]; then echo "remove $TARGET"; else run_priv rm -f "$TARGET"; echo "$TAG: removed $TARGET"; fi
  exit 0
fi

[ -n "$EXPECTED_HOST" ] || { echo "$TAG: --host EXACT_HOST is required" >&2; exit 2; }
[ "$(hostname)" = "$EXPECTED_HOST" ] || { echo "$TAG: refusing installation on $(hostname); expected $EXPECTED_HOST" >&2; exit 1; }

USER_NAME="$(id -un)"
TARGET_HOME="$HOME"
WATCHDOG="$TARGET_HOME/.local/bin/telegram-agent-watchdog"
[ "$DRY" = 1 ] || [ -x "$WATCHDOG" ] || { echo "$TAG: missing $WATCHDOG; tangle and stow first" >&2; exit 1; }

TMP="$(mktemp)"
trap 'rm -f "$TMP"' EXIT
cat >"$TMP" <<EOF
# DotCortex Telegram agent watchdog; managed by $TAG.
*/3 * * * * ${USER_NAME} HOME=${TARGET_HOME} PATH=${TARGET_HOME}/.guix-extra-profiles/core/core/bin:${TARGET_HOME}/.local/bin:${TARGET_HOME}/.npm-global/bin:/usr/local/bin:/usr/bin:/bin ${WATCHDOG} --expected-host ${EXPECTED_HOST} >> ${TARGET_HOME}/.local/state/telegram-agent-watchdog/cron.log 2>&1
EOF

if [ "$DRY" = 1 ]; then
  cat "$TMP"
else
  mkdir -p "$TARGET_HOME/.local/state/telegram-agent-watchdog"
  run_priv install -o root -g root -m 0644 "$TMP" "$TARGET"
  echo "$TAG: installed $TARGET"
fi
