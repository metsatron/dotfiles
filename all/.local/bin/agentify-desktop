#!/usr/bin/env bash
# [[file:../../../agents-mcp.org::*Agentify Desktop - browser-session MCP (ChatGPT / Perplexity / more)][Agentify Desktop - browser-session MCP (ChatGPT / Perplexity / more):3]]
# ~/DotCortex/all/.local/bin/agentify-desktop
# Agentify Desktop control center — drives the user's logged-in browser (CDP)
# and serves the loopback HTTP API. Pinned; bump deliberately after smoke test.
set -euo pipefail

PREPARE="${AGENTIFY_DESKTOP_PREPARE:-$HOME/.local/libexec/agentify-desktop-prepare}"
[ -x "$PREPARE" ] || { printf 'agentify-desktop: missing guarded runtime preparer: %s\n' "$PREPARE" >&2; exit 1; }
ENTRYPOINT=$("$PREPARE")
PACKAGE_ROOT="${ENTRYPOINT%/bin/agentify-desktop.mjs}"
ELECTRON_BIN="$(dirname "$(dirname "$PACKAGE_ROOT")")/.bin/electron"
[ -x "$ELECTRON_BIN" ] || { printf 'agentify-desktop: pinned Electron binary missing: %s\n' "$ELECTRON_BIN" >&2; exit 1; }
export AGENTIFY_DESKTOP_ELECTRON_BIN="$ELECTRON_BIN"

exec node "$ENTRYPOINT" "$@"
# Agentify Desktop - browser-session MCP (ChatGPT / Perplexity / more):3 ends here
