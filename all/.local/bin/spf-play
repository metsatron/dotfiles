#!/usr/bin/env bash
# spf-play — play an audio file from superfile's [open_with] in the terminal.
# DotCortex-managed (term.org). Prefers the running MPD daemon; falls back to ffplay.
set -euo pipefail

target="${1:-}"
if [[ -z "${target}" ]]; then
  echo "usage: spf-play <audio-file>" >&2
  exit 2
fi
if [[ ! -f "${target}" ]]; then
  echo "spf-play: not a file: ${target}" >&2
  exit 2
fi

abs="$(readlink -f -- "${target}")"

# MPD's music_directory, as declared in its own config — never hardcoded here.
mpd_conf="${MPD_CONF:-${HOME}/.config/mpd/mpd.conf}"
music_root=""
if [[ -r "${mpd_conf}" ]]; then
  music_root="$(sed -n 's/^[[:space:]]*music_directory[[:space:]]*"\(.*\)".*/\1/p' "${mpd_conf}" | head -n1)"
  # expand a leading ~ without eval
  [[ "${music_root}" == "~"* ]] && music_root="${HOME}${music_root#\~}"
  [[ -n "${music_root}" ]] && music_root="$(readlink -f -- "${music_root}" 2>/dev/null || true)"
fi

# Lane 1 — inside the MPD library and the daemon answers: use the fleet daemon.
# Deliberately append-and-play rather than `mpc clear`: this is invoked from a file
# manager, and silently destroying a queue built in dj-mpd/ncmpcpp would be a nasty
# surprise for a keystroke that only means "play this file".
if [[ -n "${music_root}" && "${abs}" == "${music_root}/"* ]] && command -v mpc >/dev/null 2>&1; then
  if mpc status >/dev/null 2>&1; then
    rel="${abs#"${music_root}/"}"
    if [[ -n "${SPF_PLAY_DRY_RUN:-}" ]]; then
      echo "lane=mpd root=${music_root} rel=${rel}"
      exit 0
    fi
    if mpc add "${rel}" >/dev/null 2>&1; then
      # Play the track just appended, leaving the rest of the queue intact.
      pos="$(mpc playlist | wc -l)"
      mpc play "${pos}" >/dev/null
      exec mpc status
    fi
    echo "spf-play: mpd has no database entry for ${rel} (run 'mpc update'), falling back" >&2
  fi
fi

# Lane 2 — anything else: terminal-only playback, no window, no GUI.
if command -v ffplay >/dev/null 2>&1; then
  if [[ -n "${SPF_PLAY_DRY_RUN:-}" ]]; then
    echo "lane=ffplay file=${abs}"
    exit 0
  fi
  exec ffplay -nodisp -autoexit -hide_banner -loglevel error "${abs}"
fi

echo "spf-play: no terminal audio player available (need mpc+mpd or ffplay)" >&2
exit 127
