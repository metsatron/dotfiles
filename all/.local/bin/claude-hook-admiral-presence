#!/usr/bin/env python3
"""Stamp the Admiral's last prompt activity for the local approval seat."""
import json
import os
from pathlib import Path
import re
import stat
import sys


IDENTITY_KEYS = ('user_id', 'from_user_id', 'sender_id', 'sender_user_id', 'author_id')
CHANNEL_RE = re.compile(r'<channel\b([^>]*)>', re.IGNORECASE)
ATTRIBUTE_RE = re.compile(
    r'\b(?:user_id|from_user_id|sender_id|sender_user_id|author_id|from)\s*=\s*["\']([^"\']+)["\']',
    re.IGNORECASE,
)


def _strings(value):
    if isinstance(value, str):
        return [value]
    if isinstance(value, dict):
        return [item for key in IDENTITY_KEYS if isinstance(item := value.get(key), str)]
    return []


def _is_admiral(payload):
    if not isinstance(payload, dict):
        return False
    event = payload.get('hook_event_name')
    if event is not None and event != 'UserPromptSubmit':
        return False
    prompt = payload.get('prompt') or payload.get('message') or ''
    if not isinstance(prompt, str):
        prompt = ''
    tags = CHANNEL_RE.findall(prompt)
    telegram = str(payload.get('source') or '').casefold() == 'telegram'
    telegram = telegram or any(re.search(r'\bsource\s*=\s*["\'][^"\']*telegram', tag, re.IGNORECASE) for tag in tags)
    if not telegram:
        return True
    expected = os.environ.get('DOTCORTEX_ADMIRAL_TELEGRAM_USER_ID', '')
    if not expected or any(char.isspace() for char in expected):
        return False
    observed = set(_strings(payload))
    for key in ('channel', 'sender', 'from', 'user'):
        observed.update(_strings(payload.get(key)))
    for tag in tags:
        observed.update(ATTRIBUTE_RE.findall(tag))
    return expected in observed


def _stamp():
    path = Path(os.environ.get('DOTCORTEX_ADMIRAL_LAST_SEEN') or
                Path.home() / '.local/state/dotcortex/admiral-last-seen')
    if not path.is_absolute():
        return
    try:
        path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW, 0o600)
        try:
            info = os.fstat(fd)
            if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                    or info.st_nlink != 1):
                return
            os.fchmod(fd, 0o600)
            os.utime(fd, None)
        finally:
            os.close(fd)
    except (OSError, ValueError):
        return


def main():
    try:
        payload = json.load(sys.stdin)
    except (json.JSONDecodeError, OSError, TypeError, ValueError):
        return 0
    if _is_admiral(payload):
        _stamp()
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
