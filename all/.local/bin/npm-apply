#!/usr/bin/env bash
# Apply manifest inside DotCortex env

# [[file:../../../package-npm.org::*Apply manifest inside DotCortex env][Apply manifest inside DotCortex env:1]]
# ~/DotCortex/all/.local/bin/npm-apply
set -euo pipefail

MAN="$HOME/DotCortex/all/.npm/manifest/global.ssv"
RUN="$HOME/DotCortex/all/.local/bin/dotcortex-node-env"

ENFORCE="${ENFORCE:-1}"   # 1 = enforce manifest membership, 0 = installs only
UNINSTALL="${UNINSTALL:-1}"
UPDATE="${UPDATE:-0}"     # 1 = allow upgrades, 0 = leave existing versions alone
ONLY="${ONLY:-}"           # optional exact package name for a bounded apply

# Per-host provisioning gate (package-host-gates.org): a gated host (Honey)
# stops here in dry-run unless PROVISION_APPLY=1, and never uninstalls.
PROVISION_GATE_BIN="$HOME/.local/bin/provision-gate"
[ -x "$PROVISION_GATE_BIN" ] || PROVISION_GATE_BIN="${DOTCORTEX_ROOT:-$HOME/DotCortex}/all/.local/bin/provision-gate"
if [ -x "$PROVISION_GATE_BIN" ]; then
  GATE_MODE="$("$PROVISION_GATE_BIN" mode npm)"
  if [ "$GATE_MODE" != open ]; then
    # A gated host only ever uses its own host lane, never the fleet manifest.
    HOST_MAN="$(dirname "$MAN")/hosts/$("$PROVISION_GATE_BIN" host).ssv"
    if [ ! -f "$HOST_MAN" ]; then
      echo "npm-apply: gated host has no npm host lane ($HOST_MAN): nothing to install, nothing removed"
      exit 0
    fi
  fi
  case "$GATE_MODE" in
    dry-run) echo "npm-apply: gated host, dry-run: host lane $HOST_MAN declares $(awk '!/^[ \t]*#/ && NF' "$HOST_MAN" | wc -l) package(s); nothing installed or removed (PROVISION_APPLY=1 installs missing ones, removals stay refused)"; exit 0 ;;
    additive) UNINSTALL=0; MAN="$HOST_MAN"; echo "npm-apply: gated host, additive only: host lane $HOST_MAN, uninstall of extras disabled" ;;
  esac
fi

echo "== npm apply =="

# Normalize manifest rows to 8 pipe-separated fields, honoring "" as empty.
_emit_norm() {
  awk -v FS='[ \t]+' '
    function dequote(s){ return (s=="\"\"" ? "" : s) }
    $0 ~ /^[ \t]*#/ || NF==0 { next }
    {
      printf "%s|%s|%s|%s|%s|%s|%s|%s\n",
        dequote($1),dequote($2),dequote($3),dequote($4),
        dequote($5),dequote($6),dequote($7),dequote($8)
    }
  ' "$MAN"
}

# Build map of live package versions from npm list -g --depth=0 --json
declare -A live_ver

while IFS=$'\t' read -r name ver; do
  [ -n "${name:-}" ] || continue
  live_ver["$name"]="$ver"
done < <(
  "$RUN" npm list -g --depth=0 --json 2>/dev/null \
    | node -e '
        let raw = "";
        process.stdin.setEncoding("utf8");
        process.stdin.on("data", (chunk) => (raw += chunk));
        process.stdin.on("end", () => {
          const deps = JSON.parse(raw || "{}").dependencies || {};
          for (const name of Object.keys(deps)) {
            const version = deps[name] && deps[name].version ? deps[name].version : "";
            console.log(`${name}\t${version}`);
          }
        });
      ' | LC_ALL=C sort -u
)

# When UPDATE=1, query registry once for all outdated global packages.
# npm outdated exits 1 when packages are outdated, so || true guards pipefail.
declare -A outdated_pkgs
if [ "$UPDATE" = "1" ]; then
  while IFS= read -r name; do
    [ -n "${name:-}" ] || continue
    outdated_pkgs["$name"]=1
  done < <(
    { "$RUN" npm outdated -g --json 2>/dev/null || true; } \
      | node -e '
          let raw = "";
          process.stdin.setEncoding("utf8");
          process.stdin.on("data", (chunk) => (raw += chunk));
          process.stdin.on("end", () => {
            const pkgs = JSON.parse(raw || "{}");
            for (const name of Object.keys(pkgs)) {
              console.log(name);
            }
          });
        ' | LC_ALL=C sort -u
  )
fi

declare -A want_names

# Apply manifest: install / upgrade as needed
while IFS='|' read -r pkg version flags global_flag source registry tarball extra
do
  [ -n "$pkg" ] || continue
  if [ -n "$ONLY" ] && [ "$pkg" != "$ONLY" ]; then
    continue
  fi
  want_names["$pkg"]=1

  installed_ver="${live_ver[$pkg]:-}"

  needs_install=0
  if [ -z "$installed_ver" ]; then
    needs_install=1
  elif [ "$UPDATE" = "1" ]; then
    if [ -n "$version" ] && [ "$version" != "$installed_ver" ]; then
      needs_install=1
    elif [ -z "$version" ] && [ -n "${outdated_pkgs[$pkg]:-}" ]; then
      needs_install=1
    fi
  fi

  if [ "$needs_install" = "1" ]; then
    spec="$pkg"
    if [ -n "$version" ]; then
      spec="$pkg@$version"
    fi

    args=(install -g "$spec")

    # Allow FLAGS column to carry extra npm args, comma-separated.
    if [ -n "$flags" ]; then
      IFS=',' read -ra FF <<<"$flags"
      for f in "${FF[@]}"; do
        [ -n "$f" ] && args+=("$f")
      done
    fi

    "$RUN" npm "${args[@]}"
  fi

  DOTCORTEX_NODE_ENV="$RUN" bash "$HOME/DotCortex/all/.local/bin/npm-postapply" "$pkg" "$extra"
done < <(_emit_norm)

# Optional uninstall of extras
if [ -z "$ONLY" ] && [ "$ENFORCE" = "1" ] && [ "$UNINSTALL" = "1" ]; then
  echo "== uninstall extras =="

  UNINSTALL_LOG="${XDG_STATE_HOME:-$HOME/.local/state}/npm/uninstalled.log"
  mkdir -p "$(dirname "$UNINSTALL_LOG")"

  # Sorted iteration for stable output.
  for pkg in $(printf '%s\n' "${!live_ver[@]}" | sort); do
    if [ -z "${want_names[$pkg]:-}" ]; then
      ver="${live_ver[$pkg]:-unknown}"
      echo "  removing $pkg@$ver"
      printf '%s\t%s@%s\n' "$(date -Iseconds)" "$pkg" "$ver" >> "$UNINSTALL_LOG"
      "$RUN" npm uninstall -g "$pkg" || true
    fi
  done

  echo "  (log: $UNINSTALL_LOG)"
fi

echo "Done."
# Apply manifest inside DotCortex env:1 ends here
