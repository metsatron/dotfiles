#!/usr/bin/env bash
# Remote git safety guard
# Intercepts Bash tool calls that attempt remote git operations without proper precautions.
# Blocks =ssh -A= (agent forwarding) and raw remote =git pull= without dirty-state checks.
# Also blocks raw =git pull --ff-only= on remote machines when =dotcortex-pull= should be used instead.
# Blocks DotCortex stow verbs whose machine target does not match the machine they would run on — the live host for local commands, or the ssh destination for ssh-wrapped commands. Block reasons go to stderr, which is what Claude Code shows the agent on a PreToolUse exit-2.


# [[file:../../../agents-hooks.org::*Remote git safety guard][Remote git safety guard:1]]
# ~/DotCortex/all/.local/bin/claude-hook-pre-tool-use-bash
# PreToolUse hook for Bash — blocks unsafe remote git/stow operations.
# Exit 2 = block the tool call; the reason MUST go to stderr — stdout is
# not shown to the agent on a PreToolUse block.
# No set -euo pipefail: hooks must not abort on grep non-match (exit 1).

input=$(cat)
cmd=$(printf '%s' "$input" | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
    print(d.get('tool_input', {}).get('command', ''))
except Exception:
    pass
" 2>/dev/null) || true

if [ -z "$cmd" ]; then
  exit 0
fi

# ── Icon tree single-writer gate ──────────────────────────────────────────────
# Icon theme payloads are hand-made pixel art, much of it irreplaceable and some
# of it in git submodules where a careless write is easy to miss. On 2026-07-26 a
# `cp -f` onto places/{22,24}/folder-documents.png followed those symlinks and
# destroyed the theme's generic folder.png, and a separate overwrite destroyed
# Chicago95 art that existed nowhere else in the tree. Neither was intended and
# neither was noticed until afterwards.
#
# So: no direct shell mutation of icon trees. icon-theme-inject is the only
# writer, because it is the only thing that refuses to write through a symlink
# and refuses to destroy art with no duplicate elsewhere in the theme. Reads are
# untouched — this gate only fires on commands that mutate.
python3 - "$cmd" <<'ICONEOF'
import re
import shlex
import sys

cmd = sys.argv[1]

ICON_PATH = re.compile(r"(?:share/icons|/\.icons|/\.local/share/icons)/", re.I)
if not ICON_PATH.search(cmd):
    sys.exit(0)

# Sanctioned writers: icon-theme-inject enforces the safety preconditions itself,
# icons-home-sync only mirrors repo -> live roots, the cache tool writes only
# .cache files, and git checkout/restore RESTORES art rather than destroying it.
SANCTIONED = {
    "icon-theme-inject", "icons-home-sync", "gtk-update-icon-cache",
    "icons-capture", "icon-theme-audit",
}
GIT_SAFE = {"checkout", "restore", "stash", "status", "diff", "show", "log",
            "add", "commit", "rev-parse", "ls-files", "submodule"}

MUTATING = {"cp", "mv", "rm", "rmdir", "install", "ln", "truncate", "shred",
            "dd", "tee", "mogrify", "oxipng", "pngquant", "chmod", "chown"}
# Deliberately excludes bash/sh/zsh: their payload is another script this hook
# cannot see, and including them made every test harness look like a write.
INTERPRETERS = {"python", "python3", "perl", "ruby", "node"}

# Write calls, checked against the RAW text so heredoc bodies count. Only
# consulted when the verb is an interpreter AND an icon path is present.
WRITE_CALL = re.compile(
    r"\b(?:open\s*\([^)]*['\"][wa]|\.save\s*\(|write_bytes|write_text"
    r"|shutil\.(?:copy|copy2|copyfile|move)|os\.(?:remove|unlink|rename|rmdir)"
    r"|\.unlink\s*\(|makedirs)"
)


def simple_commands(text):
    """Split into simple commands, honouring quotes, keeping redirect operators.

    shlex with punctuation_chars emits ; & | < > as their own tokens and leaves
    quoted spans intact as single tokens, so a `>` inside "a -> b" never appears
    as an operator. That is the whole reason this is tokenised rather than
    regexed: two false positives on 2026-07-26 came from matching shell syntax
    inside quoted strings.
    """
    lexer = shlex.shlex(text, posix=True, punctuation_chars=True)
    lexer.whitespace_split = True
    try:
        tokens = list(lexer)
    except ValueError:
        return None  # unbalanced quotes / heredoc: caller falls back

    groups, current = [], []
    for tok in tokens:
        if tok in (";", "&&", "||", "|", "&", "\n"):
            groups.append(current)
            current = []
        else:
            current.append(tok)
    groups.append(current)
    return groups


# Shell keywords that precede the real verb. Splitting on `;` leaves a loop body
# starting at `do`, so without this a `for ...; do cp ...; done` writes straight
# through the gate — found by the corpus on 2026-07-26.
SHELL_KEYWORDS = {"do", "then", "else", "elif", "fi", "done", "while", "for",
                  "if", "until", "case", "esac", "in", "{", "}", "(", ")", "!",
                  "select", "function"}


def verb_of(words):
    """First real word, skipping env assignments, prefixes and shell keywords."""
    for i, w in enumerate(words):
        if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*=.*", w):
            continue
        if w in ("sudo", "command", "exec", "nohup", "time", "env"):
            continue
        if w in SHELL_KEYWORDS:
            continue
        return w.rsplit("/", 1)[-1], words[i + 1:]
    return None, []


groups = simple_commands(cmd)
if groups is None:
    # Could not tokenise. Fail SAFE for writes: only block if an obviously
    # mutating verb sits next to an icon path in the raw text.
    if re.search(r"(?:^|[;&|]\s*|\s)(?:cp|mv|rm|install|ln|tee|dd)\s", cmd):
        groups = None
    else:
        sys.exit(0)

reason = None
detail = ""
if groups is not None:
    for words in groups:
        if not words:
            continue
        verb, rest = verb_of(words)
        if verb is None:
            continue

        if verb in SANCTIONED:
            continue
        if verb == "git":
            sub = next((w for w in rest if not w.startswith("-") and w != "-C"), "")
            # `git -C <dir> <sub>`: skip the -C value too
            if rest[:1] == ["-C"] and len(rest) > 2:
                sub = next((w for w in rest[2:] if not w.startswith("-")), "")
            if sub in GIT_SAFE:
                continue

        # Redirections: block only when the TARGET is an icon path.
        for i, w in enumerate(words):
            if w in (">", ">>") and i + 1 < len(words) and ICON_PATH.search(words[i + 1]):
                reason = "output redirection into an icon tree"
                detail = words[i + 1]
                break
        if reason:
            break

        if verb in MUTATING and any(ICON_PATH.search(w) for w in rest):
            reason = f"{verb} targeting an icon tree"
            detail = next(w for w in rest if ICON_PATH.search(w))
            break

        if verb == "sed" and any(w == "-i" or w.startswith("-i") for w in rest) \
           and any(ICON_PATH.search(w) for w in rest):
            reason = "sed -i on an icon tree"
            detail = next(w for w in rest if ICON_PATH.search(w))
            break

        # Interpreter payloads are best-effort only: require a write call and an
        # icon path on the SAME line. "write call somewhere, icon path somewhere"
        # flagged a heredoc writing /tmp while merely mentioning icon paths
        # (2026-07-26). The shell-verb rules above are the real defence; a
        # multi-line interpreter write can still slip past this one.
        if verb in INTERPRETERS:
            hit = next((ln for ln in cmd.splitlines()
                        if WRITE_CALL.search(ln) and ICON_PATH.search(ln)), None)
            if hit:
                reason = "interpreter writing into an icon tree"
                detail = hit.strip()[:80]
                break
else:
    reason = "file mutation command near an icon path (command could not be tokenised)"

if reason is None:
    sys.exit(0)

print("BLOCKED: direct write to an icon theme tree.", file=sys.stderr)
print(f"Detected: {reason}" + (f" -> {detail}" if detail else ""), file=sys.stderr)
print("", file=sys.stderr)
print("Icon payloads are hand-made pixel art and live in git submodules.", file=sys.stderr)
print("Shell copies follow symlinks and overwrite the link's TARGET, and they", file=sys.stderr)
print("destroy art that may exist nowhere else. Both happened on 2026-07-26.", file=sys.stderr)
print("", file=sys.stderr)
print("Use icon-theme-inject. It refuses to write through a symlink and refuses", file=sys.stderr)
print("to overwrite art with no duplicate elsewhere in the theme:", file=sys.stderr)
print("", file=sys.stderr)
print("  icon-theme-inject SRC.png --repo-root ~/DotCortex --themes T \\", file=sys.stderr)
print("      --category places --names NAME [--preserve-as OLDNAME]", file=sys.stderr)
print("  icon-theme-inject x --repo-root ~/DotCortex --themes T \\", file=sys.stderr)
print("      --category apps --from-theme-icon DONOR --names NAME", file=sys.stderr)
print("", file=sys.stderr)
print("To RESTORE art, git checkout/restore is allowed and is the right tool.", file=sys.stderr)
sys.exit(2)
ICONEOF
case "$?" in
  0) ;;
  2) exit 2 ;;
  *) exit 0 ;;
esac

python3 - "$cmd" <<'PYEOF'
import re
import shlex
import socket
import sys

cmd = sys.argv[1]

HOST_ALIASES = {
    "ThinkPad-T480s": "t480s",
    "t480s": "t480s",
    "ThinkPad-X230": "x230",
    "x230": "x230",
    "ThinkPad-T480": "t480",
    "t480": "t480",
    "s24": "s24",
}

EXPECTED_HOSTS = {
    "x230": {"x230", "ThinkPad-X230"},
    "t480s": {"t480s", "ThinkPad-T480s"},
    "t480": {"t480", "ThinkPad-T480"},
    "s24": {"s24"},
}

# Optional leading env assignments (STOW_PKGS="..." make safe-stow) must not hide the verb
ENV_PREFIX = r"(?:[A-Za-z_][A-Za-z0-9_]*=(?:\"[^\"]*\"|'[^']*'|\S*)\s+)*"
STOW_RE = re.compile(
    r"(^|[;&|]\s*)" + ENV_PREFIX + r"("
    r"(?:\S*/)?loom\s+stow(?::[A-Za-z0-9_-]+)?"
    r"|(?:\S*/)?make(?:\s+-f\s+\S+)?\s+(?:safe-stow|stow|x11-apply)"
    r"|(?:\S*/)?stow\s+(?:all|linux|debian|devuan|x230|t480s|t480|s24|openmandriva)\b"
    r")"
)


def shell_words(text):
    try:
        return shlex.split(text)
    except ValueError:
        return text.split()


def stow_targets(text):
    targets = []

    for match in re.finditer(r"(?:^|[;&|]\s*)(?:\S*/)?loom\s+stow(?::([A-Za-z0-9_-]+))?", text):
        targets.append(match.group(1) or "shared")

    for match in re.finditer(r"(?:^|[;&|]\s*)(?:\S*/)?stow\s+([A-Za-z0-9_-]+)", text):
        targets.append(match.group(1))

    if re.search(r"(?:^|[;&|]\s*)" + ENV_PREFIX + r"(?:\S*/)?make(?:\s+-f\s+\S+)?\s+safe-stow\b", text):
        words = shell_words(text)
        pkgs = []
        for word in words:
            if word.startswith("STOW_PKGS="):
                pkgs.extend(word.split("=", 1)[1].split())
        for candidate in ("x230", "t480s", "t480", "s24"):
            if candidate in pkgs:
                targets.append(candidate)
        if not pkgs:
            targets.append("shared")

    return targets


# ssh flags that consume a following argument (so we can find the destination word)
SSH_ARG_FLAGS = {"-p", "-i", "-o", "-l", "-F", "-J", "-b", "-e", "-c", "-L", "-R", "-D", "-W", "-S"}


def ssh_destination(text):
    words = shell_words(text)
    if not words or words[0] != "ssh":
        return None
    i = 1
    while i < len(words):
        word = words[i]
        if word in SSH_ARG_FLAGS:
            i += 2
            continue
        if word.startswith("-"):
            i += 1
            continue
        return word.rsplit("@", 1)[-1]
    return None


if not STOW_RE.search(cmd):
    sys.exit(0)

ssh_dest = ssh_destination(cmd)
if ssh_dest:
    raw_host = ssh_dest
    short_host = HOST_ALIASES.get(ssh_dest, ssh_dest)
    where = f"ssh destination '{ssh_dest}'"
else:
    raw_host = socket.gethostname().split(".", 1)[0]
    short_host = HOST_ALIASES.get(raw_host, raw_host)
    where = f"local host '{raw_host}'"

for target in stow_targets(cmd):
    expected = EXPECTED_HOSTS.get(target)
    if expected and short_host not in expected and raw_host not in expected:
        print("BLOCKED: DotCortex stow target does not match the machine it would run on.", file=sys.stderr)
        print(f"Requested stow target: {target}", file=sys.stderr)
        print(f"Would run on: {where} (alias: {short_host})", file=sys.stderr)
        print(f"Use the stow verb for '{short_host}', or run this on the matching machine.", file=sys.stderr)
        sys.exit(2)

sys.exit(0)
PYEOF
case "$?" in
  0) ;;
  2) exit 2 ;;
  *) exit 0 ;;
esac

# Extract only the first token/command from the string to avoid matching
# inside heredoc bodies or commit messages. We check the first shell word
# on each line that starts an actual command (after &&, ;, or at line start).
# This avoids false-positive matches on git commit -m bodies that discuss ssh.

# Block ssh -A (agent forwarding): match ssh immediately followed by -A flag
# anywhere a ssh command would actually start (line start, after &&, after ;)
if printf '%s' "$cmd" | grep -qE '(^|&&|;)[[:space:]]*(ssh)[[:space:]]+(-[^A[:space:]][[:space:]]+|[^-][^[:space:]]*[[:space:]]+)?-A([[:space:]]|$)'; then
  {
    printf 'BLOCKED: ssh -A (agent forwarding) exposes your local SSH keys to the remote machine.\n'
    printf 'Confirm with the user that agent forwarding is acceptable before proceeding.\n'
    printf 'Consider whether the remote machine has its own key instead.\n'
  } >&2
  exit 2
fi

# Block remote git pull without dotcortex-pull:
# Match ssh as an actual command start, with a hostname, containing git pull on same line.
# The double-negative (no dotcortex-pull) is a guard for legitimate syncs.
if printf '%s' "$cmd" | grep -qP '(^|&&|;)\s*ssh\s+\S+.*git pull' 2>/dev/null && \
   ! printf '%s' "$cmd" | grep -qF 'dotcortex-pull'; then
  {
    printf 'BLOCKED: remote git pull without dirty-state guard.\n\n'
    printf 'Required steps before pulling on a remote machine:\n'
    printf '  1. ssh <host> "cd ~/DotCortex && git status --short"\n'
    printf '  2. Confirm no dirty tracked files (or get explicit user approval)\n'
    printf '  3. Use dotcortex-pull instead of git pull --ff-only\n\n'
    printf 'Correct pattern:\n'
    printf '  ssh <host> "cd ~/DotCortex && dotcortex-pull && loom stow:<machine>"\n'
  } >&2
  exit 2
fi

exit 0
# Remote git safety guard:1 ends here
