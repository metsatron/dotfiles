#!/usr/bin/env bash
# Agent Control Script




# [[file:../../../agents-bots.org::*Agent Control Script][Agent Control Script:1]]
# Agent Control Script


# [[file:../../../agents-bots.org::*Agent Control Script][Agent Control Script:1]]
# ~/DotCortex/all/.local/bin/telegram-agent-host
# Manage which Telegram agents run on this machine

set -euo pipefail

AGENTS_DIR="${DOTCORTEX_AGENTS_DIR:-$HOME/DotCortex/all/.bots}"
CONFIG_DIR="$HOME/.config"
HOSTS_FILE="$AGENTS_DIR/hosts.conf"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/telegram-agents"
KNOWN_AGENTS="opencode ductor claudecode hermes codex pi-agent"
DUCTOR_HOME_DIR="${DUCTOR_HOME_DIR:-$HOME/HelmCortex/FORGE/brain/ductor}"
DUCTOR_SUPERVISOR="${DUCTOR_SUPERVISOR:-$HOME/HelmCortex/FORGE/bin/ductor-supervise}"
CORE_PROFILE_BIN="${CORE_PROFILE_BIN:-$HOME/.guix-extra-profiles/core/core/bin}"
AGENT_RUNTIME_PATH="${AGENT_RUNTIME_PATH:-$CORE_PROFILE_BIN:$HOME/.local/bin:$HOME/.npm-global/bin:/usr/local/bin:/usr/bin:/bin}"
OPENCODE_PROJECT_ROOT="${OPENCODE_PROJECT_ROOT:-$HOME/HelmCortex}"
OPENCODE_PORT="${OPENCODE_PORT:-4096}"
OPENCODE_STATE_FILE="${OPENCODE_STATE_FILE:-$STATE_DIR/opencode.json}"
OPENCODE_POLLER_BIN="${OPENCODE_POLLER_BIN:-$HOME/.npm-global/bin/opencode-telegram}"
OPENCODE_TELEGRAM_HOME="${OPENCODE_TELEGRAM_HOME:-$HOME/.config/opencode-telegram-bot}"
OPENCODE_NODE_OPTIONS="${OPENCODE_NODE_OPTIONS:---dns-result-order=ipv4first --no-network-family-autoselection}"
OPENCODE_PATCH_APPLIER="${OPENCODE_PATCH_APPLIER:-$HOME/HelmCortex/FORGE/bin/opencode-telegram-patch-apply}"
export OPENCODE_TELEGRAM_HOME
OPENCODE_OWNER_HELPER="${OPENCODE_OWNER_HELPER:-${DOTCORTEX_BIN_DIR:-$HOME/DotCortex/all/.local/bin}/opencode-owner}"
OPENCODE_BACKEND_PID_FILE="$STATE_DIR/opencode-backend.pid"
OPENCODE_POLLER_PID_FILE="$STATE_DIR/opencode-poller.pid"

load_opencode_continuity_policy() {
    local policy_file="${OPENCODE_WARM_POLICY_ENV:-$HOME/.config/opencode-continuity/policy.env}"
    local key value
    [ -r "$policy_file" ] || return 0
    while IFS='=' read -r key value; do
        key="${key%$'\r'}"
        value="${value%$'\r'}"
        case "$key" in
            OPENCODE_WARM_POLICY_HELPER|OPENCODE_WARM_POLICY_ROOT|OPENCODE_WARM_POLICY_AUTHORITY_IDENTITY|\
            OPENCODE_WARM_POLICY_TELEMETRY_HOST|OPENCODE_WARM_POLICY_PROVIDER|OPENCODE_WARM_POLICY_ACCOUNT_HASH|\
            OPENCODE_WARM_POLICY_MODEL_POOL|OPENCODE_WARM_POLICY_ESTIMATED_PRESERVATION_PERCENT|\
            OPENCODE_WARM_POLICY_ESTIMATE_UNCERTAINTY_PERCENT|OPENCODE_WARM_POLICY_IN_FLIGHT_RESERVE_PERCENT|\
            OPENCODE_WARM_POLICY_CONTROL_RESERVE_PERCENT|OPENCODE_WARM_POLICY_SAFETY_MARGIN_SECONDS|\
            OPENCODE_WARM_CACHE_TTL_SECONDS|OPENCODE_WARM_NUDGE_SCHEDULER|\
            OPENCODE_WARM_WAKEUP_ADAPTER|OPENCODE_WARM_NUDGE_DELAY_SECONDS|\
            OPENCODE_WARM_NUDGE_EXPIRY_SECONDS|OPENCODE_WARM_NUDGE_TIMEZONE)
                [ -n "$value" ] && export "$key=$value"
                ;;
        esac
    done < "$policy_file"
}

usage() {
    cat <<EOF
Usage: telegram-agent-host <command> [agent]

Commands:
  list              List all known agents
  status            Show which agents are running
  enabled           Print enabled agents for this host
  enable <agent>    Enable agent on this machine
  disable <agent>   Disable agent on this machine
  sync              Sync configs to this machine from DotCortex
  start             Start all enabled agents independently
  stop              Stop all agents
  switch <machine>  Switch to another machine's agents (disables local, enables remote)
  bring             Bring agents to this machine (stop remote, start local)

Agents: opencode ductor claudecode hermes codex pi-agent

Examples:
  telegram-agent-host list
  telegram-agent-host status
  telegram-agent-host enable opencode
  telegram-agent-host disable opencode
  telegram-agent-host switch x230
EOF
}

get_hostname() {
    hostname | tr '[:upper:]' '[:lower:]'
}

get_enabled_agents() {
    local host="$1"
    grep -i "^${host}|" "$HOSTS_FILE" 2>/dev/null | cut -d'|' -f2 | tr ',' ' '
}

is_agent_enabled() {
    local agent="$1"
    local host
    host=$(get_hostname)
    local enabled
    enabled=$(get_enabled_agents "$host")
    echo "$enabled" | grep -qw "$agent"
}

validate_agent() {
    local agent="${1:-}"
    if [ -z "$agent" ]; then
        echo "Error: missing agent"
        echo "Agents: $KNOWN_AGENTS"
        exit 1
    fi
    case " $KNOWN_AGENTS " in
        *" $agent "*) ;;
        *)
            echo "Error: unknown agent '$agent'"
            echo "Agents: $KNOWN_AGENTS"
            exit 1
            ;;
    esac
}

list_agents() {
    echo "Known agents:"
    echo "  opencode    - OpenCode + Telegram bot"
    echo "  ductor      - Ductor + Telegram/Matrix bot"
    echo "  claudecode  - Claude Code (MCP send/receive)"
    echo "  hermes      - Hermes gateway (native Telegram)"
    echo "  codex       - HelmAstra Codex app-server + Telegram bot"
    echo "  pi-agent    - Pi Coding Agent (no bot yet)"
    echo ""
    echo "Configured hosts:"
    if [ -f "$HOSTS_FILE" ]; then
        grep -v '^#' "$HOSTS_FILE" | grep -v '^$'
    else
        echo " (no hosts.conf found)"
    fi
}

check_opencode() {
    local status_json status_code
    if [ ! -x "$OPENCODE_OWNER_HELPER" ]; then
        echo "opencode: STOPPED (owner helper unavailable)"
        return 1
    fi
    set +e
    status_json=$("$OPENCODE_OWNER_HELPER" inspect \
        --state "$OPENCODE_STATE_FILE" \
        --project "$OPENCODE_PROJECT_ROOT" \
        --host 127.0.0.1 --port "$OPENCODE_PORT")
    status_code=$?
    set -e
    python3 - "$status_json" <<'PY'
import json
import sys

payload = json.loads(sys.argv[1])
print(f"opencode: {payload.get('status', 'unknown').upper()}")
for role in ("backend", "poller"):
    row = payload.get(role) or {}
    state = "RUNNING" if row.get("valid") else ("STOPPED" if not row else "INVALID")
    print(f"  opencode {role}: {state} pid={row.get('pid', '?') if row else '?'}")
native = payload.get("native_poller") or {}
session = payload.get("session") or {}
print(f"  opencode native poller status: {native.get('status', 'unknown')}")
print(f"  opencode session binding: {session.get('status', 'session-unbound')}")
print(f"  opencode project: {payload.get('project', 'see owner state')}")
print(f"  opencode port: {payload.get('host', '127.0.0.1')}:{payload.get('port', '?')}")
PY
    return "$status_code"
}

write_opencode_state() {
    local backend_pid poller_pid
    [ -r "$OPENCODE_BACKEND_PID_FILE" ] || return 1
    backend_pid=$(cat "$OPENCODE_BACKEND_PID_FILE")
    poller_pid=$(python3 - "$OPENCODE_TELEGRAM_HOME/run/bot-service.json" <<'PY'
import json
import sys
try:
    with open(sys.argv[1], encoding="utf-8") as handle:
        value = json.load(handle)
    print(value.get("pid", ""))
except (OSError, ValueError, TypeError):
    print("")
PY
    )
    [ -n "$poller_pid" ] || return 1
    [ -x "$OPENCODE_OWNER_HELPER" ] || return 1
    "$OPENCODE_OWNER_HELPER" capture \
        --state "$OPENCODE_STATE_FILE" \
        --project "$OPENCODE_PROJECT_ROOT" \
        --host 127.0.0.1 --port "$OPENCODE_PORT" \
        --backend-pid "$backend_pid" --poller-pid "$poller_pid" \
        --poller-entrypoint "$OPENCODE_POLLER_BIN" \
        --poller-service-state "$OPENCODE_TELEGRAM_HOME/run/bot-service.json" >/dev/null
}

check_ductor() {
    if ductor_ready; then
        echo "  ductor: RUNNING"
    elif ductor_running; then
        echo "  ductor: DEGRADED (supervisor alive, child unavailable)"
    else
        echo "  ductor: STOPPED"
    fi
}

pid_file_has_command() {
    local pid_file="$1" expected="$2" pid argument
    [ -r "$pid_file" ] || return 1
    IFS= read -r pid < "$pid_file" || return 1
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    [ -r "/proc/$pid/cmdline" ] || return 1
    while IFS= read -r -d '' argument; do
        [ "${argument##*/}" = "$expected" ] && return 0
    done < "/proc/$pid/cmdline"
    return 1
}

ductor_running() {
    pid_file_has_command "$STATE_DIR/ductor-supervise.pid" ductor-supervise
}

ductor_ready() {
    ductor_running && pid_file_has_command "$STATE_DIR/ductor-child.pid" ductor
}

wait_ductor_ready() {
    local timeout="${DUCTOR_READY_TIMEOUT:-90}"
    local elapsed=0
    case "$timeout" in ''|*[!0-9]*) echo "Invalid DUCTOR_READY_TIMEOUT: $timeout" >&2; return 1 ;; esac
    while [ "$elapsed" -lt "$timeout" ]; do
        ductor_ready && return 0
        sleep 1
        elapsed=$((elapsed + 1))
    done
    ductor_ready
}

stop_ductor_owned() {
    local supervisor_pid child_pid
    if ductor_running; then
        IFS= read -r supervisor_pid < "$STATE_DIR/ductor-supervise.pid"
        kill -TERM "$supervisor_pid"
        for _ in {1..15}; do
            [ ! -r "/proc/$supervisor_pid/cmdline" ] && break
            sleep 1
        done
        if [ -r "/proc/$supervisor_pid/cmdline" ]; then
            echo "ductor supervisor $supervisor_pid did not stop" >&2
            return 1
        fi
    elif pid_file_has_command "$STATE_DIR/ductor-child.pid" ductor; then
        IFS= read -r child_pid < "$STATE_DIR/ductor-child.pid"
        kill -TERM "$child_pid"
    fi
    rm -f "$STATE_DIR/ductor-supervise.pid" "$STATE_DIR/ductor-child.pid"
}

hermes_service_unit() {
    printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/hermes-gateway.service"
}

hermes_service_installed() {
    command -v systemctl >/dev/null 2>&1 && [ -f "$(hermes_service_unit)" ]
}

hermes_running() {
    if hermes_service_installed && systemctl --user is-active --quiet hermes-gateway.service; then
        return 0
    fi
    pgrep -x hermes >/dev/null 2>&1
}

start_hermes() {
    if ! command -v hermes >/dev/null 2>&1; then
        echo "hermes not found in PATH"
        return 1
    fi

    if hermes_service_installed; then
        echo "Starting supervised Hermes gateway..."
        systemctl --user enable --now hermes-gateway.service
    elif command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
        echo "Installing supervised Hermes gateway service..."
        hermes gateway install --start-now --start-on-login
    else
        echo "No user service manager available; starting Hermes gateway with nohup..."
        nohup hermes gateway run > "$STATE_DIR/hermes.log" 2>&1 </dev/null &
    fi
}

stop_hermes() {
    if hermes_service_installed; then
        systemctl --user stop hermes-gateway.service
    else
        pkill -x hermes 2>/dev/null || true
    fi
}

check_claudecode() {
    if pgrep -f "claude.*channels.*telegram" >/dev/null 2>&1; then
        echo "  claudecode (--channels telegram plugin): RUNNING"
    else
        echo "  claudecode (--channels telegram plugin): STOPPED"
    fi
}

check_hermes() {
    if hermes_running; then
        echo "  hermes gateway run: RUNNING"
    else
        echo "  hermes gateway run: STOPPED"
    fi
}

check_codex() {
    if codex_telegram_running; then
        echo "  codex-helmastra (--telegram): RUNNING"
    else
        echo "  codex-helmastra (--telegram): STOPPED"
    fi
}

codex_telegram_running() {
    local adapter="${CODEX_TELEGRAM_ADAPTER:-$HOME/HelmCortex/FORGE/scripts/codex_telegram.py}"
    local pid_file="$STATE_DIR/codex-helmastra-telegram.pid"
    local ready_file="$STATE_DIR/codex-helmastra-telegram.ready"
    local pid ready argument
    [ -r "$pid_file" ] && [ -r "$ready_file" ] || return 1
    pid=$(cat "$pid_file")
    ready=$(cat "$ready_file")
    case "$pid" in *[!0-9]*|'') return 1 ;; esac
    [ "$ready" = "$pid" ] || return 1
    [ -r "/proc/$pid/cmdline" ] || return 1
    while IFS= read -r -d '' argument; do
        [ "$argument" = "$adapter" ] && return 0
    done < "/proc/$pid/cmdline"
    return 1
}

gemma_telegram_running() {
    local state_dir="$HOME/.claude/channels/telegram-gemma"
    local f
    for f in /proc/[0-9]*/environ; do
        [ -r "$f" ] || continue
        if tr '\0' '\n' 2>/dev/null < "$f" \
           | grep -q "^TELEGRAM_STATE_DIR=${state_dir}$"; then
            return 0
        fi
    done
    return 1
}

start_pi_agent() {
    if gemma_telegram_running; then
        echo "Gemma Telegram is already running"
        return 0
    fi
    echo "Gemma Telegram runs inline via the PTY-supervised claude-gemma launcher."
    echo "Launch Claude with: claude-gemma --telegram"
    echo "Access control: $HOME/.claude/channels/telegram-gemma/access.json"
}

stop_pi_agent() {
    local state_dir="$HOME/.claude/channels/telegram-gemma"
    local f pid pids
    pids=""
    for f in /proc/[0-9]*/environ; do
        [ -r "$f" ] || continue
        if tr '\0' '\n' 2>/dev/null < "$f" \
           | grep -q "^TELEGRAM_STATE_DIR=${state_dir}$"; then
            pid="${f%/environ}"; pid="${pid##/proc/}"
            pids="${pids:+$pids }$pid"
        fi
    done
    if [ -z "$pids" ]; then
        echo "pi-agent: not running"
        return 0
    fi
    # shellcheck disable=SC2086
    kill -TERM $pids 2>/dev/null || true
}

check_pi_agent() {
    if gemma_telegram_running; then
        echo "  pi-agent (claude-gemma --telegram): RUNNING"
    else
        echo "  pi-agent (claude-gemma --telegram): STOPPED"
    fi
}

status_cmd() {
    local requested="${1:-}"
    local host
    host=$(get_hostname)
    if [ "$requested" = "opencode" ]; then
        check_opencode
        return
    fi
    echo "Host: $host"
    echo "Enabled agents: $(get_enabled_agents "$host")"
    echo ""
    echo "Running processes:"
    check_opencode
    check_ductor
    check_claudecode
    check_hermes
    check_codex
    check_pi_agent
}

enable_agent() {
    local agent="$1"
    validate_agent "$agent"
    local host
    host=$(get_hostname)

    if [ ! -f "$HOSTS_FILE" ]; then
        echo "Error: hosts.conf not found at $HOSTS_FILE"
        exit 1
    fi

    local line
    line=$(grep -i "^${host}|" "$HOSTS_FILE" 2>/dev/null || true)
    if [ -z "$line" ]; then
        echo "Error: host '$host' not found in hosts.conf"
        exit 1
    fi

    local current_agents
    current_agents=$(echo "$line" | cut -d'|' -f2)

    if echo "$current_agents" | grep -qw "$agent"; then
        echo "$agent is already enabled on $host"
        return
    fi

    local new_agents
    if [ -z "$current_agents" ]; then
        new_agents="$agent"
    else
        new_agents="$current_agents,$agent"
    fi

    local tmp_hosts
    tmp_hosts="${HOSTS_FILE}.tmp.$$"
    awk -F'|' -v host="$host" -v agents="$new_agents" '
        BEGIN { OFS = FS }
        tolower($1) == tolower(host) { $2 = agents }
        { print }
    ' "$HOSTS_FILE" > "$tmp_hosts"
    mv "$tmp_hosts" "$HOSTS_FILE"
    echo "Enabled $agent on $host"
    echo "Run 'telegram-agent-host sync' to apply, then 'telegram-agent-host start'"
}

disable_agent() {
    local agent="$1"
    validate_agent "$agent"
    local host
    host=$(get_hostname)

    if [ ! -f "$HOSTS_FILE" ]; then
        echo "Error: hosts.conf not found at $HOSTS_FILE"
        exit 1
    fi

    local line
    line=$(grep -i "^${host}|" "$HOSTS_FILE" 2>/dev/null || true)
    if [ -z "$line" ]; then
        echo "Error: host '$host' not found in hosts.conf"
        exit 1
    fi

    local current_agents
    current_agents=$(echo "$line" | cut -d'|' -f2)

    if ! echo "$current_agents" | grep -qw "$agent"; then
        echo "$agent is not enabled on $host"
        return
    fi

    local new_agents
    new_agents=$(echo "$current_agents" | tr ',' '\n' | grep -v "^${agent}$" | tr '\n' ',' | sed 's/,$//' | sed 's/^,//')

    local tmp_hosts
    tmp_hosts="${HOSTS_FILE}.tmp.$$"
    awk -F'|' -v host="$host" -v agents="$new_agents" '
        BEGIN { OFS = FS }
        tolower($1) == tolower(host) { $2 = agents }
        { print }
    ' "$HOSTS_FILE" > "$tmp_hosts"
    mv "$tmp_hosts" "$HOSTS_FILE"
    echo "Disabled $agent on $host"
    echo "Run 'telegram-agent-host stop $agent' to stop it"
}

sync_configs() {
    echo "Syncing agent configs from DotCortex..."
    local repo="$HOME/DotCortex"

    if [ ! -d "$repo/all/.bots" ]; then
        echo "Error: DotCortex/all/.bots not found"
        exit 1
    fi

    mkdir -p "$HOME/.config/opencode-telegram-bot"
    mkdir -p "$HOME/.config/codex-telegram-helmastra"
    mkdir -p "$HOME/.config/pi-agent" 2>/dev/null || true
    mkdir -p "$HOME/.config/telegram-agents"

    if [ -f "$repo/all/.bots/hosts.conf" ]; then
        cp "$repo/all/.bots/hosts.conf" "$HOME/.config/telegram-agents/hosts.conf"
    fi

    echo "Config sync complete. Update credentials manually if needed."
}

start_agent() {
    local agent="$1"
    validate_agent "$agent"
    case "$agent" in
        opencode)
            load_opencode_continuity_policy
            if [ ! -d "$OPENCODE_PROJECT_ROOT" ]; then
                echo "OpenCode project root not found: $OPENCODE_PROJECT_ROOT" >&2
                return 1
            fi
            if [ ! -x "$OPENCODE_PATCH_APPLIER" ]; then
                echo "OpenCode Telegram patch applier not found: $OPENCODE_PATCH_APPLIER" >&2
                return 1
            fi
            if [ ! -x "$CORE_PROFILE_BIN/node" ]; then
                echo "Intended OpenCode Node runtime not found: $CORE_PROFILE_BIN/node" >&2
                return 1
            fi
            if ! env PATH="$AGENT_RUNTIME_PATH" "$OPENCODE_PATCH_APPLIER"; then
                echo "OpenCode Telegram package seam is not ready; refusing start" >&2
                return 1
            fi
            if [ -r "$OPENCODE_STATE_FILE" ]; then
                if check_opencode >/dev/null 2>&1; then
                    echo "opencode is already running"
                    return 0
                fi
                echo "Existing OpenCode owner state is not healthy; validating and stopping only its owned processes..."
                "$OPENCODE_OWNER_HELPER" stop --state "$OPENCODE_STATE_FILE" --project "$OPENCODE_PROJECT_ROOT" --host 127.0.0.1 --port "$OPENCODE_PORT" || true
            fi
            if command -v ss >/dev/null 2>&1 && ss -Hln "sport = :$OPENCODE_PORT" 2>/dev/null | grep -q .; then
                echo "Refusing OpenCode start: port $OPENCODE_PORT is already occupied by an unowned listener" >&2
                return 1
            fi
            echo "Starting opencode serve in $OPENCODE_PROJECT_ROOT..."
            (
                cd "$OPENCODE_PROJECT_ROOT"
                exec nohup env PATH="$AGENT_RUNTIME_PATH" opencode serve --hostname 127.0.0.1 --port "$OPENCODE_PORT"
            ) > "$STATE_DIR/opencode-serve.log" 2>&1 </dev/null &
            printf '%s\n' "$!" > "$OPENCODE_BACKEND_PID_FILE"
            sleep 2
            if [ ! -s "$OPENCODE_BACKEND_PID_FILE" ]; then
                echo "OpenCode backend did not publish an owned PID" >&2
                return 1
            fi
            echo "Starting opencode-telegram in $OPENCODE_PROJECT_ROOT..."
            if ! (umask 077; cd "$OPENCODE_PROJECT_ROOT" && env PATH="$AGENT_RUNTIME_PATH" NODE_OPTIONS="$OPENCODE_NODE_OPTIONS" "$OPENCODE_POLLER_BIN" start --daemon --mode installed > "$STATE_DIR/opencode-telegram.log" 2>&1 </dev/null); then
                backend_pid=$(cat "$OPENCODE_BACKEND_PID_FILE")
                kill -TERM "$backend_pid" 2>/dev/null || true
                rm -f "$OPENCODE_BACKEND_PID_FILE"
                echo "OpenCode Telegram daemon failed to start; rolled back owned backend" >&2
                return 1
            fi
            for _ in {1..15}; do
                [ -s "$OPENCODE_TELEGRAM_HOME/run/bot-service.json" ] && break
                sleep 1
            done
            write_opencode_state || {
                env PATH="$AGENT_RUNTIME_PATH" "$OPENCODE_POLLER_BIN" stop >/dev/null 2>&1 || true
                backend_pid=$(cat "$OPENCODE_BACKEND_PID_FILE")
                kill -TERM "$backend_pid" 2>/dev/null || true
                rm -f "$OPENCODE_BACKEND_PID_FILE" "$OPENCODE_POLLER_PID_FILE"
                echo "OpenCode backend/poller did not produce a complete owner state" >&2
                return 1
            }
            python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["pid"])' "$OPENCODE_TELEGRAM_HOME/run/bot-service.json" > "$OPENCODE_POLLER_PID_FILE"
            ;;
        ductor)
            if command -v ductor >/dev/null 2>&1 && [ -x "$DUCTOR_SUPERVISOR" ]; then
                if ductor_ready; then
                    echo "ductor is already running"
                elif ductor_running; then
                    echo "ductor supervisor is running; waiting for cold-start readiness..."
                    if ! wait_ductor_ready; then
                        echo "ductor supervisor remained degraded after ${DUCTOR_READY_TIMEOUT:-90}s" >&2
                        return 1
                    fi
                    echo "ductor started"
                else
                    echo "Starting ductor (supervised)..."
                    rm -f "$STATE_DIR/ductor-supervise.pid" "$STATE_DIR/ductor-child.pid"
                    nohup setsid env PATH="$AGENT_RUNTIME_PATH" DUCTOR_HOME="$DUCTOR_HOME_DIR" "$DUCTOR_SUPERVISOR" > "$STATE_DIR/ductor-supervise.log" 2>&1 </dev/null &
                    if ! wait_ductor_ready; then
                        echo "ductor failed supervised readiness" >&2
                        return 1
                    fi
                    echo "ductor started"
                fi
            else
                echo "ductor or its canonical supervisor is unavailable"
                return 1
            fi
            ;;
        claudecode)
            echo "claudecode Telegram runs inline via the PTY-supervised claude-auryn launcher."
            echo "Launch Claude with: claude-auryn --telegram"
            echo "Access control: ~/.claude/channels/telegram/access.json"
            ;;
        hermes)
            start_hermes
            ;;
        codex)
            local wrapper="${CODEX_HELMASTRA_WRAPPER:-$HOME/HelmCortex/FORGE/bin/codex-helmastra}"
            if [ ! -x "$wrapper" ]; then
                echo "codex-helmastra wrapper not found at $wrapper"
                return 1
            fi
            if codex_telegram_running; then
                echo "HelmAstra Telegram is already running"
            else
                echo "Starting HelmAstra Codex Telegram adapter..."
                if ! "$wrapper" --telegram \
                    >> "$STATE_DIR/codex-helmastra-telegram.log" 2>&1 </dev/null; then
                    echo "HelmAstra Telegram adapter failed readiness; inspect $STATE_DIR/codex-helmastra-telegram.log"
                    return 1
                fi
                if ! codex_telegram_running; then
                    echo "HelmAstra Telegram adapter reported ready but is not running"
                    return 1
                fi
            fi
            ;;
        pi-agent)
            start_pi_agent
            ;;
        *)
            echo "Unknown agent: $agent"
            exit 1
            ;;
    esac
    echo "$agent started"
}

stop_agent() {
    local agent="$1"
    validate_agent "$agent"
    case "$agent" in
        opencode)
            if [ -x "$OPENCODE_OWNER_HELPER" ]; then
                "$OPENCODE_OWNER_HELPER" stop \
                    --state "$OPENCODE_STATE_FILE" \
                    --project "$OPENCODE_PROJECT_ROOT" \
                    --host 127.0.0.1 --port "$OPENCODE_PORT"
            else
                echo "OpenCode owner helper unavailable; refusing unscoped stop" >&2
                return 1
            fi
            ;;
        ductor)
            stop_ductor_owned
            ;;
        claudecode)
            pkill -f "claude.*channels.*telegram" 2>/dev/null || true
            ;;
        hermes)
            stop_hermes
            ;;
        codex)
            local codex_pid codex_pgid
            if codex_telegram_running; then
                codex_pid=$(cat "$STATE_DIR/codex-helmastra-telegram.pid")
                codex_pgid=$(ps -o pgid= -p "$codex_pid" 2>/dev/null | tr -d ' ' || true)
                if [ "$codex_pgid" = "$codex_pid" ]; then
                    kill -TERM -- "-$codex_pgid" 2>/dev/null || true
                else
                    kill -TERM "$codex_pid" 2>/dev/null || true
                fi
                for _ in {1..20}; do
                    codex_telegram_running || break
                    sleep 0.25
                done
                if codex_telegram_running; then
                    echo "HelmAstra Telegram did not stop gracefully; forcing its verified process group" >&2
                    if [ "$codex_pgid" = "$codex_pid" ]; then
                        kill -KILL -- "-$codex_pgid" 2>/dev/null || true
                    else
                        kill -KILL "$codex_pid" 2>/dev/null || true
                    fi
                    for _ in {1..20}; do
                        codex_telegram_running || break
                        sleep 0.25
                    done
                fi
            fi
            if codex_telegram_running; then
                echo "HelmAstra Telegram failed to stop" >&2
                return 1
            fi
            ;;
        pi-agent)
            stop_pi_agent
            ;;
        *)
            echo "Unknown agent: $agent"
            exit 1
            ;;
    esac
    echo "$agent stopped"
}

start_all() {
    local host
    host=$(get_hostname)
    local agents
    agents=$(get_enabled_agents "$host")

    if [ -z "$agents" ]; then
        echo "No agents enabled for $host. Run 'telegram-agent-host enable <agent>' first."
        exit 1
    fi

    echo "Starting enabled agents for $host: $agents"
    local failed=0
    for agent in $agents; do
        if ! start_agent "$agent"; then
            echo "Failed to start enabled agent: $agent" >&2
            failed=1
        fi
    done
    return "$failed"
}

stop_all() {
    for agent in opencode ductor claudecode hermes codex pi-agent; do
        stop_agent "$agent" 2>/dev/null || true
    done
    echo "All agents stopped"
}

switch_to_machine() {
    local target="$1"
    local current_host
    current_host=$(get_hostname)

    if [ "$current_host" = "$target" ]; then
        echo "Already on $target"
        return
    fi

    local target_agents
    target_agents=$(get_enabled_agents "$target")

    if [ -z "$target_agents" ]; then
        echo "No agents configured for $target"
        exit 1
    fi

    local target_ssh
    target_ssh=$(grep -i "^${target}|" "$HOSTS_FILE" 2>/dev/null | cut -d'|' -f3)

    echo "Switching from $current_host to $target"

    echo "Stopping all agents on $current_host..."
    stop_all

    echo "Stopping agents on $target before restart..."
    if [ -n "$target_ssh" ]; then
        ssh "$target_ssh" "systemctl --user stop hermes-gateway.service 2>/dev/null || pkill -x hermes 2>/dev/null || true; pkill -f 'ductor' 2>/dev/null || true" 2>/dev/null || true
        sleep 1
    fi

    echo "Starting agents on $target via SSH..."
    if [ -n "$target_ssh" ]; then
        ssh "$target_ssh" "\$HOME/.local/bin/telegram-agent-remote-start $target_agents"
        echo "Switched to $target"
    else
        echo "No SSH config for $target. Manually start on target machine:"
        echo " ssh $target"
        echo " telegram-agent-host start"
    fi
    echo ""
    echo "Enabled on $target: $target_agents"
}

bring_here() {
    local current_host
    current_host=$(get_hostname)
    local agents
    agents=$(get_enabled_agents "$current_host")

    if [ -z "$agents" ]; then
        echo "No agents configured for $current_host"
        exit 1
    fi

    echo "Bringing agents to $current_host..."

    for host_line in $(grep -v '^#' "$HOSTS_FILE" | grep -v '^$'); do
        local other_host
        other_host=$(echo "$host_line" | cut -d'|' -f1)
        if [ "$other_host" != "$current_host" ]; then
            local other_ssh
            other_ssh=$(echo "$host_line" | cut -d'|' -f3)
            if [ -n "$other_ssh" ]; then
                echo "Stopping agents on $other_host..."
                ssh "$other_ssh" "systemctl --user stop hermes-gateway.service 2>/dev/null || pkill -x hermes 2>/dev/null || true; pkill -f 'ductor' 2>/dev/null || true" 2>/dev/null || true
            fi
        fi
    done

    sleep 1
    echo "Starting agents locally..."
    start_all
}

COMMAND="${1:-}"
shift || true

case "$COMMAND" in
    -h|--help|help) usage; exit 0 ;;
esac

mkdir -p "$STATE_DIR"

case "$COMMAND" in
    list) list_agents ;;
    status) status_cmd "${1:-}" ;;
    enable) enable_agent "${1:-}" ;;
    disable) disable_agent "${1:-}" ;;
    sync) sync_configs ;;
    enabled) get_enabled_agents "$(get_hostname)" ;;
    start)
        if [ -n "${1:-}" ]; then
            start_agent "$1"
        else
            start_all
        fi
        ;;
    stop)
        if [ -n "${1:-}" ]; then
            stop_agent "$1"
        else
            stop_all
        fi
        ;;
    switch) switch_to_machine "${1:-}" ;;
    bring) bring_here ;;
    *) usage; exit 1 ;;
esac
# Agent Control Script:1 ends here
# Agent Control Script:1 ends here
