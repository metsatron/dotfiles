#!/usr/bin/env bash
# Python module health

# [[file:../../../package-pip.org::*Python module health][Python module health:1]]
# ~/DotCortex/all/.local/bin/python-deps-health
set -euo pipefail

ROOT="${DOTCORTEX_ROOT:-$HOME/DotCortex}"
MANIFEST="${DOTCORTEX_PYTHON_MODULE_MANIFEST:-$ROOT/all/.pip/manifest/python-modules.ssv}"
GUIX_PYTHON="${DOTCORTEX_GUIX_PYTHON:-$HOME/.guix-extra-profiles/core/core/bin/python3}"
SYSTEM_PYTHON="${DOTCORTEX_SYSTEM_PYTHON:-/usr/bin/python3}"
CONDA_PYTHON="${HELMCORTEX_CONDA_PYTHON:-$HOME/HelmCortex/CORE/anaconda3/envs/helmcortex/bin/python}"
TIMEOUT_SECONDS="${DOTCORTEX_PYTHON_IMPORT_TIMEOUT:-15}"

[ -r "$MANIFEST" ] || { echo "python-deps-health: manifest is missing: $MANIFEST" >&2; exit 1; }
command -v timeout >/dev/null 2>&1 || { echo "python-deps-health: timeout is required" >&2; exit 1; }

version() {
  local python="$1"
  [ -x "$python" ] && "$python" --version 2>&1 || echo missing
}

probe() {
  local python="$1" module="$2" output rc
  if [ ! -x "$python" ]; then
    printf 'NO-INTERP'
    return 0
  fi
  set +e
  output="$(timeout "$TIMEOUT_SECONDS" "$python" -c "import importlib; importlib.import_module('$module')" 2>&1 >/dev/null)"
  rc=$?
  set -e
  if [ "$rc" -eq 0 ]; then
    printf 'OK'
  elif [ "$rc" -eq 124 ]; then
    printf 'TIMEOUT'
  elif grep -q 'No module named\|ModuleNotFoundError' <<<"$output"; then
    printf 'MISSING'
  else
    printf 'ERROR'
  fi
}

printf 'Guix:  %s (%s)\n' "$GUIX_PYTHON" "$(version "$GUIX_PYTHON")"
printf 'System: %s (%s)\n' "$SYSTEM_PYTHON" "$(version "$SYSTEM_PYTHON")"
printf 'Conda:  %s (%s)\n' "$CONDA_PYTHON" "$(version "$CONDA_PYTHON")"
printf '\n%-18s %-22s %-4s %-10s %-10s %-10s\n' \
  MODULE DISTRIBUTION REQ GUIX SYSTEM CONDA
printf '%-18s %-22s %-4s %-10s %-10s %-10s\n' \
  '------------------' '----------------------' '----' '----------' '----------' '----------'

failures=0
while read -r module distribution required; do
  [[ -z "${module:-}" || "$module" == \#* ]] && continue
  guix_status="$(probe "$GUIX_PYTHON" "$module")"
  system_status="$(probe "$SYSTEM_PYTHON" "$module")"
  conda_status="$(probe "$CONDA_PYTHON" "$module")"
  printf '%-18s %-22s %-4s %-10s %-10s %-10s\n' \
    "$module" "$distribution" "$required" "$guix_status" "$system_status" "$conda_status"
  case "$required" in
    G)  [ "$guix_status" = OK ] || failures=$((failures + 1)) ;;
    C)  [ "$conda_status" = OK ] || failures=$((failures + 1)) ;;
    GC) { [ "$guix_status" = OK ] && [ "$conda_status" = OK ]; } || failures=$((failures + 1)) ;;
    -)  ;;
    *) echo "python-deps-health: invalid requirement '$required' for $module" >&2; exit 1 ;;
  esac
done <"$MANIFEST"

if [ "$failures" -gt 0 ]; then
  echo "python-deps-health: $failures required interpreter checks failed" >&2
  exit 1
fi
echo "python-deps-health: required checks passed"
# Python module health:1 ends here
