#!/bin/env bash
#!/bin/env bash
set -euo pipefail

AGENT_ENV="${XDG_CACHE_HOME:-$HOME/.cache}/ssh-agent.env"

# Short per-user socket dir (sanctuary-cortex fix, 2026-10-14): never under a
# deep guest home. 0700 so only this uid can reach the socket.
_agent_sock_dir() {
  local d
  if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -O "${XDG_RUNTIME_DIR}" ]; then
    d="${XDG_RUNTIME_DIR}/ssh-agent-$(id -u)"
    mkdir -p "$d"
    chmod 700 "$d"
  else
    d="/tmp/ssh-agent-$(id -u)"
    mkdir -p "$d"
    chmod 700 "$d"
  fi
  printf '%s\n' "$d"
}

agent_live() {
  [ -n "${SSH_AUTH_SOCK:-}" ] || return 1
  ssh-add -l >/dev/null 2>&1 && return 0
  [ "$?" -eq 1 ]
}

load_agent_env() {
  [ -r "$AGENT_ENV" ] || return 1
  # shellcheck disable=SC1090
  . "$AGENT_ENV"
  export SSH_AUTH_SOCK SSH_AGENT_PID
  agent_live
}

start_agent() {
  mkdir -p "$(dirname "$AGENT_ENV")"
  local sock_dir sock
  sock_dir="$(_agent_sock_dir)"
  sock="${sock_dir}/agent"
  # Explicit -a keeps the socket short even in deep guest homes where the
  # ssh-agent default (~/.ssh/agent/s.<rand>.agent.<rand>) overflows sun_path.
  ssh-agent -a "$sock" -s | sed '/^echo /d' >"$AGENT_ENV"
  chmod 600 "$AGENT_ENV"
  # shellcheck disable=SC1090
  . "$AGENT_ENV"
  export SSH_AUTH_SOCK SSH_AGENT_PID
}

if ! agent_live && ! load_agent_env; then
  start_agent
fi

if [ "${1:-}" = "--print" ]; then
  printf 'export SSH_AUTH_SOCK=%q\n' "$SSH_AUTH_SOCK"
  if [ -n "${SSH_AGENT_PID:-}" ]; then
    printf 'export SSH_AGENT_PID=%q\n' "$SSH_AGENT_PID"
  else
    printf 'unset SSH_AGENT_PID\n'
  fi
fi
