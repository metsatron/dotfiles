#!/bin/env bash
# [[file:../../../loom.org::*Maak control plane (Scheme, XDG-friendly)][Maak control plane (Scheme, XDG-friendly):5]]
# ~/.local/bin/tangle-one
#!/bin/env bash
set -Eeuo pipefail
file="${1:?Usage: tangle-one <file.org>}"
file_path="$(realpath "$file")"
base="$(basename "$file_path")"
repo_root="$(git -C "$(dirname "$file_path")" rev-parse --show-toplevel 2>/dev/null || pwd)"

if grep -qE '^<<<<<<< |^=======$|^>>>>>>> ' "$file_path"; then
  echo "!! REFUSED: $base contains unresolved merge conflict markers" >&2
  grep -nE '^<<<<<<< |^=======$|^>>>>>>> ' "$file_path" | head -10 >&2
  echo "!! Resolve conflicts before tangling — stowed outputs would be broken" >&2
  exit 1
fi

echo ">> Tangle $base"

cd "$repo_root"

if [[ "$base" == "style.org" ]]; then
  exec emacs --batch -Q \
    --eval "(setq org-confirm-babel-evaluate nil create-lockfiles nil make-backup-files nil auto-save-default nil)" \
    --eval "(require 'org)" \
    --eval "(require 'ob-emacs-lisp)" \
    --eval "(find-file \"$base\")" \
    --eval "(org-babel-goto-named-src-block \"loom-style\")" \
    --eval "(org-babel-execute-src-block)" \
    --eval "(org-babel-tangle)"
else
  exec emacs --batch -Q \
    --eval "(setq org-confirm-babel-evaluate nil create-lockfiles nil make-backup-files nil auto-save-default nil)" \
    --eval "(require 'ob-shell)" \
    --eval "(require 'ob-makefile)" \
    --eval "(require 'ob-emacs-lisp)" \
    --eval "(find-file \"$base\")" \
    --eval "(org-babel-tangle)"
fi
# Maak control plane (Scheme, XDG-friendly):5 ends here
