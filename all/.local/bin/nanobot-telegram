#!/usr/bin/env bash
# HelmCortex Nano Instance Wrapper

# The wrapper selects one Nanobot instance and imports only its dedicated token
# from the private environment file. It never evaluates arbitrary shell content.


# [[file:../../../agents-bots.org::*HelmCortex Nano Instance Wrapper][HelmCortex Nano Instance Wrapper:1]]
# ~/DotCortex/all/.local/bin/nanobot-telegram
set -euo pipefail

WORKSPACE="${NANOBOT_WORKSPACE:-$HOME/HelmCortex/FORGE/brain/nanobot}"
VENV="${NANOBOT_VENV:-$WORKSPACE/.venv}"
CONFIG_DIR="${NANOBOT_CONFIG_DIR:-$HOME/.config/nanobot-telegram}"
CONFIG="${NANOBOT_CONFIG:-$CONFIG_DIR/config.json}"
ENV_FILE="${NANOBOT_ENV_FILE:-$CONFIG_DIR/env}"
BIN="$VENV/bin/nanobot"

[ -x "$BIN" ] || {
    echo "Nanobot runtime missing: $BIN (run loom nanobot:apply)" >&2
    exit 1
}
[ -r "$CONFIG" ] || {
    echo "Nanobot config missing: $CONFIG (run telegram-agent-host sync)" >&2
    exit 1
}

if [ -r "$ENV_FILE" ]; then
    while IFS='=' read -r key value; do
        key="${key%$'\r'}"
        value="${value%$'\r'}"
        case "$key" in
            TELEGRAM_BOT_TOKEN)
                [ -n "$value" ] && export TELEGRAM_BOT_TOKEN="$value"
                ;;
        esac
    done < "$ENV_FILE"
fi

exec "$BIN" "$@" --config "$CONFIG"
# HelmCortex Nano Instance Wrapper:1 ends here
