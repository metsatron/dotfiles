#!/usr/bin/env bash
# agent-session

# [[file:../../../services.org::*agent-session][agent-session:1]]
set -euo pipefail

STATE_DIR="${AGENT_SESSIOND_STATE_DIR:-$HOME/DotCortex/ROOTS/DotRoot/agent-session}"
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"

agent_sessiond_bin() {
  if command -v agent-sessiond >/dev/null 2>&1; then
    command -v agent-sessiond
  elif [ -x "$SCRIPT_DIR/agent-sessiond" ]; then
    printf '%s/agent-sessiond\n' "$SCRIPT_DIR"
  else
    echo "agent-session: agent-sessiond not found in PATH or $SCRIPT_DIR" >&2
    exit 1
  fi
}

usage() {
  cat <<'EOF'
Usage: agent-session <scan|status|json>

Commands:
  scan    run agent-sessiond once
  status  print agent-sessiond status
  json    print latest local state JSON
EOF
}

state_file() {
  local host
  host="$(hostname 2>/dev/null || echo unknown)"
  printf '%s/state.%s.json\n' "$STATE_DIR" "$host"
}

cmd="${1:-status}"
case "$cmd" in
  scan)
    exec "$(agent_sessiond_bin)" once
    ;;
  status)
    exec "$(agent_sessiond_bin)" status
    ;;
  json)
    file="$(state_file)"
    if [ ! -s "$file" ]; then
      echo "agent-session: no state file found at $file" >&2
      exit 1
    fi
    exec cat "$file"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
# agent-session:1 ends here
