#!/usr/bin/env bash
# agent-session

# [[file:../../../services.org::*agent-session][agent-session:1]]
set -euo pipefail

STATE_DIR="${AGENT_SESSIOND_STATE_DIR:-$HOME/DotCortex/ROOTS/DotRoot/agent-session}"
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"

agent_sessiond_bin() {
  if command -v agent-sessiond >/dev/null 2>&1; then
    command -v agent-sessiond
  elif [ -x "$SCRIPT_DIR/agent-sessiond" ]; then
    printf '%s/agent-sessiond\n' "$SCRIPT_DIR"
  else
    echo "agent-session: agent-sessiond not found in PATH or $SCRIPT_DIR" >&2
    exit 1
  fi
}

usage() {
  cat <<'EOF'
Usage: agent-session <scan|status|json|close>

Commands:
  scan         run agent-sessiond once
  status       print agent-sessiond status
  json         print latest local state JSON
  close <id>   mark session as closed in session-index.json
EOF
}

state_file() {
  local host
  host="$(hostname 2>/dev/null || echo unknown)"
  printf '%s/state.%s.json\n' "$STATE_DIR" "$host"
}

index_file_path() {
  if [ -n "${AGENT_SESSION_INDEX:-}" ]; then
    printf '%s\n' "$AGENT_SESSION_INDEX"
    return
  fi
  if [ -n "${AGENT_TOP_INDEX:-}" ]; then
    printf '%s\n' "$AGENT_TOP_INDEX"
    return
  fi
  local host
  host="$(hostname 2>/dev/null || echo unknown)"
  case "$host" in
    ThinkPad-T480s|t480s) printf '%s\n' "$HOME/mnt/x230/HelmCortex/ROOTS/AgentRoot/session-index.json" ;;
    *)                    printf '%s\n' "$HOME/HelmCortex/ROOTS/AgentRoot/session-index.json" ;;
  esac
}

cmd="${1:-status}"
case "$cmd" in
  scan)
    exec "$(agent_sessiond_bin)" once
    ;;
  status)
    exec "$(agent_sessiond_bin)" status
    ;;
  json)
    file="$(state_file)"
    if [ ! -s "$file" ]; then
      echo "agent-session: no state file found at $file" >&2
      exit 1
    fi
    exec cat "$file"
    ;;
  close)
    sid="${2:-}"
    if [ -z "$sid" ]; then
      echo "Usage: agent-session close <session_id>" >&2
      exit 1
    fi
    ifile="$(index_file_path)"
    if [ ! -f "$ifile" ]; then
      echo "agent-session close: index file not found: $ifile" >&2
      exit 1
    fi
    python3 - "$sid" "$ifile" <<'PY'
import json, os, sys, time
sid   = sys.argv[1]
ifile = sys.argv[2]
with open(ifile) as f:
    idx = json.load(f)
sessions = idx.get("sessions", [])
found = [s for s in sessions
         if (s.get("id") or "") == sid or (s.get("id") or "").startswith(sid)]
if len(found) > 1:
    print(f"agent-session close: ambiguous prefix '{sid}' matches {len(found)} sessions", file=sys.stderr)
    sys.exit(1)
if not found:
    print(f"agent-session close: session not found: {sid}", file=sys.stderr)
    sys.exit(1)
s = found[0]
if s.get("status") in ("closed", "abandoned"):
    print(f"agent-session close: already {s['status']}: {s.get('id')}", file=sys.stderr)
    sys.exit(2)
old = s.get("status", "unknown")
s["status"]   = "closed"
s["indexedat"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
tmp = ifile + ".tmp"
with open(tmp, "w") as f:
    json.dump(idx, f, indent=2)
    f.write("\n")
os.replace(tmp, ifile)
print(f"closed: {s['id']} [{old} → closed]  {s.get('agent', '')}  {(s.get('openquestion') or '')[:60]}")
PY
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
# agent-session:1 ends here
