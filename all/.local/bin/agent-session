#!/usr/bin/env bash
# agent-session

# [[file:../../../services.org::*agent-session][agent-session:1]]
set -euo pipefail

STATE_DIR="${AGENT_SESSIOND_STATE_DIR:-$HOME/HelmCortex/ROOTS/DotRoot/agent-session}"
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"

agent_sessiond_bin() {
  if command -v agent-sessiond >/dev/null 2>&1; then
    command -v agent-sessiond
  elif [ -x "$SCRIPT_DIR/agent-sessiond" ]; then
    printf '%s/agent-sessiond\n' "$SCRIPT_DIR"
  else
    echo "agent-session: agent-sessiond not found in PATH or $SCRIPT_DIR" >&2
    exit 1
  fi
}

usage() {
  cat <<'EOF'
Usage: agent-session [scan|list|all|show <id>|close <id>|preview <file> [<id>]]

Commands:
  (no args)       open the HelmCortex fzf session picker
  scan/list/all   delegate to HelmCortex agent-session
  show/close/...  delegate to HelmCortex agent-session

DotCortex state helpers:
  status          print agent-sessiond status
  json            print latest local agent-sessiond state JSON
  state-scan      run agent-sessiond once
EOF
}

state_file() {
  local host
  host="$(hostname 2>/dev/null || echo unknown)"
  printf '%s/state.%s.json\n' "$STATE_DIR" "$host"
}

_find_hc_agent_session() {
  # HC owns session-index.json and the fzf session picker.
  local host
  host="$(hostname 2>/dev/null || echo unknown)"
  case "$host" in
    ThinkPad-T480s|t480s) printf '%s\n' "$HOME/mnt/x230/HelmCortex/FORGE/bin/agent-session" ;;
    *)                    printf '%s\n' "$HOME/HelmCortex/FORGE/bin/agent-session" ;;
  esac
}

exec_hc_agent_session() {
  local hc_bin
  hc_bin="$(_find_hc_agent_session)"
  if [ ! -x "$hc_bin" ]; then
    echo "agent-session: HC agent-session not found: $hc_bin" >&2
    exit 1
  fi
  exec "$hc_bin" "$@"
}

cmd="${1:-}"
case "$cmd" in
  state-scan)
    exec "$(agent_sessiond_bin)" once
    ;;
  status)
    exec "$(agent_sessiond_bin)" status
    ;;
  json)
    file="$(state_file)"
    if [ ! -s "$file" ]; then
      echo "agent-session: no state file found at $file" >&2
      exit 1
    fi
    exec cat "$file"
    ;;
  -h|--help|help)
    usage
    ;;
  "")
    exec_hc_agent_session
    ;;
  *)
    exec_hc_agent_session "$@"
    ;;
esac
# agent-session:1 ends here
