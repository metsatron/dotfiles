#!/usr/bin/env python3
# Codex Recall context hook
# The Codex Recall hook is local and report-only. It receives a lifecycle
# payload, asks the Recall CLI for a bounded semantic slice, and returns that
# slice through Codex's =additionalContext= channel. The active agent label comes
# from =CODEX_WARM_HERDR_AGENT= and safely defaults to =Codex=, so a wrapper such
# as =codex-helmastra= can identify its own context without contaminating every
# Codex session. The hook never opens Recall's databases, reads native session
# stores, or writes corpus state.


# [[file:../../../agents-hooks.org::*Codex Recall context hook][Codex Recall context hook:1]]
"""Inject a bounded Recall context slice into Codex lifecycle events."""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys

MAX_QUERY = 1200
MAX_CONTEXT = 6000
AGENT_NAME = re.compile(r"[A-Za-z][A-Za-z0-9 .:_-]{0,63}")


def active_agent() -> str:
    """Use the warm-wrapper identity when it is present and valid."""

    candidate = os.environ.get("CODEX_WARM_HERDR_AGENT", "").strip()
    return candidate if AGENT_NAME.fullmatch(candidate) else "Codex"


def main() -> int:
    try:
        payload = json.load(sys.stdin)
    except (json.JSONDecodeError, OSError):
        return 0

    agent = active_agent()
    event = payload.get("hook_event_name", "")
    if event == "UserPromptSubmit":
        query = str(payload.get("prompt", "")).strip()[:MAX_QUERY]
        if not query:
            return 0
    elif event == "SessionStart":
        query = (
            f"{agent} HelmCortex active work, recent decisions, "
            "relevant skills and harness context"
        )
    else:
        return 0

    recall = os.environ.get(
        "CODEX_RECALL_BIN", os.path.expanduser("~/HelmCortex/FORGE/bin/recall")
    )
    try:
        result = subprocess.run(
            [recall, "query", query, "--k", "5", "--db", "helmcortex"],
            capture_output=True,
            text=True,
            timeout=8,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return 0
    if result.returncode != 0 or not result.stdout.strip():
        return 0

    context = result.stdout.strip()[:MAX_CONTEXT]
    print(json.dumps({
        "hookSpecificOutput": {
            "hookEventName": event,
            "additionalContext": f"Recall context for this {agent} session:\n\n{context}",
        }
    }))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
# Codex Recall context hook:1 ends here
