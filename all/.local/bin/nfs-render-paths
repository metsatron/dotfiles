#!/usr/bin/env python3
"""Render NFS account-home templates without touching live configuration."""
import argparse
import os
from pathlib import Path
import sys

MARKER = "/home/YOUR_USERNAME"

def home_path(value):
    if not value.startswith("/") or value == "/" or any(c.isspace() or c in ":#\\" for c in value):
        raise argparse.ArgumentTypeError("home must be an absolute non-root path without whitespace or NFS delimiters")
    return value.rstrip("/")

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--kind", choices=("client", "server"), required=True)
    parser.add_argument("--local-home", type=home_path, default=os.environ.get("HOME", ""))
    parser.add_argument("--remote-home", type=home_path)
    parser.add_argument("template", type=Path)
    args = parser.parse_args()
    remote = args.remote_home or args.local_home
    lines = []
    for line in args.template.read_text(encoding="utf-8").splitlines(keepends=True):
        if line.lstrip().startswith("#") or not line.strip():
            lines.append(line)
            continue
        fields = line.split()
        if args.kind == "client":
            if len(fields) != 3:
                parser.error("client template must have mount, options and remote fields")
            fields[0] = fields[0].replace(MARKER, args.local_home)
            fields[2] = fields[2].replace(MARKER, remote)
        else:
            if len(fields) != 2:
                parser.error("server template must have export and client fields")
            fields[0] = fields[0].replace(MARKER, args.local_home)
        if any(MARKER in value for value in fields):
            parser.error("unresolved home marker in template")
        lines.append("  ".join(fields) + "\n")
    sys.stdout.write("".join(lines))

if __name__ == "__main__":
    main()
