#!/usr/bin/env python3
"""Read-only query interface over the Help Corpus (help-corpus.sqlite).

Never opens the corpus for write -- Clippy consumes the Fleet Library
read-only. Designed to be spawned per-query from Electron's main process
and parsed as JSON on stdout (never in-process sqlite in the renderer/main).

Usage:
  dotcortex-help-query search "<query>" [--docset NAME] [--limit N] [--corpus PATH]
  dotcortex-help-query read <chunk-id> [--corpus PATH]
"""
import argparse, json, sqlite3, sys
from pathlib import Path

DEFAULT_CORPUS = Path.home() / ".local/share/dotcortex/help/help-corpus.sqlite"


def open_ro(path: Path) -> sqlite3.Connection:
    if not path.is_file():
        print(json.dumps({"error": f"corpus not found: {path}"}), file=sys.stdout)
        sys.exit(1)
    return sqlite3.connect(f"file:{path}?mode=ro", uri=True)


def cmd_search(con, query, docset, limit):
    sql = """
    SELECT d.docset, d.name, d.type, d.path, c.id, c.anchor, c.heading,
           snippet(chunks_fts, 2, '[', ']', '...', 24) AS snip,
           bm25(chunks_fts) AS score
    FROM chunks_fts
    JOIN chunks c ON c.id = chunks_fts.chunk_id
    JOIN documents d ON d.id = c.document_id
    WHERE chunks_fts MATCH ?
    """
    params = [query]
    if docset:
        sql += " AND d.docset = ?"
        params.append(docset)
    sql += " ORDER BY score LIMIT ?"
    params.append(limit)
    rows = con.execute(sql, params).fetchall()
    return [
        {"docset": r[0], "name": r[1], "type": r[2], "path": r[3],
         "chunk_id": r[4], "anchor": r[5], "heading": r[6], "snippet": r[7]}
        for r in rows
    ]


def cmd_read(con, chunk_id):
    row = con.execute("""
        SELECT d.docset, d.name, d.type, d.path, c.anchor, c.heading, c.body
        FROM chunks c JOIN documents d ON d.id = c.document_id
        WHERE c.id = ?
    """, (chunk_id,)).fetchone()
    if not row:
        return None
    return {"docset": row[0], "name": row[1], "type": row[2], "path": row[3],
            "anchor": row[4], "heading": row[5], "body": row[6]}


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--corpus", default=str(DEFAULT_CORPUS))
    sub = ap.add_subparsers(dest="verb", required=True)

    sp = sub.add_parser("search")
    sp.add_argument("query")
    sp.add_argument("--docset")
    sp.add_argument("--limit", type=int, default=8)

    rp = sub.add_parser("read")
    rp.add_argument("chunk_id", type=int)

    args = ap.parse_args()
    con = open_ro(Path(args.corpus))

    if args.verb == "search":
        result = cmd_search(con, args.query, args.docset, args.limit)
    else:
        result = cmd_read(con, args.chunk_id)
        if result is None:
            print(json.dumps({"error": f"no such chunk: {args.chunk_id}"}))
            sys.exit(1)

    print(json.dumps(result))


if __name__ == "__main__":
    main()
