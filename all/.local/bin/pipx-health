#!/usr/bin/env bash
# Pipx health

# [[file:../../../package-pip.org::*Pipx health][Pipx health:1]]
# ~/DotCortex/all/.local/bin/pipx-health
set -euo pipefail

echo "PIPX      = $(command -v pipx || echo missing)"
echo "pipx ver  = $(pipx --version 2>/dev/null || echo n/a)"
echo ""
pipx list 2>/dev/null || echo "no pipx venvs found"
# Pipx health:1 ends here
