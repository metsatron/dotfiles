#!/usr/bin/env bash
# vi compatibility wrapper: opens Neovim.
# Placed in ~/.local/bin/ (ahead of /usr/bin in PATH) so CDE's Vi action,
# dtterm sessions, and all scripts that call 'vi' get Neovim instead.
exec nvim "$@"
