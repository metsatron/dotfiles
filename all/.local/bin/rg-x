#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'Usage: rg-x PATTERN [rg options] [PATH ...]\n' >&2
}

if [ "$#" -eq 0 ]; then
  usage
  exit 2
fi

if ! command -v rg >/dev/null 2>&1; then
  echo "rg-x: rg not found" >&2
  exit 127
fi

has_path=0
for arg in "$@"; do
  case "$arg" in
    -*)
      ;;
    *)
      if [ "$arg" != "$1" ]; then
        has_path=1
        break
      fi
      ;;
  esac
done

if [ "$has_path" -eq 0 ]; then
  set -- "$@" .
fi

exec rg -n --color=auto --hidden --no-ignore --glob '!**/.git/**' "$@"
