#!/usr/bin/env bash
# Codex live config apply
# Codex keeps credentials, state, marketplace cache paths, and machine-local
# project trust entries under =~/.codex=. DotCortex should not own that whole
# tree. This helper patches only the declarative TUI status-line list in the live
# private config.


# [[file:../../../codex.org::*Codex live config apply][Codex live config apply:1]]
set -euo pipefail

config="${CODEX_CONFIG:-$HOME/.codex/config.toml}"
desired='status_line = ["model-with-reasoning", "current-dir", "context-used", "five-hour-limit", "weekly-limit"]'

mkdir -p "$(dirname "$config")"

if [ ! -f "$config" ]; then
  {
    printf '[tui]\n'
    printf '%s\n' "$desired"
  } >"$config"
  chmod 600 "$config"
  echo "codex-config-apply: created $config"
  exit 0
fi

tmp="$(mktemp)"
awk -v desired="$desired" '
  BEGIN {
    in_tui = 0
    seen_tui = 0
    wrote_status = 0
  }

  /^\[[^]]+\]$/ {
    if (in_tui && !wrote_status) {
      print desired
      wrote_status = 1
    }
    in_tui = ($0 == "[tui]")
    if (in_tui) {
      seen_tui = 1
    }
    print
    next
  }

  in_tui && /^[[:space:]]*status_line[[:space:]]*=/ {
    if (!wrote_status) {
      print desired
      wrote_status = 1
    }
    next
  }

  { print }

  END {
    if (!seen_tui) {
      print ""
      print "[tui]"
      print desired
    } else if (in_tui && !wrote_status) {
      print desired
    }
  }
' "$config" >"$tmp"

if cmp -s "$tmp" "$config"; then
  rm -f "$tmp"
  echo "codex-config-apply: already current"
  exit 0
fi

backup="${config}.backup-$(date +%Y%m%d-%H%M%S)"
cp -a "$config" "$backup"
cat "$tmp" >"$config"
rm -f "$tmp"
chmod 600 "$config"
echo "codex-config-apply: updated $config"
echo "codex-config-apply: backup $backup"
# Codex live config apply:1 ends here
