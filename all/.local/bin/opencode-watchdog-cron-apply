#!/usr/bin/env bash
set -euo pipefail

TAG="opencode-watchdog-cron-apply"
TARGET="/etc/cron.d/dotcortex-opencode-watchdog"
REMOVE=0
DRY=0
EXPECTED_HOST=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --remove) REMOVE=1 ;;
    --dry-run) DRY=1 ;;
    --host)
      [ "$#" -ge 2 ] || { echo "$TAG: --host requires a value" >&2; exit 2; }
      EXPECTED_HOST="$2"
      shift ;;
    -h|--help|help)
      echo "Usage: $TAG --host EXACT_HOST [--dry-run] [--remove]"
      exit 0 ;;
    *) echo "$TAG: unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done

run_priv() { if [ "$(id -u)" = 0 ]; then "$@"; else sudo -n "$@"; fi; }

if [ "$REMOVE" = 1 ]; then
  if [ "$DRY" = 1 ]; then
    echo "remove $TARGET"
  else
    run_priv rm -f "$TARGET"
    echo "$TAG: removed $TARGET"
  fi
  exit 0
fi

[ -n "$EXPECTED_HOST" ] || { echo "$TAG: --host EXACT_HOST is required" >&2; exit 2; }
CURRENT_HOST="$(hostname)"
[ "$CURRENT_HOST" = "$EXPECTED_HOST" ] || {
  echo "$TAG: refusing installation on $CURRENT_HOST; expected $EXPECTED_HOST" >&2
  exit 1
}

USER_NAME="$(id -un)"
USER_ID="$(id -u)"
TARGET_HOME="$HOME"
WATCHDOG="$TARGET_HOME/.local/bin/opencode-watchdog"
LOG_DIR="$TARGET_HOME/.local/state/opencode-watchdog"
if [ "$DRY" != 1 ] && [ ! -x "$WATCHDOG" ]; then
  echo "$TAG: missing $WATCHDOG; tangle and stow first" >&2
  exit 1
fi

TMP="$(mktemp)"
trap 'rm -f "$TMP"' EXIT
cat >"$TMP" <<EOF
# DotCortex OpenCode watchdog; managed by $TAG.
*/3 * * * * ${USER_NAME} HOME=${TARGET_HOME} PATH=${TARGET_HOME}/.local/bin:${TARGET_HOME}/.npm-global/bin:/usr/local/bin:/usr/bin:/bin XDG_RUNTIME_DIR=/run/user/${USER_ID} ${WATCHDOG} --expected-host ${EXPECTED_HOST} --json >>${LOG_DIR}/cron.log 2>&1
EOF

if [ "$DRY" = 1 ]; then
  cat "$TMP"
else
  mkdir -p "$LOG_DIR"
  run_priv install -o root -g root -m 0644 "$TMP" "$TARGET"
  echo "$TAG: installed $TARGET"
fi
