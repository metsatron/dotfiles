#!/usr/bin/env bash
# Voice-note fallback: the reply becomes a Telegram voice note when he cannot hear it

# Playback to a host he cannot hear is a *silent* failure. The phone can be dozing, unreachable, or simply muted — media volume at zero — and the log still says =delivered=s24=, which is honest about the transfer and useless about his ears. Mètsàtron asked for both halves on 2026-11-11: he is happy for it to fall back to the T480s, but the reply should *also* be appended to the Telegram session as a rendered voice note; and specifically "when I have the volume all the way down as well on my phone".

# So the relay grew three behaviours, each best-effort and none able to affect the reply or the playback lane:

# 1. *Mute probe.* Before either lane runs, one SSH round trip asks the play host for its media stream volume (=termux-volume=). It is detached like everything else, so it costs the reply nothing. Zero means muted: playing is pointless, so both play lanes are skipped and the render lane runs only to produce the note.
# 2. *Voice note.* Whenever the phone was muted, or the reply fell through to the fallback host, or every host failed, the rendered WAV is encoded to OGG/Opus with =ffmpeg= and posted to Telegram as a native voice note — the same bytes he would have heard, now sitting in the chat where he can play it whenever.
# 3. *Alert by existence.* A =telegram=<code>= field in the log records what happened, so a run of muted or fallback deliveries is visible without new machinery: the note arriving *is* the signal that the phone lane is not serving him.

# Both helpers live beside the hook and are resolved through =$(dirname $(readlink -f $0))=, the same way the normaliser is, so they work wherever the hook is installed. Kill switch for the note: =PVOX_REPLY_TG_OFF=1=; chat override: =PVOX_REPLY_TG_CHAT=; force a note for testing: =PVOX_REPLY_TG_FORCE=1=.


# [[file:../../../agents-hooks.org::*Voice-note fallback: the reply becomes a Telegram voice note when he cannot hear it][Voice-note fallback: the reply becomes a Telegram voice note when he cannot hear it:1]]
# pvox-reply-media-muted HOST — can he actually hear the play host?
# Exit 0 = media (music) stream at zero, 1 = audible, 2 = unknown.
# Only Android/Termux hosts carry termux-volume; anything else is "unknown",
# which the caller treats as audible so playback still gets its chance.
set -uo pipefail

HOST="${1:?usage: pvox-reply-media-muted HOST}"
SSHOPTS="-o BatchMode=yes -o ConnectTimeout=5 -o ServerAliveInterval=5 -o ServerAliveCountMax=2"

JSON="$(ssh $SSHOPTS "$HOST" 'command -v termux-volume >/dev/null 2>&1 || exit 7; termux-volume' 2>/dev/null)" || JSON=""
[ -n "$JSON" ] || { echo "unknown"; exit 2; }

VOL="$(printf '%s' "$JSON" | python3 -c '
import json, sys
try:
    streams = json.load(sys.stdin)
    print(next((int(s["volume"]) for s in streams if s.get("stream") == "music"), -1))
except Exception:
    print(-1)
' 2>/dev/null)"

case "$VOL" in
    0)      echo "muted";        exit 0 ;;
    ''|-1)  echo "unknown";      exit 2 ;;
    *)      echo "audible:$VOL"; exit 1 ;;
esac
# Voice-note fallback: the reply becomes a Telegram voice note when he cannot hear it:1 ends here
