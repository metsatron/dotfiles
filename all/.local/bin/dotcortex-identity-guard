#!/usr/bin/env bash
# Protected-identity guard — the name a public repository must never carry

# The address guard enforces rule 21. This is the neighbouring hole, found the hard way: a real person's name and address reached a
# public remote through commit metadata and captured unit files, and the scrub that removed it was undone twice - once by a rescue
# branch pushed to preserve the pre-scrub history, once by a capture that was byte-faithful to a host whose unit description said
# whose desk it was. Neither mistake was careless; both were made by someone trying to be careful in one dimension and blind in
# another. A guard at the point of commit is the only place that catches both.

# - **The patterns are not in the repository.** They live in =$DOTCORTEX_IDENTITY_DENYLIST=, default
#   =~/.config/dotcortex/protected-identities=, one extended regex per line with =#= comments. A machine without that file is not
#   blocked - the guard is a no-op - because a fresh clone must never be wedged by a list it does not have, and because a list that
#   lives in the repo is the leak it is trying to prevent.
# - **Only added lines are scanned**, so existing history never blocks new work.
# - **Author and committer identities are checked too.** That is how the name entered history the first time: not in a file, in
#   ="GIT_AUTHOR_NAME"=. A content scan alone would have watched the door while the window stood open.
# - **No override flag.** A fixture that needs a protected-looking string builds it at runtime in the guard's own test, the way
#   the address guard's test assembles its addresses.


# [[file:../../../agents-hooks.org::*Protected-identity guard — the name a public repository must never carry][Protected-identity guard — the name a public repository must never carry:1]]
# [[file:../../../agents-hooks.org::*Protected-identity guard][Protected-identity guard:1]]
# ~/DotCortex/all/.local/bin/dotcortex-identity-guard
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: dotcortex-identity-guard --staged
       dotcortex-identity-guard --pre-push <remote-name> <remote-url>   (reads refs on stdin)
       dotcortex-identity-guard --range <rev-range>

Refuse content or commit metadata that matches a protected identity, so a
private name or address cannot reach the public remote. Patterns come from
$DOTCORTEX_IDENTITY_DENYLIST (default ~/.config/dotcortex/protected-identities),
one extended regex per line. No such file means nothing to protect: exit 0.
USAGE
}

denylist() {
  printf '%s' "${DOTCORTEX_IDENTITY_DENYLIST:-$HOME/.config/dotcortex/protected-identities}"
}

# One ERE alternation from the file, or empty when there is nothing to protect.
pattern_re() {
  local f; f="$(denylist)"
  [ -r "$f" ] || return 0
  awk 'BEGIN{ORS="|"} /^[[:space:]]*(#|$)/{next} {sub(/[[:space:]]+$/,""); print}' "$f" | sed 's/|$//'
}

# Read a unified diff on stdin; print "path: matched-text" for every added-line hit.
scan_diff() {
  awk -v re="$RE" '
    /^\+\+\+ / { path = substr($0, 5); sub(/^b\//, "", path); next }
    /^\+/ {
      line = substr($0, 2)
      while (match(line, re)) {
        print path ": " substr(line, RSTART, RLENGTH)
        line = substr(line, RSTART + RLENGTH)
      }
    }'
}

# Commit metadata: the author and committer lines of every commit in a range.
scan_meta() {
  git log --format='%h %an <%ae> %cn <%ce>' "$1" 2>/dev/null | grep -E "$RE" || true
}

report() {
  local hits="$1" where="$2"
  [ -z "$hits" ] && return 0
  printf 'dotcortex-identity-guard: refusing %s: a protected identity would become public\n' "$where" >&2
  printf '%s\n' "$hits" | sort -u | sed 's/^/  - /' >&2
  printf 'dotcortex-identity-guard: patterns from %s - neutralise the text, or commit under another identity\n' "$(denylist)" >&2
  return 1
}

RE="$(pattern_re)"
if [ -z "$RE" ]; then
  # Nothing to protect on this machine. Say so only when asked.
  [ "${1:-}" = "--explain" ] && echo "dotcortex-identity-guard: no denylist at $(denylist) - allowing everything" >&2
  exit 0
fi

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  --staged)
    status=0
    ident="$(git var GIT_AUTHOR_IDENT 2>/dev/null || true; git var GIT_COMMITTER_IDENT 2>/dev/null || true)"
    meta_hits="$(printf '%s\n' "$ident" | grep -E "$RE" || true)"
    report "$meta_hits" "this commit: author or committer identity" || status=1
    diff_hits="$(git diff --cached -U0 --no-color --no-ext-diff | scan_diff)"
    report "$diff_hits" "this commit: staged content" || status=1
    exit "$status" ;;
  --range)
    [ -n "${2:-}" ] || { usage >&2; exit 2; }
    status=0
    report "$(scan_meta "$2")" "range $2: commit metadata" || status=1
    report "$(git log -p -U0 --no-color --no-ext-diff --format= "$2" | scan_diff)" "range $2: content" || status=1
    exit "$status" ;;
  --pre-push)
    zero="0000000000000000000000000000000000000000"
    status=0
    while read -r local_ref local_sha remote_ref remote_sha; do
      [ "$local_sha" = "$zero" ] && continue
      if [ "$remote_sha" = "$zero" ]; then
        rng="$local_sha --not --remotes"
      else
        rng="$remote_sha..$local_sha"
      fi
      report "$(scan_meta "$rng")" "push of $local_ref: commit metadata" || status=1
      report "$(git log -p -U0 --no-color --no-ext-diff --format= "$rng" | scan_diff)" "push of $local_ref: content" || status=1
    done
    exit "$status" ;;
  --explain) exit 0 ;;
  *) usage >&2; exit 2 ;;
esac
# Protected-identity guard — the name a public repository must never carry:1 ends here
