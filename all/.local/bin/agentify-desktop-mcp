#!/usr/bin/env bash
# [[file:../../../agents-mcp.org::*Agentify Desktop - browser-session MCP (ChatGPT / Perplexity / more)][Agentify Desktop - browser-session MCP (ChatGPT / Perplexity / more):4]]
# ~/DotCortex/all/.local/bin/agentify-desktop-mcp
# Stdio MCP server surface of Agentify Desktop, for MCP client config blocks
# (claude .mcp.json, ~/.hermes/config.yaml mcp_servers, ~/.opencode.json).
# Dispatch is by subcommand: `agentify-desktop mcp` (verified via --help).
set -euo pipefail

# Agent users (Agent Boundaries 8f) run this by its DotCortex path with their
# own $HOME, so the preparer falls back to this script's sibling libexec and
# installs a private pinned client in the agent home.
SELF_DIR="$(dirname "$(readlink -f "$0")")"
PREPARE="${AGENTIFY_DESKTOP_PREPARE:-$HOME/.local/libexec/agentify-desktop-prepare}"
[ -x "$PREPARE" ] || PREPARE="$SELF_DIR/../libexec/agentify-desktop-prepare"
[ -x "$PREPARE" ] || { printf 'agentify-desktop-mcp: missing guarded runtime preparer: %s\n' "$PREPARE" >&2; exit 1; }

# The control center, its browser and its state stay the operator's. An agent
# cannot read ~/.agentify-desktop, so it connects through the group-readable
# mirror of the port and token that agentify-agent-share keeps in sync.
AGENTIFY_SHARE_DIR="${AGENTIFY_SHARE_DIR:-/var/lib/agentify-share}"
if [ -z "${AGENTIFY_DESKTOP_STATE_DIR:-}" ] && [ ! -r "$HOME/.agentify-desktop/token.txt" ] \
   && [ -r "$AGENTIFY_SHARE_DIR/token.txt" ]; then
    export AGENTIFY_DESKTOP_STATE_DIR="$AGENTIFY_SHARE_DIR"
fi

ENTRYPOINT=$("$PREPARE")

exec node "$ENTRYPOINT" mcp "$@"
# Agentify Desktop - browser-session MCP (ChatGPT / Perplexity / more):4 ends here
