#!/usr/bin/env bash
# [[file:../../../agents-mcp.org::*Agentify Desktop - browser-session MCP (ChatGPT / Perplexity / more)][Agentify Desktop - browser-session MCP (ChatGPT / Perplexity / more):2]]
# ~/DotCortex/all/.local/bin/agentify-desktop-mcp
# Stdio MCP server surface of Agentify Desktop, for MCP client config blocks
# (claude .mcp.json, ~/.hermes/config.yaml mcp_servers, ~/.opencode.json).
# Dispatch is by subcommand: `agentify-desktop mcp` (verified via --help).
set -euo pipefail

if ! command -v npx >/dev/null 2>&1; then
  echo "agentify-desktop-mcp: npx not found in PATH." >&2
  exit 1
fi

exec npx -y @agentify/desktop@0.2.4 mcp "$@"
# Agentify Desktop - browser-session MCP (ChatGPT / Perplexity / more):2 ends here
