#!/usr/bin/env bash
# ~/DotCortex/all/.local/bin/withkeys
set -euo pipefail

ENV_FILE="${DOTCORTEX_KEYS_FILE:-$HOME/.env}"

usage() {
  echo "usage: withkeys NAME [NAME...] -- cmd [args] | withkeys --emit NAME... | withkeys --list" >&2
  exit 2
}

declare -A KEYS=()
read_env() {
  local line key value
  [ -r "$ENV_FILE" ] || { echo "withkeys: cannot read $ENV_FILE" >&2; exit 1; }
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%%#*}"
    case "$line" in export\ *) line="${line#export }" ;; esac
    case "$line" in *=*) ;; *) continue ;; esac
    key="${line%%=*}"
    key="${key#"${key%%[![:space:]]*}"}"
    key="${key%"${key##*[![:space:]]}"}"
    case "$key" in ''|*[!A-Za-z0-9_]*) continue ;; esac
    value="${line#*=}"
    value="${value%"${value##*[![:space:]]}"}"
    if [ "${#value}" -ge 2 ]; then
      case "$value" in
        \"*\") value="${value:1:${#value}-2}" ;;
        \'*\') value="${value:1:${#value}-2}" ;;
      esac
    fi
    KEYS["$key"]="$value"
  done < "$ENV_FILE"
}

[ $# -ge 1 ] || usage
case "$1" in
  --list)
    read_env
    printf '%s\n' "${!KEYS[@]}" | sort
    exit 0
    ;;
  --emit)
    shift
    [ $# -ge 1 ] || usage
    read_env
    for name in "$@"; do
      [ -n "${KEYS[$name]+x}" ] || { echo "withkeys: $name not in $ENV_FILE" >&2; exit 1; }
      printf 'export %s=%q\n' "$name" "${KEYS[$name]}"
    done
    exit 0
    ;;
esac

names=()
while [ $# -gt 0 ] && [ "$1" != "--" ]; do names+=("$1"); shift; done
[ "${1:-}" = "--" ] || usage
shift
[ ${#names[@]} -ge 1 ] && [ $# -ge 1 ] || usage
read_env
for name in "${names[@]}"; do
  [ -n "${KEYS[$name]+x}" ] || { echo "withkeys: $name not in $ENV_FILE" >&2; exit 1; }
  export "$name=${KEYS[$name]}"
done
exec "$@"
