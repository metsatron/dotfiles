#!/usr/bin/env bash
# [[file:../../../agents-hooks.org::*Agent IDE notifications][Agent IDE notifications:2]]
# ~/DotCortex/all/.local/bin/claude-hook-notification
set -u

[ "${CLAUDE_CODE_IDE_EL_SESSION:-}" = "1" ] || exit 0

payload=$(cat 2>/dev/null || true)
title="Claude IDE needs input"
body="Waiting for input in $(basename "$PWD")"

if command -v jq >/dev/null 2>&1 && [ -n "$payload" ]; then
  hook_title=$(printf '%s' "$payload" | jq -r '.title // empty' 2>/dev/null || true)
  hook_message=$(printf '%s' "$payload" | jq -r '.message // empty' 2>/dev/null || true)
  [ -z "$hook_title" ] || title="$hook_title"
  [ -z "$hook_message" ] || body="$hook_message"
fi

agent-ide-notify request "$title" "$body" >/dev/null 2>&1 || true
exit 0
# Agent IDE notifications:2 ends here
