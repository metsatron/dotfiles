#!/usr/bin/env python3
from __future__ import annotations

import argparse
import ast
import hashlib
import io
import os
import re
import shutil
import subprocess
import tarfile
import tempfile
from dataclasses import dataclass
from pathlib import Path, PurePosixPath

from PIL import Image, ImageColor, UnidentifiedImageError


UPSTREAM_URL = "https://github.com/KDE/kde1-kdebase.git"
GENERATED_MARKER = ".dotcortex-kde1-generated"
CACHE_NAMES = {"icon-theme.cache", ".icon-theme.cache"}
TARGET_SIZES = (16, 22, 24, 32, 48)
CATEGORIES = ("actions", "apps", "mimetypes", "places")
CONTEXTS = {
    "actions": "Actions",
    "apps": "Applications",
    "mimetypes": "MimeTypes",
    "places": "Places",
}


@dataclass(frozen=True)
class Snapshot:
    key: str
    theme: str
    title: str
    date: str
    description: str
    commit: str
    tree: str
    archive_sha256: str


SNAPSHOTS = (
    Snapshot(
        key="alpha",
        theme="KDE-1-Alpha-Original",
        title="KDE 1 Alpha Original",
        date="1997-04-13",
        description="Initial imported KDE 1-era source corpus; not a tagged release.",
