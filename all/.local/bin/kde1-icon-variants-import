    ),
    Snapshot(
        key="warm",
        theme="KDE-1-Beta-Warm-Original",
        title="KDE 1 Beta Warm Original",
        date="1997-09-13",
        description="Earliest commit carrying the warm sculpted folder corpus.",
        commit="d24816a21faa05c0ced504c0d000ac2f3b7c85b0",
        tree="7fd6a7d6ba2402522da6b9f6a7d744a1257c261a",
        archive_sha256="ff94557dc838d8aa77bb2969484afc8cc46a79e539508c418e7ecceb980c2a5c",
    ),
    Snapshot(
        key="classic",
        theme="KDE-1-Classic-Silver-Original",
