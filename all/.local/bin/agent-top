#!/usr/bin/env bash
# agent-top
# Read-only renderer, planned as htop-style operator console.
# Architecture invariants: agent-top is the TUI/operator; agent-sessiond owns process state;
# agent-session owns index write/close/archive. agent-top never writes to native stores.

# Function key plan (Phase 2N+):
#   F2 sort · F3 search · F4 toggle-closed · F5 refresh
#   F6 resume/reopen · F7 close(index) · F8 stop(SIGTERM) · F9 kill(SIGKILL)
#   Shift-F9 kill-pgid · Enter jump-to-pane · F10 quit

# Action backends:
#   resume  → party[].resume_cmd template; spawn in new tmux pane
#   close   → agent-session close <id>  (verb not yet implemented — Phase 2M gap)
#   stop    → kill -TERM <pid>
#   kill    → kill -KILL <pid>
#   pgkill  → kill -KILL -<pgid>
#   jump    → tmux select-window + select-pane

# Metadata gaps: model/provider not in state or index; context_size/window/percent require
#   harness API; CPU% requires two snapshots for delta (cpu_ticks are cumulative).

# Implementation phases: 2M non-destructive actions · 2N curses TUI · 2O destructive+confirm · 2P archive search


# [[file:../../../services.org::*agent-top][agent-top:1]]
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
_DEFAULT_STATE_DIR="${AGENT_SESSIOND_STATE_DIR:-$HOME/DotCortex/ROOTS/DotRoot/agent-session}"
export AGENT_TOP_STATE="${AGENT_SESSIOND_STATE:-${_DEFAULT_STATE_DIR}/state.latest.json}"
REFRESH_SECS="${AGENT_TOP_REFRESH:-5}"
if [ -z "${AGENT_TOP_INDEX:-}" ]; then
  case "$(hostname 2>/dev/null || echo unknown)" in
    ThinkPad-T480s|t480s) AGENT_TOP_INDEX="$HOME/mnt/x230/HelmCortex/ROOTS/AgentRoot/session-index.json" ;;
    *)                    AGENT_TOP_INDEX="$HOME/HelmCortex/ROOTS/AgentRoot/session-index.json" ;;
  esac
fi
export AGENT_TOP_INDEX="${AGENT_SESSION_INDEX:-$AGENT_TOP_INDEX}"

_find_agentd() {
  if command -v agent-sessiond >/dev/null 2>&1; then
    command -v agent-sessiond
  elif [ -x "$SCRIPT_DIR/agent-sessiond" ]; then
    printf '%s/agent-sessiond\n' "$SCRIPT_DIR"
  else
    echo "agent-top: agent-sessiond not found" >&2
    exit 1
  fi
}

usage() {
  cat <<'EOF'
Usage: agent-top [CMD] [OPTIONS]

Commands:
  once [--all]         render agent state once (default)
  watch [--all]        refresh every N seconds until interrupted
  json                 print raw agent-sessiond state JSON
  refresh              trigger agent-sessiond scan once
  jump <pid|session>   switch tmux to the agent's pane
  resume <session_id>  resume a session via its harness
  show <session_id>    show full session details
  help                 show this help

Options:
  --all  include NONE-confidence/noisy processes
         (AGENT_TOP_REFRESH controls watch interval, default 5s)
EOF
}

run_once() {
  local show_all="${1:-false}"
  python3 <<PY
import json, os, sys

STATE_FILE = os.environ.get("AGENT_TOP_STATE", "")
INDEX_FILE = os.environ.get("AGENT_TOP_INDEX", os.path.expanduser("~/HelmCortex/ROOTS/AgentRoot/session-index.json"))
SHOW_ALL = "$show_all" == "true"

BOLD = "\033[1m"
DIM  = "\033[2m"
RED  = "\033[31m"
GRN  = "\033[32m"
YLW  = "\033[33m"
CYN  = "\033[36m"
RST  = "\033[0m"


def fmt_bytes(n):
    if not n:
        return "—"
    for unit, thr in [("G", 1 << 30), ("M", 1 << 20), ("K", 1 << 10)]:
        if n >= thr:
            return f"{n/thr:.0f}{unit}"
    return f"{n}B"


def fmt_kb(kb):
    return fmt_bytes((kb or 0) * 1024)


def short_sid(s):
    if not s:
        return "—"
    return s[-12:] if len(s) > 12 else s


def cwd_name(path):
    if not path:
        return "—"
    home = os.path.expanduser("~")
    if path.startswith(home):
        path = "~" + path[len(home):]
    return path.rstrip("/").split("/")[-1] or path


def tmux_label(a):
    sn = a.get("tmux_session_name") or ""
    wn = a.get("tmux_window_name") or ""
    pi = a.get("tmux_pane_id") or ""
    if sn and wn and pi:
        return f"{sn}/{wn}/{pi}"
    if sn and wn:
        return f"{sn}/{wn}"
    if sn:
        return sn
    return "—"


def fmt_date(s):
    return (s or "")[:10] or "—"


def hr(width=82):
    print(DIM + "─" * width + RST)


def compute_tier(agent):
    has_sid = bool(agent.get("session_id"))
    has_pane = bool(agent.get("tmux_pane_id"))
    if has_sid and has_pane:
        return ("HIGH", GRN)
    if has_sid:
        return ("MED", CYN)
    if has_pane:
        return ("LOW", YLW)
    return ("NONE", DIM)


if not STATE_FILE or not os.path.isfile(STATE_FILE):
    print(f"\033[31mERROR: state file not found: {STATE_FILE or '(unset)'}\033[0m", file=sys.stderr)
    sys.exit(1)

try:
    with open(STATE_FILE) as f:
        state = json.load(f)
except Exception as e:
    print(f"\033[31mERROR: {e}\033[0m", file=sys.stderr)
    sys.exit(1)

index = {}
if os.path.isfile(INDEX_FILE):
    try:
        with open(INDEX_FILE) as f:
            idx_data = json.load(f)
            idx_list = idx_data.get("sessions", []) if isinstance(idx_data, dict) else idx_data
            index = {item.get("id"): item for item in idx_list if isinstance(item, dict) and item.get("id")}
    except Exception:
        pass

schema   = state.get("schema", "?")
host     = state.get("host", "?")
gen_at   = (state.get("generated_at") or "")[:19]
warnings = state.get("warnings") or []
agents   = state.get("active_agents") or []
stores   = state.get("native_stores") or {}
sessions = state.get("sessions") or {}

agents_with_tiers = [(a, compute_tier(a)) for a in agents]
visible = [a for a, (tier, _) in agents_with_tiers if SHOW_ALL or tier != "NONE"]
visible.sort(key=lambda a: (
    0 if compute_tier(a)[0] == "HIGH" else 1 if compute_tier(a)[0] == "MED" else 2,
    a.get("pattern", ""),
    -(a.get("rss_kb") or 0)
))

tier_counts = {}
for a, (tier, _) in agents_with_tiers:
    tier_counts[tier] = tier_counts.get(tier, 0) + 1

hr()
print(
    f"  {BOLD}agent-top{RST}  "
    f"{DIM}host{RST} {host}  "
    f"{DIM}generated{RST} {gen_at}  "
    f"{DIM}schema{RST} {schema}"
)
hr()
wc = RED if warnings else DIM
summary = f"  processes {len(agents)}"
if tier_counts.get("HIGH"):
    summary += f"   {GRN}HIGH{RST} {tier_counts.get('HIGH')}"
if tier_counts.get("MED"):
    summary += f"   {CYN}MED{RST} {tier_counts.get('MED')}"
if tier_counts.get("LOW"):
    summary += f"   {YLW}LOW{RST} {tier_counts.get('LOW')}"
if SHOW_ALL and tier_counts.get("NONE"):
    summary += f"   {DIM}NONE{RST} {tier_counts.get('NONE')}"
summary += f"   {wc}warnings{RST} {len(warnings)}"
print(summary)
print()

if visible:
    print(BOLD + "ACTIVE AGENTS" + RST)
    hr()
    print(DIM + f"  {'TIER':<5} {'AGENT':<10} {'PID':<7} {'SESSION_ID':<14} {'QUESTION':<35}" + RST)
    for a in visible:
        tier_label, tier_color = compute_tier(a)
        pattern = a.get("pattern") or "?"
        pid = str(a.get("pid") or "?")
        sid = short_sid(a.get("session_id"))
        question = "—"
        if a.get("session_id") and a.get("session_id") in index:
            idx_item = index[a.get("session_id")]
            q = idx_item.get("openquestion") or ""
            question = q[:34] if len(q) > 34 else q
        print(
            f"  {tier_color}{tier_label:<5}{RST} "
            f"{pattern:<10} "
            f"{pid:<7} "
            f"{sid:<14} "
            f"{question:<35}"
        )
    print()

if stores:
    print(BOLD + "NATIVE STORES" + RST)
    hr()
    print(DIM + f"  {'NAME':<14} {'PRESENT':<10} {'TYPE':<14} {'SESSIONS':>8}  {'NEWEST':<10}" + RST)
    for name, info in stores.items():
        present = info.get("present", False)
        pc     = GRN if present else RED
        sym    = "present  " if present else "absent   "
        stype  = (info.get("type") or "—")[:13]
        scount = str(info.get("session_count") or 0)
        newest = fmt_date(info.get("newest_mtime"))
        print(
            f"  {name:<14} {pc}{sym}{RST}"
            f"{stype:<14} {scount:>8}  {newest:<10}"
        )
    sc = sessions.get("counts") or {}
    if sc:
        print(
            f"  {DIM}index: {sc.get('total','?')} total "
            f"({sc.get('open',0)} open, "
            f"{sc.get('closed',0)} closed, "
            f"{sc.get('abandoned',0)} abandoned){RST}"
        )
    print()

if warnings:
    print(BOLD + RED + "WARNINGS" + RST)
    hr()
    for w in warnings:
        print(f"  {YLW}!{RST} {w}")
    print()
PY
}

run_refresh() {
  local agentd
  agentd="$(_find_agentd)"
  exec "$agentd" once
}

run_jump() {
  local target="${1:-}"
  if [ -z "$target" ]; then
    echo "Usage: agent-top jump <pid|session_id>" >&2
    exit 1
  fi
  python3 - "$target" <<'PY'
import json, os, re, subprocess, sys

TARGET     = sys.argv[1]
STATE_FILE = os.environ.get("AGENT_TOP_STATE", "")

if not STATE_FILE or not os.path.isfile(STATE_FILE):
    print(f"agent-top: state file not found: {STATE_FILE or '(unset)'}", file=sys.stderr)
    sys.exit(1)

state  = json.loads(open(STATE_FILE).read())
agents = state.get("active_agents") or []

hit = None
if re.fullmatch(r'\d+', TARGET):
    hit = next((a for a in agents if str(a.get("pid")) == TARGET), None)
else:
    hit = next((a for a in agents if a.get("session_id") == TARGET), None)
    if not hit:
        matches = [a for a in agents if (a.get("session_id") or "").startswith(TARGET)]
        if len(matches) == 1:
            hit = matches[0]
        elif len(matches) > 1:
            print(f"Ambiguous: {len(matches)} agents match prefix '{TARGET}'", file=sys.stderr)
            sys.exit(1)

if not hit:
    print(f"agent-top: no live agent found for '{TARGET}'", file=sys.stderr)
    sys.exit(1)

pane_id = hit.get("tmux_pane_id")
if not pane_id:
    print(f"agent-top: pid={hit.get('pid')} ({hit.get('pattern')}) has no tmux pane  [confidence={hit.get('link_confidence')}]")
    sys.exit(1)

in_tmux = bool(os.environ.get("TMUX"))
if in_tmux:
    print(f"Switching to pane {pane_id}  (agent={hit.get('pattern')} pid={hit.get('pid')})")
    subprocess.run(["tmux", "switch-client", "-t", pane_id])
else:
    print(f"Not in tmux.  Run:  tmux switch-client -t {pane_id}")
    print(f"  agent={hit.get('pattern')}  pid={hit.get('pid')}  pane={pane_id}")
PY
}

run_resume() {
  local target="${1:-}"
  if [ -z "$target" ]; then
    echo "Usage: agent-top resume <session_id>" >&2
    exit 1
  fi
  python3 - "$target" <<'PY'
import json, os, shlex, sys
from pathlib import Path

TARGET     = sys.argv[1]
STATE_FILE = os.environ.get("AGENT_TOP_STATE", "")
INDEX_FILE = os.environ.get("AGENT_TOP_INDEX", "")

entry = None
if INDEX_FILE and os.path.isfile(INDEX_FILE):
    payload  = json.loads(open(INDEX_FILE).read())
    sessions = payload.get("sessions", [])
    entry    = next((s for s in sessions if s.get("id") == TARGET), None)
    if not entry:
        matches = [s for s in sessions if (s.get("id") or "").startswith(TARGET)]
        if len(matches) == 1:
            entry = matches[0]
        elif len(matches) > 1:
            print(f"Ambiguous prefix '{TARGET}' — {len(matches)} matches:", file=sys.stderr)
            for m in matches[:5]:
                print(f"  {m.get('id')} [{m.get('agent')}] {m.get('status')}", file=sys.stderr)
            sys.exit(1)

if not entry and STATE_FILE and os.path.isfile(STATE_FILE):
    state = json.loads(open(STATE_FILE).read())
    live  = next((a for a in state.get("active_agents", []) if a.get("session_id") == TARGET), None)
    if live:
        entry = {"id": TARGET, "agent": live.get("pattern"), "cwd": live.get("cwd")}

if not entry:
    print(f"agent-top: session not found: {TARGET}", file=sys.stderr)
    sys.exit(1)

agent = entry.get("agent") or ""
sid   = entry["id"]
cwd   = entry.get("cwd") or ""

RESUME = {
    "claude":   ["claude",   "--resume", sid],
    "opencode": ["opencode", "-s",       sid],
    "codex":    ["codex",    "resume",   sid],
    "hermes":   ["hermes",   "--resume", sid],
}
argv = RESUME.get(agent)
if not argv:
    print(f"agent-top: no resume command for agent '{agent}'")
    if entry.get("file"):
        print(f"  file: {entry['file']}")
    sys.exit(0)

if cwd:
    print(f"  cd {shlex.quote(cwd)}")
    os.chdir(cwd)
print(f"  {shlex.join(argv)}")
os.execvp(argv[0], argv)
PY
}

run_show() {
  local target="${1:-}"
  if [ -z "$target" ]; then
    echo "Usage: agent-top show <session_id|pid>" >&2
    exit 1
  fi
  python3 - "$target" <<'PY'
import json, os, re, shlex, sys
from pathlib import Path

TARGET     = sys.argv[1]
STATE_FILE = os.environ.get("AGENT_TOP_STATE", "")
INDEX_FILE = os.environ.get("AGENT_TOP_INDEX", "")

BOLD = "\033[1m"; DIM = "\033[2m"; GRN = "\033[32m"
YLW  = "\033[33m"; RST = "\033[0m"

PROVIDER_MAP = {
    "claude": "anthropic", "opencode": "multi",    "codex": "openai",
    "hermes": "anthropic", "auryn":    "anthropic", "auryn-chan": "anthropic",
    "helmastra": "openai", "antigravity": "google",
}

def hr(n=78): print(DIM + "─" * n + RST)
def row(k, v, c=""): print(f"  {DIM}{k:<20}{RST} {c}{v or '—'}{RST if c else ''}")

is_pid = bool(re.fullmatch(r'\d+', TARGET))

entry = None
if INDEX_FILE and os.path.isfile(INDEX_FILE) and not is_pid:
    payload  = json.loads(open(INDEX_FILE).read())
    sessions = payload.get("sessions", [])
    entry    = next((s for s in sessions if s.get("id") == TARGET), None)
    if not entry:
        matches = [s for s in sessions if (s.get("id") or "").startswith(TARGET)]
        if len(matches) == 1:
            entry = matches[0]
        elif len(matches) > 1:
            print(f"Ambiguous: {len(matches)} sessions match '{TARGET}'", file=sys.stderr)
            for m in matches[:5]:
                print(f"  {m.get('id')} [{m.get('agent')}]", file=sys.stderr)
            sys.exit(1)

live_agents = []
if STATE_FILE and os.path.isfile(STATE_FILE):
    state      = json.loads(open(STATE_FILE).read())
    all_agents = state.get("active_agents", [])
    if is_pid:
        live_agents = [a for a in all_agents if str(a.get("pid")) == TARGET]
    else:
        sid_target  = entry["id"] if entry else TARGET
        live_agents = [a for a in all_agents if a.get("session_id") == sid_target]

if not entry and not live_agents:
    print(f"agent-top: not found: {TARGET}", file=sys.stderr)
    sys.exit(1)

hr()
if entry:
    agent  = entry.get("agent") or "?"
    sid    = entry.get("id") or TARGET
    status = entry.get("status") or "unknown"
    sc     = GRN if status == "open" else YLW if status == "unknown" else DIM
    print(f"  {BOLD}{sid}{RST}")
    hr()
    row("agent",       agent)
    row("status",      status, sc)
    row("provider",    PROVIDER_MAP.get(agent, "—"))
    row("model",       "—")
    row("context",     "—")
    row("machine",     entry.get("machine"))
    row("cwd",         entry.get("cwd"))
    row("sessiondate", entry.get("sessiondate"))
    row("signal",      entry.get("signal"))
    row("openquestion",entry.get("openquestion"))
    row("source",      entry.get("file"))
    RESUME = {
        "claude":   f"claude --resume {shlex.quote(sid)}",
        "opencode": f"opencode -s {shlex.quote(sid)}",
        "codex":    f"codex resume {shlex.quote(sid)}",
        "hermes":   f"hermes --resume {shlex.quote(sid)}",
    }
    cwd    = entry.get("cwd") or ""
    cmd    = RESUME.get(agent, "")
    prefix = f"cd {shlex.quote(cwd)} && " if (cmd and cwd) else ""
    row("resume", f"{prefix}{cmd}" if cmd else f"(no command for {agent})")
else:
    print(f"  {BOLD}{TARGET}{RST}  {DIM}(not in index){RST}")

if live_agents:
    print()
    print(f"  {BOLD}LIVE{RST}")
    hr()
    for a in live_agents:
        row("pid",        str(a.get("pid") or "?"), BOLD)
        row("pattern",    a.get("pattern"))
        row("confidence", a.get("link_confidence"))
        row("tmux_pane",  a.get("tmux_pane_id"))
        row("rss",        f"{a.get('rss_kb') or 0} KB")
        row("live_cwd",   a.get("cwd"))
        if len(live_agents) > 1:
            print()
else:
    print()
    row("live", "not currently running")
hr()
PY
}

cmd="${1:-once}"
show_all="false"

case "$cmd" in
  once|"")
    if [ "${2:-}" = "--all" ]; then
      show_all="true"
    fi
    run_once "$show_all"
    ;;
  json)
    if [ ! -s "$AGENT_TOP_STATE" ]; then
      echo "agent-top: state file not found: $AGENT_TOP_STATE" >&2
      exit 1
    fi
    exec cat "$AGENT_TOP_STATE"
    ;;
  watch)
    if [ "${2:-}" = "--all" ]; then
      show_all="true"
    fi
    trap 'exit 0' INT TERM
    while true; do
      clear
      run_once "$show_all" || true
      sleep "$REFRESH_SECS"
    done
    ;;
  refresh)
    run_refresh
    ;;
  jump)
    run_jump "${2:-}"
    ;;
  resume)
    run_resume "${2:-}"
    ;;
  show)
    run_show "${2:-}"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac
# agent-top:1 ends here
