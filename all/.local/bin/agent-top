#!/usr/bin/env bash
# agent-top
# Read-only renderer, planned as htop-style operator console.
# Architecture invariants: agent-top is the TUI/operator; agent-sessiond owns process state;
# agent-session owns index write/close/archive. agent-top never writes to native stores.

# Function key plan (Phase 2N+):
#   F2 sort · F3 search · F4 toggle-closed · F5 refresh
#   F6 resume/reopen · F7 close(index) · F8 stop(SIGTERM) · F9 kill(SIGKILL)
#   Shift-F9 kill-pgid · Enter jump-to-pane · F10 quit

# Action backends:
#   resume  → party[].resume_cmd template; spawn in new tmux pane
#   close   → agent-session close <id>  (writes session-index.json status=closed)
#   stop    → kill -TERM <pid>
#   kill    → kill -KILL <pid>
#   pgkill  → kill -KILL -<pgid>
#   jump    → tmux select-window + select-pane

# Metadata gaps: model/provider not in state or index; context_size/window/percent require
#   harness API; CPU% requires two snapshots for delta (cpu_ticks are cumulative).

# Implementation phases: 2M non-destructive actions · 2N curses TUI · 2O destructive+confirm · 2P archive search


# [[file:../../../services.org::*agent-top][agent-top:1]]
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
_DEFAULT_STATE_DIR="${AGENT_SESSIOND_STATE_DIR:-$HOME/DotCortex/ROOTS/DotRoot/agent-session}"
export AGENT_TOP_STATE="${AGENT_SESSIOND_STATE:-${_DEFAULT_STATE_DIR}/state.latest.json}"
REFRESH_SECS="${AGENT_TOP_REFRESH:-5}"
if [ -z "${AGENT_TOP_INDEX:-}" ]; then
  case "$(hostname 2>/dev/null || echo unknown)" in
    ThinkPad-T480s|t480s) AGENT_TOP_INDEX="$HOME/mnt/x230/HelmCortex/ROOTS/AgentRoot/session-index.json" ;;
    *)                    AGENT_TOP_INDEX="$HOME/HelmCortex/ROOTS/AgentRoot/session-index.json" ;;
  esac
fi
export AGENT_TOP_INDEX="${AGENT_SESSION_INDEX:-$AGENT_TOP_INDEX}"

_find_agentd() {
  if command -v agent-sessiond >/dev/null 2>&1; then
    command -v agent-sessiond
  elif [ -x "$SCRIPT_DIR/agent-sessiond" ]; then
    printf '%s/agent-sessiond\n' "$SCRIPT_DIR"
  else
    echo "agent-top: agent-sessiond not found" >&2
    exit 1
  fi
}

_find_agent_session() {
  if command -v agent-session >/dev/null 2>&1; then
    command -v agent-session
  elif [ -x "$SCRIPT_DIR/agent-session" ]; then
    printf '%s/agent-session\n' "$SCRIPT_DIR"
  else
    echo "agent-top: agent-session not found" >&2
    exit 1
  fi
}

usage() {
  cat <<'EOF'
Usage: agent-top [CMD] [OPTIONS]

Commands:
  once [--all]         render agent state once (default)
  watch [--all]        refresh every N seconds until interrupted
  json                 print raw agent-sessiond state JSON
  refresh              trigger agent-sessiond scan once
  jump <pid|session>   switch tmux to the agent's pane
  resume <session_id>  resume a session via its harness
  show <session_id>    show full session details
  tui / top            interactive curses operator console
  keytest              interactive key code diagnostic
  help                 show this help

Options:
  --all  include NONE-confidence/noisy processes
         (AGENT_TOP_REFRESH controls watch interval, default 5s)
EOF
}

run_once() {
  local show_all="${1:-false}"
  python3 <<PY
import json, os, sys

STATE_FILE = os.environ.get("AGENT_TOP_STATE", "")
INDEX_FILE = os.environ.get("AGENT_TOP_INDEX", os.path.expanduser("~/HelmCortex/ROOTS/AgentRoot/session-index.json"))
SHOW_ALL = "$show_all" == "true"

BOLD = "\033[1m"
DIM  = "\033[2m"
RED  = "\033[31m"
GRN  = "\033[32m"
YLW  = "\033[33m"
CYN  = "\033[36m"
RST  = "\033[0m"


def fmt_bytes(n):
    if not n:
        return "—"
    for unit, thr in [("G", 1 << 30), ("M", 1 << 20), ("K", 1 << 10)]:
        if n >= thr:
            return f"{n/thr:.0f}{unit}"
    return f"{n}B"


def fmt_kb(kb):
    return fmt_bytes((kb or 0) * 1024)


def short_sid(s):
    if not s:
        return "—"
    return s[-12:] if len(s) > 12 else s


def cwd_name(path):
    if not path:
        return "—"
    home = os.path.expanduser("~")
    if path.startswith(home):
        path = "~" + path[len(home):]
    return path.rstrip("/").split("/")[-1] or path


def tmux_label(a):
    sn = a.get("tmux_session_name") or ""
    wn = a.get("tmux_window_name") or ""
    pi = a.get("tmux_pane_id") or ""
    if sn and wn and pi:
        return f"{sn}/{wn}/{pi}"
    if sn and wn:
        return f"{sn}/{wn}"
    if sn:
        return sn
    return "—"


def fmt_date(s):
    return (s or "")[:10] or "—"


def hr(width=82):
    print(DIM + "─" * width + RST)


def compute_tier(agent):
    has_sid = bool(agent.get("session_id"))
    has_pane = bool(agent.get("tmux_pane_id"))
    if has_sid and has_pane:
        return ("HIGH", GRN)
    if has_sid:
        return ("MED", CYN)
    if has_pane:
        return ("LOW", YLW)
    return ("NONE", DIM)


if not STATE_FILE or not os.path.isfile(STATE_FILE):
    print(f"\033[31mERROR: state file not found: {STATE_FILE or '(unset)'}\033[0m", file=sys.stderr)
    sys.exit(1)

try:
    with open(STATE_FILE) as f:
        state = json.load(f)
except Exception as e:
    print(f"\033[31mERROR: {e}\033[0m", file=sys.stderr)
    sys.exit(1)

index = {}
if os.path.isfile(INDEX_FILE):
    try:
        with open(INDEX_FILE) as f:
            idx_data = json.load(f)
            idx_list = idx_data.get("sessions", []) if isinstance(idx_data, dict) else idx_data
            index = {item.get("id"): item for item in idx_list if isinstance(item, dict) and item.get("id")}
    except Exception:
        pass

schema   = state.get("schema", "?")
host     = state.get("host", "?")
gen_at   = (state.get("generated_at") or "")[:19]
warnings = state.get("warnings") or []
agents   = state.get("active_agents") or []
stores   = state.get("native_stores") or {}
sessions = state.get("sessions") or {}

agents_with_tiers = [(a, compute_tier(a)) for a in agents]
visible = [a for a, (tier, _) in agents_with_tiers if SHOW_ALL or tier != "NONE"]
visible.sort(key=lambda a: (
    0 if compute_tier(a)[0] == "HIGH" else 1 if compute_tier(a)[0] == "MED" else 2,
    a.get("pattern", ""),
    -(a.get("rss_kb") or 0)
))

tier_counts = {}
for a, (tier, _) in agents_with_tiers:
    tier_counts[tier] = tier_counts.get(tier, 0) + 1

hr()
print(
    f"  {BOLD}agent-top{RST}  "
    f"{DIM}host{RST} {host}  "
    f"{DIM}generated{RST} {gen_at}  "
    f"{DIM}schema{RST} {schema}"
)
hr()
wc = RED if warnings else DIM
summary = f"  processes {len(agents)}"
if tier_counts.get("HIGH"):
    summary += f"   {GRN}HIGH{RST} {tier_counts.get('HIGH')}"
if tier_counts.get("MED"):
    summary += f"   {CYN}MED{RST} {tier_counts.get('MED')}"
if tier_counts.get("LOW"):
    summary += f"   {YLW}LOW{RST} {tier_counts.get('LOW')}"
if SHOW_ALL and tier_counts.get("NONE"):
    summary += f"   {DIM}NONE{RST} {tier_counts.get('NONE')}"
summary += f"   {wc}warnings{RST} {len(warnings)}"
print(summary)
print()

if visible:
    print(BOLD + "ACTIVE AGENTS" + RST)
    hr()
    print(DIM + f"  {'TIER':<5} {'AGENT':<10} {'PID':<7} {'SESSION_ID':<14} {'QUESTION':<35}" + RST)
    for a in visible:
        tier_label, tier_color = compute_tier(a)
        pattern = a.get("pattern") or "?"
        pid = str(a.get("pid") or "?")
        sid = short_sid(a.get("session_id"))
        question = "—"
        if a.get("session_id") and a.get("session_id") in index:
            idx_item = index[a.get("session_id")]
            q = idx_item.get("openquestion") or ""
            question = q[:34] if len(q) > 34 else q
        print(
            f"  {tier_color}{tier_label:<5}{RST} "
            f"{pattern:<10} "
            f"{pid:<7} "
            f"{sid:<14} "
            f"{question:<35}"
        )
    print()

if stores:
    print(BOLD + "NATIVE STORES" + RST)
    hr()
    print(DIM + f"  {'NAME':<14} {'PRESENT':<10} {'TYPE':<14} {'SESSIONS':>8}  {'NEWEST':<10}" + RST)
    for name, info in stores.items():
        present = info.get("present", False)
        pc     = GRN if present else RED
        sym    = "present  " if present else "absent   "
        stype  = (info.get("type") or "—")[:13]
        scount = str(info.get("session_count") or 0)
        newest = fmt_date(info.get("newest_mtime"))
        print(
            f"  {name:<14} {pc}{sym}{RST}"
            f"{stype:<14} {scount:>8}  {newest:<10}"
        )
    sc = sessions.get("counts") or {}
    if sc:
        print(
            f"  {DIM}index: {sc.get('total','?')} total "
            f"({sc.get('open',0)} open, "
            f"{sc.get('closed',0)} closed, "
            f"{sc.get('abandoned',0)} abandoned){RST}"
        )
    print()

if warnings:
    print(BOLD + RED + "WARNINGS" + RST)
    hr()
    for w in warnings:
        print(f"  {YLW}!{RST} {w}")
    print()
PY
}

run_refresh() {
  local agentd
  agentd="$(_find_agentd)"
  exec "$agentd" once
}

run_jump() {
  local target="${1:-}"
  if [ -z "$target" ]; then
    echo "Usage: agent-top jump <pid|session_id>" >&2
    exit 1
  fi
  python3 - "$target" <<'PY'
import json, os, re, subprocess, sys

TARGET     = sys.argv[1]
STATE_FILE = os.environ.get("AGENT_TOP_STATE", "")

if not STATE_FILE or not os.path.isfile(STATE_FILE):
    print(f"agent-top: state file not found: {STATE_FILE or '(unset)'}", file=sys.stderr)
    sys.exit(1)

state  = json.loads(open(STATE_FILE).read())
agents = state.get("active_agents") or []

hit = None
if re.fullmatch(r'\d+', TARGET):
    hit = next((a for a in agents if str(a.get("pid")) == TARGET), None)
else:
    hit = next((a for a in agents if a.get("session_id") == TARGET), None)
    if not hit:
        matches = [a for a in agents if (a.get("session_id") or "").startswith(TARGET)]
        if len(matches) == 1:
            hit = matches[0]
        elif len(matches) > 1:
            print(f"Ambiguous: {len(matches)} agents match prefix '{TARGET}'", file=sys.stderr)
            sys.exit(1)

if not hit:
    print(f"agent-top: no live agent found for '{TARGET}'", file=sys.stderr)
    sys.exit(1)

pane_id = hit.get("tmux_pane_id")
if not pane_id:
    print(f"agent-top: pid={hit.get('pid')} ({hit.get('pattern')}) has no tmux pane  [confidence={hit.get('link_confidence')}]")
    sys.exit(1)

in_tmux = bool(os.environ.get("TMUX"))
if in_tmux:
    print(f"Switching to pane {pane_id}  (agent={hit.get('pattern')} pid={hit.get('pid')})")
    subprocess.run(["tmux", "switch-client", "-t", pane_id])
else:
    print(f"Not in tmux.  Run:  tmux switch-client -t {pane_id}")
    print(f"  agent={hit.get('pattern')}  pid={hit.get('pid')}  pane={pane_id}")
PY
}

run_resume() {
  local target="${1:-}"
  if [ -z "$target" ]; then
    echo "Usage: agent-top resume <session_id>" >&2
    exit 1
  fi
  python3 - "$target" <<'PY'
import json, os, shlex, sys
from pathlib import Path

TARGET     = sys.argv[1]
STATE_FILE = os.environ.get("AGENT_TOP_STATE", "")
INDEX_FILE = os.environ.get("AGENT_TOP_INDEX", "")

entry = None
if INDEX_FILE and os.path.isfile(INDEX_FILE):
    payload  = json.loads(open(INDEX_FILE).read())
    sessions = payload.get("sessions", [])
    entry    = next((s for s in sessions if s.get("id") == TARGET), None)
    if not entry:
        matches = [s for s in sessions if (s.get("id") or "").startswith(TARGET)]
        if len(matches) == 1:
            entry = matches[0]
        elif len(matches) > 1:
            print(f"Ambiguous prefix '{TARGET}' — {len(matches)} matches:", file=sys.stderr)
            for m in matches[:5]:
                print(f"  {m.get('id')} [{m.get('agent')}] {m.get('status')}", file=sys.stderr)
            sys.exit(1)

if not entry and STATE_FILE and os.path.isfile(STATE_FILE):
    state = json.loads(open(STATE_FILE).read())
    live  = next((a for a in state.get("active_agents", []) if a.get("session_id") == TARGET), None)
    if live:
        entry = {"id": TARGET, "agent": live.get("pattern"), "cwd": live.get("cwd")}

if not entry:
    print(f"agent-top: session not found: {TARGET}", file=sys.stderr)
    sys.exit(1)

agent = entry.get("agent") or ""
sid   = entry["id"]
cwd   = entry.get("cwd") or ""

RESUME = {
    "claude":   ["claude",   "--resume", sid],
    "opencode": ["opencode", "-s",       sid],
    "codex":    ["codex",    "resume",   sid],
    "hermes":   ["hermes",   "--resume", sid],
}
argv = RESUME.get(agent)
if not argv:
    print(f"agent-top: no resume command for agent '{agent}'")
    if entry.get("file"):
        print(f"  file: {entry['file']}")
    sys.exit(0)

if cwd:
    print(f"  cd {shlex.quote(cwd)}")
    os.chdir(cwd)
print(f"  {shlex.join(argv)}")
os.execvp(argv[0], argv)
PY
}

run_show() {
  local target="${1:-}"
  if [ -z "$target" ]; then
    echo "Usage: agent-top show <session_id|pid>" >&2
    exit 1
  fi
  python3 - "$target" <<'PY'
import json, os, re, shlex, sys
from pathlib import Path

TARGET     = sys.argv[1]
STATE_FILE = os.environ.get("AGENT_TOP_STATE", "")
INDEX_FILE = os.environ.get("AGENT_TOP_INDEX", "")

BOLD = "\033[1m"; DIM = "\033[2m"; GRN = "\033[32m"
YLW  = "\033[33m"; RST = "\033[0m"

def hr(n=78): print(DIM + "─" * n + RST)
def row(k, v, c=""): print(f"  {DIM}{k:<20}{RST} {c}{v or '—'}{RST if c else ''}")
def fmt_tok(n):
    if n is None: return "—"
    if n >= 1_000_000: return f"{n/1_000_000:.1f}M"
    if n >= 1_000:     return f"{n/1_000:.1f}k"
    return str(n)

is_pid = bool(re.fullmatch(r'\d+', TARGET))

entry = None
if INDEX_FILE and os.path.isfile(INDEX_FILE) and not is_pid:
    payload  = json.loads(open(INDEX_FILE).read())
    sessions = payload.get("sessions", [])
    entry    = next((s for s in sessions if s.get("id") == TARGET), None)
    if not entry:
        matches = [s for s in sessions if (s.get("id") or "").startswith(TARGET)]
        if len(matches) == 1:
            entry = matches[0]
        elif len(matches) > 1:
            print(f"Ambiguous: {len(matches)} sessions match '{TARGET}'", file=sys.stderr)
            for m in matches[:5]:
                print(f"  {m.get('id')} [{m.get('agent')}]", file=sys.stderr)
            sys.exit(1)

live_agents = []
if STATE_FILE and os.path.isfile(STATE_FILE):
    state      = json.loads(open(STATE_FILE).read())
    all_agents = state.get("active_agents", [])
    if is_pid:
        live_agents = [a for a in all_agents if str(a.get("pid")) == TARGET]
    else:
        sid_target  = entry["id"] if entry else TARGET
        live_agents = [a for a in all_agents if a.get("session_id") == sid_target]

if not entry and not live_agents:
    print(f"agent-top: not found: {TARGET}", file=sys.stderr)
    sys.exit(1)

hr()
if entry:
    agent  = entry.get("agent") or "?"
    sid    = entry.get("id") or TARGET
    status = entry.get("status") or "unknown"
    sc     = GRN if status == "open" else YLW if status == "unknown" else DIM
    print(f"  {BOLD}{sid}{RST}")
    hr()
    row("agent",       agent)
    row("status",      status, sc)
    _la = next(iter(live_agents), {})
    row("provider",    f"{_la.get('provider') or '—'}  [{_la.get('provider_source') or 'unknown'}]")
    row("model",       f"{_la.get('model') or '—'}  [{_la.get('model_source') or 'unknown'}]")
    row("machine",     entry.get("machine"))
    row("cwd",         entry.get("cwd"))
    row("sessiondate", entry.get("sessiondate"))
    row("signal",      entry.get("signal"))
    row("openquestion",entry.get("openquestion"))
    row("source",      entry.get("file"))
    RESUME = {
        "claude":   f"claude --resume {shlex.quote(sid)}",
        "opencode": f"opencode -s {shlex.quote(sid)}",
        "codex":    f"codex resume {shlex.quote(sid)}",
        "hermes":   f"hermes --resume {shlex.quote(sid)}",
    }
    cwd    = entry.get("cwd") or ""
    cmd    = RESUME.get(agent, "")
    prefix = f"cd {shlex.quote(cwd)} && " if (cmd and cwd) else ""
    row("resume", f"{prefix}{cmd}" if cmd else f"(no command for {agent})")
else:
    print(f"  {BOLD}{TARGET}{RST}  {DIM}(not in index){RST}")

if live_agents:
    print()
    print(f"  {BOLD}LIVE{RST}")
    hr()
    for a in live_agents:
        row("pid",        str(a.get("pid") or "?"), BOLD)
        row("pattern",    a.get("pattern"))
        row("confidence", a.get("link_confidence"))
        row("provider",   f"{a.get('provider') or '—'}  [{a.get('provider_source') or 'unknown'}]")
        row("model",      f"{a.get('model') or '—'}  [{a.get('model_source') or 'unknown'}]")
        _cpct  = a.get("context_percent")
        _age   = a.get("metadata_age_s")
        _stale = a.get("metadata_stale")
        def _fmt_age(s):
            if s is None: return "—"
            if s < 60:    return f"{s}s"
            if s < 3600:  return f"{s//60}m"
            if s < 86400: return f"{s//3600}h"
            return f"{s//86400}d"
        row("ctx_size",   f"{fmt_tok(a.get('context_size'))}  [{a.get('context_size_source') or 'unknown'}]")
        row("ctx_window", f"{fmt_tok(a.get('context_window'))}  [{a.get('context_window_source') or 'unknown'}]")
        row("ctx_pct",    f"{_cpct:.1f}%" if _cpct is not None else "—")
        row("meta_age",   f"{_fmt_age(_age)}{'  [stale]' if _stale else ''}")
        row("tmux_pane",  a.get("tmux_pane_id"))
        row("rss",        f"{a.get('rss_kb') or 0} KB")
        row("live_cwd",   a.get("cwd"))
        if len(live_agents) > 1:
            print()
else:
    print()
    row("live", "not currently running")
hr()
PY
}

run_tui() {
  local agentd agent_session
  agentd="$(_find_agentd)"
  agent_session="$(_find_agent_session)"
  python3 - "$agentd" "$agent_session" <<'PY'
import curses, json, os, shlex, signal, subprocess, sys, time

AGENTD        = sys.argv[1] if len(sys.argv) > 1 else "agent-sessiond"
AGENT_SESSION = sys.argv[2] if len(sys.argv) > 2 else "agent-session"
STATE_FILE = os.environ.get("AGENT_TOP_STATE", "")
INDEX_FILE = os.environ.get("AGENT_TOP_INDEX", "")

# Family hints only — not used for display; actual provider/model comes from state JSON.
PROVIDER_MAP = {
    "claude": "anthropic", "opencode": "—",         "codex": "openai",
    "hermes": "anthropic", "auryn":    "anthropic", "auryn-chan": "anthropic",
    "helmastra": "openai", "antigravity": "google",
}
RESUME_ARGV = {
    "claude":   lambda s: ["claude",   "--resume", s],
    "opencode": lambda s: ["opencode", "-s",       s],
    "codex":    lambda s: ["codex",    "resume",   s],
    "hermes":   lambda s: ["hermes",   "--resume", s],
}
SORT_FIELDS = ["tier", "agent", "pid", "rss", "io_write", "status", "title", "ctx", "model", "prov"]

def fmt_kb(kb):
    n = (kb or 0) * 1024
    if not n:
        return "—"
    for unit, thr in [("G", 1 << 30), ("M", 1 << 20), ("K", 1 << 10)]:
        if n >= thr:
            return f"{n/thr:.0f}{unit}"
    return f"{n}B"

def fmt_ctx(n):
    if n is None: return "—"
    if n >= 1_000_000: return f"{n/1_000_000:.1f}M"
    if n >= 1_000:     return f"{n/1_000:.1f}k"
    return str(n)

def short_sid(s):
    return (s[-12:] if s and len(s) > 12 else s) or "—"

def cwd_base(path):
    if not path:
        return "—"
    home = os.path.expanduser("~")
    p = ("~" + path[len(home):]) if path.startswith(home) else path
    return p.rstrip("/").split("/")[-1] or p

def tier_of(a):
    if a.get("session_id") and a.get("tmux_pane_id"):
        return "HIGH"
    if a.get("session_id"):
        return "MED"
    if a.get("tmux_pane_id"):
        return "LOW"
    return "NONE"

def tier_ord(t):
    return {"HIGH": 0, "MED": 1, "LOW": 2, "NONE": 3}.get(t, 4)

def load_data(show_closed=False):
    state = {}
    if STATE_FILE and os.path.isfile(STATE_FILE):
        try:
            state = json.loads(open(STATE_FILE).read())
        except Exception:
            pass
    index = {}
    if INDEX_FILE and os.path.isfile(INDEX_FILE):
        try:
            raw = json.loads(open(INDEX_FILE).read())
            lst = raw.get("sessions", []) if isinstance(raw, dict) else raw
            index = {s.get("id"): s for s in lst if isinstance(s, dict) and s.get("id")}
        except Exception:
            pass
    state_host = state.get("host") or "?"
    rows = []
    for a in (state.get("active_agents") or []):
        tier = tier_of(a)
        idx  = index.get(a.get("session_id")) or {}
        ist  = idx.get("status") or ""
        if not show_closed and ist in ("closed", "abandoned"):
            continue
        r = dict(a)
        r["_tier"]       = tier
        r["_prov"]       = a.get("provider")              or "—"
        r["_prov_src"]   = a.get("provider_source")       or "unknown"
        r["_model"]      = a.get("model")                 or "—"
        r["_model_src"]  = a.get("model_source")          or "unknown"
        r["_model_conf"] = a.get("model_confidence")      or "none"
        r["_ctx_size"]   = a.get("context_size")
        r["_ctx_src"]    = a.get("context_size_source")   or "unknown"
        r["_ctx_win"]    = a.get("context_window")
        r["_ctx_win_src"]= a.get("context_window_source") or "unknown"
        r["_ctx_pct"]    = a.get("context_percent")
        r["_meta_stale"] = a.get("metadata_stale") or False
        r["_meta_age"]   = a.get("metadata_age_s")
        r["_title"] = idx.get("openquestion") or idx.get("title") or ""
        r["_ist"]   = ist or "—"
        r["_mach"]  = idx.get("machine") or state_host
        r["_idx"]   = idx
        rows.append(r)
    return state, rows

def sort_rows(rows, sf):
    def key(r):
        if sf == "tier":     return (tier_ord(r["_tier"]), r.get("pattern", ""))
        if sf == "agent":    return (r.get("pattern", ""), tier_ord(r["_tier"]))
        if sf == "pid":      return (r.get("pid") or 0,)
        if sf == "rss":      return (-(r.get("rss_kb") or 0),)
        if sf == "io_write": return (-(r.get("io_write_bytes") or 0),)
        if sf == "status":   return (r.get("_ist", ""), r.get("pattern", ""))
        if sf == "title":    return (r.get("_title", "").lower(),)
        if sf == "ctx":      return (-(r.get("_ctx_pct") or 0),)
        if sf == "model":    return (r.get("_model", ""), r.get("pattern", ""))
        if sf == "prov":     return (r.get("_prov", ""), r.get("pattern", ""))
        return (0,)
    return sorted(rows, key=key)

def filter_rows(rows, q):
    if not q:
        return rows
    ql = q.lower()
    def m(r):
        return any(ql in (v or "").lower() for v in [
            r.get("pattern"), str(r.get("pid") or ""),
            r.get("session_id"), r.get("_title"), r.get("_mach"),
            r.get("cwd"), r.get("_ist"), r.get("_prov"),
        ])
    return [r for r in rows if m(r)]

DEBUG   = os.environ.get("AGENT_TOP_TUI_DEBUG") == "1"
_dbg_fh = None
def dbg(msg):
    global _dbg_fh
    if not DEBUG:
        return
    if _dbg_fh is None:
        _dbg_fh = open("/tmp/agent-top-tui.log", "a", buffering=1)
    _dbg_fh.write(f"[{time.strftime('%H:%M:%S')}] {msg}\n")

class TUI:
    HELP = [
        " agent-top  —  interactive operator console",
        "",
        " Navigation  (Colemak-NEIO primary / arrow keys also work)",
        "  i / UpArrow        move selection up",
        "  e / DownArrow      move selection down",
        "  PgUp / PgDn        scroll pages",
        "  Home / End         jump top/bottom",
        "",
        " Actions",
        "  Enter / o          jump to tmux pane",
        "  Space              show session details",
        "  r / F5             refresh (agent-sessiond once)",
        "  R / F6             resume selected session",
        "  c / F7             close session (marks index as closed)",
        "  t / F8             polite stop  (SIGTERM)",
        "",
        " Display",
        "  s / F2             cycle sort field",
        "  / / F3             incremental search  (Esc clears)",
        "  a / F4             toggle closed/archive visibility",
        "",
        " Not yet wired",
        "  F9                 kill  (SIGKILL)",
        "",
        " Quit",
        "  q / F10            quit",
        "  ? / F1             this help",
        "",
        " Press any key to close",
    ]

    def __init__(self, scr):
        self.scr         = scr
        self.sel         = 0
        self.offset      = 0
        self.sort_idx    = 0
        self.query       = ""
        self.searching   = False
        self.show_closed = False
        self.status_msg  = ""
        self.status_ts   = 0.0
        self.state       = {}
        self.all_rows    = []
        self.visible     = []
        self.reload()
        scr.keypad(True)
        curses.noecho()
        curses.cbreak()
        try: curses.curs_set(0)
        except curses.error: pass
        scr.timeout(5000)
        self._init_colors()

    def _init_colors(self):
        curses.start_color()
        try:
            curses.use_default_colors()
            bg = -1
        except Exception:
            bg = curses.COLOR_BLACK
        curses.init_pair(1, curses.COLOR_GREEN,  bg)
        curses.init_pair(2, curses.COLOR_CYAN,   bg)
        curses.init_pair(3, curses.COLOR_YELLOW, bg)
        curses.init_pair(7, curses.COLOR_BLACK,  curses.COLOR_WHITE)

    def tier_attr(self, t):
        return {
            "HIGH": curses.color_pair(1) | curses.A_BOLD,
            "MED":  curses.color_pair(2),
            "LOW":  curses.color_pair(3),
            "NONE": curses.A_DIM,
        }.get(t, curses.A_NORMAL)

    def reload(self):
        self.state, self.all_rows = load_data(self.show_closed)
        self.refresh_visible()

    def refresh_visible(self):
        sf = SORT_FIELDS[self.sort_idx]
        rows = sort_rows(self.all_rows, sf)
        self.visible = filter_rows(rows, self.query)
        if self.sel >= len(self.visible):
            self.sel = max(0, len(self.visible) - 1)

    def set_status(self, msg):
        self.status_msg = msg
        self.status_ts  = time.time()

    def _end_curses(self):
        try: curses.nocbreak()
        except curses.error: pass
        try: self.scr.keypad(False)
        except curses.error: pass
        try: curses.echo()
        except curses.error: pass
        try: curses.endwin()
        except curses.error: pass

    def draw(self):
        h, w = self.scr.getmaxyx()
        if h < 5 or w < 40:
            try:
                self.scr.addstr(0, 0, "Terminal too small (need 40x5)")
            except curses.error:
                pass
            self.scr.refresh()
            return
        self.scr.erase()
        self._draw_header(0, w)
        self._draw_col_hdr(1, w)
        table_h = h - 3
        if self.sel < self.offset:
            self.offset = self.sel
        elif self.sel >= self.offset + table_h:
            self.offset = self.sel - table_h + 1
        for i in range(table_h):
            ri = self.offset + i
            if ri >= len(self.visible):
                break
            self._draw_row(2 + i, w, self.visible[ri], ri == self.sel)
        self._draw_status(h - 1, w)
        self.scr.refresh()

    def _col_widths(self, w):
        fixed = [
            ("TIER", 5), ("AGENT", 10), ("PID", 7), ("SESSION", 14),
            ("STATUS", 8), ("MACH", 8), ("PROV", 9), ("CTX%", 5), ("RSS", 6), ("PS", 3),
            ("PANE", 14), ("CWD", 12),
        ]
        used = 2 + sum(cw for _, cw in fixed) + len(fixed)
        return fixed + [("TITLE", max(4, w - used - 1))]

    def _draw_header(self, y, w):
        st  = self.state
        hst = st.get("host", "?")
        gat = (st.get("generated_at") or "")[:19]
        sch = st.get("schema", "?")
        sf  = SORT_FIELDS[self.sort_idx]
        cf  = "  +closed" if self.show_closed else ""
        hdr = (f" agent-top  {hst}  {gat}  schema:{sch}"
               f"  active:{len(self.all_rows)}  vis:{len(self.visible)}"
               f"  sort:{sf}{cf}")
        try:
            self.scr.addstr(y, 0, hdr[:w - 1].ljust(w - 1),
                            curses.A_REVERSE | curses.A_BOLD)
        except curses.error:
            pass

    def _draw_col_hdr(self, y, w):
        cols = self._col_widths(w)
        line = "  " + " ".join(f"{name:<{cw}}" for name, cw in cols)
        try:
            self.scr.addstr(y, 0, line[:w - 1], curses.A_DIM)
        except curses.error:
            pass

    def _draw_row(self, y, w, r, sel):
        tier = r["_tier"]
        cols = self._col_widths(w)
        tw   = cols[-1][1]
        ps   = (r.get("proc_status") or "?")[:3]
        mach = (r.get("_mach") or "—")[:8]
        cpct = r.get("_ctx_pct")
        if cpct is not None:
            ctx_s = ("~" if r.get("_meta_stale") else "") + f"{cpct:.0f}%"
        else:
            ctx_s = "—"
        fields = [
            f"{tier:<5}",
            f"{(r.get('pattern') or '?')[:10]:<10}",
            f"{str(r.get('pid') or '?'):<7}",
            f"{short_sid(r.get('session_id')):<14}",
            f"{r.get('_ist', '—')[:8]:<8}",
            f"{mach:<8}",
            f"{r.get('_prov', '—')[:9]:<9}",
            f"{ctx_s[:5]:<5}",
            f"{fmt_kb(r.get('rss_kb'))[:6]:<6}",
            f"{ps:<3}",
            f"{(r.get('tmux_pane_id') or '—')[:14]:<14}",
            f"{cwd_base(r.get('cwd'))[:12]:<12}",
            f"{(r.get('_title') or '')[:tw]:<{tw}}",
        ]
        line = "  " + " ".join(fields)
        try:
            if sel:
                self.scr.addstr(y, 0, line[:w - 1], curses.color_pair(7))
            else:
                self.scr.addstr(y, 0, line[:w - 1])
                self.scr.addstr(y, 2, f"{tier:<5}", self.tier_attr(tier))
        except curses.error:
            pass

    def _draw_status(self, y, w):
        if self.searching:
            bar = f" /{self.query}█  Esc:clear  Enter:done"
        elif self.status_msg and (time.time() - self.status_ts) < 5:
            bar = f" {self.status_msg}"
        else:
            bar = (" ?:help  s:sort  /:search  a:±closed"
                   "  r:refresh  Enter:jump  Spc:show  R:resume  c:close  t:stop  q:quit")
        try:
            self.scr.addstr(y, 0, bar[:w - 1].ljust(w - 1), curses.A_REVERSE)
        except curses.error:
            pass

    def run(self):
        while True:
            self.draw()
            key = self.scr.getch()
            if key == curses.ERR:
                self.reload()
                continue
            dbg(f"key={key} name={curses.keyname(key)}")
            if self.searching:
                self._search_key(key)
            elif not self._normal_key(key):
                break

    def _search_key(self, key):
        if key == 27:
            self.searching = False
            self.query = ""
            self.refresh_visible()
        elif key in (curses.KEY_BACKSPACE, 127, 8):
            self.query = self.query[:-1]
            self.refresh_visible()
        elif key == ord('\n'):
            self.searching = False
        elif 32 <= key < 127:
            self.query += chr(key)
            self.refresh_visible()

    def _normal_key(self, key):
        n  = len(self.visible)
        h, _ = self.scr.getmaxyx()
        pg = max(1, h - 3)
        # Movement — Colemak-NEIO primary; arrow keys always work
        if key in (ord('q'), curses.KEY_F10):
            return False
        elif key in (curses.KEY_UP, ord('i')):
            self.sel = max(0, self.sel - 1)
        elif key in (curses.KEY_DOWN, ord('e')):
            self.sel = min(max(0, n - 1), self.sel + 1)
        elif key == curses.KEY_PPAGE:
            self.sel = max(0, self.sel - pg)
        elif key == curses.KEY_NPAGE:
            self.sel = min(max(0, n - 1), self.sel + pg)
        elif key == curses.KEY_HOME:
            self.sel = 0
        elif key == curses.KEY_END:
            self.sel = max(0, n - 1)
        # Jump / inspect
        elif key in (curses.KEY_ENTER, ord('\n'), ord('\r'), ord('o')):
            self._action_jump()
        elif key == ord(' '):
            self._action_show()
        # Help
        elif key in (curses.KEY_F1, ord('?')):
            self._overlay(self.HELP, " Help ")
        # Sort
        elif key in (curses.KEY_F2, ord('s')):
            self.sort_idx = (self.sort_idx + 1) % len(SORT_FIELDS)
            self.refresh_visible()
            self.set_status(f"Sort: {SORT_FIELDS[self.sort_idx]}")
        # Search
        elif key in (curses.KEY_F3, ord('/')):
            self.searching = True
        # Toggle closed
        elif key in (curses.KEY_F4, ord('a')):
            self.show_closed = not self.show_closed
            self.reload()
            self.set_status(f"Closed sessions: {'shown' if self.show_closed else 'hidden'}")
        # Refresh
        elif key in (curses.KEY_F5, ord('r')):
            self._action_refresh()
        # Resume
        elif key in (curses.KEY_F6, ord('R')):
            self._action_resume()
        # Close
        elif key in (curses.KEY_F7, ord('c')):
            self._action_close()
        # Polite stop (SIGTERM)
        elif key in (curses.KEY_F8, ord('t')):
            self._action_stop()
        elif key == curses.KEY_F9:
            self.set_status("F9 kill (SIGKILL) not wired yet")
        elif key == curses.KEY_RESIZE:
            self.scr.clear()
            dbg("resize")
        return True

    def _sel_row(self):
        if self.visible and 0 <= self.sel < len(self.visible):
            return self.visible[self.sel]
        return None

    def _action_jump(self):
        r = self._sel_row()
        if not r:
            self.set_status("No row selected")
            return
        pane = r.get("tmux_pane_id")
        if not pane:
            self.set_status(
                f"No tmux pane  pid={r.get('pid')} [{r.get('pattern')}]"
                f"  conf={r.get('link_confidence')}"
            )
            return
        if os.environ.get("TMUX"):
            try:
                subprocess.run(["tmux", "switch-client", "-t", pane], check=False)
                self.set_status(f"Switched to pane {pane}")
            except Exception as e:
                self.set_status(f"tmux error: {e}")
        else:
            self.set_status(f"Not in tmux — run: tmux switch-client -t {pane}")

    def _action_show(self):
        r = self._sel_row()
        if not r:
            return
        _, w  = self.scr.getmaxyx()
        idx   = r.get("_idx") or {}
        agent = r.get("pattern") or "?"
        sid   = r.get("session_id") or "?"
        cwd_v = idx.get("cwd") or r.get("cwd") or ""
        argv  = RESUME_ARGV.get(agent, lambda s: [])(sid)
        if argv and cwd_v:
            resume_s = f"cd {shlex.quote(cwd_v)} && {shlex.join(argv)}"
        elif argv:
            resume_s = shlex.join(argv)
        else:
            resume_s = f"(no command for {agent})"
        mw = min(74, w - 4)
        def _fmt_age(s):
            if s is None: return "—"
            if s < 60:    return f"{s}s"
            if s < 3600:  return f"{s//60}m"
            if s < 86400: return f"{s//3600}h"
            return f"{s//86400}d"
        _meta_age   = r.get("_meta_age")
        _meta_stale = r.get("_meta_stale")
        lines = [
            f" {sid}",
            "",
            f" agent:    {agent}",
            f" status:   {r.get('_ist', '—')}",
            f" machine:  {r.get('_mach') or '—'}",
            f" provider: {r.get('_prov', '—')}  [{r.get('_prov_src', 'unknown')}]",
            f" model:    {r.get('_model') or '—'}  [{r.get('_model_src', 'unknown')}]",
            f" ctx_size: {fmt_ctx(r.get('_ctx_size'))}  [{r.get('_ctx_src', 'unknown')}]",
            f" ctx_win:  {fmt_ctx(r.get('_ctx_win'))}  [{r.get('_ctx_win_src', 'unknown')}]",
            f" ctx_pct:  {f\"{r.get('_ctx_pct'):.1f}%\" if r.get('_ctx_pct') is not None else '—'}",
            f" meta_age: {_fmt_age(_meta_age)}{'  [stale]' if _meta_stale else ''}",
            f" cwd:      {cwd_v or '—'}",
            f" date:     {idx.get('sessiondate') or '—'}",
            f" signal:   {idx.get('signal') or '—'}",
            f" question: {(idx.get('openquestion') or '')[:mw - 12]}",
            "",
            f" pid:      {r.get('pid') or '—'}",
            f" proc:     {r.get('proc_status') or '—'}",
            f" rss:      {fmt_kb(r.get('rss_kb'))}",
            f" pane:     {r.get('tmux_pane_id') or '—'}",
            f" live_cwd: {r.get('cwd') or '—'}",
            "",
            f" resume:   {resume_s[:mw - 12]}",
            "",
            " Press any key to close",
        ]
        self._overlay(lines, " Session Details ", w_hint=mw)

    def _action_refresh(self):
        try:
            subprocess.run([AGENTD, "once"], capture_output=True, timeout=30)
            self.reload()
            gat = (self.state.get("generated_at") or "")[:19]
            self.set_status(f"Refreshed at {gat}")
        except subprocess.TimeoutExpired:
            self.set_status("Refresh timed out")
        except Exception as e:
            self.set_status(f"Refresh error: {e}")

    def _action_close(self):
        r = self._sel_row()
        if not r:
            self.set_status("No row selected")
            return
        sid = r.get("session_id") or ""
        if not sid:
            self.set_status(
                f"No session_id  pid={r.get('pid')} [{r.get('pattern')}]"
            )
            return
        ist = r.get("_ist") or ""
        if ist in ("closed", "abandoned"):
            self.set_status(f"Already {ist}: {short_sid(sid)}")
            return
        agent  = r.get("pattern") or "?"
        title_s = (r.get("_title") or "")[:25]
        tail   = f" {title_s}" if title_s else ""
        prompt = f" Close {short_sid(sid)} [{agent}]{tail}? [y/N] "
        if not self._confirm(prompt):
            self.set_status("Close cancelled")
            return
        dbg(f"close: {agent} sid={sid[:12]}")
        try:
            result = subprocess.run(
                [AGENT_SESSION, "close", sid],
                capture_output=True, text=True, timeout=15,
            )
            if result.returncode == 0:
                self.reload()
                self.set_status(f"Closed: {short_sid(sid)} [{agent}]")
            else:
                err = (result.stderr or result.stdout or "unknown error").strip()[:60]
                self.set_status(f"Close failed: {err}")
        except subprocess.TimeoutExpired:
            self.set_status("Close timed out")
        except Exception as e:
            self.set_status(f"Close error: {e}")

    def _action_stop(self):
        r = self._sel_row()
        if not r:
            self.set_status("No row selected")
            return
        pid = r.get("pid")
        if not pid:
            self.set_status(f"No PID  [{r.get('pattern')}]")
            return
        try:
            pid_int = int(pid)
        except (TypeError, ValueError):
            self.set_status(f"Invalid PID: {pid!r}")
            return
        try:
            os.kill(pid_int, 0)
        except ProcessLookupError:
            self.reload()
            self.set_status(f"PID {pid_int} no longer exists — reloaded")
            return
        except PermissionError:
            pass  # process exists, owned by another uid
        agent  = r.get("pattern") or "?"
        sid    = r.get("session_id") or ""
        label  = short_sid(sid) if sid else (r.get("_title") or "")[:20]
        tail   = f" {label}" if label else ""
        prompt = f" Stop PID {pid_int} [{agent}]{tail}? [y/N] "
        if not self._confirm(prompt):
            self.set_status("Stop cancelled")
            return
        dbg(f"stop: SIGTERM pid={pid_int} agent={agent}")
        try:
            os.kill(pid_int, signal.SIGTERM)
        except ProcessLookupError:
            self.reload()
            self.set_status(f"PID {pid_int} already gone — reloaded")
            return
        except PermissionError as e:
            self.set_status(f"SIGTERM denied: {e}")
            return
        except Exception as e:
            self.set_status(f"Stop error: {e}")
            return
        self.reload()
        self.set_status(f"SIGTERM → PID {pid_int} [{agent}]")

    def _action_resume(self):
        r = self._sel_row()
        if not r:
            self.set_status("No row selected")
            return
        idx   = r.get("_idx") or {}
        agent = r.get("pattern") or ""
        sid   = r.get("session_id") or ""
        cwd_v = idx.get("cwd") or r.get("cwd") or ""
        if not sid:
            self.set_status("No session_id for selected row")
            return
        argv_fn = RESUME_ARGV.get(agent)
        if not argv_fn:
            self.set_status(f"No resume command for agent '{agent}'")
            return
        argv = argv_fn(sid)
        ist = r.get("_ist") or ""
        if ist in ("closed", "abandoned"):
            if not self._confirm(f" Session is {ist}. Resume anyway? [y/N] "):
                self.set_status("Resume cancelled")
                return
        dbg(f"resume: exec {agent} sid={sid[:12]} cwd={cwd_v[:30]!r}")
        self._end_curses()
        if cwd_v:
            print(f"  cd {shlex.quote(cwd_v)}")
            try:
                os.chdir(cwd_v)
            except Exception:
                pass
        print(f"  {shlex.join(argv)}")
        try:
            os.execvp(argv[0], argv)
        except OSError as e:
            print(f"agent-top: exec failed: {e}", file=sys.stderr)
            sys.exit(1)

    def _confirm(self, prompt):
        h, w = self.scr.getmaxyx()
        cw  = min(len(prompt) + 6, w - 4)
        win = curses.newwin(3, cw, (h - 3) // 2, (w - cw) // 2)
        win.box()
        try:
            win.addstr(1, 1, prompt[:cw - 2])
        except curses.error:
            pass
        win.refresh()
        k = win.getch()
        return 32 <= k < 127 and chr(k).lower() == 'y'

    def _overlay(self, lines, title="", w_hint=None):
        h, w = self.scr.getmaxyx()
        mw = w_hint if w_hint else min(60, w - 4)
        mh = min(len(lines) + 2, h - 2)
        win = curses.newwin(mh, mw, (h - mh) // 2, (w - mw) // 2)
        win.box()
        if title:
            tx = max(0, (mw - len(title)) // 2)
            try:
                win.addstr(0, tx, title[:mw - 2], curses.A_BOLD)
            except curses.error:
                pass
        for i, line in enumerate(lines):
            if i + 1 >= mh - 1:
                break
            try:
                win.addstr(i + 1, 1, line[:mw - 2])
            except curses.error:
                pass
        win.refresh()
        win.getch()

def _main(stdscr):
    TUI(stdscr).run()

if not STATE_FILE or not os.path.isfile(STATE_FILE):
    sys.exit(f"agent-top tui: state file not found: {STATE_FILE or '(unset)'}")

# When run via heredoc, fd 0 is a pipe; restore /dev/tty so curses can read keys
if not os.isatty(0):
    _fd = os.open('/dev/tty', os.O_RDWR)
    os.dup2(_fd, 0)
    os.close(_fd)

curses.wrapper(_main)
PY
}

run_keytest() {
  python3 - <<'PY'
import curses, os, sys, time

if not os.isatty(0):
    _fd = os.open('/dev/tty', os.O_RDWR)
    os.dup2(_fd, 0)
    os.close(_fd)

def _keytest(scr):
    scr.keypad(True)
    curses.noecho()
    curses.cbreak()
    try: curses.curs_set(0)
    except curses.error: pass
    scr.timeout(10000)
    term = os.environ.get("TERM", "?")
    rows = []
    while True:
        scr.clear()
        h, w = scr.getmaxyx()
        hdr = f" agent-top keytest   TERM={term}   q/F10=quit"
        try: scr.addstr(0, 0, hdr[:w - 1].ljust(w - 1), curses.A_REVERSE)
        except curses.error: pass
        try: scr.addstr(1, 0, f" {'CODE':<8} {'NAME':<24} {'CHAR':<6} {'TIME'}"[:w-1], curses.A_DIM)
        except curses.error: pass
        for i, row in enumerate(rows[-(h - 3):]):
            try: scr.addstr(i + 2, 0, row[:w - 1])
            except curses.error: pass
        scr.refresh()
        key = scr.getch()
        if key == curses.ERR:
            continue
        if key in (ord('q'), curses.KEY_F10):
            break
        name = curses.keyname(key).decode(errors='replace')
        ch   = chr(key) if 32 <= key < 127 else ""
        rows.append(f"  {key:<8} {name:<24} {ch!r:<6} {time.strftime('%H:%M:%S')}")

curses.wrapper(_keytest)
PY
}

cmd="${1:-once}"
show_all="false"

case "$cmd" in
  once|"")
    if [ "${2:-}" = "--all" ]; then
      show_all="true"
    fi
    run_once "$show_all"
    ;;
  json)
    if [ ! -s "$AGENT_TOP_STATE" ]; then
      echo "agent-top: state file not found: $AGENT_TOP_STATE" >&2
      exit 1
    fi
    exec cat "$AGENT_TOP_STATE"
    ;;
  watch)
    if [ "${2:-}" = "--all" ]; then
      show_all="true"
    fi
    trap 'exit 0' INT TERM
    while true; do
      clear
      run_once "$show_all" || true
      sleep "$REFRESH_SECS"
    done
    ;;
  refresh)
    run_refresh
    ;;
  jump)
    run_jump "${2:-}"
    ;;
  resume)
    run_resume "${2:-}"
    ;;
  show)
    run_show "${2:-}"
    ;;
  tui|top|interactive)
    run_tui
    ;;
  keytest)
    run_keytest
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac
# agent-top:1 ends here
