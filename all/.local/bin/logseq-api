#!/usr/bin/env bash
# [[file:../logseq.org::logseq-api-script][logseq-api-script]]
# Logseq DB HTTP API helper — proxies Plugin SDK methods to port 12315.
# Token: set LOGSEQ_API_TOKEN in ~/.env; sourced here for desktop/noninteractive calls.
set -euo pipefail

load_private_env() {
  local line key
  [ -f "$HOME/.env" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%%#*}"
    case "$line" in
      export\ *) line="${line#export }" ;;
    esac
    case "$line" in *=*) ;; *) continue ;; esac
    key="${line%%=*}"
    key="${key#"${key%%[![:space:]]*}"}"
    case "$key" in *[!A-Za-z0-9_]*) continue ;; esac
    [ -n "$key" ] && eval "export $line"
  done < "$HOME/.env"
}

load_private_env

TOKEN="${LOGSEQ_API_TOKEN:-}"
TOKEN_NAME="${LOGSEQ_API_NAME:-claude-code}"
API_URL="${LOGSEQ_API_URL:-http://127.0.0.1:12315/api}"

usage() {
  cat >&2 <<'USAGE'
Usage: logseq-api check
       logseq-api METHOD [ARGS_JSON]

Examples:
  logseq-api check
  logseq-api logseq.Editor.getAllPages
  logseq-api logseq.Editor.getPage '["MyPage"]'
  logseq-api logseq.Editor.getPageBlocksTree '["MyPage"]'
  logseq-api logseq.Editor.appendBlockInPage '["MyPage", "new block content"]'
  logseq-api logseq.Editor.createPage '["NewPage", {}, {"redirect": false}]'
  logseq-api logseq.search '["query text"]'
USAGE
  exit 1
}

[ $# -eq 0 ] && usage

cmd="$1"
args="${2:-[]}"

if [ "$cmd" = "check" ]; then
  if curl -sf --connect-timeout 2 "$API_URL" >/dev/null 2>&1; then
    echo "Logseq API reachable at $API_URL"
  else
    echo "Logseq HTTP API not reachable at $API_URL" >&2
    echo "Enable: Logseq Settings -> Features -> HTTP APIs server" >&2
    exit 1
  fi
  exit 0
fi

if [ -z "$TOKEN" ]; then
  echo "LOGSEQ_API_TOKEN not set" >&2
  echo "Add to ~/.env: export LOGSEQ_API_TOKEN=\"your-token\"" >&2
  echo "Optional: export LOGSEQ_API_NAME=\"$TOKEN_NAME\"" >&2
  exit 1
fi

curl -sf \
  -H "Authorization: Bearer $TOKEN" \
  -H "Content-Type: application/json" \
  -d "{\"method\": \"$cmd\", \"args\": $args}" \
  "$API_URL" | python3 -m json.tool
# logseq-api-script ends here
