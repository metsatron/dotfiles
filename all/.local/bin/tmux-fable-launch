#!/usr/bin/env bash
set -euo pipefail

STATE_ROOT="${XDG_STATE_HOME:-$HOME/.local/state}/claude-idle-compaction"
BOT_SESSION="${TMUX_FABLE_SESSION:-Fable}"
RECORD="$STATE_ROOT/last-session.Fable.json"

case "${1:-}" in
  --latest) ;;
  -h|--help)
    echo "Usage: tmux-fable-launch --latest"
    exit 0
    ;;
  *)
    echo "tmux-fable-launch: only --latest is supported" >&2
    exit 2
    ;;
esac

[ -r "$RECORD" ] || { echo "tmux-fable-launch: missing $RECORD" >&2; exit 1; }
command -v python3 >/dev/null 2>&1 || { echo "tmux-fable-launch: python3 unavailable" >&2; exit 1; }
session_id="$(python3 - "$RECORD" <<'PY'
import json
import re
import sys

try:
    value = json.load(open(sys.argv[1], encoding="utf-8")).get("session_id", "")
except (OSError, ValueError, TypeError):
    raise SystemExit(1)
if not re.fullmatch(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", str(value)):
    raise SystemExit(1)
print(value)
PY
)" || { echo "tmux-fable-launch: invalid latest Fable session record" >&2; exit 1; }

command -v tmux >/dev/null 2>&1 || { echo "tmux-fable-launch: tmux unavailable" >&2; exit 1; }
command -v claude-fable >/dev/null 2>&1 || { echo "tmux-fable-launch: claude-fable unavailable" >&2; exit 1; }
pane=""
for _ in $(seq 1 30); do
  pane="$(tmux list-panes -t "$BOT_SESSION" -F '#{pane_id}' 2>/dev/null | sed -n '1p')"
  [ -n "$pane" ] && break
  sleep 2
done
[ -n "$pane" ] || { echo "tmux-fable-launch: no pane in $BOT_SESSION" >&2; exit 1; }

pane_command=""
for _ in $(seq 1 30); do
  pane_command="$(tmux display-message -p -t "$pane" '#{pane_current_command}' 2>/dev/null || true)"
  case "$pane_command" in
    bash|zsh|sh|dash|fish|-bash|-zsh|-sh|-dash|-fish) break ;;
  esac
  sleep 2
done
case "$pane_command" in
  bash|zsh|sh|dash|fish|-bash|-zsh|-sh|-dash|-fish) ;;
  *) echo "tmux-fable-launch: Fable pane is not at a shell: $pane_command" >&2; exit 1 ;;
esac

command_line="claude-fable --telegram --mailcortex --remote --resume $session_id"
echo "tmux-fable-launch: $BOT_SESSION/$pane <- $command_line"
tmux send-keys -t "$pane" C-u "$command_line" Enter
