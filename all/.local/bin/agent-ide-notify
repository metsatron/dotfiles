#!/usr/bin/env bash
# Agent IDE notifications

# Claude Code IDE and Codex IDE share Herdr's notification vocabulary: =request=
# means the agent needs human input, while =done= means the turn completed.  The
# helper keeps the delivery policy in Herdr (toast placement, system-vs-terminal
# delivery, and configured sounds) instead of growing a second notification
# configuration inside Emacs.

# Claude's hook payload has no official IDE-origin field, so the Doom integration
# injects =CLAUDE_CODE_IDE_EL_SESSION=1= only around
# =claude-code-ide--create-terminal-session=.  These hook adapters refuse to fire
# without that marker; ordinary Claude terminals and OpenCode's reuse of the Stop
# hook remain quiet.


# [[file:../../../agents-hooks.org::*Agent IDE notifications][Agent IDE notifications:1]]
# ~/DotCortex/all/.local/bin/agent-ide-notify
set -u

kind="${1:-}"
title="${2:-Agent IDE}"
body="${3:-}"

case "$kind" in
  request|done) ;;
  *)
    printf 'usage: agent-ide-notify request|done TITLE BODY\n' >&2
    exit 2
    ;;
esac

if command -v herdr >/dev/null 2>&1; then
  # Notification delivery must never hold a Claude hook or an Emacs process
  # open while a toast is visible.  Start a new session and return immediately.
  if command -v setsid >/dev/null 2>&1; then
    setsid -f herdr notification show "$title" --body "$body" --sound "$kind" \
      </dev/null >/dev/null 2>&1
    exit 0
  fi
  herdr notification show "$title" --body "$body" --sound "$kind" \
    </dev/null >/dev/null 2>&1 &
  exit 0
fi

# A popup is still useful on machines where Herdr is not installed.  There is
# deliberately no guessed sound fallback: Herdr owns the request/done sounds.
if command -v notify-send >/dev/null 2>&1; then
  exec notify-send "$title" "$body"
fi

exit 0
# Agent IDE notifications:1 ends here
