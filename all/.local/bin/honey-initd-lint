#!/usr/bin/python3 -I
"""honey-initd-lint (generated by agents-bots-honey.org): fail on an init script whose daemon is a SHARED INTERPRETER and that has no stop of its own.

Why: OpenRC's default stop runs `start-stop-daemon --stop --exec $command --pidfile $pidfile`. When the pidfile is gone it falls back to matching the
executable alone, so a script with command=/usr/bin/python3 takes down EVERY OpenRC-started python3 process on the host (Honey, 2026-11-12: seven services).

A script is a FAULT (exit 1) only when the fault is PROVEN from what the script says:
  no-own-stop   the daemon (command=, or a procname=) is a shared interpreter and the script defines no stop()
  stop-exec     a stop/stop_pre/stop_post passes --exec (or -x) to start-stop-daemon and the executable is a shared interpreter
  stop-by-name  a stop/stop_pre/stop_post signals by name or pattern (start-stop-daemon --name, pkill, killall, kill $(pgrep ...), pgrep | xargs kill)
                with no uid restriction, or with a bare shared-interpreter name, or on a shared-interpreter daemon.
Anything the lint cannot decide is UNPARSED: it prints the line that stopped it and does NOT fail the run. A pattern signal that is uid-scoped and names
something specific is a NOTE. Backup copies (*.bak-*, *.orig, *.disabled, *.retired-*, *~) are reported separately and never change the exit status.
Shared interpreters, by NAME: python, python3, python3.N, perl, bash, sh, dash, zsh, ksh, node, nodejs, ruby, php, lua. (start-stop-daemon --exec matches argv[0]
by string, so the name in command= is what decides; symlinks and `env X` are not followed.)
Sysv/LSB scripts have no default stop; only their start-stop-daemon --stop calls and pkill/killall are examined, and an --exec/--name next to a
--pidfile is accepted there (it narrows the match rather than widening it).

Exit: 0 no proven fault in an active script, 1 at least one, 2 the directory could not be read.
Usage: honey-initd-lint [--dir /etc/init.d] [--confd /etc/conf.d] [--json] [-q] [FILE...]
Read-only. It never runs, sources or evaluates any script: it only reads text."""
import json, os, re, shlex, sys

SHARED_RE = re.compile(r'^(python([0-9]+(\.[0-9]+)*)?|perl[0-9.]*|bash|sh|dash|zsh|ksh|node(js)?|ruby[0-9.]*|php[0-9.]*|lua[0-9.]*)$')
INACTIVE_RE = re.compile(r'(\.(bak|orig|old|save|disabled|retired|dpkg-[a-z]+)([-.].*)?|~)$')
STOP_FUNCS = ('stop', 'stop_pre', 'stop_post')
ASSIGN_RE = re.compile(r'^\s*(?:export\s+|local\s+|readonly\s+)?([A-Za-z_][A-Za-z0-9_]*)=(.*)$')
FUNC_RE = re.compile(r'^\s*(?:function\s+)?([A-Za-z_][A-Za-z0-9_.:-]*)\s*\(\s*\)\s*(.*)$')
HEREDOC_RE = re.compile(r'(?<!<)<<(?!<)-?\s*(?:\'([^\']+)\'|"([^"]+)"|\\?([A-Za-z_][A-Za-z0-9_]*))')
LEAD = {'if', 'then', 'else', 'elif', 'do', 'while', 'until', '!', '{', 'time', 'sudo', 'nohup', 'nice', 'exec', 'command', '-n', 'env'}


class Unparsed(Exception):
    def __init__(self, line, why):
        super().__init__(why)
        self.line, self.why = line, why


def is_shared(path_or_name):
    return bool(SHARED_RE.match(os.path.basename(str(path_or_name))))


def shared_reason(value):
    """The interpreter's name when VALUE (a path or bare name) is a shared interpreter, judged by its NAME only; else None.
    Why not through symlinks or `env X`: OpenRC's start-stop-daemon --exec matches a process by its argv[0] STRING (measured 2026-11-12: a decoy started
    as /usr/bin/python3 was signalled, one started as `python3`, or via a symlink to the same binary, was not), so what matters is the string in command=."""
    if value and is_shared(value):
        return os.path.basename(value)
    return None


# ---- preprocessing: logical lines with their first original line number --------------------------------------------
def logical_lines(text):
    """[(lineno, text)] with continuations joined, comments and heredoc bodies removed. Raises Unparsed on an unterminated quote or heredoc."""
    out, raw = [], text.split('\n')
    i, n = 0, len(raw)
    while i < n:
        start, cur = i + 1, raw[i]
        i += 1
        while cur.endswith('\\') and not cur.endswith('\\\\') and i < n:
            cur = cur[:-1] + raw[i]
            i += 1
        buf, q, k = [], None, 0
        while True:
            while k < len(cur):
                c = cur[k]
                if q is None:
                    if c == '\\' and k + 1 < len(cur):
                        buf.append(cur[k:k + 2]); k += 2; continue
                    if c == '#' and (k == 0 or cur[k - 1] in ' \t;&|('):
                        break
                    if c in '\'"':
                        q = c
                elif c == q:
                    q = None
                elif c == '\\' and q == '"' and k + 1 < len(cur):
                    buf.append(cur[k:k + 2]); k += 2; continue
                buf.append(c); k += 1
            if q is None:
                break
            if i >= n:
                raise Unparsed(start, 'unterminated %s quote' % ('single' if q == "'" else 'double'))
            buf.append(' '); cur = raw[i]; i += 1; k = 0
        line = ''.join(buf)
        out.append((start, line))
        m = HEREDOC_RE.search(line)
        if m:
            tag = m.group(1) or m.group(2) or m.group(3)
            while i < n and raw[i].strip() != tag:
                i += 1
            if i >= n:
                raise Unparsed(start, 'heredoc %s is never closed' % tag)
            i += 1
    return out


def brace_delta(line):
    """Net { minus } outside quotes, so ${x} cancels and quoted braces vanish."""
    d, q, k = 0, None, 0
    while k < len(line):
        c = line[k]
        if c == '\\' and q != "'":
            k += 2; continue
        if q is None:
            if c in '\'"':
                q = c
            elif c == '{':
                d += 1
            elif c == '}':
                d -= 1
        elif c == q:
            q = None
        k += 1
    return d


def split_script(lines):
    """-> (top-level [(n, line)], functions {name: (start_n, [(n, line)])})."""
    top, funcs, i = [], {}, 0
    while i < len(lines):
        n, line = lines[i]
        m = FUNC_RE.match(line)
        if not m:
            top.append((n, line)); i += 1; continue
        name, rest = m.group(1), m.group(2).strip()
        if rest.startswith('('):
            raise Unparsed(n, 'function %s has a subshell body' % name)
        cur_n, cur = n, line
        if not rest.startswith('{'):  # the brace may sit on the next line
            if i + 1 >= len(lines) or not lines[i + 1][1].strip().startswith('{'):
                raise Unparsed(n, 'function %s has no { body' % name)
            i += 1
            cur_n, cur = lines[i]
        body, depth = [], 0
        while True:
            depth += brace_delta(cur)
            body.append((cur_n, cur))
            if depth <= 0:
                break
            i += 1
            if i >= len(lines):
                raise Unparsed(n, 'function %s is never closed (unbalanced braces)' % name)
            cur_n, cur = lines[i]
        funcs[name] = (n, body)
        i += 1
    return top, funcs


# ---- words and expansion ----------------------------------------------------------------------------------------------
def substitutions(line):
    """(outer, [inner command strings]) for $(...) and `...` (nesting by paren depth; single-quoted text is literal)."""
    inner, out, q, k = [], [], None, 0
    while k < len(line):
        c = line[k]
        if q == "'":
            out.append(c)
            if c == "'": q = None
            k += 1; continue
        if c == "'":
            q = "'"; out.append(c); k += 1; continue
        if c == '\\' and k + 1 < len(line):
            out.append(line[k:k + 2]); k += 2; continue
        if line.startswith('$(', k) and not line.startswith('$((', k):
            depth, j = 1, k + 2
            while j < len(line) and depth:
                depth += (line[j] == '(') - (line[j] == ')'); j += 1
            inner.append(line[k + 2:j - 1]); out.append('SUBST'); k = j; continue
        if c == '`':
            j = line.find('`', k + 1)
            if j < 0: j = len(line)
            inner.append(line[k + 1:j]); out.append('SUBST'); k = j + 1; continue
        if c == '"':
            q = None if q == '"' else '"'
        out.append(c); k += 1
    return ''.join(out), inner


def split_commands(line):
    """Quote-aware split of one logical line into simple commands (; & | && || ( ) newline), each as a shlex word list."""
    segs, cur, q, k = [], [], None, 0
    while k < len(line):
        c = line[k]
        if q:
            cur.append(c)
            if c == '\\' and q == '"' and k + 1 < len(line):
                cur.append(line[k + 1]); k += 1
            elif c == q:
                q = None
        elif c == '\\' and k + 1 < len(line):
            cur.append(line[k:k + 2]); k += 1
        elif c in '\'"':
            q = c; cur.append(c)
        elif c in ';&|()\n':
            segs.append(''.join(cur)); cur = []
        else:
            cur.append(c)
        k += 1
    segs.append(''.join(cur))
    out = []
    for s in segs:
        s = re.sub(r'\d*[<>]+&?\S*', ' ', s) if False else s  # redirections stay as words; they never match a command name
        s = s.strip()
        if not s:
            continue
        try:
            out.append(shlex.split(s, posix=True))
        except ValueError:
            out.append(s.split())
    return out


def strip_redirections(words):
    out, skip = [], False
    for w in words:
        if skip:
            skip = False; continue
        m = re.match(r'^\d*(?:&>>?|>>?|<<?<?|>&|<&)(.*)$', w)
        if m:
            skip = (m.group(1) == '')  # `> file`: the target is the next word
            continue
        out.append(w)
    return out


def commands(line, depth=0):
    """All simple commands on a logical line, including command substitutions and `sh -c '...'` strings, leading keywords removed."""
    outer, inner = substitutions(line)
    res = []
    for words in split_commands(outer):
        while words and (words[0] in LEAD or re.match(r'^[A-Za-z_][A-Za-z0-9_]*=', words[0])):
            if words[0] == '-n' and len(words) > 1:  # `sudo -n cmd`
                words = words[1:]; continue
            words = words[1:]
        words = strip_redirections(words)
        if not words:
            continue
        res.append(words)
        if depth < 3 and os.path.basename(words[0]) in ('su', 'sh', 'bash', 'dash') and '-c' in words[:-1]:
            res += commands(words[words.index('-c') + 1], depth + 1)
    for s in inner:
        if depth < 3:
            res += commands(s, depth + 1)
    return res


VAR_RE = re.compile(r'\$\{([A-Za-z_][A-Za-z0-9_]*)(?:(:?[-=+])([^{}]*))?\}|\$([A-Za-z_][A-Za-z0-9_]*)')


def expand(s, env, depth=0):
    """Expand $v ${v} ${v:-d} ${v:=d} ${v:+a} against ENV; None when anything cannot be decided (undefined variable, $(...), other operators)."""
    if s is None or depth > 8 or '$(' in s or '`' in s or re.search(r'\$\{(?![A-Za-z_][A-Za-z0-9_]*(?:\}|:?[-=+]))', s):
        return None
    bad = []

    def sub(m):
        name, op, arg = m.group(1) or m.group(4), m.group(2), m.group(3)
        val = env.get(name)
        unset = val is None or (val == '' and op is not None and op.startswith(':'))
        if op in (':-', '-', ':=', '='):
            if unset:
                r = expand(arg, env, depth + 1)
                if r is None: bad.append(1); return ''
                return r
            return val
        if op in (':+', '+'):
            if unset: return ''
            r = expand(arg, env, depth + 1)
            if r is None: bad.append(1); return ''
            return r
        if val is None: bad.append(1); return ''
        return val
    out = VAR_RE.sub(sub, s)
    return None if bad else out


def one_word(value):
    value = value.strip()
    try:
        w = shlex.split(value, posix=True)
    except ValueError:
        return value
    return ' '.join(w)


def assign(env, key, raw, rawvals=None):
    if rawvals is not None:
        rawvals[key] = one_word(raw)
    if '$(' in raw or '`' in raw:
        env.pop(key, None); return  # computed at run time
    v = one_word(raw)
    val = expand(v, env) if '$' in v else v
    if val is None:
        env.pop(key, None)
    else:
        env[key] = val


def parse_env(top, name, confd, rawvals=None):
    """Variables as openrc-run sees them: /etc/conf.d/NAME is sourced FIRST (openrc-run.sh), then the script's own top-level lines, so a plain
    assignment in the script overrides conf.d, and conf.d feeds the ${x:-default} and : "${x:=default}" forms."""
    env = {'RC_SVCNAME': name}
    if confd and os.path.isfile(os.path.join(confd, name)):
        try:
            with open(os.path.join(confd, name), errors='replace') as fh:
                for _, line in logical_lines(fh.read()):
                    m = ASSIGN_RE.match(line)
                    if m:
                        assign(env, m.group(1), m.group(2), rawvals)
        except (OSError, Unparsed):
            pass
    for _, line in top:
        m = ASSIGN_RE.match(line)
        if m:
            assign(env, m.group(1), m.group(2), rawvals)
        else:
            m = re.match(r'^\s*:\s+"?\$\{([A-Za-z_][A-Za-z0-9_]*):?=([^}]*)\}"?\s*$', line)  # : "${x:=default}"
            if m and m.group(1) not in env:
                assign(env, m.group(1), m.group(2), rawvals)
    return env


# ---- analysis ----------------------------------------------------------------------------------------------------------
def opt_value(words, short, long_):
    """Value of -x VAL / --exec VAL / --exec=VAL / -xVAL; None when absent."""
    for i, w in enumerate(words):
        if w == '--':
            break
        if w in short or w in long_:
            return words[i + 1] if i + 1 < len(words) else ''
        for l in long_:
            if w.startswith(l + '='):
                return w[len(l) + 1:]
        for s in short:
            if w.startswith(s) and len(w) > 2 and not w.startswith('--'):
                return w[2:]
    return None


def has_opt(words, short, long_):
    return any(w in short or w in long_ or any(w.startswith(l + '=') for l in long_) for w in words)


def stop_findings(fname, body, env, daemon_shared, kind):
    """(faults, notes, unparsed) of one stop-family function body, or (sysv) of the whole script."""
    faults, notes, unp = [], [], []
    for n, line in body:
        cmds = commands(line)
        kills = any(os.path.basename(w[0]) in ('kill', 'xargs') for w in cmds)
        for words in cmds:
            cmd = os.path.basename(words[0])
            args = words[1:]
            if cmd == 'start-stop-daemon' and has_opt(args, ('-K',), ('--stop',)):
                pid = opt_value(args, ('-p',), ('--pidfile',))
                ex = opt_value(args, ('-x',), ('--exec',))
                nm = opt_value(args, ('-n',), ('--name',))
                narrowed = kind == 'sysv' and pid is not None
                if ex and not narrowed:
                    ev = expand(ex, env)
                    if ev is None and daemon_shared:
                        faults.append((n, 'stop-exec', '%s passes --exec %s to start-stop-daemon and the daemon is a shared interpreter (the value cannot be resolved)' % (fname, ex)))
                    elif ev is None:
                        unp.append((n, '--exec %s cannot be resolved' % ex))
                    elif shared_reason(ev):
                        faults.append((n, 'stop-exec', '%s passes --exec %s to start-stop-daemon: it can signal processes this script never started' % (fname, ev)))
                if nm and not narrowed:
                    nv = expand(nm, env)
                    if (nv is None and daemon_shared) or (nv is not None and shared_reason(nv)):
                        faults.append((n, 'stop-by-name', '%s signals by --name %s' % (fname, nv or nm)))
                    elif nv is None:
                        unp.append((n, '--name %s cannot be resolved' % nm))
                    else:
                        notes.append((n, 'start-stop-daemon --name %s (a specific name)' % nv))
            elif cmd in ('pkill', 'killall') or (cmd == 'pgrep' and kills):
                uid = has_opt(args, ('-u', '-U'), ('--euid', '--uid', '--user'))
                parent = has_opt(args, ('-P',), ('--parent',))
                skip = {i + 1 for i, a in enumerate(args) if a in ('-u', '-U', '-g', '-G', '-P', '-s', '-t', '-n', '-o', '-c', '--signal', '--euid', '--uid', '--user', '--parent', '--session')}
                pat = [a for i, a in enumerate(args) if not a.startswith('-') and i not in skip]
                shown = '%s %s' % (cmd, ' '.join(shlex.quote(a) for a in args))
                if parent and not pat:
                    notes.append((n, '%s by parent pid only' % shown)); continue
                pv = expand(pat[-1], env) if pat else None
                bare = bool(pv and pv.split() and is_shared(pv.split()[0]))
                if daemon_shared or bare:
                    faults.append((n, 'stop-by-name', '%s signals by name or pattern (%s)' % (fname, shown)))
                elif not uid:
                    faults.append((n, 'stop-by-name', '%s signals by name or pattern with no uid restriction (%s)' % (fname, shown)))
                elif pat and pv is None:
                    unp.append((n, 'pattern %s cannot be resolved (uid-scoped %s)' % (pat[-1], cmd)))
                else:
                    notes.append((n, '%s: pattern %r, uid-scoped' % (cmd, pv)))
    return faults, notes, unp


def analyse_text(name, text, confd=None):
    res = {'status': 'OK', 'faults': [], 'notes': [], 'why': '', 'line': 0, 'daemon': ''}
    first = text.split('\n', 1)[0]
    if not first.startswith('#!'):
        return dict(res, status='UNPARSED', line=1, why='no #! line: not a script the lint understands')
    try:
        lines = logical_lines(text)
        top, funcs = split_script(lines)
    except Unparsed as e:
        return dict(res, status='UNPARSED', line=e.line, why=str(e))
    rawvals = {}
    env = parse_env(top, name, confd, rawvals)
    unp = []

    if 'openrc-run' not in first:  # sysv/LSB: no default stop to fall back on
        f, nt, u = stop_findings('script', lines, env, False, 'sysv')
        res['faults'], res['notes'] = f, nt
        if f: res['status'] = 'FAULT'
        elif u: res.update(status='UNPARSED', line=u[0][0], why=u[0][1])
        else: res['status'] = 'NA'
        return res

    cmd = env.get('command')
    cmd_line = next((n for n, l in reversed(top) if re.match(r'\s*command=', l)), 0)
    why_shared = shared_reason(cmd) if cmd else None
    cmd_known = cmd is not None
    if cmd is None and rawvals.get('command'):  # computed prefix, literal last component (${user_home}/.local/bin/ductor): the name still decides
        tail = rawvals['command'].rsplit('/', 1)
        if len(tail) == 2 and tail[1] and '$' not in tail[1]:
            cmd_known = True
            why_shared = shared_reason(tail[1])
    pn = env.get('procname')
    if not why_shared and pn and is_shared(pn):
        why_shared = 'procname=' + pn
    res['daemon'] = cmd or ''
    daemon_shared = bool(why_shared)
    has_stop = 'stop' in funcs
    sup = env.get('supervisor')
    if sup and 'supervise' in sup:  # supervise-daemon stops its own supervisor; only matters if the daemon is shared
        if daemon_shared:
            return dict(res, status='UNPARSED', line=0, why='supervisor=%s on a shared-interpreter daemon: its stop semantics are not modelled' % sup)
        return dict(res, status='NA')
    if not has_stop:
        if not cmd_known and cmd_line:
            return dict(res, status='UNPARSED', line=cmd_line, why='command= is computed at run time or uses an undefined variable: cannot tell whether the daemon is a shared interpreter')
        if daemon_shared:
            res['faults'].append((cmd_line, 'no-own-stop', 'daemon is a shared interpreter (%s) and the script defines no stop(): the default stop passes --exec %s and, with the pidfile gone, signals every process whose argv[0] is that string' % (why_shared, cmd or pn)))
    for fn in STOP_FUNCS:
        if fn in funcs:
            f, nt, u = stop_findings(fn + '()', funcs[fn][1], env, daemon_shared, 'openrc')
            res['faults'] += f; res['notes'] += nt; unp += u
    if res['faults']:
        res['status'] = 'FAULT'
    elif unp:
        res.update(status='UNPARSED', line=unp[0][0], why=unp[0][1])
    elif daemon_shared or has_stop:
        res['status'] = 'OK'
    else:
        res['status'] = 'NA'
    return res


def analyse_file(path, confd):
    name = os.path.basename(path)
    base = {'status': 'UNPARSED', 'faults': [], 'notes': [], 'line': 0, 'why': '', 'daemon': ''}
    try:
        with open(path, 'rb') as fh:
            raw = fh.read()
    except OSError as e:
        return dict(base, why='cannot read: %s' % e.strerror)
    if b'\0' in raw[:4096]:
        return dict(base, line=1, why='binary file')
    try:
        return analyse_text(name, raw.decode('utf-8', 'replace'), confd)
    except Exception as e:  # a bug in the lint must surface as UNPARSED for that file: never a pass, never a fault
        return dict(base, why='lint error: %s: %s' % (type(e).__name__, e))


def main(argv):
    d, confd, as_json, quiet, files = '/etc/init.d', '/etc/conf.d', False, False, []
    a = list(argv)
    while a:
        x = a.pop(0)
        if x == '--dir' and a: d = a.pop(0)
        elif x == '--confd' and a: confd = a.pop(0)
        elif x == '--json': as_json = True
        elif x in ('-q', '--quiet'): quiet = True
        elif x in ('-h', '--help'): print(__doc__); return 0
        elif x.startswith('-'): print('honey-initd-lint: unknown or incomplete option %s' % x, file=sys.stderr); return 2
        else: files.append(x)
    if not files:
        try:
            files = [os.path.join(d, f) for f in sorted(os.listdir(d))]
        except OSError as e:
            print('honey-initd-lint: cannot read %s: %s' % (d, e.strerror), file=sys.stderr)
            return 2
    rows, skipped = [], 0
    for p in files:
        if os.path.isdir(p) or os.path.basename(p).startswith('.'):  # dotfiles in /etc/init.d are insserv caches (.depend.*), not scripts
            skipped += 1; continue
        r = analyse_file(p, confd)
        r['path'], r['inactive'] = p, bool(INACTIVE_RE.search(os.path.basename(p)))
        rows.append(r)
    act = [r for r in rows if not r['inactive']]
    ina = [r for r in rows if r['inactive']]
    cnt = lambda rs, k: sum(1 for r in rs if r['status'] == k)
    s = {'scanned': len(rows), 'active': len(act), 'ok': cnt(act, 'OK'), 'not_applicable': cnt(act, 'NA'), 'fault': cnt(act, 'FAULT'),
         'unparsed': cnt(act, 'UNPARSED'), 'inactive_copies': len(ina), 'inactive_copies_with_fault': cnt(ina, 'FAULT'),
         'inactive_copies_unparsed': cnt(ina, 'UNPARSED')}
    rc = 1 if s['fault'] else 0
    if as_json:
        print(json.dumps({'summary': s, 'exit': rc, 'directories_skipped': skipped, 'results': rows}, indent=1))
        return rc
    for r in rows:
        tag = ' (inactive copy)' if r['inactive'] else ''
        if r['status'] == 'FAULT':
            for ln, rule, msg in r['faults']:
                print('FAULT%s %s:%s [%s] %s' % (tag, r['path'], ln or '-', rule, msg))
        elif r['status'] == 'UNPARSED':
            print('UNPARSED%s %s:%s %s' % (tag, r['path'], r['line'] or '-', r['why']))
        if not quiet:
            for ln, msg in r['notes']:
                print('NOTE%s %s:%s %s' % (tag, r['path'], ln, msg))
    print('SUMMARY scanned=%(scanned)d active=%(active)d ok=%(ok)d not_applicable=%(not_applicable)d fault=%(fault)d unparsed=%(unparsed)d '
          'inactive_copies=%(inactive_copies)d inactive_copies_with_fault=%(inactive_copies_with_fault)d inactive_copies_unparsed=%(inactive_copies_unparsed)d' % s)
    print('RESULT ' + ('FAIL: %d active script(s) with a proven fault' % s['fault'] if rc else
                       'PASS: no proven fault in an active script (%d UNPARSED are not a verdict)' % s['unparsed']))
    return rc


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
