#!/usr/bin/env bash
# [[file:../../../agents-hooks.org::*Voice-note fallback: the reply becomes a Telegram voice note when he cannot hear it][Voice-note fallback: the reply becomes a Telegram voice note when he cannot hear it:2]]
# pvox-reply-telegram-note WAV [VOICE] — post a rendered reply as a voice note.
# Best effort by construction: it prints one result token for the caller's log
# and never fails the relay. The bot token comes from the environment file and
# is never echoed; it is stripped to its valid character set so a stray quote
# in the file cannot corrupt the request.
set -uo pipefail

WAV="${1:?usage: pvox-reply-telegram-note WAV [VOICE]}"
VOICE="${2:-voice reply}"

[ -s "$WAV" ] || { echo "note-skip:no-audio"; exit 0; }
[ -n "${PVOX_REPLY_TG_OFF:-}" ] && { echo "note-skip:disabled"; exit 0; }
command -v ffmpeg >/dev/null 2>&1 || { echo "note-skip:no-ffmpeg"; exit 0; }

ENVF="${PVOX_REPLY_TG_ENV:-$HOME/.hermes/.env}"
CHAT="${PVOX_REPLY_TG_CHAT:-111081877}"
TOK="$(sed -n 's/^TELEGRAM_BOT_TOKEN=//p' "$ENVF" 2>/dev/null | head -1 | sed 's/[^0-9A-Za-z:_-].*$//')"
[ -n "$TOK" ] || { echo "note-skip:no-token"; exit 0; }

OGG="$(mktemp --suffix=.ogg 2>/dev/null || mktemp)"
RESP="$(mktemp)"
trap 'rm -f "$OGG" "$RESP"' EXIT

if ! ffmpeg -v error -y -i "$WAV" -c:a libopus -b:a 32k -ac 1 -ar 48000 "$OGG" >/dev/null 2>&1; then
    echo "note-fail:encode"; exit 0
fi

HTTP="$(curl -s -o "$RESP" -w '%{http_code}' --max-time 60 \
    -F "chat_id=$CHAT" \
    -F "voice=@$OGG;type=audio/ogg" \
    -F "caption=$VOICE" \
    "https://api.telegram.org/bot$TOK/sendVoice" 2>/dev/null || echo 000)"

if [ "$HTTP" = "200" ]; then
    echo "note-sent:chat=$CHAT"
else
    DESC="$(sed -n 's/.*"description":"\([^"]*\)".*/\1/p' "$RESP" 2>/dev/null | head -1)"
    echo "note-fail:http=$HTTP${DESC:+ ($DESC)}"
fi
exit 0
# Voice-note fallback: the reply becomes a Telegram voice note when he cannot hear it:2 ends here
