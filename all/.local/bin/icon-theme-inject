#!/usr/bin/env python3
from __future__ import annotations

import argparse
import hashlib
import os
from pathlib import Path

from PIL import Image


THEME_SIZES = {
    "Irixium": (16, 22, 24, 32, 48, 64, 128, 256),
    "BeOS-r5-Icons": (16, 22, 24, 32, 48, 64, 128, 256),
    "indigo-reality": (16, 22, 32, 48, 64, 128, 256),
    # Chicago95 declares exactly these in its index.theme. Emitting a size it does
    # not declare produces a file GTK will never look at.
    "Chicago95": (16, 22, 24, 32, 48, 256),
    # Windows-family packs: places/<size>/ grammar, same declared size ladder.
    # SE98 and Win98SE are TWO applied instances of one upstream (nestoris/Win98SE):
    # Win98SE = win98_icons.awk variant (windows-98 scheme); SE98 = win2k_icons.awk
    # variant = genuine Windows 2000/ME icons (windows-2000 scheme). Their ~90%
    # byte-overlap is EXPECTED (shared 98/ME/2000 shell32), NOT duplication — do not
    # dedupe or rename. Full note: dotcortex-icons skill. (sealed 2026-07-31)
    "Win98SE": (16, 22, 24, 32, 48, 64, 72, 96),
    "SE98": (16, 22, 24, 32, 48, 64, 72, 96),
    "LinXP": (16, 22, 24, 32, 48, 64, 72, 96),
    "Win31": (16, 22, 24, 32, 48),
    "Serenity95": (16, 22, 24, 32, 48),
    # Local Catalina-Dark child theme: fixed Obsidian sizes plus its scalable
    # Antigravity SVG.  Keep this ladder in sync with its index.theme.
    "Catalina-Dark-Metsatron": (16, 22, 24, 32, 48, 64, 128, 256),
}

# Themes are not all laid out the same way. Two grammars exist here:
#   <theme>/<category>/<size>/NAME.png     (Chicago95, Win98SE, SE98, LinXP, ...)
#   <theme>/<size>x<size>/<category>/NAME.png  (Irixium)
# Passing the wrong one writes a file GTK will never look at, which looks like a
# silent no-op rather than an error.
SIZE_FIRST_THEMES = {"Irixium"}


def theme_icon_dir(theme: str, size: int, category: str) -> Path:
    if theme in SIZE_FIRST_THEMES:
        return Path(f"linux/.local/share/icons/{theme}/{size}x{size}/{category}")
    if theme == "indigo-reality" and size == 256 and category == "apps":
        return Path(f"linux/.local/share/icons/{theme}/{category}/256FIXED")
    return Path(f"linux/.local/share/icons/{theme}/{category}/{size}")


# Backwards-compatible alias: existing callers pass apps-only.
def theme_app_dir(theme: str, size: int) -> Path:
    return theme_icon_dir(theme, size, "apps")


def file_digest(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def art_exists_elsewhere(theme_root: Path, digest: str, exclude: Path) -> list[Path]:
    """Every other file in the theme carrying byte-identical art.

    This is the whole basis of the uniqueness guard: overwriting a name whose art
    is duplicated under other names destroys nothing, because the art survives.
    Overwriting the ONLY copy destroys it. On 2026-07-26 that distinction was the
    difference between a lossless edit to Win98SE/SE98 (art present under eight
    other names) and genuine destruction in Chicago95 (art present nowhere else).
    """
    matches = []
    exclude = exclude.resolve() if exclude.exists() else exclude
    for candidate in theme_root.rglob("*"):
        if not candidate.is_file() or candidate.is_symlink():
            continue
        try:
            if candidate.resolve() == exclude:
                continue
            if file_digest(candidate) == digest:
                matches.append(candidate)
        except OSError:
            continue
    return matches


def guard_destination(dest: Path, theme_root: Path, preserve_as: str | None,
                      allow_destroy: bool) -> None:
    """Refuse to destroy art that exists nowhere else in the theme.

    Also refuses to write THROUGH a symlink. cp -f onto a symlink follows it and
    overwrites the link's target — on 2026-07-26 that silently replaced
    Chicago95's generic places/{22,24}/folder.png while the intended destination
    was folder-documents.png. Symlinks are unlinked and replaced, never followed.
    """
    if dest.is_symlink():
        target = os.readlink(dest)
        print(f"  replacing symlink {dest.name} -> {target} (not writing through it)")
        dest.unlink()
        return
    if not dest.exists():
        return

    digest = file_digest(dest)
    duplicates = art_exists_elsewhere(theme_root, digest, dest)
    if duplicates:
        rels = ", ".join(sorted(p.name for p in duplicates)[:4])
        print(f"  replacing {dest.name}; art survives as {rels}")
        return

    if preserve_as:
        keep = dest.with_name(f"{preserve_as}{dest.suffix}")
        if keep.exists() or keep.is_symlink():
            raise SystemExit(f"--preserve-as target already exists: {keep}")
        dest.rename(keep)
        print(f"  preserved unique art: {dest.name} -> {keep.name}")
        return

    if allow_destroy:
        print(f"  DESTROYING unique art at {dest} (--force-destroy)")
        return

    raise SystemExit(
        f"refusing to destroy unique art: {dest}\n"
        f"  This is the only copy of this image in {theme_root.name}.\n"
        f"  Re-run with --preserve-as <name> to rename it first, "
        f"or --force-destroy to overwrite it anyway."
    )


def parse_csv(value: str) -> list[str]:
    return [item.strip() for item in value.split(",") if item.strip()]


def replace_path(path: Path) -> None:
    if path.is_symlink() or path.is_file():
        path.unlink()
    elif path.exists():
        raise SystemExit(f"refusing to replace non-file path: {path}")


def write_icon_alias(alias: Path, target_name: str, copy_aliases: bool) -> None:
    if alias.exists() or alias.is_symlink():
        replace_path(alias)
    if copy_aliases:
        source = alias.with_name(target_name)
        alias.write_bytes(source.read_bytes())
    else:
        alias.symlink_to(target_name)


def parse_hex_color(value: str) -> tuple[int, int, int]:
    color = value.strip()
    if color.startswith("#"):
        color = color[1:]
    if len(color) != 6:
        raise argparse.ArgumentTypeError("expected RGB hex color such as #ff00ff")
    try:
        return tuple(int(color[i : i + 2], 16) for i in (0, 2, 4))
    except ValueError as exc:
        raise argparse.ArgumentTypeError("expected RGB hex color such as #ff00ff") from exc


def remove_color_key(image: Image.Image, color: tuple[int, int, int], tolerance: int) -> Image.Image:
    keyed = image.convert("RGBA")
    pixels = keyed.load()
    width, height = keyed.size
    cr, cg, cb = color
    for y in range(height):
        for x in range(width):
            r, g, b, a = pixels[x, y]
            if (
                abs(r - cr) <= tolerance
                and abs(g - cg) <= tolerance
                and abs(b - cb) <= tolerance
            ):
                pixels[x, y] = (r, g, b, 0)
            elif a == 0:
                pixels[x, y] = (r, g, b, 0)
    return keyed


def trim_transparent(image: Image.Image, padding: int) -> Image.Image:
    alpha = image.getchannel("A")
    bbox = alpha.getbbox()
    if bbox is None:
        return image

    left, top, right, bottom = bbox
    if padding > 0:
        left = max(0, left - padding)
        top = max(0, top - padding)
        right = min(image.width, right + padding)
        bottom = min(image.height, bottom + padding)

    cropped = image.crop((left, top, right, bottom))
    return pad_to_square(cropped)


def pad_to_square(image: Image.Image) -> Image.Image:
    side = max(image.width, image.height)
    if image.width == image.height:
        return image
    square = Image.new("RGBA", (side, side), (0, 0, 0, 0))
    square.paste(image, ((side - image.width) // 2, (side - image.height) // 2))
    return square


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Inject scaled app icons into repo-managed DotCortex icon themes."
    )
    parser.add_argument("source", help="source image, usually a large PNG")
    parser.add_argument("--themes", default="Irixium,BeOS-r5-Icons", help="comma-separated theme names")
    parser.add_argument("--names", required=True, help="comma-separated icon names without .png")
    parser.add_argument("--sizes", default="", help="comma-separated sizes; default follows each theme")
    parser.add_argument(
        "--copy-aliases",
        action="store_true",
        help="write every --names entry as a physical PNG instead of symlinking aliases",
    )
    parser.add_argument(
        "--resample",
        choices=("nearest", "lanczos"),
        default="nearest",
        help="nearest for pixel art, lanczos for smooth artwork",
    )
    parser.add_argument(
        "--transparent-color",
        type=parse_hex_color,
        default=None,
        help="make matching RGB pixels transparent before resizing, for color-keyed source art",
    )
    parser.add_argument(
        "--transparent-tolerance",
        type=int,
        default=0,
        help="per-channel tolerance for --transparent-color, default exact match",
    )
    parser.add_argument(
        "--magic-pink",
        action="store_true",
        help="shortcut for --transparent-color #ff00ff",
    )
    parser.add_argument(
        "--trim-transparent",
        action="store_true",
        help="crop transparent borders after color-keying and pad back to square before resizing",
    )
    parser.add_argument(
        "--trim-padding",
        type=int,
        default=0,
        help="source-pixel padding to preserve around --trim-transparent crops",
    )
    parser.add_argument(
        "--square",
        action="store_true",
        help="pad a non-square source onto a transparent square canvas instead of "
             "stretching it. Game sprites are rarely square (Doom's STFST01 is 24x29) "
             "and the default resize to (size, size) silently distorts them.",
    )
    parser.add_argument(
        "--category",
        default="apps",
        help="icon-theme category directory: apps, places, mimetypes, ... (default apps)",
    )
    parser.add_argument(
        "--from-theme-icon",
        default="",
        help="copy an existing icon in the SAME theme, per size, byte-for-byte, "
             "instead of resampling a source image. Use for aliasing one icon "
             "name onto another (e.g. folder-documents from user-home) where "
             "resampling would degrade hand-made per-size pixel art. When given, "
             "the positional source argument is ignored.",
    )
    parser.add_argument(
        "--preserve-as",
        default="",
        help="if a destination holds art found nowhere else in the theme, rename "
             "it to this name instead of destroying it",
    )
    parser.add_argument(
        "--force-destroy",
        action="store_true",
        help="permit overwriting art that exists nowhere else in the theme. "
             "Never use casually: the working-tree copy is gone.",
    )
    parser.add_argument("--repo-root", default=".", help="DotCortex repository root")
    args = parser.parse_args()

    repo_root = Path(args.repo_root).expanduser().resolve()
    if args.from_theme_icon:
        source = None
    else:
        source = Path(args.source).expanduser().resolve()
        if not source.is_file():
            raise SystemExit(f"missing source image: {source}")

    names = parse_csv(args.names)
    themes = parse_csv(args.themes)
    explicit_sizes = tuple(int(size) for size in parse_csv(args.sizes))
    if not names:
        raise SystemExit("--names must contain at least one icon name")

    resample = Image.Resampling.NEAREST if args.resample == "nearest" else Image.Resampling.LANCZOS
    image = None
    if source is not None:
        image = Image.open(source).convert("RGBA")
        transparent_color = (255, 0, 255) if args.magic_pink else args.transparent_color
        if transparent_color is not None:
            if args.transparent_tolerance < 0:
                raise SystemExit("--transparent-tolerance must be zero or greater")
            image = remove_color_key(image, transparent_color, args.transparent_tolerance)
        if args.trim_padding < 0:
            raise SystemExit("--trim-padding must be zero or greater")
        if args.trim_transparent:
            image = trim_transparent(image, args.trim_padding)
        if args.square:
            image = pad_to_square(image)

    written = 0
    skipped = 0
    for theme in themes:
        theme_root = repo_root / f"linux/.local/share/icons/{theme}"
        if not theme_root.is_dir():
            raise SystemExit(f"no such theme directory: {theme_root}")
        sizes = explicit_sizes or THEME_SIZES.get(theme)
        if not sizes:
            raise SystemExit(f"unknown theme without explicit --sizes: {theme}")
        for size in sizes:
            icon_dir = repo_root / theme_icon_dir(theme, size, args.category)
            if args.from_theme_icon:
                # Per-size exact copy. Only act where the donor exists at this
                # size: silently synthesising a missing size would invent art the
                # pack never had.
                donor = icon_dir / f"{args.from_theme_icon}.png"
                if not donor.exists():
                    print(f"  skip {theme} {size}px: no donor {donor.name}")
                    skipped += 1
                    continue
                payload = donor.resolve().read_bytes()
            else:
                icon_dir.mkdir(parents=True, exist_ok=True)
                payload = None

            if not icon_dir.is_dir():
                print(f"  skip {theme} {size}px: no {args.category}/{size} directory")
                skipped += 1
                continue

            primary = icon_dir / f"{names[0]}.png"
            guard_destination(primary, theme_root, args.preserve_as or None, args.force_destroy)
            if payload is not None:
                primary.write_bytes(payload)
                print(f"{primary.relative_to(repo_root)} {size}x{size} (from {args.from_theme_icon})")
            else:
                image.resize((size, size), resample).save(primary)
                print(f"{primary.relative_to(repo_root)} {size}x{size}")
            written += 1
            for name in names[1:]:
                alias = icon_dir / f"{name}.png"
                guard_destination(alias, theme_root, args.preserve_as or None, args.force_destroy)
                write_icon_alias(alias, primary.name, args.copy_aliases)
                mode = "copy" if args.copy_aliases else "symlink"
                print(f"{alias.relative_to(repo_root)} -> {primary.name} ({mode})")
                written += 1

    if skipped:
        print(f"icon-theme-inject: skipped {skipped} size(s) with no donor/directory")

    print(f"icon-theme-inject: wrote {written} icon files")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
