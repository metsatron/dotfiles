#!/usr/bin/env python3
"""Read and resolve the shared unattended approval queue."""
import argparse
import importlib.util
import json
import os
from pathlib import Path
import sys


def _engine():
    override = os.environ.get('DOTCORTEX_APPROVAL_ENGINE')
    here = Path(__file__).resolve()
    candidates = [Path(override)] if override else [
        here.parent / 'claude_approval_kikin.py',
        here.parents[1] / 'lib/dotcortex/claude_approval_kikin.py',
        Path.home() / '.local/lib/dotcortex/claude_approval_kikin.py',
    ]
    path = next((candidate for candidate in candidates if candidate.is_file()), None)
    if path is None:
        raise RuntimeError('shared approval engine not found')
    spec = importlib.util.spec_from_file_location('approval_queue_engine', path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def _list(module):
    items = module._queue_snapshot()
    if items is None:
        raise RuntimeError('queue unavailable')
    return {
        'schema': module.QUEUE_LIST_SCHEMA,
        'awaiting': [item for item in items if item.get('status') == 'open'],
        'done_while_away': [item for item in items if item.get('status') == 'resolved'],
        'obsolete': [item for item in items if item.get('status') == 'obsolete'],
    }


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='command', required=True)
    commands.add_parser('list', help='show awaiting, done-while-away and obsolete items as JSON')
    resolve = commands.add_parser('resolve', help='mark an item resolved without replaying it')
    resolve.add_argument('item_id')
    resolve.add_argument('--how', required=True, help='one-line explanation of how it was achieved')
    sweep = commands.add_parser('sweep', help='run the deterministic staleness sweep')
    sweep.set_defaults(sweep=True)
    check = commands.add_parser('recheck', help='consume one pre-replay approval token')
    check.add_argument('item_id')
    check.add_argument('--confirmation', required=True, help='fresh confirmation from the waking seat')
    check.add_argument('--seat')
    args = parser.parse_args()
    try:
        module = _engine()
        if args.command == 'list':
            result = _list(module)
        elif args.command == 'sweep':
            result = _list(module)
        elif args.command == 'resolve':
            item = module._queue_resolve(args.item_id, args.how)
            if item is None:
                raise RuntimeError('item not found, not open, or invalid --how')
            result = {'schema': module.QUEUE_ACTION_SCHEMA, 'action': 'resolve', 'item': item}
        else:
            result = module._pre_replay_check(args.item_id, args.confirmation, args.seat)
        print(json.dumps(result, ensure_ascii=True, sort_keys=True, separators=(',', ':')))
        return 0
    except (OSError, RuntimeError, TypeError, ValueError) as exc:
        print('approval queue unavailable: ' + str(exc), file=sys.stderr)
        return 1


if __name__ == '__main__':
    raise SystemExit(main())
