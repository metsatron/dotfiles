#!/usr/bin/env bash
# [[file:../../../agents-hooks.org::*Agent IDE notifications][Agent IDE notifications:5]]
# ~/DotCortex/all/.local/bin/antigravity-hook-idle-event
# Forward validated lifecycle facts from Antigravity to the antigravity-warm supervisor.
set -u

channel="${ANTIGRAVITY_IDLE_CHANNEL:-}"
owner="${ANTIGRAVITY_IDLE_OWNER:-}"
supervised=0
if [ "${owner}" = "pty-supervisor" ] && [[ "${channel}" =~ ^antigravity-[0-9a-f]{32}$ ]]; then
  supervised=1
fi
if [ "${supervised}" -ne 1 ]; then
  exit 0
fi

payload=$(cat 2>/dev/null || true)
command -v jq >/dev/null 2>&1 || exit 0
[ -n "$payload" ] || exit 0
jq -e . >/dev/null 2>&1 <<<"$payload" || exit 0

event=$(jq -r '.hookEventName // .hook_event_name // empty' <<<"$payload" 2>/dev/null || true)
session_id=$(jq -r '.conversationId // .conversation_id // .session_id // empty' <<<"$payload" 2>/dev/null || true)
stop_hook_active=$(jq -r 'if has("stop_hook_active") then .stop_hook_active else empty end' \
  <<<"$payload" 2>/dev/null || true)

case "$event" in
  Stop)
    [ "$stop_hook_active" = "false" ] || exit 0
    event_symbol=stop ;;
  SessionStart) event_symbol=session-start ;;
  PreInvocation) event_symbol=user-prompt-submit ;;
  PostInvocation) event_symbol=session-activity ;;
  PreToolUse|PostToolUse) event_symbol=session-activity ;;
  PostCompact) event_symbol=post-compact ;;
  StopFailure) event_symbol=stop-failure ;;
  SessionEnd) event_symbol=session-end ;;
  *) exit 0 ;;
esac

case "$session_id" in
  "") exit 0 ;;
  *[!A-Za-z0-9._:-]*) exit 0 ;;
esac

if [ -n "${ANTIGRAVITY_IDLE_CONTROL_SOCKET:-}" ] \
    && command -v python3 >/dev/null 2>&1 && command -v timeout >/dev/null 2>&1; then
  timeout 3s python3 - "$ANTIGRAVITY_IDLE_CONTROL_SOCKET" "$event_symbol" \
    "$channel" "$session_id" "$stop_hook_active" <<'PY' \
    >/dev/null 2>&1 || true
import json
import socket
import sys

path, event, channel, session_id, stop_hook_active = sys.argv[1:]
message = {
    "kind": "event",
    "event": event,
    "channel": channel,
    "session_id": session_id,
}
if event == "stop":
    message["stop_hook_active"] = False
with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
    connection.settimeout(2.0)
    connection.connect(path)
    connection.sendall((json.dumps(message, separators=(",", ":")) + "\n").encode())
    connection.recv(4096)
PY
fi
exit 0
# Agent IDE notifications:5 ends here
