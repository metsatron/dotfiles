#!/usr/bin/env bash
# OpenCode launcher wrapper

# [[file:../../../hooks.org::*OpenCode launcher wrapper][OpenCode launcher wrapper:1]]
# ~/DotCortex/all/.local/bin/opencode
# Temporary compatibility wrapper: OpenCode 1.17.12 full TUI accepts text in this
# tmux/runtime but does not submit on Enter. The mini TUI submits through the
# same backend/provider path, so default interactive TUI launches to --mini.
set -euo pipefail

real="$HOME/.npm-global/bin/opencode"

if [ ! -x "$real" ]; then
    echo "opencode wrapper: real executable not found: $real" >&2
    exit 127
fi

for arg in "$@"; do
    case "$arg" in
        --mini|--help|-h|--version|-v)
            exec "$real" "$@"
            ;;
    esac
done

if [ "${OPENCODE_FULL_TUI:-0}" = "1" ]; then
    exec "$real" "$@"
fi

first=""
skip_next=0
for arg in "$@"; do
    if [ "$skip_next" = "1" ]; then
        skip_next=0
        continue
    fi
    case "$arg" in
        --model|-m|--session|-s|--agent|--prompt|--port|--hostname|--mdns-domain|--replay-limit)
            skip_next=1
            ;;
        --model=*|-m=*|--session=*|-s=*|--agent=*|--prompt=*|--port=*|--hostname=*|--mdns-domain=*|--replay-limit=*)
            ;;
        --*) ;;
        -*) ;;
        *) first="$arg"; break ;;
    esac
done

case "$first" in
    ""|/*|./*|../*|~*)
        exec "$real" --mini "$@"
        ;;
    acp|attach|completion|debug|db|export|github|import|mcp|models|plugin|providers|auth|agent|pr|run|serve|session|stats|uninstall|upgrade|web)
        exec "$real" "$@"
        ;;
    *)
        if [ -d "$first" ]; then
            exec "$real" --mini "$@"
        fi
        exec "$real" "$@"
        ;;
esac
# OpenCode launcher wrapper:1 ends here
