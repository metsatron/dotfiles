#!/usr/bin/env bash
# Helper: provision-gate


# [[file:../../../package-host-gates.org::*Helper: provision-gate][Helper: provision-gate:1]]
set -euo pipefail

ROOT="${DOTCORTEX_ROOT:-$HOME/DotCortex}"
HOST="${PROVISION_GATE_HOSTNAME:-$(hostname -s 2>/dev/null || hostname)}"

usage() {
  cat <<EOF
Usage: provision-gate status              show this host's gate
       provision-gate is-gated            exit 0 if this host is gated, else 1
       provision-gate gate                print the gate name, or "open"
       provision-gate manifest            print the gated nala manifest path (absolute), or nothing
       provision-gate host                print the hostname the gate is evaluated for
       provision-gate mode <lane>         print open | dry-run | additive for a package lane
       provision-gate allow-removal <lane> [what...]
                                          exit 0 if removals may run here, else refuse (exit 1)
Env:   PROVISION_GATES (gate file; default: repo copy + ~/.provision/host-gates.ssv)
       PROVISION_GATE_HOSTNAME (default: hostname -s)
       PROVISION_APPLY=1 (gated hosts: allow additive installs)
EOF
}

gate_files() {
  if [ -n "${PROVISION_GATES:-}" ]; then
    printf '%s\n' "$PROVISION_GATES"
    return
  fi
  printf '%s\n' "$ROOT/all/.provision/host-gates.ssv" "$HOME/.provision/host-gates.ssv"
}

# Print "GATE<TAB>MANIFEST" for this host from the first file that has a row.
gate_row() {
  local file
  while IFS= read -r file; do
    [ -f "$file" ] || continue
    if awk -v host="$HOST" '
         /^[ \t]*#/ || NF==0 { next }
         $1==host { print $2 "\t" ($3 == "" ? "-" : $3); found=1; exit }
         END { exit(found?0:1) }
       ' "$file"; then
      return 0
    fi
  done < <(gate_files)
  return 1
}

row="$(gate_row || true)"
GATE="open"
MANIFEST="-"
if [ -n "$row" ]; then
  GATE="${row%%$'\t'*}"
  MANIFEST="${row#*$'\t'}"
  case "$GATE" in
    additive) ;;
    *) GATE="additive" ;;  # unknown gate names fail safe
  esac
fi

cmd="${1:-}"
case "$cmd" in
  -h|--help|help) usage; exit 0 ;;
  status)
    if [ "$GATE" = open ]; then
      echo "$HOST: open (no provisioning gate)"
    else
      echo "$HOST: gated ($GATE), manifest=$MANIFEST, PROVISION_APPLY=${PROVISION_APPLY:-0}"
    fi
    ;;
  is-gated) [ "$GATE" != open ] ;;
  gate) echo "$GATE" ;;
  host) echo "$HOST" ;;
  manifest)
    if [ "$GATE" != open ] && [ "$MANIFEST" != "-" ]; then
      case "$MANIFEST" in
        /*) echo "$MANIFEST" ;;
        *) echo "$ROOT/$MANIFEST" ;;
      esac
    fi
    ;;
  mode)
    lane="${2:?Usage: provision-gate mode <lane>}"
    if [ "$GATE" = open ]; then
      echo open
    elif [ "${PROVISION_APPLY:-0}" = 1 ]; then
      echo "provision-gate: $HOST is gated ($GATE): $lane runs additive-only (installs yes, removals never)" >&2
      echo additive
    else
      echo "provision-gate: $HOST is gated ($GATE): $lane is dry-run; set PROVISION_APPLY=1 to install (removals stay refused)" >&2
      echo dry-run
    fi
    ;;
  allow-removal)
    lane="${2:?Usage: provision-gate allow-removal <lane> [what...]}"
    shift 2
    if [ "$GATE" = open ]; then
      exit 0
    fi
    echo "REFUSED: $HOST is gated ($GATE): $lane removal is never run here${*:+: $*}" >&2
    echo "         remove the host's row from host-gates.ssv in a reviewed commit to change that" >&2
    exit 1
    ;;
  *) usage >&2; exit 2 ;;
esac
# Helper: provision-gate:1 ends here
