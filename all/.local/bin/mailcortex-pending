#!/usr/bin/env bash
# mailcortex-pending — the queue of mail that actually still needs attention.
#
# `mailcortex inbox` lists archived (cur/) mail alongside pending (new/) mail, which
# reads as a far larger backlog than exists and has already caused a mis-triage:
# items quoted as "unread" had been read days earlier. This prints ONLY new/, one
# line per message, with the filename token first so it can be piped into
# `mailcortex read`.
set -euo pipefail
seat="${1:-hermes@kikin.helm}"
mailcortex inbox "$seat" 2>/dev/null |
    awk -F'\t' '$1=="new"{printf "%s\t%s\t%s\n", $2, $4, $5}' |
    sort -t$'\t' -k2
