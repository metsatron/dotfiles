#!/usr/bin/env bash
# hx-apply — generate local shims from the manifest. Works with the mount DOWN,
# by falling back to the machine-local cache. See helmcortex-shims.org.
set -euo pipefail

HELM="${HELMCORTEX_ROOT:-$HOME/HelmCortex}"
MANIFEST="${HELM}/ROOTS/DotCortex/helmcortex-shims.ssv"
CACHE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/dotcortex/hx"
CACHE="${CACHE_DIR}/manifest.ssv"
SHIM_DIR="${HOME}/.local/hx/bin"
PROBE_TIMEOUT=2

die() { echo "hx-apply: $*" >&2; exit 1; }

# Prefer the authoritative manifest; fall back to the cache. Announce which was
# used — a run whose source of truth is ambiguous is worse than one that fails.
src=""
if timeout -k 1 "${PROBE_TIMEOUT}" test -r "${MANIFEST}" 2>/dev/null; then
  src="${MANIFEST}"
  mkdir -p "${CACHE_DIR}"
  cp -f "${MANIFEST}" "${CACHE}" 2>/dev/null || true
  echo "hx-apply: source = HelmCortex manifest (mount up, cache refreshed)"
elif [ -r "${CACHE}" ]; then
  src="${CACHE}"
  echo "hx-apply: source = local cache (HelmCortex unreachable)"
else
  die "no manifest and no cache — run hx-capture on a machine that can see HelmCortex"
fi

mkdir -p "${SHIM_DIR}"

wanted="$(mktemp)"; trap 'rm -f "${wanted}"' EXIT
added=0; kept=0

while read -r name dir; do
  case "${name}" in ''|\#*) continue ;; esac
  [ -n "${dir}" ] || continue
  echo "${name}" >> "${wanted}"
  target="${SHIM_DIR}/${name}"
  new="$(mktemp)"
  cat > "${new}" <<SHIM
#!/usr/bin/env bash
# hx shim — ${name}  (generated by hx-apply; edit helmcortex-shims.org, not this)
set -euo pipefail
DIR="\$HOME/HelmCortex/${dir}"
TOOL="${name}"
REAL="\$DIR/\$TOOL"

# Is the mount alive? Bounded at 2s because a wedged soft NFS mount takes ~9s to
# give up on its own (timeo=30 is tenths of a second, x2 retransmits). -k adds an
# unconditional SIGKILL so the bound does not depend on SIGTERM breaking a killable
# RPC wait. Relies on the mount being 'soft'; see helmcortex-shims.org.
if ! timeout -k 1 2 test -d "\$DIR" 2>/dev/null; then
  echo "hx: HelmCortex unreachable — \$DIR did not answer in 2s" >&2
  exit 69
fi

# Is the tool actually there and runnable?
if ! timeout -k 1 2 test -x "\$REAL" 2>/dev/null; then
  echo "hx: \$TOOL missing or not executable at \$REAL" >&2
  exit 127
fi

# Run it from its own directory so relative modules resolve; keep the caller's
# cwd reachable for any tool that needs to resolve a user-supplied path.
export HX_CALLER_PWD="\$PWD"
cd "\$DIR"
exec "\$REAL" "\$@"
SHIM
  chmod 755 "${new}"
  if [ -f "${target}" ] && cmp -s "${new}" "${target}"; then
    kept=$((kept + 1)); rm -f "${new}"
  else
    mv -f "${new}" "${target}"
    added=$((added + 1)); echo "  + ${name}  (${dir})"
  fi
done < "${src}"

# Prune orphans: shims whose tool is no longer in the manifest.
removed=0
if [ -d "${SHIM_DIR}" ]; then
  while IFS= read -r existing; do
    [ -n "${existing}" ] || continue
    n="$(basename "${existing}")"
    if ! grep -qxF "${n}" "${wanted}"; then
      rm -f "${existing}"; removed=$((removed + 1)); echo "  - ${n}  (orphan)"
    fi
  done < <(find "${SHIM_DIR}" -maxdepth 1 -type f 2>/dev/null)
fi

echo "hx-apply: ${added} written, ${kept} unchanged, ${removed} pruned -> ${SHIM_DIR}"
