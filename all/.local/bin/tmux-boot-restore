#!/usr/bin/env bash
set -uo pipefail

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
LOG="${XDG_STATE_HOME:-$HOME/.local/state}/tmux-boot-restore.log"
STATE_ROOT="${XDG_STATE_HOME:-$HOME/.local/state}/claude-idle-compaction"
NURSE_JOY="$HOME/HelmCortex/FORGE/bin/nurse-joy"
BOT_NAMES="Auryn Fable Haiku Opus"
mkdir -p "$(dirname "$LOG")"
exec >>"$LOG" 2>&1
echo "$(date -Is) tmux-boot-restore: start"

all_bot_sessions_present() {
  local bot
  for bot in $BOT_NAMES; do
    tmux has-session -t "$bot" 2>/dev/null || return 1
  done
}

network_ready() {
  getent ahosts api.telegram.org >/dev/null 2>&1 || return 1
  getent ahosts api.anthropic.com >/dev/null 2>&1 || return 1
  curl -sS --connect-timeout 3 --max-time 5 -o /dev/null https://api.telegram.org || return 1
  curl -sS --connect-timeout 3 --max-time 5 -o /dev/null https://api.anthropic.com || return 1
}

durable_session_id() {
  local record="$STATE_ROOT/last-session.${1}.json"
  [ -r "$record" ] || return 1
  python3 - "$record" <<'PY'
import json
import re
import sys

try:
    value = json.load(open(sys.argv[1], encoding="utf-8")).get("session_id", "")
except (OSError, ValueError, TypeError):
    raise SystemExit(1)
if not re.fullmatch(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", str(value)):
    raise SystemExit(1)
print(value)
PY
}

# Wait for the runtime, every local executable, DNS and both remote endpoints.
# A tmux session name alone is not agent readiness.
for _ in $(seq 1 90); do
  if [ -d "$XDG_RUNTIME_DIR" ] \
    && command -v tmux >/dev/null 2>&1 \
    && command -v bun >/dev/null 2>&1 \
    && command -v python3 >/dev/null 2>&1 \
    && command -v getent >/dev/null 2>&1 \
    && command -v curl >/dev/null 2>&1 \
    && [ -x "${CLAUDE_IDLE_REAL_EXECUTABLE:-}" ] \
    && [ -x "$NURSE_JOY" ] \
    && network_ready; then
      break
  fi
  sleep 2
done
command -v tmux >/dev/null 2>&1 || { echo "$(date -Is) bootstrap failed: tmux unavailable"; exit 1; }
command -v bun >/dev/null 2>&1 || { echo "$(date -Is) bootstrap failed: bun unavailable"; exit 1; }
[ -x "${CLAUDE_IDLE_REAL_EXECUTABLE:-}" ] || { echo "$(date -Is) bootstrap failed: Claude executable unavailable"; exit 1; }
[ -x "$NURSE_JOY" ] || { echo "$(date -Is) bootstrap failed: Nurse Joy unavailable"; exit 1; }
network_ready || { echo "$(date -Is) bootstrap failed: network endpoints unavailable"; exit 1; }

# Never clobber a live tree: if the server already holds real (non-_boot) sessions, stop.
if tmux list-sessions 2>/dev/null | grep -qv '^_boot:'; then
  echo "$(date -Is) server already has sessions; skipping restore"
  exit 0
fi

# Start the server via a throwaway session: this loads the config -> TPM ->
# continuum, and @continuum-restore 'on' recreates the saved seats. Nurse Joy
# owns process launch after every seat exists.
tmux new-session -d -s _boot -c "$HOME" 2>/dev/null || true
echo "$(date -Is) server started; waiting for continuum restore"

# Give continuum up to ~60s to restore all four bot seats.
for _ in $(seq 1 30); do
  all_bot_sessions_present && break
  sleep 2
done

if all_bot_sessions_present; then
  tmux kill-session -t _boot 2>/dev/null || true
  echo "$(date -Is) seats restored: $(tmux list-sessions 2>/dev/null | cut -d: -f1 | paste -sd, -)"
else
  echo "$(date -Is) continuum did not restore within timeout; running explicit resurrect restore"
  restore="$HOME/.tmux/plugins/tmux-resurrect/scripts/restore.sh"
  if [ -x "$restore" ]; then "$restore"; else echo "$(date -Is) explicit restore.sh unavailable"; fi
fi

for _ in $(seq 1 30); do
  all_bot_sessions_present && break
  sleep 2
done
all_bot_sessions_present || { echo "$(date -Is) restore failed: not all Claude seats exist"; exit 1; }

result=0
for bot in $BOT_NAMES; do
  session_id="$(durable_session_id "$bot" 2>/dev/null || true)"
  if [ -z "$session_id" ]; then
    echo "$(date -Is) $bot revive refused: no valid durable session id"
    result=1
    continue
  fi
  echo "$(date -Is) $bot revive: durable session $session_id"
  "$NURSE_JOY" revive "$bot" --resume "$session_id" --no-visit || result=1
done

if [ "$result" -eq 0 ]; then
  echo "$(date -Is) restore confirmed: all four Claude Telegram agents ready"
else
  echo "$(date -Is) restore degraded: one or more Claude Telegram agents failed readiness"
fi
echo "$(date -Is) tmux-boot-restore: done"
exit "$result"
