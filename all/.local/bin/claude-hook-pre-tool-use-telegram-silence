#!/usr/bin/env bash
# [[file:../../../agents-hooks.org::*Cross-harness stow target guard][Cross-harness stow target guard:2]]
# ~/DotCortex/all/.local/bin/claude-hook-pre-tool-use-telegram-silence
# PreToolUse hook for mcp__plugin_telegram_telegram__reply -- refuses to send the silence
# marker. The Stop-hook delivery guard only blocks a turn that SPOKE without delivering; a
# seat that calls the reply tool with the literal token delivers it, and the operator gets
# "NO_REPLY" in his chat (HelmDuctor, 2026-11-19 19:08 and 19:55). The token is a delivery
# instruction, not words, so it must never reach Telegram.
#
# Exit 2 blocks the tool call and sends stderr to the agent as the reason. The reason has to
# end the retry loop explicitly, or the seat answers NO_REPLY again and nothing improves.
# No set -euo pipefail: a hook must not abort on a grep non-match.

input=$(cat)
verdict=$(printf '%s' "$input" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
    text = (d.get("tool_input") or {}).get("text") or ""
except Exception:
    text = ""
print("silent" if text.strip().upper() == "NO_REPLY" or not text.strip() else "send")
' 2>/dev/null) || true

if [ "$verdict" = "silent" ]; then
  cat >&2 <<'MSG'
SILENCE MARKER: the reply text is NO_REPLY, which means this turn says nothing to the
operator by design. Nothing was sent, and nothing should be sent. Do not retry the reply
tool and do not send an explanation of this refusal -- end the turn now. If you actually
have something to tell him, call the reply tool with the real message instead.
MSG
  exit 2
fi

exit 0
# Cross-harness stow target guard:2 ends here
