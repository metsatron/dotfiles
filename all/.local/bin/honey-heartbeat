#!/usr/bin/python3 -I
"""honey-heartbeat (generated by agents-bots-honey.org): a heartbeat a supervised service writes, and a check that tells DEAD from SILENT.

The gap it closes (2026-11-12): "dead since 8 November" and "alive, idle" produced identical logs, because a service that logs only when it has
work is indistinguishable, from outside, from one that is gone. A heartbeat is proof of life the service writes WHILE IT IS IDLE.

  beat  NAME [--status ok|degraded|failing] [--detail TEXT] [--pid N] [--dir DIR]
        atomically (re)writes DIR/NAME.json: {name, pid, ts, seq, status, detail}. Call it from the service's own loop. --pid defaults to the caller's
        parent (the service, when a service shell calls it).
  check NAME --pidfile FILE --max-age SECONDS [--dir DIR] [--json]
  check-all SPECFILE [--dir DIR]       SPECFILE lines: NAME PIDFILE MAX_AGE_SECONDS   (# comments allowed)

check reports exactly one state per service, each with its own exit status, so "no heartbeat" is never confused with "unhealthy" or "dead":
  HEALTHY       0  the process is alive AND a heartbeat from THAT process is fresh and says ok
  UNHEALTHY     1  the process is alive and its fresh heartbeat says degraded or failing: the service itself reports a problem
  NO-HEARTBEAT  2  the process is alive but there is no usable fresh heartbeat from it: missing, unreadable, older than --max-age, from the future,
                   or written by a different pid (a previous incarnation). Alive and silent: not proven working, not proven dead.
  DEAD          3  there is no live process (no pidfile, a dead pid, a zombie). If a heartbeat exists its age says when the service was last known alive.
  UNKNOWN       4  neither a pidfile nor a heartbeat exists: nothing was ever supervised under this name
check-all prints one line per service and exits with the highest status among them. A usage error exits 64, never 0 to 4. Nothing here sends an alert or touches the network: wiring this
to an alert is a separate decision."""
import json, os, re, sys, time

STATES = {'HEALTHY': 0, 'UNHEALTHY': 1, 'NO-HEARTBEAT': 2, 'DEAD': 3, 'UNKNOWN': 4}
NAME_RE = re.compile(r'^[A-Za-z0-9][A-Za-z0-9_.-]*$')
DEFAULT_DIR = '/run/honey-heartbeat'


def beat_path(d, name):
    if not NAME_RE.match(name):
        raise ValueError('bad service name %r' % name)
    return os.path.join(d, name + '.json')


def write_beat(d, name, pid, status='ok', detail='', now=None):
    if status not in ('ok', 'degraded', 'failing'):
        raise ValueError('status must be ok, degraded or failing')
    path = beat_path(d, name)
    seq = 0
    try:
        with open(path) as fh:
            seq = int(json.load(fh).get('seq', 0))
    except (OSError, ValueError, TypeError):
        pass
    rec = {'name': name, 'pid': int(pid), 'ts': float(time.time() if now is None else now), 'seq': seq + 1, 'status': status, 'detail': str(detail)[:200]}
    tmp = '%s.tmp.%d' % (path, os.getpid())
    os.makedirs(d, exist_ok=True)
    with open(tmp, 'w') as fh:
        json.dump(rec, fh)
        fh.flush(); os.fsync(fh.fileno())
    os.replace(tmp, path)  # readers see the old record or the new one, never half of one
    return rec


def process_state(pidfile):
    """('alive'|'dead'|'no-pidfile', pid or None)"""
    try:
        with open(pidfile) as fh:
            pid = int(fh.read().split()[0])
    except (OSError, ValueError, IndexError):
        return 'no-pidfile', None
    try:
        with open('/proc/%d/stat' % pid) as fh:
            stat = fh.read()
        state = stat[stat.rindex(')') + 2:].split()[0]
    except (OSError, ValueError):
        return 'dead', pid
    return ('dead' if state in ('Z', 'X') else 'alive'), pid


def read_beat(d, name):
    """(record or None, problem or None)"""
    path = beat_path(d, name)
    try:
        with open(path) as fh:
            rec = json.load(fh)
    except FileNotFoundError:
        return None, 'no heartbeat file'
    except (OSError, ValueError) as e:
        return None, 'heartbeat file unreadable (%s)' % type(e).__name__
    if not isinstance(rec, dict) or not isinstance(rec.get('ts'), (int, float)) or not isinstance(rec.get('pid'), int):
        return None, 'heartbeat file malformed'
    return rec, None


def check(name, pidfile, max_age, d=DEFAULT_DIR, now=None):
    now = time.time() if now is None else now
    proc, pid = process_state(pidfile)
    rec, problem = read_beat(d, name)
    age = None if rec is None else now - rec['ts']
    out = {'name': name, 'process': proc, 'pid': pid, 'beat_age': None if age is None else round(age, 1), 'max_age': max_age,
           'status': rec.get('status') if rec else None, 'detail': rec.get('detail') if rec else None, 'reason': ''}
    if rec is not None:
        out['last_beat'] = time.strftime('%Y-%m-%dT%H:%M:%S%z', time.localtime(rec['ts']))
    if proc != 'alive':
        if proc == 'no-pidfile' and rec is None and problem == 'no heartbeat file':
            out['state'], out['reason'] = 'UNKNOWN', 'no pidfile and no heartbeat: never supervised under this name'
        else:
            out['state'] = 'DEAD'
            out['reason'] = 'no live process (%s)' % ('pid %d is gone' % pid if proc == 'dead' else 'no pidfile') + \
                ('; last heartbeat %.0fs ago' % age if age is not None else '; no heartbeat ever recorded')
    elif rec is None:
        out['state'], out['reason'] = 'NO-HEARTBEAT', 'process alive but %s' % problem
    elif rec['pid'] != pid:
        out['state'], out['reason'] = 'NO-HEARTBEAT', 'process alive (pid %d) but the heartbeat is from pid %d: a previous incarnation' % (pid, rec['pid'])
    elif age < -60:
        out['state'], out['reason'] = 'NO-HEARTBEAT', 'heartbeat is %.0fs in the future (clock skew or a forged file)' % -age
    elif age > max_age:
        out['state'], out['reason'] = 'NO-HEARTBEAT', 'process alive but the last heartbeat is %.0fs old (threshold %ds)' % (age, max_age)
    elif rec.get('status') != 'ok':
        out['state'], out['reason'] = 'UNHEALTHY', 'fresh heartbeat reports %s%s' % (rec.get('status'), ': ' + rec['detail'] if rec.get('detail') else '')
    else:
        out['state'], out['reason'] = 'HEALTHY', 'process alive, heartbeat %.0fs old' % age
    out['exit'] = STATES[out['state']]
    return out


def line(r):
    return '%-13s %s process=%s%s beat_age=%s threshold=%ss%s -- %s' % (
        r['state'], r['name'], r['process'], '(%d)' % r['pid'] if r['pid'] else '', '-' if r['beat_age'] is None else '%.0fs' % r['beat_age'], r['max_age'],
        '' if r['status'] is None else ' reported=%s' % r['status'], r['reason'])


def main(argv):
    a = list(argv)
    if not a or a[0] in ('-h', '--help'):
        print(__doc__); return 0 if a else 64
    cmd, a = a[0], a[1:]
    opts, pos = {}, []
    while a:
        x = a.pop(0)
        if x.startswith('--') and x != '--json':
            if not a:
                print('honey-heartbeat: %s needs a value' % x, file=sys.stderr); return 64
            opts[x[2:]] = a.pop(0)
        elif x == '--json':
            opts['json'] = True
        else:
            pos.append(x)
    d = opts.get('dir', os.environ.get('HONEY_HEARTBEAT_DIR', DEFAULT_DIR))
    try:
        if cmd == 'beat':
            if len(pos) != 1: raise ValueError('usage: beat NAME [--status S] [--detail T] [--pid N] [--dir D]')
            write_beat(d, pos[0], int(opts.get('pid', os.getppid())), opts.get('status', 'ok'), opts.get('detail', ''))
            return 0
        if cmd == 'check':
            if len(pos) != 1 or 'pidfile' not in opts or 'max-age' not in opts: raise ValueError('usage: check NAME --pidfile F --max-age S [--dir D] [--json]')
            r = check(pos[0], opts['pidfile'], int(opts['max-age']), d)
            print(json.dumps(r) if opts.get('json') else line(r))
            return r['exit']
        if cmd == 'check-all':
            if len(pos) != 1: raise ValueError('usage: check-all SPECFILE [--dir D]')
            worst = 0
            with open(pos[0]) as fh:
                for raw in fh:
                    raw = raw.split('#', 1)[0].strip()
                    if not raw: continue
                    f = raw.split()
                    if len(f) != 3: raise ValueError('bad spec line: %r' % raw)
                    r = check(f[0], f[1], int(f[2]), d)
                    print(line(r)); worst = max(worst, r['exit'])
            return worst
        raise ValueError('unknown command %r' % cmd)
    except (ValueError, OSError) as e:
        print('honey-heartbeat: %s' % e, file=sys.stderr)
        return 64


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
