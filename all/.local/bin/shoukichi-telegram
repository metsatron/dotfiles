#!/usr/bin/env bash
# Shoukichi Instance Wrapper

# Shoukichi's =shoukichi-telegram= wrapper launches the fleet-patched vibe-bridge
# from the NEXUS mirror's pinned venv against the brain workspace. It pins
# =VIBE_HOME= to a dedicated directory under the private config dir (never the
# operator's own =~/.vibe=), projects the canonical identity from the brain's
# AGENTS.md into that VIBE_HOME as the user-global AGENTS.md (ACP mode does not
# load a workspace AGENTS.md — vibe's untrusted-directory policy), and imports an
# allowlist from the private env: the dedicated Telegram token, the Admiral-only
# allowlist, and the Vibe subscription key =MISTRAL_VIBE_API_KEY= (exported under
# the provider's =MISTRAL_API_KEY= env name; the Studio key never enters this
# lane). Launch configuration is read from a non-secret conf file beside it.


# [[file:../../../agents-bots.org::*Shoukichi Instance Wrapper][Shoukichi Instance Wrapper:1]]
# ~/DotCortex/all/.local/bin/shoukichi-telegram
set -euo pipefail

WORKSPACE="${SHOUKICHI_WORKSPACE:-$HOME/HelmCortex/FORGE/brain/shoukichi}"
CONFIG_DIR="${SHOUKICHI_CONFIG_DIR:-$HOME/.config/vibe-telegram}"
ENV_FILE="${SHOUKICHI_ENV_FILE:-$CONFIG_DIR/env}"
CONF_FILE="${SHOUKICHI_CONF_FILE:-$CONFIG_DIR/shoukichi.conf}"
VIBE_HOME_DIR="${SHOUKICHI_VIBE_HOME:-$CONFIG_DIR/vibe-home}"
BRIDGE_REPO="${SHOUKICHI_BRIDGE_REPO:-$HOME/HelmCortex/NEXUS/git/vibe-bridge}"
VENV_PY="${SHOUKICHI_VENV_PY:-$BRIDGE_REPO/.venv/bin/python}"

[ -x "$VENV_PY" ] || {
    echo "vibe-bridge runtime missing: $VENV_PY" >&2
    echo "(provision the mirror's pinned venv: see agents-bots.org, Shoukichi)" >&2
    exit 1
}
[ -d "$WORKSPACE" ] || {
    echo "Shoukichi workspace missing: $WORKSPACE" >&2
    exit 1
}
[ -r "$ENV_FILE" ] || {
    echo "Shoukichi private env missing: $ENV_FILE" >&2
    exit 1
}
[ -r "$WORKSPACE/AGENTS.md" ] || {
    echo "Shoukichi identity source missing: $WORKSPACE/AGENTS.md" >&2
    exit 1
}
[ -r "$VIBE_HOME_DIR/config.toml" ] || {
    echo "Shoukichi VIBE_HOME config missing: $VIBE_HOME_DIR/config.toml" >&2
    echo "(install from all/.bots/templates/shoukichi-vibe-home-config.toml)" >&2
    exit 1
}

# Identity projection: ACP mode loads the user-global AGENTS.md from VIBE_HOME,
# not the workspace one. Project the canonical brain identity there on every
# start so the two can never diverge silently.
mkdir -p "$VIBE_HOME_DIR"
chmod 700 "$VIBE_HOME_DIR"
cp -- "$WORKSPACE/AGENTS.md" "$VIBE_HOME_DIR/AGENTS.md"
chmod 600 "$VIBE_HOME_DIR/AGENTS.md"

# Private env allowlist. Network identity and the Vibe subscription key belong
# only in this uncommitted machine-local file; nothing here is evaluated.
TOKEN_PROVISIONED=0
ALLOWLIST_PROVISIONED=0
VIBE_KEY_PROVISIONED=0
while IFS='=' read -r key value; do
    key="${key%$'\r'}"
    value="${value%$'\r'}"
    case "$key" in
        TELEGRAM_BOT_TOKEN)
            [ -n "$value" ] && export TELEGRAM_BOT_TOKEN="$value" && TOKEN_PROVISIONED=1
            ;;
        TELEGRAM_ALLOWED_USER_IDS)
            [ -n "$value" ] && export TELEGRAM_ALLOWED_USER_IDS="$value" && ALLOWLIST_PROVISIONED=1
            ;;
        MISTRAL_VIBE_API_KEY)
            [ -n "$value" ] && export MISTRAL_API_KEY="$value" && VIBE_KEY_PROVISIONED=1
            ;;
    esac
done < "$ENV_FILE"
[ "$TOKEN_PROVISIONED" = 1 ] || {
    echo "Shoukichi TELEGRAM_BOT_TOKEN is not provisioned in $ENV_FILE" >&2
    exit 1
}
[ "$ALLOWLIST_PROVISIONED" = 1 ] || {
    echo "Shoukichi TELEGRAM_ALLOWED_USER_IDS is not provisioned in $ENV_FILE" >&2
    exit 1
}
[ "$VIBE_KEY_PROVISIONED" = 1 ] || {
    echo "Shoukichi MISTRAL_VIBE_API_KEY is not provisioned in $ENV_FILE" >&2
    exit 1
}

# Non-secret launch configuration. The wrapper pins the invariant values
# itself; the conf file may only override the operational ones. Secret-ish
# overrides (token, keys, allowlist, workspace, ACP command, voice model)
# are deliberately NOT in the conf allowlist: they stay pinned or private.
export VIBE_HOME="$VIBE_HOME_DIR"
export VIBE_BRIDGE_WORKSPACE="$WORKSPACE"
export VIBE_BRIDGE_LANG="${SHOUKICHI_LANG:-en}"
export ACP_AGENT_COMMAND="${SHOUKICHI_ACP_AGENT_COMMAND:-vibe-acp}"
export VIBE_BRIDGE_FORBIDDEN_MODES="${SHOUKICHI_FORBIDDEN_MODES:-auto-approve}"
export VIBE_BRIDGE_VOICE="${SHOUKICHI_VOICE:-Kiki}"
export VIBE_BRIDGE_VOICE_MODEL="${SHOUKICHI_VOICE_MODEL:-KittenML/kitten-tts-nano-0.8-int8}"
export VIBE_BRIDGE_VOICE_SPEED="${SHOUKICHI_VOICE_SPEED:-1.2}"
export VIBE_BRIDGE_WHISPER_MODEL="${SHOUKICHI_WHISPER_MODEL:-small}"
if [ -r "$CONF_FILE" ]; then
    while IFS='=' read -r key value; do
        key="${key%$'\r'}"
        value="${value%$'\r'}"
        case "$key" in
            SHOUKICHI_WHISPER_CLI)
                [ -n "$value" ] && export VIBE_BRIDGE_WHISPER_CLI="$value"
                ;;
            SHOUKICHI_KITTEN_PY)
                [ -n "$value" ] && export VIBE_BRIDGE_KITTEN_PY="$value"
                ;;
        esac
    done < "$CONF_FILE"
fi

# The token must never appear in argv or the process title: the bridge reads it
# from the environment; the workspace path is the only argument it receives.
cd -- "$BRIDGE_REPO"
exec "$VENV_PY" -m vibe_bridge.main
# Shoukichi Instance Wrapper:1 ends here
