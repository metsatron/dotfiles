#!/usr/bin/env bash
set -euo pipefail
TAG="nanobot-watchdog-cron-apply"
TARGET="/etc/cron.d/dotcortex-nanobot-watchdog"
DRY=0
REMOVE=0
HOST=""
while [ "$#" -gt 0 ]; do
    case "$1" in
        --host) [ "$#" -ge 2 ] || { echo "$TAG: --host requires a value" >&2; exit 2; }; HOST="$2"; shift ;;
        --dry-run) DRY=1 ;;
        --remove) REMOVE=1 ;;
        -h|--help|help) echo "Usage: $TAG --host EXACT_HOST [--dry-run] [--remove]"; exit 0 ;;
        *) echo "$TAG: unknown argument: $1" >&2; exit 2 ;;
    esac
    shift
done
run_priv() { if [ "$(id -u)" = 0 ]; then "$@"; else sudo -n "$@"; fi; }
[ -n "$HOST" ] || { echo "$TAG: --host EXACT_HOST is required" >&2; exit 2; }
[ "$(hostname)" = "$HOST" ] || { echo "$TAG: wrong host" >&2; exit 1; }
if [ "$REMOVE" = 1 ]; then
    if [ "$DRY" = 1 ]; then echo "remove $TARGET"; else
        run_priv rm -f "$TARGET"
        echo "$TAG: removed $TARGET"
    fi
    exit 0
fi
watchdog="$HOME/.local/bin/nanobot-watchdog"
state="$HOME/.local/state/nanobot-watchdog"
if [ "$DRY" != 1 ]; then
    [ -x "$watchdog" ] || { echo "$TAG: tangle and stow watchdog first" >&2; exit 1; }
    "$watchdog" --check-alert-route >/dev/null || { echo "$TAG: local alert route unavailable" >&2; exit 1; }
fi
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
schedule='* * * * *'
cat >"$tmp" <<EOF
# DotCortex Nano watchdog; managed by $TAG.
${schedule} $(id -un) HOME=$HOME PATH=$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin $watchdog --expected-host $HOST >>$state/cron.log 2>&1
EOF
if [ "$DRY" = 1 ]; then cat "$tmp"; else
    mkdir -p -m 700 "$state"
    run_priv install -o root -g root -m 0644 "$tmp" "$TARGET"
    echo "$TAG: installed $TARGET"
fi
