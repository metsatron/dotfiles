#!/usr/bin/env bash
# [[file:../../../hooks.org::*File edit rollback guard][File edit rollback guard:2]]
# ~/DotCortex/all/.local/bin/claude-hook-post-tool-use-file-edit
# PostToolUse hook for Write. If Claude creates a new file in DotCortex, stage
# that exact path immediately so the new source is not left as loose drift.

input=$(cat 2>/dev/null || true)

python3 - "$input" <<'PYEOF'
import json
import os
import subprocess
import sys
from pathlib import Path


def run(cmd, cwd):
    return subprocess.run(cmd, cwd=cwd, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)


def repo_root_for(path):
    probe = path if path.is_dir() else path.parent
    result = run(["git", "rev-parse", "--show-toplevel"], str(probe))
    if result.returncode != 0:
        return None
    repo = Path(result.stdout.strip()).resolve()
    if not (repo / "agents.org").is_file() or repo.name != "DotCortex":
        return None
    return repo


def relpath(repo, path):
    try:
        return str(path.resolve(strict=False).relative_to(repo))
    except ValueError:
        return None


def is_untracked_existing(repo, rel):
    result = run(["git", "ls-files", "--others", "--exclude-standard", "--", rel], str(repo))
    return result.returncode == 0 and any(line == rel for line in result.stdout.splitlines())


try:
    payload = json.loads(sys.argv[1]) if len(sys.argv) > 1 and sys.argv[1].strip() else {}
except json.JSONDecodeError:
    sys.exit(0)

tool_input = payload.get("tool_input", {}) if isinstance(payload, dict) else {}
raw = tool_input.get("file_path") or tool_input.get("path")
if not isinstance(raw, str) or not raw:
    sys.exit(0)

cwd = Path(os.getcwd()).resolve()
path = Path(raw)
if not path.is_absolute():
    path = cwd / path
path = path.resolve(strict=False)
repo = repo_root_for(path)
if repo is None:
    sys.exit(0)
rel = relpath(repo, path)
if not rel or rel == ".git" or rel.startswith(".git/") or not path.exists():
    sys.exit(0)

if is_untracked_existing(repo, rel):
    result = run(["git", "add", "--", rel], str(repo))
    if result.returncode != 0:
        print("BLOCKED: could not stage new DotCortex file after Write.")
        print()
        print(f"Path: {path}")
        print(result.stderr.strip())
        sys.exit(2)
    print("DotCortex new file staged after Write:")
    print(f"  - {rel}")

sys.exit(0)
PYEOF
case "$?" in
  0) exit 0 ;;
  2) exit 2 ;;
  *) exit 0 ;;
esac
# File edit rollback guard:2 ends here
