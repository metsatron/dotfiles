     "binary": "codex-astra", "harness": "codex",
     "telegram": False, "tmux": False,
     "memory": None, "rag": None, "mcp": None, "tts": False, "stt": False},
    {"id": "gemma",       "type": "consort",
     "binary": "gemma-pi", "harness": "ollama", "model": "gemma",
     "telegram": False, "tmux": False,
     "memory": None, "rag": None, "mcp": None, "tts": False, "stt": False},
    {"id": "gemini",      "type": "consort",
     "binary": "gemini-pi", "harness": "gemini", "model": "gemini",
     "telegram": False, "tmux": False,
     "memory": None, "rag": None, "mcp": None, "tts": False, "stt": False},
    {"id": "ductor",      "type": "consort",
     "binary": "ductor",  "harness": None,
     "telegram": False, "tmux": False,
     "memory": None, "rag": None, "mcp": None, "tts": False, "stt": False},
    {"id": "sapphire",    "type": "consort",
     "binary": "sapphire", "harness": None,
     "telegram": False, "tmux": False,
     "memory": None, "rag": None, "mcp": None, "tts": False, "stt": False},
    {"id": "pi-agent",    "type": "consort",
     "binary": "pi-agent", "harness": None,
     "telegram": False, "tmux": False,
     "memory": None, "rag": None, "mcp": None, "tts": False, "stt": False},
    {"id": "telegram-agent-host", "type": "infrastructure",
     "binary": "telegram-agent-host", "role": "telegram_gateway"},
    {"id": "opencode-telegram",   "type": "infrastructure",
     "binary": None, "process_pattern": "opencode-telegram",
     "role": "telegram_opencode_bridge"},
    {"id": "tmux",                "type": "infrastructure",
     "binary": "tmux", "role": "transport"},
]

party = []
for entry in PARTY_STATIC:
    e = dict(entry)
    b = e.get("binary")
    e["binary_present"] = (shutil.which(b) is not None) if b else None
    party.append(e)


# ── raw processes + /proc enrichment ─────────────────────────────────────────
raw_procs = []
seen = set()
for row in parse_tsv(read_lines("processes"), ["pattern", "pid", "command"]):
    key = (row["pattern"], row["pid"], row["command"])
    if key in seen:
        continue
    seen.add(key)
    raw_procs.append({**row, **proc_metrics(row["pid"])})


# ── tmux ──────────────────────────────────────────────────────────────────────
tmux_sessions = parse_tsv(read_lines("tmux-sessions"),
    ["id", "name", "windows", "attached", "created"])
tmux_panes = parse_tsv(read_lines("tmux-panes"),
    ["session", "window_index", "window_name", "pane_index",
     "pane_id", "active", "current_path", "current_command", "pid"])
pane_by_pid  = {p["pid"]: p for p in tmux_panes if p.get("pid")}
pane_pid_set = set(pane_by_pid.keys())


# ── pid_session_links (evidence table) ───────────────────────────────────────
pid_session_links = []
for proc in raw_procs:
    pid   = proc["pid"]
    agent = proc["pattern"]
    sid, sid_src = session_id_from_cmdline(proc["command"], agent)
    fd_session_path = None
    fd_session_kind = None
    if sid is None:
        sid, sid_src, fd_session_path, fd_session_kind = session_id_probe(pid, agent)

    pane             = None
    tmux_link_source = None
    tmux_pane_pid    = None
    ppid_chain_list  = None

    # 1. Direct PID match (agent pid IS the tmux pane_pid)
    if pid in pane_by_pid:
        pane             = pane_by_pid[pid]
        tmux_link_source = "direct_pid"
        tmux_pane_pid    = pid
    # 2. SID match: agent inherits session from pane shell (shell pid == SID)
    elif proc.get("sid") and str(proc["sid"]) in pane_by_pid:
        pane             = pane_by_pid[str(proc["sid"])]
        tmux_link_source = "sid_match"
        tmux_pane_pid    = str(proc["sid"])
    # 3. PPID ancestry walk: find a pane_pid among ancestors
    else:
        ancestor, chain  = ppid_chain_walk(pid, pane_pid_set)
        ppid_chain_list  = chain if chain else None
        if ancestor:
            pane             = pane_by_pid[ancestor]
            tmux_link_source = "ppid_chain"
            tmux_pane_pid    = ancestor

    confidence = ("high"   if (sid and pane) else
                  "medium" if sid else
                  "low"    if pane else "none")
    pid_session_links.append({
        "pid":               pid,
        "agent":             agent,
        "cmdline":           proc["command"][:200],
        "session_id":        sid,
        "session_id_source": sid_src,
        "cwd":               proc.get("cwd"),
        "ppid":              proc.get("ppid"),
        "fd_session_path":   fd_session_path,
        "fd_session_kind":   fd_session_kind,
        "tmux_pane_id":      pane.get("pane_id")         if pane else None,
        "tmux_session_name": pane.get("session")         if pane else None,
        "tmux_window_index": pane.get("window_index")    if pane else None,
        "tmux_window_name":  pane.get("window_name")     if pane else None,
        "tmux_link_source":  tmux_link_source,
        "tmux_pane_pid":     tmux_pane_pid,
        "ppid_chain":        ppid_chain_list,
        "confidence":        confidence,
    })
links_by_pid = {ln["pid"]: ln for ln in pid_session_links}


# ── opencode model/provider lookup (read-only DB probe) ───────────────────────
_oc_db = home / ".local/share/opencode/opencode.db"
_model_by_sid = {}
if _oc_db.exists():
    _oc_sids = [
        ln["session_id"] for ln in pid_session_links
        if ln.get("fd_session_kind") == "opencode" and ln.get("session_id")
    ]
    if _oc_sids:
        try:
            _conn = sqlite3.connect(f"file:{_oc_db}?mode=ro", uri=True)
            for _sid in _oc_sids:
                _row = _conn.execute(
                    "SELECT json_extract(data,'$.model.providerID'),"
                    "       json_extract(data,'$.model.modelID') "
                    "FROM message "
                    "WHERE session_id=? "
                    "  AND json_extract(data,'$.model.providerID') IS NOT NULL "
                    "ORDER BY time_created DESC LIMIT 1",
                    (_sid,)
                ).fetchone()
                if _row and _row[0]:
                    _model_by_sid[_sid] = {"provider": _row[0], "model": _row[1] or "—"}
            _conn.close()
        except Exception as _exc:
            warnings.append(f"opencode model probe: {_exc}")

for ln in pid_session_links:
    _sid = ln.get("session_id")
    if _sid and _sid in _model_by_sid:
        _mi = _model_by_sid[_sid]
        ln["provider"]         = _mi["provider"]
        ln["provider_source"]  = "opencode_db"
        ln["model"]            = _mi["model"]
        ln["model_source"]     = "opencode_db"
        ln["model_confidence"] = "high"
    else:
        ln["provider"]         = None
        ln["provider_source"]  = "unknown"
        ln["model"]            = None
        ln["model_source"]     = "unknown"
        ln["model_confidence"] = "none"


# ── active_agents ─────────────────────────────────────────────────────────────
active_agents = []
for proc in raw_procs:
    pid = proc["pid"]
    lnk = links_by_pid.get(pid, {})
    active_agents.append({
        "pattern":           proc["pattern"],
        "pid":               pid,
        "ppid":              proc.get("ppid"),
        "pgid":              proc.get("pgid"),
        "sid":               proc.get("sid"),
        "proc_status":       proc.get("proc_status"),
        "command":           proc["command"],
        "cwd":               proc.get("cwd"),
        "cpu_ticks":         proc.get("cpu_ticks"),
        "rss_kb":            proc.get("rss_kb"),
        "io_read_bytes":     proc.get("io_read_bytes"),
        "io_write_bytes":    proc.get("io_write_bytes"),
        "session_id":        lnk.get("session_id"),
        "session_id_source": lnk.get("session_id_source"),
        "fd_session_path":   lnk.get("fd_session_path"),
        "fd_session_kind":   lnk.get("fd_session_kind"),
        "tmux_pane_id":      lnk.get("tmux_pane_id"),
        "tmux_session_name": lnk.get("tmux_session_name"),
        "tmux_window_name":  lnk.get("tmux_window_name"),
        "tmux_pane_pid":     lnk.get("tmux_pane_pid"),
        "tmux_link_source":  lnk.get("tmux_link_source"),
        "link_confidence":   lnk.get("confidence"),
        "provider":          lnk.get("provider"),
        "provider_source":   lnk.get("provider_source"),
        "model":             lnk.get("model"),
        "model_source":      lnk.get("model_source"),
        "model_confidence":  lnk.get("model_confidence"),
    })


# ── native_stores ─────────────────────────────────────────────────────────────
native_stores = {}

claude_root = home / ".claude/projects"
if claude_root.exists():
    files  = [f for f in claude_root.rglob("*.jsonl") if "/subagents/" not in f.as_posix()]
    newest = max((f.stat().st_mtime for f in files), default=None)
    native_stores["claude"] = {
        "path": str(claude_root), "type": "jsonl_dir", "present": True,
        "session_count": len(files),
        "newest_mtime":  iso_from_mtime(newest) if newest else None,
    }
else:
    native_stores["claude"] = {
        "path": str(claude_root), "type": "jsonl_dir", "present": False,
        "session_count": 0, "newest_mtime": None,
    }

opencode_db = home / ".local/share/opencode/opencode.db"
if opencode_db.exists():
    try:
        conn = sqlite3.connect(f"file:{opencode_db}?mode=ro", uri=True)
        cnt  = conn.execute("select count(*) from session where time_archived is null").fetchone()[0]
        conn.close()
        native_stores["opencode"] = {
            "path": str(opencode_db), "type": "sqlite", "present": True,
            "session_count": cnt,
            "newest_mtime":  iso_from_mtime(opencode_db.stat().st_mtime),
        }
    except Exception as exc:
        warnings.append(f"opencode: sqlite probe failed: {exc}")
        native_stores["opencode"] = {
            "path": str(opencode_db), "type": "sqlite", "present": True,
            "session_count": None, "newest_mtime": None,
        }
else:
    native_stores["opencode"] = {
        "path": str(opencode_db), "type": "sqlite", "present": False,
        "session_count": 0, "newest_mtime": None,
    }

# Codex: primary path is sessions/; logs_2.sqlite may be a newer store format
codex_sessions = home / ".codex/sessions"
codex_sqlite   = home / ".codex/logs_2.sqlite"
codex_entry    = {
    "path": str(codex_sessions), "type": "jsonl_dir",
    "present": codex_sessions.exists(),
    "session_count": 0, "newest_mtime": None,
}
if codex_sessions.exists():
    files  = list(codex_sessions.rglob("*.jsonl"))
    newest = max((f.stat().st_mtime for f in files), default=None)
    codex_entry["session_count"] = len(files)
    codex_entry["newest_mtime"]  = iso_from_mtime(newest) if newest else None
if codex_sqlite.exists():
    codex_entry["fallback_path"] = str(codex_sqlite)
    codex_entry["fallback_type"] = "sqlite"
    if not codex_sessions.exists():
        warnings.append(
            f"codex: {codex_sessions} not found; {codex_sqlite} present"
            " — store format may have changed")
native_stores["codex"] = codex_entry

# Hermes: canonical store is state.db; legacy fallback is sessions/*.json
hermes_db       = home / ".hermes/state.db"
hermes_sessions = home / ".hermes/sessions"
hermes_entry    = {
    "path": str(hermes_db), "type": "sqlite",
    "present": False, "session_count": 0, "newest_mtime": None,
}
if hermes_db.exists():
    try:
        conn = sqlite3.connect(f"file:{hermes_db}?mode=ro", uri=True)
        cnt  = conn.execute("select count(*) from sessions where ended_at is null").fetchone()[0]
        conn.close()
        hermes_entry.update({
            "present": True, "session_count": cnt,
            "newest_mtime": iso_from_mtime(hermes_db.stat().st_mtime),
        })
    except Exception as exc:
        hermes_entry["present"] = True
        warnings.append(f"hermes: state.db probe failed: {exc}")
elif hermes_sessions.exists():
    files = list(hermes_sessions.glob("session_*.json"))
    hermes_entry.update({
        "path": str(hermes_sessions), "type": "json_dir",
        "present": True, "session_count": len(files),
    })
    warnings.append("hermes: state.db not found; legacy sessions/ dir present")
else:
    warnings.append(
        "hermes: no native store found"
        " (checked ~/.hermes/state.db and ~/.hermes/sessions/)")
native_stores["hermes"] = hermes_entry

# Antigravity: protobuf conversations + plaintext brain entries
ag_root = home / ".gemini/antigravity"
if ag_root.exists():
    conv_dir  = ag_root / "conversations"
    brain_dir = ag_root / "brain"
    pb_cnt    = len(list(conv_dir.glob("*.pb"))) if conv_dir.exists() else 0
    brain_cnt = (sum(1 for p in brain_dir.iterdir() if p.is_dir())
                 if brain_dir.exists() else 0)
    native_stores["antigravity"] = {
        "path": str(ag_root), "type": "mixed_dir", "present": True,
        "session_count":  max(pb_cnt, brain_cnt),
        "pb_conversations": pb_cnt, "brain_entries": brain_cnt,
        "newest_mtime": None,
    }
else:
    native_stores["antigravity"] = {
        "path": str(ag_root), "type": "mixed_dir", "present": False,
        "session_count": 0, "newest_mtime": None,
    }


# ── sessions index summary ────────────────────────────────────────────────────
index_path_str   = read_text("session-index-path").strip()
sessions_summary = {
    "index_path":         index_path_str,
    "index_exists":       False,
    "index_generated_at": None,
    "counts": {"open": 0, "closed": 0, "unknown": 0, "abandoned": 0, "total": 0},
}
if index_path_str:
    index_path = pathlib.Path(index_path_str)
    if index_path.exists():
        try:
            payload = json.loads(index_path.read_text(encoding="utf-8"))
            entries = payload.get("sessions", [])
            counts  = {"open": 0, "closed": 0, "unknown": 0, "abandoned": 0,
                       "total": len(entries)}
            for s in entries:
                st = s.get("status") or "unknown"
                if st in counts:
                    counts[st] += 1
            newest_ts = max(
                (s.get("indexedat") or "" for s in entries), default=None,
            ) or None
            sessions_summary.update({
                "index_exists":       True,
                "index_generated_at": newest_ts,
                "counts":             counts,
            })
        except Exception as exc:
            warnings.append(f"sessions: index read failed: {exc}")
    else:
        warnings.append(f"sessions: index not found at {index_path_str}")


# ── telegram ──────────────────────────────────────────────────────────────────
try:
    tg_available = read_text("telegram.available").strip() == "1"
except Exception:
    tg_available = False
try:
    tg_exit = int(read_text("telegram.exit").strip() or "0")
except Exception:
    tg_exit = None

telegram = {
    "host_available": tg_available,
    "host_exit_code":  tg_exit,
    "host_stdout":     read_lines("telegram.out"),
    "host_stderr":     read_lines("telegram.err"),
}


# ── final assembly ────────────────────────────────────────────────────────────
state = {
    "schema":            "agent-sessiond.v2",
    "host":              read_text("hostname").strip(),
    "generated_at":      read_text("timestamp").strip(),
    "party":             party,
    "active_agents":     active_agents,
    "sessions":          sessions_summary,
    "native_stores":     native_stores,
    "pid_session_links": pid_session_links,
    "telegram":          telegram,
    "tmux":              {"sessions": tmux_sessions, "panes": tmux_panes},
    "capabilities":      capabilities,
    "warnings":          warnings,
}

json.dump(state, sys.stdout, indent=2, sort_keys=True)
sys.stdout.write("\n")
PY

  mv "$tmp" "$outfile"
  cp "$outfile" "$latest_tmp"
  mv "$latest_tmp" "$latest"
  printf 'agent-sessiond: wrote %s and %s\n' "$outfile" "$latest"
}

print_status() {
  need_python
  local file
  file="$(state_file)"
  if [ ! -s "$file" ]; then
    echo "agent-sessiond: no state file found at $file" >&2
    exit 1
  fi

  python3 - "$file" <<'PY'
import json
import sys

path = sys.argv[1]
with open(path, encoding="utf-8") as fh:
    state = json.load(fh)

tmux_sess  = state.get("tmux", {}).get("sessions", [])
tmux_panes = state.get("tmux", {}).get("panes", [])
active     = state.get("active_agents", [])
stores     = state.get("native_stores", {})
idx        = state.get("sessions", {})
warns      = state.get("warnings", [])

print(f"agent-sessiond state: {path}")
print(f"schema : {state.get('schema', '?')}")
print(f"host   : {state.get('host', '?')}")
print(f"time   : {state.get('generated_at', '?')}")
print(f"tmux   : {len(tmux_sess)} sessions  {len(tmux_panes)} panes")
if tmux_sess:
    names = ", ".join(s.get("name", "") for s in tmux_sess if s.get("name"))
    print(f"         {names}")

if active:
    print(f"live   : {len(active)} process(es)")
    for a in active:
        sid   = a.get("session_id") or "?"
        pane  = a.get("tmux_pane_id") or "no-pane"
        rss   = a.get("rss_kb")
        rss_s = f"  rss={rss}KB" if rss else ""
        conf  = a.get("link_confidence") or "?"
        src   = a.get("tmux_link_source") or ""
        src_s = f"/{src}" if src and a.get("tmux_pane_id") else ""
        print(f"         {a['pattern']}  pid={a['pid']}  sid={sid}"
              f"  pane={pane}{src_s}{rss_s}  [{conf}]")
else:
    print("live   : none")

counts = idx.get("counts", {})
if any(counts.get(k, 0) for k in ("open", "closed", "unknown", "abandoned")):
    print(f"index  : {counts.get('open',0)} open  {counts.get('closed',0)} closed"
          f"  {counts.get('unknown',0)} unknown  {counts.get('abandoned',0)} abandoned")
    if not idx.get("index_exists"):
        print("         (index not found — run FORGE/bin/agent-session scan)")

present = sorted(k for k, v in stores.items() if isinstance(v, dict) and v.get("present"))
absent  = sorted(k for k, v in stores.items() if isinstance(v, dict) and not v.get("present"))
if present:
    print(f"stores : present={','.join(present)}")
if absent:
    print(f"         absent={','.join(absent)}")

for w in warns:
    print(f"WARN   : {w}")
PY
}

cmd="${1:-status}"
case "$cmd" in
  once)
    collect_once
    ;;
  watch)
    while :; do
      collect_once
      sleep "$INTERVAL"
    done
    ;;
  status)
    print_status
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
# agent-sessiond:1 ends here
