#!/usr/bin/env python3
"""Build the Help Corpus (FTS5) from already-rendered Zeal docsets.

Consumes docSet.dsidx + Documents/*.html from every *.docset under
--docsets-dir (the exact artefacts dotcortex-docset-gen already produced),
never the original man sources -- Zeal and Clippy inhabit the same library.

Usage:
  dotcortex-help-corpus-build --docsets-dir DIR --out help-corpus.sqlite
"""
import argparse, hashlib, sqlite3, sys
from html.parser import HTMLParser
from pathlib import Path


class SectionChunker(HTMLParser):
    """Splits mandoc's <section class="Sh|Ss"><h1|h2 id=...>...</section>
    tree into one chunk per leaf section. Text seen while a child section
    is open never reaches the parent's buffer (stack scoping), so a
    section with subsections yields one chunk per subsection plus one
    chunk for the parent's own lead-in text."""

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.stack = []          # list of dict(anchor, heading, buf=[])
        self.chunks = []         # finished chunks
        self.heading_depth = None  # tag name ('h1'/'h2') currently capturing heading text

    def handle_starttag(self, tag, attrs):
        d = dict(attrs)
        cls = d.get("class", "")
        if tag == "section" and cls in ("Sh", "Ss"):
            self.stack.append({"anchor": d.get("id", ""), "heading": "", "buf": []})
        elif tag in ("h1", "h2") and cls in ("Sh", "Ss") and self.stack:
            self.heading_depth = tag

    def handle_endtag(self, tag):
        if tag in ("h1", "h2") and self.heading_depth == tag:
            self.heading_depth = None
        elif tag == "section" and self.stack:
            top = self.stack.pop()
            body = "".join(top["buf"]).strip()
            if body:
                self.chunks.append((top["anchor"], top["heading"].strip(), body))

    def handle_data(self, data):
        if not self.stack:
            return
        if self.heading_depth:
            self.stack[-1]["heading"] += data
        else:
            self.stack[-1]["buf"].append(data)


def chunk_html(html: str):
    p = SectionChunker()
    p.feed(html)
    if p.chunks:
        return p.chunks
    # Fallback: no Sh/Ss sections found (unusual/degenerate page) -- one
    # whole-page chunk so nothing silently vanishes from the corpus.
    text = HTMLTextDump()
    text.feed(html)
    body = text.get_text().strip()
    return [("", "", body)] if body else []


class HTMLTextDump(HTMLParser):
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self._parts = []

    def handle_data(self, data):
        self._parts.append(data)

    def get_text(self):
        return "".join(self._parts)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--docsets-dir", required=True)
    ap.add_argument("--out", required=True)
    args = ap.parse_args()

    docsets_dir = Path(args.docsets_dir)
    out = Path(args.out)
    out.parent.mkdir(parents=True, exist_ok=True)

    con = sqlite3.connect(out)
    # Derived/rebuildable index: trade durability for build speed. A crash
    # mid-build just means the next `loom docs:build` rebuilds it.
    con.executescript("PRAGMA synchronous=OFF; PRAGMA journal_mode=MEMORY;")
    con.executescript("""
    CREATE TABLE IF NOT EXISTS documents(
      id INTEGER PRIMARY KEY,
      docset TEXT NOT NULL,
      name TEXT NOT NULL,
      type TEXT NOT NULL,
      path TEXT NOT NULL,
      source_hash TEXT NOT NULL,
      UNIQUE(docset, path)
    );
    CREATE TABLE IF NOT EXISTS chunks(
      id INTEGER PRIMARY KEY,
      document_id INTEGER NOT NULL REFERENCES documents(id) ON DELETE CASCADE,
      anchor TEXT NOT NULL,
      heading TEXT NOT NULL,
      body TEXT NOT NULL
    );
    CREATE VIRTUAL TABLE IF NOT EXISTS chunks_fts USING fts5(
      title, heading, body, chunk_id UNINDEXED, tokenize='porter unicode61'
    );
    """)

    seen_docsets = set()
    live_keys = set()
    docs_seen = chunks_seen = rendered = skipped = 0

    for docset_dir in sorted(docsets_dir.glob("*.docset")):
        dsidx = docset_dir / "Contents/Resources/docSet.dsidx"
        docs_root = docset_dir / "Contents/Resources/Documents"
        if not dsidx.is_file():
            continue
        docset_name = docset_dir.stem
        seen_docsets.add(docset_name)
        idx = sqlite3.connect(f"file:{dsidx}?mode=ro", uri=True)
        for name, typ, path in idx.execute("SELECT name, type, path FROM searchIndex"):
            live_keys.add((docset_name, path))
            html_path = docs_root / path
            if not html_path.is_file():
                continue
            raw = html_path.read_bytes()
            digest = hashlib.sha1(raw).hexdigest()
            row = con.execute(
                "SELECT id, source_hash FROM documents WHERE docset=? AND path=?",
                (docset_name, path)).fetchone()
            docs_seen += 1
            if row and row[1] == digest:
                skipped += 1
                continue
            html = raw.decode("utf-8", errors="replace")
            chunks = chunk_html(html)
            if row:
                doc_id = row[0]
                con.execute("DELETE FROM chunks WHERE document_id=?", (doc_id,))
                con.execute("DELETE FROM chunks_fts WHERE chunk_id IN "
                            "(SELECT id FROM chunks WHERE document_id=?)", (doc_id,))
                con.execute("UPDATE documents SET name=?, type=?, source_hash=? WHERE id=?",
                            (name, typ, digest, doc_id))
            else:
                cur = con.execute(
                    "INSERT INTO documents(docset,name,type,path,source_hash) VALUES (?,?,?,?,?)",
                    (docset_name, name, typ, path, digest))
                doc_id = cur.lastrowid
            for anchor, heading, body in chunks:
                cur = con.execute(
                    "INSERT INTO chunks(document_id,anchor,heading,body) VALUES (?,?,?,?)",
                    (doc_id, anchor, heading, body))
                con.execute(
                    "INSERT INTO chunks_fts(title,heading,body,chunk_id) VALUES (?,?,?,?)",
                    (name, heading, body, cur.lastrowid))
                chunks_seen += 1
            rendered += 1

    # Prune documents (and their chunks/fts rows, via ON DELETE CASCADE +
    # explicit fts cleanup) for docsets that vanished or pages no longer
    # present in their dsidx.
    stale = []
    for doc_id, docset, path in con.execute("SELECT id, docset, path FROM documents"):
        if docset not in seen_docsets or (docset, path) not in live_keys:
            stale.append(doc_id)
    for doc_id in stale:
        con.execute("DELETE FROM chunks_fts WHERE chunk_id IN "
                    "(SELECT id FROM chunks WHERE document_id=?)", (doc_id,))
        con.execute("DELETE FROM chunks WHERE document_id=?", (doc_id,))
        con.execute("DELETE FROM documents WHERE id=?", (doc_id,))

    con.commit()
    con.close()
    print(f"help-corpus: {docs_seen} pages scanned ({rendered} (re)chunked, "
          f"{skipped} cached, {len(stale)} pruned), {chunks_seen} chunks written -> {out}")


if __name__ == "__main__":
    main()
