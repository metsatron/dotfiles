#!/usr/bin/env bash
# [[file:../../../homebrew.org::*GitHub binary releases][GitHub binary releases:2]]
# ~/DotCortex/all/.local/bin/github-release-apply
set -euo pipefail

MAN="$HOME/DotCortex/all/.homebrew/manifest/github-releases.ssv"

_emit_norm() {
  awk -v FS='[[:space:]]+' '
    function dequote(s){ return (s=="\"\"" ? "" : s) }
    $0 ~ /^[[:space:]]*#/ || NF==0 { next }
    { printf "%s|%s|%s|%s|%s\n",
        dequote($1), dequote($2), dequote($3), dequote($4), dequote($5) }
  ' "$MAN"
}

echo "== github-release apply =="

while IFS='|' read -r name repo asset_pat install_dir_raw version_pin
do
  [ -n "$name" ] || continue
  install_dir="${install_dir_raw:-$HOME/.local/bin}"

  echo ">> $name from $repo${version_pin:+ (pinned $version_pin)}"

  if [ -n "$version_pin" ]; then
    api_url="https://api.github.com/repos/${repo}/releases/tags/${version_pin}"
  else
    api_url="https://api.github.com/repos/${repo}/releases/latest"
  fi
  asset_url="$(curl -s "$api_url" | python3 -c "
import json, sys, fnmatch
r = json.load(sys.stdin)
for a in r.get('assets', []):
    if fnmatch.fnmatch(a['name'], '$asset_pat'):
        print(a['browser_download_url'])
        break
")"

  if [ -z "$asset_url" ]; then
    echo "!! No asset matching '$asset_pat' for $repo" >&2
    continue
  fi

  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' EXIT

  echo ">> Downloading $asset_url"
  curl -sL "$asset_url" -o "$tmpdir/asset.zip"

  unzip -q "$tmpdir/asset.zip" -d "$tmpdir/out"

  binary="$(find "$tmpdir/out" -maxdepth 2 -type f -name "$name" | head -1)"
  if [ -z "$binary" ]; then
    echo "!! Binary '$name' not found in zip" >&2
    ls "$tmpdir/out" >&2
    continue
  fi

  mkdir -p "$install_dir"
  cp "$binary" "$install_dir/$name"
  chmod +x "$install_dir/$name"
  echo ">> Installed $name -> $install_dir/$name"

done < <(_emit_norm)

echo "Done."
# GitHub binary releases:2 ends here
