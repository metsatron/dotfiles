#!/usr/bin/env bash
# OpenCode secret hygiene (2026-09-25)
# Every interactive zsh/bash exports all of =~/.env= (see =shell.org=), so an agent launched from a terminal inherits every API key in its process environment, and one =env= in its bash tool would send them all to its model provider. Two layers close that:

# - =opencode-clean= starts OpenCode with an allowlisted environment: no keys at all. OpenCode's own provider logins live in its auth file, and the MCP servers above load their own keys (e.g. =opencode-mcp-brave-search= reads =~/.env= itself), so nothing needs the inherited keys. Non-interactive shells the agent spawns do not re-read =~/.env= (=.bashrc= returns early; =.zshrc= is interactive-only).
# - The =permission= block in the global config above denies the read tool on =~/.env*=, harness auth files, =~/.ssh=, Borg passphrases and KeePass files, and makes bash commands that name them (or dump the environment) ask first. The read-tool rule alone would not cover =cat ~/.env= through bash; the environment rule alone would not cover the files.

# The durable root fix, loading each key only into the tool that needs it instead of exporting =~/.env= into every shell, is a separate decision (Mètsàtron's).


# [[file:../../../agents-hooks.org::*OpenCode secret hygiene (2026-09-25)][OpenCode secret hygiene (2026-09-25):1]]
# ~/DotCortex/all/.local/bin/opencode-clean
# Launch OpenCode with an allowlisted environment: no API keys inherited.
set -euo pipefail

keep=(HOME USER LOGNAME SHELL PATH TERM COLORTERM LANG LC_ALL LC_CTYPE TZ
      DISPLAY WAYLAND_DISPLAY XAUTHORITY XDG_RUNTIME_DIR XDG_CONFIG_HOME
      XDG_DATA_HOME XDG_STATE_HOME XDG_CACHE_HOME DBUS_SESSION_BUS_ADDRESS
      TMUX TMUX_PANE)
# SSH_AUTH_SOCK is deliberately NOT kept: an agent on a remote-hosted model
# should not drive the ssh agent (fleet hosts, git pushes).
args=()
for name in "${keep[@]}"; do
  if [ -n "${!name:-}" ]; then
    args+=("$name=${!name}")
  fi
done

exec env -i "${args[@]}" opencode "$@"
# OpenCode secret hygiene (2026-09-25):1 ends here
