#!/usr/bin/env bash
# beads-install – install the pinned Beads CLI (`bd`)
# Beads is a git-backed issue store (`gastownhall/beads`, formerly `steveyegge/beads`) that
# carries its own embedded Dolt — no server, no separate binary. This block installs the
# **`bd` binary only**, pinned by version and sha256, into =~/.local/bin/bd= as a *real file*.
# It deliberately does **not** go through stow: the binary is ~147 MiB and DotCortex is a
# public repo, so shipping it through =all/.local/bin= would be both wrong and enormous. The
# installer itself is the declared artefact; =~/.local/bin/beads-install= is the reproducible
# command.

# Idempotence is keyed on the **version string**, not on file existence — a file-existence
# guard silently freezes a stale binary at whatever version was first installed.

# =bd init= writes agent harness files and makes a commit if allowed, so initialise a repo with
# =bd init --non-interactive --skip-agents --init-if-missing= and confirm the repo's HEAD did not
# move. The database lives in-repo at =.beads/embeddeddolt/=. **NFS behaviour is NOT
# ESTABLISHED** upstream (the docs are silent and the Go source has no NFS awareness); it has
# been exercised only uncontended on the HelmCortex mount, so treat concurrent writers on the
# shared NFS tree as unsupported until tested.


# [[file:../../../tools.org::*beads-install – install the pinned Beads CLI (`bd`)][beads-install – install the pinned Beads CLI (`bd`):1]]
set -Eeuo pipefail

VERSION="1.3.2"
SHA256="c6ea3281f6ff82628351b2d0967c9eb85862c8a0ec0ebc24e63e645c8b02462e"
URL="https://github.com/gastownhall/beads/releases/download/v${VERSION}/beads_${VERSION}_linux_amd64.tar.gz"
DEST="${HOME}/.local/bin/bd"
CACHE="${XDG_DATA_HOME:-${HOME}/.local/share}/beads"

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  echo "Usage: beads-install [--force]   (installs bd ${VERSION} to ~/.local/bin/bd)"
  exit 0
fi

arch="$(uname -m)"
if [[ "${arch}" != "x86_64" ]]; then
  echo "beads-install: unsupported architecture '${arch}' — the pinned asset is linux_amd64" >&2
  exit 1
fi

if [[ "${1:-}" != "--force" ]] && [[ -x "${DEST}" ]] && "${DEST}" version 2>/dev/null | grep -q "${VERSION}"; then
  echo "bd ${VERSION} already installed at ${DEST}"
  exit 0
fi

mkdir -p "${CACHE}" "$(dirname "${DEST}")"
tarball="${CACHE}/beads_${VERSION}_linux_amd64.tar.gz"

if [[ ! -s "${tarball}" ]]; then
  echo "downloading ${URL}"
  curl -fsSL --proto '=https' --tlsv1.2 -o "${tarball}.part" "${URL}"
  mv -f "${tarball}.part" "${tarball}"
fi

if ! printf '%s  %s\n' "${SHA256}" "${tarball}" | sha256sum -c - >/dev/null 2>&1; then
  echo "beads-install: checksum mismatch for ${tarball} — refusing to install" >&2
  echo "  expected ${SHA256}" >&2
  exit 1
fi

tmp="$(mktemp -d "${CACHE}/.extract.XXXXXXXX")"
trap 'rm -rf "${tmp}"' EXIT
tar -xzf "${tarball}" -C "${tmp}"
src="$(find "${tmp}" -maxdepth 2 -type f -name bd -print -quit)"
if [[ -z "${src}" ]]; then
  echo "beads-install: no 'bd' binary inside ${tarball}" >&2
  exit 1
fi

install -m 0755 "${src}" "${DEST}.new"
mv -f "${DEST}.new" "${DEST}"
echo "installed ${DEST}"
"${DEST}" version
# beads-install – install the pinned Beads CLI (`bd`):1 ends here
