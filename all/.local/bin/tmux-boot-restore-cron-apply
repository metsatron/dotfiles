#!/usr/bin/env bash
set -euo pipefail

TAG="tmux-boot-restore-cron-apply"
TARGET="/etc/cron.d/dotcortex-tmux-boot-restore"
EXPECTED_HOST=""
DRY=0
REMOVE=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --host) [ "$#" -ge 2 ] || { echo "$TAG: --host requires a value" >&2; exit 2; }; EXPECTED_HOST="$2"; shift ;;
    --dry-run) DRY=1 ;;
    --remove) REMOVE=1 ;;
    -h|--help|help) echo "Usage: $TAG --host EXACT_HOST [--dry-run] [--remove]"; exit 0 ;;
    *) echo "$TAG: unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done

run_priv() { if [ "$(id -u)" = 0 ]; then "$@"; else sudo -n "$@"; fi; }

if [ "$REMOVE" = 1 ]; then
  if [ "$DRY" = 1 ]; then echo "remove $TARGET"; else run_priv rm -f "$TARGET"; echo "$TAG: removed $TARGET"; fi
  exit 0
fi

[ -n "$EXPECTED_HOST" ] || { echo "$TAG: --host EXACT_HOST is required" >&2; exit 2; }
[ "$(hostname)" = "$EXPECTED_HOST" ] || { echo "$TAG: refusing installation on $(hostname); expected $EXPECTED_HOST" >&2; exit 1; }

USER_NAME="$(id -un)"
USER_ID="$(id -u)"
TARGET_HOME="$HOME"
HOOK="$TARGET_HOME/.local/bin/tmux-boot-restore"
[ "$DRY" = 1 ] || [ -x "$HOOK" ] || { echo "$TAG: missing $HOOK; tangle and stow first" >&2; exit 1; }

TMP="$(mktemp)"
trap 'rm -f "$TMP"' EXIT
cat >"$TMP" <<EOF
# DotCortex tmux boot restore; managed by $TAG.
# Sysvinit/OpenRC has no continuum-boot service, so nothing starts a tmux server
# at boot; this @reboot hook restores the seats and Nurse Joy revives the four
# Claude agents from their durable session records after readiness gates pass.
@reboot ${USER_NAME} HOME=${TARGET_HOME} PATH=${TARGET_HOME}/.bun/bin:${TARGET_HOME}/.guix-extra-profiles/core/core/bin:${TARGET_HOME}/HelmCortex/FORGE/bin:${TARGET_HOME}/.local/bin:${TARGET_HOME}/.npm-global/bin:/usr/local/bin:/usr/bin:/bin XDG_RUNTIME_DIR=/run/user/${USER_ID} CLAUDE_IDLE_REAL_EXECUTABLE=${TARGET_HOME}/.npm-global/bin/claude ${HOOK}
EOF

if [ "$DRY" = 1 ]; then
  cat "$TMP"
else
  run_priv install -o root -g root -m 0644 "$TMP" "$TARGET"
  echo "$TAG: installed $TARGET"
fi
