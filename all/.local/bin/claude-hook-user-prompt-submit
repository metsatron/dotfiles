#!/usr/bin/env bash
# Skill forced eval
# Smart-gated skill evaluation: surface the YES/NO skill block only when the user's prompt
# keyword-matches a skill, so unrelated prompts cost zero skill-overhead tokens. Falls back
# to the full skill list only if the prompt text can't be parsed (non-Claude-Code callers).
# Only fires when =.claude/skills/= exists in the working directory (project-scoped -- no-op
# outside DotCortex).


# [[file:../../../hooks.org::*Skill forced eval][Skill forced eval:1]]
# ~/DotCortex/all/.local/bin/claude-hook-user-prompt-submit
# Inject DotCortex reminders before every task.
# Fires for Claude Code (UserPromptSubmit) and OpenCode.
# No-op outside the DotCortex repo.
# Skill surfacing is SMART-GATED: the skill-evaluation block is emitted only when
# the user's prompt keyword-matches one or more skills, so unrelated prompts cost
# zero skill-overhead tokens. If the prompt text can't be parsed from the hook
# payload (e.g. a non-Claude-Code caller), it falls back to the full skill list.
# Also surfaces pending OpenCode config merge reminders from stow-time drift detection.
set -euo pipefail

# OpenCode's TUI plugin can invoke this command with stdin inherited but not
# closed, so a plain `cat` can block prompt submission forever. Keep Claude's
# payload support, but bound the read for callers that provide no stdin data.
if command -v timeout >/dev/null 2>&1; then
    HOOK_INPUT="$(timeout 0.2 cat 2>/dev/null || true)"
else
    HOOK_INPUT=""
    if IFS= read -r -t 0.2 first_line; then
        HOOK_INPUT="$first_line"
        rest="$(cat 2>/dev/null || true)"
        [ -n "$rest" ] && HOOK_INPUT="${HOOK_INPUT}"$'\n'"${rest}"
    fi
fi
export DOTCORTEX_HOOK_INPUT="$HOOK_INPUT"

python3 - <<'PYEOF'
import os, re, sys, json

blocks = []
state_home = os.environ.get('XDG_STATE_HOME', os.path.join(os.path.expanduser('~'), '.local', 'state'))
marker_path = os.path.join(state_home, 'dotcortex', 'opencode-config-merge.json')
cwd = os.path.realpath(os.getcwd())
repo = os.path.realpath(os.environ.get('DOTCORTEX_REPO', os.path.join(os.path.expanduser('~'), 'DotCortex')))

if cwd != repo and not cwd.startswith(repo + os.sep):
    sys.exit(0)

# OpenCode config-merge reminder (unconditional when the drift marker is present).
if os.path.isfile(marker_path):
    try:
        with open(marker_path) as f:
            marker = json.load(f)
    except Exception:
        marker = None

    mrepo = os.path.realpath(marker.get('repo', '')) if marker else ''
    if marker and mrepo and (cwd == mrepo or cwd.startswith(mrepo + os.sep)):
        extra_paths = marker.get('extra_paths', [])
        bullets = ['- `{}`'.format(path) for path in extra_paths[:10]]
        if len(extra_paths) > 10:
            bullets.append('- ... and {} more'.format(len(extra_paths) - 10))
        if not bullets:
            bullets = ['- (paths unavailable)']
        blocks.append(
            '## OPENCODE CONFIG MERGE PENDING\n\n'
            'DotCortex backed up a live OpenCode config because it had settings '
            'not represented in `hooks.org`. Merge them back into source before '
            'deleting the backup.\n\n'
            '- Live config: `{}`\n'
            '- Backup: `{}`\n'
            '- Unmerged paths:\n{}'.format(
                marker.get('live', '(unknown live config)'),
                marker.get('backup', '(unknown backup path)'),
                '\n'.join(bullets),
            )
        )

# Skill surfacing, smart-gated by prompt keywords.
skills_dir = os.path.join(os.getcwd(), '.claude', 'skills')
if os.path.isdir(skills_dir):
    skills = []
    for slug in sorted(os.listdir(skills_dir)):
        skill_path = os.path.join(skills_dir, slug, 'SKILL.md')
        description = ''
        if os.path.isfile(skill_path):
            with open(skill_path) as f:
                for line in f:
                    if line.startswith('description:'):
                        description = line.split(':', 1)[1].strip()
                        break
        skills.append((slug, description))

    # Pull the user's prompt out of the hook payload, if this caller provides it.
    prompt_text = None
    raw = os.environ.get('DOTCORTEX_HOOK_INPUT', '')
    if raw.strip():
        try:
            payload = json.loads(raw)
            if isinstance(payload, dict) and 'prompt' in payload:
                prompt_text = payload.get('prompt') or ''
        except Exception:
            prompt_text = None

    STOP = set('''
        the and for with this that from into your you use used using run runs via
        new now all any one can does did will would should set get let got like
        just only also more most some what when where which who how why want need
        please help fix make made manage managing management manager configure
        configuration config configs system systems source sources repo repos
        repository file files folder directory agent agents claude code opencode
        native live local global update updates updated refresh inspect operate
        operating tool tools version versions add added remove create created edit
        editing work working task tasks thing things stuff per across given here
        '''.split())

    def toks(text):
        return set(t for t in re.findall(r'[a-z0-9]+', (text or '').lower()) if len(t) >= 3)

    def keywords(slug, desc):
        kw = set(p for p in slug.lower().split('-') if len(p) >= 3)
        kw |= set(t for t in toks(desc) if len(t) >= 4 and t not in STOP)
        return kw

    if prompt_text is not None:
        # Smart-gate: only skills whose keywords appear in the prompt; none -> nothing.
        ptoks = toks(prompt_text)
        selected = [(s, d) for (s, d) in skills if keywords(s, d) & ptoks]
        gated = True
    else:
        # Prompt unavailable (non-Claude-Code caller): fall back to the full list.
        selected = skills
        gated = False

    if selected:
        skills_text = '\n'.join('- {}: {}'.format(s, d) for (s, d) in selected)
        intro = ('These skills may be relevant to your request'
                 if gated else 'Available skills')
        blocks.append(
            '## Skills available\n\n'
            + intro + ' - load any that clearly apply, otherwise just proceed. '
            'Do NOT narrate a per-skill YES/NO evaluation; just invoke what fits.'
            '\n\n' + skills_text
        )

if not blocks:
    sys.exit(0)

output = {
    'hookSpecificOutput': {
        'hookEventName': 'UserPromptSubmit',
        'additionalContext': '\n\n'.join(blocks)
    }
}
print(json.dumps(output))
PYEOF
# Skill forced eval:1 ends here
