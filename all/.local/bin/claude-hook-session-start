#!/usr/bin/env bash
# Session start

# [[file:../../../agents-hooks.org::*Session start][Session start:1]]
# ~/DotCortex/all/.local/bin/claude-hook-session-start

extract_lightcone() {
  local content="$1"
  local extracted bytes open
  extracted=$(printf '%s' "$content" | awk '/^## LightCone/{p=1} p && /^## / && !/^## LightCone/{exit} p')
  if [ -n "$extracted" ]; then
    # LightCone law (todo skill): ### Active <=5 open items, section <=6000
    # bytes, no [x] inside, everything else in ## Backlog. Announce breaches
    # loudly at every session start until someone triages — and cap the flood
    # regardless (a 55KB "LightCone" once rode into every session's context).
    bytes=$(printf '%s' "$extracted" | wc -c)
    open=$(printf '%s\n' "$extracted" | grep -c '^- \[ \]')
    if [ "$open" -gt 5 ] || [ "$bytes" -gt 6000 ]; then
      printf '!!! LIGHTCONE OVER CAP: %s open items, %s bytes (law: <=5 items, <=6000 bytes). Triage per the todo skill BEFORE other TODO edits: keep true focus in ### Active, move the rest to ## Backlog, move [x] items to Progress.\n' "$open" "$bytes"
    fi
    if [ "$bytes" -gt 6000 ]; then
      printf '%s' "$extracted" | head -c 6000
      printf '\n(… LightCone truncated at 6000 bytes — full section in the TODO file)\n'
    else
      printf '%s\n' "$extracted"
    fi
  else
    # No "## LightCone" section: cap the fallback. An uncapped dump of a large
    # TODO file once put 84KB into session context (ThinkPad-T480, 2026-07-31).
    printf '%s\n' "$content" | head -n 40
    if [ "$(printf '%s\n' "$content" | wc -l)" -gt 40 ]; then
      printf '(… truncated — this TODO has no "## LightCone" section; add one to control what loads here)\n'
    fi
  fi
}

# --- Machine Identity (always first — survives compaction) ---
HOST=$(hostname)
# Hostnames and vault TODO filenames diverge (probed live 2026-07-31): the X230
# reports "ThinkPad-X230", and Termux on the S24 reports "localhost". So each
# branch carries MACHINE_FILE explicitly — the LightCone lookup must never
# depend on hostname and filename agreeing.
case "$HOST" in
  ThinkPad-T480s)     SHORT="t480s"; STOW_VERB="loom stow:t480s";                              OTHER_HOSTS="x230  t480  s24"; MACHINE_FILE="ThinkPad-T480s.md" ;;
  ThinkPad-X230|x230) SHORT="x230";  STOW_VERB="loom stow:x230";                               OTHER_HOSTS="t480s  t480  s24"; MACHINE_FILE="ThinkPad-X230.md" ;;
  ThinkPad-T480)      SHORT="t480";  STOW_VERB="STOW_PKGS='all linux debian t480' make safe-stow"; OTHER_HOSTS="x230  t480s  s24"; MACHINE_FILE="ThinkPad-T480.md" ;;
  s24)                SHORT="s24";   STOW_VERB="loom stow:s24";                                OTHER_HOSTS="x230  t480s  t480"; MACHINE_FILE="Galaxy-S24-Ultra.md" ;;
  localhost)
    # Termux never sets a real hostname; identify the S24 by the Android userland.
    if [ -n "${TERMUX_VERSION:-}" ] || [ "$(uname -o 2>/dev/null)" = "Android" ]; then
      SHORT="s24"; STOW_VERB="loom stow:s24"; OTHER_HOSTS="x230  t480s  t480"; MACHINE_FILE="Galaxy-S24-Ultra.md"
    else
      SHORT="$HOST"; STOW_VERB="(unknown — check CLAUDE.md fleet table)"; OTHER_HOSTS="(unknown)"; MACHINE_FILE="$HOST.md"
    fi ;;
  *)                  SHORT="$HOST"; STOW_VERB="(unknown — check CLAUDE.md fleet table)";      OTHER_HOSTS="(unknown)"; MACHINE_FILE="$HOST.md" ;;
esac

echo "--- Machine Identity ---"
echo "YOU ARE ON: $HOST ($SHORT)  <<< THIS IS YOUR CURRENT MACHINE — DO NOT SSH INTO IT"
echo "Fleet SSH targets (other machines): $OTHER_HOSTS"
echo "Stow verb for this machine: $STOW_VERB"
echo

# --- Conflict marker scan (overlay dirs stowed into $HOME) ---
DOTCORTEX_ROOT="${PWD}"
if [ -d "$DOTCORTEX_ROOT/all" ]; then
  CONFLICT_HITS=$(grep -rlE '^<<<<<<< |^>>>>>>> ' \
    "$DOTCORTEX_ROOT"/all/ "$DOTCORTEX_ROOT"/linux/ "$DOTCORTEX_ROOT"/debian/ \
    "$DOTCORTEX_ROOT"/devuan/ "$DOTCORTEX_ROOT"/x230/ "$DOTCORTEX_ROOT"/t480s/ \
    "$DOTCORTEX_ROOT"/t1700/ "$DOTCORTEX_ROOT"/t480/ 2>/dev/null \
    | grep -vE '\.(themes|icewm/themes)/|\.xpm$|gtkrc|\.local/straight/repos/' \
    | head -10)
  if [ -n "$CONFLICT_HITS" ]; then
    echo "!!! STOWED OVERLAY FILES CONTAIN UNRESOLVED MERGE CONFLICT MARKERS !!!"
    echo "These files are symlinked into \$HOME — every affected script is BROKEN:"
    printf '%s\n' "$CONFLICT_HITS" | sed "s|$DOTCORTEX_ROOT/||"
    echo "Resolve conflicts in the .org source, retangle, and restow BEFORE other work."
    echo
  fi
fi

# --- Root Memory (machine/OS — every value probed live, never hardcoded) ---
tool_ver() {
  command -v "$1" >/dev/null 2>&1 \
    && "$1" --version 2>/dev/null | head -1 | grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' | head -1 \
    || echo absent
}

CPU=$(grep -m1 'model name' /proc/cpuinfo | cut -d: -f2- | sed 's/^ *//')
DISTRO="unknown"
[ -r /etc/os-release ] && . /etc/os-release && DISTRO="$ID ${VERSION_ID:-} (${VERSION_CODENAME:-})"
INIT=$(ps -p 1 -o comm= 2>/dev/null)
LOGIN_SHELL=$(getent passwd "${USER:-$(id -un)}" | cut -d: -f7)
TAILNET=$(timeout 2 tailscale status --peers=false 2>/dev/null | awk 'NR==1{print $1" ("$2")"}')
SSH_ALIASES=$(grep -E '^Host ' "$HOME/.ssh/config" 2>/dev/null | sed 's/^Host //' | tr ' ' '\n' | grep -v '[*?]' | grep . | sort -u | tr '\n' ' ')

echo "--- Root Memory (probed live) ---"
echo "cpu: $CPU"
echo "os: $DISTRO  kernel=$(uname -r)  init=$INIT"
[ "$INIT" != "systemd" ] && echo "  ^ NOT systemd — no systemctl/timedatectl/localectl/journalctl on this machine"
echo "login shell: $LOGIN_SHELL  <<< interactive shell is $(basename "${LOGIN_SHELL:-unknown}") — do NOT assume bash"
echo "tailnet: ${TAILNET:-offline or absent}"
echo "ssh aliases: ${SSH_ALIASES:-none}"
echo "toolchain: node=$(tool_ver node) npm=$(tool_ver npm) bun=$(tool_ver bun) python3=$(tool_ver python3) pip=$(tool_ver pip) cargo=$(tool_ver cargo) guix=$(command -v guix >/dev/null 2>&1 && echo present || echo absent)"
echo

# --- Userspace Memory (user prefs — probed live, follows the machine when travelling) ---
TZFILE=$(readlink -f /etc/localtime 2>/dev/null)
TZNAME=${TZFILE#*/zoneinfo/}
[ -z "$TZNAME" ] || [ "$TZNAME" = "$TZFILE" ] && TZNAME=$(cat /etc/timezone 2>/dev/null)
KB=$( { setxkbmap -query 2>/dev/null || grep -hE '^XKB' /etc/default/keyboard 2>/dev/null; } \
  | tr -d '"' | awk -F'[:=]' '
      /layout|LAYOUT/{l=$2} /variant|VARIANT/{v=$2} /model|MODEL/{m=$2}
      END{gsub(/ /,"",l); gsub(/ /,"",v); gsub(/ /,"",m); if(l) print l (v?"("v")":"") "  model=" m}')

echo "--- Userspace Memory (probed live) ---"
echo "user: ${USER:-$(id -un)}  home=$HOME"
echo "locale: ${LANG:-unset}"
echo "keyboard: ${KB:-unknown}"
echo "timezone: ${TZNAME:-unknown}  now=$(date '+%Y-%m-%d %H:%M %Z (%A)')"
echo

# --- LightCone ---
VAULT="${HELMCORTEX_VAULT:-$HOME/HelmCortex}"
WORKSPACE=$(basename "$PWD")
echo "--- $WORKSPACE LightCone ---"
todo_content=$(cat "$VAULT/LOGS/TODO/$WORKSPACE.md" 2>/dev/null)
if [ -n "$todo_content" ]; then
  extract_lightcone "$todo_content"
else
  echo "(no $WORKSPACE TODO found)"
fi

echo
echo "--- Machine LightCone ($HOST → $MACHINE_FILE) ---"
machine_content=$(cat "$VAULT/LOGS/TODO/Machines/$MACHINE_FILE" 2>/dev/null)
if [ -n "$machine_content" ]; then
  extract_lightcone "$machine_content"
else
  echo "(no machine TODO found)"
fi
# Session start:1 ends here
