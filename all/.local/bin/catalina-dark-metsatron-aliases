#!/usr/bin/env python3
from __future__ import annotations

import shutil
from pathlib import Path


REPO_ROOT = Path.home() / "DotCortex"
THEME_ROOT = REPO_ROOT / "linux/.local/share/icons/Catalina-Dark-Metsatron"

# These are launcher IDs found in installed .desktop files.  The right-hand
# side is the closest installed donor when the application did not ship the
# left-hand name into an indexed theme directory.
ALIASES = {
    "antigravity-ide": "antigravity",
    "astronvim": "nvim",
    "brave-dphmddbaacdodhfgamobmdfkkclnlkml-Default": "brave-browser",
    "calibre-ebook-edit": "calibre",
    "calibre-ebook-viewer": "calibre",
    "calibre-lrfviewer": "calibre",
    "calibre-viewer": "calibre",
    "codex-desktop": "claude-devtools",
    "appimagekit_b110714bdc0350a056f50e75eb56627a_cool-retro-term": "utilities-terminal",
    "lutris_the-ultimate-doom": "emacs",
    "bezilla": "firefox",
    "goneovim": "nvim",
    "Fish-icon": "multimedia-video-player",
    "neovide": "nvim",
    "BeOS_Menu": "rofi",
    "network-remote": "network-server",
    "wez-left-stack": "org.wezfurlong.wezterm",
    "BeOS_terminal": "org.wezfurlong.wezterm",
    "com.tiagopires.ObsidianRedstone": "md.obsidian.Obsidian",
    "io.github.sithlord48.blackchocobo": "applications-games",
    "net.pcsx2.PCSX2": "pcsx2",
    "org.duckstation.DuckStation": "applications-games",
    "org.jdownloader.JDownloader": "jdownloader",
    "org.deskflow.deskflow": "input-keyboard",
    "picom": "preferences-system-windows",
}

SEARCH_DIRS = (
    THEME_ROOT / "apps/scalable",
    THEME_ROOT / "apps/128",
    Path("/usr/share/icons/Catalina-Dark/apps/128"),
    Path("/usr/share/icons/Catalina-Dark/devices/128"),
    Path("/usr/share/icons/Catalina-Dark/apps/scalable"),
    Path("/usr/share/icons/hicolor/128x128/apps"),
    Path("/usr/share/icons/hicolor/scalable/apps"),
    Path.home() / ".guix-extra-profiles/core/core/share/icons/hicolor/128x128/apps",
    Path.home() / ".guix-extra-profiles/core/core/share/icons/hicolor/scalable/apps",
    Path.home() / ".local/share/flatpak/exports/share/icons/hicolor/128x128/apps",
    Path.home() / ".local/share/flatpak/exports/share/icons/hicolor/scalable/apps",
    Path("/var/lib/flatpak/exports/share/icons/hicolor/128x128/apps"),
    Path("/var/lib/flatpak/exports/share/icons/hicolor/scalable/apps"),
)


def find_donor(name: str) -> Path | None:
    for directory in SEARCH_DIRS:
        for suffix in (".svg", ".png", ".xpm"):
            candidate = directory / f"{name}{suffix}"
            if candidate.is_file():
                return candidate
    return None


def main() -> int:
    written = 0
    missing = 0
    for alias, donor_name in ALIASES.items():
        donor = find_donor(donor_name)
        if donor is None:
            print(f"missing donor: {alias} <- {donor_name}")
            missing += 1
            continue
        target_dir = THEME_ROOT / ("apps/scalable" if donor.suffix == ".svg" else "apps/128")
        target_dir.mkdir(parents=True, exist_ok=True)
        target = target_dir / f"{alias}{donor.suffix}"
        shutil.copy2(donor, target)
        print(f"{target.relative_to(REPO_ROOT)} <- {donor}")
        written += 1
    print(f"catalina-dark-metsatron-aliases: written={written} missing={missing}")
    return 1 if missing else 0


if __name__ == "__main__":
    raise SystemExit(main())
