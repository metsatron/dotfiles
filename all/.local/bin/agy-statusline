#!/usr/bin/env bash
input=$(cat)

# User and host
user=$(whoami)
host=$(hostname -s)

# Directory — basename only, try agy-specific paths then fallback
cwd=$(echo "$input" | jq -r '.workspace_path // .workspace.current_dir // .cwd // empty')
if [ -z "$cwd" ] || [ "$cwd" = "null" ]; then
  cwd=$(pwd)
fi
short_cwd=$(basename "$cwd")

# Git branch — try agy-specific field, then probe git directly
git_branch=$(echo "$input" | jq -r '.git_branch // .worktree.branch // .workspace.git_worktree // empty')
if [ -z "$git_branch" ] || [ "$git_branch" = "null" ]; then
  if command -v git >/dev/null 2>&1; then
    git_branch=$(git -C "$cwd" symbolic-ref --short HEAD 2>/dev/null || git -C "$cwd" rev-parse --short HEAD 2>/dev/null)
  fi
fi

# Time
time_str=$(date +%H:%M)

# Model — strip "Gemini " / "Claude " prefix for brevity
model=$(echo "$input" | jq -r '.model // .model.display_name // empty' | sed 's/^Gemini //;s/^Claude //')

# Context used %
used=$(echo "$input" | jq -r '.context_usage_percentage // .context_window.used_percentage // empty')

# Token count as XK
tokens=$(echo "$input" | jq -r '
  if .context_tokens_used != null then .context_tokens_used
  elif .context_window.total_input_tokens != null then
    (.context_window.total_input_tokens // 0) + (.context_window.total_output_tokens // 0)
  else 0
  end')
if [ -n "$tokens" ] && [ "$tokens" != "null" ] && [ "$tokens" -gt 0 ] 2>/dev/null; then
  tk=$(echo "$tokens" | awk '{if($1>=1000) printf "%.1fK",$1/1000; else printf "%d",$1}')
else
  tk=""
fi

# Session quota remaining % — try agy-specific field then rate_limits path
quota_pct=$(echo "$input" | jq -r '
  if .quota_usage_percentage != null then (100 - .quota_usage_percentage)
  elif .rate_limits.five_hour.remaining_percentage != null then .rate_limits.five_hour.remaining_percentage
  elif .rate_limits.five_hour.used_percentage != null then (100 - .rate_limits.five_hour.used_percentage)
  else empty
  end')

# Weekly quota — remaining % and days to reset
seven_day_used=$(echo "$input" | jq -r '.rate_limits.seven_day.used_percentage // empty')
seven_day_resets=$(echo "$input" | jq -r '.rate_limits.seven_day.resets_at // empty')
week_pct=""
week_days=""
if [ -n "$seven_day_used" ] && [ "$seven_day_used" != "null" ]; then
  week_pct=$(echo "$seven_day_used" | awk '{printf "%.0f", 100-$1}')
fi
if [ -n "$seven_day_resets" ] && [ "$seven_day_resets" != "null" ] && [ "$seven_day_resets" -gt 0 ] 2>/dev/null; then
  now=$(date +%s)
  secs=$((seven_day_resets - now))
  [ $secs -lt 0 ] && secs=0
  week_days=$(awk "BEGIN{printf \"%.1f\", $secs/86400}")
fi

printf "\033[38;5;72m %s\033[0m" "$user@$host"
printf " \033[33m %s\033[0m" "$short_cwd"
if [ -n "$git_branch" ]; then
  printf " \033[34m %s\033[0m" "$git_branch"
fi
printf "\033[38;5;59m  %s\033[0m" "$time_str"
if [ -n "$model" ]; then
  printf " \033[32m✦ %s\033[0m" "$model"
fi
if [ -n "$tk" ] && [ -n "$used" ]; then
  printf " \033[38;5;59m%s (%s%%)\033[0m" "$tk" "$(printf '%.0f' "$used")"
elif [ -n "$used" ]; then
  printf " \033[38;5;59m(%s%%)\033[0m" "$(printf '%.0f' "$used")"
fi
if [ -n "$quota_pct" ]; then
  printf " \033[38;5;59m5h %s%%\033[0m" "$(printf '%.0f' "$quota_pct")"
fi
if [ -n "$week_pct" ] || [ -n "$week_days" ]; then
  out="wk"
  [ -n "$week_pct" ] && out="${out} ${week_pct}%"
  [ -n "$week_days" ] && out="${out} ${week_days}d"
  printf " \033[38;5;59m%s\033[0m" "$out"
fi
