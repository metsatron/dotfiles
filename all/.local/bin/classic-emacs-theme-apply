#!/usr/bin/env bash
# Redstone theme bridge

# The Redstone Desktop Scheme already updates IceWM, GTK, Qt, FOX, Wine,
# Audacious, sound, and desktop layers. This small bridge gives vanilla Emacs
# the same contract without making Emacs depend on Redstone internals: it writes
# one guest-local theme override and asks the named Emacs server to reload it when
# one is running. An explicit =EMACS_THEME= key in a future scheme wins over the
# family mapping.


# [[file:../../../emacs-classic.org::*Redstone theme bridge][Redstone theme bridge:1]]
# classic-emacs-theme-apply <scheme-id> [theme] [display-key]
# Write the mutable classic Emacs theme override and refresh Emacs if live.
set -euo pipefail

scheme_id="${1:-classic}"
theme="${2:-}"
display_key="${3:-}"

if [[ -z "${theme}" ]]; then
  case "${scheme_id}" in
    windows-3x|windows-95|windows-98|windows-2000|windows-xp|plus-*|reactionary*|hp-vue*)
      theme="leuven" ;;
    cde-*|cdep-*|kde-*|cde-default|cde-green|cde-mustard|cde-sandy|cde-crimson)
      theme="tsdh-light" ;;
    serenity-basalt|serenity-contrast|serenity-cupertino|serenity-dark|\
    serenity-durrque|serenity-gruvbox-dark|serenity-nord|serenity-valve|\
    serenity-catppuccin-frappe|serenity-catppuccin-macchiato|serenity-catppuccin-mocha)
      theme="modus-vivendi" ;;
    serenity-*|beos-*|haiku|icedano)
      theme="modus-operandi" ;;
    *)
      theme="tango" ;;
  esac
fi

if [[ ! "${theme}" =~ ^[[:alnum:]_-]+$ ]]; then
  echo "classic-emacs-theme-apply: invalid theme name: ${theme}" >&2
  exit 2
fi

if [[ -z "${display_key}" ]]; then
  display_key="${DISPLAY:-}"
  display_key="${display_key%%.*}"
  display_key="${display_key##*:}"
fi
display_key="${display_key//[^[:alnum:]]/}"
[[ -n "${display_key}" ]] || display_key="classic"

runtime_dir="${HOME}/.config/emacs-classic"
theme_file="${runtime_dir}/classic-theme.el"
mkdir -p "${runtime_dir}"
tmp="${theme_file}.tmp.$$"
trap 'rm -f "${tmp}"' EXIT
{
  printf '%s\n' ";;; Generated by classic-emacs-theme-apply. Do not edit while a scheme switch is running."
  printf '(setq metsatron/classic-emacs-theme '\''%s)\n' "${theme}"
} > "${tmp}"
mv -f "${tmp}" "${theme_file}"
trap - EXIT

server_file="${HOME}/.cache/emacs-classic/server/classic-${display_key}"
if command -v emacsclient >/dev/null 2>&1; then
  emacsclient -f "${server_file}" \
    --eval '(metsatron/classic-emacs-refresh-theme)' >/dev/null 2>&1 || true
fi

printf 'classic-emacs-theme-apply: %s -> %s\n' "${scheme_id}" "${theme}"
# Redstone theme bridge:1 ends here
