#!/usr/bin/env bash
# [[file:../../../agents-hooks.org::*Agent IDE notifications][Agent IDE notifications:4]]
# ~/DotCortex/all/.local/bin/codex-hook-idle-event
# Forward only validated lifecycle facts to the codex-warm supervisor.
# The hook never submits terminal input and never passes prompts, summaries,
# transcript paths, or authentication data.  Only the `pty-supervisor' owner
# mode is supported — Codex has no Emacs IDE governor.
set -u

[ -n "${CODEX_IDLE_CHANNEL:-}" ] || exit 0
owner="${CODEX_IDLE_OWNER:-}"
case "$owner" in
  pty-supervisor) ;;
  *) exit 0 ;;
esac

[[ "$CODEX_IDLE_CHANNEL" =~ ^codex-[0-9a-f]{32}$ ]] || exit 0

payload=$(cat 2>/dev/null || true)
command -v jq >/dev/null 2>&1 || exit 0
[ -n "$payload" ] || exit 0
jq -e . >/dev/null 2>&1 <<<"$payload" || exit 0

event=$(jq -r '.hook_event_name // empty' <<<"$payload" 2>/dev/null || true)
session_id=$(jq -r '.session_id // empty' <<<"$payload" 2>/dev/null || true)
stop_hook_active=$(jq -r 'if has("stop_hook_active") then .stop_hook_active else empty end' \
  <<<"$payload" 2>/dev/null || true)
case "$event" in
  Stop)
    [ "$stop_hook_active" = "false" ] || exit 0
    event_symbol=stop ;;
  SessionStart) event_symbol=session-start ;;
  UserPromptSubmit) event_symbol=user-prompt-submit ;;
  PostCompact) event_symbol=post-compact ;;
  PreCompact|PreToolUse|PostToolUse) event_symbol=session-activity ;;
  StopFailure) event_symbol=stop-failure ;;
  SessionEnd) event_symbol=session-end ;;
  *) exit 0 ;;
esac

case "$session_id" in
  "") exit 0 ;;
  *[!A-Za-z0-9._:-]*) exit 0 ;;
esac

[ -n "${CODEX_IDLE_CONTROL_SOCKET:-}" ] || exit 0
command -v python3 >/dev/null 2>&1 || exit 0
if command -v timeout >/dev/null 2>&1; then
  timeout 3s python3 - "$CODEX_IDLE_CONTROL_SOCKET" "$event_symbol" \
    "$CODEX_IDLE_CHANNEL" "$session_id" "$stop_hook_active" <<'PY' \
    >/dev/null 2>&1 || true
import json
import socket
import sys

path, event, channel, session_id, stop_hook_active = sys.argv[1:]
message = {
    "kind": "event",
    "event": event,
    "channel": channel,
    "session_id": session_id,
}
if event == "stop":
    message["stop_hook_active"] = False
with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
    connection.settimeout(2.0)
    connection.connect(path)
    connection.sendall((json.dumps(message, separators=(",", ":")) + "\n").encode())
    connection.recv(4096)
PY
fi
exit 0
# Agent IDE notifications:4 ends here
