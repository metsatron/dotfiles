#!/usr/bin/env bash
# honey-review-desk-install (generated by agents-bots-honey.org): the install lane for ONE unit, /etc/init.d/honey-review-desk.
# Human-run, root. It compares the tangled unit in this lane with the one in /etc/init.d and, only on `install`, places that one file (timestamped
# backup of the file it replaces). It places nothing else, never touches the application (~/.local/share/honey-centre), never starts, stops, restarts or
# enables a service, and never edits a running process: a changed stop() takes effect at the next stop.
# Usage: honey-review-desk-install [--dry-run] [check|install]      (default: check)
#   check    reports `unchanged`, `missing` or `drift` (with the diff, at most 40 lines). Exit 0 only when unchanged; 1 for missing or drift.
#   install  as root, after `sh -n` accepts the source; --dry-run says what it would do and changes nothing.
# HONEY_REVIEW_DESK_INITD_DIR points the target at a staging directory (tests, rehearsals); with it set root is not required, and without it
# nothing can be written unless the caller is root.
set -euo pipefail
umask 022
LANE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
SRC="$LANE/openrc/honey-review-desk"
INITD="${HONEY_REVIEW_DESK_INITD_DIR:-/etc/init.d}"
DST="$INITD/honey-review-desk"
DRY=0; VERB=check
for arg in "$@"; do
    case "$arg" in
        --dry-run) DRY=1 ;;
        install|check) VERB="$arg" ;;
        -h|--help) sed -n '2,13p' "${BASH_SOURCE[0]}"; exit 0 ;;
        *) printf 'honey-review-desk-install: unknown argument: %s\n' "$arg" >&2; exit 2 ;;
    esac
done
[ -r "$SRC" ] || { echo "missing $SRC" >&2; exit 1; }
if [ ! -e "$DST" ]; then state=missing
elif cmp -s "$SRC" "$DST"; then state=unchanged
else state=drift; fi
if [ "$VERB" = check ]; then
    echo "$state $DST"
    [ "$state" = drift ] && { diff -u "$DST" "$SRC" | head -40 || true; }
    [ "$state" = unchanged ]; exit $?
fi
if [ "$state" = unchanged ]; then echo "unchanged $DST"; echo 'No service was started, restarted, or enabled.'; exit 0; fi
sh -n "$SRC" || { echo "refusing: $SRC does not parse" >&2; exit 1; }
if [ "$DRY" -eq 1 ]; then echo "would: backup and install $DST ($state)"; echo 'No service was started, restarted, or enabled.'; exit 0; fi
if [ -z "${HONEY_REVIEW_DESK_INITD_DIR:-}" ] && [ "$(id -u)" -ne 0 ]; then echo 'install requires root' >&2; exit 1; fi
ts="$(date +%Y%m%d-%H%M%S)"
[ -e "$DST" ] && cp -p -- "$DST" "$DST.bak-$ts"
if [ "$(id -u)" -eq 0 ]; then install -D -m 0755 -o root -g root -- "$SRC" "$DST"; else install -D -m 0755 -- "$SRC" "$DST"; fi
echo "installed $DST"
echo 'No service was started, restarted, or enabled.'
