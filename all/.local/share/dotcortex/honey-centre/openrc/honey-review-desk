#!/sbin/openrc-run

name="honey-review-desk"
description="Gillean's Review desk: loopback web service behind Caddy (:9100/review). Resolves sync conflicts via honey-sync-conflicts."

command="/usr/bin/python3"
command_args="-I /home/gille/.local/share/honey-centre/review_desk.py --port 9101"
command_user="gille:gille"
command_background=true
pidfile="/run/honey-review-desk.pid"
output_log="/var/log/honey-review-desk.log"
error_log="/var/log/honey-review-desk.log"

depend() {
    use net
}

start_pre() {
    checkpath -f -m 0644 -o gille:gille /var/log/honey-review-desk.log
}
