# /etc/honey-ups/honey-ups.conf (generated example from honey-ups.org; host values are local)
UPS=cyberpower@localhost
ENVY_AFTER=300          # seconds on battery before the Envy is shut down
REPORT_EVERY=300        # seconds between on-battery Telegram reports
FLOOR_CHARGE=30         # watchdog backstop, below NUT's 40% trigger
FLOOR_RUNTIME=300       # watchdog backstop, below NUT's 600 s trigger
COMMLOST_AFTER=900      # shut down if the UPS is unreadable this long after going on battery
ALERT_USER=gille
ALERT_CMD=/home/gille/bin/honey-alert
ENVY_HOSTS="YOUR_ENVY_LAN_IP YOUR_ENVY_TAILNET_IP"   # tried in order
ENVY_USER=gille
ENVY_KEY=/etc/honey-ups/envy_ed25519
ENVY_KNOWN_HOSTS=/etc/honey-ups/envy_known_hosts
