#!/usr/bin/env bash
#!/usr/bin/env bash
set -euo pipefail
umask 022

LANE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
ENGINE_ROOT="${HONEY_VOICE_ENGINE_ROOT:-}"
DRY=0
VERB=check
for arg in "$@"; do
    case "$arg" in
        --dry-run) DRY=1 ;;
        install|check) VERB="$arg" ;;
        -h|--help) printf '%s\n' 'honey-voice-install [--dry-run] [check|install]' ; exit 0 ;;
        *) printf 'honey-voice-install: unknown argument: %s\n' "$arg" >&2; exit 2 ;;
    esac
done
[ -n "$ENGINE_ROOT" ] || { echo 'set HONEY_VOICE_ENGINE_ROOT to the existing private honey-voice engine' >&2; exit 2; }
SRC_WATCHER="$LANE/bin/provider-rollout-watcher.py"
SRC_OPENRC="$LANE/openrc/honey-voice"
SRC_FOX="$LANE/openrc/honey-voice-fox"
INITD="${HONEY_VOICE_INITD_DIR:-/etc/init.d}"
CONFD="${HONEY_VOICE_CONFD_DIR:-/etc/conf.d}"
for path in "$SRC_WATCHER" "$SRC_OPENRC" "$SRC_FOX"; do [ -r "$path" ] || { echo "missing $path" >&2; exit 1; }; done
targets=(
    "$SRC_WATCHER|$ENGINE_ROOT/bin/provider-rollout-watcher.py"
    "$SRC_OPENRC|$INITD/honey-voice-badger"
    "$SRC_FOX|$INITD/honey-voice-fox"
)
# Both units take every account and path from /etc/conf.d/<service>. Installing a unit whose conf.d file is missing would break that service at its
# next start, so install refuses, before it writes anything, and check says so.
noconf=0
for svc in honey-voice-badger honey-voice-fox; do
    [ -f "$CONFD/$svc" ] || { echo "conf.d missing: $CONFD/$svc (create it from the lane's conf template first)" >&2; noconf=1; }
done
[ "$VERB" = install ] && [ "$noconf" -eq 1 ] && { echo 'refusing: nothing was written' >&2; exit 1; }
for pair in "${targets[@]}"; do
    src="${pair%%|*}"; dst="${pair#*|}"
    if cmp -s "$src" "$dst" 2>/dev/null; then echo "unchanged $dst"; continue; fi
    if [ "$VERB" = check ]; then echo "drift $dst"; continue; fi
    if [ "$DRY" -eq 1 ]; then echo "would: backup/install $dst"; continue; fi
    [ "$(id -u)" -eq 0 ] || [ -n "${HONEY_VOICE_INITD_DIR:-}" ] || { echo 'install requires root' >&2; exit 1; }
    ts="$(date +%Y%m%d-%H%M%S)"
    [ -e "$dst" ] && cp -p -- "$dst" "$dst.bak-$ts"
    if [ "$(id -u)" -eq 0 ]; then install -D -m 0755 -o root -g root -- "$src" "$dst"; else install -D -m 0755 -- "$src" "$dst"; fi
    echo "installed $dst"
done
echo 'No service was started, restarted, or enabled.'
[ "$noconf" -eq 0 ]
