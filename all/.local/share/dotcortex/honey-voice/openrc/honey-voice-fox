#!/sbin/openrc-run
# Honey Flying Fox voice — follows Codex rollout logs for honey-codex's Telegram
# threads and sends finished replies as Piper voice notes (see
# codex_rollout_watcher.py in the voice engine for why a watcher).
# Source of truth: DotCortex, agents-bots-honey.org. Configure in /etc/conf.d/${RC_SVCNAME}
# (see honey-voice-fox.conf.template): the accounts and paths are not written in this file.
# honey-codex runs as its own agent account; this watcher stays the voice engine's account
# and reads that agent home through narrow ACLs (sessions.json via sudo -u <read_as> cat).

: "${honey_voice_user:?set honey_voice_user in /etc/conf.d/${RC_SVCNAME}}"
: "${honey_voice_group:=${honey_voice_user}}"
: "${honey_voice_engine_root:?set honey_voice_engine_root in /etc/conf.d/${RC_SVCNAME}}"
: "${honey_voice_fox_home:?set honey_voice_fox_home in /etc/conf.d/${RC_SVCNAME}}"
: "${honey_voice_fox_read_as:?set honey_voice_fox_read_as in /etc/conf.d/${RC_SVCNAME}}"

user_home="$(getent passwd "${honey_voice_user}" | cut -d: -f6)"
: "${user_home:?cannot resolve honey_voice_user home}"

name="honey-voice-fox"
description="Piper voice notes for Honey Flying Fox (honey-codex)"

command="/usr/bin/python3"
command_args="${honey_voice_engine_root}/bin/codex_rollout_watcher.py"
command_user="${honey_voice_user}:${honey_voice_group}"
command_background=true
pidfile="/run/honey-voice-fox.pid"
output_log="/var/log/honey-voice-fox.log"
error_log="/var/log/honey-voice-fox.log"
directory="${user_home}"

export HOME="${user_home}"
export PATH="${PATH}:${user_home}/.local/bin"
export PYTHONUNBUFFERED=1
export HONEY_FOX_HOME="${honey_voice_fox_home}"
export HONEY_FOX_READ_AS="${honey_voice_fox_read_as}"

depend() {
    use net dns
    after net honey-codex
}

start_pre() {
    checkpath -f -m 0640 -o "${honey_voice_user}:${honey_voice_group}" "${output_log}"
}

stop() {
    # Own stop (honey-initd-lint). OpenRC's default stop passes --exec ${command}; with the pidfile gone that signals every process whose argv[0] is
    # the same string (for command=/usr/bin/python3: every python3 service on the host). This one signals the pid in the pidfile, and only if it is alive.
    local pid
    pid="$(cat "${pidfile}" 2>/dev/null)"
    [ -n "${pid}" ] || return 0
    if [ ! -d "/proc/${pid}" ]; then rm -f "${pidfile}"; return 0; fi
    ebegin "Stopping ${name:-${RC_SVCNAME}}"
    start-stop-daemon --stop --quiet --retry "${retry:-TERM/30/KILL/5}" --pidfile "${pidfile}"
    eend $? "Failed to stop ${name:-${RC_SVCNAME}}"
}
