#!/sbin/openrc-run
# Honey Flying Fox voice — follows Codex rollout logs for honey-codex's Telegram
# threads and sends finished replies as Piper voice notes (see
# ~/.local/share/honey-voice/bin/codex_rollout_watcher.py for why a watcher).
# Source of truth: ~/.local/share/honey-voice/deploy/honey-voice-fox.openrc
# 2026-09-25: honey-codex runs as agent-codex; this watcher stays gille and reads
# /home/agent-codex through narrow ACLs (sessions.json via sudo -u agent-codex cat).

name="honey-voice-fox"
description="Piper voice notes for Honey Flying Fox (honey-codex)"

command="/usr/bin/python3"
command_args="/home/gille/.local/share/honey-voice/bin/codex_rollout_watcher.py"
command_user="gille:gille"
command_background=true
pidfile="/run/honey-voice-fox.pid"
output_log="/var/log/honey-voice-fox.log"
error_log="/var/log/honey-voice-fox.log"
directory="/home/gille"

export HOME="/home/gille"
export PATH="${PATH}:/home/gille/.local/bin"
export PYTHONUNBUFFERED=1
export HONEY_FOX_HOME="/home/agent-codex"
export HONEY_FOX_READ_AS="agent-codex"

depend() {
    use net dns
    after net honey-codex
}

start_pre() {
    checkpath -f -m 0640 -o gille:gille /var/log/honey-voice-fox.log
}

stop() {
    # Own stop (honey-initd-lint). OpenRC's default stop passes --exec ${command}; with the pidfile gone that signals every process whose argv[0] is
    # the same string (for command=/usr/bin/python3: every python3 service on the host). This one signals the pid in the pidfile, and only if it is alive.
    local pid
    pid="$(cat "${pidfile}" 2>/dev/null)"
    [ -n "${pid}" ] || return 0
    if [ ! -d "/proc/${pid}" ]; then rm -f "${pidfile}"; return 0; fi
    ebegin "Stopping ${name:-${RC_SVCNAME}}"
    start-stop-daemon --stop --quiet --retry "${retry:-TERM/30/KILL/5}" --pidfile "${pidfile}"
    eend $? "Failed to stop ${name:-${RC_SVCNAME}}"
}
