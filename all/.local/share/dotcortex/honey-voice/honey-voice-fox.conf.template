# Copy to /etc/conf.d/honey-voice-fox; keep this file machine-local (it names this host's accounts and paths).
# The account the watcher runs as, and its group (defaults to the user's name).
honey_voice_user=
honey_voice_group=
# The private voice engine: the watcher is <engine_root>/bin/codex_rollout_watcher.py
honey_voice_engine_root=
# The home of the agent account whose Codex rollouts are followed, and the account the watcher reads it as (sudo -u).
honey_voice_fox_home=
honey_voice_fox_read_as=
