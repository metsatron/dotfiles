#!/sbin/openrc-run
# GNU Guix build daemon as a native OpenRC service (DotCortex).
#
# For OpenRC hosts (Devuan with OpenRC as the service manager: T480, Honey).
# The upstream installer writes an LSB script there, which OpenRC never starts
# at boot; this is the native form. depend() uses `after`, never `need`:
# Devuan's OpenRC has no `localmount`, and a `need` on a missing service makes
# OpenRC refuse to start this one. --substitute-urls must reach the daemon as
# ONE argv element (a word-split list killed the daemon on T480, 2026-06-28).

name="guix-daemon"
description="GNU Guix build daemon"

command="/var/guix/profiles/per-user/root/current-guix/bin/guix-daemon"
command_args="--build-users-group=guixbuild --substitute-urls=\"https://bordeaux.guix.gnu.org https://ci.guix.gnu.org https://substitutes.nonguix.org\""
command_background="yes"
pidfile="/run/guix-daemon.pid"
export GUIX_LOCPATH="/var/guix/profiles/per-user/root/guix-profile/lib/locale"

depend() {
    after mountall.sh net
}
