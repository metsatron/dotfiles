#!/usr/bin/env bash
# honey-sync-conflicts-install (generated by honey-sync-conflicts.org): install Honey's Syncthing conflict handler.
set -euo pipefail

usage() {
    cat <<'USAGE'
Usage: honey-sync-conflicts-install [--dry-run]
Install honey-sync-conflicts into ~/bin, ensure the hourly crontab line, and ensure Syncthing ignores permission bits on the vault and HEEA folders.
--dry-run prints what would change and touches nothing.
USAGE
}

DRY=""
case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    --dry-run) DRY=yes ;;
    "") ;;
    *) usage >&2; exit 64 ;;
esac

[ "$(id -u)" -ne 0 ] || { echo "honey-sync-conflicts-install: run as the owner (gille), not root" >&2; exit 1; }
LANE=$(cd "$(dirname "$0")/.." && pwd)
STAMP=$(date +%Y%m%d-%H%M%S)
BIN=$HOME/bin
CRON_COMMENT='# Sync conflicts (honey-sync-conflicts.org, Metsatron 2026-11-02): hourly, purge byte-identical conflict copies, write the Sync Conflicts notes. Pause: touch ~/.config/sync-conflicts/DISABLED'
CRON_LINE='17 * * * * mkdir -p /home/gille/.local/state/sync-conflicts && flock -n /tmp/honey-sync-conflicts.lock timeout 600 /home/gille/bin/honey-sync-conflicts run > /home/gille/.local/state/sync-conflicts/last-run.txt 2>&1'

say() { printf '%s\n' "$*"; }
run() { if [ -n "$DRY" ]; then say "would: $*"; else "$@"; fi; }

dest=$BIN/honey-sync-conflicts
if [ -e "$dest" ] && cmp -s "$LANE/bin/honey-sync-conflicts" "$dest"; then
    say "unchanged: $dest"
else
    [ -e "$dest" ] && run cp -p "$dest" "$dest.bak-honey-sync-conflicts-$STAMP"
    run install -D -m 0755 "$LANE/bin/honey-sync-conflicts" "$dest"
    say "installed: $dest"
fi

if crontab -l 2>/dev/null | grep -qF "$CRON_LINE"; then
    say "unchanged: crontab line"
else
    if crontab -l 2>/dev/null | grep -q 'honey-sync-conflicts'; then
        echo "honey-sync-conflicts-install: a different honey-sync-conflicts crontab line exists; fix by hand" >&2
        exit 1
    fi
    if [ -n "$DRY" ]; then
        say "would: append the hourly crontab line"
    else
        crontab -l > "$HOME/.local/state/crontab.pre-honey-sync-conflicts-$STAMP" 2>/dev/null || true
        { crontab -l 2>/dev/null || true; printf '%s\n%s\n' "$CRON_COMMENT" "$CRON_LINE"; } | crontab -
        say "installed: crontab line"
    fi
fi

# Root cause of the conflicts: honey-private-perms.sh (every 15 min) strips "other" permission bits from
# files Syncthing has just written, and with ignorePerms=false Syncthing counts that chmod as a local edit
# and bumps the file's version, which makes the next write from Gills look concurrent. Ignoring permission
# bits on Honey's side of these folders stops it; the perms script still keeps the files private.
ensure_ignoreperms() {
    python3 -I - "$DRY" <<'PY'
import json, os, ssl, sys, urllib.request, xml.etree.ElementTree as ET
dry = bool(sys.argv[1])
cfg = next(p for p in (os.path.expanduser("~/.local/state/syncthing/config.xml"),
                       os.path.expanduser("~/.config/syncthing/config.xml")) if os.path.exists(p))
g = ET.parse(cfg).getroot().find("gui")
base = ("https://" if g.get("tls") == "true" else "http://") + g.findtext("address")
key, ctx = g.findtext("apikey"), ssl._create_unverified_context()
def call(method, path, body=None):
    r = urllib.request.Request(base + path, method=method, headers={"X-API-Key": key, "Content-Type": "application/json"},
                               data=json.dumps(body).encode() if body is not None else None)
    with urllib.request.urlopen(r, timeout=30, context=ctx) as x:
        t = x.read()
        return json.loads(t) if t else None
for fid in ("obsidian-vault", "heea"):
    if call("GET", f"/rest/config/folders/{fid}")["ignorePerms"]:
        print(f"unchanged: syncthing folder {fid} ignorePerms=true")
    elif dry:
        print(f"would: set syncthing folder {fid} ignorePerms=true")
    else:
        call("PATCH", f"/rest/config/folders/{fid}", {"ignorePerms": True})
        print(f"installed: syncthing folder {fid} ignorePerms=true (undo: PATCH ignorePerms=false)")
PY
}
if [ -z "$DRY" ] && [ ! -e "$HOME/.local/state/syncthing-config.pre-ignoreperms-20261102.xml" ]; then
    cp -p "$(ls "$HOME/.local/state/syncthing/config.xml" "$HOME/.config/syncthing/config.xml" 2>/dev/null | head -1)" \
        "$HOME/.local/state/syncthing-config.pre-ignoreperms-20261102.xml"
fi
ensure_ignoreperms

if [ -n "$DRY" ]; then
    say "dry run: nothing changed"
    exit 0
fi
"$dest" run --dry-run
say "installed; the next scheduled run is at :17 past the hour"
