#!/usr/bin/env bash
# honey-sync-conflicts-install (generated by honey-sync-conflicts.org): install Honey's Syncthing conflict handler.
set -euo pipefail

usage() {
    cat <<'USAGE'
Usage: honey-sync-conflicts-install [--dry-run]
Install honey-sync-conflicts into ~/bin and ensure the hourly crontab line.
--dry-run prints what would change and touches nothing.
USAGE
}

DRY=""
case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    --dry-run) DRY=yes ;;
    "") ;;
    *) usage >&2; exit 64 ;;
esac

[ "$(id -u)" -ne 0 ] || { echo "honey-sync-conflicts-install: run as the owner (gille), not root" >&2; exit 1; }
LANE=$(cd "$(dirname "$0")/.." && pwd)
STAMP=$(date +%Y%m%d-%H%M%S)
BIN=$HOME/bin
CRON_COMMENT='# Sync conflicts (honey-sync-conflicts.org, Metsatron 2026-11-02): hourly, purge byte-identical conflict copies, write the Sync Conflicts notes. Pause: touch ~/.config/sync-conflicts/DISABLED'
CRON_LINE='17 * * * * mkdir -p /home/gille/.local/state/sync-conflicts && flock -n /tmp/honey-sync-conflicts.lock timeout 600 /home/gille/bin/honey-sync-conflicts run > /home/gille/.local/state/sync-conflicts/last-run.txt 2>&1'

say() { printf '%s\n' "$*"; }
run() { if [ -n "$DRY" ]; then say "would: $*"; else "$@"; fi; }

dest=$BIN/honey-sync-conflicts
if [ -e "$dest" ] && cmp -s "$LANE/bin/honey-sync-conflicts" "$dest"; then
    say "unchanged: $dest"
else
    [ -e "$dest" ] && run cp -p "$dest" "$dest.bak-honey-sync-conflicts-$STAMP"
    run install -D -m 0755 "$LANE/bin/honey-sync-conflicts" "$dest"
    say "installed: $dest"
fi

if crontab -l 2>/dev/null | grep -qF "$CRON_LINE"; then
    say "unchanged: crontab line"
else
    if crontab -l 2>/dev/null | grep -q 'honey-sync-conflicts'; then
        echo "honey-sync-conflicts-install: a different honey-sync-conflicts crontab line exists; fix by hand" >&2
        exit 1
    fi
    if [ -n "$DRY" ]; then
        say "would: append the hourly crontab line"
    else
        crontab -l > "$HOME/.local/state/crontab.pre-honey-sync-conflicts-$STAMP" 2>/dev/null || true
        { crontab -l 2>/dev/null || true; printf '%s\n%s\n' "$CRON_COMMENT" "$CRON_LINE"; } | crontab -
        say "installed: crontab line"
    fi
fi

if [ -n "$DRY" ]; then
    say "dry run: nothing changed"
    exit 0
fi
"$dest" run --dry-run
say "installed; the next scheduled run is at :17 past the hour"
