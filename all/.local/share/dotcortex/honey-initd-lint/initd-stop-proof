#!/usr/bin/env bash
# initd-stop-proof (generated by agents-bots-honey.org): run a unit's OWN stop() under the real openrc-run, inside a private PID namespace,
# with the pidfile deleted, and show whether any other process is signalled.
#
# WHAT THIS PROVES: "this stop function signals only its own pid".
# WHAT IT DOES NOT PROVE: that OpenRC's default stop no longer mass-kills on the real host. It never touches the real host's services, and it
# says nothing about any init script you have not run through it.
#
# Three conditions, all asserted by a gate BEFORE anything is started (the script aborts, having done nothing, if any one is false):
#   1. its own /proc   : a private PID namespace (unshare --pid --fork --mount-proc), so OpenRC's start-stop-daemon, which scans /proc, can only see
#                        processes that were started inside it;
#   2. a private /run  : a fresh tmpfs over /run (and over /sys/fs/cgroup, so OpenRC creates no cgroup on the real host), inside a private mount namespace;
#   3. no production pid visible: the namespace holds only this script's own processes, none of the production services' command lines, and no
#                        production pidfile.
# A CONTROL runs first: the same unit shape WITHOUT a stop() of its own. If the control does not reproduce the mass-kill the proof is vacuous and
# the script exits 3, never 0.
#
# Usage: initd-stop-proof [--unit PATH_TO_UNIT_WITH_stop()]   (default: ../honey-fca-dsh/openrc/honey-fca-egress, next to this script's lane)
# Needs: passwordless sudo, unshare, /sbin/openrc-run. Without them it says SKIP and exits 4. Exit: 0 proven, 1 a check failed, 3 control vacuous,
# 4 skipped, 5 the gate refused.
set -u
SELF="$(readlink -f "$0")"; HERE="$(dirname "$SELF")"
UNIT="${HERE}/../honey-fca-dsh/openrc/honey-fca-egress"
OPENRC=/sbin/openrc-run

if [ "${1:-}" = --inside ]; then
  # ---------------------------------------------------------------- inside the namespaces
  HOSTNS="$2"; WORK="$3"; UNIT="$4"
  say() { printf '%s\n' "$*"; }
  refuse() { say "GATE REFUSED: $*"; exit 5; }
  # --- gate: all three conditions, before anything is started ---
  [ "$(readlink /proc/self/ns/pid)" != "$HOSTNS" ] || refuse "this is the host PID namespace"
  [ "$$" -lt 100 ] || refuse "pid $$ is not a fresh namespace's early pid"
  tr '\0' ' ' < /proc/1/cmdline | grep -q -- '--inside' || refuse "pid 1 here is not this script: the PID namespace is not private"
  mount -t tmpfs tmpfs /run || refuse "cannot mount a private /run"
  [ "$(stat -f -c %T /run)" = tmpfs ] || refuse "/run is not a fresh tmpfs"
  [ -z "$(ls -A /run)" ] || refuse "/run is not empty: it is not private"   # checked first: mount(8) itself writes /run/mount afterwards
  mount -t tmpfs tmpfs /sys/fs/cgroup 2>/dev/null || refuse "cannot hide /sys/fs/cgroup"
  [ -z "$(ls -A /sys/fs/cgroup)" ] || refuse "/sys/fs/cgroup still shows the host's cgroups"
  nproc_seen="$(ls /proc | grep -c '^[0-9]\+$')"
  [ "$nproc_seen" -le 15 ] || refuse "$nproc_seen processes visible: not a private PID namespace"
  for p in /proc/[0-9]*; do
    c="$(tr '\0' ' ' < "$p/cmdline" 2>/dev/null)"
    case "$c" in *llama-swap*|*hermes*|*identity_proxy*|*llama-server*|*ornith*|*r2d2*|*honey-voice*|*review_desk*|*gille-*|*image-bridge*|*syncthing*)
      refuse "production-looking process visible: ${p#/proc/} $c";; esac
  done
  [ -z "$(ls /run/*.pid 2>/dev/null)" ] || refuse "a pidfile exists in /run"
  say "GATE: own PID namespace ($nproc_seen processes, none production), fresh tmpfs /run (empty), /sys/fs/cgroup hidden"
  mkdir -p /run/openrc/{started,starting,stopping,inactive,hotplugged,failed,scheduled,exclusive,daemons,options} /run/lock
  touch /run/openrc/softlevel   # OpenRC refuses to run a service on a system it did not boot; this /run is private, so the marker is too

  # --- the bystander: a python3 that LOGS every signal it is sent (and who sent it) instead of dying ---
  cat > "$WORK/bystander.py" <<'PY'
import os, signal, sys, time
log = sys.argv[1]
sigs = {signal.SIGTERM, signal.SIGHUP, signal.SIGINT, signal.SIGUSR2}
signal.pthread_sigmask(signal.SIG_BLOCK, sigs)
end = time.time() + 120
while time.time() < end:
    info = signal.sigtimedwait(sigs, 1)
    if info is None:
        continue
    try:
        who = open('/proc/%d/cmdline' % info.si_pid, 'rb').read().replace(b'\0', b' ').decode('utf-8', 'replace').strip()
    except OSError:
        who = '(gone)'
    with open(log, 'a') as f:
        f.write('%s from pid %d: %s\n' % (signal.Signals(info.si_signo).name, info.si_pid, who))
    if info.si_signo == signal.SIGUSR2:
        break
PY
  # --- units: production shape (command=/usr/bin/python3, command_background, pidfile in /run), differing only in having a stop() or not ---
  mkunit() { # name args [stop-function-file]
    { printf '#!/sbin/openrc-run\nname="%s"\ncommand="/usr/bin/python3"\ncommand_args="-I %s/bystander.py %s/%s.sig"\ncommand_background=true\npidfile="/run/%s.pid"\n' "$1" "$WORK" "$WORK" "$1" "$1"
      printf 'depend() { :; }\n'
      [ -n "${2:-}" ] && { printf 'relay_user=root\n'; cat "$2"; }
    } > "$WORK/units/$1"; chmod 755 "$WORK/units/$1"; }
  mkdir -p "$WORK/units"
  awk '/^stop\(\) \{/{p=1} p{print} p&&/^\}/{exit}' "$UNIT" > "$WORK/stop.fn"
  grep -q '^stop() {' "$WORK/stop.fn" || { say "no stop() found in $UNIT"; exit 1; }
  for u in bystander-a bystander-b control-subject; do mkunit "$u"; done
  mkunit safe-subject "$WORK/stop.fn"
  alive() { [ -d "/proc/$1" ]; }
  pidof_unit() { cat "/run/$1.pid" 2>/dev/null; }
  sigs_of() { cat "$WORK/$1.sig" 2>/dev/null | tr '\n' ';'; }
  fails=0
  check() { if [ "$2" = ok ]; then say "  ok   $1"; else say "  FAIL $1"; fails=$((fails+1)); fi; }
  start_all() {
    for u in bystander-a bystander-b "$1"; do "$WORK/units/$u" start >/dev/null 2>&1; done
    sleep 1
    setsid python3 -I "$WORK/bystander.py" "$WORK/plain.sig" </dev/null >/dev/null 2>&1 &  # a bystander NOT started by OpenRC
    sleep 1
    PLAIN="$(pgrep -f 'bystander.py .*plain.sig' | head -1)"
    for u in bystander-a bystander-b "$1"; do alive "$(pidof_unit $u)" || { say "setup failed: $u did not start"; exit 1; }; done
    alive "$PLAIN" || { say "setup failed: plain bystander did not start"; exit 1; }
  }
  reset_all() { for u in bystander-a bystander-b control-subject safe-subject; do
      p="$(pidof_unit $u)"; [ -n "$p" ] && kill -USR2 "$p" 2>/dev/null; rm -f "/run/$u.pid" "$WORK/$u.sig"
      "$WORK/units/$u" zap >/dev/null 2>&1; done
    pkill -USR2 -f 'bystander.py .*plain.sig'; sleep 1.2; rm -f "$WORK/plain.sig" "$WORK/"*.sig; }

  say "== CONTROL: the same shape with NO stop(); pidfile deleted, then stop (this is the failure the lint exists to prevent)"
  start_all control-subject
  rm -f /run/control-subject.pid
  "$WORK/units/control-subject" stop >"$WORK/control.out" 2>&1; say "  stop rc=$?"; sed 's/^/    | /' "$WORK/control.out"
  sleep 2
  ca="$(sigs_of bystander-a)"; cb="$(sigs_of bystander-b)"; cp="$(sigs_of plain)"
  say "  bystander-a (OpenRC-started) signals: ${ca:-none}"; say "  bystander-b (OpenRC-started) signals: ${cb:-none}"; say "  plain bystander (setsid, not OpenRC) signals: ${cp:-none}"
  CONTROL=vacuous; case "$ca$cb" in *SIGTERM*) CONTROL=reproduced;; esac
  say "  control: $CONTROL"
  reset_all

  say "== SAFE: the unit's own stop() (verbatim from $(basename "$UNIT")), three conditions of the pidfile"
  say "-- (1) pidfile deleted, then stop"
  start_all safe-subject
  rm -f /run/safe-subject.pid
  "$WORK/units/safe-subject" stop >"$WORK/safe1.out" 2>&1; rc=$?; say "  stop rc=$rc"; sleep 2
  [ -z "$(sigs_of bystander-a)$(sigs_of bystander-b)$(sigs_of plain)" ] && r=ok || r=bad
  check "no signal reached any bystander (a: $(sigs_of bystander-a)| b: $(sigs_of bystander-b)| plain: $(sigs_of plain)|)" $r
  alive "$(pidof_unit bystander-a)" && alive "$(pidof_unit bystander-b)" && alive "$PLAIN" && r=ok || r=bad
  check "all three bystanders still alive" $r
  reset_all
  say "-- (2) pidfile holds a dead pid, then stop"
  start_all safe-subject
  sp="$(pidof_unit safe-subject)"; kill -USR2 "$sp"; sleep 1.5; alive "$sp" && { say "  setup: subject did not exit"; exit 1; }
  "$WORK/units/safe-subject" stop >"$WORK/safe2.out" 2>&1; rc=$?; say "  stop rc=$rc"; sleep 2
  [ -z "$(sigs_of bystander-a)$(sigs_of bystander-b)$(sigs_of plain)" ] && r=ok || r=bad
  check "no signal reached any bystander" $r
  reset_all
  say "-- (3) pidfile intact: stop must signal its OWN pid, and only that"
  start_all safe-subject
  sp="$(pidof_unit safe-subject)"
  "$WORK/units/safe-subject" stop >"$WORK/safe3.out" 2>&1; rc=$?; say "  stop rc=$rc"; sleep 2
  alive "$sp" && r=bad || r=ok; check "the subject itself was stopped (pid $sp)" $r
  [ -z "$(sigs_of bystander-a)$(sigs_of bystander-b)$(sigs_of plain)" ] && r=ok || r=bad
  check "no signal reached any bystander" $r
  reset_all

  say
  if [ "$CONTROL" != reproduced ]; then say "RESULT: CONTROL DID NOT REPRODUCE the mass-kill, so the SAFE result proves nothing (exit 3)"; exit 3; fi
  if [ "$fails" != 0 ]; then say "RESULT: $fails check(s) FAILED"; exit 1; fi
  say "RESULT: PROVEN, and only this: this stop function signals only its own pid (control reproduced the hazard in the same namespace)."
  say "        NOT shown: that the default no longer mass-kills on the real host, or anything about any other init script."
  exit 0
fi

# -------------------------------------------------------------------- outside
[ "${1:-}" = --unit ] && UNIT="$2"
[ -f "$UNIT" ] || { echo "initd-stop-proof: unit not found: $UNIT" >&2; exit 1; }
for x in unshare stat; do command -v "$x" >/dev/null || { echo "SKIPPED: $x is not installed"; exit 4; }; done
[ -x "$OPENRC" ] || { echo "SKIPPED: no $OPENRC on this host"; exit 4; }
sudo -n true 2>/dev/null || { echo "SKIPPED: passwordless sudo is needed for the namespaces"; exit 4; }
WORK="$(mktemp -d /tmp/initd-stop-proof.XXXXXX)"; trap 'sudo -n rm -rf "$WORK"' EXIT
cgbefore="$(ls /sys/fs/cgroup 2>/dev/null | grep -c '^openrc\.')"
pidfiles_before="$(ls -l --time-style=+%s /run/*.pid 2>/dev/null | awk '{print $6,$7}' | sort | md5sum)"
HOSTNS="$(readlink /proc/self/ns/pid)"
sudo -n unshare --pid --fork --mount-proc --mount --propagation private bash "$SELF" --inside "$HOSTNS" "$WORK" "$UNIT"
rc=$?
cgafter="$(ls /sys/fs/cgroup 2>/dev/null | grep -c '^openrc\.')"
pidfiles_after="$(ls -l --time-style=+%s /run/*.pid 2>/dev/null | awk '{print $6,$7}' | sort | md5sum)"
echo "HOST AFTER: openrc cgroups before=$cgbefore after=$cgafter; production pidfile listing $( [ "$pidfiles_before" = "$pidfiles_after" ] && echo unchanged || echo CHANGED)"
[ "$cgbefore" = "$cgafter" ] && [ "$pidfiles_before" = "$pidfiles_after" ] || { echo "HOST CHANGED DURING THE PROOF: treat it as a failure"; [ "$rc" = 0 ] && rc=1; }
exit "$rc"
