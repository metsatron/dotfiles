#!/usr/bin/env bash
# devuan-guest-proof (generated by agents-bots-honey.org): a DISPOSABLE guest that matches Honey's init, running the init-script lint and one
# stop-safety proof, with Honey's version strings printed beside the guest's.
#
# The guest is a Virtual Habitat "sanctuary"-class guest (a container on the host kernel: guests.org, sanctuary-distrobox.org). Honey has docker, not
# podman/distrobox, so this uses docker; nothing is installed on Honey. It is built from the Devuan 6 "excalibur" image with the SAME openrc package version
# as Honey, run with no network and no mounts for the proof itself, and removed afterwards (the image too, unless --keep).
#   prepare : a throwaway container with network installs openrc=<Honey's version>, python3, procps, then runs the LINT on a copy of Honey's /etc/init.d
#             inside it and compares the output with the lint run on Honey (they must be identical apart from the path prefix). The copy is discarded with
#             that container: the committed image holds only the tools.
#   prove   : a fresh container, --network none, --tmpfs /run, memory and pid limits, whose ENTRYPOINT is initd-stop-proof --in-guest: the guest's own
#             PID namespace and private /run are the three conditions the host mode has to build (see that script's gate). /tmp is mounted exec because
#             docker's tmpfs mounts are noexec by default.
# Exit: 0 only if the guest's Devuan release, openrc package, OpenRC start-stop-daemon and Debian start-stop-daemon versions all equal Honey's, the lint
# output equals Honey's, and the proof says PROVEN. 1 = mismatch or failure, 4 = skipped (no docker or no network), 5 = the proof's gate refused.
# Usage: devuan-guest-proof [--keep] [--image IMAGE]
set -uo pipefail
HERE="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
IMAGE="devuan/devuan:excalibur"; KEEP=0
while [ $# -gt 0 ]; do case "$1" in --keep) KEEP=1;; --image) IMAGE="$2"; shift;; *) echo "unknown option $1" >&2; exit 64;; esac; shift; done
pick() { for c in "$@"; do [ -f "$c" ] && { echo "$c"; return; }; done; }
LINT="${HONEY_INITD_LINT:-$(pick "$HERE/../../../bin/honey-initd-lint" "$HERE/honey-initd-lint")}"
PROOF="${INITD_STOP_PROOF:-$(pick "$HERE/initd-stop-proof")}"
UNIT="${PROOF_UNIT:-$(pick "$HERE/../honey-fca-dsh/openrc/honey-fca-egress" "$HERE/honey-fca-egress")}"
[ -f "$LINT" ] && [ -f "$PROOF" ] && [ -f "$UNIT" ] || { echo "SKIPPED: lint, proof or unit not found"; exit 4; }
command -v docker >/dev/null && docker info >/dev/null 2>&1 || { echo "SKIPPED: no usable docker"; exit 4; }
TAG="hb-devuan-guest-proof:$$"; PREP="hb-devuan-prep-$$"
cleanup() { docker rm -f "$PREP" >/dev/null 2>&1; docker rmi -f "$TAG" >/dev/null 2>&1; [ "$KEEP" = 1 ] || docker rmi "$IMAGE" >/dev/null 2>&1; }
trap cleanup EXIT
bad=0
# ---- Honey's side
H_OS="$(. /etc/os-release; echo "$VERSION_ID ($VERSION_CODENAME)")"; H_DEB="$(cat /etc/debian_version)"
H_PKG="$(dpkg-query -W -f='${Version}' openrc)"; H_DPKG="$(dpkg-query -W -f='${Version}' dpkg)"
H_RC="$(openrc --version 2>&1 | head -1)"; H_SSD_RC="$(/lib/rc/sbin/start-stop-daemon --version 2>&1 | head -1)"; H_SSD_DEB="$(/sbin/start-stop-daemon --version 2>&1 | head -1)"
H_LINT="$(python3 -I "$LINT" --dir /etc/init.d --confd /etc/conf.d | sed 's|/etc/init.d/|/g/init.d/|g')"
# ---- prepare
docker pull -q "$IMAGE" >/dev/null 2>&1 || { echo "SKIPPED: cannot pull $IMAGE (no network?)"; exit 4; }
IMG_ID="$(docker image inspect "$IMAGE" --format '{{.Id}}' | cut -c1-19)"
docker run -d --name "$PREP" --memory 768m --pids-limit 512 --cpus 2 "$IMAGE" sleep 600 >/dev/null || { echo "cannot start the preparation container"; exit 1; }
docker exec "$PREP" sh -c "apt-get update -qq >/dev/null 2>&1 && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends openrc='$H_PKG' python3 procps >/dev/null 2>&1" \
  || { echo "FAIL: could not install openrc=$H_PKG in the guest (the repository no longer serves Honey's version?)"; docker exec "$PREP" apt-cache policy openrc | head -5; exit 1; }
docker exec "$PREP" mkdir -p /opt/hb /g
docker cp "$LINT" "$PREP:/opt/hb/honey-initd-lint"; docker cp "$PROOF" "$PREP:/opt/hb/initd-stop-proof"; docker cp "$UNIT" "$PREP:/opt/hb/honey-fca-egress"
docker cp /etc/init.d "$PREP:/g/init.d" 2>/dev/null; docker cp /etc/conf.d "$PREP:/g/conf.d" 2>/dev/null
G_LINT="$(docker exec "$PREP" python3 -I /opt/hb/honey-initd-lint --dir /g/init.d --confd /g/conf.d)"
docker exec "$PREP" rm -rf /g
G_OS="$(docker exec "$PREP" sh -c '. /etc/os-release; echo "$VERSION_ID ($VERSION_CODENAME)"')"; G_DEB="$(docker exec "$PREP" cat /etc/debian_version)"
G_PKG="$(docker exec "$PREP" dpkg-query -W -f='${Version}' openrc)"; G_DPKG="$(docker exec "$PREP" dpkg-query -W -f='${Version}' dpkg)"
G_RC="$(docker exec "$PREP" openrc --version 2>&1 | head -1)"
G_SSD_RC="$(docker exec "$PREP" sh -c '$(dpkg -L openrc | grep -E "/rc/sbin/start-stop-daemon$" | head -1) --version 2>&1 | head -1')"
G_SSD_DEB="$(docker exec "$PREP" /sbin/start-stop-daemon --version 2>&1 | head -1)"
G_PRETTY="$(docker exec "$PREP" sh -c '. /etc/os-release; echo "$PRETTY_NAME"')"
docker commit "$PREP" "$TAG" >/dev/null; docker rm -f "$PREP" >/dev/null
# ---- versions side by side
# OpenRC prints a container tag in its version string ("OpenRC [DOCKER]") when it detects one; the tag is not a version, so it is stripped before comparing.
norm() { printf '%s' "$1" | sed 's/ \[[A-Z-]*\]//'; }
row() { local ok=DIFFERENT; [ "$(norm "$2")" = "$(norm "$3")" ] && ok=match; printf '%-26s | %-34s | %-34s | %s\n' "$1" "$2" "$3" "$ok"; [ "$ok" = match ] || bad=$((bad+1)); }
info() { printf '%-26s | %-34s | %-34s | %s\n' "$1" "$2" "$3" "informational (base-files string, not an init package)"; }
echo "image: $IMAGE ($IMG_ID)"; printf '%-26s | %-34s | %-34s | %s\n' "" "HONEY" "GUEST" ""
row "Devuan VERSION_ID"        "$H_OS"     "$G_OS"
info "Debian base"             "$H_DEB"    "$G_DEB"
row "openrc package"           "$H_PKG"    "$G_PKG"
row "openrc --version"         "$H_RC"     "$G_RC"
row "start-stop-daemon (OpenRC)" "$H_SSD_RC" "$G_SSD_RC"
row "start-stop-daemon (Debian)" "$H_SSD_DEB" "$G_SSD_DEB"
row "dpkg package"             "$H_DPKG"   "$G_DPKG"
echo "guest PRETTY_NAME: $G_PRETTY   (Honey's is a Devuan 6 derivative; the base release and the init packages are what must match)"
# ---- lint on the guest, against Honey's own init scripts
if [ "$H_LINT" = "$G_LINT" ]; then echo "LINT in the guest on a copy of Honey's /etc/init.d: output identical to Honey's ($(printf '%s\n' "$G_LINT" | grep '^SUMMARY' | cut -c1-110))"
else echo "LINT DIFFERS between Honey and the guest:"; diff <(printf '%s\n' "$H_LINT") <(printf '%s\n' "$G_LINT") | head -10; bad=$((bad+1)); fi
# ---- the proof, as the guest's entrypoint
echo "== stop-safety proof inside the guest (entrypoint pid 1, --network none, --tmpfs /run, memory and pid limits; docker tmpfs mounts are noexec by default, so /tmp is mounted exec)"
PROOF_OUT="$(docker run --rm --network none --tmpfs /run:exec,mode=755,size=16m --tmpfs /tmp:exec,mode=1777,size=64m --memory 256m --pids-limit 256 "$TAG" bash /opt/hb/initd-stop-proof --in-guest /tmp/w /opt/hb/honey-fca-egress 2>&1)"; prc=$?
printf '%s\n' "$PROOF_OUT" | cut -c1-200
if [ "$prc" = 5 ]; then echo "GATE REFUSED inside the guest"; exit 5; fi
[ "$prc" = 0 ] || { echo "proof exit $prc"; bad=$((bad+1)); }
echo
if [ "$bad" = 0 ]; then echo "RESULT: guest matches Honey on every version string, the lint output is identical, and the stop-safety proof ran inside it (exit 0)."; exit 0; fi
echo "RESULT: $bad mismatch(es) or failure(s)"; exit 1
