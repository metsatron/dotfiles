diff --git a/test/interactive.test.mjs b/test/interactive.test.mjs
index 5e9ab2b..99fa037 100644
--- a/test/interactive.test.mjs
+++ b/test/interactive.test.mjs
@@ -182,0 +183,32 @@ test('userQuestions provider is left alone when another UI owns it', () => {
+test('DSH 0.1.5 scoped userQuestions waterfall is answered through Telegram', async () => {
+  const delivery = fakeDelivery();
+  const events = fakeEvents();
+  const agent = { id: 's1' };
+  const ctx = {
+    get: (name) => {
+      if (name === 'userQuestions') return { ask() {} };
+      if (name === 'agents') return { get: (id) => id === agent.id ? agent : undefined, roots: () => [agent] };
+      return undefined;
+    },
+    on: events.on.bind(events),
+  };
+  const interactive = attachInteractive(ctx, delivery, { userQuestions: 'telegram', log: () => {} });
+  try {
+    const listener = events.listeners.get('user-questions/request');
+    assert.equal(typeof listener, 'function');
+    const result = listener({
+      agent,
+      questions: [{ id: 'q1', question: 'Proceed?', options: [{ label: 'Yes' }, { label: 'No' }] }],
+    }, () => Promise.reject(new Error('waterfall was not claimed')));
+    await new Promise((resolve) => setImmediate(resolve));
+    assert.equal(delivery.sent.length, 1);
+    assert.match(delivery.sent[0].text, /Proceed\?/);
+    const pendingId = Number(delivery.sent[0].keyboard.inline_keyboard[0][0].callback_data.split(':')[1]);
+    assert.equal(await interactive.toggleQuestionOption(111, pendingId, 'q1', 'Yes'), true);
+    assert.equal(await interactive.submitQuestions(111, pendingId), true);
+    assert.deepEqual(await result, { answers: [{ id: 'q1', selected: ['Yes'] }] });
+  } finally {
+    interactive.detach();
+  }
+});
+
