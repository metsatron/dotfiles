+        isAllowed: () => true,
+        liveAgentId: () => undefined,
+        resume: async () => ({ ok: false, text: 'not found' }),
+        adopt: () => assert.fail('failed resume must not be adopted'),
+        bind: () => { bound = true; },
+        log: () => {},
+      }),
+      /cannot restore chat 100 session missing-session: not found/,
+    );
+    assert.equal(bound, false);
+  } finally {
+    rmSync(root, { recursive: true, force: true });
