+test('restoreChatBindings resumes and adopts a cold session before binding it', async () => {
+  const { restoreChatBindings, saveChatBinding } = await import('../dist/core/chat-bindings.js');
+  const root = mkdtempSync(join(tmpdir(), 'tg-bindings-restore-'));
+  try {
+    saveChatBinding(root, 100, 'persisted-session');
+    const live = new Set();
+    const order = [];
+    await restoreChatBindings(root, {
+      isAllowed: (chatId) => chatId === 100,
+      liveAgentId: (sessionId) => live.has(sessionId) ? sessionId : undefined,
+      resume: async (sessionId) => {
+        order.push(`resume:${sessionId}`);
+        live.add(sessionId);
+        return { ok: true, text: 'ok', agentId: sessionId, handle: { sessionId } };
+      },
+      adopt: (handle) => order.push(`adopt:${handle.sessionId}`),
+      bind: (chatId, sessionId) => order.push(`bind:${chatId}:${sessionId}`),
+      log: () => {},
+    });
+    assert.deepEqual(order, [
+      'resume:persisted-session',
+      'adopt:persisted-session',
+      'bind:100:persisted-session',
+    ]);
+  } finally {
+    rmSync(root, { recursive: true, force: true });
+  }
+});
+
+test('restoreChatBindings fails closed when an allowed cold session cannot resume', async () => {
+  const { restoreChatBindings, saveChatBinding } = await import('../dist/core/chat-bindings.js');
+  const root = mkdtempSync(join(tmpdir(), 'tg-bindings-fail-'));
+  try {
+    saveChatBinding(root, 100, 'missing-session');
