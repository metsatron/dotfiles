+/** Resume every allowed persisted chat session before polling can accept an
+ * update. The profile is intentionally single-provider/model; passing that
+ * configured pair explicitly prevents one restored chat from inheriting a
+ * different chat's live model during a multi-chat cold start. */
+async function restorePersistedChats(ctx: Context): Promise<void> {
+  await restoreChatBindings(state.configRoot, {
+    isAllowed: (chatId) => isChatAllowed(state.config, chatId),
+    liveAgentId: (sessionId) => {
+      const live = ctx.agents?.get(sessionId as never);
+      return live === undefined ? undefined : String(live.id);
+    },
+    resume: async (sessionId) => {
+      const agents = ctx.agents;
+      if (agents === undefined) return { ok: false, text: "agents service is unavailable in this profile" };
+      try {
+        const handle = await agents.resume({
+          resumeSessionId: sessionId as never,
+          agentOptions: {
+            provider: state.config.model?.provider,
+            model: state.config.model?.model,
+          },
+        });
+        return { ok: true, text: `Resumed ${String(handle.agent.id)}`, agentId: String(handle.agent.id), handle };
+      } catch (err) {
+        return { ok: false, text: err instanceof Error ? err.message : String(err) };
+      }
+    },
+    adopt: (handle) => sessionLifecycle.adopt(handle),
+    bind: (chatId, sessionId) => state.bridge?.bindAgent(chatId, sessionId),
+    log: (message) => log(message),
+  });
+}
