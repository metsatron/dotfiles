+});
+
+test('restoreChatBindings reuses live sessions and ignores disallowed saved chats', async () => {
+  const { restoreChatBindings, saveChatBinding } = await import('../dist/core/chat-bindings.js');
+  const root = mkdtempSync(join(tmpdir(), 'tg-bindings-live-'));
+  try {
+    saveChatBinding(root, 100, 'already-live');
+    saveChatBinding(root, 200, 'not-allowed');
+    const bound = [];
+    await restoreChatBindings(root, {
+      isAllowed: (chatId) => chatId === 100,
+      liveAgentId: (sessionId) => sessionId === 'already-live' ? sessionId : undefined,
+      resume: async () => assert.fail('live and disallowed sessions must not resume'),
+      adopt: () => assert.fail('live sessions must not be adopted again'),
+      bind: (chatId, sessionId) => bound.push([chatId, sessionId]),
+      log: () => {},
+    });
+    assert.deepEqual(bound, [[100, 'already-live']]);
+  } finally {
+    rmSync(root, { recursive: true, force: true });
+  }
+});
