     /* best effort */
   }
 }
+
+/** Restore every allowed saved binding before Telegram polling starts.
+ * A process restart leaves persisted sessions cold, so registry lookup alone
+ * can never establish continuity. Any allowed binding that cannot be resumed
+ * fails the mount: polling with it unbound would silently create a new session
+ * on the next inbound message and falsely present that as successful recovery.
+ */
+export async function restoreChatBindings<Handle>(configRoot: string, ops: RestoreBindingOps<Handle>): Promise<void> {
+  for (const [chatIdRaw, entry] of Object.entries(readChatBindings(configRoot))) {
+    const chatId = Number(chatIdRaw);
+    if (!Number.isInteger(chatId) || !ops.isAllowed(chatId)) continue;
+    let liveId = ops.liveAgentId(entry.agentId);
+    if (liveId === undefined) {
+      const resumed = await ops.resume(entry.agentId);
+      if (!resumed.ok || resumed.handle === undefined || resumed.agentId === undefined) {
+        throw new Error(`cannot restore chat ${chatId} session ${entry.agentId}: ${resumed.text}`);
+      }
+      if (resumed.agentId !== entry.agentId) {
+        throw new Error(`restored session identity mismatch for chat ${chatId}: expected ${entry.agentId}, got ${resumed.agentId}`);
+      }
+      ops.adopt(resumed.handle);
+      liveId = ops.liveAgentId(entry.agentId);
+      if (liveId !== entry.agentId) {
+        throw new Error(`restored session ${entry.agentId} did not publish as live for chat ${chatId}`);
+      }
+      ops.log(`binding resumed chatId=${chatId} agentId=${entry.agentId}`);
+    }
+    if (liveId !== entry.agentId) {
+      throw new Error(`live session identity mismatch for chat ${chatId}: expected ${entry.agentId}, got ${liveId}`);
+    }
+    ops.bind(chatId, entry.agentId);
+    ops.log(`binding restored chatId=${chatId} agentId=${entry.agentId}`);
+  }
+}
