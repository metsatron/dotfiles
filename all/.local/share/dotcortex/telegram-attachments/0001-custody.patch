 const INBOX_DIR = join(STATE_DIR, 'inbox')
+// DOTCORTEX_ATTACHMENT_CUSTODY_BEGIN
+const attachmentNonce = randomBytes(16).toString('hex')
+const attachmentHelper = join(homedir(), '.local/share/dotcortex/telegram-attachments/custody.py')
+function attachmentCustody(op, data) {
+  return JSON.parse(execFileSync('/usr/bin/python3', [attachmentHelper, op], {
+    input: JSON.stringify(data), encoding: 'utf8', timeout: 5000,
+    maxBuffer: 4096, stdio: ['pipe', 'pipe', 'pipe'],
+  }))
+}
+// Missing owner/unsupported platform must not take down messaging. Downloads
+// remain disabled; initialization is retried only by a fresh plugin generation.
+let attachmentReady = false
+let attachmentInboxFD
+try {
+  const root = attachmentCustody('begin', {state: STATE_DIR, nonce: attachmentNonce})
+  attachmentInboxFD = openSync(INBOX_DIR, fsConstants.O_RDONLY | fsConstants.O_DIRECTORY | fsConstants.O_NOFOLLOW)
+  const info = fstatSync(attachmentInboxFD)
+  if (info.dev !== root.dev || info.ino !== root.ino) throw new Error('inbox race')
+  attachmentCustody('anchor', {nonce: attachmentNonce, fd: attachmentInboxFD})
+  attachmentReady = true
+} catch { process.stderr.write('telegram: attachment custody unavailable; downloads disabled\n') }
+async function safeAttachmentDownload(args) {
+  if (!attachmentReady || !args || typeof args !== 'object' || Array.isArray(args)
+      || Object.keys(args).length !== 1 || !Object.hasOwn(args, 'file_id')
+      || typeof args.file_id !== 'string' || !/^[A-Za-z0-9_-]{1,256}$/.test(args.file_id)) {
+    throw new Error('attachment arguments or owner refused')
+  }
+  const file_id = args.file_id
+  attachmentCustody('check', {nonce: attachmentNonce, file_id})
+  const limit = 20 * 1024 * 1024
+  const controller = new AbortController()
+  const timeout = new Promise((_, reject) => {
+    controller.signal.addEventListener('abort', () => reject(new Error('attachment deadline')), {once:true})
+  })
+  const timer = setTimeout(() => controller.abort(), 30000)
+  let reader
+  try {
+    const file = await Promise.race([bot.api.getFile(file_id, controller.signal), timeout])
+    if (!file || typeof file.file_path !== 'string'
+        || !/^[A-Za-z0-9_-]+\/[A-Za-z0-9_.-]+$/.test(file.file_path)
+        || file.file_path.includes('..')
+        || file.file_size != null && (!Number.isSafeInteger(file.file_size) || file.file_size < 0 || file.file_size > limit)) {
+      throw new Error('attachment metadata refused')
+    }
+    const url = `https://api.telegram.org/file/bot${TOKEN}/${file.file_path}`
+    const res = await Promise.race([fetch(url, {signal: controller.signal, redirect:'error'}), timeout])
+    if (!res.ok || !res.body) throw new Error('attachment response refused')
+    const length = res.headers.get('content-length')
+    if (length !== null && (!/^[0-9]{1,10}$/.test(length) || Number(length) > limit)) throw new Error('attachment too large')
+    reader = res.body.getReader()
+    const chunks = []
+    let size = 0
+    for (;;) {
+      const part = await Promise.race([reader.read(), timeout])
+      if (part.done) break
+      size += part.value.byteLength
+      if (size > limit) throw new Error('attachment too large')
+      chunks.push(Buffer.from(part.value))
+    }
+    attachmentCustody('check', {nonce: attachmentNonce, file_id})
+    return attachmentCustody('store', {nonce: attachmentNonce, file_id,
+      bytes: Buffer.concat(chunks, size).toString('base64')})
+  } finally {
+    clearTimeout(timer)
+    controller.abort()
+    if (reader) void reader.cancel().catch(() => {})
+  }
+}
+// DOTCORTEX_ATTACHMENT_CUSTODY_END
