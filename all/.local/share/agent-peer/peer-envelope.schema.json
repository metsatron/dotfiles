{
  "$id": "dotcortex.peer.v1",
  "title": "DotCortex peer envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "message_id",
    "kind",
    "created_at",
    "from",
    "to",
    "in_reply_to",
    "workspace",
    "authority",
    "payload"
  ],
  "properties": {
    "schema": {
      "const": "dotcortex.peer.v1"
    },
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "enum": ["task", "reply", "delivery", "status", "control"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "from": {
      "$ref": "#/$defs/peer"
    },
    "to": {
      "$ref": "#/$defs/peer"
    },
    "in_reply_to": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "workspace": {
      "$ref": "#/$defs/workspace"
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "lease": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/lease"}
      ]
    },
    "payload": {
      "$ref": "#/$defs/payload"
    }
  },
  "$defs": {
    "identity_component": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "peer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["peer_id", "host_id", "provider", "session_id"],
      "properties": {
        "peer_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "host_id": {
          "$ref": "#/$defs/identity_component"
        },
        "provider": {
          "$ref": "#/$defs/identity_component"
        },
        "session_id": {
          "$ref": "#/$defs/identity_component"
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "repo_root", "checkout_id", "access"],
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "repo_root": {
          "type": "string",
          "minLength": 1
        },
        "checkout_id": {
          "type": "string",
          "minLength": 1
        },
        "access": {
          "enum": ["read", "write"]
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "user_authority",
        "allow_git",
        "allow_push",
        "allow_pull",
        "allow_destructive"
      ],
      "properties": {
        "origin": {
          "const": "peer"
        },
        "user_authority": {
          "const": false
        },
        "allow_git": {
          "type": "boolean"
        },
        "allow_push": {
          "type": "boolean"
        },
        "allow_pull": {
          "type": "boolean"
        },
        "allow_destructive": {
          "const": false
        }
      }
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lease_id", "scopes"],
      "properties": {
        "lease_id": {
          "type": "string",
          "format": "uuid"
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["checkout-write", "upstream-integration"]
          }
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "body"],
      "properties": {
        "type": {
          "enum": ["message", "task_handoff"]
        },
        "body": {
          "type": "string"
        },
        "task_handoff": {
          "type": "object"
        }
      }
    }
  }
}
