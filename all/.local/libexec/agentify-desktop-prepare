#!/usr/bin/env bash
# Agentify Desktop - browser-session MCP (ChatGPT / Perplexity / more)
# Local control center that drives the user's OWN logged-in browser over Chrome
# DevTools Protocol and exposes it to MCP-capable agents (Claude Code, Codex,
# OpenCode, Hermes) as =agentify_*= tools: query, navigate, read page, tabs,
# artifacts. Six services: ChatGPT, Perplexity, Claude, Gemini, AI Studio, Grok.
# This is the fleet organ for reaching web subscriptions (ChatGPT Projects,
# Perplexity Spaces) from any agent without an API key — the subscription login
# lives in the browser profile, never in config. State: =~/.agentify-desktop/=.
# Loopback-only HTTP API; CAPTCHAs pause for the human by design.

# Pinned 0.2.4 (encoded 2026-08-15; first consumer: the Haiku governor lane in
# HelmCortex FORGE). The upstream ChatGPT controller types text one character at
# a time through CDP =Input.insertText=. Literal newline insertion is not a lawful
# multiline gesture for ChatGPT's ProseMirror composer and can submit fragments
# before Agentify's explicit final send. Both launchers therefore use a locally
# prepared, exact-version runtime. The preparer verifies the upstream controller
# SHA-256 and patches the final typing boundary to normalize line separators and
# emit Shift+Enter for each line break. Ordinary text is inserted in bounded
# runs, avoiding the upstream per-character delay. The composer is verified empty
# before any prompt bytes are inserted, with one exact selection retry before the
# send fails closed. Text structure is preserved, no raw newline reaches
# =Input.insertText=, and the existing explicit send remains the only submission.
# Any unknown source or failed verification aborts launch; Agentify is never
# allowed to run unguarded. One entrypoint, subcommand dispatch
# (verified via =--help=): default/=gui= starts the control center, =mcp= runs the
# stdio MCP server.


# [[file:../../../agents-mcp.org::*Agentify Desktop - browser-session MCP (ChatGPT / Perplexity / more)][Agentify Desktop - browser-session MCP (ChatGPT / Perplexity / more):1]]
# Prepare the pinned Agentify runtime and print its guarded entrypoint.
# This is the final fleet-wide single-send boundary, independent of harness
# hooks. It fails closed if the pinned source differs from the reviewed bytes.
set -euo pipefail

VERSION="0.2.4"
ORIGINAL_SHA256="9c8fff43aa57ed8da17f8a12e753eafcda240897fa092f1db0414fbce04a520e"
CONTAINMENT_SHA256="e59eb3fb86ad2dc0b858742b5b3f15125b740f365775d2dafa91eb99ecde3504"
STRUCTURED_V2_SHA256="e89f1c2100eb6db4f061e0fffc1031d012b62b931ce980dfcf0b759ab15d64ec"
PATCHED_SHA256="c58e197d015fc035c0288529a7077da29ca396528233d64d04a49e547bec64d3"
RUNTIME_ROOT="${AGENTIFY_SAFE_RUNTIME_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/agentify-desktop-safe/${VERSION}}"
PACKAGE_ROOT="$RUNTIME_ROOT/node_modules/@agentify/desktop"
CONTROLLER="$PACKAGE_ROOT/chatgpt-controller.mjs"
ENTRYPOINT="$PACKAGE_ROOT/bin/agentify-desktop.mjs"
LOCK_FILE="${RUNTIME_ROOT}.lock"

for command_name in npm python3 flock node; do
  command -v "$command_name" >/dev/null 2>&1 || {
    printf 'agentify-desktop: %s not found in PATH\n' "$command_name" >&2
    exit 1
  }
done

mkdir -p "$(dirname "$RUNTIME_ROOT")"
exec 9>"$LOCK_FILE"
flock 9

if [ ! -f "$ENTRYPOINT" ]; then
  mkdir -p "$RUNTIME_ROOT"
  npm install --silent --no-audit --no-fund --prefer-offline \
    --prefix "$RUNTIME_ROOT" "@agentify/desktop@${VERSION}"
fi

python3 - "$PACKAGE_ROOT/package.json" "$CONTROLLER" "$VERSION" \
  "$ORIGINAL_SHA256" "$CONTAINMENT_SHA256" "$STRUCTURED_V2_SHA256" \
  "$PATCHED_SHA256" <<'PY'
import hashlib
import json
import os
from pathlib import Path
import sys

package_json = Path(sys.argv[1])
controller = Path(sys.argv[2])
expected_version = sys.argv[3]
original_sha256 = sys.argv[4]
containment_sha256 = sys.argv[5]
structured_v2_sha256 = sys.argv[6]
patched_sha256 = sys.argv[7]
containment_marker = "HELMCORTEX_AGENTIFY_SINGLE_SEND_V1"
structured_v2_marker = "HELMCORTEX_AGENTIFY_STRUCTURED_INPUT_V2"
structured_v3_marker = "HELMCORTEX_AGENTIFY_STRUCTURED_INPUT_V3"

try:
    package = json.loads(package_json.read_text(encoding="utf-8"))
except Exception as exc:
    raise SystemExit(f"agentify-desktop: cannot read pinned package metadata: {exc}")
if package.get("name") != "@agentify/desktop" or package.get("version") != expected_version:
    raise SystemExit("agentify-desktop: pinned package identity mismatch")

source = controller.read_text(encoding="utf-8")
actual = hashlib.sha256(source.encode("utf-8")).hexdigest()
if structured_v3_marker not in source:
    typing_replacement = """  async #typeHuman(text) {
    // HELMCORTEX_AGENTIFY_STRUCTURED_INPUT_V3: preserve structure without submitting.
    const normalized = String(text).replace(/\\r\\n?|\\u2028|\\u2029/gu, '\\n');
    const lines = normalized.split('\\n');
    for (let lineIndex = 0; lineIndex < lines.length; lineIndex += 1) {
      this.#throwIfStopRequested();
      const line = lines[lineIndex];
      for (let offset = 0; offset < line.length; offset += 2048) {
        this.#throwIfStopRequested();
        await this.page.insertText(line.slice(offset, offset + 2048));
        await sleep(jitter(2, 8));
      }
      if (lineIndex < lines.length - 1) {
        await this.#sendKey('Enter', { modifiers: ['shift'] });
        await sleep(jitter(8, 24));
      }
    }
  }
"""
    if actual == original_sha256:
        needle = """  async #typeHuman(text) {
    for (const ch of String(text)) {
      this.#throwIfStopRequested();
      await this.page.insertText(ch);
      await sleep(jitter(12, 45));
    }
  }
"""
    elif actual == containment_sha256 and containment_marker in source:
        needle = """  async #typeHuman(text) {
    // HELMCORTEX_AGENTIFY_SINGLE_SEND_V1: collapse before any browser keystroke.
    const singleSendText = String(text)
      .replace(/[ \\t]*(?:\\r\\n?|\\n|\\u2028|\\u2029)+[ \\t]*/gu, ' ')
      .trim();
    if (!singleSendText) throw new Error('missing_prompt');
    if (/[\\r\\n\\u2028\\u2029]/u.test(singleSendText)) throw new Error('unsafe_multiline_prompt');
    for (const ch of singleSendText) {
      this.#throwIfStopRequested();
      await this.page.insertText(ch);
      await sleep(jitter(12, 45));
    }
  }
"""
    elif actual == structured_v2_sha256 and structured_v2_marker in source:
        needle = """  async #typeHuman(text) {
    // HELMCORTEX_AGENTIFY_STRUCTURED_INPUT_V2: preserve structure without submitting.
    const normalized = String(text).replace(/\\r\\n?|\\u2028|\\u2029/gu, '\\n');
    for (const ch of normalized) {
      this.#throwIfStopRequested();
      if (ch === '\\n') {
        await this.#sendKey('Enter', { modifiers: ['shift'] });
      } else {
        await this.page.insertText(ch);
      }
      await sleep(jitter(12, 45));
    }
  }
"""
    else:
        raise SystemExit(
            "agentify-desktop: refusing to patch unexpected controller source "
            f"(sha256={actual})"
        )
    if source.count(needle) != 1:
        raise SystemExit("agentify-desktop: controller patch point is missing or ambiguous")
    patched = source.replace(needle, typing_replacement)
    clear_needle = """    await this.#sendKey('A', { modifiers: [isMac ? 'meta' : 'control'] });
    await sleep(jitter(15, 50));
    await this.#sendKey('Backspace');
    await sleep(jitter(25, 80));
    await this.#typeHuman(prompt);
"""
    clear_replacement = """    await this.#sendKey('A', { modifiers: [isMac ? 'meta' : 'control'] });
    await sleep(jitter(15, 50));
    await this.#sendKey('Backspace');
    await sleep(jitter(25, 80));
    let cleared = await this.#eval(`(() => {
      const visible = (n) => {
        if (!n) return false;
        const r = n.getBoundingClientRect();
        const style = window.getComputedStyle(n);
        return r.width > 0 && r.height > 0 && style.visibility !== 'hidden' && style.display !== 'none';
      };
      const editable = (n) => {
        if (!visible(n)) return false;
        if (n.matches('textarea, input')) return !n.disabled && !n.readOnly;
        return !!n.isContentEditable || n.getAttribute('contenteditable') === 'true' || n.getAttribute('role') === 'textbox';
      };
      const candidates = [
        ...document.querySelectorAll(${sel}),
        ...document.querySelectorAll('main textarea, main [role="textbox"], main [contenteditable="true"], textarea, [role="textbox"], [contenteditable="true"]')
      ];
      const el = candidates.find(editable);
      if (!el) return { ok:false, error:'missing_prompt_textarea' };
      const text = n => n.matches('textarea, input') ? String(n.value || '') : String(n.innerText || n.textContent || '');
      const promptLen = text(el).trim().length;
      if (promptLen > 0) {
        el.focus();
        const selection = window.getSelection();
        if (selection) {
          const range = document.createRange();
          range.selectNodeContents(el);
          selection.removeAllRanges();
          selection.addRange(range);
        }
      }
      return { ok:true, promptLen };
    })()`);
    if (!cleared?.ok) {
      const err = new Error(cleared?.error || 'prompt_clear_failed');
      err.data = cleared;
      throw err;
    }
    if (cleared.promptLen > 0) {
      await this.#sendKey('Backspace');
      await sleep(jitter(25, 80));
      cleared = await this.#eval(`(() => {
        const visible = (n) => {
          if (!n) return false;
          const r = n.getBoundingClientRect();
          const style = window.getComputedStyle(n);
          return r.width > 0 && r.height > 0 && style.visibility !== 'hidden' && style.display !== 'none';
        };
        const candidates = [
          ...document.querySelectorAll(${sel}),
          ...document.querySelectorAll('main textarea, main [role="textbox"], main [contenteditable="true"], textarea, [role="textbox"], [contenteditable="true"]')
        ];
        const el = candidates.find(visible);
        if (!el) return { ok:false, error:'missing_prompt_textarea' };
        const text = el.matches('textarea, input') ? String(el.value || '') : String(el.innerText || el.textContent || '');
        return { ok:true, promptLen: text.trim().length };
      })()`);
    }
    if (!cleared?.ok || cleared.promptLen !== 0) {
      const err = new Error('prompt_clear_failed');
      err.data = cleared;
      throw err;
    }
    await this.#typeHuman(prompt);
"""
    if patched.count(clear_needle) != 1:
        raise SystemExit("agentify-desktop: composer-clear patch point is missing or ambiguous")
    patched = patched.replace(clear_needle, clear_replacement)
    temp = controller.with_name(controller.name + ".tmp")
    temp.write_text(patched, encoding="utf-8")
    os.chmod(temp, controller.stat().st_mode)
    os.replace(temp, controller)
    source = patched
    actual = hashlib.sha256(source.encode("utf-8")).hexdigest()

if actual != patched_sha256:
    raise SystemExit(
        "agentify-desktop: guarded controller verification failed "
        f"(sha256={actual})"
    )
PY

printf '%s\n' "$ENTRYPOINT"
# Agentify Desktop - browser-session MCP (ChatGPT / Perplexity / more):1 ends here
