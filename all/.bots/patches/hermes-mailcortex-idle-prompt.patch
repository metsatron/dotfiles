+    _GATEWAY_IDLE_PROMPT_PROTOCOL = "hermes.gateway_idle_prompt.v1"
+
+    @classmethod
+    def _gateway_idle_prompt_response(
+        cls, *, session_key: Any, request_id: Any = None,
+        status: Optional[str] = None, known: Optional[bool] = None,
+        busy: Optional[bool] = None, http_status: int = 200,
+    ) -> "web.Response":
+        payload: Dict[str, Any] = {
+            "protocol": cls._GATEWAY_IDLE_PROMPT_PROTOCOL,
+            "session_key": session_key,
+        }
+        if request_id is not None:
+            payload["request_id"] = request_id
+        if status is not None:
+            payload["status"] = status
+        if known is not None:
+            payload["known"] = known
+        if busy is not None:
+            payload["busy"] = busy
+        return web.json_response(payload, status=http_status)
+
+    @staticmethod
+    def _valid_gateway_session_key(value: Any) -> bool:
+        return (isinstance(value, str) and 1 <= len(value) <= 512
+                and ":telegram:" in value)
+
+    @_require_auth
+    async def _handle_gateway_idle_prompt_status(
+        self, request: "web.Request",
+    ) -> "web.Response":
+        body, error = await self._read_json_body(request)
+        session_key = body.get("session_key")
+        if (error is not None or set(body) != {"protocol", "session_key"}
+                or body.get("protocol") != self._GATEWAY_IDLE_PROMPT_PROTOCOL
+                or not self._valid_gateway_session_key(session_key)):
+            return self._gateway_idle_prompt_response(
+                session_key=session_key, known=False, busy=True, http_status=400)
+        runner = self.gateway_runner
+        if runner is None:
+            return self._gateway_idle_prompt_response(
+                session_key=session_key, known=False, busy=True, http_status=503)
+        outcome = await runner.gateway_idle_prompt_status(session_key)
+        if outcome == "unavailable":
+            return self._gateway_idle_prompt_response(
+                session_key=session_key, known=False, busy=True, http_status=503)
+        return self._gateway_idle_prompt_response(
+            session_key=session_key, known=True, busy=outcome == "busy")
+
+    @_require_auth
+    async def _handle_gateway_idle_prompt(self, request: "web.Request") -> "web.Response":
+        body, error = await self._read_json_body(request)
+        request_id = body.get("request_id")
+        session_key = body.get("session_key")
+        valid = (error is None
+                 and set(body) == {"protocol", "request_id", "session_key", "text"}
+                 and body.get("protocol") == self._GATEWAY_IDLE_PROMPT_PROTOCOL
+                 and isinstance(request_id, str)
+                 and re.fullmatch(r"[0-9a-f]{32}", request_id)
+                 and self._valid_gateway_session_key(session_key)
+                 and isinstance(body.get("text"), str)
+                 and 0 < len(body["text"].strip()) <= 16000)
+        if not valid:
+            return self._gateway_idle_prompt_response(
+                session_key=session_key, request_id=request_id,
+                status="invalid", http_status=400)
+        runner = self.gateway_runner
+        outcome = (await runner.admit_gateway_idle_prompt(session_key, body["text"])
+                   if runner is not None else "unavailable")
+        http_status = {"accepted": 202, "busy": 409, "unavailable": 503}.get(outcome, 503)
+        if outcome not in {"accepted", "busy", "unavailable"}:
+            outcome = "unavailable"
+        return self._gateway_idle_prompt_response(
+            session_key=session_key, request_id=request_id,
+            status=outcome, http_status=http_status)
+
