+    @staticmethod
+    def _policy_ttl_seconds(runtime: LLMRuntime) -> float | None:
+        fallback_compact = int(os.environ.get(
+            "NANOBOT_CACHE_POLICY_FALLBACK_COMPACT_SECONDS", "1620"
+        ))
+        fallback_cache = int(os.environ.get(
+            "NANOBOT_CACHE_POLICY_FALLBACK_CACHE_SECONDS", "1800"
+        ))
+        helper = Path(os.environ.get(
+            "FLEET_CACHE_POLICY_HELPER",
+            str(Path.home() / "HelmCortex/FORGE/bin/cache-policy"),
+        )).expanduser()
+        policy = Path(os.environ.get(
+            "FLEET_CACHE_POLICY_PATH",
+            str(Path.home() / "HelmCortex/ROOTS/DotRoot/agent-session/centre/data/cache-policy.json"),
+        )).expanduser()
+        provider = str(getattr(runtime.provider, "provider_name", "unknown"))
+        try:
+            completed = subprocess.run(
+                [str(helper), "resolve", "--policy", str(policy),
+                 "--harness", "nanobot", "--provider", provider,
+                 "--endpoint", provider, "--model", runtime.model,
+                 "--fallback-compact", str(fallback_compact),
+                 "--fallback-cache", str(fallback_cache),
+                 "--allow-observed"],
+                capture_output=True, text=True, timeout=5, check=True,
+            )
+            decision = json.loads(completed.stdout)
+            mode = str(decision.get("mode") or "fallback")
+            seconds = (float(decision["compact_before_seconds"])
+                       if mode in {"measured", "observed"} else None)
+        except (OSError, ValueError, KeyError, subprocess.SubprocessError):
+            seconds, mode = None, "fallback-error"
+        logger.debug(
+            "Auto-compact policy provider={} model={} mode={} threshold={}",
+            provider, runtime.model, mode,
+            "disabled" if seconds is None else f"{int(seconds)}s",
+        )
+        return None if seconds is None else max(60.0, seconds)
