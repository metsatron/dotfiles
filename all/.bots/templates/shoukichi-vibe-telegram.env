# [[file:../../../agents-bots.org::*HelmCortex Nano Templates][HelmCortex Nano Templates:3]]
# Shoukichi (vibe-bridge) private runtime environment
# Copy to ~/.config/vibe-telegram/env, set the dedicated token and the
# Admiral's numeric user ID, and keep the installed file mode 0600.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USER_IDS=
# MISTRAL_VIBE_API_KEY=
# MISTRAL_API_KEY is the Studio key (paid credit) and stays OUT of this
# lane: Shoukichi runs on the Vibe subscription key only.
# ACP_AGENT_COMMAND=vibe-acp
# VIBE_HOME is pinned by the wrapper, never by this file.
# HelmCortex Nano Templates:3 ends here
