# DeepSeek Harness Telegram Env Template

# The template contains placeholders only. Provision the real token/API key and
# allowlist from private credential storage on the target machine.


# [[file:../../../agents-bots.org::*DeepSeek Harness Telegram Env Template][DeepSeek Harness Telegram Env Template:1]]
# DeepSeek Harness Telegram configuration
# Copy to ~/.config/deepseek-harness-telegram/env on the target machine.
# Keep the private file mode 0600.

# Store the BotFather token only in this separate mode-0600 file. Inline tokens
# are deliberately rejected so they cannot appear in process arguments.
TELEGRAM_BOT_TOKEN_FILE=/home/metsatron/.config/deepseek-harness-telegram/token
# DeepSeek is the model author; NeuralWatt Flex is the required API route.
# Native DSH_HOME/.credentials.yaml refs.NEURALWATT_API_KEY is the default source
# (regular, owned by the harness UID, mode 0600). DSH resolves it without export.
# Optionally use an existing owner-only key file instead; never duplicate a key.
# An explicitly configured file must validate; it will not silently fall back.
# Never inline credentials here or in process arguments.
# NEURALWATT_API_KEY_FILE=YOUR_NEURALWATT_KEY_FILE
# Preserve the existing private Go binding for explicit manual selection only.
OPENCODE_GO_API_KEY_FILE=YOUR_HELMCORTEX_OPENCODE_GO_KEY_FILE
DSH_HOME=/home/metsatron/.local/share/deepseek-harness-telegram/dsh-home
DSH_TELEGRAM_PROFILE=helmcortex-telegram
DSH_TELEGRAM_WORKSPACE=/home/metsatron/HelmCortex/FORGE/brain/DeepSeek
DSH_TELEGRAM_PLUGIN_ROOT=/home/metsatron/HelmCortex/NEXUS/git/dsh-telegram
DSH_TELEGRAM_MODEL_PROVIDER=neuralwatt
DSH_TELEGRAM_MODEL=deepseek-v4.1-flash-flex
DSH_TELEGRAM_PROVIDER_BASE_URL=https://api.neuralwatt.com/v1
# Optional bare DNS host[:port] authority for the web UI (no scheme or path).
# Blank derives hostname -s plus the tailnet suffix from Self.DNSName and
# the Harness web port at sync time. Keep the real authority private.
DSH_WEB_TRUSTED_HOST=
# DeepSeek Harness Telegram Env Template:1 ends here
