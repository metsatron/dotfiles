# Hermes Dashboard Env Template

# Copy this template to =~/.hermes/dashboard.env= on the target machine, keep it
# mode 0600, and replace every placeholder from private credential storage.  Do
# not put a plaintext password in this file: provision the scrypt hash emitted by
# Hermes's bundled =plugins.dashboard_auth.basic.hash_password= helper.  Until the
# URL, username, and password hash are all provisioned, the manager intentionally
# starts a loopback-only dashboard.


# [[file:../../../agents-bots.org::*Hermes Dashboard Env Template][Hermes Dashboard Env Template:1]]
# Hermes dashboard private exposure policy (mode 0600)
HERMES_DASHBOARD_PUBLIC_URL=https://YOUR_TAILNET_HOST:YOUR_HERMES_DASHBOARD_PORT
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=YOUR_HERMES_DASHBOARD_BASIC_AUTH_USERNAME
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH=YOUR_HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH
HERMES_DASHBOARD_BASIC_AUTH_SECRET=YOUR_HERMES_DASHBOARD_BASIC_AUTH_SECRET
# Hermes Dashboard Env Template:1 ends here
