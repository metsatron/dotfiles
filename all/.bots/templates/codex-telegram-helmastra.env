# HelmAstra Codex Telegram Env Template

# The template contains structure only. Provision the real Telegram token and
# allowlisted user ID on the target machine from private credential storage.


# [[file:../../../agents-bots.org::*HelmAstra Codex Telegram Env Template][HelmAstra Codex Telegram Env Template:1]]
# HelmAstra Codex Telegram adapter configuration
# Copy to ~/.config/codex-telegram-helmastra/.env on target machine

TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
TELEGRAM_ALLOWED_USER_ID=YOUR_USER_ID
TELEGRAM_EXPECTED_BOT_ID=YOUR_BOT_ID
TELEGRAM_EXPECTED_BOT_USERNAME=YOUR_BOT_USERNAME
CODEX_TELEGRAM_MODEL=gpt-5.6-luna
CODEX_TELEGRAM_EFFORT=xhigh
CODEX_TELEGRAM_APPROVAL_POLICY=never
CODEX_IDLE_COMPACT_SECONDS=1620
CODEX_IDLE_COMPACT_MIN_TOKENS=70000
# HelmAstra Codex Telegram Env Template:1 ends here
