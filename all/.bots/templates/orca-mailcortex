#!/bin/bash
# Orca's normal MailCortex command: preserve private defaults everywhere except
# the already-provisioned shared Hermes receiver. Bubblewrap's user namespace
# cannot round-trip named ACL IDs; shared delivery uses fchmod before publication.
set -euo pipefail
export MAILCORTEX_ROOT=/home/metsatron/Mail
if [[ ${1:-} == send ]]; then
    recipient='' shared=0 take_next=0
    for arg in "${@:2}"; do
        if (( take_next )); then recipient=$arg; take_next=0; continue; fi
        case "$arg" in
            --to) take_next=1 ;;
            --to=*) recipient=${arg#--to=} ;;
            --shared-delivery) shared=1 ;;
        esac
    done
    if [[ $recipient == hermes@kikin.helm && $shared == 0 ]]; then
        exec /home/agent-deepseek/.local/bin/mailcortex-real "$@" --shared-delivery
    fi
fi
exec /home/agent-deepseek/.local/bin/mailcortex-real "$@"
