{
  "agents": {
    "defaults": {
      "workspace": "~/HelmCortex/FORGE/brain/nanobot",
      "modelPreset": "telegram",
      "botName": "HelmCortex Nano",
      "botIcon": "🐈",
      "unifiedSession": true,
      "timezone": "Australia/Melbourne",
      "timezoneMode": "manual"
    }
  },
  "modelPresets": {
    "telegram": {
      "model": "openai-codex/gpt-5.6-sol",
      "provider": "openai_codex",
      "maxTokens": 8192,
      "contextWindowTokens": 200000,
      "temperature": 0.1,
      "reasoningEffort": "high"
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "token": "${TELEGRAM_BOT_TOKEN}",
      "mode": "polling",
      "groupPolicy": "mention",
      "streaming": true,
      "richMessages": false
    }
  },
  "tools": {
    "restrictToWorkspace": true,
    "exec": {
      "enable": true,
      "sandbox": "bwrap"
    }
  },
  "gateway": {
    "host": "127.0.0.1",
    "port": 18790,
    "restartMode": "auto",
    "heartbeat": {
      "enabled": true,
      "intervalS": 1800
    }
  }
}
