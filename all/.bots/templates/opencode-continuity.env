# OpenCode continuity policy environment template

# This private environment is parsed through an exact key allowlist by
# =telegram-agent-host=. It is never evaluated as shell code.


# [[file:../../../agents-bots.org::*OpenCode continuity policy environment template][OpenCode continuity policy environment template:1]]
# Render this private template before installing it into the agent home.
OPENCODE_WARM_POLICY_HELPER=YOUR_HELMCORTEX_ROOT/FORGE/bin/opencode-continuity-policy
OPENCODE_WARM_POLICY_ROOT=YOUR_AUTHORITY_STATE_ROOT
OPENCODE_WARM_POLICY_AUTHORITY_IDENTITY=YOUR_AUTHORITY_IDENTITY
OPENCODE_WARM_POLICY_TELEMETRY_HOST=YOUR_TELEMETRY_HOST
OPENCODE_WARM_POLICY_PROVIDER=YOUR_POLICY_PROVIDER
OPENCODE_WARM_POLICY_ACCOUNT_HASH=YOUR_OPAQUE_ACCOUNT_HASH
OPENCODE_WARM_POLICY_MODEL_POOL=YOUR_MODEL_POOL
OPENCODE_WARM_POLICY_ESTIMATED_PRESERVATION_PERCENT=3
OPENCODE_WARM_POLICY_ESTIMATE_UNCERTAINTY_PERCENT=1
OPENCODE_WARM_POLICY_IN_FLIGHT_RESERVE_PERCENT=0.5
OPENCODE_WARM_POLICY_CONTROL_RESERVE_PERCENT=0.5
OPENCODE_WARM_POLICY_SAFETY_MARGIN_SECONDS=120
OPENCODE_WARM_CACHE_TTL_SECONDS=1800
OPENCODE_WARM_NUDGE_SCHEDULER=YOUR_HELMCORTEX_ROOT/FORGE/bin/timeark-oneshot-schedule
OPENCODE_WARM_WAKEUP_ADAPTER=YOUR_AGENT_HOME/.local/bin/opencode-wakeup
OPENCODE_WARM_NUDGE_DELAY_SECONDS=15
OPENCODE_WARM_NUDGE_EXPIRY_SECONDS=1800
OPENCODE_WARM_NUDGE_TIMEZONE=YOUR_TIMEZONE
# OpenCode continuity policy environment template:1 ends here
