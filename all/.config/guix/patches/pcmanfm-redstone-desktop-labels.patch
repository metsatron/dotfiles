+static gboolean desktop_label_foreground_is_dark(FmDesktop* desktop)
+{
+    guint luminance;
+
+    luminance = desktop->conf.desktop_fg.red * 299
+              + desktop->conf.desktop_fg.green * 587
+              + desktop->conf.desktop_fg.blue * 114;
+    return luminance < 32768 * 1000;
+}
+
+static void get_label_rects(FmDesktop* desktop, FmDesktopItem* item,
+                            PangoRectangle* ink,
+                            GdkRectangle* selection_rect,
+                            GdkRectangle* normal_rect,
+                            GdkRectangle* damage_rect)
+{
+    gint text_x = item->area.x + (desktop->cell_w - desktop->text_w) / 2 + 2;
+    gint text_y = item->area.y + desktop->ypad + fm_config->big_icon_size
+                + desktop->spacing + 2;
+    gint shadow_x = desktop->conf.desktop_label_shadow_x;
+    gint shadow_y = desktop->conf.desktop_label_shadow_y;
+
+    selection_rect->x = text_x + ink->x - 2;
+    selection_rect->y = text_y + ink->y - 2;
+    selection_rect->width = MAX(1, ink->width + 4);
+    selection_rect->height = MAX(1, ink->height + 4);
+    *normal_rect = *selection_rect;
+
+    if(desktop->conf.desktop_label_mode == FM_DESKTOP_LABEL_BOX)
+    {
+        normal_rect->x = text_x + ink->x
+                       - desktop->conf.desktop_label_padding_x;
+        normal_rect->y = text_y + ink->y
+                       - desktop->conf.desktop_label_padding_y;
+        normal_rect->width = MAX(1, ink->width
+                               + 2 * desktop->conf.desktop_label_padding_x);
+        normal_rect->height = MAX(1, ink->height
+                                + 2 * desktop->conf.desktop_label_padding_y);
+    }
+    else if(desktop->conf.desktop_label_mode == FM_DESKTOP_LABEL_SHADOW &&
+            !desktop_label_foreground_is_dark(desktop))
+    {
+        gint x1 = MIN(normal_rect->x, normal_rect->x + shadow_x);
+        gint y1 = MIN(normal_rect->y, normal_rect->y + shadow_y);
+        gint x2 = MAX(normal_rect->x + normal_rect->width,
+                      normal_rect->x + normal_rect->width + shadow_x);
+        gint y2 = MAX(normal_rect->y + normal_rect->height,
+                      normal_rect->y + normal_rect->height + shadow_y);
+
+        normal_rect->x = x1;
+        normal_rect->y = y1;
+        normal_rect->width = x2 - x1;
+        normal_rect->height = y2 - y1;
+    }
+
+    gdk_rectangle_union(selection_rect, normal_rect, damage_rect);
+}
