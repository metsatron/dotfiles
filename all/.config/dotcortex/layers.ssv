# LAYER         SLOT      NOTE
all             base      "shared by every host"
linux           platform  "Linux userland (Guix, host-wrap)"
termux          platform  "Android Termux userland"
debian          distro    "Debian family: nala/apt manifests"
openmandriva    distro    "OpenMandriva family: DNF manifests; no live systems at present"
devuan          init      "sysv-rc session layer (devuan/.xsessionrc); OpenRC hosts leave INIT empty"
