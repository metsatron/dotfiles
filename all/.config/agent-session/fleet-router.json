{
  "schema": "dotcortex.fleet-router.v1",
  "transport": {
    "kind": "ssh-exec",
    "hub_machine_key": "kikin-kushi",
    "hub_ssh_alias": "kikin",
    "ssh_options": {
      "BatchMode": "yes",
      "PasswordAuthentication": "no",
      "KbdInteractiveAuthentication": "no",
      "PreferredAuthentications": "publickey",
      "ConnectTimeout": "10",
      "ConnectionAttempts": "1"
    }
  },
  "defaults": {
    "class": "client-fanout-safe",
    "unknown_declared_class": "error",
    "reconcile": "unimplemented"
  },
  "tools": {
    "agent-sessiond": {"class": "client-fanout-safe"},
    "agent-session": {
      "class": "hub",
      "rules": [
        {"argv_prefix": ["once"], "class": "client-fanout-safe"}
      ]
    },
    "claude-code-md-pipeline": {"class": "client-fanout-safe"},
    "codex-md-pipeline": {"class": "client-fanout-safe"},
    "opencode-md-pipeline": {"class": "client-fanout-safe"},
    "hermes-md-pipeline": {"class": "client-fanout-safe"},
    "antigravity-md-pipeline": {"class": "client-fanout-safe"},
    "gemini-md-export": {"class": "client-fanout-safe"},
    "telegram-export-pipeline": {"class": "client-fanout-reconcile"},
    "recall": {"class": "hub"},
    "helmcortex-readme-indexer": {"class": "hub"},
    "helmcortex-export": {
      "class": "hub",
      "rules": [
        {"argv_prefix": ["local-capture"], "class": "client-fanout-safe"},
        {"argv_prefix": ["hub-finalize"], "class": "hub"},
        {"argv_prefix": ["aggregate"], "class": "hub"},
        {"argv_prefix": ["status"], "class": "hub"},
        {"argv_prefix": ["doctor"], "class": "hub"},
        {"argv_index_equals": {"index": 1, "value": "aggregate"}, "class": "hub"},
        {"argv_index_equals": {"index": 1, "value": "status"}, "class": "hub"},
        {"argv_index_equals": {"index": 1, "value": "doctor"}, "class": "hub"}
      ]
    },
    "helmcortex-compile": {
      "class": "hub",
      "rules": [
        {"argv_prefix": ["local-apply"], "class": "client-fanout-safe"}
      ]
    }
  }
}
