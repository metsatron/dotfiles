{
  "schema": "dotcortex.fleet-router.v2",
  "transport": {
    "kind": "ssh-exec",
    "hub_machine_key": "kikin-kushi",
    "hub_ssh_alias": "kikin",
    "ssh_options": {
      "BatchMode": "yes",
      "PasswordAuthentication": "no",
      "KbdInteractiveAuthentication": "no",
      "PreferredAuthentications": "publickey",
      "ConnectTimeout": "10",
      "ConnectionAttempts": "1"
    }
  },
  "defaults": {
    "class": "client-fanout-safe",
    "unknown_declared_class": "error",
    "reconcile": "declared-protocol-only"
  },
  "tools": {
    "dotcortex-export": {
      "class": "client-fanout-reconcile",
      "reconcile": {"protocol": "dotcortex-root-org-v1"}
    },
    "agent-sessiond": {"class": "client-fanout-safe"},
    "agent-session": {
      "class": "hub",
      "rules": [
        {"argv_prefix": ["once"], "class": "client-fanout-safe"}
      ]
    },
    "claude-code-md-pipeline": {"class": "client-fanout-safe"},
    "codex-md-pipeline": {"class": "client-fanout-safe"},
    "opencode-md-pipeline": {"class": "client-fanout-safe"},
    "hermes-md-pipeline": {"class": "client-fanout-safe"},
    "antigravity-md-pipeline": {"class": "client-fanout-safe"},
    "gemini-md-export": {"class": "client-fanout-safe"},
    "telegram-export-pipeline": {
      "class": "client-fanout-reconcile",
      "reconcile": {
        "protocol": "telegram-export-snapshot-v2",
        "legacy_unscoped_source_machine_key": "t480s"
      }
    },
    "recall": {"class": "hub"},
    "helmcortex-readme-indexer": {"class": "hub"},
    "helmcortex-export": {
      "class": "hub",
      "capture": {
        "schema": "helmcortex.fleet-capture.v2",
        "protocol": "ephemeral-ssh-v1",
        "finalization": {
          "owner": "hub_machine_key",
          "policy": "required"
        },
        "freshness": {
          "on_source_unavailable": "carry-forward-canonical-logs",
          "on_store_absent": "carry-forward-canonical-logs",
          "on_capture_failure": "carry-forward-canonical-logs",
          "allow_incomplete": true,
          "host_statuses": ["fresh", "carry-forward", "unavailable", "failed"],
          "incomplete_field": "freshness_complete",
          "preserve_history": true
        },
        "harnesses_semantics": "supported-local-probes",
        "limits": {
          "payload_bytes": 4194304,
          "result_bytes": 67108864,
          "expanded_bytes": 268435456,
          "file_bytes": 33554432,
          "files": 20000,
          "seconds": 600,
          "pages": 1000
        },
        "machines": {
          "x230": {
            "policy": "optional",
            "harnesses": [
              "claude-code",
              "codex",
              "opencode",
              "hermes",
              "pi-agent",
              "antigravity"
            ]
          },
          "t480s": {
            "policy": "optional",
            "harnesses": [
              "claude-code",
              "codex",
              "opencode",
              "hermes",
              "pi-agent",
              "antigravity"
            ]
          },
          "t480": {
            "policy": "optional",
            "harnesses": [
              "claude-code",
              "codex",
              "opencode",
              "hermes",
              "pi-agent",
              "antigravity"
            ]
          },
          "kikin-kushi": {
            "policy": "optional",
            "harnesses": [
              "claude-code",
              "codex",
              "opencode",
              "hermes",
              "pi-agent",
              "antigravity"
            ]
          },
          "s24": {
            "policy": "optional",
            "harnesses": [
              "claude-code",
              "codex",
              "opencode",
              "hermes",
              "pi-agent",
              "antigravity"
            ]
          }
        }
      },
      "rules": [
        {"argv_prefix": ["local-capture"], "class": "client-fanout-safe"},
        {"argv_prefix": ["hub-finalize"], "class": "hub"},
        {"argv_prefix": ["aggregate"], "class": "hub"},
        {"argv_prefix": ["status"], "class": "hub"},
        {"argv_prefix": ["doctor"], "class": "hub"},
        {"argv_index_equals": {"index": 1, "value": "aggregate"}, "class": "hub"},
        {"argv_index_equals": {"index": 1, "value": "status"}, "class": "hub"},
        {"argv_index_equals": {"index": 1, "value": "doctor"}, "class": "hub"}
      ]
    },
    "helmcortex-compile": {
      "class": "hub",
      "rules": [
        {"argv_prefix": ["local-apply"], "class": "client-fanout-safe"}
      ]
    }
  }
}
