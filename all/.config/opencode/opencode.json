{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "~/.env*": "deny",
      "~/.local/share/opencode/auth.json": "deny",
      "~/.codex/auth.json": "deny",
      "~/.claude/.credentials.json": "deny",
      "~/.ssh/*": "deny",
      "~/.config/helmcortex-borg/*": "deny",
      "*.kdbx": "deny"
    },
    "bash": {
      "*": "allow",
      "*.env*": "ask",
      "*auth.json*": "ask",
      "*.credentials.json*": "ask",
      "*.ssh/*": "ask",
      "*.kdbx*": "ask",
      "*helmcortex-borg/*.pass*": "ask",
      "printenv*": "ask",
      "env": "ask",
      "export -p*": "ask"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 16000
  },
  "provider": {
    "opencode-go": {
      "options": {
        "chunkTimeout": 120000
      },
      "models": {
        "deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash",
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        }
      }
    },
    "mistral": {
      "name": "Mistral Studio API",
      "npm": "@ai-sdk/mistral",
      "options": {
        "apiKey": "{env:MISTRAL_VIBE_API_KEY}",
        "baseURL": "https://api.mistral.ai/v1"
      }
    },
    "mistral-vibe": {
      "name": "Mistral Vibe",
      "npm": "@ai-sdk/mistral",
      "options": {
        "apiKey": "{env:MISTRAL_VIBE_API_KEY}",
        "baseURL": "https://api.mistral.ai/v1"
      },
      "models": {
        "mistral-vibe-cli-latest": {
          "name": "Vibe \u2014 CLI latest (256k)",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        },
        "mistral-vibe-cli-with-tools": {
          "name": "Vibe \u2014 CLI with tools (256k)",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        },
        "mistral-vibe-cli-fast": {
          "name": "Vibe \u2014 CLI fast (256k)",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        }
      }
    }
  },
  "plugin": [
    "@different-ai/opencode-browser"
  ],
  "mcp": {
    "brave-search": {
      "type": "local",
      "command": [
        "bash",
        "-lc",
        "exec \"$HOME/DotCortex/all/.local/bin/opencode-mcp-brave-search\""
      ],
      "enabled": true
    },
    "recall": {
      "type": "remote",
      "url": "http://thinkpad-x230:3004/mcp",
      "enabled": true
    },
    "agentify": {
      "type": "local",
      "command": [
        "bash",
        "-lc",
        "exec \"$HOME/DotCortex/all/.local/bin/agentify-desktop-mcp\""
      ],
      "enabled": true,
      "timeout": 60000
    },
    "agent-browser": {
      "type": "local",
      "command": [
        "bash",
        "-lc",
        "exec \"$HOME/.npm-global/bin/agent-browser\" mcp --tools core"
      ],
      "enabled": true,
      "timeout": 60000
    }
  },
  "tui": {
    "theme": "opencode"
  }
}
