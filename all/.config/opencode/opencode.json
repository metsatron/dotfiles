{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "~/.env*": "deny",
      "~/.local/share/opencode/auth.json": "deny",
      "~/.codex/auth.json": "deny",
      "~/.claude/.credentials.json": "deny",
      "~/.ssh/*": "deny",
      "~/.config/helmcortex-borg/*": "deny",
      "*.kdbx": "deny"
    },
    "bash": {
      "*": "allow",
      "*.env*": "ask",
      "*auth.json*": "ask",
      "*.credentials.json*": "ask",
      "*.ssh/*": "ask",
      "*.kdbx*": "ask",
      "*helmcortex-borg/*.pass*": "ask",
      "printenv*": "ask",
      "env": "ask",
      "export -p*": "ask"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 16000
  },
  "plugin": [
    "@different-ai/opencode-browser"
  ],
  "mcp": {
    "brave-search": {
      "type": "local",
      "command": [
        "bash",
        "-lc",
        "exec \"$HOME/.local/bin/opencode-mcp-brave-search\""
      ],
      "enabled": true
    },
    "recall": {
      "type": "local",
      "command": [
        "bash",
        "-lc",
        "exec \"$HOME/HelmCortex/FORGE/bin/recall\" mcp"
      ],
      "enabled": true
    },
    "agentify": {
      "type": "local",
      "command": [
        "bash",
        "-lc",
        "exec \"$HOME/.local/bin/agentify-desktop-mcp\""
      ],
      "enabled": true,
      "timeout": 60000
    },
    "agent-browser": {
      "type": "local",
      "command": [
        "bash",
        "-lc",
        "exec \"$HOME/.npm-global/bin/agent-browser\" mcp --tools core"
      ],
      "enabled": true,
      "timeout": 60000
    }
  },
  "tui": {
    "theme": "opencode"
  }
}
