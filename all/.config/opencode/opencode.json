{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 16000
  },
  "plugin": [
    "@different-ai/opencode-browser"
  ],
  "mcp": {
    "brave-search": {
      "type": "local",
      "command": [
        "bash",
        "-lc",
        "exec \"$HOME/.local/bin/opencode-mcp-brave-search\""
      ],
      "enabled": true
    },
    "recall": {
      "type": "local",
      "command": [
        "bash",
        "-lc",
        "exec \"$HOME/HelmCortex/FORGE/bin/recall\" mcp"
      ],
      "enabled": true
    },
    "agentify": {
      "type": "local",
      "command": [
        "bash",
        "-lc",
        "exec \"$HOME/.local/bin/agentify-desktop-mcp\""
      ],
      "enabled": true,
      "timeout": 60000
    },
    "agent-browser": {
      "type": "local",
      "command": [
        "bash",
        "-lc",
        "exec \"$HOME/.npm-global/bin/agent-browser\" mcp --tools core"
      ],
      "enabled": true,
      "timeout": 60000
    }
  },
  "tui": {
    "theme": "opencode"
  }
}
