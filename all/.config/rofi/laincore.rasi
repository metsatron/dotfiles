* {
    bg: #1f1f1f;
    bg-alt: #242424;
    fg: #d2d4d4;
    dim: #6a6a6a;
    accent: #15b8cf;
    urgent: #dc322f;
    border: #15b8cf;
    selected-fg: #1f1f1f;
    font: "monospace 12";
}

window {
    background-color: @bg;
    border: 1px;
    border-color: @border;
    border-radius: 8px;
    width: 600px;
    padding: 12px;
}

mainbox {
    spacing: 10px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg-alt;
    border-radius: 6px;
    padding: 8px 10px;
    spacing: 8px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
}

entry {
    text-color: @fg;
    placeholder: "Type to filter";
    placeholder-color: @dim;
}

listview {
    lines: 10;
    columns: 1;
    background-color: transparent;
    scrollbar: false;
    spacing: 4px;
}

element {
    background-color: transparent;
    text-color: @fg;
    border-radius: 6px;
    padding: 6px 8px;
    spacing: 8px;
}

element selected {
    background-color: @accent;
    text-color: @selected-fg;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}

element-icon {
    size: 1.1em;
    text-color: inherit;
}
