#!/bin/bash
# ~/.bash_exports
# --------------------------------------------------
# Mètsàtron's Exports
# --------------------------------------------------

# Add local bin directories to PATH. The shared-exports-min loop below consumes
# this array and guards every entry with path_dir_healthy (timeout-bounded).
# Bash has no .zshenv equivalent, so this array is the only place bash picks up
# the FORGE tools -- keep it in sync with the zsh list in .zsh_exports.
# .cargo/bin is absent on purpose: .bashrc sources ~/.cargo/env instead.
custom_paths=(
  "$HOME/bin"
  "$HOME/.local/bin"
  "$HOME/Apps"
  "$HOME/.scripts"
  "$HOME/stl/prefix"
)

# HelmCortex reaches PATH one of two ways, decided by whether this machine hosts
# it natively. On a client ~/HelmCortex is a SYMLINK into NFS, and putting the
# FORGE bins on PATH makes every bare-name command lookup stat the mount -- so a
# dead server hangs every command in every already-running shell, which
# path_dir_healthy cannot prevent because it only runs at startup. Clients get
# local shims instead; the native host uses the real bins. See helmcortex-shims.org.
if [ -L "$HOME/HelmCortex" ]; then
  custom_paths+=("$HOME/.local/hx/bin")
else
  custom_paths+=(
    "$HOME/HelmCortex/FORGE/bin"
    "$HOME/HelmCortex/FORGE/PixelForge/bin"
    "$HOME/HelmCortex/FORGE/VoxForge/bin"
  )
fi

# if command -v powerline-daemon >/dev/null 2>&1; then
#   powerline-daemon -q
#   POWERLINE_BASH_CONTINUATION=1
#   POWERLINE_BASH_SELECT=1
#   . /usr/share/powerline/bindings/bash/powerline.sh 2>/dev/null || true
# fi

# Arch Linux command-not-found hook
# if [ -f /etc/arch-release ] && [ -r /usr/share/doc/pkgfile/command-not-found.bash ]; then
#     . /usr/share/doc/pkgfile/command-not-found.bash
# fi

export PVOX_CLIP_PLAYER="ffplay -v error -nodisp -autoexit -"
export OMP_NUM_THREADS=2
export OPENBLAS_NUM_THREADS=2
export SHOW_LUMENASTRA_GREETING=0
export SHOW_FORTUNE=0
export SHOW_NEOFETCH=0

# Put /usr/local first (portable PATH edit)
export PATH="/usr/local/bin:/usr/local/sbin:$PATH"

# X session startup owns GTK no-CSD/appmenu env. Do not rewrite
# LD_PRELOAD in shell startup; that changes behavior for child GUI apps.

# dircolors
if command -v dircolors >/dev/null 2>&1; then
  if [ -f "$HOME/.dir_colors" ]; then
    eval "$(dircolors -b "$HOME/.dir_colors")"
  else
    eval "$(dircolors -b)"
  fi
fi

# lesspipe
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# ProtonUp-Qt PATH tail
if [ -d "/home/metsatron/stl/prefix" ]; then
  export PATH="$PATH:/home/metsatron/stl/prefix"
fi

# Guix "current" on PATH only
if [ -d "$HOME/.config/guix/current" ]; then
  export PATH="$HOME/.config/guix/current/bin:$PATH"
  export INFOPATH="$HOME/.config/guix/current/share/info:$INFOPATH"
fi

# Source main user Guix profile once, if present
if [ -L "$HOME/.guix-profile" ] && [ -z "${__GUIX_MAIN_PROFILE_SOURCED+x}" ]; then
  export __GUIX_MAIN_PROFILE_SOURCED=1
  GUIX_PROFILE="$HOME/.guix-profile"
  . "$GUIX_PROFILE/etc/profile"
fi

# Source per-profile 'core' once, if present
# Guard by PATH contents (not just env var) so we retry if prior sourcing failed
if [ -r "$HOME/.guix-extra-profiles/core/core/etc/profile" ]; then
  case ":$PATH:" in
    *":$HOME/.guix-extra-profiles/core/core/bin:"*) ;;  # already in PATH, skip
    *)
      export __GUIX_CORE_PROFILE_SOURCED=1
      export GUIX_PROFILE="$HOME/.guix-extra-profiles/core/core"
      . "$GUIX_PROFILE/etc/profile"
      # Guix profile sets EMACSLOADPATH without trailing : so Emacs loses defaults (cl-lib etc)
      [[ -n "${EMACSLOADPATH:-}" && "${EMACSLOADPATH}" != *: ]] && export EMACSLOADPATH="${EMACSLOADPATH}:"
      # Locales for this profile
      if [ -d "$GUIX_PROFILE/lib/locale" ]; then
        export GUIX_LOCPATH="$GUIX_PROFILE/lib/locale"
      fi
      ;;
  esac
fi

# Cortex guests source the desktop and sanctuary profiles in the session
# launcher.  Interactive shells must see the same command surfaces, plus the
# host-side Nala lane projected by Distrobox; otherwise a terminal can start
# with a working GUI but no loom/Guix/Nala tools.
case "${HOME:-}" in
  */.local/share/dotcortex/guests/sanctuary-cortex/home)
    # Cortex gets guest-native replacements for host cargo tools.  The marker
    # also prevents ~/.cargo/env from putting host-linked binaries first.
    export DOTCORTEX_SANCTUARY_GUEST=1
    if [ -z "${__GUIX_CORTEX_PROFILES_SOURCED+x}" ]; then
      for _cortex_profile in \
        "$HOME/.guix-extra-profiles/desktop-common/desktop-common" \
        "$HOME/.guix-extra-profiles/sanctuary-cortex/sanctuary-cortex"
      do
        if [ -r "$_cortex_profile/etc/profile" ]; then
          GUIX_PROFILE="$_cortex_profile"
          . "$GUIX_PROFILE/etc/profile"
        fi
      done
      export __GUIX_CORTEX_PROFILES_SOURCED=1
      export GUIX_PROFILE="$HOME/.guix-extra-profiles/sanctuary-cortex/sanctuary-cortex"
    fi
    if [ -d /run/host/usr/bin ]; then
      export PATH="$HOME/.local/bin:$HOME/DotCortex/all/.local/bin:$HOME/DotCortex/linux/.local/bin:$HOME/DotCortex/debian/.local/bin:$HOME/DotCortex/x230/.local/bin:$PATH:/run/host/usr/bin:/run/host/usr/sbin"
    fi
    ;;
esac

# Stop runtime loader from picking Guix libs for host binaries like /bin/ps
unset LD_LIBRARY_PATH

# Only add PATH entries that are actually traversable; dead mounts can make
# /usr/bin/env fail interpreter lookup with ENOTCONN. NFS-backed paths (e.g.
# HelmCortex on client machines) can also block the stat itself in D-state, so
# bound every probe with timeout — a wedged mount must never hang shell startup.
path_dir_healthy() {
  timeout 2 test -d "$1" 2>/dev/null || return 1
  timeout 2 ls -d "$1" >/dev/null 2>&1
}

# Homebrew / Linuxbrew
if path_dir_healthy "/home/linuxbrew/.linuxbrew/bin"; then
  export HOMEBREW_PREFIX="${HOMEBREW_PREFIX:-/home/linuxbrew/.linuxbrew}"
  export PATH="$HOMEBREW_PREFIX/bin:$HOMEBREW_PREFIX/sbin:$PATH"
elif path_dir_healthy "/opt/homebrew/bin"; then
  export HOMEBREW_PREFIX="${HOMEBREW_PREFIX:-/opt/homebrew}"
  export PATH="$HOMEBREW_PREFIX/bin:$HOMEBREW_PREFIX/sbin:$PATH"
fi

# Shared SSH agent for shells and GUI-launched tools
if [ -z "${DOTCORTEX_DISABLE_SSH_AGENT:-}" ] && [ -x "$HOME/.local/bin/ssh-agent-ensure" ]; then
  eval "$("$HOME/.local/bin/ssh-agent-ensure" --print)"
fi

case $- in
  *i*)
    if [ -f "$HOME/.ssh/id_ed25519" ] && command -v ssh-add >/dev/null 2>&1 && { [ -t 0 ] || [ -t 1 ] || [ -t 2 ]; }; then
      if ! ssh-add -l >/dev/null 2>&1; then
        ssh-add "$HOME/.ssh/id_ed25519" </dev/tty >/dev/null 2>&1 || true
      fi
    fi
    ;;
esac

# Simple colon-list deduper for bash/zsh (no output)
dedupe_path_var() {
  # IFS MUST be local. A bare `IFS=:` here leaks into the caller and poisons word
  # splitting for the whole shell -- it silently collapsed the custom_paths loop
  # below into one bogus path, and reached the live interactive session (bash and
  # zsh both ran with IFS=: until 2026-07-09).
  local name="$1" val new elem IFS=':'
  eval "val=\${$name}"
  new=
  for elem in $val; do
    [ -z "$elem" ] && continue
    case ":$new:" in
      *:"$elem":*) ;;
      *) new="${new:+$new:}$elem" ;;
    esac
  done
  eval "export $name=\$new"
}
[ -n "$LIBRARY_PATH" ]    && dedupe_path_var LIBRARY_PATH
[ -n "$GUIX_PYTHONPATH" ] && dedupe_path_var GUIX_PYTHONPATH

# fnm: tell it the shell explicitly to avoid calling `ps`
FNM_PATH="/home/metsatron/.local/share/fnm"
if path_dir_healthy "$FNM_PATH"; then
  export PATH="$FNM_PATH:$PATH"
  if [ -n "$ZSH_VERSION" ]; then
    eval "$(fnm env --shell=zsh --use-on-cd)"
  elif [ -n "$BASH_VERSION" ]; then
    eval "$(fnm env --shell=bash --use-on-cd)"
  else
    # Fallback with no inference, still avoids ps
    eval "$(fnm env)"
  fi
fi

# n (Node version manager) — installs to ~/.local so it beats Guix node in PATH
export N_PREFIX="$HOME/.local"

# npm global
if path_dir_healthy "$HOME/.npm-global/bin"; then
  export PATH="$HOME/.npm-global/bin:$PATH"
fi

# Bun
if path_dir_healthy "$HOME/.bun/bin"; then
  export PATH="$HOME/.bun/bin:$PATH"
fi

# Optional user-defined PATH extras (works even if array not set). The array
# expansion is quoted: the old unquoted ${custom_paths:+${custom_paths[@]}} form
# depended on IFS word splitting, so any stray IFS collapsed all entries into a
# single bogus path and silently added nothing.
if [ -n "${custom_paths+set}" ]; then
  for dir in "${custom_paths[@]}"; do
    path_dir_healthy "$dir" && PATH="$dir:$PATH"
  done
fi

# Priority: ~/.local/bin/claude (canonical) > ~/.config/Claude native app >
# Antigravity/VSCodium extension > npm global.
# Always prepend the best native binary so it wins over any npm-installed claude.
_claude_found=

# Tier 1: ~/.local/bin/claude (managed symlink / manual install)
if [ -x "$HOME/.local/bin/claude" ]; then
  export PATH="$HOME/.local/bin:$PATH"
  _claude_found=local

# Tier 2: newest versioned dir under Claude app install locations
else
  for _claude_base in \
    "$HOME/.config/Claude/claude-code" \
    "$HOME/.config/Claude/claude-code-vm"
  do
    [ -d "$_claude_base" ] || continue
    _claude_native_dir="$(find "$_claude_base" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort -V | tail -n 1)"
    if [ -n "$_claude_native_dir" ] && [ -x "$_claude_native_dir/claude" ]; then
      export PATH="$_claude_native_dir:$PATH"
      _claude_found=native
      break
    fi
  done

  # Tier 3: Antigravity / VSCodium extension managed binary
  if [ -z "$_claude_found" ] && [ -d "$HOME/.antigravity/extensions" ]; then
    _claude_ext_dir="$(find "$HOME/.antigravity/extensions" -path '*/resources/native-binary' -type d 2>/dev/null | sort -V | tail -n 1)"
    if [ -n "${_claude_ext_dir:-}" ] && [ -x "$_claude_ext_dir/claude" ]; then
      export PATH="$_claude_ext_dir:$PATH"
      _claude_found=antigravity
    fi
    unset _claude_ext_dir
  fi

  unset _claude_base _claude_native_dir
fi

unset _claude_found

# Dedupe PATH, keeping the FIRST occurrence so "local first" ordering survives.
# This block is sourced more than once in a normal login shell (.bash_profile ->
# .bash_exports, then .bashrc -> .bash_exports), and several stanzas above
# prepend unconditionally, so without this PATH accumulates duplicates on every
# pass -- which is how the HelmCortex FORGE entries came to appear three times
# each in a live session. Written with pure parameter expansion and no word
# splitting on purpose: zsh does not split unquoted $PATH the way bash does, so
# an IFS-based loop here would behave differently in the two shells.
_dc_dedupe_path() {
  _dc_out=""; _dc_rest="$PATH"
  while [ -n "$_dc_rest" ]; do
    _dc_d="${_dc_rest%%:*}"
    case "$_dc_rest" in
      *:*) _dc_rest="${_dc_rest#*:}" ;;
      *)   _dc_rest="" ;;
    esac
    [ -n "$_dc_d" ] || continue
    case ":${_dc_out}:" in
      *":${_dc_d}:"*) ;;
      *) _dc_out="${_dc_out:+$_dc_out:}$_dc_d" ;;
    esac
  done
  PATH="$_dc_out"
}
_dc_dedupe_path
unset -f _dc_dedupe_path 2>/dev/null || true
unset _dc_out _dc_rest _dc_d 2>/dev/null || true

export PATH

# Editor
export EDITOR=${EDITOR:-nvim}
export VISUAL=${VISUAL:-$EDITOR}

# History hygiene for bash
HISTCONTROL=ignoreboth


# Do not carry zsh-only tuning into bash children.
unset KEYTIMEOUT 2>/dev/null || true
