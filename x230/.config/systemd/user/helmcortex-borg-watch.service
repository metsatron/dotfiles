# HelmCortex Borg systemd units — X230
# X230 is the only HelmCortex Borg writer. These user units supervise the existing
# =FORGE/bin/helmcortex-borg= entrypoint: the watcher handles debounced near-real-time
# snapshots, while timers provide the daily/weekly/monthly safety net from the Borg
# design doc.

# *Thermal policy (2026-06-26):* the X230 took a kernel HARDWARE PROTECTION shutdown
# (=critical temperature reached=) while running borg unthrottled across all cores at
# turbo. Every Borg service has a generated =service.d/throttle.conf= drop-in with
# =Nice=19=, =CPUSchedulingPolicy=idle=, =IOSchedulingClass=idle=, =CPUWeight=20=,
# and =CPUQuota=100%=. The cgroup =cpu= controller is delegated to the user slice on
# this host, so =CPUQuota= is honoured for =--user= units.

# Cadence is **daily-only**: the half-hour timer and near-real-time watcher are left
# disabled on purpose — they were the heat source. Re-enable them only after cooling
# maintenance and live thermal validation.

# The service =PATH= intentionally includes =/usr/sbin= and =/sbin=: mount canary
# verification uses =blkid= on Debian, and =blkid= lives outside the ordinary user
# binary path. Snapshot/prune/check services also refresh the desktop SSH agent
# environment before invoking Borg so the T480s endpoint does not depend on stale
# systemd user-manager environment from login time.


# [[file:../../../../services.org::*HelmCortex Borg systemd units — X230][HelmCortex Borg systemd units — X230:1]]
[Unit]
Description=HelmCortex Borg watcher
Documentation=file:%h/HelmCortex/FORGE/docs/helmcortex-borg.md
ConditionPathExists=%h/HelmCortex/FORGE/bin/helmcortex-borg

[Service]
Type=simple
Environment=PATH=%h/.guix-extra-profiles/core/core/bin:%h/.guix-extra-profiles/core/core/sbin:%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=%h/HelmCortex/FORGE/bin/helmcortex-borg watch
Restart=on-failure
RestartSec=60
KillMode=process

[Install]
WantedBy=default.target
# HelmCortex Borg systemd units — X230:1 ends here
