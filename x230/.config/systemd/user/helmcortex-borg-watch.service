# HelmCortex Borg systemd units — X230
# X230 is the only HelmCortex Borg writer. These user units supervise the existing
# =FORGE/bin/helmcortex-borg= entrypoint: the watcher handles debounced near-real-time
# snapshots, while timers provide the daily/weekly/monthly safety net from the Borg
# design doc.


# [[file:../../../../services.org::*HelmCortex Borg systemd units — X230][HelmCortex Borg systemd units — X230:1]]
[Unit]
Description=HelmCortex Borg watcher
Documentation=file:%h/HelmCortex/FORGE/docs/helmcortex-borg.md
ConditionPathExists=%h/HelmCortex/FORGE/bin/helmcortex-borg

[Service]
Type=simple
Environment=PATH=%h/.guix-extra-profiles/core/core/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/HelmCortex/FORGE/bin/helmcortex-borg watch
Restart=on-failure
RestartSec=60
KillMode=process

[Install]
WantedBy=default.target
# HelmCortex Borg systemd units — X230:1 ends here
