# [[file:../../../../services.org::*HelmCortex Borg systemd units — X230][HelmCortex Borg systemd units — X230:11]]
[Unit]
Description=Run HelmCortex Borg weekly prune and compact

[Timer]
OnCalendar=Sun *-*-* 04:30:00
Persistent=true
Unit=helmcortex-borg-weekly-prune.service

[Install]
WantedBy=timers.target
# HelmCortex Borg systemd units — X230:11 ends here
