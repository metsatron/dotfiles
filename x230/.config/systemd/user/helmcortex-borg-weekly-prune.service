# [[file:../../../../services.org::*HelmCortex Borg systemd units — X230][HelmCortex Borg systemd units — X230:9]]
[Unit]
Description=HelmCortex Borg weekly prune and compact
Documentation=file:%h/HelmCortex/FORGE/docs/helmcortex-borg.md
ConditionPathExists=%h/HelmCortex/FORGE/bin/helmcortex-borg

[Service]
Type=oneshot
Environment=PATH=%h/.guix-extra-profiles/core/core/bin:%h/.guix-extra-profiles/core/core/sbin:%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStartPre=%h/.local/bin/ssh-agent-session-sync
ExecStart=%h/HelmCortex/FORGE/bin/helmcortex-borg prune
# HelmCortex Borg systemd units — X230:9 ends here
