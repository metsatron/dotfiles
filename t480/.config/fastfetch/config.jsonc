// ~/.config/fastfetch/config.jsonc — T480 (OpenMandriva, SonicDE)
{
	  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
	  "logo": {
		    "source": "~/.config/fastfetch/ascii.txt",
		    "padding": { "top": 0 },
        "color": { "1": "red", "2": "white" }
	  },
    "display": {
        "separator": " \u001b[91m󰨃 "
    },
    "modules": [
        {
            "type": "custom",
            "keyColor": "white",
            "format": "╭────────────────────────────────────────────────────────────╮"
        },
        { "type": "os", "key": " OS", "keyColor": "red" },
        { "type": "kernel", "key": "│ \u001b[91m├", "keyColor": "white" },
        {
            "type": "command",
            "key": "│ \u001b[91m├ Pkgs",
            "keyColor": "white",
            "shell": "/bin/sh",
            "param": "-c",
            "text": "rpm=$(rpm -qa 2>/dev/null | wc -l); flatpak=$(flatpak list --user 2>/dev/null | wc -l); out=\"\"; [ \"$rpm\" -gt 0 ] && out=\"${rpm} (rpm)\"; [ \"$flatpak\" -gt 0 ] && { [ -n \"$out\" ] && out=\"$out, \"; out=\"${out}${flatpak} (flatpak)\"; }; printf '%s' \"$out\"",
            "format": "{result}"
        },
        {
            "type": "command",
            "key": "│ \u001b[91m├ Guix",
            "keyColor": "white",
            "shell": "/bin/sh",
            "param": "-lc",
            "text": "core_profile=\"$HOME/.guix-extra-profiles/core/core\"; dev_profile=\"${GUIX_DEV_PROFILE:-$HOME/.guix-extra-profiles/dev/dev}\"; nonguix_profile=\"${GUIX_NONGUIX_PROFILE:-$HOME/.guix-extra-profiles/nonguix/nonguix}\"; count() { p=\"$1\"; if [ -e \"$p\" ]; then guix package -p \"$p\" -I 2>/dev/null | wc -l; else printf 0; fi; }; core=$(count \"$core_profile\"); dev=$(count \"$dev_profile\"); nonguix=$(count \"$nonguix_profile\"); out=\"\"; [ \"$core\" -gt 0 ] && out=\"${core} (core)\"; [ \"$dev\" -gt 0 ] && { [ -n \"$out\" ] && out=\"$out, \"; out=\"${out}${dev} (dev)\"; }; [ \"$nonguix\" -gt 0 ] && { [ -n \"$out\" ] && out=\"$out, \"; out=\"${out}${nonguix} (nonguix)\"; }; printf '%s' \"$out\"",
            "format": "{result}"
        },
        {
            "type": "command",
            "key": "│ \u001b[91m├ Node",
            "keyColor": "white",
            "shell": "/bin/sh",
            "param": "-lc",
            "text": "npm=$(ls ~/.npm-global/lib/node_modules/ 2>/dev/null | wc -l); bun=$(ls ~/.bun/install/global/node_modules/ 2>/dev/null | wc -l); out=\"\"; [ \"$npm\" -gt 0 ] && out=\"${npm} (npm)\"; [ \"$bun\" -gt 0 ] && { [ -n \"$out\" ] && out=\"$out, \"; out=\"${out}${bun} (bun)\"; }; printf '%s' \"$out\"",
            "format": "{result}"
        },
        {
            "type": "command",
            "key": "│ \u001b[91m├ Pip",
            "keyColor": "white",
            "shell": "/bin/sh",
            "param": "-lc",
            "text": "n=$(pip3 list 2>/dev/null | tail -n +3 | wc -l); [ \"$n\" -gt 0 ] && printf '%s (packages)' \"$n\"",
            "format": "{result}"
        },
        {
            "type": "command",
            "key": "│ \u001b[91m├ Cargo",
            "keyColor": "white",
            "shell": "/bin/sh",
            "param": "-lc",
            "text": "n=$(ls ~/.cargo/bin/ 2>/dev/null | wc -l); [ \"$n\" -gt 0 ] && printf '%s (tools)' \"$n\"",
            "format": "{result}"
        },
        {
            "type": "command",
            "key": "│ \u001b[91m├ AppImage",
            "keyColor": "white",
            "shell": "/bin/sh",
            "param": "-lc",
            "text": "if [ -d \"$HOME/Applications\" ]; then n=$(find \"$HOME/Applications\" -maxdepth 1 -type f -name '*.AppImage' 2>/dev/null | wc -l); else n=0; fi; [ \"$n\" -gt 0 ] && printf '%s (apps)' \"$n\"",
            "format": "{result}"
        },
        {
            "type": "command",
            "key": "│ \u001b[91m└ Games",
            "keyColor": "white",
            "shell": "/bin/sh",
            "param": "-lc",
            "text": "count_dirs(){ dir=$1; if [ -d $dir ]; then find $dir -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l; else printf 0; fi; }; steam1=$HOME/.steam/steam/steamapps/common; steam2=/secret/home/metsatron/Steam/steamapps/common; s1=$(count_dirs $steam1); s2=$(count_dirs $steam2); steam=$((s1 + s2)); lutris_db=$HOME/.local/share/lutris/pga.db; if [ -f $lutris_db ] && command -v sqlite3 >/dev/null 2>&1; then lutris=$(sqlite3 $lutris_db 'SELECT COUNT(*) FROM games WHERE installed=1;' 2>/dev/null || printf 0); else lutris=0; fi; es_base=$HOME/.emulationstation/gamelists; if [ -d $es_base ]; then retropie=$(grep -h '<game>' $es_base/*/gamelist.xml 2>/dev/null | wc -l); else retropie=0; fi; out=\"\"; [ \"$steam\" -gt 0 ] && out=\"${steam} (Steam)\"; [ \"$lutris\" -gt 0 ] && { [ -n \"$out\" ] && out=\"$out, \"; out=\"${out}${lutris} (Lutris)\"; }; [ \"$retropie\" -gt 0 ] && { [ -n \"$out\" ] && out=\"$out, \"; out=\"${out}${retropie} (RetroPie)\"; }; printf '%s' \"$out\"",
            "format": "{result}"
        },
        { "type": "shell", "key": "│ \u001b[91m└", "keyColor": "white" },
        {
            "type": "command",
            "key": "󰇄 DE",
            "keyColor": "red",
            "shell": "/bin/sh",
            "param": "-lc",
            "text": "printf 'SonicDE'",
            "format": "{result}"
        },
        { "type": "wm", "key": "│ \u001b[91m├", "keyColor": "white" },
        { "type": "theme", "key": "│ \u001b[91m├󰧨", "keyColor": "white" },
        { "type": "font", "key": "│ \u001b[91m├", "keyColor": "white" },
        { "type": "icons", "key": "│ \u001b[91m├", "keyColor": "white" },
        { "type": "terminal", "key": "│ \u001b[91m├", "keyColor": "white" },
        { "type": "wallpaper", "key": "│ \u001b[91m└󰸉", "keyColor": "white" },
        { "type": "host", "key": "󰟀 PC", "keyColor": "red" },
        { "type": "cpu", "key": "│ \u001b[91m├", "keyColor": "white" },
        { "type": "gpu", "key": "│ \u001b[91m├ ", "keyColor": "white" },
        { "type": "memory", "key": "│ \u001b[91m├󰑭", "keyColor": "white" },
        { "type": "battery", "key": "│ \u001b[91m├󰁹", "keyColor": "white" },
        { "type": "uptime", "key": "│ \u001b[91m└󰅐", "keyColor": "white" },
        { "type": "player", "key": " SND", "keyColor": "red" },
        { "type": "media", "key": "│ \u001b[91m└󰝚", "keyColor": "white" },
        {
            "type": "custom",
            "keyColor": "white",
            "format": "╰────────────────────────────────────────────────────────────╯"
        },
        {
            "type": "custom",
            "format": "\u001b[40m   \u001b[41m   \u001b[42m   \u001b[43m   \u001b[44m   \u001b[45m   \u001b[46m   \u001b[47m   \u001b[m \u001b[100m   \u001b[101m   \u001b[102m   \u001b[103m   \u001b[104m   \u001b[105m   \u001b[106m   \u001b[107m   \u001b[m"
        },
    ]
}
