# NFS mounts via tailscale — direct LAN path at home, DERP relay elsewhere
/home/metsatron/mnt/x230   -fstype=nfs4,rsize=131072,wsize=131072,async,noatime,soft,timeo=10,retrans=1,intr  x230:/home/metsatron
/home/metsatron/mnt/t480s  -fstype=nfs4,rsize=131072,wsize=131072,async,noatime,soft,timeo=10,retrans=1,intr  t480s:/home/metsatron
