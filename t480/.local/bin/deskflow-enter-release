#!/usr/bin/env bash
set -euo pipefail
DISPLAY="${DISPLAY:-:0}"
export DISPLAY

# Release standard modifier keysyms
xdotool keyup alt shift ctrl super Hyper_L ISO_Level3_Shift Return KP_Enter Linefeed 2>/dev/null || true

# Release any keys stuck in the XTEST virtual keyboard device. Deskflow sends
# keys via XTest and can leave key-up events behind when switching screens.
xtest_id="$(
  xinput list 2>/dev/null \
    | sed -n 's/.*XTEST keyboard.*id=\([0-9][0-9]*\).*/\1/p' \
    | head -n1
)"

if [ -n "$xtest_id" ]; then
  xinput query-state "$xtest_id" 2>/dev/null \
    | sed -n 's/.*key\[\([0-9][0-9]*\)\]=down.*/\1/p' \
    | while read -r keycode; do
        xdotool keyup "$keycode" 2>/dev/null || true
      done
fi
