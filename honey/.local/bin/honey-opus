#!/usr/bin/env bash
# honey/.local/bin/honey-opus (generated by agents-bots-honey.org): @honey_opus_bot
set -euo pipefail

LIB_DIR="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/../share/honey-claude/lib" && pwd)"
source "$LIB_DIR/telegram-preflight.bash"
source "$LIB_DIR/launch.bash"

case "${1-}" in
  -h|--help)
    printf '%s\n' "Usage: $(basename -- "$0") [--telegram] [claude args...]" \
      "Launch this Honey Claude bot through claude-warm in ~/honey-work/<bot> (agents-bots-honey.org)." \
      "  --telegram  attach the Telegram channel; runs in acceptEdits (auto) mode." \
      "              Token: ~/.claude/channels/telegram-<bot>/.env (never printed)."
    exit 0 ;;
esac
honey_claude_launch opus "${HONEY_OPUS_MODEL:-claude-opus-5-5}" "$@"
