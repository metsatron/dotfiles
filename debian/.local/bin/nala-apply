#!/usr/bin/env bash
# Apply script

# [[file:../../../package-nala.org::*Apply script][Apply script:1]]
set -euo pipefail

MAN="${NALA_SSV:-$HOME/.nala/manifest/packages.ssv}"
ENFORCE="${ENFORCE:-1}"
UNINSTALL="${UNINSTALL:-0}"
REL_SYNC_HELPER="${HOME}/.local/bin/nala-release-sync"
[ -x "$REL_SYNC_HELPER" ] || REL_SYNC_HELPER="${HOME}/DotCortex/debian/.local/bin/nala-release-sync"
BRAVE_GATE="${HOME}/.local/bin/brave-canary-gate"
[ -x "$BRAVE_GATE" ] || BRAVE_GATE="${HOME}/DotCortex/debian/.local/bin/brave-canary-gate"
HOST_EXCLUDES_BIN="${HOME}/.local/bin/host-excludes"
[ -x "$HOST_EXCLUDES_BIN" ] || HOST_EXCLUDES_BIN="${HOME}/DotCortex/all/.local/bin/host-excludes"

# Per-host provisioning gate (provision-host-gates.org). An ungated host prints
# "open" and takes the unchanged path below; a gated host (Honey) takes
# gated_apply: its own manifest, dry-run unless PROVISION_APPLY=1, never removes.
PROVISION_GATE_BIN="${HOME}/.local/bin/provision-gate"
[ -x "$PROVISION_GATE_BIN" ] || PROVISION_GATE_BIN="${DOTCORTEX_ROOT:-$HOME/DotCortex}/all/.local/bin/provision-gate"
GATE_MODE=open
if [ -x "$PROVISION_GATE_BIN" ]; then
  GATE_MODE="$("$PROVISION_GATE_BIN" mode nala)"
fi
if [ "$GATE_MODE" != open ] && [ -z "${NALA_SSV:-}" ]; then
  GATED_MAN="$("$PROVISION_GATE_BIN" manifest)"
  [ -n "$GATED_MAN" ] && MAN="$GATED_MAN"
fi

if [ ! -f "$MAN" ]; then
  echo "No manifest at $MAN" >&2
  exit 1
fi

# --- Detect OS ---
OS_ID="unknown"
if [ -f /etc/os-release ]; then
  # shellcheck disable=SC1091
  . /etc/os-release
  OS_ID="$ID"
fi
IS_DEVUAN=0
[ -f /etc/devuan_version ] && IS_DEVUAN=1

scope_matches() {
  local scope="$1"
  case "$scope" in
    shared) return 0 ;;
    devuan-only) [ "$IS_DEVUAN" -eq 1 ] ;;
    ubuntu-only) [ "$OS_ID" = "ubuntu" ] ;;
    vendefoul-only) [ "$OS_ID" = "vendefoul" ] ;;
    *) return 0 ;;
  esac
}

# --- Gated hosts: additive-only, dry-run by default, never removes ---
manifest_rows() {
  awk -v FS='[ \t]+' '
    function dq(s){ return (s == "\"\"" ? "" : s) }
    /^[ \t]*#/ || NF==0 { next }
    { printf "%s|%s|%s|%s|%s\n", dq($1), dq($2), dq($3), dq($4), dq($5) }
  ' "$MAN"
}

gated_apply() {
  local mode="$1" pkg _ver _cat scope _extra sim
  local satisfied=() install=() missing=() held=()
  echo "nala-apply: gated host (mode: $mode): additive only; nothing is ever removed here"
  echo "  manifest: $MAN"
  while IFS='|' read -r pkg _ver _cat scope _extra; do
    [ -z "$pkg" ] && continue
    scope_matches "$scope" || continue
    if [ -x "$HOST_EXCLUDES_BIN" ] && "$HOST_EXCLUDES_BIN" nala "$pkg"; then
      continue
    fi
    if [ "$(dpkg-query -W -f='${db:Status-Abbrev}' "$pkg" 2>/dev/null)" = "ii " ]; then
      satisfied+=("$pkg")
    elif apt-cache show "$pkg" >/dev/null 2>&1; then
      install+=("$pkg")
    else
      missing+=("$pkg")
    fi
  done < <(manifest_rows)

  if [ -x "$HOST_EXCLUDES_BIN" ]; then
    while IFS= read -r pkg; do
      [ -n "$pkg" ] && dpkg -s "$pkg" >/dev/null 2>&1 && held+=("$pkg")
    done < <("$HOST_EXCLUDES_BIN" nala)
  fi

  echo "  satisfied (${#satisfied[@]}): ${satisfied[*]:-}"
  echo "  to install (${#install[@]}): ${install[*]:-}"
  [ "${#missing[@]}" -eq 0 ] || echo "  not in apt repos (${#missing[@]}): ${missing[*]}"
  [ "${#held[@]}" -eq 0 ] || echo "  host-excluded but installed (${#held[@]}): ${held[*]} -- never removed on a gated host"
  echo "  skipped on gated host: nala bootstrap, nala upgrade, removals, Brave canary gate, release-backed .deb sync"

  if [ "${#install[@]}" -eq 0 ]; then
    echo "Nothing to install."
    return 0
  fi

  # With --no-remove apt aborts if the transaction would remove anything; the
  # Remv/Purg scan is a second, independent refusal.
  if ! sim="$(apt-get -s --no-remove -o APT::Get::AutomaticRemove=false install "${install[@]}" 2>&1)"; then
    echo "REFUSED: apt-get simulation failed; a gated host installs only transactions that remove nothing" >&2
    printf '%s\n' "$sim" | tail -20 >&2
    return 3
  fi
  if printf '%s\n' "$sim" | grep -qE '^(Remv|Purg) '; then
    echo "REFUSED: the install transaction would remove packages on a gated host:" >&2
    printf '%s\n' "$sim" | grep -E '^(Remv|Purg) ' >&2
    return 3
  fi
  echo "  simulation: $(printf '%s\n' "$sim" | grep -c '^Inst ') package(s) would be installed, 0 removed"

  if [ "$mode" != additive ]; then
    echo "dry-run (default on gated hosts): nothing installed. PROVISION_APPLY=1 installs the ${#install[@]} package(s) above; removals are never run here."
    return 0
  fi
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-remove -o APT::Get::AutomaticRemove=false "${install[@]}"
  echo "Done (additive)."
}

if [ "$GATE_MODE" != open ]; then
  gated_apply "$GATE_MODE"
  exit $?
fi

# --- Bootstrap nala if missing ---
APT="apt-get"
if command -v nala &>/dev/null; then
  APT="nala"
else
  echo "nala not found, installing..."
  sudo apt-get update
  sudo apt-get install -y nala || {
    echo "nala install failed, falling back to apt-get"
    APT="apt-get"
  }
  command -v nala &>/dev/null && APT="nala"
fi
echo "Using: $APT"

# Brave is the one apt package whose stable candidate must pass the real-display
# canary gate.  Run it before the generic manifest loop so an absent package also
# cannot bypass the gate.
if [ -x "$BRAVE_GATE" ]; then
  "$BRAVE_GATE"
fi

# --- Parse manifest, filter by scope ---
INSTALL_LIST=()

while IFS='|' read -r pkg _ver _cat scope _extra; do
  [ -z "$pkg" ] && continue

  if ! scope_matches "$scope"; then
    continue
  fi

  [ "$pkg" = brave-browser ] && continue

  if [ -x "$HOST_EXCLUDES_BIN" ] && "$HOST_EXCLUDES_BIN" nala "$pkg"; then
    continue
  fi

  # Check if already installed
  if dpkg -s "$pkg" &>/dev/null 2>&1; then
    continue
  fi

  # Check if package exists in repos
  if ! apt-cache show "$pkg" &>/dev/null 2>&1; then
    echo "Error: $pkg not found" >&2
    continue
  fi

  INSTALL_LIST+=("$pkg")
done < <(
  awk -v FS='[ \t]+' '
    function dq(s){ return (s == "\"\"" ? "" : s) }
    /^[ \t]*#/ || NF==0 { next }
    {
      printf "%s|%s|%s|%s|%s\n",
        dq($1), dq($2), dq($3), dq($4), dq($5)
    }
  ' "$MAN"
)

# --- Install missing ---
if [ ${#INSTALL_LIST[@]} -eq 0 ]; then
  echo "All manifest packages are installed."
else
  echo "Installing ${#INSTALL_LIST[@]} packages..."
  printf "  %s\n" "${INSTALL_LIST[@]}"
  sudo DEBIAN_FRONTEND=noninteractive $APT install -y "${INSTALL_LIST[@]}" || {
    if [ "$APT" = "nala" ]; then
      echo "nala failed (broken resolver), falling back to apt-get..."
      sudo DEBIAN_FRONTEND=noninteractive apt-get install -y "${INSTALL_LIST[@]}"
    else
      exit 1
    fi
  }
fi

# --- Remove host-excluded packages that are currently installed ---
if [ -x "$HOST_EXCLUDES_BIN" ]; then
  REMOVE_LIST=()
  while IFS= read -r excl_pkg; do
    [ -n "$excl_pkg" ] || continue
    if dpkg -s "$excl_pkg" &>/dev/null 2>&1; then
      REMOVE_LIST+=("$excl_pkg")
    fi
  done < <("$HOST_EXCLUDES_BIN" nala)

  if [ "${#REMOVE_LIST[@]}" -gt 0 ]; then
    echo "Removing ${#REMOVE_LIST[@]} host-excluded package(s)..."
    printf "  %s\n" "${REMOVE_LIST[@]}"
    sudo $APT remove -y "${REMOVE_LIST[@]}" || {
      echo "$APT remove failed, falling back to apt-get remove..."
      sudo apt-get remove -y "${REMOVE_LIST[@]}"
    }
  fi
fi

if [ -x "$REL_SYNC_HELPER" ]; then
  "$REL_SYNC_HELPER"
fi

echo "Done."
# Apply script:1 ends here
