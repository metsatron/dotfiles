+_AURA_DEDASH_KILL = os.path.expanduser("~/.config/aura-dedash/DISABLED")
+_AURA_DEDASH_PLUGIN = os.path.expanduser("~/.hermes/plugins/aura-dedash/__init__.py")
+_aura_dedash_mod = None
+
+
+def _aura_dedash_live(text):
+    if isinstance(text, str) and "—" in text and not os.path.exists(_AURA_DEDASH_KILL):
+        return text.replace(" —", ",").replace("—", ",")
+    return text
+
+
+def _aura_dedash_final(text):
+    global _aura_dedash_mod
+    if not isinstance(text, str) or os.path.exists(_AURA_DEDASH_KILL):
+        return text
+    try:
+        if _aura_dedash_mod is None:
+            import importlib.util
+            spec = importlib.util.spec_from_file_location("aura_dedash_webui", _AURA_DEDASH_PLUGIN)
+            mod = importlib.util.module_from_spec(spec)
+            spec.loader.exec_module(mod)
+            mod._convert = mod._load()
+            _aura_dedash_mod = mod
+        mod = _aura_dedash_mod
+        if mod._cfg().get("mode", "active") != "active":
+            return text
+        new, n = mod.clean(text)
+        if new != text:
+            mod._record("webui", n, "active")
+        return new
+    except Exception:
+        logger.debug("aura-dedash final clean failed; using live swap", exc_info=True)
+        return _aura_dedash_live(text)
+
 
