+_VOICE_NOTE_MARKER_RE = re.compile(
+    r"\[Sent (?:voice message|audio attachment|image attachment|"
+    r"video attachment|document attachment|\d+ media attachments?)\]",
+    re.IGNORECASE,
+)
+
+
+def _strip_voice_note_markers(text: str) -> str:
+    """Remove assistant-visible media mirror markers without touching real prose."""
+    if not text:
+        return text
+    stripped, count = _VOICE_NOTE_MARKER_RE.subn("", text)
+    if not count:
+        return text
+    stripped = re.sub(r"[ \t]+\n", "\n", stripped)
+    stripped = re.sub(r"\n{3,}", "\n\n", stripped).strip()
+    return stripped if stripped else text
+
+
