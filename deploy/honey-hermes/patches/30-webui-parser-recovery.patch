+"""Portable behavioural regression for the real messages.js parser display cache.
+
+Follows test_renderer_js_behaviour.py's stdlib subprocess -> Node extraction
+pattern. No npm modules, application import, server, session or provider needed.
+The broader attachLiveStream terminal/reconnect matrix is supplemental evidence.
+"""
+import json
+import shutil
+import subprocess
+import unittest
+from pathlib import Path
+
+
+REPO = Path(__file__).resolve().parent.parent
+NODE = shutil.which("node")
+
+DRIVER = r"""
+const fs=require('fs');
+const src=fs.readFileSync(process.argv[1],'utf8');
+const vendor=fs.readFileSync(process.argv[2],'utf8');
+const mode=process.argv[3];
+function extract(name){
+  const match=new RegExp('function\\s+'+name+'\\s*\\(').exec(src);
+  if(!match)throw Error(name+' missing');
+  let at=src.indexOf('{',match.index),depth=1,end=at+1;
+  while(depth&&end<src.length){if(src[end]==='{')depth++;else if(src[end]==='}')depth--;end++;}
+  return src.slice(match.index,end);
+}
+function node(text=''){
+  return {children:[],parentElement:null,_text:text,
+    appendChild(child){child.parentElement=this;this.children.push(child);return child;},
+    setAttribute(){},classList:{add(){},remove(){},toggle(){}},
+    get textContent(){return this._text+this.children.map(n=>n.textContent).join('');},
+    set textContent(value){this._text=value;this.children=[];},
+    set innerHTML(value){if(value!=='')throw Error('fixture only clears HTML');this._text='';this.children=[];}};
+}
+global.document={createElement:()=>node(),createTextNode:text=>node(text)};
+global.window={};
+(async()=>{
+  const actual=await import('data:text/javascript;base64,'+Buffer.from(vendor).toString('base64'));
+  window.smd={...actual};
+  let failed=false;const inputs=[];
+  window.smd.parser_write=(p,text)=>{
+    inputs.push(text);
+    if(mode!=='normal'&&!failed){
+      failed=true;
+      if(mode==='partial')actual.parser_write(p,text.slice(0,2));
+      throw Error('controlled one-shot parser failure');
+    }
+    return actual.parser_write(p,text);
+  };
+  // Use the production closure declarations, including any recovery-state flag.
+  const declarations=src.split('\n').filter(line=>/^  let (_smdParser|_smdWrittenLen|_smdWrittenText|_smdWriteFailed|_streamingKatexTimer)=/.test(line)).join('\n');
+  const body=declarations+'\n'+['_smdNewParser','_smdRendererWithoutUnderscoreEmphasis','_smdWrite','_smdEndParser'].map(extract).join('\n');
+  const run=new Function('actual','node','mode','inputs',body+`
+    let assistantBody=node();
+    const _safeSmdRenderer=el=>actual.default_renderer(el);
+    const _streamFadeRenderer=_safeSmdRenderer;
+    const _smdBindParserIdentity=()=>{};
+    const _scheduleStreamingKatex=()=>{};
+    const _sanitizeSmdLinks=()=>{};
+    const enhanceMarkdownTables=()=>{};
+    _smdNewParser(assistantBody);
+    _smdWrite('Water');
+    const afterFailure=assistantBody.textContent;
+    _smdWrite('Waterlow score 17, high risk.');
+    const afterNextSnapshot=assistantBody.textContent;
+    _smdEndParser();
+    return {afterFailure,afterNextSnapshot,flushed:assistantBody.textContent,inputs};
+  `);
+  process.stdout.write(JSON.stringify(run(actual,node,mode,inputs)));
+})().catch(error=>{console.error(error.name+': '+error.message);process.exitCode=1;});
+"""
+
+
+@unittest.skipUnless(NODE, "node not on PATH")
+class TestSmdParserWriteRecovery(unittest.TestCase):
+    def run_mode(self, mode):
+        result = subprocess.run(
+            [NODE, "-e", DRIVER, str(REPO / "static/messages.js"),
+             str(REPO / "static/vendor/smd.min.js"), mode],
+            capture_output=True, text=True, timeout=15,
+        )
+        self.assertEqual(result.returncode, 0, result.stderr)
+        return json.loads(result.stdout)
+
+    def test_recovers_next_snapshot_after_write_throws_before_consuming(self):
+        result = self.run_mode("before")
+        # The real parser may retain its final period until parser_end().
+        # Require the entire word prefix BEFORE terminal flushing, not just after it.
+        self.assertIn(
+            result["afterNextSnapshot"],
+            ("Waterlow score 17, high risk", "Waterlow score 17, high risk."),
+        )
+        self.assertEqual(result["flushed"], "Waterlow score 17, high risk.")
+
+    def test_recovers_next_snapshot_after_write_partly_mutates_parser(self):
+        result = self.run_mode("partial")
+        # The real parser may retain its final period until parser_end().
+        # Require the entire word prefix BEFORE terminal flushing, not just after it.
+        self.assertIn(
+            result["afterNextSnapshot"],
+            ("Waterlow score 17, high risk", "Waterlow score 17, high risk."),
+        )
+        self.assertEqual(result["flushed"], "Waterlow score 17, high risk.")
+
+    def test_normal_incremental_render_and_terminal_flush_stay_intact(self):
+        result = self.run_mode("normal")
+        # The real parser may retain its final period until parser_end().
+        # Require the entire word prefix BEFORE terminal flushing, not just after it.
+        self.assertIn(
+            result["afterNextSnapshot"],
+            ("Waterlow score 17, high risk", "Waterlow score 17, high risk."),
+        )
+        self.assertEqual(result["flushed"], "Waterlow score 17, high risk.")
+
+
+if __name__ == "__main__":
+    unittest.main()
