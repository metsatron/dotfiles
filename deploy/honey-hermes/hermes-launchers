#!/bin/bash
# Root. Run after go-live.sh and BEFORE starting services. Idempotent.
# The target's hermes_bootstrap does a launch-time source-update completion (dependency sync, node/TUI/web build, relaunch into a
# store interpreter) whenever PM has no recorded venv facts for the tree. A venv built by hermes-stage has none, and a relaunch broke
# the WebUI imports on 2026-11-06. HERMES_DISABLE_LAZY_INSTALLS=1 makes every launch skip that step, so nothing can re-resolve or
# prune the pinned venv (clinical-skill pins, voice extras). Services launch through the wrapper (gateway) or the venv python (WebUI).
set -euo pipefail; . "$(dirname "$0")/lib.sh"
mk(){ f=$1; shift; printf '%s\n' "$@" > "$f.tmp"; install -m 0755 -o "$OWNER" -g "$OWNER" "$f.tmp" "$f"; rm -f "$f.tmp"; }
mk "$LB/hermes" '#!/usr/bin/env bash' 'unset PYTHONPATH' 'unset PYTHONHOME' 'export HERMES_DISABLE_LAZY_INSTALLS=1' "exec \"$HH/hermes-agent/venv/bin/hermes\" \"\$@\""
for s in hermes-gateway hermes-webui; do
  grep -q '^export HERMES_DISABLE_LAZY_INSTALLS=1' "$INITD/$s" || sed -i '0,/^export HOME=/s//export HERMES_DISABLE_LAZY_INSTALLS=1\nexport HOME=/' "$INITD/$s"
  grep -q '^export HERMES_DISABLE_LAZY_INSTALLS=1' "$INITD/$s" || die "could not add the export to $INITD/$s"
done
echo LAUNCHERS-OK
