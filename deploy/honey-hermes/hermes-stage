#!/bin/bash
# hermes-stage: build the staged Hermes + WebUI trees for Honey from build-spec.env. Run as gille (not root).
# Idempotent: a stage whose recorded spec digest matches is left alone; otherwise REBUILD=1 moves it aside first.
set -euo pipefail
D=$(cd "$(dirname "$0")" && pwd); . "$D/build-spec.env"
: "${HH:=/home/gille/.hermes}" "${WS:=/home/gille/src}" "${CACHE:=/var/tmp/hermes-stage-cache}" "${BH:=/tmp/hermes-stage-home}"
SA=$HH/hermes-agent.staged; SW=$WS/hermes-webui.staged
die(){ echo "ABORT: $*" >&2; exit 1; }
[ "$(id -u)" != 0 ] || die "run as the gille user; root is used only through sudo for the mount namespace"
tree_digest(){ ( cd "$1" && find . -type f -not -path './.git/*' -not -path './venv/*' -print0 | sort -z | xargs -0 sha256sum | sha256sum | cut -c1-64 ); }
spec_digest(){ ( cd "$D" && cat build-spec.env carried-pins.txt $(for p in $PATCHES_AGENT $PATCHES_WEBUI; do echo patches/$p; done) | sha256sum | cut -c1-64 ); }
fetch(){ # host repo commit expect dest
  mkdir -p "$5"; ssh "$1" "git -C $2 archive --format=tar $3" | tar -x -C "$5"
  got=$(tree_digest "$5"); [ "$got" = "$4" ] || die "archive tree digest mismatch for $3: $got != $4"; }
baseline(){ ( cd "$1"; git init -q .; git add -A; git -c user.email=stage@honey -c user.name=hermes-stage commit -qm "pinned $2" ); }
apply(){ ( cd "$1"; shift; for p in "$@"; do git apply --check "$D/patches/$p" && git apply "$D/patches/$p"; done ); }
want=$(spec_digest)
if [ -f "$SA/.stage-spec" ] && [ "$(cat "$SA/.stage-spec")" = "$want" ] && [ -f "$SW/.stage-spec" ]; then echo "stage already matches spec $want"; exit 0; fi
if [ -e "$SA" ] || [ -e "$SW" ]; then
  [ "${REBUILD:-0}" = 1 ] || die "stage exists and does not match the spec; set REBUILD=1 to move it aside"
  ts=$(date +%Y%m%d-%H%M%S); [ ! -e "$SA" ] || mv "$SA" "$SA.old-$ts"; [ ! -e "$SW" ] || mv "$SW" "$SW.old-$ts"
fi
echo "== fetch + verify pinned sources"; fetch "$SOURCE_HOST" "$AGENT_REPO" "$AGENT_COMMIT" "$AGENT_TREE_SHA256" "$SA"
fetch "$SOURCE_HOST" "$WEBUI_REPO" "$WEBUI_COMMIT" "$WEBUI_TREE_SHA256" "$SW"
echo "== baseline commit + ordered patches"; baseline "$SA" "$AGENT_COMMIT"; baseline "$SW" "$WEBUI_COMMIT"
apply "$SA" $PATCHES_AGENT; apply "$SW" $PATCHES_WEBUI
[ -x "$PYTHON_HOME/bin/python3" ] || die "pinned python missing: $PYTHON_HOME"; [ -x "$UV_BIN" ] || die "uv missing: $UV_BIN"
echo "== venv at its final path (private mount namespace; the live tree is never touched)"
mkdir -p "$BH/.hermes" "$CACHE"
sudo -n env HH="$HH" SA="$SA" BH="$BH" CACHE="$CACHE" D="$D" PYTHON_HOME="$PYTHON_HOME" UV_BIN="$UV_BIN" EXTRAS="$EXTRAS" \
  unshare -m --propagation private bash "$D/hermes-stage-venv"
echo "$want" > "$SA/.stage-spec"; echo "$want" > "$SW/.stage-spec"
echo STAGE-OK "$want"
