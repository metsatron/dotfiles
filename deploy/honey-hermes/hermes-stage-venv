#!/bin/bash
# Root, inside a private mount namespace (called by hermes-stage). Bind-mounts the staged tree over the live path so the venv
# bakes its FINAL path, builds it with the target's own PM builder from the target uv.lock, then adds the carried pins.
set -euo pipefail
mount --bind "$SA" "$HH/hermes-agent"
run(){ setpriv --reuid=gille --regid=gille --init-groups env -i PATH=/usr/bin:/bin HOME="$BH" HERMES_HOME="$BH/.hermes" PYTHONDONTWRITEBYTECODE=1 "$@"; }
cd "$HH/hermes-agent"
ex=(); for e in $EXTRAS; do ex+=(--extra "$e"); done
run env PYTHONPATH=. /usr/bin/python3 -m pm.build_env --source "$HH/hermes-agent" --out "$HH/hermes-agent/venv" --cache "$CACHE" "${ex[@]}"
# As gille, never root: the target refuses to update a tree whose venv/bin/python is root-owned.
run ln -sfn "$PYTHON_HOME/bin/python3" venv/bin/python; run sed -i "s#^home = .*#home = $PYTHON_HOME/bin#" venv/pyvenv.cfg
run "$UV_BIN" pip install --python "$HH/hermes-agent/venv/bin/python" --cache-dir "$CACHE" -r "$D/carried-pins.txt"
run venv/bin/python -c 'import gateway.run, gateway.platforms.api_server, gateway.drain_control, tools.send_message_tool, faster_whisper, piper, edge_tts, telegram, aiohttp, docx, pdfplumber, lxml.etree, google.auth, boto3, uvloop; print("STAGE-IMPORTS-OK")'
