# Pinned, public, non-secret build spec for Honey's Hermes (gille). Sourced by hermes-stage and the deploy scripts.
SOURCE_HOST=kikin
AGENT_REPO=/home/metsatron/.hermes/hermes-agent
AGENT_COMMIT=3a5355dc173eff1a7ba8da3fcd0558a30a87cf65
# sha256 of the sorted per-file sha256 list of `git archive AGENT_COMMIT` (see hermes-stage tree_digest)
AGENT_TREE_SHA256=5cadd7c75d9ea532e525387adba5080d3cde4b83a2488c639616351f5e903ccd
WEBUI_REPO=/home/metsatron/src/hermes-webui
WEBUI_COMMIT=320789ae596a3963d726d90f6c7f3bc86f7f2d6d
WEBUI_TREE_SHA256=671a2a7a2c995f048077e7a140e6e39a895db5bdc2c968edeb7fff6e35b83676
# Production interpreter: the target uv.lock supports only python >= 3.14, so 3.11 (the pre-upgrade venv) is impossible.
PYTHON_VERSION=3.14.7
PYTHON_HOME=/home/gille/.hermes/tools/python-3.14.7+20260901-linux-x64
UV_BIN=/home/gille/.hermes/tools/uv-0.12.3-linux-x64/uv
# Target [all] no longer carries voice/telegram/edge-tts (lazy-install), so they are requested explicitly.
EXTRAS="cron pty mcp uvloop homeassistant sms acp google web youtube messaging voice edge-tts piper bedrock"
# Ordered patch sets (git apply, in this order). 27 supersedes the earlier candidates 24/25 (+fixes, +ported tests); 28 supersedes 26.
PATCHES_AGENT="27-hermes-carry.patch"
PATCHES_WEBUI="28-webui-carry.patch"
# Pre-upgrade baseline this replaces (rollback target): Hermes 0.20.5 @ 4c1f53be + 17 local entries, WebUI @ c67fd2dd + 4.
