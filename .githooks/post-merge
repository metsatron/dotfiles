#!/usr/bin/env bash
# Cross-harness post-merge scan: detect conflict markers in overlay dirs.
# Fires after any successful merge/pull regardless of caller (SSH, NFS, Telegram bot).
# A stash pop that produces conflicts does NOT fire post-merge (it exits non-zero),
# but git merge and git pull do — this catches the operations that succeed with markers.
set -euo pipefail
repo="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$repo"

unmerged="$(git ls-files -u 2>/dev/null | head -1)"
if [ -n "$unmerged" ]; then
  printf '\n!!! UNMERGED FILES DETECTED IN DOTCORTEX !!!\n' >&2
  printf 'The index contains unresolved conflicts. Every affected overlay file\n' >&2
  printf 'is symlinked into $HOME and is NOW BROKEN.\n\n' >&2
  git ls-files -u | awk '{print $4}' | sort -u | head -20 | sed 's/^/  /' >&2
  printf '\nResolve all conflicts or run: git merge --abort\n' >&2
fi

markers=""
for dir in all linux debian devuan x230 t480s t480 t1700 arch osx be navi termux s24; do
  [ -d "$dir" ] || continue
  found="$(grep -rl '^<<<<<<< \|^>>>>>>> ' "$dir" 2>/dev/null \
    | grep -v '\.local/straight/repos/' \
    | head -5)" || true
  [ -n "$found" ] && markers="${markers}${found}"$'\n'
done

if [ -n "$markers" ]; then
  printf '\n!!! CONFLICT MARKERS IN STOWED OVERLAY FILES !!!\n' >&2
  printf 'These files are symlinked into $HOME — scripts are BROKEN:\n' >&2
  printf '%s' "$markers" | head -20 | sed 's/^/  /' >&2
  printf '\nResolve conflicts in the .org source, retangle, and restow.\n' >&2
fi
