#!/usr/bin/env bash
# Git hook wrappers

# [[file:../agents-hooks.org::*Git hook wrappers][Git hook wrappers:1]]
#!/usr/bin/env bash
set -euo pipefail
repo="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
address_guard="${HOME}/.local/bin/dotcortex-address-guard"
[ -x "$address_guard" ] || address_guard="$repo/all/.local/bin/dotcortex-address-guard"
"$address_guard" --staged
identity_guard="${HOME}/.local/bin/dotcortex-identity-guard"
[ -x "$identity_guard" ] || identity_guard="$repo/all/.local/bin/dotcortex-identity-guard"
"$identity_guard" --staged
helper="${HOME}/.local/bin/dotcortex-git-guard"
[ -x "$helper" ] || helper="$repo/all/.local/bin/dotcortex-git-guard"
exec "$helper"
# Git hook wrappers:1 ends here
