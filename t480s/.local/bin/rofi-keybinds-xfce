#!/usr/bin/env bash
# Rofi launcher suite keybindings for XFCE (T480s). Binds the rofi menu suite via
# xfconf. Separate from workspace/sanctuary switching (xfce-sanctuary-shortcuts) —
# this is the menu/launcher concern (menu.org). Idempotent.
set -euo pipefail

if ! command -v xfconf-query >/dev/null 2>&1; then
  echo "xfconf-query not found; rofi XFCE keybindings cannot be configured" >&2
  exit 1
fi

# Tolerant helper: warn but do NOT exit if a mode script is missing, so a partial
# rollout still binds what exists. Delete-then-recreate forces xfwm4's regrab.
set_cmd() {  # $1=key literal (e.g. <Super>space)  $2=command value  $3=optional require-exec path
  local key="$1" val="$2" req="${3:-}"
  local p="/commands/custom/${key}"
  if [ -n "$req" ] && [ ! -x "$req" ]; then
    echo "  warn: ${p} → not executable yet: $req (binding anyway)" >&2
  fi
  xfconf-query -c xfce4-keyboard-shortcuts -p "$p" -r 2>/dev/null || true
  xfconf-query -c xfce4-keyboard-shortcuts -p "$p" -n -t string -s "$val"
  echo "  set: ${p} → ${val}"
}

echo "Configuring rofi launcher keybindings (XFCE)…"
set_cmd '<Super>space' "$HOME/.local/bin/rofi-launch"     "$HOME/.local/bin/rofi-launch"
set_cmd '<Alt>space'   "xfce4-appfinder"
set_cmd '<Super>x'     "$HOME/.local/bin/rofi-actions"    "$HOME/.local/bin/rofi-actions"
# Emoji is on Super+period (the Windows Win+. emoji reflex), not Super+b or Super+e:
# on SonicDE (Plasma) Meta+B is powerdevil's Switch Power Profile and Meta+E is
# Dolphin, so emoji uses . across the fleet to keep one key. Drop stale Super+b and
# Super+e commands from earlier runs so they stop shadowing the relocation.
xfconf-query -c xfce4-keyboard-shortcuts -p '/commands/custom/<Super>b' -r 2>/dev/null || true
xfconf-query -c xfce4-keyboard-shortcuts -p '/commands/custom/<Super>e' -r 2>/dev/null || true
set_cmd '<Super>period' "$HOME/.local/bin/rofi-emoji-menu" "$HOME/.local/bin/rofi-emoji-menu"
set_cmd '<Super>z'     "$HOME/.local/bin/clipmenu-rofi"   "$HOME/.local/bin/clipmenu-rofi"
set_cmd '<Super>m'     "$HOME/.local/bin/rofi-mpd"        "$HOME/.local/bin/rofi-mpd"
set_cmd '<Super>w'     "$HOME/.local/bin/rofi-window"     "$HOME/.local/bin/rofi-window"
# <Super>r ships as an XFCE *default* (/commands/default/<Super>r -> `xfce4-appfinder -c`).
# A /commands/custom/ entry at the same key takes precedence, so no removal is needed.
set_cmd '<Super>r'     "$HOME/.local/bin/rofi-run"        "$HOME/.local/bin/rofi-run"
# Drop the xfwm4 popup_menu_key on <Alt>space so it stops shadowing the new
# /commands/custom/<Alt>space appfinder launcher (the two-channel conflict).
xfconf-query -c xfce4-keyboard-shortcuts -p '/xfwm4/custom/<Alt>space' -r 2>/dev/null || true
echo "  removed: /xfwm4/custom/<Alt>space (popup_menu_key)"

echo "Done."
echo "      Super+space  -> rofi launcher (drun)"
echo "      Alt+space    -> xfce4-appfinder (relocated from Super+space)"
echo "      Super+x      -> rofi action menu (control panel)"
echo "      Super+period -> rofi emoji picker (rofimoji)"
echo "      Super+m      -> rofi mpd music menu (music.org daemon, NADA library)"
echo "      Super+z      -> clipmenu clipboard history"
echo "      Super+w      -> rofi window switcher"
echo "      Super+r      -> rofi run dialog"
