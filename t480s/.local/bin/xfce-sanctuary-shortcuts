#!/usr/bin/env bash
# Set Super+1/2/3 → workspace 1/2/3 in XFWM4 (T480s XFCE).
# Additive: existing Ctrl+F1/F2 shortcuts are preserved.
set -euo pipefail

if ! command -v xfconf-query >/dev/null 2>&1; then
  echo "xfconf-query not found; XFCE keyboard shortcuts cannot be configured" >&2
  exit 1
fi

set_shortcut() {
  local action="$1" key="$2"
  if xfconf-query -c xfwm4 -p "/general/${action}" >/dev/null 2>&1; then
    xfconf-query -c xfwm4 -p "/general/${action}" -t string -s "${key}"
  else
    xfconf-query -c xfwm4 -p "/general/${action}" -n -t string -s "${key}"
  fi
  echo "  set: ${action} → ${key}"
}

# Clean up any stale /custom/ entries from the previous (wrong) schema
for k in '<Super>1' '<Super>2' '<Super>3'; do
  xfconf-query -c xfwm4 -p "/custom/${k}" -r 2>/dev/null || true
done

echo "Configuring Virtual Habitat workspace shortcuts…"
set_shortcut workspace_1_key '<Super>1'
set_shortcut workspace_2_key '<Super>2'
set_shortcut workspace_3_key '<Super>3'
echo "Done. Super+1 → Desktop 1 (sanctuary-qtile)"
echo "      Super+2 → Desktop 2 (sanctuary-gnustep)"
echo "      Super+3 → Desktop 3 (sanctuary-cde)"
