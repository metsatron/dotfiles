#!/usr/bin/env bash
# Set Super+1/2/3/4 → workspace 1/2/3/4 in XFWM4 (T480s XFCE).
# Layout: Desktop 1 = normal, Desktop 2/3/4 = sanctuaries (qtile/gnustep/cde).
# Additive: existing Ctrl+F1/F2 shortcuts are preserved.
set -euo pipefail

if ! command -v xfconf-query >/dev/null 2>&1; then
  echo "xfconf-query not found; XFCE keyboard shortcuts cannot be configured" >&2
  exit 1
fi

set_shortcut() {
  local n="$1"
  local p="/xfwm4/custom/<Super>${n}"
  # Delete-then-recreate unconditionally. A plain `-s` to an already-correct value is a
  # no-op that xfconf suppresses — no change-notify fires, so xfwm4 never re-runs its
  # ungrab/regrab pass. When a passive grab silently failed to register at an earlier
  # regrab (the long-standing Super+4 failure: config correct, XGrabKey never placed),
  # a no-op write can never recover it. Removing the property and recreating it forces a
  # change-notify → full xfwm4 keyboard regrab, which re-places every grab from scratch.
  xfconf-query -c xfce4-keyboard-shortcuts -p "${p}" -r 2>/dev/null || true
  xfconf-query -c xfce4-keyboard-shortcuts -p "${p}" -n -t string -s "workspace_${n}_key"
  echo "  set: ${p} → workspace_${n}_key"
}

# Clean up stale entries from previous wrong schemas (xfwm4 channel)
for k in 1 2 3 4; do
  xfconf-query -c xfwm4 -p "/custom/<Super>${k}" -r 2>/dev/null || true
  xfconf-query -c xfwm4 -p "/general/workspace_${k}_key" -r 2>/dev/null || true
done

echo "Configuring Virtual Habitat workspace shortcuts…"
set_shortcut 1
set_shortcut 2
set_shortcut 3
set_shortcut 4
if [ -x "$HOME/.local/bin/kitty" ]; then
  if xfconf-query -c xfce4-keyboard-shortcuts -p "/commands/custom/<Super>t" >/dev/null 2>&1; then
    xfconf-query -c xfce4-keyboard-shortcuts -p "/commands/custom/<Super>t" -t string -s "$HOME/.local/bin/kitty"
  else
    xfconf-query -c xfce4-keyboard-shortcuts -p "/commands/custom/<Super>t" -n -t string -s "$HOME/.local/bin/kitty"
  fi
  echo "  set: /commands/custom/<Super>t → $HOME/.local/bin/kitty"
else
  echo "kitty not executable at $HOME/.local/bin/kitty" >&2
  exit 1
fi
if [ -x "$HOME/.local/bin/whisper-hotkey" ]; then
  if xfconf-query -c xfce4-keyboard-shortcuts -p "/commands/custom/<Super>c" >/dev/null 2>&1; then
    xfconf-query -c xfce4-keyboard-shortcuts -p "/commands/custom/<Super>c" -t string -s "$HOME/.local/bin/whisper-hotkey"
  else
    xfconf-query -c xfce4-keyboard-shortcuts -p "/commands/custom/<Super>c" -n -t string -s "$HOME/.local/bin/whisper-hotkey"
  fi
  echo "  set: /commands/custom/<Super>c → $HOME/.local/bin/whisper-hotkey"
else
  echo "whisper-hotkey not executable at $HOME/.local/bin/whisper-hotkey" >&2
  exit 1
fi
if [ -x "$HOME/.local/bin/pclip-toggle" ]; then
  if xfconf-query -c xfce4-keyboard-shortcuts -p "/commands/custom/<Super>v" >/dev/null 2>&1; then
    xfconf-query -c xfce4-keyboard-shortcuts -p "/commands/custom/<Super>v" -t string -s "$HOME/.local/bin/pclip-toggle"
  else
    xfconf-query -c xfce4-keyboard-shortcuts -p "/commands/custom/<Super>v" -n -t string -s "$HOME/.local/bin/pclip-toggle"
  fi
  echo "  set: /commands/custom/<Super>v → $HOME/.local/bin/pclip-toggle"
else
  echo "pclip-toggle not executable at $HOME/.local/bin/pclip-toggle" >&2
  exit 1
fi

# --- Rofi launcher suite (Super+space/x/b/z, Alt+space) ---
# Tolerant helper: warn but do NOT exit if a mode script is missing (unlike the
# kitty/whisper/pclip guards above), so a partial rollout still binds what exists.
# Delete-then-recreate forces xfwm4's regrab, same rationale as the workspace keys.
set_cmd() {  # $1=key literal (e.g. <Super>space)  $2=command value  $3=optional require-exec path
  local key="$1" val="$2" req="${3:-}"
  local p="/commands/custom/${key}"
  if [ -n "$req" ] && [ ! -x "$req" ]; then
    echo "  warn: ${p} → not executable yet: $req (binding anyway)" >&2
  fi
  xfconf-query -c xfce4-keyboard-shortcuts -p "$p" -r 2>/dev/null || true
  xfconf-query -c xfce4-keyboard-shortcuts -p "$p" -n -t string -s "$val"
  echo "  set: ${p} → ${val}"
}
set_cmd '<Super>space' "$HOME/.local/bin/rofi-launch"     "$HOME/.local/bin/rofi-launch"
set_cmd '<Alt>space'   "xfce4-appfinder"
set_cmd '<Super>x'     "$HOME/.local/bin/rofi-actions"    "$HOME/.local/bin/rofi-actions"
set_cmd '<Super>b'     "$HOME/.local/bin/rofi-emoji-menu" "$HOME/.local/bin/rofi-emoji-menu"
set_cmd '<Super>z'     "$HOME/.local/bin/clipmenu-rofi"   "$HOME/.local/bin/clipmenu-rofi"
set_cmd '<Super>w'     "$HOME/.local/bin/rofi-window"     "$HOME/.local/bin/rofi-window"
# Drop the xfwm4 popup_menu_key on <Alt>space so it stops shadowing the new
# /commands/custom/<Alt>space appfinder launcher (the two-channel conflict).
xfconf-query -c xfce4-keyboard-shortcuts -p '/xfwm4/custom/<Alt>space' -r 2>/dev/null || true
echo "  removed: /xfwm4/custom/<Alt>space (popup_menu_key)"

echo "Done. Super+1 → Desktop 1 (normal)"
echo "      Super+2 → Desktop 2 (sanctuary-qtile)"
echo "      Super+3 → Desktop 3 (sanctuary-gnustep)"
echo "      Super+4 → Desktop 4 (sanctuary-cde)"
echo "      Super+t → kitty"
echo "      Super+c → whisper-hotkey (toggle mic capture, transcribe, paste)"
echo "      Super+v → pclip-toggle (speak clipboard; press again to cancel)"
echo "      Super+space → rofi launcher (drun)"
echo "      Alt+space   → xfce4-appfinder (relocated from Super+space)"
echo "      Super+x     → rofi action menu (control panel)"
echo "      Super+b     → rofi emoji picker (rofimoji)"
echo "      Super+z     → clipmenu clipboard history"
echo "      Super+w     → rofi window switcher"
