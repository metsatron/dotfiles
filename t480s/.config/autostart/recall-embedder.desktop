[Desktop Entry]
Type=Application
Name=Recall embedder
Exec=bash -c 'for _ in $(seq 1 60); do if [ -x "$HOME/mnt/x230/HelmCortex/FORGE/bin/recall" ]; then exec "$HOME/mnt/x230/HelmCortex/FORGE/bin/recall" embedder start >/dev/null 2>&1; fi; sleep 2; done'
Hidden=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
