#!/usr/bin/env bash
# T480 as server: setup script
# Run on T480 after =tangle-one nfs.org && loom stow:openmandriva=.


# [[file:../../../nfs.org::*T480 as server: setup script][T480 as server: setup script:1]]
set -euo pipefail

CONF="${HOME}/.local/share/dotcortex/nfs"
NFS_ENV="${CONF}/nfs.env"
HOSTS_FRAG="${CONF}/hosts-nfs-server.conf"
EXPORTS_FRAG="${CONF}/exports-server.conf"
MARKER_START="# BEGIN DOTCORTEX-NFS"
MARKER_END="# END DOTCORTEX-NFS"

die() { printf 'nfs-server-setup: %s\n' "$*" >&2; exit 1; }

[ -f "$NFS_ENV" ] || die "missing $NFS_ENV — copy: cp ${CONF}/nfs.env.template $NFS_ENV and fill in IPs"
# shellcheck source=/dev/null
source "$NFS_ENV"

[ -f "$EXPORTS_FRAG" ] || die "missing $EXPORTS_FRAG — run: tangle-one nfs.org && loom stow:openmandriva"

# Generate hosts fragment from env — IPs are never stored in the repo
cat > "$HOSTS_FRAG" <<EOF
# T480 NFS clients — generated from nfs.env, do not edit manually
${T480S_TS_IP}   t480s
${X230_TS_IP}   x230
EOF

inject_block() {
  local target="$1" src="$2"
  local tmp
  tmp="$(mktemp)"
  if grep -qF "$MARKER_START" "$target" 2>/dev/null; then
    awk "/^${MARKER_START}$/{skip=1} !skip{print} /^${MARKER_END}$/{skip=0}" \
      "$target" > "$tmp"
  else
    cat "$target" > "$tmp" 2>/dev/null || true
  fi
  { printf '\n%s\n' "$MARKER_START"; cat "$src"; printf '%s\n' "$MARKER_END"; } >> "$tmp"
  sudo cp "$tmp" "$target"
  rm -f "$tmp"
}

echo "[1/5] nfs-utils..."
rpm -q nfs-utils &>/dev/null || sudo dnf install -y nfs-utils

echo "[2/5] /etc/hosts (client aliases)..."
inject_block /etc/hosts "$HOSTS_FRAG"

echo "[3/5] /etc/exports..."
sudo touch /etc/exports
inject_block /etc/exports "$EXPORTS_FRAG"

echo "[4/5] exportfs -ra..."
sudo exportfs -ra
sudo exportfs -v

echo "[5/5] nfs-server service..."
sudo systemctl enable --now nfs-server

echo
echo "=== T480 NFS server ready ==="
sudo exportfs -v
# T480 as server: setup script:1 ends here
