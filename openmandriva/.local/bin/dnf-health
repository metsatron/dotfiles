#!/usr/bin/env bash
# Health script

# [[file:../../../package-dnf.org::*Health script][Health script:1]]
set -euo pipefail

echo "=== dnf:health ==="
echo

if [ -f /etc/os-release ]; then
  # shellcheck disable=SC1091
  . /etc/os-release
  echo "OS:    ${PRETTY_NAME:-$ID}"
fi

if command -v dnf >/dev/null 2>&1; then
  echo "DNF:   $(dnf --version | head -1)"
else
  echo "DNF:   not installed"
fi

echo "RPM:   $(rpm --version)"

MAN="${DNF_SSV:-$HOME/.dnf/manifest/packages.ssv}"
if [ -f "$MAN" ]; then
  manifest_count=$(awk -v FS='[ \t]+' '!/^[ \t]*#/ && NF { c++ } END { print c+0 }' "$MAN")
  echo "SSV:   $manifest_count packages in manifest"
else
  echo "SSV:   no manifest found at $MAN"
fi

if command -v dnf >/dev/null 2>&1; then
  echo
  echo "Repos:"
  dnf repolist --enabled
fi
# Health script:1 ends here
