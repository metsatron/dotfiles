# Full mesh peer mounts — via tailscale
/home/YOUR_USERNAME/mnt/x230   -fstype=nfs4,rsize=131072,wsize=131072,async,noatime,soft,timeo=10,retrans=1,intr  x230:/home/YOUR_USERNAME
/home/YOUR_USERNAME/mnt/t480s  -fstype=nfs4,rsize=131072,wsize=131072,async,noatime,soft,timeo=10,retrans=1,intr  t480s:/home/YOUR_USERNAME
/home/YOUR_USERNAME/mnt/t480   -fstype=nfs4,rsize=131072,wsize=131072,async,noatime,soft,timeo=10,retrans=1,intr  t480:/home/YOUR_USERNAME
