[Desktop Entry]
Type=Application
Name=Recall embedder
Exec=bash -c 'for _ in $(seq 1 60); do h="$(tailscale ip -4 2>/dev/null | grep -m1 -E "^[0-9.]+$")"; if [ -n "$h" ]; then exec env RECALL_BIND_HOST="$h" "$HOME/HelmCortex/FORGE/bin/recall" embedder start >/dev/null 2>&1; fi; sleep 2; done'
Hidden=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
