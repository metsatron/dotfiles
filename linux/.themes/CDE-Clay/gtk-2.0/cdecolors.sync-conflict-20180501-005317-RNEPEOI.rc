gtk-color-scheme = "base_color:#968282\nfg_color:#000000\ntooltip_fg_color:#000000\nselected_bg_color:#7f6e6e\nselected_fg_color:#000000\ntext_color:#000000\nbg_color:#968282\ninsensitive_bg_color:#7f6e6e\ntooltip_bg_color:#7f6e6e"
    
style "cde_style_1"
{
    fg[NORMAL]  ="#ffffff"
    bg[NORMAL]  ="#ffaaaa"
    text[NORMAL]="#ffffff"
    base[NORMAL]="#ffaaaa"

    fg[ACTIVE]  ="#ffffff"
    bg[ACTIVE]  ="#d99191"
    text[ACTIVE]="#ffffff"
    base[ACTIVE]="#d99191"

    fg[PRELIGHT]="#ffffff"
    bg[PRELIGHT]="#ffaaaa"
    text[PRELIGHT]="#ffffff"
    base[PRELIGHT] ="#ffaaaa"

    fg[SELECTED]="#ffaaaa"
    bg[SELECTED]="#ffffff"
    text[SELECTED]="#ffaaaa"
    base[SELECTED]="#ffffff"

    #this is the dark color of the etched in insensitive text when on normal background of widget
    fg[INSENSITIVE]="#895b5b"
    bg[INSENSITIVE]="#ffaaaa"
    #insensitive text color in entry and also fg color of etched in text in combo box
    text[INSENSITIVE]="#895b5b"
    #in cde this is normal bg color
    base[INSENSITIVE]="#ffaaaa"
}

