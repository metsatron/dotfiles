gtk-color-scheme = "base_color:#b4aa94\nfg_color:#000000\ntooltip_fg_color:#000000\nselected_bg_color:#99907e\nselected_fg_color:#000000\ntext_color:#000000\nbg_color:#b4aa94\ninsensitive_bg_color:#99907e\ntooltip_bg_color:#99907e"
    
style "cde_style_1"
{
    fg[NORMAL]  ="#ffffff"
    bg[NORMAL]  ="#da9a68"
    text[NORMAL]="#ffffff"
    base[NORMAL]="#da9a68"

    fg[ACTIVE]  ="#ffffff"
    bg[ACTIVE]  ="#ba8359"
    text[ACTIVE]="#ffffff"
    base[ACTIVE]="#ba8359"

    fg[PRELIGHT]="#ffffff"
    bg[PRELIGHT]="#da9a68"
    text[PRELIGHT]="#ffffff"
    base[PRELIGHT] ="#da9a68"

    fg[SELECTED]="#da9a68"
    bg[SELECTED]="#ffffff"
    text[SELECTED]="#da9a68"
    base[SELECTED]="#ffffff"

    #this is the dark color of the etched in insensitive text when on normal background of widget
    fg[INSENSITIVE]="#755338"
    bg[INSENSITIVE]="#da9a68"
    #insensitive text color in entry and also fg color of etched in text in combo box
    text[INSENSITIVE]="#755338"
    #in cde this is normal bg color
    base[INSENSITIVE]="#da9a68"
}

