[Unit]
Description=MailCortex private Syncthing transport
Documentation=man:syncthing(1)
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
ExecStart=/usr/bin/syncthing serve --home=%h/.config/mailcortex/syncthing --no-browser --no-upgrade --no-restart --no-default-folder
Restart=on-failure
RestartSec=10
SuccessExitStatus=3 4

[Install]
WantedBy=default.target
