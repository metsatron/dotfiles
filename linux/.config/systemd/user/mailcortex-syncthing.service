[Unit]
Description=MailCortex private Syncthing transport
Documentation=man:syncthing(1)
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
ExecStart=%h/.local/bin/mailcortex-syncthing-service --run
Restart=on-failure
RestartSec=10
SuccessExitStatus=3 4

[Install]
WantedBy=default.target
