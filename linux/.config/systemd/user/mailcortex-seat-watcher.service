[Unit]
Description=MailCortex idle seat watcher
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
ExecStart=%h/.local/bin/mailcortex-seat-watcher-service --run
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=2

[Install]
WantedBy=default.target
