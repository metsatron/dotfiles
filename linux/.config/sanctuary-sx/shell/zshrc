# Godzilla XS-86000 sanctuary zsh rc — Human68k drive-letter shell identity.
# Shared sanctuary grammar: symlinked to ~/.zshrc by sanctuary-sx-launch. Sources the
# global DotCortex zshrc FIRST so global aliases/functions survive, THEN applies the
# sanctuary prompt — the global ~/DotCortex/all/.zshrc is never edited.
HISTFILE=~/.histfile
HISTSIZE=1000
SAVEHIST=1000
[ -f "${HOME}/DotCortex/all/.zshrc" ] && source "${HOME}/DotCortex/all/.zshrc"

# Map the Unix path to a Human68k drive path. zsh's ${//} mangles a literal backslash
# replacement, so a backslash variable is used. (Tested 2026-07-15.)
_godzilla_xs_dospath() {
  local p="${PWD}" rel bs=$'\\'
  if [[ "${p}" == "${HOME}" ]]; then
    printf 'A:%s' "${bs}"
  elif [[ "${p}" == "${HOME}/"* ]]; then
    rel="${p#${HOME}/}"; rel="${rel//\//${bs}}"; printf 'A:%s%s' "${bs}" "${rel}"
  else
    rel="${p#/}"; rel="${rel//\//${bs}}"; printf 'C:%s%s' "${bs}" "${rel}"
  fi
}
setopt PROMPT_SUBST
PROMPT='ZSH $(_godzilla_xs_dospath)> '

# First interactive shell in each terminal: open at HOME, print the boot banner.
if [[ -z "${GODZILLA_XS_SHELL_INIT:-}" ]]; then
  export GODZILLA_XS_SHELL_INIT=1
  cd "${HOME}" 2>/dev/null || true
  printf '\033[97mGodzilla XS-86000 \302\267 Human68k v3.02\033[0m\n'
fi
