{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "none"
    },
    "display": {
        "separator": ""
    },
    "modules": [
        { "type": "custom", "format": "\u001b[37mGODZILLA XS-86000 SYSTEM DRIVER version 0.86" },
        { "type": "custom", "format": "\u001b[37mSHARP / NEC / FUJITSU / ARCADE COMPATIBILITY BUS" },
        { "type": "custom", "format": "" },
        { "type": "custom", "format": "\u001b[37mRS-232C DRIVER for XS-86000 version 2.02" },
        { "type": "custom", "format": "\u001b[37mAUX0 から AUX5 のデバイスで通信が可能です" },
        { "type": "custom", "format": "" },
        { "type": "custom", "format": "\u001b[37m日本語フロントプロセッサ ASK68K for XS-86000 version 3.02" },
        { "type": "custom", "format": "\u001b[37mCopyright 1987-2026 SHARP Corp. / ACCESS Co., LTD." },
        { "type": "custom", "format": "" },
        { "type": "custom", "format": "\u001b[37mX68k FD driver extension version 1.00" },
        { "type": "custom", "format": "\u001b[37m2DD / 2HD / PC-98 / FM TOWNS media access ready" },
        { "type": "custom", "format": "" },
        { "type": "custom", "format": "\u001b[37mConsole/Graphic IOCS Version 1.50" },
        { "type": "custom", "format": "\u001b[37mCPS-1 / CPS-2 / CPS-3 / MVS compatibility enabled" },
        { "type": "custom", "format": "" },
        { "type": "custom", "format": "\u001b[37mA:\\>SYSINFO /W" },
        { "type": "custom", "format": "" },
        { "type": "custom", "format": "\u001b[37m Volume has no label.     GODZILLA XS-86000" },
        { "type": "custom", "format": "\u001b[37m \u001b[90m----------------------------------------------------------------" },
        { "type": "host",        "key": "  Host",        "keyColor": "white", "keyWidth": 13 },
        { "type": "kernel",      "key": "  Kernel",      "keyColor": "white", "keyWidth": 13 },
        { "type": "cpu",         "key": "  CPU",         "keyColor": "white", "keyWidth": 13 },
        { "type": "gpu",         "key": "  GPU",         "keyColor": "white", "keyWidth": 13 },
        { "type": "display",     "key": "  Display",     "keyColor": "white", "keyWidth": 13 },
        { "type": "memory",      "key": "  Memory",      "keyColor": "white", "keyWidth": 13 },
        { "type": "uptime",      "key": "  Uptime",      "keyColor": "white", "keyWidth": 13 },
        { "type": "shell",       "key": "  Shell",       "keyColor": "white", "keyWidth": 13 },
        { "type": "de",          "key": "  Desktop",     "keyColor": "white", "keyWidth": 13 },
{ "type": "wm",          "key": "  WM",          "keyColor": "white", "keyWidth": 13 },
        { "type": "command",     "key": "  Habitat",     "keyColor": "white", "keyWidth": 13, "text": "[ -f /run/.containerenv ] && echo \"Sanctuary (Distrobox)\" || ( [ -d /sys/hypervisor ] && grep -q . /sys/hypervisor/type 2>/dev/null && echo Enclave ) || echo Baremetal" },
        { "type": "command",     "key": "  Substrate",   "keyColor": "white", "keyWidth": 13, "text": "[ -d /gnu/store ] && echo Guix || echo Unknown" },
        { "type": "command",     "key": "  Layer",       "keyColor": "white", "keyWidth": 13, "text": "echo Xephyr ${DISPLAY}" },
        { "type": "custom", "format": "\u001b[37m \u001b[90m----------------------------------------------------------------" },
        { "type": "custom", "format": "\u001b[37m X68 BUS     \u001b[91mREADY                        \u001b[37mPC-98 BUS  \u001b[91mREADY" },
        { "type": "custom", "format": "\u001b[37m PC-88 BUS   \u001b[91mREADY                        \u001b[37mFM TOWNS   \u001b[91mREADY" },
        { "type": "custom", "format": "\u001b[37m ARCADE BUS  \u001b[91mREADY                        \u001b[37mWINE BOARD \u001b[91mREADY" },
        { "type": "custom", "format": "" },
        { "type": "custom", "format": "\u001b[37m A:\\>STATUS" },
        { "type": "custom", "format": "\u001b[92m ALL SYSTEMS EXCESSIVE" }
    ]
}
