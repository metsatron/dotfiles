{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "Windows 95",
        "padding": { "top": 1, "right": 4 }
    },
    "display": { "separator": "" },
    "modules": [
        {"type": "custom", "format": "\u001b[37mC:\\> SYSINFO /ARCH"},
        {"type": "custom", "format": "\u001b[37m Volume in drive C is \u001b[97mREDSTONE-9X"},
        {"type": "custom", "format": "\u001b[90m -------------------------------------------------------"},
        {"type": "host", "key": "  Machine", "keyColor": "white", "keyWidth": 12},
        {"type": "kernel", "key": "  Kernel", "keyColor": "white", "keyWidth": 12},
        {"type": "cpu", "key": "  CPU", "keyColor": "white", "keyWidth": 12},
        {"type": "memory", "key": "  Memory", "keyColor": "white", "keyWidth": 12},
        {"type": "uptime", "key": "  Uptime", "keyColor": "white", "keyWidth": 12},
        {"type": "shell", "key": "  Shell", "keyColor": "white", "keyWidth": 12},
        {"type": "wm", "key": "  Shell UI", "keyColor": "white", "keyWidth": 12},
        {"type": "custom", "format": "\u001b[90m -------------------------------------------------------"},
        {"type": "command", "key": "  Host OS", "keyColor": "white", "keyWidth": 12, "text": ". /run/host/etc/os-release 2>/dev/null && printf '%s' \"$PRETTY_NAME\" || printf 'Unknown'"},
        {"type": "command", "key": "  DotCortex", "keyColor": "white", "keyWidth": 12, "text": "printf '%s' 'literate dotfiles \u2192 tangle \u2192 stow \u2192 $HOME'"},
        {"type": "command", "key": "  Habitat", "keyColor": "white", "keyWidth": 12, "text": "[ -f /run/.containerenv ] && printf 'Sanctuary (Distrobox)' || printf 'Baremetal'"},
        {"type": "command", "key": "  Substrate", "keyColor": "white", "keyWidth": 12, "text": "[ -d /gnu/store ] && printf 'Guix' || printf 'Unknown'"},
        {"type": "command", "key": "  Layer", "keyColor": "white", "keyWidth": 12, "text": "printf 'Xephyr %s' \"${DISPLAY:-?}\""},
        {"type": "custom", "format": "\u001b[90m -------------------------------------------------------"},
        {"type": "custom", "format": "\u001b[37m SOUND BLASTER 16  \u001b[92mREADY  \u001b[37mVESA SVGA  \u001b[92mREADY"},
        {"type": "custom", "format": "\u001b[37m WINE BOARD        \u001b[92mREADY  \u001b[37mDIRECTX    \u001b[92mREADY"},
        {"type": "custom", "format": "\u001b[37m MSCDEX CD-ROM     \u001b[92mREADY  \u001b[37mNETWORK    \u001b[92mREADY"},
        {"type": "custom", "format": "\u001b[37mC:\\> WIN"},
        {"type": "custom", "format": "\u001b[97mStarting Redstone 9X..."}
    ]
}
