#=============================================================================#
#
# .fvwm95rc example configuration file for fvwm95-2.0.43a
# (with enhanced FvwmTaskBar)
#
# This is a Win95-themed configuration for Redstone 9X.
# Based on the upstream sample config from mintsuki/fvwm95.
#
#=============================================================================#


#------------------------------------------------------------------------------
# Fonts — exact XLFDs from Xephyr built-in font set; tested working
#------------------------------------------------------------------------------

WindowFont	-adobe-helvetica-bold-r-normal--14-100-100-100-p-82-iso10646-1
IconFont	fixed
MenuFont   	-adobe-helvetica-medium-r-normal--14-100-100-100-p-76-iso10646-1


#------------------------------------------------------------------------------
# Set the default window colors. The syntax is:
#  DefaultColors winforecolor winbackcolor titleforecolor titlebackcolor
#------------------------------------------------------------------------------

DefaultColors   Black #c0c0c0 #c0c0c0 #808080


#------------------------------------------------------------------------------
# Text and background color for the title bar of the active (selected) window
#------------------------------------------------------------------------------

HilightColors   White #000080


#------------------------------------------------------------------------------
# Text and background color for the title bar of sticky windows
#------------------------------------------------------------------------------

StickyColors    #808080 #008080

# You can also use the Style command to set the colors of individual
# title bars of some non-selected windows
#Style "*" ForeColor yellow
#Style "*" BackColor #808080

#=============================================================================#
#
# Set up the major operating modes
#
#=============================================================================#


# If we use the FvwmTaskBar we don't need the icons :-)
# Style "..." Icon is also commented below.


Style "*" NoIcon
Style "*" ClickToFocus
Style "*" MWMFunctions
Style "*" HintOverride
Style "*" MWMDecor
Style "*" OLDecor

OpaqueMoveSize 10
EdgeScroll 100 100
EdgeResistance 800 100

#
# RandomPlacement prevents user interaction while placing windows
# SmartPlacement attempts to place windows 'intelligently'
# Using both can be interesting
#
 Style "*" RandomPlacement, SmartPlacement


#------------------------------------------------------------------------------
# NoPPosition instructs fvwm to ignore the PPosition field in window
# geometry hints. Emacs annoyingly sets PPosition to (0,0)!
#------------------------------------------------------------------------------

# Style "*" NoPPosition


#------------------------------------------------------------------------------
#
# Set the desk top size in units of physical screen size
#
#------------------------------------------------------------------------------

DeskTopSize 2x2



#=============================================================================#
# Module path and Icon paths
# These paths are colon-separated lists, just like regular unix PATH
#=============================================================================#

# FVWM95 compiled with correct --prefix; compiled-in defaults work.
# Added explicit PixmapPath so menu/titlebar icons resolve.
PixmapPath $HOME/.local/fvwm95/lib/X11/icons

#=============================================================================#
# Set the decoration styles and window options
# Order is important!!!!
# If compatible styles are set for a single window in multiple Style
# commands, then the styles are ORed together. If conflicting styles
# are set, the last one specified is used.
# These commands should command before any menus or functions are defined,
# and before the internal pager is started.
#=============================================================================#


#------------------------------------------------------------------------------
# Default border and handle widths - and then some style definitions
#------------------------------------------------------------------------------

Style "*" BorderWidth 2, HandleWidth 4

Style "Fvwm*"        NoTitle, Sticky, WindowListSkip
Style "FvwmPager"    Title, Sticky, WindowListHit
Style "FvwmPager"    StaysOnTop, NoHandles
Style "FvwmTalk"     Title, WindowListHit
Style "FvwmConsole"  Title, WindowListHit
Style "FvwmBanner"   StaysOnTop

# xclass desktop manager (desktop-0.3.4) — borderless, no titlebar, sticky
Style "Desktop"      NoTitle, NoHandles, Sticky, WindowListSkip, CirculateSkip, BorderWidth 0

# Audacious music player — borderless panel style
Style "audacious"    NoTitle, NoHandles, Sticky, BorderWidth 0


Style "*lock"        NoTitle, NoHandles, Sticky, WindowListSkip
Style "xbiff"        NoTitle,            Sticky, WindowListSkip
Style "xsysinfo"     NoTitle,            Sticky, WindowListSkip
Style "xload"        NoTitle,            Sticky, WindowListSkip,RandomPlacement
Style "xconsole"                         Sticky, StartIconic
Style "xpostit"                                  WindowListSkip
Style "PostitNote"                               WindowListSkip
Style "Postit"       NoHandles,                  WindowListSkip



#------------------------------------------------------------------------------
# Some mini-icons for the title bar
#------------------------------------------------------------------------------

Style "*"         	TitleIcon mini-x2.xpm
Style "*xterm*"   	TitleIcon mini-term.xpm
Style "rxvt"      	TitleIcon mini-term.xpm
Style "redstone-calc"	TitleIcon mini-calc.xpm
Style "xsession"  	TitleIcon mini-bx2.xpm
Style "xv"        	TitleIcon mini-xv.xpm
Style "Netscape"  	TitleIcon mini-nscape.xpm
Style "xmag"      	TitleIcon mini-zoom.xpm
Style "textedit"  	TitleIcon mini-edit.xpm
Style "*emacs*"	  	TitleIcon mini-edit.xpm
Style "tkps"      	TitleIcon mini-run.xpm
Style "Ghostview" 	TitleIcon mini-gv.xpm
Style "gv*"	 	TitleIcon mini-gv.xpm
Style "Xcolorsel" 	TitleIcon mini-colors.xpm
Style "IDL*"      	TitleIcon mini-zoom.xpm
Style "xeyes"     	TitleIcon mini-eyes.xpm
Style "*fm*"      	TitleIcon mini-filemgr.xpm
Style "FileRunner"	TitleIcon mini-ofolder.xpm
Style "The GIMP"  	TitleIcon mini-wilber.xpm
Style "Scilab"    	TitleIcon mini-fractal.xpm
Style "thot"      	TitleIcon mini-pencil.xpm
Style "LyX"      	TitleIcon mini-pencil.xpm
# xman resource names
Style "topBox"    	TitleIcon mini-book1.xpm
Style "help"      	TitleIcon mini-book2.xpm
Style "manualBrowser" 	TitleIcon mini-book2.xpm
# xpaint resource names
Style "xpaint"   	TitleIcon mini-paint.xpm
Style "Canvas"   	TitleIcon mini-paint.xpm
Style "fatbits" 	TitleIcon mini-paint.xpm
Style "filebrowser"	TitleIcon mini-ofolder.xpm
# Fox
Style "Explorer"     	TitleIcon explorer.xpm
Style "Run"     	TitleIcon run1616.xpm
Style "Notepad"     	TitleIcon mini.text.xpm
Style "*onyx*"         TitleIcon onyx1616.xpm
# others...
Style "FvwmPager"    	TitleIcon mini-pager.xpm
Style "XDbx"         	TitleIcon mini-bug2.xpm
Style "Workman"      	TitleIcon mini-cd.xpm
Style "*playcd*"      	TitleIcon mini-cd.xpm
Style "*cdplay*"      	TitleIcon mini-cd.xpm
Style "Mail"         	TitleIcon mini-mail.xpm
Style "*mail*"         TitleIcon mini-mail.xpm
Style "xmh"            TitleIcon mini-mail.xpm
Style "AcroRead"     	TitleIcon mini-pdf.xpm
Style "NcFtp"        	TitleIcon mini-ftp.xpm
Style "XbmBrowser"   	TitleIcon mini-paint.xpm
Style "Bitmap"       	TitleIcon mini-paint.xpm
Style "Pixmap"       	TitleIcon mini-paint.xpm
Style "XClipboard"   	TitleIcon mini-clipboard.xpm
Style "control-panel"  	TitleIcon mini-redhat.xpm
Style "*console*"  	TitleIcon mini-display.xpm


#=============================================================================#
#
# Stuff to do at start-up and on restart
#
#=============================================================================#


DestroyFunc "InitFunction"
AddToFunc "InitFunction"    "I" Exec desktop
+                           "I" Exec sleep 0.3
+                           "I" Module FvwmBanner
+                           "I" Module FvwmWharf QuickLaunch
+                           "I" Module FvwmTaskBar

DestroyFunc "RestartFunction"
AddToFunc "RestartFunction" "I" Module FvwmTaskBar
+                           "I" Module FvwmWharf QuickLaunch


#============================================================================#
#
# Now define some handy complex functions
#
#============================================================================#

#------------------------------------------------------------------------------
# This one moves and then raises the window if you drag the mouse,
# only raises the window if you click, or does a vertical maximize if
# you double click (full screen maximize would be 'Maximize 100 100')
#------------------------------------------------------------------------------

DestroyFunc "Move-or-Raise"
AddToFunc "Move-or-Raise" "M" Move
+                         "M" Raise
+                         "C" Raise
+                         "D" Maximize 100 96



#------------------------------------------------------------------------------
# This one moves and then lowers the window if you drag the mouse,
# only lowers the window if you click, or does a RaiseLower if you double
# click
#------------------------------------------------------------------------------

DestroyFunc "Move-or-Lower"
AddToFunc "Move-or-Lower" "M" Move
+                         "M" Lower
+                         "C" Lower
+                         "D" RaiseLower


#------------------------------------------------------------------------------
# This one moves or (de)iconifies:
#------------------------------------------------------------------------------

DestroyFunc "Move-or-Iconify"
AddToFunc "Move-or-Iconify" "M" Move
+                           "D" Iconify

#------------------------------------------------------------------------------
# This one maximizes vertically if you click (leaving room for the taskbar
# at the bottom, or does a full maximization if you double click, or a
# true full vertical maximization if you just hold the mouse button down.
#------------------------------------------------------------------------------


DestroyFunc "Maximize-Func"
AddToFunc "Maximize-Func" "M"	Maximize 0 96
+ 			  "C"	Maximize 0 100
+ 			  "D"	Maximize 100 96

#------------------------------------------------------------------------------
# This one resizes and then raises the window if you drag the mouse,
# only raises the window if you click,  or does a RaiseLower if you double
# click
#------------------------------------------------------------------------------

DestroyFunc "Resize-or-Raise"
AddToFunc "Resize-or-Raise" "M" Resize
+                           "M" Raise
+                           "C" Raise
+                           "D" RaiseLower


#------------------------------------------------------------------------------
# This one focuses and then 'warps' to the center of the window.
#------------------------------------------------------------------------------


DestroyFunc "FocusAndWarp"
AddToFunc FocusAndWarp "I" Focus
+                      "I" WarpToWindow 50 50


#------------------------------------------------------------------------------
# Like the precedent, but de-iconifies first.
#------------------------------------------------------------------------------

DestroyFunc "DeiconifyFocusAndWarp"
AddToFunc DeiconifyFocusAndWarp "I" Iconify -1
+                               "I" FocusAndWarp


#------------------------------------------------------------------------------
# This one is used to modify some settings
#------------------------------------------------------------------------------

DestroyFunc "ChangeDefaultFocus"
AddToFunc ChangeDefaultFocus "I" Style "*" $0
+                            "I" Recapture


#------------------------------------------------------------------------------
# A really useful one: de-iconifies, warps to the window
# or creates it if it doen't exist (often used with mailtools)
#------------------------------------------------------------------------------

DestroyFunc "WarpOrExec"
AddToFunc WarpOrExec	   "I" Next [$0] Iconify -1
+		           "I" Next [$0] FocusAndWarp
+			   "I" None [$0] Exec $0 $1


#------------------------------------------------------------------------------
# One more complex function - couldn't be defined earlier because it used
# pop-up menus
#
# This creates the "system" menu for the title-bar window-ops
# pop-up
#------------------------------------------------------------------------------


DestroyMenu "window_ops_func"
AddToFunc "window_ops_func" "C" PopUp Window-Ops2
+	              "M" PopUp Window-Ops2
+	              "D" Delete


#=============================================================================#
#
# Now define the menus - defer bindings until later
#
#=============================================================================#



#------------------------------------------------------------------------------
#--------- Taskbar's start menu
#------------------------------------------------------------------------------

DestroyMenu "StartMenu"
AddToMenu "StartMenu@fvwm-menu.xpm@^#808080^"
+ "File Manager       %mini-filemgr.xpm%"       Exec explorer $HOME &
+ "Alt File Manager    %mini-folder.xpm%"          Exec pcmanfm $HOME &
+ "Text Editor        %mini-edit.xpm%"          Exec mousepad &
+ "Music Player       %mini-cd.xpm%"            Exec audacious &
+ "Appearance         %mini-paint.xpm%"         Exec lxappearance &
+ ""                   Nop
+ "Accessories        %mini-edit.xpm%"          Popup Accessories
+ "Games              %mini-solitaire.xpm%"      Popup Games
+ "Ports              %mini-solitaire.xpm%"      Popup Ports
+ "Multimedia         %mini-cd.xpm%"            Popup Multimedia
+ "Terminals          %mini-term.xpm%"          Popup Terminals
+ "DOS / Windows      %mini-bomb.xpm%"          Popup DosWindows
+ "Wine Tools         %mini-x2.xpm%"            Popup WineTools
+ ""                   Nop
+ "Restart FVWM95     %mini-turn.xpm%"          Restart
+ "Quit FVWM95        %mini-stop.xpm%"          Quit


DestroyMenu "Multimedia"
AddToMenu "Multimedia" "Multimedia" Title
+ "VLC                %vlc.xpm%"                Exec redstone-9x-vlc &
+ "Music Player       %mini-cd.xpm%"            Exec audacious &


DestroyMenu "Accessories"
AddToMenu "Accessories" "Accessories" Title
+ "Mousepad           %mini-edit.xpm%"          Exec mousepad &
+ "Calculator         %mini-calc.xpm%"          Exec xterm -name redstone-calc -title "Calculator" -e tcalc &

DestroyMenu "Games"
AddToMenu "Games" "Games" Title
+ "Minesweeper        %dsdmine.xpm%"             Exec redstone-9x-dsdmine &
+ "Solitaire          %mini-solitaire.xpm%"      Exec sol &
+ "FreeCell           %mini-solitaire.xpm%"      Exec sol --variation=freecell &
+ "GNU Backgammon     %gnubg.xpm%"                Exec gnubg &
+ "FreeCiv            %freeciv.xpm%"             Exec freeciv-gtk3.22 &
+ "CorsixTH           %corsixth.xpm%"            Exec corsix-th &
+ "OpenTTD            %openttd.xpm%"             Exec openttd &
+ "OpenRCT2           %openrct2.xpm%"            Exec openrct2 &
+ "OpenRA             %openra.xpm%"             Exec redstone-9x-openra &
+ "Micropolis         %micropolis.xpm%"          Exec redstone-9x-micropolis &
+ "Space Cadet Pinball %pinball.xpm%"            Exec redstone-9x-pinball &

# The ports submenu is emitted from the bounded depth-1/depth-2 launcher glob.
PipeRead "ports-menu-gen fvwm"


DestroyMenu "Terminals"
AddToMenu "Terminals" "Terminals" Title
+ "Windows PowerShell"      Exec bash /home/metsatron/.local/bin/redstone-9x-run xterm -class redstone-powershell -title PowerShell -geometry 80x25 -fa "Consolas" -fs 11 -bg "#012456" -fg "#EEEDF0" -cr "#EEEDF0" -e /home/metsatron/.local/bin/redstone-9x-pwsh
+ "PowerShell (Bash)"       Exec bash /home/metsatron/.local/bin/redstone-9x-run urxvt -name redstone-bash-powershell -title "Windows PowerShell" -geometry 80x25 +sb -bg rgb:01/24/56 -fg rgb:ee/ed/f0 -cr rgb:ee/ed/f0 -fn "xft:Cascadia Mono:size=11:antialias=true,xft:Consolas:size=11:antialias=true" -e bash
+ "Command Prompt"          Exec bash /home/metsatron/.local/bin/redstone-9x-run urxvt -hold -name redstone-bash-cmd -title "Command Prompt" -geometry 80x25 +sb -bg rgb:0c/0c/0c -fg rgb:cc/cc/cc -cr rgb:cc/cc/cc -fn "xft:Lucida Console:pixelsize=14:antialias=true" -e bash -lc 'exec wine cmd.exe'
+ "Bash (CMD frame)"        Exec bash /home/metsatron/.local/bin/redstone-9x-run urxvt -name redstone-bash-cmd -title "Command Prompt" -geometry 80x25 +sb -bg rgb:0c/0c/0c -fg rgb:cc/cc/cc -cr rgb:cc/cc/cc -fn "xft:Lucida Console:pixelsize=14:antialias=true" -e bash
+ "URxVT"                   Exec bash /home/metsatron/.local/bin/redstone-9x-run urxvt -name redstone-plain-urxvt -title "URxVT" -geometry 80x25 +sb -bg rgb:00/00/00 -fg rgb:d6/d3/ce -cr rgb:d6/d3/ce -fn "xft:Courier New:size=11:antialias=true,xft:monospace:size:11:antialias=true" -e bash
+ "XTerm"                   Exec bash /home/metsatron/.local/bin/redstone-9x-run xterm -title "XTerm" -geometry 80x25

DestroyMenu "DosWindows"
AddToMenu "DosWindows" "DOS / Windows" Title
+ "MS-DOS Prompt      %mini-bomb.xpm%"          Exec bash /home/metsatron/.local/bin/redstone-9x-run xterm -title "MS-DOS Prompt" -geometry 80x25 -fa "Perfect DOS VGA 437 Win" -fs 11 -bg black -fg "#c0c0c0" -e /home/metsatron/.local/bin/redstone-9x-dosemu2-shell &
+ "DOSBox-X           %mini-bomb.xpm%"          Exec /home/metsatron/.local/bin/redstone-9x-dosbox-x &

DestroyMenu "WineTools"
AddToMenu "WineTools" "Wine Tools" Title
+ "Wine Configurator"  Exec wine64 winecfg
+ "Registry Editor"    Exec wine64 regedit
+ "Windows Explorer"   Exec wine64 explorer
+ "Notepad"            Exec wine64 notepad




#------------------------------------------------------------------------------
# This defines the most common window operations
#------------------------------------------------------------------------------


DestroyMenu "Window"
AddToMenu "Window" "Window Ops" Title
+ "&Move%mini-move.xpm%"                Function Move-or-Raise
+ "&Resize%mini-resize.xpm%"            Function Resize-or-Raise
+ "R&aise%mini-raise.xpm%"              Raise
+ "&Lower%mini-lower.xpm%"              Lower
+ "(De)Iconify%mini-iconify.xpm%"       Iconify
+ "(Un)Stick%mini.stick.xpm%"           Stick
+ "(Un)Maximize%mini-max1.xpm%"         Maximize 100 96
+ "(Un)Maxwide%mini-maxwide.xpm%"       Maximize 100 0
+ ""                                    Nop
+ "Kill"                                Destroy
+ "&Close"                              Delete
+ ""                                    Nop
+ "Switch to..."                        WindowList
+ "Refresh Screen"                      Refresh


#------------------------------------------------------------------------------
# Win95-style desktop right-click context menu
#------------------------------------------------------------------------------

DestroyMenu "DeskCtx"
AddToMenu "DeskCtx"@fvwm-menu.xpm@^#808080^
+ "New Folder"                         Exec xterm -e mkdir ${HOME}/.xclass/desktop/"New Folder"
+ ""                                    Nop
+ "Arrange Icons"                       Nop
+ "Line Up Icons"                       Nop
+ ""                                    Nop
+ "Paste"                               Nop
+ "Paste Shortcut"                      Nop
+ ""                                    Nop
+ "New"                                 Popup NewCtx
+ ""                                    Nop
+ "Properties%mini-paint.xpm%"          Exec lxappearance &

DestroyMenu "NewCtx"
AddToMenu "NewCtx"
+ "Folder"                              Exec xterm -e mkdir ${HOME}/.xclass/desktop/"New Folder"
+ "Text Document"                      Exec touch ${HOME}/.xclass/desktop/"New Text Document.txt"


#------------------------------------------------------------------------------
# A trimmed down version of "Window Ops", good for binding to decorations
#------------------------------------------------------------------------------

DestroyMenu "Window-Ops2"
AddToMenu "Window-Ops2" "&Restore"        Iconify -1
+	              "&Move"           Move-or-Raise
+	              "&Size"           Resize-or-Raise
+	              "Mi&nimize"       Iconify 1
+	              "Ma&ximize"       Maximize 100 96
+	              ""                Nop
+	              "&Kill"           Destroy
+	              "&Close"          Delete


#=============================================================================#
#
# Mouse , frame buttons and keyboard bindings
#
#=============================================================================#


#------------------------------------------------------------------------------
# First, for the mouse in the root window (Context=R)
# Button 1 gives the Start menu
# Button 2 gives the Window Ops menu
# Button 3 gives the WindowList
#------------------------------------------------------------------------------


#     Button	Context Modifi 	Function

Mouse 1		R   	A       Menu "StartMenu" Nop
Mouse 2		R    	A       Menu "Window" Nop
# Root button3 is intentionally NOT bound: the xclass desktop manager
# installs its own XGrabButton(AnyButton) on the root to show its native
# context menu (New / Arrange Icons By / Line Up Icons / Auto Arrange /
# Properties). A fvwm95 root button3 binding would conflict (BadAccess) and
# prevent the xclass menu — and thus Arrange Icons By / Auto Arrange —
# from ever working.
#Mouse 3         R       A       Menu "DeskCtx" Nop
#Mouse 3	R    	A      	Module "winlist" FvwmWinList transient


#------------------------------------------------------------------------------
# Now the title bar buttons
# Any button in the left title-bar button gives the window ops menu
# Any button in the first right title-bar button Iconifies the window
# Any button in the second title-bar button full-maximizes
# Any button in the third (rightmost) title-bar button closes
# Note the use of "Mouse 0" for AnyButton.
#------------------------------------------------------------------------------


#     Button	Context Modif 	Function
Mouse 0		1    	A      	Function "window_ops_func"
Mouse 1         2       A       Delete
Mouse 0		4    	A     	Maximize 100 96
Mouse 0		6    	A     	Iconify


#------------------------------------------------------------------------------
# Now the rest of the frame
# Here I invoke my complex functions for Move-or-lower, Move-or-raise,
# and Resize-or-Raise.
#------------------------------------------------------------------------------

# Button 1 in the corners or sides, with any modifiers, gives resize or raise
Mouse 1		FS	A	Function "Resize-or-Raise"

# Button 1 in the title, sides, or icon, w/ any modifiers, gives move or raise
Mouse 1		T	A	Function "Move-or-Raise"

# Button 1 in an icons gives move for a drag, de-iconify for a double-click,
# nothing for a single click
Mouse 1		I	A	Function "Move-or-Iconify"

# Button 2 in an icon, w/ any modifiers, gives de-iconify
Mouse 2		I	A	Iconify

# Button 2 in the corners, sides, or title-bar gives the window ops menu
Mouse 2		FST	A	Function "window_ops_func"

# Button 3 anywhere in the decoration (except the title-bar buttons)
# does a raise-lower
Mouse 3		TSIF	A	RaiseLower

# Button 3 in the window, with the Modifier-1 key (usually alt or diamond)
# gives Raise-Lower. Used to use control here, but that interferes with xterm
Mouse 3         W       M       RaiseLower



#------------------------------------------------------------------------------
# Now some keyboard shortcuts.
# Most are commented, they are there for documentation.
#------------------------------------------------------------------------------

#------------------------------------------------------------------------------
# press arrow + control anywhere, and scroll by 1 page
#------------------------------------------------------------------------------

Key Left	A	C	Scroll -100 0
Key Right	A	C	Scroll +100 +0
Key Up		A	C	Scroll +0   -100
Key Down	A	C	Scroll +0   +100

#------------------------------------------------------------------------------
# press arrow + meta key, and scroll by 1/10 of a page
#------------------------------------------------------------------------------

Key Left	A	M	Scroll -10 +0
Key Right	A	M	Scroll +10 +0
Key Up		A	M	Scroll +0   -10
Key Down	A	M	Scroll +0   +10

#------------------------------------------------------------------------------
# Keyboard accelerators - I left F1-F8 out because they are often used
# by apps other than the window manager
#------------------------------------------------------------------------------

Key F9		A	A	Iconify
Key F10		A	A	Iconify
Key F11		A	A	CirculateUp
Key F12		A	A	CirculateDown

#------------------------------------------------------------------------------
# Page Up/Page Down keys are used to scroll by one desktop page
# in any context, press page up/down + control
# in root context, just pressing page up/down is OK
#------------------------------------------------------------------------------

Key Next	A       C       Scroll 100000 0
Key Next	R       N       Scroll 100000 0
Key Prior	A       C       Scroll -100000 0
Key Prior	R       N       Scroll -100000 0


#------------------------------------------------------------------------------
# press arrow left/right+ control anywhere, and skip focus
#------------------------------------------------------------------------------

Key Left	A	S	Prev FocusAndWarp
Key Right	A	S	Next [!iconic] FocusAndWarp
Key Down	A	S	Prev FocusAndWarp
Key Up  	A	S	Next [iconic] DeIconifyFocusAndWarp

Key Tab         A       M       Prev FocusAndWarp
Key Tab         A       MS      Next FocusAndWarp


#=============================================================================#
#
# Definitions used by the modules
#
#=============================================================================#


#------------------------------------------------------------------------------
#------------------ FvwmWharf QuickLaunch bar
#------------------------------------------------------------------------------
# NOTE: this mintsuki FVWM95 fork sets ModuleName = argv[0] basename
# ("FvwmWharf"), NOT the fvwm alias used in `Module FvwmWharf QuickLaunch`.
# So the config prefix must be *FvwmWharf, not *QuickLaunch, or
# match_string() is never reached and FvwmWharf exits "No Buttons defined".

Style "FvwmWharf" NoTitle, NoHandles, Sticky, WindowListSkip, CirculateSkip, BorderWidth 0

*FvwmWharfGeometry +38-26
*FvwmWharfRows 1
*FvwmWharfForceSize
*FvwmWharfNoBorder
*FvwmWharfBgColor #c0c0c0
*FvwmWharfTextureType 0
*FvwmWharfTextureColor #c0c0c0 #808080

# Quick-launch icons (FvwmWharf button line: *<ModuleName> <label> <icon> <action>)
*FvwmWharf Explorer   mini-filemgr.xpm   Exec explorer $HOME &
*FvwmWharf Editor     mini-edit.xpm      Exec mousepad &
*FvwmWharf Term       mini-term.xpm      Exec xterm &
*FvwmWharf Music      mini-cd.xpm       Exec audacious &
*FvwmWharf Apps       mini-paint.xpm     Exec lxappearance &

#------------------------------------------------------------------------------
#------------------ FvwmTaskBar
#------------------------------------------------------------------------------

Style "FvwmTaskBar" NoTitle,BorderWidth 4,HandleWidth 4,Sticky, \
                    StaysOnTop,WindowListSkip,CirculateSkip

*FvwmTaskBarGeometry +0-0
*FvwmTaskBarFore Black
*FvwmTaskBarBack #c0c0c0
*FvwmTaskBarFont -adobe-helvetica-medium-r-normal--14-100-100-100-p-76-iso10646-1
*FvwmTaskBarSelFont -adobe-helvetica-bold-r-normal--14-100-100-100-p-82-iso10646-1
*FvwmTaskBarStatusFont fixed
*FvwmTaskBarAction Click1 Iconify -1,Raise,Focus
*FvwmTaskBarAction Click2 Iconify
*FvwmTaskBarAction Click3 PopUp Window-Ops2
*FvwmTaskBarUseSkipList
*FvwmTaskBarAutoStick
*FvwmTaskBarStartName Start
*FvwmTaskBarStartMenu StartMenu
*FvwmTaskBarStartIcon mini-win95.xpm
*FvwmTaskBarShowTips
*FvwmTaskBarShowTransients
#*FvwmTaskBarHighlightFocus
#*FvwmTaskBarAutoHide
*FvwmTaskBarDeskOnly



# Now the goodies....

# Clock status area (real, not a static decoration): the ShowDateModule
# goody plugin, built alongside FvwmTaskBar by sanctuary-redstone-9x-fvwm95-build
# (so its ABI matches). 12-hour AM/PM, no seconds — Win95 clock convention.
# Path is substituted at launch time by sanctuary-redstone-9x-launch
# (the FvwmTaskBar module's CopyString does NOT expand $HOME, so an absolute
# guest-home path must be patched into the projected config).
*FvwmTaskBarGoodyLoadablePlugins @GUEST_PLUGINS@
*FvwmTaskBarGoodyLoadableQuiet
*FvwmTaskBarGoodyLoadableSymbol ShowDateModuleSymbol
*FvwmTaskBarGoodyLoadableId .DATE
*FvwmTaskBarShowDateModuleClockFormat.DATE %I:%M %p

# Screen lock
# *FvwmTaskBarGoodyLoadableSymbol GoodyModuleSymbol
# *FvwmTaskBarGoodyLoadableId .LOCK
# *FvwmwmTaskBarGoodyModuleIcon.LOCK mini-lock.xpm
# *FvwmTaskBarGoodyModuleTip.LOCK Screen Locker

#------------------------------------------------------------------------------
#------------------ FvwmConsole
#------------------------------------------------------------------------------

*FvwmConsoleHook /dev/console

#------------------------------------------------------------------------------
