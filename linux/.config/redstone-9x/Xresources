! Redstone 9X — URxvt terminal profiles
! Loaded into Xephyr display by sanctuary-redstone-9x-launch via xrdb -merge.
! Each launcher uses: urxvt -name <instance> ...

Xft.dpi: 96

! ── Common defaults ──────────────────────────────────────────────────────────
URxvt*scrollBar:       false
URxvt*geometry:        80x25
URxvt*letterSpace:     0
URxvt*lineSpace:       1
URxvt*borderLess:      false
URxvt*internalBorder:  2

! ── redstone-powershell — Windows PowerShell (deep blue / white) ─────────────
redstone-powershell*background:  #012456
redstone-powershell*foreground:  #EEEDF0
redstone-powershell*cursorColor: #EEEDF0
