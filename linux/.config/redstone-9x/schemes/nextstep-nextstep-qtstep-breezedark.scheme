# Redstone 9X Desktop Scheme — NeXTSTEP/OpenStep / QTStep — BreezeDark.
SCHEME_TITLE="NeXTSTEP/OpenStep — QTStep — BreezeDark"
ICEWM_THEME="NextStep-NeXT-QTStep-BreezeDark"
GTK_THEME="NextStep-QTStep-BreezeDark"
ICON_THEME="NeXTSTEP"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Charcoal 9"
DESKTOP_BG="#242432"
DESKTOP_ICON_LABEL_MODE="shadow"
DESKTOP_ICON_LABEL_FOREGROUND="#ffffff"
DESKTOP_ICON_LABEL_SHADOW_COLOR="#000000"
SEL_BG="#3c4146"
SEL_FG="#ffffff"
QT6CT_COLORS="nextstep-qtstep-breezedark.conf"
WINE_COLORS="nextstep-qtstep-breezedark.reg"
QT_STYLE="Windows"
SOUND_SCHEME="nextstep"
FOX_BASE="#000000"
FOX_SEL_BG="#3c4146"
FOX_SEL_FG="#ffffff"
FOX_MENU_BG="#000000"
FOX_MENU_FG="#ffffff"
NEXTSTEP_DOCKAPPS="1"
ICEWM_PREFS='TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetworkStatusDevice="en* wl* wg* tailscale*";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;ClockCommand="i2kcal";CPUStatusCommand="dbus-run-session mate-system-monitor";NetStatusCommand="netactview";DockApps="right high dock"'
