# Redstone 9X Desktop Scheme — CDE Golden (raided CDE palette dynasty, 2026-07-20).
SCHEME_TITLE="CDE Golden"
ICEWM_THEME="CDE-Golden"
GTK_THEME="CDE-Golden"
ICON_THEME="Irixium"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#b1705f"
SEL_BG="#faad49"
SEL_FG="#000000"
QT6CT_COLORS="cdep-golden.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="CDE-Golden"
