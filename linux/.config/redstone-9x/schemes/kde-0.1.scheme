# Redstone 9X Desktop Scheme — KDE 0.1 (2026-07-21). Windows 95 window
# decorations (Windows-95 IceWM theme) around real CDE/Motif toolkit widgets in
# neutral grey (CDE-GrayScale GTK — the same proven CDE engine the CDE schemes
# use, in its grayscale palette; bg #c3c3c3 matches the Win95 frame grey), plus
# Kvantum commonalitygris (Qt) and grey FOX, BeOS icons, KDE teal desktop.
SCHEME_TITLE="KDE 0.1"
ICEWM_THEME="KDE-0.1"
GTK_THEME="Motif95"
ICON_THEME="BeOS-r5-Icons"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#008081"
DESKTOP_ICON_LABEL_MODE="box"
DESKTOP_ICON_LABEL_FOREGROUND="#ffffff"
DESKTOP_ICON_LABEL_BACKGROUND="#008081"
SEL_BG="#000080"
SEL_FG="#ffffff"
QT6CT_COLORS="win95.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="Motif95"
SOUND_SCHEME="kde-0.1"
FOX_BASE="#c0c0c0"
FOX_SEL_BG="#000080"
FOX_SEL_FG="#ffffff"
FOX_MENU_BG="#000080"
FOX_MENU_FG="#ffffff"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";MEMStatusCommand=\"lxtask\";NetStatusCommand=\"netactview\";TaskBarShowWorkspaces=1"
