# Redstone 9X Desktop Scheme — Rhapsody / OneStepBack — Green Brown.
SCHEME_TITLE="Rhapsody — OneStepBack — Green Brown"
ICEWM_THEME="NextStep-Rhapsody-OneStepBack-Green-Brown"
GTK_THEME="OneStepBack-green-brown"
ICON_THEME="NineIcons"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="TeX Gyre Heros 9"
DESKTOP_BG="#3e5453"
DESKTOP_ICON_LABEL_MODE="shadow"
DESKTOP_ICON_LABEL_FOREGROUND="#ffffff"
DESKTOP_ICON_LABEL_SHADOW_COLOR="#000000"
SEL_BG="#ac441d"
SEL_FG="#ffffff"
QT6CT_COLORS="nextstep-onestepback-green-brown.conf"
WINE_COLORS="nextstep-onestepback-green-brown.reg"
QT_STYLE="Windows"
SOUND_SCHEME="nextstep"
FOX_BASE="#517c5f"
FOX_SEL_BG="#ac441d"
FOX_SEL_FG="#ffffff"
FOX_MENU_BG="#517c5f"
FOX_MENU_FG="#ffffff"
NEXTSTEP_DOCKAPPS="1"
ICEWM_PREFS='TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetworkStatusDevice="en* wl* wg* tailscale*";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;ClockCommand="i2kcal";CPUStatusCommand="dbus-run-session mate-system-monitor";NetStatusCommand="netactview";DockApps="right high dock"'
