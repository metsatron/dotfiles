# Redstone 9X Desktop Scheme — CDE Camouflage (raided CDE palette dynasty, 2026-07-20).
SCHEME_TITLE="CDE Camouflage"
ICEWM_THEME="CDE-Camouflage"
GTK_THEME="CDE-Camouflage"
ICON_THEME="Irixium"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#4e6b65"
SEL_BG="#acbeb4"
SEL_FG="#000000"
QT6CT_COLORS="cdep-camouflage.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="CDE-Camouflage"
WINE_COLORS="cdep-camouflage.reg"
SOUND_SCHEME="cdep-camouflage"
WALLPAPER="$HOME/.icewm/themes/CDE-Camouflage/backgrounds/Ankh.png"
WALLPAPER_MODE="center"
FOX_BASE="#6e7d76"
FOX_SEL_BG="#acbeb4"
FOX_SEL_FG="#000000"
FOX_MENU_BG="#acbeb4"
FOX_MENU_FG="#000000"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;ClockCommand=\"i2kcal\";CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
