# Redstone 9X Desktop Scheme — CDE SeaFoam (raided CDE palette dynasty, 2026-07-20).
SCHEME_TITLE="CDE SeaFoam"
ICEWM_THEME="CDE-SeaFoam"
GTK_THEME="CDE-SeaFoam"
ICON_THEME="Irixium"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#c8ada0"
SEL_BG="#aacbdb"
SEL_FG="#000000"
QT6CT_COLORS="cdep-seafoam.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="CDE-SeaFoam"
WINE_COLORS="cdep-seafoam.reg"
SOUND_SCHEME="cdep-seafoam"
WALLPAPER="$HOME/.icewm/themes/CDE-SeaFoam/backgrounds/Toronto.png"
WALLPAPER_MODE="tile"
FOX_BASE="#a7a8a7"
FOX_SEL_BG="#aacbdb"
FOX_SEL_FG="#000000"
FOX_MENU_BG="#aacbdb"
FOX_MENU_FG="#000000"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
