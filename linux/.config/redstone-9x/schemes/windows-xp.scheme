# Redstone 9X Desktop Scheme — Windows XP Classic (Windows dynasty). ice2k
# ships the XP IceWM theme identity (green flag start, own icons); titlebar
# gradient is the classic "Windows Standard" #0a246a→#a6caf0 dark-left →
# light-right per pixelocdguy/windows-classic themerc. GTK is the B00merang
# Windows-Classic upstream. Desktop #3a6ea5 = XP classic default background.
# Sounds: pack pending (archive.org was down) — drop XP media into
# sounds/schemes/windows-xp/ when obtained.
SCHEME_TITLE="Windows XP"
ICEWM_THEME="Windows-XP"
GTK_THEME="Windows-Classic"
ICON_THEME="LinXP"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#3a6ea5"
SEL_BG="#0a246a"
SEL_FG="#ffffff"
QT6CT_COLORS="win95.conf"
SOUND_SCHEME="windows-xp"
FOX_BASE="#d4d0c8"
FOX_SEL_BG="#0a246a"
FOX_SEL_FG="#ffffff"
FOX_MENU_BG="#0a246a"
FOX_MENU_FG="#ffffff"
# ice2k FOX branding personality (2k|xp|srv03): this scheme is the XP skew.
FOX_WINVER="xp"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
