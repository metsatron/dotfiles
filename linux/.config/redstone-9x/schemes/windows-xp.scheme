# Redstone 9X Desktop Scheme — Windows XP Classic (Windows dynasty). ice2k
# ships the XP IceWM theme; GTK stays Windows-95 (the collection's Windows-XP
# GTK dir has no engine dirs — Luna proper arrives with the ice2k icon ports).
# Sounds: pack pending (archive.org was down) — drop XP media into
# sounds/schemes/windows-xp/ when obtained.
SCHEME_TITLE="Windows XP"
ICEWM_THEME="Win2kmod-xpm-xp"
GTK_THEME="Windows-95"
ICON_THEME="LinXP"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#004E98"
SEL_BG="#316AC5"
SEL_FG="#ffffff"
QT6CT_COLORS="win95.conf"
SOUND_SCHEME="windows-xp"
FOX_BASE="#c0c0c0"
FOX_SEL_BG="#316AC5"
FOX_SEL_FG="#ffffff"
FOX_MENU_BG="#316AC5"
FOX_MENU_FG="#ffffff"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
