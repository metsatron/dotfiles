# Redstone 9X — KDE 1 Icons — Warm Sculpted; first introduced 1997-09-13.
SCHEME_TITLE="KDE 1 Icons — Warm Sculpted [1997-09-13]"
ICEWM_THEME="KDE-1-Alpha"
GTK_THEME="Motif95"
ICON_THEME="KDE-1-Beta-Warm-Original"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#C0C0C0"
DESKTOP_ICON_LABEL_MODE="box"
DESKTOP_ICON_LABEL_BACKGROUND="#C0C0C0"
DESKTOP_LABEL_FOREGROUND="#000000"
DESKTOP_LABEL_SHADOW="#FFFFFF"
SEL_BG="#000080"
SEL_FG="#FFFFFF"
QT6CT_COLORS="kde1-icons-warm-original.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="Motif95"
SOUND_SCHEME="kde-0.1"
FOX_BASE="#C0C0C0"
FOX_SEL_BG="#000080"
FOX_SEL_FG="#FFFFFF"
FOX_MENU_BG="#000080"
FOX_MENU_FG="#FFFFFF"
WALLPAPER="$HOME/.icewm/themes/KDE-1-Alpha/backgrounds/KDE_1_Alpha.png"
WALLPAPER_MODE="center"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;ClockCommand=\"i2kcal\";CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\";TaskBarShowWorkspaces=1"
