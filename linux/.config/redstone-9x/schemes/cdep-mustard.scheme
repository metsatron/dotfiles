# Redstone 9X Desktop Scheme — CDE Mustard (raided CDE palette dynasty, 2026-07-20).
SCHEME_TITLE="CDE Mustard"
ICEWM_THEME="CDE-Mustard"
GTK_THEME="CDE-Mustard"
ICON_THEME="Irixium"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#2a6889"
SEL_BG="#d5802e"
SEL_FG="#000000"
QT6CT_COLORS="cdep-mustard.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="CDE-Mustard"
WINE_COLORS="cdep-mustard.reg"
SOUND_SCHEME="cdep-mustard"
WALLPAPER="$HOME/.icewm/themes/CDE-Mustard/backgrounds/Toronto.png"
WALLPAPER_MODE="tile"
FOX_BASE="#b75f5f"
FOX_SEL_BG="#d5802e"
FOX_SEL_FG="#000000"
FOX_MENU_BG="#d5802e"
FOX_MENU_FG="#000000"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
