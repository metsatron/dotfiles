# Redstone 9X Desktop Scheme — ReactionaryTravel (converted from official .theme by
# redstone-9x-theme-convert; colours are the file's own, gradient endpoints
# synthesized 50%-to-white when the file predates gradient keys).
SCHEME_TITLE="Reactionary Travel"
ICEWM_THEME="ReactionaryTravel"
MENU_BUTTON=""
GTK_THEME="ReactionaryTravel"
ICON_THEME="SE98"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#2C3454"
DESKTOP_ICON_LABEL_MODE="box"
DESKTOP_ICON_LABEL_FOREGROUND="#ffffff"
DESKTOP_ICON_LABEL_BACKGROUND="#2C3454"
SEL_BG="#3E4976"
SEL_FG="#FFFFFF"
QT6CT_COLORS="reactionary-travel.conf"
SOUND_SCHEME="windows-2000"
WINE_COLORS="reactionary-travel.reg"
FOX_BASE="#8F816E"
FOX_FG="#000000"
FOX_BG="#D9D0C9"
FOX_SEL_BG="#3E4976"
FOX_SEL_FG="#FFFFFF"
FOX_MENU_BG="#3E4976"
FOX_MENU_FG="#FFFFFF"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;ClockCommand=\"i2kcal\";CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
WALLPAPER="$HOME/.local/share/redstone-9x/wallpapers/reactionary-travel.jpg"
WALLPAPER_MODE="crop"
