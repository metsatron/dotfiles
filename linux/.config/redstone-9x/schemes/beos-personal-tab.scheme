# Redstone 9X Desktop Scheme — BeOS Personal (Be tab dynasty, 2026-07-23). The
# "real" Personal: icedano's genuine tab illusion recoloured to Personal's rare
# terracotta, correct BeOS buttons, navy accent removed. Inherits every non-
# chrome layer from the Inspired Personal scheme.
SCHEME_TITLE="BeOS Personal"
ICEWM_THEME="BeOS-Personal-Tab"
# Wine classic colours reuse the Inspired Personal palette (same BeOS-r5 GTK
# theme + terracotta titlebar) — no separate reg needed.
WINE_COLORS="beos-personal.reg"
GTK_THEME="BeOS-r5"
ICON_THEME="BeOS-r5-Icons"
MENU_BUTTON="beos-personal"
CURSOR_THEME="behand"
CURSOR_SIZE="24"
GTK_FONT="Swis721 BT 10"
DESKTOP_BG="#3f6e7e"
DESKTOP_ICON_LABEL_MODE="shadow"
DESKTOP_ICON_LABEL_FOREGROUND="#ffffff"
DESKTOP_ICON_LABEL_SHADOW_COLOR="#000000"
# Colour-fill behind the tab text, matched to the recoloured tab pixmaps.
TITLE_ACTIVE="#be816c"
TITLE_INACTIVE="#eaeaea"
SEL_BG="#989898"
SEL_FG="#000000"
QT6CT_COLORS="beos-r5.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="Besot"
SOUND_SCHEME="beos-r5"
FOX_BASE="#d8d8d8"
FOX_SEL_BG="#989898"
FOX_SEL_FG="#000000"
FOX_MENU_BG="#d8d8d8"
FOX_MENU_FG="#000000"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";MEMStatusCommand=\"lxtask\";NetStatusCommand=\"netactview\""
