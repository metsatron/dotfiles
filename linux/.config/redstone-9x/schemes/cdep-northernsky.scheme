# Redstone 9X Desktop Scheme — CDE NorthernSky (raided CDE palette dynasty, 2026-07-20).
SCHEME_TITLE="CDE NorthernSky"
ICEWM_THEME="CDE-NorthernSky"
GTK_THEME="CDE-NorthernSky"
ICON_THEME="Irixium"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#3d407c"
SEL_BG="#a47591"
SEL_FG="#000000"
QT6CT_COLORS="cdep-northernsky.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="commonalitygris"
WINE_COLORS="cdep-northernsky.reg"
SOUND_SCHEME="cdep-northernsky"
WALLPAPER="$HOME/.icewm/themes/CDE-NorthernSky/backgrounds/BrickWall.png"
WALLPAPER_MODE="tile"
FOX_BASE="#1b5d6c"
FOX_SEL_BG="#a47591"
FOX_SEL_FG="#000000"
FOX_MENU_BG="#a47591"
FOX_MENU_FG="#000000"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
