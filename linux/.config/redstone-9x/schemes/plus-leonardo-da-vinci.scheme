# Redstone 9X Desktop Scheme — Leonardo da Vinci (converted from official .theme by
# redstone-9x-theme-convert; colours are the file's own, gradient endpoints
# synthesized 50%-to-white when the file predates gradient keys).
SCHEME_TITLE="Leonardo da Vinci"
ICEWM_THEME="Leonardo-da-Vinci"
GTK_THEME="Leonardo-da-Vinci"
ICON_THEME="Win98SE"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#8B655C"
SEL_BG="#800000"
SEL_FG="#FFFFFF"
QT6CT_COLORS="plus-leonardo-da-vinci.conf"
SOUND_SCHEME="plus-leonardo-da-vinci"
FOX_BASE="#BFA59F"
FOX_SEL_BG="#800000"
FOX_SEL_FG="#FFFFFF"
FOX_MENU_BG="#800000"
FOX_MENU_FG="#FFFFFF"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
