# Redstone 9X Desktop Scheme — CDE Nutmeg (raided CDE palette dynasty, 2026-07-20).
SCHEME_TITLE="CDE Nutmeg"
ICEWM_THEME="CDE-Nutmeg"
GTK_THEME="CDE-Nutmeg"
ICON_THEME="Irixium"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#457293"
SEL_BG="#cec2bb"
SEL_FG="#000000"
QT6CT_COLORS="cdep-nutmeg.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="CDE-Nutmeg"
WINE_COLORS="cdep-nutmeg.reg"
SOUND_SCHEME="cdep-nutmeg"
WALLPAPER="$HOME/.icewm/themes/CDE-Nutmeg/backgrounds/NoBackdrop.png"
WALLPAPER_MODE="center"
FOX_BASE="#256593"
FOX_SEL_BG="#cec2bb"
FOX_SEL_FG="#000000"
FOX_MENU_BG="#cec2bb"
FOX_MENU_FG="#000000"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;ClockCommand=\"i2kcal\";CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
