# Redstone 9X Desktop Scheme — Haiku (Be dynasty, 2026-07-21). BeOS's open-source
# heir: Tverdov's Haiku IceWM chrome (the refined yellow tab and its own 79×22
# leaf start button, used as-is — no MENU_BUTTON override), the native Haiku GTK
# theme, and the authentic HaikuHand cursor, all over Haiku's signature deep-blue
# desktop. Qt/FOX share the Be-family grey; the Be R4 chime greets the switch (a
# genuine Haiku boot wav can drop into the beos-r5 sound dir later).
SCHEME_TITLE="Haiku"
ICEWM_THEME="Haiku"
GTK_THEME="Haiku"
ICON_THEME="BeOS-r5-Icons"
CURSOR_THEME="HaikuHand"
CURSOR_SIZE="24"
GTK_FONT="Sans 9"
# Haiku's signature desktop blue (white labels stay readable — scheme-apply default).
DESKTOP_BG="#2f6699"
# The Haiku GTK theme's own selected_bg_color, so GTK/Qt/FOX highlights agree.
SEL_BG="#989898"
SEL_FG="#000000"
QT6CT_COLORS="beos-r5.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="Besot"
SOUND_SCHEME="beos-r5"
# FOX toolkit registry — Be-family grey chrome.
FOX_BASE="#d8d8d8"
FOX_SEL_BG="#989898"
FOX_SEL_FG="#000000"
FOX_MENU_BG="#d8d8d8"
FOX_MENU_FG="#000000"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
