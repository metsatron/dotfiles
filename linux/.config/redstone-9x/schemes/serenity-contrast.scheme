# Redstone 9X Desktop Scheme — Serenity Contrast (converted from official .theme by
# redstone-9x-theme-convert; colours are the file's own, gradient endpoints
# synthesized 50%-to-white when the file predates gradient keys).
SCHEME_TITLE="Serenity Contrast"
ICEWM_THEME="Serenity-Contrast"
GTK_THEME="Serenity-Contrast"
ICON_THEME="Serenity-Black-and-White"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#000000"
SEL_BG="#00F9FF"
SEL_FG="#000000"
QT6CT_COLORS="serenity-contrast.conf"
SOUND_SCHEME="serenity"
WINE_COLORS="serenity-contrast.reg"
FOX_BASE="#000000"
FOX_FG="#F7FF00"
FOX_BG="#000000"
FOX_SEL_BG="#00F9FF"
FOX_SEL_FG="#000000"
FOX_MENU_BG="#00F9FF"
FOX_MENU_FG="#000000"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
