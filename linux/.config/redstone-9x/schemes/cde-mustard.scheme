# Redstone 9X Desktop Scheme — CDE Mustard (nIceCDE dynasty, 2026-07-20).
SCHEME_TITLE="CDE Mustard"
ICEWM_THEME="nIceCDE.Mustard"
GTK_THEME="cdetheme"
ICON_THEME="Irixium"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#5e9c7b"
SEL_BG="#bec6b7"
SEL_FG="#000000"
QT6CT_COLORS="cde-mustard.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="commonalitygris"
SOUND_SCHEME="cde-mustard"
WALLPAPER="$HOME/.icewm/themes/nIceCDE.Mustard/backgrounds/Sprinkles_green.png"
WALLPAPER_MODE="center"
FOX_BASE="#a4a9aa"
FOX_SEL_BG="#bec6b7"
FOX_SEL_FG="#000000"
FOX_MENU_BG="#bec6b7"
FOX_MENU_FG="#000000"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";MEMStatusCommand=\"lxtask\";NetStatusCommand=\"netactview\""
