# Redstone 9X Desktop Scheme — CDE SkyRed (raided CDE palette dynasty, 2026-07-20).
SCHEME_TITLE="CDE SkyRed"
ICEWM_THEME="CDE-SkyRed"
GTK_THEME="CDE-SkyRed"
ICON_THEME="Irixium"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#5e84b9"
SEL_BG="#cc686f"
SEL_FG="#000000"
QT6CT_COLORS="cdep-skyred.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="commonalitygris"
WINE_COLORS="cdep-skyred.reg"
SOUND_SCHEME="cdep-skyred"
WALLPAPER="$HOME/.icewm/themes/CDE-SkyRed/backgrounds/Ankh.png"
WALLPAPER_MODE="tile"
FOX_BASE="#afc0c2"
FOX_SEL_BG="#cc686f"
FOX_SEL_FG="#000000"
FOX_MENU_BG="#cc686f"
FOX_MENU_FG="#000000"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
