# Redstone 9X — KDE 1 Theme — Nostalgy; first introduced 1999-07-25.
SCHEME_TITLE="KDE 1 Theme — Nostalgy [1999-07-25]"
ICEWM_THEME="KDE1-Theme-nostalgy"
GTK_THEME="KDE1-Theme-nostalgy"
ICON_THEME="KDE-1-Classic-Silver-Curated"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#C0C0C0"
DESKTOP_ICON_LABEL_MODE="box"
DESKTOP_ICON_LABEL_BACKGROUND="#C0C0C0"
DESKTOP_LABEL_FOREGROUND="#000000"
DESKTOP_LABEL_SHADOW="#FFFFFF"
SEL_BG="#31319C"
SEL_FG="#FFFFFF"
QT6CT_COLORS="kde1-theme-nostalgy.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="KDE1-Theme-nostalgy"
SOUND_SCHEME="kde1-theme-nostalgy"
FOX_BASE="#C0C0C0"
FOX_SEL_BG="#31319C"
FOX_SEL_FG="#FFFFFF"
FOX_MENU_BG="#31319C"
FOX_MENU_FG="#FFFFFF"
WALLPAPER="$HOME/.icewm/themes/KDE1-Theme-nostalgy/backgrounds/nostalgy-1920x1080.png"
WALLPAPER_MODE="center"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;ClockCommand=\"i2kcal\";CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\";TaskBarShowWorkspaces=1"
