# Redstone 9X Desktop Scheme — ReactionaryRocknRoll (converted from official .theme by
# redstone-9x-theme-convert; colours are the file's own, gradient endpoints
# synthesized 50%-to-white when the file predates gradient keys).
SCHEME_TITLE="Reactionary Rock'n'Roll"
ICEWM_THEME="ReactionaryRocknRoll"
MENU_BUTTON=""
GTK_THEME="ReactionaryRocknRoll"
ICON_THEME="SE98"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#26267F"
DESKTOP_ICON_LABEL_MODE="box"
DESKTOP_ICON_LABEL_FOREGROUND="#ffffff"
DESKTOP_ICON_LABEL_BACKGROUND="#26267F"
SEL_BG="#00007F"
SEL_FG="#FFFFFF"
QT6CT_COLORS="reactionary-rocknroll.conf"
SOUND_SCHEME="windows-2000"
WINE_COLORS="reactionary-rocknroll.reg"
FOX_BASE="#BFB8BF"
FOX_FG="#000000"
FOX_BG="#FFF8FF"
FOX_SEL_BG="#00007F"
FOX_SEL_FG="#FFFFFF"
FOX_MENU_BG="#00007F"
FOX_MENU_FG="#FFFFFF"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;ClockCommand=\"i2kcal\";CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
WALLPAPER="$HOME/.local/share/redstone-9x/wallpapers/reactionary-rocknroll.jpg"
WALLPAPER_MODE="crop"
