# Redstone 9X Desktop Scheme — ReactionaryScience (converted from official .theme by
# redstone-9x-theme-convert; colours are the file's own, gradient endpoints
# synthesized 50%-to-white when the file predates gradient keys).
SCHEME_TITLE="Reactionary Science"
ICEWM_THEME="ReactionaryScience"
MENU_BUTTON=""
GTK_THEME="ReactionaryScience"
ICON_THEME="SE98"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#005459"
DESKTOP_ICON_LABEL_MODE="box"
DESKTOP_ICON_LABEL_FOREGROUND="#ffffff"
DESKTOP_ICON_LABEL_BACKGROUND="#005459"
SEL_BG="#00757C"
SEL_FG="#FFFFFF"
QT6CT_COLORS="reactionary-science.conf"
SOUND_SCHEME="windows-2000"
WINE_COLORS="reactionary-science.reg"
FOX_BASE="#7A97AD"
FOX_FG="#000000"
FOX_BG="#FCFCFC"
FOX_SEL_BG="#00757C"
FOX_SEL_FG="#FFFFFF"
FOX_MENU_BG="#00757C"
FOX_MENU_FG="#FFFFFF"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;ClockCommand=\"i2kcal\";CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
WALLPAPER="$HOME/.local/share/redstone-9x/wallpapers/reactionary-science.jpg"
WALLPAPER_MODE="center"
