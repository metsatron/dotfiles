# Redstone 9X Desktop Scheme — CDE Desert (raided CDE palette dynasty, 2026-07-20).
SCHEME_TITLE="CDE Desert"
ICEWM_THEME="CDE-Desert"
GTK_THEME="CDE-Desert"
ICON_THEME="Irixium"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#c4929b"
SEL_BG="#e5b793"
SEL_FG="#000000"
QT6CT_COLORS="cdep-desert.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="CDE-Desert"
WINE_COLORS="cdep-desert.reg"
SOUND_SCHEME="cdep-desert"
WALLPAPER="$HOME/.icewm/themes/CDE-Desert/backgrounds/Toronto.png"
WALLPAPER_MODE="tile"
FOX_BASE="#c2bba7"
FOX_SEL_BG="#e5b793"
FOX_SEL_FG="#000000"
FOX_MENU_BG="#e5b793"
FOX_MENU_FG="#000000"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
