# Redstone 9X Desktop Scheme - Rhapsody Canonical representative trial.
SCHEME_TITLE="Rhapsody Canonical representative trial"
ICEWM_THEME="Rhapsody-Trial-Canonical"
GTK_THEME="Rhapsody-Canonical"
ICON_THEME="Redstone-Rhapsody"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Charcoal 9"
DESKTOP_BG="#6666A0"
WALLPAPER="$HOME/.config/redstone-9x/wallpapers/rhapsody-canon.png"
WALLPAPER_MODE="center"
MENU_BUTTON="rhapsody"
SEL_BG="#CCCCFF"
SEL_FG="#000000"
DESKTOP_ICON_LABEL_MODE="shadow"
DESKTOP_ICON_LABEL_FOREGROUND="#ffffff"
DESKTOP_ICON_LABEL_SHADOW_COLOR="#000000"
QT6CT_COLORS="nextstep-rhapsody-canon.conf"
WINE_COLORS="nextstep-rhapsody-canon.reg"
QT_STYLE="Windows"
SOUND_SCHEME="nextstep"
FOX_BASE="#9A9ABC"
FOX_SEL_BG="#CCCCFF"
FOX_SEL_FG="#000000"
FOX_MENU_BG="#9A9ABC"
FOX_MENU_FG="#000000"
NEXTSTEP_DOCKAPPS="0"
ICEWM_PREFS='TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetworkStatusDevice="en* wl* wg* tailscale*";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;ClockCommand="i2kcal";CPUStatusCommand="dbus-run-session mate-system-monitor";NetStatusCommand="netactview"'
