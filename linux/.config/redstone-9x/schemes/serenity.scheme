# Redstone 9X Desktop Scheme — SerenityOS (Default.ini palette from the
# SerenityOS repo, BSD-2-Clause: burnt-sienna titlebars, warm #d4d0c8 chrome,
# #84351a selection, #505050 desktop). Assets generated by
# redstone-9x-serenity-import. Upstream ships no audio — the sound scheme
# directory exists but starts empty; curate your own.
SCHEME_TITLE="SerenityOS"
ICEWM_THEME="Serenity"
GTK_THEME="Serenity95"
ICON_THEME="Serenity95"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#505050"
SEL_BG="#84351a"
SEL_FG="#ffffff"
QT6CT_COLORS="serenity.conf"
SOUND_SCHEME="serenity"
