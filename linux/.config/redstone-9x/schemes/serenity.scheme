# Redstone 9X Desktop Scheme — SerenityOS (Default.ini palette from the
# SerenityOS repo, BSD-2-Clause: burnt-sienna titlebars, warm #d4d0c8 chrome,
# #84351a selection, #505050 desktop). Assets generated by
# redstone-9x-serenity-import. Upstream ships no audio — the sound scheme
# directory exists but starts empty; curate your own.
SCHEME_TITLE="SerenityOS"
ICEWM_THEME="Serenity"
MENU_BUTTON="serenity"
GTK_THEME="Serenity-Default"  # ruling 2026-08-08: legacy scheme rides the Reactionary-based Serenity-Default emission; the old Serenity95 GTK theme is retired
ICON_THEME="Serenity95"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#505050"
DESKTOP_ICON_LABEL_MODE="shadow"
DESKTOP_ICON_LABEL_FOREGROUND="#ffffff"
DESKTOP_ICON_LABEL_SHADOW_COLOR="#000000"
SEL_BG="#84351a"
SEL_FG="#ffffff"
QT6CT_COLORS="serenity.conf"
SOUND_SCHEME="serenity"
# FOX toolkit registry colours — warm chrome, sienna selection, tan menus.
FOX_BASE="#d4d0c8"
FOX_SEL_BG="#84351a"
FOX_SEL_FG="#ffffff"
FOX_MENU_BG="#d2c0b6"
FOX_MENU_FG="#000000"
# Taskbar layout toggles (themes can only set COLOURS; the show/hide and
# placement switches are preferences-level, so scheme-apply writes them into
# a managed ~/.icewm/prefoverride block). ShowDesktopButton=2 = far right
# past the clock (verified live 2026-07-19; the value is undocumented in the
# binary's strings but real in IceWM 4.0). CPU meter wears SerenityOS
# System-Monitor colours from the theme.
# Semicolon-separated (NetDevice's value contains a space). Full default
# meter set — CPU, MEM, Net — in SerenityOS System-Monitor colours.
# dbus-run-session wrappers: MATE apps are single-instance GApplications and
# the host+guest session-bus sockets BOTH live in bind-mounted /tmp — without
# a private bus a meter click can hand off to a HOST instance (found live
# 2026-07-19 when Pluma opened in the host's editor). netactview pends its
# local Guix package.
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;ClockCommand=\"i2kcal\";CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
