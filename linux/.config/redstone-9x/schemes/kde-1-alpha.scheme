# Redstone 9X Desktop Scheme — KDE 1 Alpha. The KDE 0.1 Pre-Alpha
# Motif/Windows-95 foundation, with the Alpha screenshot's black focused
# titlebar, KDE-Classic icon corpus, and procedurally reconstructed wallpaper.
SCHEME_TITLE="KDE 1 Alpha"
ICEWM_THEME="KDE-1-Alpha"
GTK_THEME="Motif95"
ICON_THEME="KDE-Classic"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#7995AA"
DESKTOP_ICON_LABEL_MODE="box"
DESKTOP_ICON_LABEL_BACKGROUND="#7995AA"
# Desktop icon labels and the lower-right build label are one colour contract.
# Both values must be literal colours together, or both must be "auto".
DESKTOP_LABEL_FOREGROUND="#ffffff"
DESKTOP_LABEL_SHADOW="#000000"
SEL_BG="#000080"
SEL_FG="#ffffff"
QT6CT_COLORS="win95.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="Motif95"
SOUND_SCHEME="kde-0.1"
FOX_BASE="#c0c0c0"
FOX_SEL_BG="#000080"
FOX_SEL_FG="#ffffff"
FOX_MENU_BG="#000080"
FOX_MENU_FG="#ffffff"
# The theme file carries this too. TITLE_ACTIVE is the authoritative
# scheme-apply override, so a shared-preference remnant cannot turn it navy.
TITLE_ACTIVE="#000000"
WALLPAPER="$HOME/.icewm/themes/KDE-1-Alpha/backgrounds/KDE_1_Alpha.png"
WALLPAPER_MODE="center"
BACKDROP_STYLE="palette-gradient"
BACKDROP_PALETTE="#306185,#487191,#61859D,#7995AA"
BACKDROP_SIZE="1920x1080"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;ClockCommand=\"i2kcal\";CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\";TaskBarShowWorkspaces=1"
