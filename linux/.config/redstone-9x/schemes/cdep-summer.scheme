# Redstone 9X Desktop Scheme — CDE Summer (raided CDE palette dynasty, 2026-07-20).
SCHEME_TITLE="CDE Summer"
ICEWM_THEME="CDE-Summer"
GTK_THEME="CDE-Summer"
ICON_THEME="Irixium"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#bcc5db"
SEL_BG="#ff5664"
SEL_FG="#000000"
QT6CT_COLORS="cdep-summer.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="CDE-Summer"
WINE_COLORS="cdep-summer.reg"
SOUND_SCHEME="cdep-summer"
WALLPAPER="$HOME/.icewm/themes/CDE-Summer/backgrounds/RakedSand.png"
WALLPAPER_MODE="tile"
FOX_BASE="#ffd690"
FOX_SEL_BG="#ff5664"
FOX_SEL_FG="#000000"
FOX_MENU_BG="#ff5664"
FOX_MENU_FG="#000000"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
