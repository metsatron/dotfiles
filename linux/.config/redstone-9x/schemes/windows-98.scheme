# Redstone 9X Desktop Scheme — Windows 98 (Windows dynasty, 2026-07-19). Plus! 98 base sounds; windowMax/Min/Restore wired into icesound.
SCHEME_TITLE="Windows 98"
ICEWM_THEME="Windows-95"
GTK_THEME="Windows-95"
ICON_THEME="Chicago95"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#008080"
SEL_BG="#000080"
SEL_FG="#ffffff"
QT6CT_COLORS="win95.conf"
SOUND_SCHEME="windows-98"
FOX_BASE="#c0c0c0"
FOX_SEL_BG="#000080"
FOX_SEL_FG="#ffffff"
FOX_MENU_BG="#000080"
FOX_MENU_FG="#ffffff"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
