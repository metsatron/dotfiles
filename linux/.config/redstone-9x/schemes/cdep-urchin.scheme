# Redstone 9X Desktop Scheme — CDE Urchin (raided CDE palette dynasty, 2026-07-20).
SCHEME_TITLE="CDE Urchin"
ICEWM_THEME="CDE-Urchin"
GTK_THEME="CDE-Urchin"
ICON_THEME="Irixium"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#328392"
SEL_BG="#d5a591"
SEL_FG="#000000"
QT6CT_COLORS="cdep-urchin.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="CDE-Urchin"
WINE_COLORS="cdep-urchin.reg"
SOUND_SCHEME="cdep-urchin"
WALLPAPER="$HOME/.icewm/themes/CDE-Urchin/backgrounds/Ankh.png"
WALLPAPER_MODE="center"
FOX_BASE="#0f7c7a"
FOX_SEL_BG="#d5a591"
FOX_SEL_FG="#000000"
FOX_MENU_BG="#d5a591"
FOX_MENU_FG="#000000"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
