# Redstone 9X Desktop Scheme — CDE Crimson (raided CDE palette dynasty, 2026-07-20).
SCHEME_TITLE="CDE Crimson"
ICEWM_THEME="CDE-Crimson"
GTK_THEME="CDE-Crimson"
ICON_THEME="Irixium"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#9793b5"
SEL_BG="#b24d7a"
SEL_FG="#ffffff"
QT6CT_COLORS="cdep-crimson.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="CDE-Crimson"
WINE_COLORS="cdep-crimson.reg"
SOUND_SCHEME="cdep-crimson"
WALLPAPER="$HOME/.icewm/themes/CDE-Crimson/backgrounds/Ankh.png"
WALLPAPER_MODE="center"
FOX_BASE="#aeb2c3"
FOX_SEL_BG="#b24d7a"
FOX_SEL_FG="#ffffff"
FOX_MENU_BG="#b24d7a"
FOX_MENU_FG="#ffffff"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;ClockCommand=\"i2kcal\";CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\";TaskBarShowWorkspaces=1"
