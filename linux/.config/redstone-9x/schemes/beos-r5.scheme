# Redstone 9X Desktop Scheme — BeOS Inspired (Be dynasty, 2026-07-20). The
# centrepiece: genuine yellow-tab IceWM chrome (Tverdov's BEOS-R5-inspired
# theme), the Bluecurve-BeOS GTK theme (Bluecurve/Slate recoloured to BeOS grey
# — carries a real gtk-4.0, unlike Blueshell which stopped at gtk-3.20 and left
# GTK4 apps on Adwaita), behand cursor, the BeOS R4 startup chime as the switch
# greeting.
SCHEME_TITLE="BeOS Inspired"
ICEWM_THEME="BeOS-r5"
GTK_THEME="Bluecurve-BeOS"
ICON_THEME="BeOS-r5-Icons"
MENU_BUTTON="beos-r5"
CURSOR_THEME="behand"
CURSOR_SIZE="24"
GTK_FONT="Swis721 BT 10"
# Optional desktop build-stamp style lives in the existing scheme declaration;
# the wrapper supplies every omitted key from stable Redstone defaults.
BUILDSTAMP_FOREGROUND="#000000"
BUILDSTAMP_SHADOW="#ffffff"
BUILDSTAMP_SHADOW_OFFSET=1
BUILDSTAMP_RIGHT_MARGIN=14
BUILDSTAMP_BOTTOM_MARGIN=12
# Neutral BeOS light grey — matches the chrome and desktop panel.
DESKTOP_BG="#d0d0d0"
# Light-grey desktop needs dark labels to stay readable.
DESKTOP_FG="#000000"
DESKTOP_ICON_LABEL_MODE="plain"
DESKTOP_ICON_LABEL_FOREGROUND="#000000"
# Selection = the BeOS-r5 GTK theme's own selected_bg_color, so GTK apps and
# the scheme's gtk.css/qt6ct highlight agree (Kvantum paints its own #c7c7c7).
SEL_BG="#989898"
SEL_FG="#000000"
QT6CT_COLORS="beos-r5.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="Besot"
SOUND_SCHEME="beos-r5"
# Wine classic colours — generated by redstone-9x-gtk-to-wine, derived from this
# scheme's GTK theme (Bluecurve-BeOS: #d8d8d8 face, #989898 selection) + IceWM
# titlebar (BeOS-r5 grey), so Wine apps line up with the GTK/Qt/FOX layers.
WINE_COLORS="beos-r5.reg"
# FOX toolkit registry — BeOS grey chrome, grey selection.
FOX_BASE="#d8d8d8"
FOX_SEL_BG="#989898"
FOX_SEL_FG="#000000"
FOX_MENU_BG="#d8d8d8"
FOX_MENU_FG="#000000"
# Same taskbar polish as the rest of the fleet (meters, far-right show-desktop,
# tray bevel). The BEOS-R5-inspired theme sets TaskBarAtTop=1 itself.
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";MEMStatusCommand=\"lxtask\";NetStatusCommand=\"netactview\""
