# Redstone 9X Desktop Scheme — BeOS R5 (Be dynasty, 2026-07-20). The centrepiece:
# genuine yellow-tab IceWM chrome, BeOS-grey GTK/Qt/FOX, behand cursor, the
# BeOS R4 startup chime as the switch greeting.
SCHEME_TITLE="BeOS R5"
ICEWM_THEME="BeOS-r5"
GTK_THEME="BeOS-r5"
ICON_THEME="BeOS-r5-Icons"
CURSOR_THEME="behand"
CURSOR_SIZE="24"
GTK_FONT="Sans 9"
# BeOS R5's default workspace blue — the canonical Be desktop teal-blue.
DESKTOP_BG="#31639e"
# Selection = the BeOS-r5 GTK theme's own selected_bg_color, so GTK apps and
# the scheme's gtk.css/qt6ct highlight agree (Kvantum paints its own #c7c7c7).
SEL_BG="#989898"
SEL_FG="#000000"
QT6CT_COLORS="beos-r5.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="Besot"
SOUND_SCHEME="beos-r5"
# FOX toolkit registry — BeOS grey chrome, grey selection.
FOX_BASE="#d8d8d8"
FOX_SEL_BG="#989898"
FOX_SEL_FG="#000000"
FOX_MENU_BG="#d8d8d8"
FOX_MENU_FG="#000000"
# Same taskbar polish as the rest of the fleet (meters, far-right show-desktop,
# tray bevel). The BEOS-R5-inspired theme sets TaskBarAtTop=1 itself.
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
