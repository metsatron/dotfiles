# Redstone 9X Desktop Scheme — CDE Chocolate (raided CDE palette dynasty, 2026-07-20).
SCHEME_TITLE="CDE Chocolate"
ICEWM_THEME="CDE-Chocolate"
GTK_THEME="CDE-Chocolate"
ICON_THEME="Irixium"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#9696b9"
SEL_BG="#a9a9ff"
SEL_FG="#000000"
QT6CT_COLORS="cdep-chocolate.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="CDE-Chocolate"
WINE_COLORS="cdep-chocolate.reg"
SOUND_SCHEME="cdep-chocolate"
WALLPAPER="$HOME/.icewm/themes/CDE-Chocolate/backgrounds/NoBackdrop.png"
WALLPAPER_MODE="center"
FOX_BASE="#708c8d"
FOX_SEL_BG="#a9a9ff"
FOX_SEL_FG="#000000"
FOX_MENU_BG="#a9a9ff"
FOX_MENU_FG="#000000"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;ClockCommand=\"i2kcal\";CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
