# Redstone 9X Desktop Scheme — CDE Wheat (raided CDE palette dynasty, 2026-07-20).
SCHEME_TITLE="CDE Wheat"
ICEWM_THEME="CDE-Wheat"
GTK_THEME="CDE-Wheat"
ICON_THEME="Irixium"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#5d7cb8"
SEL_BG="#d1a57a"
SEL_FG="#000000"
QT6CT_COLORS="cdep-wheat.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="CDE-Wheat"
WINE_COLORS="cdep-wheat.reg"
SOUND_SCHEME="cdep-wheat"
WALLPAPER="$HOME/.icewm/themes/CDE-Wheat/backgrounds/BrickWall.png"
WALLPAPER_MODE="tile"
FOX_BASE="#dbc291"
FOX_SEL_BG="#d1a57a"
FOX_SEL_FG="#000000"
FOX_MENU_BG="#d1a57a"
FOX_MENU_FG="#000000"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
