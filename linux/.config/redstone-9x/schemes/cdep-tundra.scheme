# Redstone 9X Desktop Scheme — CDE Tundra (raided CDE palette dynasty, 2026-07-20).
SCHEME_TITLE="CDE Tundra"
ICEWM_THEME="CDE-Tundra"
GTK_THEME="CDE-Tundra"
ICON_THEME="Irixium"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#837e75"
SEL_BG="#f1bc7f"
SEL_FG="#000000"
QT6CT_COLORS="cdep-tundra.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="CDE-Tundra"
WINE_COLORS="cdep-tundra.reg"
SOUND_SCHEME="cdep-tundra"
WALLPAPER="$HOME/.icewm/themes/CDE-Tundra/backgrounds/Toronto.png"
WALLPAPER_MODE="center"
FOX_BASE="#a59680"
FOX_SEL_BG="#f1bc7f"
FOX_SEL_FG="#000000"
FOX_MENU_BG="#f1bc7f"
FOX_MENU_FG="#000000"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;ClockCommand=\"i2kcal\";CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
