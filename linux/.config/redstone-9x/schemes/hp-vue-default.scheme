# Redstone 9X Desktop Scheme — HP-UX VUE proof of concept (2026-07-27).
# Forked from nIceCDE.Default; see the "HP-UX VUE (proof of concept)" section
# above for the full palette-derivation and IceWM-feasibility evidence.
SCHEME_TITLE="HP-UX VUE (PoC)"
ICEWM_THEME="HP-VUE"
MENU_BUTTON="hp-vue"
GTK_THEME="CDE-Orchid"
ICON_THEME="Irixium"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#524554"
DESKTOP_ICON_LABEL_MODE="box"
DESKTOP_ICON_LABEL_FOREGROUND="#ffffff"
DESKTOP_ICON_LABEL_BACKGROUND="#524554"
SEL_BG="#806580"
SEL_FG="#ffffff"
SOUND_SCHEME="hp-vue"
WALLPAPER="$HOME/.icewm/themes/HP-VUE/backgrounds/VUE_Desktop.png"
WALLPAPER_MODE="tile"
FOX_BASE="#beaabe"
FOX_SEL_BG="#806580"
FOX_SEL_FG="#ffffff"
FOX_MENU_BG="#806580"
FOX_MENU_FG="#ffffff"
ICEWM_PREFS="TaskBarDoubleHeight=1;TaskBarWorkspacesTop=1;TaskBarShowWorkspaces=1;TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;ClockCommand=\"i2kcal\";CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\";TaskBarGraphHeight=32;ClockFontNameXft=\"serif:size=16:bold\""
