# Redstone 9X Desktop Scheme — CDE Savannah (raided CDE palette dynasty, 2026-07-20).
SCHEME_TITLE="CDE Savannah"
ICEWM_THEME="CDE-Savannah"
GTK_THEME="CDE-Savannah"
ICON_THEME="Irixium"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#93abbf"
SEL_BG="#da9a68"
SEL_FG="#000000"
QT6CT_COLORS="cdep-savannah.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="CDE-Savannah"
WINE_COLORS="cdep-savannah.reg"
SOUND_SCHEME="cdep-savannah"
WALLPAPER="$HOME/.icewm/themes/CDE-Savannah/backgrounds/RakedSand.png"
WALLPAPER_MODE="center"
FOX_BASE="#b4aa94"
FOX_SEL_BG="#da9a68"
FOX_SEL_FG="#000000"
FOX_MENU_BG="#da9a68"
FOX_MENU_FG="#000000"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
