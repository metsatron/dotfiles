# Redstone 9X Desktop Scheme — CDE SoftBlue (raided CDE palette dynasty, 2026-07-20).
SCHEME_TITLE="CDE SoftBlue"
ICEWM_THEME="CDE-SoftBlue"
GTK_THEME="CDE-SoftBlue"
ICON_THEME="Irixium"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#5d7cb8"
SEL_BG="#7fa9eb"
SEL_FG="#000000"
QT6CT_COLORS="cdep-softblue.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="CDE-SoftBlue"
WINE_COLORS="cdep-softblue.reg"
SOUND_SCHEME="cdep-softblue"
WALLPAPER="$HOME/.icewm/themes/CDE-SoftBlue/backgrounds/BrickWall.png"
WALLPAPER_MODE="center"
FOX_BASE="#76a99c"
FOX_SEL_BG="#7fa9eb"
FOX_SEL_FG="#000000"
FOX_MENU_BG="#7fa9eb"
FOX_MENU_FG="#000000"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;ClockCommand=\"i2kcal\";CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\";TaskBarShowWorkspaces=1"
