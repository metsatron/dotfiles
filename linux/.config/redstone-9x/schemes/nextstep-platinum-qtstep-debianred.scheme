# Redstone 9X Desktop Scheme — Platinum / QTStep — DebianRed.
SCHEME_TITLE="Platinum — QTStep — DebianRed"
ICEWM_THEME="NextStep-Platinum-QTStep-DebianRed"
GTK_THEME="PLATINUM"
ICON_THEME="Redstone-Platinum"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Charcoal 9"
DESKTOP_BG="#58596e"
DESKTOP_ICON_LABEL_MODE="shadow"
DESKTOP_ICON_LABEL_FOREGROUND="#ffffff"
DESKTOP_ICON_LABEL_SHADOW_COLOR="#000000"
SEL_BG="#b30b3b"
SEL_FG="#ffffff"
QT6CT_COLORS="nextstep-qtstep-debianred.conf"
WINE_COLORS="nextstep-qtstep-debianred.reg"
QT_STYLE="Windows"
SOUND_SCHEME="nextstep"
FOX_BASE="#9294a8"
FOX_SEL_BG="#b30b3b"
FOX_SEL_FG="#ffffff"
FOX_MENU_BG="#9294a8"
FOX_MENU_FG="#000000"
NEXTSTEP_DOCKAPPS="0"
ICEWM_PREFS='TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetworkStatusDevice="en* wl* wg* tailscale*";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;ClockCommand="i2kcal";CPUStatusCommand="dbus-run-session mate-system-monitor";NetStatusCommand="netactview"'
