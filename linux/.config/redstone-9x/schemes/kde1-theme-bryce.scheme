# Redstone 9X — KDE 1 Theme — Bryce; first introduced 1999-09-06.
SCHEME_TITLE="KDE 1 Theme — Bryce [1999-09-06]"
ICEWM_THEME="KDE1-Theme-bryce"
GTK_THEME="KDE1-Theme-bryce"
ICON_THEME="KDE-1-Classic-Silver-Curated"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#494949"
DESKTOP_ICON_LABEL_MODE="box"
DESKTOP_ICON_LABEL_BACKGROUND="#494949"
DESKTOP_LABEL_FOREGROUND="#FFFFFF"
DESKTOP_LABEL_SHADOW="#000000"
SEL_BG="#046548"
SEL_FG="#000000"
QT6CT_COLORS="kde1-theme-bryce.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="KDE1-Theme-bryce"
SOUND_SCHEME="kde1-theme-bryce"
FOX_BASE="#494949"
FOX_SEL_BG="#046548"
FOX_SEL_FG="#000000"
FOX_MENU_BG="#046548"
FOX_MENU_FG="#000000"
WALLPAPER="$HOME/.icewm/themes/KDE1-Theme-bryce/backgrounds/bryce-1920x1080.png"
WALLPAPER_MODE="center"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;ClockCommand=\"i2kcal\";CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\";TaskBarShowWorkspaces=1"
