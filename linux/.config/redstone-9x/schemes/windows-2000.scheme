# Redstone 9X Desktop Scheme — Windows 2000 (Windows dynasty, 2026-07-19). Desktop is 2000's dusty blue; gradient frames from the ice2k Win2k theme.
SCHEME_TITLE="Windows 2000"
ICEWM_THEME="Win2kmod-xpm"
GTK_THEME="Windows-95"
ICON_THEME="Chicago95"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#3a6ea5"
SEL_BG="#000080"
SEL_FG="#ffffff"
QT6CT_COLORS="win95.conf"
SOUND_SCHEME="windows-2000"
FOX_BASE="#c0c0c0"
FOX_SEL_BG="#000080"
FOX_SEL_FG="#ffffff"
FOX_MENU_BG="#000080"
FOX_MENU_FG="#ffffff"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
