# Redstone 9X Desktop Scheme — Windows 2000 (Windows dynasty, 2026-07-19). Desktop is 2000's dusty blue; the -og ice2k variant carries the REAL
# #0A246A->#A6CAF0 dark-to-light gradient (the base variant is a recolour remix
# with the direction reversed — found live 2026-07-19).
SCHEME_TITLE="Windows 2000"
ICEWM_THEME="Windows-Classic"
GTK_THEME="Windows-Classic"
ICON_THEME="SE98"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#3a6ea5"
DESKTOP_ICON_LABEL_MODE="box"
DESKTOP_ICON_LABEL_FOREGROUND="#ffffff"
DESKTOP_ICON_LABEL_BACKGROUND="#3a6ea5"
SEL_BG="#000080"
SEL_FG="#ffffff"
QT6CT_COLORS="win95.conf"
SOUND_SCHEME="windows-2000"
# Windows 2000's 3D face is #d4d0c8, NOT Win95/98's #c0c0c0 silver — Microsoft
# lightened it for 2000/ME and kept it through XP's Classic theme. This was
# #c0c0c0 (found 2026-07-25), which put the FOX toolkit apps a full shade darker
# than this scheme's own IceWM theme, which had #d4d0c8 correct all along.
FOX_BASE="#d4d0c8"
FOX_SEL_BG="#000080"
FOX_SEL_FG="#ffffff"
FOX_MENU_BG="#000080"
FOX_MENU_FG="#ffffff"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;ClockCommand=\"i2kcal\";CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
