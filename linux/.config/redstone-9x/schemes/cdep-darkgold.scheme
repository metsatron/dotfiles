# Redstone 9X Desktop Scheme — CDE DarkGold (raided CDE palette dynasty, 2026-07-20).
SCHEME_TITLE="CDE DarkGold"
ICEWM_THEME="CDE-DarkGold"
GTK_THEME="CDE-DarkGold"
ICON_THEME="Irixium"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#6b94b2"
SEL_BG="#b89663"
SEL_FG="#000000"
QT6CT_COLORS="cdep-darkgold.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="CDE-DarkGold"
WINE_COLORS="cdep-darkgold.reg"
SOUND_SCHEME="cdep-darkgold"
WALLPAPER="$HOME/.icewm/themes/CDE-DarkGold/backgrounds/BrickWall.png"
WALLPAPER_MODE="tile"
