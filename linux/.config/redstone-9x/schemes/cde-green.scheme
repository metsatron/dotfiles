# Redstone 9X Desktop Scheme — CDE Green (nIceCDE dynasty, 2026-07-20).
SCHEME_TITLE="CDE Green"
ICEWM_THEME="nIceCDE.Green"
GTK_THEME="cdetheme"
ICON_THEME="Irixium"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#244953"
DESKTOP_ICON_LABEL_MODE="box"
DESKTOP_ICON_LABEL_FOREGROUND="#ffffff"
DESKTOP_ICON_LABEL_BACKGROUND="#244953"
SEL_BG="#3e708a"
SEL_FG="#ffffff"
QT6CT_COLORS="cde-green.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="commonalitygris"
SOUND_SCHEME="cde-green"
WALLPAPER="$HOME/.icewm/themes/nIceCDE.Green/backgrounds/Concave_greenishblue.png"
WALLPAPER_MODE="center"
FOX_BASE="#637e95"
FOX_SEL_BG="#3e708a"
FOX_SEL_FG="#ffffff"
FOX_MENU_BG="#3e708a"
FOX_MENU_FG="#ffffff"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;ClockCommand=\"i2kcal\";CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\";TaskBarShowWorkspaces=1"
