# Redstone 9X Desktop Scheme — Windows 3.1 (Windows dynasty, 2026-07-19). TADA on entry, chimes on exit, exactly as 3.1 did it.
SCHEME_TITLE="Windows 3.1"
ICEWM_THEME="Win31"
GTK_THEME="Windows-3.11"
ICON_THEME="Chicago95"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#c0c7c8"
SEL_BG="#0000C8"
SEL_FG="#ffffff"
QT6CT_COLORS="win95.conf"
SOUND_SCHEME="windows-3x"
FOX_BASE="#c0c0c0"
FOX_SEL_BG="#0000C8"
FOX_SEL_FG="#ffffff"
FOX_MENU_BG="#0000C8"
FOX_MENU_FG="#ffffff"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
