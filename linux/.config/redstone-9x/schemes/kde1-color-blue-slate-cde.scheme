# Redstone 9X — KDE 1 Color — Blue Slate · CDE widgets; first introduced 1998-03-22.
SCHEME_TITLE="KDE 1 Color — Blue Slate · CDE widgets [1998-03-22]"
ICEWM_THEME="KDE1-Color-blue-slate"
GTK_THEME="KDE1-Color-blue-slate-cde"
ICON_THEME="KDE-1-Classic-Silver-Curated"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#9DB9C8"
DESKTOP_ICON_LABEL_MODE="box"
DESKTOP_ICON_LABEL_BACKGROUND="#9DB9C8"
DESKTOP_LABEL_FOREGROUND="#000000"
DESKTOP_LABEL_SHADOW="#FFFFFF"
SEL_BG="#558097"
SEL_FG="#FFFFFF"
QT6CT_COLORS="kde1-color-blue-slate-cde.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="KDE1-Color-blue-slate-cde"
SOUND_SCHEME="kde-0.1"
FOX_BASE="#9DB9C8"
FOX_SEL_BG="#558097"
FOX_SEL_FG="#FFFFFF"
FOX_MENU_BG="#558097"
FOX_MENU_FG="#FFFFFF"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;ClockCommand=\"i2kcal\";CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\";TaskBarShowWorkspaces=1"
