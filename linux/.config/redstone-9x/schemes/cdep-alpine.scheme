# Redstone 9X Desktop Scheme — CDE Alpine (raided CDE palette dynasty, 2026-07-20).
SCHEME_TITLE="CDE Alpine"
ICEWM_THEME="CDE-Alpine"
GTK_THEME="CDE-Alpine"
ICON_THEME="Irixium"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#bfc0c5"
SEL_BG="#afbffb"
SEL_FG="#000000"
QT6CT_COLORS="cdep-alpine.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="CDE-Alpine"
WINE_COLORS="cdep-alpine.reg"
SOUND_SCHEME="cdep-alpine"
WALLPAPER="$HOME/.icewm/themes/CDE-Alpine/backgrounds/Ankh.png"
WALLPAPER_MODE="center"
FOX_BASE="#78aab8"
FOX_SEL_BG="#afbffb"
FOX_SEL_FG="#000000"
FOX_MENU_BG="#afbffb"
FOX_MENU_FG="#000000"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;ClockCommand=\"i2kcal\";CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
