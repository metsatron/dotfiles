# Redstone 9X — Redstone 9X KDE Alpha MacOS Retromod; first introduced 1998-12-03.
SCHEME_TITLE="Redstone 9X KDE Alpha MacOS Retromod [1998-12-03]"
ICEWM_THEME="KDE1-Theme-macos"
GTK_THEME="PLATINUM"
ICON_THEME="KDE-1-Classic-Silver-MacOS"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Charcoal 8"
DESKTOP_BG="#6C779E"
DESKTOP_ICON_LABEL_MODE="box"
DESKTOP_ICON_LABEL_BACKGROUND="#6C779E"
DESKTOP_LABEL_FOREGROUND="#FFFFFF"
DESKTOP_LABEL_SHADOW="#000000"
SEL_BG="#31319C"
SEL_FG="#FFFFFF"
QT6CT_COLORS="kde1-theme-macos.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="KDE1-Theme-macos-platinum"
SOUND_SCHEME="kde1-theme-macos"
FOX_BASE="#CECECE"
FOX_SEL_BG="#31319C"
FOX_SEL_FG="#FFFFFF"
FOX_MENU_BG="#31319C"
FOX_MENU_FG="#FFFFFF"
WALLPAPER="$HOME/.icewm/themes/KDE1-Theme-macos/backgrounds/macos-blue-texture-1920x1080.png"
WALLPAPER_MODE="center"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;ClockCommand=\"i2kcal\";CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\";TaskBarShowWorkspaces=1"
