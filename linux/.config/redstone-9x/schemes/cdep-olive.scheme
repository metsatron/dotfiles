# Redstone 9X Desktop Scheme — CDE Olive (raided CDE palette dynasty, 2026-07-20).
SCHEME_TITLE="CDE Olive"
ICEWM_THEME="CDE-Olive"
GTK_THEME="CDE-Olive"
ICON_THEME="Irixium"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#9a919a"
SEL_BG="#83835a"
SEL_FG="#ffffff"
QT6CT_COLORS="cdep-olive.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="commonalitygris"
WINE_COLORS="cdep-olive.reg"
SOUND_SCHEME="cdep-olive"
WALLPAPER="$HOME/.icewm/themes/CDE-Olive/backgrounds/RakedSand.png"
WALLPAPER_MODE="tile"
FOX_BASE="#c3c3b9"
FOX_SEL_BG="#83835a"
FOX_SEL_FG="#ffffff"
FOX_MENU_BG="#83835a"
FOX_MENU_FG="#ffffff"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
