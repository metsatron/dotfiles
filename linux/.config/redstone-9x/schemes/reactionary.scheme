# Redstone 9X Desktop Scheme — Reactionary (converted from official .theme by
# redstone-9x-theme-convert; colours are the file's own, gradient endpoints
# synthesized 50%-to-white when the file predates gradient keys).
SCHEME_TITLE="Reactionary"
ICEWM_THEME="Reactionary"
MENU_BUTTON=""
GTK_THEME="Reactionary"
ICON_THEME="Reactionary"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#3D6497"
DESKTOP_ICON_LABEL_MODE="box"
DESKTOP_ICON_LABEL_FOREGROUND="#ffffff"
DESKTOP_ICON_LABEL_BACKGROUND="#3D6497"
SEL_BG="#568CD2"
SEL_FG="#FFFFFF"
QT6CT_COLORS="reactionary.conf"
SOUND_SCHEME="windows-2000"
WINE_COLORS="reactionary.reg"
FOX_BASE="#D3D0C7"
FOX_FG="#000000"
FOX_BG="#FFFFFF"
FOX_SEL_BG="#568CD2"
FOX_SEL_FG="#FFFFFF"
FOX_MENU_BG="#568CD2"
FOX_MENU_FG="#FFFFFF"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;ClockCommand=\"i2kcal\";CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
WALLPAPER="$HOME/.local/share/redstone-9x/wallpapers/reactionary.jpg"
WALLPAPER_MODE="crop"
