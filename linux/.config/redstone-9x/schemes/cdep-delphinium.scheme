# Redstone 9X Desktop Scheme — CDE Delphinium (raided CDE palette dynasty, 2026-07-20).
SCHEME_TITLE="CDE Delphinium"
ICEWM_THEME="CDE-Delphinium"
GTK_THEME="CDE-Delphinium"
ICON_THEME="Irixium"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#90a0be"
SEL_BG="#85c4ed"
SEL_FG="#000000"
QT6CT_COLORS="cdep-delphinium.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="CDE-Delphinium"
WINE_COLORS="cdep-delphinium.reg"
SOUND_SCHEME="cdep-delphinium"
WALLPAPER="$HOME/.icewm/themes/CDE-Delphinium/backgrounds/RakedSand.png"
WALLPAPER_MODE="center"
FOX_BASE="#c8c8c8"
FOX_SEL_BG="#85c4ed"
FOX_SEL_FG="#000000"
FOX_MENU_BG="#85c4ed"
FOX_MENU_FG="#000000"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
