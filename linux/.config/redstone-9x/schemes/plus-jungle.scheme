# Redstone 9X Desktop Scheme — Jungle (converted from official .theme by
# redstone-9x-theme-convert; colours are the file's own, gradient endpoints
# synthesized 50%-to-white when the file predates gradient keys).
SCHEME_TITLE="Jungle"
ICEWM_THEME="Jungle"
GTK_THEME="Jungle"
ICON_THEME="Win98SE"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#808080"
SEL_BG="#800000"
SEL_FG="#F09010"
QT6CT_COLORS="plus-jungle.conf"
SOUND_SCHEME="plus-jungle"
WINE_COLORS="plus-jungle.reg"
FOX_BASE="#B8A068"
FOX_FG="#000000"
FOX_BG="#FFFFFF"
FOX_SEL_BG="#800000"
FOX_SEL_FG="#F09010"
FOX_MENU_BG="#800000"
FOX_MENU_FG="#F09010"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
