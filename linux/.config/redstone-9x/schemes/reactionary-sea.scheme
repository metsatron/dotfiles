# Redstone 9X Desktop Scheme — ReactionarySea (converted from official .theme by
# redstone-9x-theme-convert; colours are the file's own, gradient endpoints
# synthesized 50%-to-white when the file predates gradient keys).
SCHEME_TITLE="Reactionary Sea"
ICEWM_THEME="ReactionarySea"
MENU_BUTTON=""
GTK_THEME="ReactionarySea"
ICON_THEME="SE98"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#022E5B"
DESKTOP_ICON_LABEL_MODE="box"
DESKTOP_ICON_LABEL_FOREGROUND="#ffffff"
DESKTOP_ICON_LABEL_BACKGROUND="#022E5B"
SEL_BG="#04407F"
SEL_FG="#FFFFFF"
QT6CT_COLORS="reactionary-sea.conf"
SOUND_SCHEME="windows-2000"
WINE_COLORS="reactionary-sea.reg"
FOX_BASE="#A7CAF0"
FOX_FG="#000000"
FOX_BG="#FFFFFF"
FOX_SEL_BG="#04407F"
FOX_SEL_FG="#FFFFFF"
FOX_MENU_BG="#04407F"
FOX_MENU_FG="#FFFFFF"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;ClockCommand=\"i2kcal\";CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
WALLPAPER="$HOME/.local/share/redstone-9x/wallpapers/reactionary-sea.jpg"
WALLPAPER_MODE="center"
