# Redstone 9X Desktop Scheme — CDE SantaFe (raided CDE palette dynasty, 2026-07-20).
SCHEME_TITLE="CDE SantaFe"
ICEWM_THEME="CDE-SantaFe"
GTK_THEME="CDE-SantaFe"
ICON_THEME="Irixium"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#9c9992"
SEL_BG="#ef9d9d"
SEL_FG="#000000"
QT6CT_COLORS="cdep-santafe.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="CDE-SantaFe"
WINE_COLORS="cdep-santafe.reg"
SOUND_SCHEME="cdep-santafe"
