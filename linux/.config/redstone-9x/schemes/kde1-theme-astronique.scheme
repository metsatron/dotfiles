# Redstone 9X — KDE 1 Theme — Astronique; first introduced 1999-08-23.
SCHEME_TITLE="KDE 1 Theme — Astronique [1999-08-23]"
ICEWM_THEME="KDE1-Theme-astronique"
GTK_THEME="KDE1-Theme-astronique"
ICON_THEME="KDE-1-Classic-Silver-Curated"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#545454"
DESKTOP_ICON_LABEL_MODE="box"
DESKTOP_ICON_LABEL_BACKGROUND="#545454"
DESKTOP_LABEL_FOREGROUND="#FFFFFF"
DESKTOP_LABEL_SHADOW="#000000"
SEL_BG="#800000"
SEL_FG="#FFFFFF"
QT6CT_COLORS="kde1-theme-astronique.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="KDE1-Theme-astronique"
SOUND_SCHEME="kde1-theme-astronique"
FOX_BASE="#545454"
FOX_SEL_BG="#800000"
FOX_SEL_FG="#FFFFFF"
FOX_MENU_BG="#800000"
FOX_MENU_FG="#FFFFFF"
FOX_FG="#FFFFFF"
FOX_BG="#808080"
FOX_HILITE="#7F7F7F"
FOX_SHADOW="#2A2A2A"
FOX_BORDER="#000000"
FOX_FOCUS="#FFFFFF"
WALLPAPER="$HOME/.icewm/themes/KDE1-Theme-astronique/backgrounds/astronique-1920x1080.png"
WALLPAPER_MODE="center"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;ClockCommand=\"i2kcal\";CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\";TaskBarShowWorkspaces=1"
