# Redstone 9X Desktop Scheme — CDE Default (raided CDE palette dynasty, 2026-07-20).
SCHEME_TITLE="CDE Default"
ICEWM_THEME="CDE-Default"
GTK_THEME="CDE-Default"
ICON_THEME="Irixium"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#93abbf"
SEL_BG="#eda870"
SEL_FG="#000000"
QT6CT_COLORS="cdep-default.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="CDE-Default"
WINE_COLORS="cdep-default.reg"
SOUND_SCHEME="cdep-default"
WALLPAPER="$HOME/.icewm/themes/CDE-Default/backgrounds/NoBackdrop.png"
WALLPAPER_MODE="tile"
FOX_BASE="#999999"
FOX_SEL_BG="#eda870"
FOX_SEL_FG="#000000"
FOX_MENU_BG="#eda870"
FOX_MENU_FG="#000000"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
