# Redstone 9X Desktop Scheme — Platinum / QTStep — Beige.
SCHEME_TITLE="Platinum — QTStep — Beige"
ICEWM_THEME="KDE1-Theme-tosh"
GTK_THEME="NextStep-QTStep-Beige"
ICON_THEME="NineIcons"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="TeX Gyre Heros 9"
DESKTOP_BG="#706f7a"
DESKTOP_ICON_LABEL_MODE="shadow"
DESKTOP_ICON_LABEL_FOREGROUND="#ffffff"
DESKTOP_ICON_LABEL_SHADOW_COLOR="#000000"
SEL_BG="#b1a995"
SEL_FG="#000000"
QT6CT_COLORS="nextstep-qtstep-beige.conf"
WINE_COLORS="nextstep-qtstep-beige.reg"
QT_STYLE="Windows"
SOUND_SCHEME="nextstep"
FOX_BASE="#d4d0c8"
FOX_SEL_BG="#b1a995"
FOX_SEL_FG="#000000"
FOX_MENU_BG="#d4d0c8"
FOX_MENU_FG="#000000"
NEXTSTEP_DOCKAPPS="0"
ICEWM_PREFS='TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetworkStatusDevice="en* wl* wg* tailscale*";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;ClockCommand="i2kcal";CPUStatusCommand="dbus-run-session mate-system-monitor";NetStatusCommand="netactview"'
