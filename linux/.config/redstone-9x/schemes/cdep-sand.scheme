# Redstone 9X Desktop Scheme — CDE Sand (raided CDE palette dynasty, 2026-07-20).
SCHEME_TITLE="CDE Sand"
ICEWM_THEME="CDE-Sand"
GTK_THEME="CDE-Sand"
ICON_THEME="Irixium"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#969696"
SEL_BG="#eabe93"
SEL_FG="#000000"
QT6CT_COLORS="cdep-sand.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="CDE-Sand"
WINE_COLORS="cdep-sand.reg"
SOUND_SCHEME="cdep-sand"
WALLPAPER="$HOME/.icewm/themes/CDE-Sand/backgrounds/BrickWall.png"
WALLPAPER_MODE="tile"
FOX_BASE="#c7afaf"
FOX_SEL_BG="#eabe93"
FOX_SEL_FG="#000000"
FOX_MENU_BG="#eabe93"
FOX_MENU_FG="#000000"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
