# Redstone 9X Desktop Scheme — Rhapsody / QTStep — OpenStep Antiford.
SCHEME_TITLE="Rhapsody — QTStep — OpenStep Antiford"
ICEWM_THEME="NextStep-Rhapsody-QTStep-OpenStep-Antiford"
GTK_THEME="PLATINUM"
ICON_THEME="Redstone-Rhapsody"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Charcoal 9"
DESKTOP_BG="#60616f"
DESKTOP_ICON_LABEL_MODE="shadow"
DESKTOP_ICON_LABEL_FOREGROUND="#ffffff"
DESKTOP_ICON_LABEL_SHADOW_COLOR="#000000"
SEL_BG="#42413f"
SEL_FG="#ffffff"
QT6CT_COLORS="nextstep-qtstep-openstep-antiford.conf"
WINE_COLORS="nextstep-qtstep-openstep-antiford.reg"
QT_STYLE="Windows"
SOUND_SCHEME="nextstep"
FOX_BASE="#aaaaaa"
FOX_SEL_BG="#42413f"
FOX_SEL_FG="#ffffff"
FOX_MENU_BG="#aaaaaa"
FOX_MENU_FG="#000000"
NEXTSTEP_DOCKAPPS="0"
ICEWM_PREFS='TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetworkStatusDevice="en* wl* wg* tailscale*";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;ClockCommand="i2kcal";CPUStatusCommand="dbus-run-session mate-system-monitor";NetStatusCommand="netactview"'
