# Redstone 9X Desktop Scheme — Windows 95 (the founding look, byte-identical
# to the pre-scheme configuration). Shell-sourceable KEY=VALUE.
SCHEME_TITLE="Windows 95"
ICEWM_THEME="Windows-95"
GTK_THEME="Windows-95"
ICON_THEME="Chicago95"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#008080"
SEL_BG="#000080"
SEL_FG="#ffffff"
QT6CT_COLORS="win95.conf"
SOUND_SCHEME="windows-95"
# FOX toolkit registry colours (~/.foxrc/Desktop [SETTINGS]) — xfe, adie,
# PathFinder, calculator, ice2k FOX apps all follow.
FOX_BASE="#c0c0c0"
FOX_SEL_BG="#000080"
FOX_SEL_FG="#ffffff"
FOX_MENU_BG="#000080"
FOX_MENU_FG="#ffffff"
# No taskbar overrides: the Windows 95 taskbar inherits ~/.icewm/preferences
# untouched (CPU meter off, show-desktop button at its default left slot —
# exactly the founding configuration).
ICEWM_PREFS=""
