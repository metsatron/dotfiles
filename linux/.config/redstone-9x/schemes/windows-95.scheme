# Redstone 9X Desktop Scheme — Windows 95 (the founding look, byte-identical
# to the pre-scheme configuration). Shell-sourceable KEY=VALUE.
SCHEME_TITLE="Windows 95"
ICEWM_THEME="Windows-95"
GTK_THEME="Windows-95"
ICON_THEME="Chicago95"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#008080"
SEL_BG="#000080"
SEL_FG="#ffffff"
QT6CT_COLORS="win95.conf"
SOUND_SCHEME="windows-95"
# FOX toolkit registry colours (~/.foxrc/Desktop [SETTINGS]) — xfe, adie,
# PathFinder, calculator, ice2k FOX apps all follow.
FOX_BASE="#c0c0c0"
FOX_SEL_BG="#000080"
FOX_SEL_FG="#ffffff"
FOX_MENU_BG="#000080"
FOX_MENU_FG="#ffffff"
# Mètsàtron's decree (2026-07-19, superseding byte-authenticity): the Win95
# taskbar carries the SAME polish as SerenityOS — full meter row, far-right
# show-desktop, tray bevel, monitor/netactview click-throughs. Meter colours
# live in the Windows-95 IceWM theme file (Task-Manager greens).
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";MEMStatusCommand=\"lxtask\";NetStatusCommand=\"netactview\""
