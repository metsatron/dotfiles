# Redstone 9X — KDE 1 Theme — Wood; first introduced 1998-12-03.
SCHEME_TITLE="KDE 1 Theme — Wood [1998-12-03]"
ICEWM_THEME="KDE1-Theme-wood"
GTK_THEME="KDE1-Theme-wood"
ICON_THEME="KDE-1-Classic-Silver-Curated"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#AFB49F"
DESKTOP_ICON_LABEL_MODE="box"
DESKTOP_ICON_LABEL_BACKGROUND="#AFB49F"
DESKTOP_LABEL_FOREGROUND="#000000"
DESKTOP_LABEL_SHADOW="#FFFFFF"
SEL_BG="#035A00"
SEL_FG="#FFFFFF"
QT6CT_COLORS="kde1-theme-wood.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="KDE1-Theme-wood"
SOUND_SCHEME="kde1-theme-wood"
FOX_BASE="#AFB49F"
FOX_SEL_BG="#035A00"
FOX_SEL_FG="#FFFFFF"
FOX_MENU_BG="#035A00"
FOX_MENU_FG="#FFFFFF"
FOX_FG="#035A00"
FOX_BG="#CAFFC4"
FOX_HILITE="#FFFFFF"
FOX_SHADOW="#808080"
FOX_BORDER="#000000"
FOX_FOCUS="#035A00"
WALLPAPER="$HOME/.icewm/themes/KDE1-Theme-wood/backgrounds/wood-1920x1080.png"
WALLPAPER_MODE="center"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;ClockCommand=\"i2kcal\";CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\";TaskBarShowWorkspaces=1"
