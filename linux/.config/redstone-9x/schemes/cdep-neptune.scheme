# Redstone 9X Desktop Scheme — CDE Neptune (raided CDE palette dynasty, 2026-07-20).
SCHEME_TITLE="CDE Neptune"
ICEWM_THEME="CDE-Neptune"
GTK_THEME="CDE-Neptune"
ICON_THEME="Irixium"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#616d8e"
SEL_BG="#a2e5c6"
SEL_FG="#000000"
QT6CT_COLORS="cdep-neptune.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="commonalitygris"
WINE_COLORS="cdep-neptune.reg"
SOUND_SCHEME="cdep-neptune"
WALLPAPER="$HOME/.icewm/themes/CDE-Neptune/backgrounds/Ankh.png"
WALLPAPER_MODE="tile"
FOX_BASE="#3f938d"
FOX_SEL_BG="#a2e5c6"
FOX_SEL_FG="#000000"
FOX_MENU_BG="#a2e5c6"
FOX_MENU_FG="#000000"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
