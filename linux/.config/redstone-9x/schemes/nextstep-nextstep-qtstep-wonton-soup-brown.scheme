# Redstone 9X Desktop Scheme — NeXTSTEP/OpenStep / QTStep — Wonton Soup Brown.
SCHEME_TITLE="NeXTSTEP/OpenStep — QTStep — Wonton Soup Brown"
ICEWM_THEME="NextStep-NeXT-QTStep-Wonton-Soup-Brown"
GTK_THEME="NextStep-QTStep-Wonton-Soup-Brown"
ICON_THEME="NeXTSTEP-Complete"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Charcoal 9"
DESKTOP_BG="#474750"
DESKTOP_ICON_LABEL_MODE="shadow"
DESKTOP_ICON_LABEL_FOREGROUND="#ffffff"
DESKTOP_ICON_LABEL_SHADOW_COLOR="#000000"
SEL_BG="#b1a995"
SEL_FG="#000000"
QT6CT_COLORS="nextstep-qtstep-wonton-soup-brown.conf"
WINE_COLORS="nextstep-qtstep-wonton-soup-brown.reg"
QT_STYLE="Windows"
SOUND_SCHEME="nextstep"
FOX_BASE="#635f52"
FOX_SEL_BG="#b1a995"
FOX_SEL_FG="#000000"
FOX_MENU_BG="#635f52"
FOX_MENU_FG="#ffffff"
NEXTSTEP_DOCKAPPS="1"
ICEWM_PREFS='TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetworkStatusDevice="en* wl* wg* tailscale*";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;ClockCommand="i2kcal";CPUStatusCommand="dbus-run-session mate-system-monitor";NetStatusCommand="netactview";DockApps="right high dock"'
