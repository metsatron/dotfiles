# Redstone 9X Desktop Scheme — CDE Orchid (raided CDE palette dynasty, 2026-07-20).
SCHEME_TITLE="CDE Orchid"
ICEWM_THEME="CDE-Orchid"
GTK_THEME="CDE-Orchid"
ICON_THEME="Irixium"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#b0b0bf"
SEL_BG="#b9b9ff"
SEL_FG="#000000"
QT6CT_COLORS="cdep-orchid.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="CDE-Orchid"
WINE_COLORS="cdep-orchid.reg"
SOUND_SCHEME="cdep-orchid"
WALLPAPER="$HOME/.icewm/themes/CDE-Orchid/backgrounds/Toronto.png"
WALLPAPER_MODE="center"
FOX_BASE="#9b9bb9"
FOX_SEL_BG="#b9b9ff"
FOX_SEL_FG="#000000"
FOX_MENU_BG="#b9b9ff"
FOX_MENU_FG="#000000"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
