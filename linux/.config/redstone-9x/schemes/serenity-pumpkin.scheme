ICEWM_THEME="Serenity-Pumpkin"
MENU_BUTTON="serenity"
GTK_THEME="Serenity-Pumpkin"
ICON_THEME="Serenity95"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#BF600C"
SEL_BG="#6F517B"
SEL_FG="#FFFFFF"
QT6CT_COLORS="serenity-pumpkin.conf"
SOUND_SCHEME="serenity"
WINE_COLORS="serenity-pumpkin.reg"
FOX_BASE="#C7C2B0"
FOX_FG="#000000"
FOX_BG="#FFFFFF"
FOX_SEL_BG="#6F517B"
FOX_SEL_FG="#FFFFFF"
FOX_MENU_BG="#6F517B"
