# Redstone 9X Desktop Scheme — CDE Arizona (raided CDE palette dynasty, 2026-07-20).
SCHEME_TITLE="CDE Arizona"
ICEWM_THEME="CDE-Arizona"
GTK_THEME="CDE-Arizona"
ICON_THEME="Irixium"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#84545f"
SEL_BG="#ffab78"
SEL_FG="#000000"
QT6CT_COLORS="cdep-arizona.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="CDE-Arizona"
WINE_COLORS="cdep-arizona.reg"
SOUND_SCHEME="cdep-arizona"
WALLPAPER="$HOME/.icewm/themes/CDE-Arizona/backgrounds/BrickWall.png"
WALLPAPER_MODE="center"
FOX_BASE="#a86b79"
FOX_SEL_BG="#ffab78"
FOX_SEL_FG="#000000"
FOX_MENU_BG="#ffab78"
FOX_MENU_FG="#000000"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
