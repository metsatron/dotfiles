# Redstone 9X Desktop Scheme — CDE Crimson (nIceCDE dynasty, 2026-07-20).
SCHEME_TITLE="CDE Crimson"
ICEWM_THEME="nIceCDE.Crimson"
GTK_THEME="cdetheme"
ICON_THEME="Irixium"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#574c8f"
DESKTOP_ICON_LABEL_MODE="box"
DESKTOP_ICON_LABEL_FOREGROUND="#ffffff"
DESKTOP_ICON_LABEL_BACKGROUND="#574c8f"
SEL_BG="#b24d7a"
SEL_FG="#ffffff"
QT6CT_COLORS="cde-crimson.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="commonalitygris"
SOUND_SCHEME="cde-crimson"
WALLPAPER="$HOME/.icewm/themes/nIceCDE.Crimson/backgrounds/Solaris.png"
WALLPAPER_MODE="center"
FOX_BASE="#afb2c3"
FOX_SEL_BG="#b24d7a"
FOX_SEL_FG="#ffffff"
FOX_MENU_BG="#b24d7a"
FOX_MENU_FG="#ffffff"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;ClockCommand=\"i2kcal\";CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\";TaskBarShowWorkspaces=1"
