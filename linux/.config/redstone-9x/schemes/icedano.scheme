# Redstone 9X Desktop Scheme — icedano (raw) (Be tab dynasty, 2026-07-23). The
# untouched upstream fork, for reference: original wrong buttons, navy accent,
# slate desktop, and flat panel exactly as J.S. shipped it in 2005. Non-chrome
# layers borrow the BeOS family so GTK/Qt apps stay themed.
SCHEME_TITLE="icedano (raw)"
ICEWM_THEME="icedano"
# Wine classic colours: the neutral BeOS grey palette (icedano has no distinct
# app-colour identity of its own).
WINE_COLORS="beos-r5.reg"
GTK_THEME="BeOS-r5"
ICON_THEME="BeOS-r5-Icons"
CURSOR_THEME="behand"
CURSOR_SIZE="24"
GTK_FONT="Swis721 BT 10"
# icedano's own slate-blue desktop (rgb:74/80/93).
DESKTOP_BG="#748093"
DESKTOP_ICON_LABEL_MODE="shadow"
DESKTOP_ICON_LABEL_FOREGROUND="#ffffff"
DESKTOP_ICON_LABEL_SHADOW_COLOR="#000000"
SEL_BG="#989898"
SEL_FG="#000000"
QT6CT_COLORS="beos-r5.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="Besot"
SOUND_SCHEME="beos-r5"
FOX_BASE="#d8d8d8"
FOX_SEL_BG="#989898"
FOX_SEL_FG="#000000"
FOX_MENU_BG="#d8d8d8"
FOX_MENU_FG="#000000"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";MEMStatusCommand=\"lxtask\";NetStatusCommand=\"netactview\""
