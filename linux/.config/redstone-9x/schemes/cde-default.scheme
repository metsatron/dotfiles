# Redstone 9X Desktop Scheme — CDE Default (nIceCDE dynasty, 2026-07-20).
# Titlebar/backdrop tones sampled from the theme's own pixmaps (titleAM.xpm,
# backgrounds/Paver.xpm); menu/button/selection from default.theme Color* keys.
SCHEME_TITLE="CDE Default"
ICEWM_THEME="nIceCDE.Default"
GTK_THEME="cdetheme"
ICON_THEME="Irixium"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#625347"
DESKTOP_ICON_LABEL_MODE="box"
DESKTOP_ICON_LABEL_FOREGROUND="#ffffff"
DESKTOP_ICON_LABEL_BACKGROUND="#625347"
SEL_BG="#eda870"
SEL_FG="#ffffff"
QT6CT_COLORS="cde-default.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="commonalitygris"
SOUND_SCHEME="cde-default"
WALLPAPER="$HOME/.icewm/themes/nIceCDE.Default/backgrounds/Paver.png"
WALLPAPER_MODE="center"
FOX_BASE="#beafaa"
FOX_SEL_BG="#eda870"
FOX_SEL_FG="#ffffff"
FOX_MENU_BG="#eda870"
FOX_MENU_FG="#ffffff"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;ClockCommand=\"i2kcal\";CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\";TaskBarShowWorkspaces=1"
