# Redstone 9X Desktop Scheme — BeOS Personal Edition (Be dynasty variant of
# BeOS Inspired, 2026-07-21). Shares the icons, behand cursor, Qt/FOX and sound
# base; the distinct layer is the BeOS-r5 GTK theme plus its own BeOS-Personal
# IceWM theme — the iconic tab recoloured terracotta (from R5's yellow) — over a
# deep teal desktop.
SCHEME_TITLE="BeOS Personal"
ICEWM_THEME="BeOS-Personal"
GTK_THEME="BeOS-r5"
ICON_THEME="BeOS-r5-Icons"
MENU_BUTTON="beos-personal"
CURSOR_THEME="behand"
CURSOR_SIZE="24"
GTK_FONT="Sans 9"
# Deep teal desktop — white labels stay readable on it (scheme-apply default).
DESKTOP_BG="#3f6e7e"
# Titlebar colour-fill behind the tab text, matched to the BeOS-Personal tab
# pixmaps: warm terracotta when focused, near-white when not.
TITLE_ACTIVE="#be816c"
TITLE_INACTIVE="#eaeaea"
SEL_BG="#989898"
SEL_FG="#000000"
QT6CT_COLORS="beos-r5.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="Besot"
SOUND_SCHEME="beos-r5"
FOX_BASE="#d8d8d8"
FOX_SEL_BG="#989898"
FOX_SEL_FG="#000000"
FOX_MENU_BG="#d8d8d8"
FOX_MENU_FG="#000000"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
