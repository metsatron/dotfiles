# Redstone 9X Desktop Scheme — CDE Clay (raided CDE palette dynasty, 2026-07-20).
SCHEME_TITLE="CDE Clay"
ICEWM_THEME="CDE-Clay"
GTK_THEME="CDE-Clay"
ICON_THEME="Irixium"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#2f8b8d"
SEL_BG="#ffaaaa"
SEL_FG="#000000"
QT6CT_COLORS="cdep-clay.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="CDE-Clay"
WINE_COLORS="cdep-clay.reg"
SOUND_SCHEME="cdep-clay"
WALLPAPER="$HOME/.icewm/themes/CDE-Clay/backgrounds/Toronto.png"
WALLPAPER_MODE="tile"
FOX_BASE="#968282"
FOX_SEL_BG="#ffaaaa"
FOX_SEL_FG="#000000"
FOX_MENU_BG="#ffaaaa"
FOX_MENU_FG="#000000"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
