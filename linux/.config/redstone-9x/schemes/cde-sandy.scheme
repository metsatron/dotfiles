# Redstone 9X Desktop Scheme — CDE Sandy (nIceCDE dynasty, 2026-07-20). The
# upstream theme's own DesktopBackgroundImage key points at the Mustard
# variant's backgrounds dir (an upstream cross-reference quirk) — the same
# file also exists inside Sandy's own backgrounds/, so WALLPAPER below uses
# Sandy's own copy rather than reproducing the cross-theme path.
SCHEME_TITLE="CDE Sandy"
ICEWM_THEME="nIceCDE.Sandy"
GTK_THEME="cdetheme"
ICON_THEME="Irixium"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#b6aea9"
SEL_BG="#b3aa94"
SEL_FG="#ffffff"
QT6CT_COLORS="cde-sandy.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="Commonality"
SOUND_SCHEME="cde-sandy"
WALLPAPER="$HOME/.icewm/themes/nIceCDE.Sandy/backgrounds/Sprinkles_sand.xpm"
WALLPAPER_MODE="tile"
FOX_BASE="#93abbe"
FOX_SEL_BG="#b3aa94"
FOX_SEL_FG="#ffffff"
FOX_MENU_BG="#b3aa94"
FOX_MENU_FG="#ffffff"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
