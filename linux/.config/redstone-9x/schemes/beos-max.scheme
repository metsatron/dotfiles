# Redstone 9X Desktop Scheme — BeOS Max Edition (Be dynasty variant of BeOS
# Inspired, 2026-07-21). Shares the icons, behand cursor, Qt/FOX and sound base;
# the distinct layers are the BeGorilla GTK theme and its own BeOS-Max IceWM
# theme — R5's yellow tab kept, but the close button moved to the app-icon slot.
SCHEME_TITLE="BeOS Max"
ICEWM_THEME="BeOS-Max"
GTK_THEME="BeGorilla"
ICON_THEME="BeOS-r5-Icons"
MENU_BUTTON="beos-max"
CURSOR_THEME="behand"
CURSOR_SIZE="24"
GTK_FONT="Sans 9"
DESKTOP_BG="#31639e"
SEL_BG="#989898"
SEL_FG="#000000"
QT6CT_COLORS="beos-r5.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="Besot"
SOUND_SCHEME="beos-r5"
FOX_BASE="#d8d8d8"
FOX_SEL_BG="#989898"
FOX_SEL_FG="#000000"
FOX_MENU_BG="#d8d8d8"
FOX_MENU_FG="#000000"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
