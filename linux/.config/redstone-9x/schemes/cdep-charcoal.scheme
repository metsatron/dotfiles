# Redstone 9X Desktop Scheme — CDE Charcoal (raided CDE palette dynasty, 2026-07-20).
SCHEME_TITLE="CDE Charcoal"
ICEWM_THEME="CDE-Charcoal"
GTK_THEME="CDE-Charcoal"
ICON_THEME="Irixium"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#af9696"
SEL_BG="#87b4b0"
SEL_FG="#000000"
QT6CT_COLORS="cdep-charcoal.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="CDE-Charcoal"
WINE_COLORS="cdep-charcoal.reg"
SOUND_SCHEME="cdep-charcoal"
WALLPAPER="$HOME/.icewm/themes/CDE-Charcoal/backgrounds/BrickWall.png"
WALLPAPER_MODE="center"
