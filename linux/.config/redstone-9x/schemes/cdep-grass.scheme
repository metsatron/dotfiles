# Redstone 9X Desktop Scheme — CDE Grass (raided CDE palette dynasty, 2026-07-20).
SCHEME_TITLE="CDE Grass"
ICEWM_THEME="CDE-Grass"
GTK_THEME="CDE-Grass"
ICON_THEME="Irixium"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#829694"
SEL_BG="#d4c77d"
SEL_FG="#000000"
QT6CT_COLORS="cdep-grass.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="CDE-Grass"
WINE_COLORS="cdep-grass.reg"
SOUND_SCHEME="cdep-grass"
WALLPAPER="$HOME/.icewm/themes/CDE-Grass/backgrounds/BrickWall.png"
WALLPAPER_MODE="center"
FOX_BASE="#bec6b7"
FOX_SEL_BG="#d4c77d"
FOX_SEL_FG="#000000"
FOX_MENU_BG="#d4c77d"
FOX_MENU_FG="#000000"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;ClockCommand=\"i2kcal\";CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\";TaskBarShowWorkspaces=1"
