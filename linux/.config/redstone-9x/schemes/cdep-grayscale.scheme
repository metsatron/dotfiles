# Redstone 9X Desktop Scheme — CDE GrayScale (raided CDE palette dynasty, 2026-07-20).
SCHEME_TITLE="CDE GrayScale"
ICEWM_THEME="CDE-GrayScale"
GTK_THEME="CDE-GrayScale"
ICON_THEME="Irixium"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#939393"
SEL_BG="#c3c3c3"
SEL_FG="#000000"
QT6CT_COLORS="cdep-grayscale.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="CDE-GrayScale"
WINE_COLORS="cdep-grayscale.reg"
SOUND_SCHEME="cdep-grayscale"
WALLPAPER="$HOME/.icewm/themes/CDE-GrayScale/backgrounds/NoBackdrop.png"
WALLPAPER_MODE="center"
FOX_BASE="#787777"
FOX_SEL_BG="#c3c3c3"
FOX_SEL_FG="#000000"
FOX_MENU_BG="#c3c3c3"
FOX_MENU_FG="#000000"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;ClockCommand=\"i2kcal\";CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
