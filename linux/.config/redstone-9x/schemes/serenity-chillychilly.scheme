# Redstone 9X Desktop Scheme — Serenity Chillychilly (converted from official .theme by
# redstone-9x-theme-convert; colours are the file's own, gradient endpoints
# synthesized 50%-to-white when the file predates gradient keys).
SCHEME_TITLE="Serenity Chillychilly"
ICEWM_THEME="Serenity-Chillychilly"
GTK_THEME="Serenity-Chillychilly"
ICON_THEME="Serenity95"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#3F8077"
SEL_BG="#3C6E71"
SEL_FG="#FDFDFF"
QT6CT_COLORS="serenity-chillychilly.conf"
SOUND_SCHEME="serenity"
FOX_BASE="#CFDBD5"
FOX_SEL_BG="#3C6E71"
FOX_SEL_FG="#FDFDFF"
FOX_MENU_BG="#3C6E71"
FOX_MENU_FG="#FDFDFF"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
