# Redstone 9X Desktop Scheme — CDE BeigeRose (raided CDE palette dynasty, 2026-07-20).
SCHEME_TITLE="CDE BeigeRose"
ICEWM_THEME="CDE-BeigeRose"
GTK_THEME="CDE-BeigeRose"
ICON_THEME="Irixium"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#90b0ac"
SEL_BG="#618888"
SEL_FG="#ffffff"
QT6CT_COLORS="cdep-beigerose.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="CDE-BeigeRose"
WINE_COLORS="cdep-beigerose.reg"
SOUND_SCHEME="cdep-beigerose"
WALLPAPER="$HOME/.icewm/themes/CDE-BeigeRose/backgrounds/NoBackdrop.png"
WALLPAPER_MODE="center"
FOX_BASE="#d1c0ae"
FOX_SEL_BG="#618888"
FOX_SEL_FG="#ffffff"
FOX_MENU_BG="#618888"
FOX_MENU_FG="#ffffff"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
