# Redstone 9X Desktop Scheme — NeXTSTEP/OpenStep / OneStepBack — DarkAdobe BlueHighlights.
SCHEME_TITLE="NeXTSTEP/OpenStep — OneStepBack — DarkAdobe BlueHighlights"
ICEWM_THEME="NextStep-NeXT-OneStepBack-DarkAdobe-BlueHighlights"
GTK_THEME="OneStepBack-DarkAdobe-BlueHighlights"
ICON_THEME="NeXTSTEP-Complete"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Charcoal 9"
DESKTOP_BG="#3e3f4d"
DESKTOP_ICON_LABEL_MODE="shadow"
DESKTOP_ICON_LABEL_FOREGROUND="#ffffff"
DESKTOP_ICON_LABEL_SHADOW_COLOR="#000000"
SEL_BG="#4b6983"
SEL_FG="#ffffff"
QT6CT_COLORS="nextstep-onestepback-darkadobe-bluehighlights.conf"
WINE_COLORS="nextstep-onestepback-darkadobe-bluehighlights.reg"
QT_STYLE="Windows"
SOUND_SCHEME="nextstep"
FOX_BASE="#454545"
FOX_SEL_BG="#4b6983"
FOX_SEL_FG="#ffffff"
FOX_MENU_BG="#454545"
FOX_MENU_FG="#ffffff"
NEXTSTEP_DOCKAPPS="1"
ICEWM_PREFS='TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetworkStatusDevice="en* wl* wg* tailscale*";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;ClockCommand="i2kcal";CPUStatusCommand="dbus-run-session mate-system-monitor";NetStatusCommand="netactview";DockApps="right high dock"'
