# Redstone 9X Desktop Scheme — CDE Lilac (raided CDE palette dynasty, 2026-07-20).
SCHEME_TITLE="CDE Lilac"
ICEWM_THEME="CDE-Lilac"
GTK_THEME="CDE-Lilac"
ICON_THEME="Irixium"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#917e9f"
SEL_BG="#d3d178"
SEL_FG="#000000"
QT6CT_COLORS="cdep-lilac.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="CDE-Lilac"
WINE_COLORS="cdep-lilac.reg"
SOUND_SCHEME="cdep-lilac"
WALLPAPER="$HOME/.icewm/themes/CDE-Lilac/backgrounds/RakedSand.png"
WALLPAPER_MODE="center"
FOX_BASE="#a5a5ac"
FOX_SEL_BG="#d3d178"
FOX_SEL_FG="#000000"
FOX_MENU_BG="#d3d178"
FOX_MENU_FG="#000000"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;ClockCommand=\"i2kcal\";CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\";TaskBarShowWorkspaces=1"
