ICEWM_THEME="The-Golden-Era"
GTK_THEME="The-Golden-Era"
ICON_THEME="Win98SE"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#BE756A"
SEL_BG="#8088A8"
SEL_FG="#FFF8E0"
QT6CT_COLORS="plus-golden-era.conf"
SOUND_SCHEME="plus-golden-era"
FOX_BASE="#B8C8B8"
FOX_SEL_BG="#8088A8"
FOX_SEL_FG="#FFF8E0"
FOX_MENU_BG="#8088A8"
FOX_MENU_FG="#FFF8E0"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
