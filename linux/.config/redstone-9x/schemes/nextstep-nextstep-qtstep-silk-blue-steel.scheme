# Redstone 9X Desktop Scheme — NeXTSTEP/OpenStep / QTStep — Silk Blue Steel.
SCHEME_TITLE="NeXTSTEP/OpenStep — QTStep — Silk Blue Steel"
ICEWM_THEME="NextStep-NeXT-QTStep-Silk-Blue-Steel"
GTK_THEME="NextStep-QTStep-Silk-Blue-Steel"
ICON_THEME="NeXTSTEP"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Charcoal 9"
DESKTOP_BG="#626171"
DESKTOP_ICON_LABEL_MODE="shadow"
DESKTOP_ICON_LABEL_FOREGROUND="#ffffff"
DESKTOP_ICON_LABEL_SHADOW_COLOR="#000000"
SEL_BG="#67678a"
SEL_FG="#ffffff"
QT6CT_COLORS="nextstep-qtstep-silk-blue-steel.conf"
WINE_COLORS="nextstep-qtstep-silk-blue-steel.reg"
QT_STYLE="Windows"
SOUND_SCHEME="nextstep"
FOX_BASE="#aeaaae"
FOX_SEL_BG="#67678a"
FOX_SEL_FG="#ffffff"
FOX_MENU_BG="#aeaaae"
FOX_MENU_FG="#000000"
NEXTSTEP_DOCKAPPS="1"
ICEWM_PREFS='TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetworkStatusDevice="en* wl* wg* tailscale*";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;ClockCommand="i2kcal";CPUStatusCommand="dbus-run-session mate-system-monitor";NetStatusCommand="netactview";DockApps="right high dock"'
