# Redstone 9X — KDE 1 Theme — Glax; first introduced 1999-08-22.
SCHEME_TITLE="KDE 1 Theme — Glax [1999-08-22]"
ICEWM_THEME="KDE1-Theme-glax"
GTK_THEME="KDE1-Theme-glax"
ICON_THEME="KDE-1-Classic-Silver-Curated"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#4C5E52"
DESKTOP_ICON_LABEL_MODE="box"
DESKTOP_ICON_LABEL_BACKGROUND="#4C5E52"
DESKTOP_LABEL_FOREGROUND="#FFFFFF"
DESKTOP_LABEL_SHADOW="#000000"
SEL_BG="#20451D"
SEL_FG="#00FFFF"
QT6CT_COLORS="kde1-theme-glax.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="KDE1-Theme-glax"
SOUND_SCHEME="kde1-theme-glax"
FOX_BASE="#4C5E52"
FOX_SEL_BG="#20451D"
FOX_SEL_FG="#00FFFF"
FOX_MENU_BG="#20451D"
FOX_MENU_FG="#00FFFF"
WALLPAPER="$HOME/.icewm/themes/KDE1-Theme-glax/backgrounds/glax-1920x1080.png"
WALLPAPER_MODE="center"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;ClockCommand=\"i2kcal\";CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\";TaskBarShowWorkspaces=1"
