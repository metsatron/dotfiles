CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#1A212D"
SEL_BG="#1F6FEB"
SEL_FG="#FFFFDF"
QT6CT_COLORS="serenity-nondurrque.conf"
SOUND_SCHEME="serenity"
WINE_COLORS="serenity-nondurrque.reg"
FOX_BASE="#E7ECF0"
