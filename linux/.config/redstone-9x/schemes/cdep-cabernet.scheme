# Redstone 9X Desktop Scheme — CDE Cabernet (raided CDE palette dynasty, 2026-07-20).
SCHEME_TITLE="CDE Cabernet"
ICEWM_THEME="CDE-Cabernet"
GTK_THEME="CDE-Cabernet"
ICON_THEME="Irixium"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#495c65"
SEL_BG="#d88775"
SEL_FG="#000000"
QT6CT_COLORS="cdep-cabernet.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="CDE-Cabernet"
WINE_COLORS="cdep-cabernet.reg"
SOUND_SCHEME="cdep-cabernet"
WALLPAPER="$HOME/.icewm/themes/CDE-Cabernet/backgrounds/Toronto.png"
WALLPAPER_MODE="center"
FOX_BASE="#638a7a"
FOX_SEL_BG="#d88775"
FOX_SEL_FG="#000000"
FOX_MENU_BG="#d88775"
FOX_MENU_FG="#000000"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
