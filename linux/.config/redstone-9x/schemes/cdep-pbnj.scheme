# Redstone 9X Desktop Scheme — CDE PBNJ (raided CDE palette dynasty, 2026-07-20).
SCHEME_TITLE="CDE PBNJ"
ICEWM_THEME="CDE-PBNJ"
GTK_THEME="CDE-PBNJ"
ICON_THEME="Irixium"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#ebd7bf"
SEL_BG="#b65c61"
SEL_FG="#ffffff"
QT6CT_COLORS="cdep-pbnj.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="CDE-PBNJ"
WINE_COLORS="cdep-pbnj.reg"
SOUND_SCHEME="cdep-pbnj"
WALLPAPER="$HOME/.icewm/themes/CDE-PBNJ/backgrounds/Ankh.png"
WALLPAPER_MODE="tile"
FOX_BASE="#d9c1b2"
FOX_SEL_BG="#b65c61"
FOX_SEL_FG="#ffffff"
FOX_MENU_BG="#b65c61"
FOX_MENU_FG="#ffffff"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
