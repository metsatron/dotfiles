# Redstone 9X Desktop Scheme — Mystery (converted from official .theme by
# redstone-9x-theme-convert; colours are the file's own, gradient endpoints
# synthesized 50%-to-white when the file predates gradient keys).
SCHEME_TITLE="Mystery"
ICEWM_THEME="Mystery"
GTK_THEME="Mystery"
ICON_THEME="Win98SE"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#5E4E53"
SEL_BG="#B87840"
SEL_FG="#FFFFFF"
QT6CT_COLORS="plus-mystery.conf"
SOUND_SCHEME="plus-mystery"
WINE_COLORS="plus-mystery.reg"
FOX_BASE="#687868"
FOX_FG="#000000"
FOX_BG="#FFFFF0"
FOX_SEL_BG="#B87840"
FOX_SEL_FG="#FFFFFF"
FOX_MENU_BG="#B87840"
FOX_MENU_FG="#FFFFFF"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
