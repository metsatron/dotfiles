# Redstone 9X — MacOS Retromod; first introduced 2026-07-31.
SCHEME_TITLE="MacOS Retromod [2026-07-31]"
ICEWM_THEME="KDE1-Theme-retromod"
GTK_THEME="KDE1-Theme-retromod"
ICON_THEME="KDE-1-Classic-Silver-MacOS"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Charcoal 9"
DESKTOP_BG="#CECECE"
DESKTOP_ICON_LABEL_MODE="box"
DESKTOP_ICON_LABEL_BACKGROUND="#CECECE"
DESKTOP_LABEL_FOREGROUND="#000000"
DESKTOP_LABEL_SHADOW="#FFFFFF"
SEL_BG="#31319C"
SEL_FG="#FFFFFF"
QT6CT_COLORS="kde1-theme-retromod.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="KDE1-Theme-retromod"
SOUND_SCHEME="kde1-theme-macos"
FOX_BASE="#CECECE"
FOX_SEL_BG="#31319C"
FOX_SEL_FG="#FFFFFF"
FOX_MENU_BG="#31319C"
FOX_MENU_FG="#FFFFFF"
FOX_FG="#000000"
FOX_BG="#FFFFFF"
FOX_HILITE="#FFFFFF"
FOX_SHADOW="#808080"
FOX_BORDER="#000000"
FOX_FOCUS="#000000"
WALLPAPER="$HOME/.icewm/themes/KDE1-Theme-retromod/backgrounds/ocean01-tiled-1920x1080.png"
WALLPAPER_MODE="center"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;ClockCommand=\"i2kcal\";CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\";TaskBarShowWorkspaces=1"
