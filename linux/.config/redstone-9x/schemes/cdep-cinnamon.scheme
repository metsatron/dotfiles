# Redstone 9X Desktop Scheme — CDE Cinnamon (raided CDE palette dynasty, 2026-07-20).
SCHEME_TITLE="CDE Cinnamon"
ICEWM_THEME="CDE-Cinnamon"
GTK_THEME="CDE-Cinnamon"
ICON_THEME="Irixium"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="#78695d"
SEL_BG="#b14b50"
SEL_FG="#ffffff"
QT6CT_COLORS="cdep-cinnamon.conf"
QT_STYLE="kvantum"
KVANTUM_THEME="CDE-Cinnamon"
WINE_COLORS="cdep-cinnamon.reg"
SOUND_SCHEME="cdep-cinnamon"
WALLPAPER="$HOME/.icewm/themes/CDE-Cinnamon/backgrounds/RakedSand.png"
WALLPAPER_MODE="tile"
FOX_BASE="#926866"
FOX_SEL_BG="#b14b50"
FOX_SEL_FG="#ffffff"
FOX_MENU_BG="#b14b50"
FOX_MENU_FG="#ffffff"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
