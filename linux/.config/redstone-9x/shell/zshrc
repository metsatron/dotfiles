# Redstone 9X sanctuary zsh rc — Win9x/MS-DOS shell identity.
# Shared sanctuary grammar: symlinked to ~/.zshrc by sanctuary-redstone-9x-launch,
# replacing the global symlink. Sources the global DotCortex zshrc FIRST so all
# global aliases/functions survive, THEN applies the sanctuary prompt — the global
# ~/DotCortex/all/.zshrc is never edited.
[ -f "${HOME}/DotCortex/all/.zshrc" ] && source "${HOME}/DotCortex/all/.zshrc"

# Map the Unix path to a DOS drive path. zsh's ${//} mangles a literal backslash
# replacement, so a backslash variable is used. (Tested 2026-07-15.)
_redstone_dospath() {
  local p="${PWD}" rel bs=$'\\'
  if [[ "${p}" == "${HOME}" ]]; then
    printf 'Z:%s' "${bs}"
  elif [[ "${p}" == "${HOME}/"* ]]; then
    rel="${p#${HOME}/}"; rel="${rel//\//${bs}}"; printf 'Z:%s%s' "${bs}" "${rel}"
  else
    rel="${p#/}"; rel="${rel//\//${bs}}"; printf 'C:%s%s' "${bs}" "${rel}"
  fi
}
setopt PROMPT_SUBST
PROMPT='ZSH $(_redstone_dospath)> '

# First interactive shell in each terminal: open at HOME, print the boot banner.
if [[ -z "${REDSTONE_SHELL_INIT:-}" ]]; then
  export REDSTONE_SHELL_INIT=1
  cd "${HOME}" 2>/dev/null || true
  printf '\033[97mMineshaft Redstone 9X.0.26715\033[0m\n'
fi
