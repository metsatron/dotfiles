* {
    font: "Tahoma 8";
    background-color: #c0c0c0;
    text-color: #000000;
    border-color: #808080;
    margin: 0px;
    padding: 0px;
    spacing: 0px;
}
window {
    width: 350px;
    height: 0px;
    padding: 8px;
    border: 0px;
    background-color: #c0c0c0;
    location: center;
    anchor: center;
    children: [ mainbox ];
}
mainbox {
    orientation: vertical;
    spacing: 8px;
    children: [ textbox-message, inputbar, listview, actions ];
}
/* NOTE: the Win95 corner Run icon and the dropdown ▼ glyph are both IMAGES, and
   this rofi 2.0.0 build does not render images inside custom theme widgets
   (filename icon, background-image — both come up blank; text renders fine). So
   the message carries no icon and the combobox button is a bare bevel. Revisit
   if rofi is rebuilt from mainline. */
textbox-message {
    content: "Type the name of a program, folder, or document, and\nRedstone will open it for you.";
    expand: false;
    background-color: #c0c0c0;
    text-color: #000000;
    padding: 0px 0px 0px 34px;
    horizontal-align: 0.0;
}
inputbar {
    orientation: horizontal;
    expand: false;
    spacing: 6px;
    children: [ textbox-open, field-combo ];
}
textbox-open {
    content: "Open:";
    expand: false;
    vertical-align: 0.5;
    background-color: transparent;
    text-color: #000000;
}
/* Win95 combobox: the field and its dropdown chevron sit flush together.  The
   chevron (combo-button -> kb-custom-2, exit 11) drops the Run history, exactly
   as the real Open: combobox lists previously-entered commands. */
field-combo {
    orientation: horizontal;
    expand: true;
    spacing: 0px;
    children: [ entry-frame, combo-frame ];
}
/* Sunken Win95 field: rofi border-color is single-colour, so the 2-tone bevel
   is faked with per-side widths — dark top/left on the frame, light bottom/right
   on the inner entry. */
entry-frame {
    orientation: horizontal;
    expand: true;
    background-color: #ffffff;
    border: 2px 0px 0px 2px;
    border-color: #808080;
    padding: 0px;
    children: [ entry ];
}
entry {
    expand: true;
    background-color: #ffffff;
    text-color: #000000;
    border: 0px 2px 2px 0px;
    border-color: #ffffff;
    padding: 2px 3px;
}
/* Raised chevron button, same 2-tone bevel technique as the OK/Cancel buttons
   (shadow on the outer frame, highlight on the inner button). */
combo-frame {
    expand: false;
    background-color: #c0c0c0;
    border: 0px 2px 2px 0px;
    border-color: #808080;
    padding: 0px;
    children: [ combo-button ];
}
/* A clean raised combobox dropdown button on the field's right edge.  rofi's
   inputbar collapses a custom leaf widget's content box, so neither a font glyph
   nor a background-image triangle renders reliably inside it — the bare beveled
   button reads correctly as the Win95 dropdown affordance and stays clickable
   (kb-custom-2 -> the Run history). */
combo-button {
    expand: false;
    width: 22px;
    background-color: #c0c0c0;
    border: 2px 0px 0px 2px;
    border-color: #ffffff;
    padding: 0px;
    cursor: pointer;
    content: "";
    action: "kb-custom-2";
}
listview {
    enabled: false;
    expand: false;
    lines: 8;
    fixed-height: true;
    dynamic: false;
    scrollbar: true;
    background-color: #ffffff;
    text-color: #000000;
    border: 2px;
    border-color: #808080;
    padding: 1px;
}
element {
    padding: 3px 5px;
    background-color: #ffffff;
    text-color: #000000;
}
element selected.normal {
    background-color: #000080;
    text-color: #ffffff;
}
element-text {
    background-color: inherit;
    text-color: inherit;
}
scrollbar {
    handle-color: #808080;
    handle-width: 8px;
}
actions {
    orientation: horizontal;
    expand: true;
    spacing: 6px;
    children: [ ok-frame, cancel-frame, browse-frame ];
}
/* Raised Win95 buttons: 2-tone bevel from single-colour per-side borders.  Each
   edge sits on the widget that renders it fully — the shadow (bottom/right) on
   the OUTER frame, the highlight (top/left) on the INNER button.  (rofi clips an
   inner widget's bottom border, so the shadow must live on the outer frame.) */
ok-frame,cancel-frame,browse-frame {
    expand: true;
    background-color: #c0c0c0;
    border: 0px 2px 2px 0px;
    border-color: #808080;
    padding: 0px;
}
button-ok,button-cancel,button-browse {
    expand: true;
    background-color: #c0c0c0;
    text-color: #000000;
    border: 2px 0px 0px 2px;
    border-color: #ffffff;
    padding: 4px 10px;
    vertical-align: 0.5;
    horizontal-align: 0.5;
    cursor: pointer;
}
ok-frame {
    children: [ button-ok ];
}
cancel-frame {
    children: [ button-cancel ];
}
browse-frame {
    children: [ button-browse ];
}
button-ok {
    content: "OK";
    action: "kb-accept-custom";
}
button-cancel {
    content: "Cancel";
    action: "kb-cancel";
}
button-browse {
    content: "Browse...";
    action: "kb-custom-1";
}
