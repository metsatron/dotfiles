* {
    font: "Tahoma 8";
    background-color: #c0c0c0;
    text-color: #000000;
    border-color: #808080;
    margin: 0px;
    padding: 0px;
    spacing: 0px;
}
window {
    width: 350px;
    height: 0px;
    padding: 8px;
    border: 2px;
    border-color: #000000;
    background-color: #c0c0c0;
    location: center;
    anchor: center;
    children: [ mainbox ];
}
mainbox {
    orientation: vertical;
    spacing: 8px;
    children: [ textbox-message, inputbar, listview, actions ];
}
textbox-message {
    content: "Type the name of a program, folder, or document, and\nRedstone will open it for you.";
    expand: false;
    background-color: #c0c0c0;
    text-color: #000000;
    padding: 0px 0px 0px 34px;
    horizontal-align: 0.0;
}
inputbar {
    orientation: horizontal;
    expand: false;
    spacing: 6px;
    children: [ textbox-open, entry-frame ];
}
textbox-open {
    content: "Open:";
    expand: false;
    vertical-align: 0.5;
    background-color: transparent;
    text-color: #000000;
}
entry-frame {
    orientation: horizontal;
    expand: true;
    background-color: #ffffff;
    border: 2px;
    border-color: #808080;
    padding: 2px;
    children: [ entry ];
}
entry {
    expand: true;
    background-color: #ffffff;
    text-color: #000000;
    padding: 2px 3px;
}
listview {
    enabled: false;
    expand: false;
    lines: 8;
    fixed-height: true;
    dynamic: false;
    scrollbar: true;
    background-color: #ffffff;
    text-color: #000000;
    border: 2px;
    border-color: #808080;
    padding: 1px;
}
element {
    padding: 3px 5px;
    background-color: #ffffff;
    text-color: #000000;
}
element selected.normal {
    background-color: #000080;
    text-color: #ffffff;
}
element-text {
    background-color: inherit;
    text-color: inherit;
}
scrollbar {
    handle-color: #808080;
    handle-width: 8px;
}
actions {
    orientation: horizontal;
    expand: true;
    spacing: 6px;
    children: [ button-ok, button-cancel, button-browse ];
}
button-ok,button-cancel,button-browse {
    expand: true;
    background-color: #c0c0c0;
    text-color: #000000;
    border: 2px;
    border-color: #ffffff;
    padding: 4px 10px;
    vertical-align: 0.5;
    horizontal-align: 0.5;
    cursor: pointer;
}
button-ok {
    content: "OK";
    action: "kb-accept-custom";
}
button-cancel {
    content: "Cancel";
    action: "kb-cancel";
}
button-browse {
    content: "Browse...";
    action: "kb-custom-1";
}
