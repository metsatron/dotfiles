* {
    win95-grey:                     #c0c0c0;
    win95-white:                    #ffffff;
    win95-shadow:                   #808080;
    win95-black:                    #000000;
    win95-navy:                     #000080;

    background:                     @win95-grey;
    foreground:                     @win95-black;
    normal-background:              @win95-white;
    normal-foreground:              @win95-black;
    alternate-normal-background:    @win95-white;
    alternate-normal-foreground:    @win95-black;
    alternate-urgent-background:    @win95-white;
    alternate-urgent-foreground:    @win95-black;
    alternate-active-background:    @win95-white;
    alternate-active-foreground:    @win95-black;
    selected-normal-background:     @win95-navy;
    selected-normal-foreground:     @win95-white;
    urgent-background:              @win95-white;
    urgent-foreground:              @win95-black;
    selected-urgent-background:     @win95-navy;
    selected-urgent-foreground:     @win95-white;
    active-background:              @win95-white;
    active-foreground:              @win95-black;
    selected-active-background:     @win95-navy;
    selected-active-foreground:     @win95-white;
    spacing:                         4px;
}
/* Win95 raised window edge (NOT a flat black outline): the 2-tone 3D bevel is
   faked across the two nested widgets exactly like the Run-box buttons — the
   highlight (white, top/left) on the inner #mainbox, the shadow (dark grey,
   bottom/right) on the outer #window.  rofi clips an inner widget's bottom
   border, so the shadow must live on the outer frame. */
#window {
    background-color: @background;
    font: "Tahoma 8";
    border: 0px 2px 2px 0px;
    border-color: @win95-shadow;
    padding: 0px;
    width: 440px;
    height: 360px;
    location: center;
    anchor: center;
    margin: 0px;
}
#mainbox {
    background-color: @background;
    border: 2px 0px 0px 2px;
    border-color: @win95-white;
    padding: 5px;
    spacing: 5px;
}
#message {
    background-color: @background;
    border: 0px;
    padding: 4px 6px;
}
#textbox { text-color: @foreground; }
#listview {
    fixed-height: 0;
    border: 2px;
    border-color: @win95-shadow;
    background-color: @win95-white;
    spacing: 0px;
    scrollbar: false;
    padding: 2px;
}
#element {
    border: 0px;
    padding: 3px 4px;
    spacing: 6px;
    highlight: none;
}
#element.normal.normal {
    background-color: @normal-background;
    text-color: @normal-foreground;
}
#element.normal.urgent {
    background-color: @urgent-background;
    text-color: @urgent-foreground;
}
#element.normal.active {
    background-color: @active-background;
    text-color: @active-foreground;
}
#element.selected.normal {
    background-color: @selected-normal-background;
    text-color: @selected-normal-foreground;
}
#element.selected.urgent {
    background-color: @selected-urgent-background;
    text-color: @selected-urgent-foreground;
}
#element.selected.active {
    background-color: @selected-active-background;
    text-color: @selected-active-foreground;
}
#element.alternate.normal {
    background-color: @alternate-normal-background;
    text-color: @alternate-normal-foreground;
}
#element.alternate.urgent {
    background-color: @alternate-urgent-background;
    text-color: @alternate-urgent-foreground;
}
#element.alternate.active {
    background-color: @alternate-active-background;
    text-color: @alternate-active-foreground;
}
#scrollbar {
    width: 12px;
    border: 1px;
    border-color: @win95-shadow;
    handle-width: 12px;
    padding: 1px;
}
#mode-switcher {
    border: 0px;
    spacing: 6px;
}
#button {
    background-color: @background;
    text-color: @foreground;
    border: 2px;
    border-color: @win95-white;
    padding: 3px 10px;
}
#button.selected {
    background-color: @selected-normal-background;
    text-color: @selected-normal-foreground;
    border-color: @win95-shadow;
}
#inputbar {
    background-color: @win95-white;
    border: 2px;
    border-color: @win95-shadow;
    spacing: 4px;
    text-color: @normal-foreground;
    padding: 3px 4px;
    children: [ prompt, entry, case-indicator ];
}
#case-indicator {
    spacing: 0px;
    text-color: @normal-foreground;
}
#entry {
    spacing: 0px;
    text-color: @normal-foreground;
    cursor: text;
}
#prompt {
    spacing: 0px;
    margin: 0px 6px 0px 0px;
    text-color: @normal-foreground;
}
element-icon {
    size: 16px;
}
