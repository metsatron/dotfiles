/* Redstone 9X GTK user overrides — TEMPLATE, rendered by redstone-9x-scheme-apply.
 * Keep the theme visually static: no fade, no hide, no animated sidebar.
 */

* {
  transition: none;
  animation: none;
}

.sidebar,
.sidebar *,
places-sidebar,
places-sidebar * {
  transition: none;
  animation: none;
  opacity: 1;
}

button,
button:hover,
button:active,
button:checked,
entry,
entry:hover,
entry:focus {
  transition: none;
}

/* PCManFM's custom desktop renderer consumes these states after room-gaming
 * names its CSS node fmdesktop, lowers its internal provider to application
 * priority, and exposes its Cairo rubber band through GTK's rubberband class.
 */
FmDesktop:selected,
fmdesktop:selected {
  background-color: @SEL_BG@;
  color: @SEL_FG@;
}

FmDesktop.rubberband,
fmdesktop.rubberband {
  background-color: @SEL_RGBA@;
  border-color: @SEL_BG@;
  border-style: solid;
  border-width: 1px;
}

/* Selection accent — force GTK selection/highlight to the scheme accent. This
 * user CSS loads at a HIGHER priority than the theme, so it wins the cascade a
 * same-priority theme append cannot (verified with an offscreen render: the
 * treeview row is painted by treeview.view:selected, which a lower-priority rule
 * never beats). Precise: only :selected VIEWS + :hover MENU items get the accent,
 * so unselected menu text stays its normal colour. @SEL_BG@/@SEL_FG@ are the
 * scheme's titlebar accent, so every colour variant stays in sync. */
treeview.view:selected, treeview.view:selected:focus,
treeview:selected, treeview:selected:focus,
.view:selected, .view:selected:focus,
iconview:selected, iconview:selected:focus,
list row:selected, flowboxchild:selected {
  background-color: @SEL_BG@;
  color: @SEL_FG@;
}
treeview.view:selected label, .view:selected label,
iconview:selected label, list row:selected label {
  color: @SEL_FG@;
}
/* Menu shell bevel — Win95 raised 2px frame (1px border + 1px inset shadow).
 * All four bevel colours extracted from the active GTK theme at runtime by
 * scheme-apply: Chicago95 button CSS, CDE palette 6, or FOX_BASE fallback. */
menu,
.menu,
.csd menu,
.csd .menu,
popover,
popover.background,
.csd popover,
.csd popover.background {
  margin: 2px;
  padding: 2px;
  border-radius: 0;
  border-width: 1px;
  border-style: solid;
  border-top-color: @BEVEL_HIGHLIGHT@;
  border-left-color: @BEVEL_HIGHLIGHT@;
  border-right-color: @BEVEL_DKSHADOW@;
  border-bottom-color: @BEVEL_DKSHADOW@;
  background-color: @BEVEL_FACE@;
  background-clip: border-box;
  box-shadow: inset 1px 1px @BEVEL_HIGHLIGHT@,
              inset -1px -1px @BEVEL_SHADOW@;
}
menu menuitem label, .menu menuitem label {
  color: @BEVEL_FG@;
}
menu menuitem:disabled label, .menu menuitem:disabled label {
  color: @BEVEL_SHADOW@;
}
menuitem:hover, menu menuitem:hover, menubar > menuitem:hover {
  background-color: @SEL_BG@;
}
menubar > menuitem:hover > label {
  color: @SEL_FG@;
}
menu menuitem:hover label {
  color: @SEL_FG@;
}
menu menuitem:hover menu menuitem label {
  color: @BEVEL_FG@;
}
menu menuitem:hover menu menuitem:disabled label {
  color: @BEVEL_SHADOW@;
}
menu menuitem:hover menu menuitem:hover label {
  color: @SEL_FG@;
}
menuitem:hover > arrow, menuitem:hover > check, menuitem:hover > radio {
  color: @SEL_FG@;
}
