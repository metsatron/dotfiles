/* Redstone 9X GTK user overrides — TEMPLATE, rendered by redstone-9x-scheme-apply.
 * Keep the theme visually static: no fade, no hide, no animated sidebar.
 */

* {
  transition: none;
  animation: none;
}

.sidebar,
.sidebar *,
places-sidebar,
places-sidebar * {
  transition: none;
  animation: none;
  opacity: 1;
}

button,
button:hover,
button:active,
button:checked,
entry,
entry:hover,
entry:focus {
  transition: none;
}

/* PCManFM's custom desktop renderer consumes these states after room-gaming
 * names its CSS node fmdesktop, lowers its internal provider to application
 * priority, and exposes its Cairo rubber band through GTK's rubberband class.
 */
FmDesktop:selected,
fmdesktop:selected {
  background-color: @SEL_BG@;
  color: @SEL_FG@;
}

FmDesktop.rubberband,
fmdesktop.rubberband {
  background-color: @SEL_RGBA@;
  border-color: @SEL_BG@;
  border-style: solid;
  border-width: 1px;
}

/* Selection accent — force GTK selection/highlight to the scheme accent. This
 * user CSS loads at a HIGHER priority than the theme, so it wins the cascade a
 * same-priority theme append cannot (verified with an offscreen render: the
 * treeview row is painted by treeview.view:selected, which a lower-priority rule
 * never beats). Precise: only :selected VIEWS + :hover MENU items get the accent,
 * so unselected menu text stays its normal colour. @SEL_BG@/@SEL_FG@ are the
 * scheme's titlebar accent, so every colour variant stays in sync. */
treeview.view:selected, treeview.view:selected:focus,
treeview:selected, treeview:selected:focus,
.view:selected, .view:selected:focus,
iconview:selected, iconview:selected:focus,
list row:selected, flowboxchild:selected {
  background-color: @SEL_BG@;
  color: @SEL_FG@;
}
treeview.view:selected label, .view:selected label,
iconview:selected label, list row:selected label {
  color: @SEL_FG@;
}
menuitem:hover, menu menuitem:hover, menubar > menuitem:hover {
  background-color: @SEL_BG@;
  color: @SEL_FG@;
}
menuitem:hover label, menu menuitem:hover label, menubar > menuitem:hover label {
  color: @SEL_FG@;
}
