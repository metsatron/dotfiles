[Desktop Entry]
Type=Application
Name=Lutris
Comment=Launch Lutris inside sanctuary-godzilla-xs through the shared Flatpak store
Exec=/bin/sh -c "exec \\"\\$HOME/.local/bin/lutris-play\\" -- \\"\\$HOME/.local/bin/sanctuary-flatpak-run\\" net.lutris.Lutris" sh
