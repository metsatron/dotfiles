[%General]
author=Mark Whittaker
active_tab_overlap=12
alt_mnemonic=true
animate_states=false
attach_active_tab=true
blurring=false
bold_active_tab=false
button_contents_shift=true
button_icon_size=16
center_toolbar_handle=true
check_size=17
click_behavior=0
combo_as_lineedit=true
combo_focus_rect=false
combo_menu=true
comment=Commonality
composite=false
contrast=1.00
dialog_button_layout=0
embedded_tabs=false
fill_rubberband=false
groupbox_top_label=false
group_toolbar_buttons=false
hide_combo_checkboxes=false
inline_spin_indicators=true
inline_spin_separator=false
intensity=1.00
joined_inactive_tabs=true
large_icon_size=32
layout_margin=3
layout_spacing=3
left_tabs=true
menubar_mouse_tracking=true
menu_shadow_depth=0
merge_menubar_with_toolbar=false
min_height=24
no_active_tab_separator=true
no_inactiveness=false
no_inactive_tab_expansion=true
no_selection_tint=false
no_window_pattern=false
normal_default_pushbutton=true
popup_blurring=false
progressbar_thickness=1.5font
reduce_menu_opacity=0
reduce_window_opacity=0
remove_extra_frames=false
respect_DE=true
saturation=1.00
scrollable_menu=true
scroll_arrows=true
scrollbar_in_view=false
scroll_min_extent=34
scroll_width=18
shadowless_popup=false
slider_handle_length=36
slider_handle_width=18
slider_width=18
small_icon_size=16
spin_button_width=11
splitter_width=9
spread_header=false
spread_progressbar=true
square_combo_button=true
submenu_delay=250
submenu_overlap=1
tab_button_extra_margin=0
toolbar_icon_size=16
toolbar_interior_spacing=0
toolbar_item_spacing=2
toolbutton_style=0
tooltip_delay=-1
tooltip_shadow_depth=0
transient_groove=false
transient_scrollbar=false
translucent_windows=false
tree_branch_line=true
vertical_spin_indicators=false
x11drag=all


[GeneralColors]
#alt.base.color=#9ebfbf
base.color=#9ebfbf
button.color=#efebe7
button.text.color=black
dark.color=#3c3c3c
disabled.text.color=#808080
highlight.color=#e3e3e3
highlight.text.color=black
#inactive.highlight.color=#cca2a2
light.color=#f7f7f7
link.color=#0000ff
link.visited.color=#ff00ff
mid.color=#000000
mid.light.color=#606060
progress.indicator.text.color=black
text.color=black
text.focus.color=blue
text.normal.color=red
tooltip.text.color=black
window.color=#c1c1c1
window.text.color=black

[Hacks]


[WindowTranslucent]
interior=true
interior.element=window
interior.x.patternsize=32
interior.y.patternsize=32
frame.expansion=0

[Window]
interior=true
interior.element=window

[PanelButtonCommand]
interior.element=tbtn
interior=true
frame=true
frame.element=tbtn
indicator.size=12
text.margin.top=5
text.margin.bottom=5

[PanelButtonTool]
interior.element=bbb
interior=true
frame=true
frame.element=bbb
indicator.size=10
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3

[Dock]
interior.element=mbord
frame.element=mbord
