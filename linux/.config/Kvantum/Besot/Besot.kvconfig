respect_DE=true
saturation=1.00
scrollable_menu=true
scroll_arrows=true
scrollbar_in_view=true
scroll_min_extent=26
scroll_width=13
shadowless_popup=false
slider_handle_length=18
slider_handle_width=18
slider_width=6
small_icon_size=16
spin_button_width=18
spread_header=false
spread_menuitems=false
spread_progressbar=false
square_combo_button=false
submenu_delay=250
submenu_overlap=2
tab_button_extra_margin=0.2font
toolbar_icon_size=16
toolbar_interior_spacing=1
toolbar_separator_thickness=6
toolbutton_style=0
tooltip_delay=-1
tooltip_shadow_depth=0
transient_groove=false
transient_scrollbar=false
