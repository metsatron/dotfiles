[GeneralColors]
window.color=#d8d8d8
base.color=#f9f9f9
alt.base.color=#f9f9f9
button.color=#d8d8d8
light.color=#f9f9f9
mid.light.color=#57595d
dark.color=#989898
mid.color=#989898
highlight.color=#c7c7c7
inactive.highlight.color=#4e4e4e
text.color=black
window.text.color=#353535
button.text.color=#353535
disabled.text.color=#686868
tooltip.text.color=#353535
highlight.text.color=black
link.color=#77aeff
link.visited.color=#644A9B
progress.indicator.text.color=white

[Hacks]


[WindowTranslucent]
interior=true
interior.element=window
interior.x.patternsize=32
interior.y.patternsize=32
frame.expansion=0

[Window]
interior=true
interior.element=window

[PanelButtonCommand]
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
frame.expansion=0
interior.element=abtn
interior=true
frame=true
