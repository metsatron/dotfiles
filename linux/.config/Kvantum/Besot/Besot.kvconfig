layout_margin=2
#layout_spacing=6
left_tabs=true
menubar_mouse_tracking=true
menu_shadow_depth=0
merge_menubar_with_toolbar=false
min_height=2font
no_active_tab_separator=false
no_inactiveness=false
no_inactive_tab_expansion=true
no_window_pattern=false
opaque=qbittorrent,kaffeine,kmplayer,subtitlecomposer,kdenlive,vlc,smplayer,smplayer2,avidemux,avidemux2_qt4,avidemux3_qt4,avidemux3_qt5,kamoso,QtCreator,VirtualBox,VirtualBoxVM,trojita,dragon,digikam,lyx
popup_blurring=false
progressbar_thickness=0
