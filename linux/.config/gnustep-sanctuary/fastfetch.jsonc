{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "GNU",
        "padding": { "top": 1, "right": 3 }
    },
    "display": { "separator": "" },
    "modules": [
        { "type": "custom",  "format": "\u001b[37mGNUSTEP / NEXTSTEP WORKSPACE" },
        { "type": "custom",  "format": "\u001b[37mOPENSTEP RUNTIME / GWORKSPACE" },
        { "type": "custom",  "format": "\u001b[90m -------------------------------------------------------" },
        { "type": "host",    "key": "  Machine", "keyColor": "white", "keyWidth": 13 },
        { "type": "kernel",  "key": "  Kernel",  "keyColor": "white", "keyWidth": 13 },
        { "type": "cpu",     "key": "  CPU",     "keyColor": "white", "keyWidth": 13 },
        { "type": "gpu",     "key": "  GPU",     "keyColor": "white", "keyWidth": 13 },
        { "type": "display", "key": "  Display", "keyColor": "white", "keyWidth": 13 },
        { "type": "memory",  "key": "  Memory",  "keyColor": "white", "keyWidth": 13 },
        { "type": "uptime",  "key": "  Uptime",  "keyColor": "white", "keyWidth": 13 },
        { "type": "shell",   "key": "  Shell",   "keyColor": "white", "keyWidth": 13 },
        { "type": "command", "key": "  WM",      "keyColor": "white", "keyWidth": 13, "text": "printf 'Window Maker'" },
        { "type": "custom",  "format": "\u001b[90m -------------------------------------------------------" },
        { "type": "command", "key": "  Host OS",  "keyColor": "white", "keyWidth": 13, "text": ". /run/host/etc/os-release 2>/dev/null && printf '%s' \"$PRETTY_NAME\" || printf 'Unknown'" },
        { "type": "command", "key": "  DotCortex", "keyColor": "white", "keyWidth": 13, "text": "printf '%s' 'literate dotfiles -> tangle -> stow -> $HOME'" },
        { "type": "command", "key": "  Habitat",   "keyColor": "white", "keyWidth": 13, "text": "[ -f /run/.containerenv ] && printf 'Sanctuary (Distrobox)' || printf 'Baremetal'" },
        { "type": "command", "key": "  Substrate", "keyColor": "white", "keyWidth": 13, "text": "[ -d /gnu/store ] && printf 'Guix' || printf 'Unknown'" },
        { "type": "command", "key": "  Layer",     "keyColor": "white", "keyWidth": 13, "text": "printf 'Xephyr %s' \"${DISPLAY:-?}\"" },
        { "type": "custom",  "format": "\u001b[90m -------------------------------------------------------" },
        { "type": "custom",  "format": "\u001b[37m GNUstep / GWorkspace     \u001b[92mREADY" },
        { "type": "custom",  "format": "\u001b[37m Window Maker / NEXTSPACE \u001b[92mREADY" },
        { "type": "custom",  "format": "\u001b[37m NeXTSTEP / OpenStep      \u001b[92mREADY" },
        { "type": "custom",  "format": "\u001b[37m GNUSTEP SANCTUARY        \u001b[97mONLINE" }
    ]
}
