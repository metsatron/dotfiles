# Brave (agent browser) — deliberate host-profile grant.
# Agentify Cortex launches this flatpak Brave with
#   --user-data-dir=$HOME/.agentify-desktop/chrome-user-data
# but that path is outside Brave's default sandbox grants, so every launch the
# cookie store was written into a throwaway in-sandbox overlay and lost on exit
# → logged out of ChatGPT/Perplexity on every browser/machine restart. This grant
# lets Brave persist the profile to the real host dir. Applied by flatpak-perms-apply
# (additive — it does not reset Brave's manifest defaults). Scoped to the profile dir
# only, NOT the whole ~/.agentify-desktop (which holds agentify's token.txt).
# Regression provenance: the live grant vanished around the 2026-09-12 Brave update;
# encoded here so a future reinstall/flatpak reset cannot silently break it again.
[Context]
filesystems=/home/metsatron/.agentify-desktop/chrome-user-data;
