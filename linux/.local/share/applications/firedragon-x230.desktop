[Desktop Entry]
Version=1.0
Name=FireDragon X230 compatibility (T1700 target)
Comment=Hidden compatibility entry; launch the migrated T1700 profile
Exec=/bin/sh -c "exec \\"\\$HOME/.local/bin/firedragon-x230\\" \\"\\$@\\"" sh %u
Icon=bezilla
Type=Application
Keywords=firedragon;browser;t1700;x230;nfs;mounted;
Terminal=false
Categories=Network;WebBrowser;
NoDisplay=true
StartupNotify=false
