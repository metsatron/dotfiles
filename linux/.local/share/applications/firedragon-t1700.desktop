[Desktop Entry]
Version=1.0
Name=FireDragon T1700
Comment=Launch local FireDragon against the migrated T1700 profile mounted over NFS
Exec=/bin/sh -c "exec \\"\\$HOME/.local/bin/firedragon-t1700\\" \\"\\$@\\"" sh %u
Icon=bezilla
Type=Application
Keywords=firedragon;browser;t1700;nfs;profile;
Terminal=false
Categories=Network;WebBrowser;
MimeType=x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=false
