# /etc/conf.d/claude-warm: compat for the bare (pre-instance) service.
warm_user="${WARM_OPERATOR_USER:-}"
warm_socket=""
warm_session="warm"
xdg="/run/warm"
warm_log_mode="0644"
warm_agent="honey-opus"
warm_cwd="${WARM_OPERATOR_CWD:-$(getent passwd "$warm_user" | cut -d: -f6)/metsatron-peer}"
warm_args="--model claude-opus-4-8"
warm_path="${WARM_OPERATOR_PATH:-$(getent passwd "$warm_user" | cut -d: -f6)/.local/bin:/usr/local/bin:/usr/bin:/bin}"
