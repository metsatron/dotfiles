#!/bin/bash
# xclass Explorer launcher wrapper

# Launches the patched xclass =Explorer= file manager with the runtime
# environment it needs (libxclass + libXcursor on =LD_LIBRARY_PATH=, the
# xclass icon pool via =OX_POOL=, Chicago95 cursor theming). Used by the
# IceWM desktop menu/toolbar so the xclass Explorer clone opens with normal
# IceWM caption buttons (it sets no MWM hints, like PCManFM).


# [[file:../../../sanctuary-distrobox.org::*xclass Explorer launcher wrapper][xclass Explorer launcher wrapper:1]]
set -euo pipefail
XCLASS="${HOME}/.local/xclass"
GUIX_PROFILES="${HOME}/.guix-extra-profiles"
export PATH="${XCLASS}/bin:${PATH}"
# xclass dlopens libXcursor; libxclass + the desktop-common libs must be on the
# link path for explorer to start under IceWM (FVWM95 sets these in its branch).
export LD_LIBRARY_PATH="${XCLASS}/lib:${GUIX_PROFILES}/desktop-common/desktop-common/lib:${LD_LIBRARY_PATH:-}"
export OX_POOL="${XCLASS}/share/xclass-icons"
export XCURSOR_THEME=Chicago95_Cursor_White
export XCURSOR_SIZE=24
export XCURSOR_PATH="${HOME}/.icons:/usr/share/icons:${XCURSOR_PATH:-}"
exec explorer "$@"
# xclass Explorer launcher wrapper:1 ends here
