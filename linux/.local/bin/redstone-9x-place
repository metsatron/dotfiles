#!/bin/bash


# The positioner is deliberately best-effort and silent.  It uses the current
# =DISPLAY= only, exits cleanly when the table or =icesh= is unavailable, polls
# for a mapped window for up to 20 seconds, and moves each match twice so an
# Electron client cannot undo the captured ruling during its first paint.


# [[file:../../../sanctuary-redstone-9x-fvwm95.org::*Dynamic menus — recent Documents + Desktop folder][Dynamic menus — recent Documents + Desktop folder:16]]
# redstone-9x-place — apply Redstone 9X captured window-position rulings.
set -euo pipefail

PLACEMENTS="${REDSTONE_PLACEMENTS_FILE:-${HOME}/.config/redstone-9x/placements.conf}"
# 120s budget: an Electron cold start under load was observed taking >20s to map
# its window, and a 20s ceiling lost that race (live-reproduced 2026-08-11).
POLL_LIMIT=240
POLL_INTERVAL=0.5
SECOND_MOVE_DELAY=0.5

# Never let a missing table, display, or IceWM helper disturb a launcher.
[[ -n "${DISPLAY:-}" ]] || exit 0
command -v icesh >/dev/null 2>&1 || exit 0
[[ -r "${PLACEMENTS}" ]] || exit 0

place_window() {
  local mode="$1" pattern="$2" x="$3" y="$4"
  local tries=0
  local -a selector

  case "${mode}" in
    title|title-exact) selector=(-name "${pattern}") ;;
    class) selector=(-c "${pattern}") ;;
    *) return 0 ;;
  esac
  [[ "${x}" =~ ^-?[0-9]+$ && "${y}" =~ ^-?[0-9]+$ ]] || return 0

  while (( tries < POLL_LIMIT )); do
    if icesh "${selector[@]}" move "${x}" "${y}" >/dev/null 2>&1; then
      sleep "${SECOND_MOVE_DELAY}"
      icesh "${selector[@]}" move "${x}" "${y}" >/dev/null 2>&1 || true
      return 0
    fi
    sleep "${POLL_INTERVAL}"
    (( tries += 1 ))
  done
}

while IFS= read -r line || [[ -n "${line}" ]]; do
  [[ "${line}" =~ ^[[:space:]]*$ ]] && continue
  [[ "${line}" =~ ^[[:space:]]*# ]] && continue
  mode=''
  pattern=''
  x=''
  y=''
  extra=''
  read -r mode pattern x y extra <<< "${line}"
  [[ -n "${mode}" && -n "${pattern}" && -n "${x}" && -n "${y}" ]] || continue
  [[ -z "${extra}" ]] || continue
  place_window "${mode}" "${pattern}" "${x}" "${y}"
done < "${PLACEMENTS}"
# Dynamic menus — recent Documents + Desktop folder:16 ends here
