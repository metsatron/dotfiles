#!/usr/bin/env bash
# lane-janitor-cron-apply
# #+NAME: lane-janitor-cron-apply

# [[file:../../../services.org::lane-janitor-cron-apply][lane-janitor-cron-apply]]
set -euo pipefail

TAG="lane-janitor-cron-apply"
DRY=0
REMOVE=0
CRON_BIN="${LANE_JANITOR_CRON_BIN:-crontab}"
BEGIN="# BEGIN dotcortex-lane-janitor (managed by $TAG)"
END="# END dotcortex-lane-janitor (managed by $TAG)"

usage() {
  cat <<'EOF'
Usage: lane-janitor-cron-apply [--dry-run] [--remove]

Install or remove the hourly lane-janitor DRY-RUN crontab entry. Dry-run only:
--apply is a deliberate hand invocation and is never scheduled. Idempotent,
managed-block style, leaves every other crontab line alone.

Options:
  --dry-run    Print the crontab modifications without applying
  --remove     Remove the managed block
  -h, --help   Show this help
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --dry-run) DRY=1 ;;
    --remove)  REMOVE=1 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "$TAG: unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

current=$("$CRON_BIN" -l 2>/dev/null || true)
stripped=$(printf '%s\n' "$current" | awk -v b="$BEGIN" -v e="$END" '
  $0 == b { skip = 1; next }
  $0 == e { skip = 0; next }
  !skip   { print }
')

if [ "$REMOVE" -eq 1 ]; then
  proposed=$(printf '%s\n' "$stripped" | sed -e '/^$/d')
  if [ "$DRY" -eq 1 ]; then printf '%s\n' "$proposed"; exit 0; fi
  printf '%s\n' "$proposed" | "$CRON_BIN" -
  echo "$TAG: removed the managed lane-janitor block"
  exit 0
fi

block="$BEGIN
# Hourly DRY-RUN. Never --apply: applying is a deliberate hand invocation.
43 * * * * \"\$HOME/.local/bin/lane-janitor\" --report-containers >> \"\${XDG_STATE_HOME:-\$HOME/.local/state}/lane-janitor/scheduled.log\" 2>&1
$END"

proposed=$(printf '%s\n%s\n' "$stripped" "$block" | sed -e '/^$/d')
if [ "$DRY" -eq 1 ]; then printf '%s\n' "$proposed"; exit 0; fi
printf '%s\n' "$proposed" | "$CRON_BIN" -
echo "$TAG: installed the hourly lane-janitor DRY-RUN block"
# lane-janitor-cron-apply ends here
