#!/usr/bin/env bash
# dsdmine (Minesweeper) build script

# Clones DragonSWDev/dsdmine (C++17 + SDL2 + Dear ImGui, cross-platform
# Minesweeper) and builds it inside the sanctuary using the room-fvwm95
# build profile (cmake + gcc + sdl2 dev). Installs the binary + assets to
# =~/.local/share/dsdmine/=.


# [[file:../../../sanctuary-redstone-9x.org::*dsdmine (Minesweeper) build script][dsdmine (Minesweeper) build script:1]]
set -euo pipefail

usage() {
  cat <<EOF
sanctuary-redstone-9x-dsdmine-build - build dsdmine inside sanctuary-redstone-9x

Usage: sanctuary-redstone-9x-dsdmine-build
       sanctuary-redstone-9x-dsdmine-build -h | --help

No arguments. Clones and builds DragonSWDev/dsdmine with the room-fvwm95
Guix profile, then installs the binary and assets in the guest home.
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if (( $# > 0 )); then
  usage >&2
  exit 1
fi

SANCTUARY="sanctuary-redstone-9x"
GH="${HOME}/.local/share/dotcortex/guests/${SANCTUARY}/home"
BUILD_DIR="${GH}/.cache/dsdmine-build"
INSTALL_DIR="${GH}/.local/share/dsdmine"

echo "dsdmine-build: cloning DragonSWDev/dsdmine into ${BUILD_DIR}…"
rm -rf "${BUILD_DIR}"
git clone --depth 1 https://github.com/DragonSWDev/dsdmine "${BUILD_DIR}"

echo "dsdmine-build: building inside ${SANCTUARY}…"
sanctuary-exec "${SANCTUARY}" bash -c '
set -e
GUIX_PROFILE=${HOME}/.guix-extra-profiles/room-fvwm95/room-fvwm95
. ${GUIX_PROFILE}/etc/profile
BUILD_DIR="'"${BUILD_DIR}"'"
INSTALL_DIR="'"${INSTALL_DIR}"'"
mkdir -p "${BUILD_DIR}/build"
cd "${BUILD_DIR}/build"
cmake .. -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX="${INSTALL_DIR}"
make -j"$(nproc)"
mkdir -p "${INSTALL_DIR}"
cp -f dsdmine "${INSTALL_DIR}/dsdmine"
cp -rf "${BUILD_DIR}/assets" "${INSTALL_DIR}/assets"
chmod +x "${INSTALL_DIR}/dsdmine"
'
echo "dsdmine-build: done. Binary + assets installed to ${INSTALL_DIR}"
# dsdmine (Minesweeper) build script:1 ends here
