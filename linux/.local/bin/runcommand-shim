#!/bin/bash
# Ports launch scripts


# [[file:../../../retropie.org::*Ports launch scripts][Ports launch scripts:1]]
# Translate RetroPie's runcommand.sh port signature to Guix-room commands.
# The caller contract is: runcommand.sh 0 _PORT_ <system> <rom> [extra args…]
set -euo pipefail

usage() {
  cat <<'EOF'
runcommand-shim - Guix-room replacement for RetroPie's runcommand.sh port lane

Usage:
  runcommand-shim 0 _PORT_ <system> <rom> [extra args…]
  runcommand-shim -h | --help

RUNCOMMAND_SHIM_DRYRUN=1 prints the resolved command without executing it.
Only provisioned engines are executed; unsupported X230 engines fail loudly.
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if (( $# < 4 )); then
  usage >&2
  exit 2
fi

set -euo pipefail

RUNCOMMAND_MODE="$1"
RUNCOMMAND_TOKEN="$2"
SYSTEM="$3"
ROM="$4"
shift 4

GUIX_PROFILES="${GUIX_PROFILES:-${HOME}/.guix-extra-profiles}"
ROOM_PROFILE="${GUIX_PROFILES}/room-retropie/room-retropie"
ROOM_GAMING_PROFILE="${GUIX_PROFILES}/room-gaming/room-gaming"
RETROARCH_CONFIG="${RETROARCH_CONFIG:-${HOME}/.config/retroarch/retroarch.cfg}"

# Declarative X230 command inventory. Values are diagnostics for an engine that
# is not yet provisioned; they are never executed as shell text.
declare -A X230_WANTED=(
  [doom]='retroarch -L <room-retropie>/lib/libretro/prboom_libretro.so --config <cfg> %ROM%'
  [quake]='retroarch -L <room-retropie>/lib/libretro/tyrquake_libretro.so --config <cfg> %ROM%'
  [quake2]='yquake2 -datadir ~/RetroPie/roms/ports/quake2 +set vid_renderer gl1 +set game %ROM%'
  [quake3]='ioquake3.x86_64'
  [duke3d]='pushd <cfgdir>; eduke32.sh %ROM%; popd'
  [wolf3d]='wolf4sdl.sh %ROM%'
  [ionfury]='pushd <cfgdir>; fury.sh %ROM%; popd'
  [cgenius]='pushd <portdir>; ./CGeniusExe; popd'
  [cannonball]='cannonball'
  [cavestory]='cavestory <Doukutsu.exe>'
  [descent1]='descent-rebirth'
  [descent2]='descent-rebirth'
  [dinothawr]='dinothawr'
  [micropolis]='micropolis'
  [mrboom]='mrboom'
  [openblok]='openblok'
  [openpht]='openpht'
  [openttd]='openttd'
  [opentyrian]='opentyrian'
  [srb2]='srb2'
  [supertux]='supertux'
  [vvvvvv]='vvvvvv'
)

source_profile() {
  local profile="$1"
  if [[ ":${PATH:-}:" != *":${profile}/bin:"* && -r "${profile}/etc/profile" ]]; then
    GUIX_PROFILE="${profile}"
    export GUIX_PROFILE
    # shellcheck disable=SC1090
    . "${profile}/etc/profile"
  fi
}

not_provisioned() {
  local system="$1"
  local wanted="${X230_WANTED[${system}]:-no X230 mapping recorded}"
  printf "runcommand-shim: engine for '%s' not provisioned in Guix rooms yet (wanted: %s)\n" \
    "${system}" "${wanted}" >&2
  exit 1
}

# Always make the declared RetroPie room available before resolving a command.
source_profile "${ROOM_PROFILE}"

command=()
case "${SYSTEM}" in
  doom)
    CORE="${ROOM_PROFILE}/lib/libretro/prboom_libretro.so"
    [[ -x "${ROOM_PROFILE}/bin/retroarch" && -f "${CORE}" ]] || \
      [[ "${RUNCOMMAND_SHIM_DRYRUN:-0}" == 1 ]] || not_provisioned "${SYSTEM}"
    command=("${ROOM_PROFILE}/bin/retroarch" -L "${CORE}" --config "${RETROARCH_CONFIG}" "${ROM}")
    ;;
  quake)
    CORE="${ROOM_PROFILE}/lib/libretro/tyrquake_libretro.so"
    [[ -x "${ROOM_PROFILE}/bin/retroarch" && -f "${CORE}" ]] || \
      [[ "${RUNCOMMAND_SHIM_DRYRUN:-0}" == 1 ]] || not_provisioned "${SYSTEM}"
    command=("${ROOM_PROFILE}/bin/retroarch" -L "${CORE}" --config "${RETROARCH_CONFIG}" "${ROM}")
    ;;
  openttd)
    # OpenTTD is a Guix-room-gaming binary already used by the Redstone menu.
    source_profile "${ROOM_GAMING_PROFILE}"
    command -v openttd >/dev/null 2>&1 || \
      [[ "${RUNCOMMAND_SHIM_DRYRUN:-0}" == 1 ]] || not_provisioned "${SYSTEM}"
    command=("$(command -v openttd 2>/dev/null || printf '%s/bin/openttd' "${ROOM_GAMING_PROFILE}")")
    [[ -n "${ROM}" ]] && command+=("${ROM}")
    ;;
  *)
    not_provisioned "${SYSTEM}"
    ;;
esac

command+=("$@")

if [[ "${RUNCOMMAND_SHIM_DRYRUN:-0}" == 1 ]]; then
  printf 'runcommand-shim: dry-run:'
  printf ' %q' "${command[@]}"
  printf '\n'
  exit 0
fi

exec "${command[@]}"
# Ports launch scripts:1 ends here
