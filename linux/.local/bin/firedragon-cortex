#!/bin/env bash
# Fleet-facing launchers

# These are the T480s/X230-compatible front doors. They invoke an SSH alias only;
# the actual host mapping remains machine-local in the user's SSH configuration.


# [[file:../../../sanctuary-cortex.org::*Fleet-facing launchers][Fleet-facing launchers:1]]
set -euo pipefail

REMOTE="${SANCTUARY_CORTEX_SSH_ALIAS:-kikin}"
exec ssh "$REMOTE" sanctuary-cortex-app firedragon "$@"
# Fleet-facing launchers:1 ends here
