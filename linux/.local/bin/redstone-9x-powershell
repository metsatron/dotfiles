#!/bin/bash
# [[file:../../../sanctuary-redstone-9x-desktop.org::*Command Prompt and PowerShell Run-box shims][Command Prompt and PowerShell Run-box shims:2]]
set -euo pipefail
# `powershell` / `pwsh` in the Run box -> Windows PowerShell in a Consolas xterm,
# matching the Terminals menu "Windows PowerShell" entry.
exec redstone-9x-run xterm -class redstone-powershell -title PowerShell \
  -geometry 80x25 -fa "Consolas" -fs 11 -bg "#012456" -fg "#EEEDF0" -cr "#EEEDF0" \
  -e redstone-9x-pwsh
# Command Prompt and PowerShell Run-box shims:2 ends here
