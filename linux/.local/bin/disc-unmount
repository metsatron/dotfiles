#!/usr/bin/env bash
# disc-unmount [IMAGE|MOUNTPOINT]
# Unmount a fuseiso disc image mounted by disc-mount-browse. With no argument (or
# an argument that maps to nothing) unmounts every disc image under the runtime
# mount root. Wired to the Thunar "Unmount disc image" custom action.
set -euo pipefail

root="${XDG_RUNTIME_DIR:-$HOME/.cache}/disc-mounts"

note() { command -v notify-send >/dev/null 2>&1 && notify-send "Disc image" "$1" 2>/dev/null || true; }

drop() {
  local m="$1"
  [ -n "$m" ] || return 0
  if awk -v mp="$m" '$2==mp{f=1} END{exit !f}' /proc/mounts 2>/dev/null; then
    fusermount -u -- "$m" 2>/dev/null || umount -- "$m" 2>/dev/null || return 1
  fi
  rmdir -- "$m" 2>/dev/null || true
}

done_any=0
if [ "$#" -ge 1 ] && [ -n "${1:-}" ]; then
  arg="$1"
  if [ -d "$arg" ] && awk -v mp="$arg" '$2==mp{f=1} END{exit !f}' /proc/mounts 2>/dev/null; then
    drop "$arg" && done_any=1
  else
    name=$(basename -- "$arg"); name="${name%.*}"
    name=$(printf '%s' "$name" | tr -c 'A-Za-z0-9._-' '_')
    if drop "$root/$name"; then done_any=1; fi
  fi
fi

# Fall back to unmounting everything if the targeted attempt did nothing.
if [ "$done_any" -eq 0 ] && [ -d "$root" ]; then
  for m in "$root"/*/; do
    [ -d "${m%/}" ] || continue
    drop "${m%/}" && done_any=1
  done
fi

note "Unmounted."
