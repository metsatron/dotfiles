#!/bin/bash


# The border-only test library has one deliberately narrow applier and one dynamic
# menu generator.  The applier accepts only a direct child of
# =~/.icewm/themes/= containing =default.theme=, writes the theme pointer
# atomically, and asks the running IceWM to reload; it never invokes
# =redstone-9x-scheme-apply=, so all non-IceWM appearance layers stay untouched.
# The generator reads the deployed theme directory every time its submenu opens,
# then groups the complete inventory by initial character so hundreds of donors
# remain navigable.


# [[file:../../../sanctuary-redstone-9x-fvwm95.org::*FVWM95 configuration][FVWM95 configuration:4]]
# redstone-9x-border-apply THEME — test one IceWM theme without changing the
# active Redstone Desktop Scheme's GTK, Qt, icons, wallpaper, sounds, or labels.
set -euo pipefail

theme="${1:?usage: redstone-9x-border-apply THEME}"
case "${theme}" in
  ""|"."|".."|*/*|*[!A-Za-z0-9._+\ -]*)
    printf 'redstone-9x-border-apply: invalid theme name: %q\n' "${theme}" >&2
    exit 2
    ;;
esac

theme_dir="${HOME}/.icewm/themes/${theme}"
if [[ ! -f "${theme_dir}/default.theme" ]]; then
  printf 'redstone-9x-border-apply: theme is not deployed: %s\n' "${theme}" >&2
  exit 1
fi

mkdir -p "${HOME}/.icewm"
theme_file="${HOME}/.icewm/theme"
temporary="${theme_file}.tmp.$$"
trap 'rm -f -- "${temporary}"' EXIT
printf 'Theme="%s"\n' "${theme}" > "${temporary}"
chmod 0644 "${temporary}"
mv -f -- "${temporary}" "${theme_file}"
trap - EXIT

icewm -r
# FVWM95 configuration:4 ends here
