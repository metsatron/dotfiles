#!/usr/bin/env bash
# Obsidian host URI ownership

# The host always owns =obsidian://= with the official Flathub identity.  Redstone
# sets its own association inside its guest XDG tree and private D-Bus session.


# [[file:../../../package-flatpak.org::*Obsidian host URI ownership][Obsidian host URI ownership:1]]
set -euo pipefail

OFFICIAL_DESKTOP="md.obsidian.Obsidian.desktop"
SCHEME="x-scheme-handler/obsidian"

command -v xdg-mime >/dev/null 2>&1 || {
  echo "obsidian-host-uri-apply: xdg-mime not found" >&2
  exit 1
}

xdg-mime default "${OFFICIAL_DESKTOP}" "${SCHEME}"
actual="$(xdg-mime query default "${SCHEME}")"
if [[ "${actual}" != "${OFFICIAL_DESKTOP}" ]]; then
  echo "obsidian-host-uri-apply: expected ${OFFICIAL_DESKTOP}, got ${actual:-none}" >&2
  exit 1
fi

echo "obsidian-host-uri-apply: host ${SCHEME} -> ${OFFICIAL_DESKTOP}"
# Obsidian host URI ownership:1 ends here
