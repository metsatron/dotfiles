#!/usr/bin/env bash
# keyring-janitor-cron-apply
# #+NAME: keyring-janitor-cron-apply

# [[file:../../../services.org::keyring-janitor-cron-apply][keyring-janitor-cron-apply]]
set -euo pipefail

TAG="keyring-janitor-cron-apply"
DRY=0
REMOVE=0
CRON_BIN="${KEYRING_JANITOR_CRON_BIN:-crontab}"
BEGIN="# BEGIN dotcortex-keyring-janitor (managed by $TAG)"
END="# END dotcortex-keyring-janitor (managed by $TAG)"

usage() {
  cat <<'EOF'
Usage: keyring-janitor-cron-apply [--dry-run] [--remove]

Install or remove the hourly keyring-janitor user crontab entry.
Idempotent: replaces only its own managed block, leaves everything else alone.

Options:
  --dry-run    Print the crontab modifications without applying
  --remove     Remove the managed block from crontab
  -h, --help   Show this help
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --dry-run) DRY=1 ;;
    --remove)  REMOVE=1 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "$TAG: unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

current=$("$CRON_BIN" -l 2>/dev/null || true)
stripped=$(printf '%s\n' "$current" | awk -v b="$BEGIN" -v e="$END" '
  $0 == b { skip = 1; next }
  $0 == e { skip = 0; next }
  !skip   { print }
')

if [ "$REMOVE" -eq 1 ]; then
  proposed=$(printf '%s\n' "$stripped" | sed -e '/^$/d')
  if [ "$DRY" -eq 1 ]; then
    printf '%s\n' "$proposed"
    exit 0
  fi
  printf '%s\n' "$proposed" | "$CRON_BIN" -
  echo "$TAG: removed the managed keyring-janitor block"
  exit 0
fi

block="$BEGIN
# Hourly: reap orphaned empty session keyrings leaked by rootless containers.
17 * * * * \"\$HOME/.local/bin/keyring-janitor\" --quiet >/dev/null 2>&1
$END"

proposed=$(printf '%s\n%s\n' "$stripped" "$block" | sed -e '/^$/d')

if [ "$DRY" -eq 1 ]; then
  printf '%s\n' "$proposed"
  exit 0
fi

printf '%s\n' "$proposed" | "$CRON_BIN" -
echo "$TAG: installed the hourly keyring-janitor block"
# keyring-janitor-cron-apply ends here
