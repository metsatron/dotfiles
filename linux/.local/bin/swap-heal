#!/bin/env bash
# swap-heal – safe swap purge + desktop/Flatpak heal
# Fleet-general Linux tool (was x230-only): promoted to the shared =linux/= scope on 2026-09-11 so every fleet box can heal its swap. It is safe by construction and portable by degradation. The RAM-safety guard refuses to proceed unless MemAvailable can hold the swap currently in use (override only with =SWAP_HEAL_FORCE=1=, which risks OOM), so it never blindly =swapoff='s more than RAM can absorb. The zram-device reset is init-agnostic (systemd → OpenRC → sysvinit → skip) and only runs when a zram device actually exists — plain disk-swap boxes (e.g. kikin-kushi, which has no zram) skip it entirely. The XFCE and Flatpak heal steps are =command -v= guarded and self-skip on headless hosts. loom tasks: =swap:heal= (safe) and =swap:heal!= (forced).

# [[file:../../../services.org::*swap-heal – safe swap purge + desktop/Flatpak heal][swap-heal – safe swap purge + desktop/Flatpak heal:1]]
#!/bin/env bash
set -euo pipefail

log() { printf '[swap-heal] %s\n' "$*"; }

# 1) Inspect RAM + swap
mem_available_kb=$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo)
swap_total_kb=$(awk '/^SwapTotal:/     {print $2}' /proc/meminfo)
swap_free_kb=$(awk '/^SwapFree:/      {print $2}' /proc/meminfo)
swap_used_kb=$((swap_total_kb - swap_free_kb))

log "MemAvailable: ${mem_available_kb} KiB"
log "Swap used:    ${swap_used_kb} KiB"

if (( swap_total_kb == 0 )); then
  log "No swap configured, nothing to do."
  exit 0
fi

# Simple safety rule: need at least as much free RAM as swap in use
needed_kb=${swap_used_kb}

if (( mem_available_kb < needed_kb )) && [[ "${SWAP_HEAL_FORCE:-0}" != 1 ]]; then
  log "Not enough free RAM to safely clear swap (need ${needed_kb} KiB)."
  log "Set SWAP_HEAL_FORCE=1 if you really want to override this (risk of OOM)."
  exit 1
fi

if [[ "${SWAP_HEAL_FORCE:-0}" == 1 ]]; then
  log "SWAP_HEAL_FORCE=1 set, ignoring RAM safety check. This may OOM the system."
else
  log "Enough RAM available, proceeding with swap purge."
fi

# 2) Drop caches
log "Dropping caches (vm.drop_caches=3)…"
if ! sudo sh -c 'echo 3 > /proc/sys/vm/drop_caches'; then
  log "WARNING: could not write vm.drop_caches; continuing anyway."
fi

# 3) swapoff + (init-agnostic) zram reset + swapon
log "swapoff -a…"
sudo swapoff -a

# Reset the zram swap device between swapoff/swapon so it starts clean.
# Only meaningful where zram is actually configured; plain disk-swap boxes
# (e.g. kikin-kushi) have no /dev/zram0 and skip this entirely. The service
# manager is detected rather than assumed, so this is correct on systemd,
# OpenRC and sysvinit alike.
if [ -e /dev/zram0 ]; then
  if command -v systemctl >/dev/null 2>&1 && systemctl list-unit-files zramswap.service >/dev/null 2>&1; then
    log "Resetting zram via systemd (zramswap.service)…"
    sudo systemctl restart zramswap.service || log "zramswap.service restart failed; continuing."
  elif command -v rc-service >/dev/null 2>&1 && rc-service --exists zramswap 2>/dev/null; then
    log "Resetting zram via OpenRC (zramswap)…"
    sudo rc-service zramswap restart || log "OpenRC zramswap restart failed; continuing."
  elif [ -x /etc/init.d/zramswap ]; then
    log "Resetting zram via sysvinit (/etc/init.d/zramswap)…"
    sudo /etc/init.d/zramswap restart || log "sysvinit zramswap restart failed; continuing."
  else
    log "zram present but no zramswap service manager found; leaving zram as-is."
  fi
else
  log "No zram device (plain disk swap); nothing to reset."
fi

log "swapon -a…"
sudo swapon -a

# Make sure zram actually ends up as swap if it exists
if [ -e /dev/zram0 ]; then
  disksize=$(cat /sys/block/zram0/disksize 2>/dev/null || echo 0)
  if [ "$disksize" -gt 0 ] && ! grep -q '^/dev/zram0' /proc/swaps; then
    log "Enabling zram swap on /dev/zram0…"
    if ! sudo swapon /dev/zram0 2>/dev/null; then
      log "WARNING: swapon /dev/zram0 failed; zram still not active."
    fi
  else
    log "zram0 already active or no disksize set, skipping swapon."
  fi
else
  log "/dev/zram0 not present; nothing to enable."
fi

# 4) Heal XFCE desktop
if command -v xfce4-heal >/dev/null 2>&1; then
  log "Running xfce4-heal…"
  xfce4-heal
else
  log "xfce4-heal not found; skipping."
fi

# 5) Heal Flatpak bridge + fontcache
if command -v flatpak-desktop-bridge >/dev/null 2>&1; then
  log "Refreshing Flatpak desktop bridge…"
  flatpak-desktop-bridge
fi

if command -v flatpak-fontcache-refresh >/dev/null 2>&1; then
  log "Refreshing Flatpak font cache…"
  flatpak-fontcache-refresh
fi

log "swap-heal ritual complete."
# swap-heal – safe swap purge + desktop/Flatpak heal:1 ends here
