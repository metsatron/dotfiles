#!/usr/bin/env bash
# Redstone 9X — capture before/after screenshots for review.
# Run from the HOST once a sanctuary session is up on :93.
# Requires: xwd (host). Produces PNGs via ffmpeg.
set -euo pipefail
OUT="${1:-/tmp/redstone-shots}"
mkdir -p "$OUT"
shot() {  # name
  local f="$OUT/$1-$(date +%H%M%S).png"
  DISPLAY=:93 timeout 5 xwd -root -silent 2>/dev/null | \
    ffmpeg -y -loglevel error -f xwd_pipe -i - "$f" 2>/dev/null && echo "saved $f"
}
echo "Capturing to $OUT (display :93 must be a live Redstone session)…"
shot 01-icewm-desktop
shot 02-icewm-menu         # open the IceWM start menu first, then re-run this line
shot 03-fvwm95-desktop
shot 04-fvwm95-taskbar
echo "done."
