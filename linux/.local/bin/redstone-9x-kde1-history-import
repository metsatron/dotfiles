# Widget engines are an explicit part of each reconstructed variant.  KDE 1's
# kdisplay style tab let the user toggle "Draw widgets in the style of
# Windows 95", so every colour scheme is emitted in BOTH control geometries
# (classic/Win95 and motif/CDE).  This table records the historically-attested
# style — the one visible in surviving desktop captures — which keeps the
# unsuffixed scheme identity; the counterpart carries a -w95/-cde suffix.
# Complete theme bundles stay single-style.
COLOR_WIDGET_STYLES = {
    "atlas-green": "classic",
    "blue-slate": "classic",
    "cde": "motif",
