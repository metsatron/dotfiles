@dataclass(frozen=True)
class ColorSpec:
    name: str
    slug: str
    date: str
    commit: str
    tree: str
    path: str
    sha256: str


@dataclass(frozen=True)
class ThemeSpec:
    name: str
    slug: str
    date: str
    commit: str
    tree: str
    source_kind: str
    path: str
    sha256: str


