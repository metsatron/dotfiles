# Restrained-chrome bundles (pilot 2026-07-30, canonized 2026-07-31): KDE 1's
# ornamental KWM facade bitmaps were authored for KWM's arbitrary border
# geometry and clip/tile wrongly when raw-copied into IceWM's pixmap slots.
# Bundles listed here skip the raw graft entirely and instead derive their
# chrome from the bundle's own themerc data — titlebar gradients from
# activeBackground/activeBlend and desktop gradient from the [Display]
# declaration — drawn on the KDE-1-Alpha donor geometry with the curated
# Alpha caption buttons, ramp-recoloured to the bundle palette.
RESTRAINED_SLUGS = frozenset(
    {"astronique", "bryce", "default", "glax", "mgbreizh", "wood"}
)

# Wood's upstream wallpaper and titlebar are the wood-grain bitmap the user
# ruled hideous (2026-07-28 session); Glax's bitmap is a tiny centred image
# that reads as a postage stamp at 1080p (ruled out 2026-07-31).  Both take a
# clean procedural palette gradient instead.
RESTRAINED_FORCE_GRADIENT = frozenset({"glax", "wood"})

# MGBreizh's kdegear.jpg is correctly centred, unscaled — it needs a black
# surround (and black desktop) to blend into, per the 2026-07-31 ruling.
CENTERED_BLACK_SLUGS = frozenset({"mgbreizh"})

# Repair-mode bundles (2026-07-31): Nostalgy's art is genuinely unfinished
# upstream but nearly IceWM-shaped — 18px tileable titlebar pixmaps and 3px
# borders graft cleanly; only its 15x15 single-frame buttons clip, because
# IceWM wants double-height normal+pressed pixmaps.  Repair keeps ALL of the
# bundle's own art and composes proper two-frame buttons from the originals
# instead of replacing the theme with restrained chrome.
REPAIR_SLUGS = frozenset({"nostalgy"})

ICON_EPOCHS = (
    ("Alpha Original", "alpha-original", "1997-04-13", "KDE-1-Alpha-Original"),
    ("Warm Sculpted", "warm-original", "1997-09-13", "KDE-1-Beta-Warm-Original"),
    ("Classic Silver", "classic-silver", "1998-02-23", "KDE-1-Classic-Silver-Original"),
    ("HiColor", "hicolor", "1999-08-01", "KDE-1-HiColor-Original"),
)


def run(repo: Path, *args: str) -> bytes:
    return subprocess.run(
        ["git", "-C", str(repo), *args],
        check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
    ).stdout


def sha256(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def verify_commit(repo: Path, commit: str, tree: str | None = None) -> None:
    resolved = run(repo, "rev-parse", "--verify", f"{commit}^{{commit}}").decode().strip()
    if resolved != commit:
        raise SystemExit(f"commit mismatch: expected {commit}, got {resolved}")
    if tree:
        actual = run(repo, "show", "-s", "--format=%T", commit).decode().strip()
        if actual != tree:
            raise SystemExit(f"{commit}: tree mismatch: expected {tree}, got {actual}")


def safe_tar_members(tf: tarfile.TarFile):
    for member in tf.getmembers():
        p = PurePosixPath(member.name)
        if p.is_absolute() or ".." in p.parts or member.issym() or member.islnk():
            raise SystemExit(f"unsafe historical archive member: {member.name}")
        yield member


def extract_theme(repo: Path, spec: ThemeSpec, destination: Path) -> None:
    verify_commit(repo, spec.commit, spec.tree)
    if spec.source_kind == "tar":
        payload = run(repo, "show", f"{spec.commit}:{spec.path}")
        if sha256(payload) != spec.sha256:
            raise SystemExit(f"{spec.name}: tarball checksum mismatch")
        with tarfile.open(fileobj=io.BytesIO(payload), mode="r:gz") as tf:
            tf.extractall(destination, members=safe_tar_members(tf))
    else:
        payload = run(repo, "archive", "--format=tar", spec.commit, spec.path)
        if sha256(payload) != spec.sha256:
            raise SystemExit(f"{spec.name}: git archive checksum mismatch")
        with tempfile.TemporaryDirectory(prefix="kde1-theme-") as td:
            tmp = Path(td)
            with tarfile.open(fileobj=io.BytesIO(payload), mode="r:") as tf:
                tf.extractall(tmp, members=safe_tar_members(tf))
            shutil.copytree(tmp / spec.path, destination, dirs_exist_ok=True)


def color_value(value: str | None, fallback: tuple[int, int, int]) -> tuple[int, int, int]:
    if not value:
        return fallback
    value = value.strip()
    named = {"black": (0, 0, 0), "white": (255, 255, 255)}
    if value.lower() in named:
        return named[value.lower()]
    if re.fullmatch(r"#[0-9a-fA-F]{6}", value):
        return tuple(int(value[i:i + 2], 16) for i in (1, 3, 5))
    if re.fullmatch(r"\d+\s*,\s*\d+\s*,\s*\d+", value):
        return tuple(max(0, min(255, int(x))) for x in value.split(","))
    return fallback


def parse_ini(path: Path) -> tuple[configparser.ConfigParser, dict[str, str]]:
    cp = configparser.ConfigParser(strict=False, interpolation=None)
    cp.optionxform = str
    cp.read(path, encoding="latin-1")
    section = next((cp[s] for s in cp.sections() if s.lower() in ("colors", "color scheme")), {})
    return cp, {k.lower(): v for k, v in section.items()}


def palette(values: dict[str, str]) -> dict[str, tuple[int, int, int]]:
    def pick(keys, fallback):
        return color_value(next((values[k] for k in keys if k in values), None), fallback)
    return {
        "face": pick(("backgroundcolor", "background"), (192, 192, 192)),
        "text": pick(("textcolor", "foreground"), (0, 0, 0)),
        "select": pick(("selectcolor", "selectbackground"), (0, 0, 128)),
        "select_text": pick(("selecttextcolor", "selectforeground"), (255, 255, 255)),
        "active": pick(("activetitlebarcolor", "activebackground"), (0, 0, 128)),
        "active_text": pick(("activetitletextcolor", "activeforeground"), (255, 255, 255)),
        "inactive": pick(("inactivetitlebarcolor", "inactivebackground"), (128, 128, 128)),
        "inactive_text": pick(("inactivetitletextcolor", "inactiveforeground"), (192, 192, 192)),
        "window": pick(("windowcolor", "windowbackground"), (255, 255, 255)),
        "window_text": pick(("windowtextcolor", "windowforeground"), (0, 0, 0)),
    }


def hx(rgb: tuple[int, int, int]) -> str:
    return "#%02X%02X%02X" % rgb


def contrast(rgb: tuple[int, int, int]) -> tuple[int, int, int]:
    lum = 0.2126 * rgb[0] + 0.7152 * rgb[1] + 0.0722 * rgb[2]
    return (0, 0, 0) if lum >= 140 else (255, 255, 255)


def write_dp(path: Path, pal: dict[str, tuple[int, int, int]], desktop) -> None:
    sets = (pal["active"], pal["face"], pal["face"], pal["window"],
            pal["face"], pal["face"], pal["select"], desktop)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(
        "".join("#" + "".join(f"{c:02x}00" for c in rgb) + "\n" for rgb in sets),
        encoding="ascii",
    )


def recolor_classic_gtk(
    repo_root: Path,
    name: str,
    pal: dict[str, tuple[int, int, int]],
) -> None:
    """Clone Windows-95 controls while retaining the historical KDE palette."""
    source = repo_root / "linux/.themes/Windows-95"
    target = repo_root / "linux/.themes" / name
    if not source.is_dir():
        raise SystemExit(f"Windows-Classic GTK donor missing: {source}")
    if target.exists():
        shutil.rmtree(target)
    target.mkdir(parents=True)
    for dirname in ("gtk-2.0", "gtk-3.0", "gtk-4.0"):
        if (source / dirname).is_dir():
            shutil.copytree(source / dirname, target / dirname)
    for filename in ("index.theme", "LICENSE", "README.md"):
        if (source / filename).is_file():
            shutil.copy2(source / filename, target / filename)

    face = pal["face"]
    select = pal["select"]
    text = pal["text"]
    window = pal["window"]
    if is_dark_face(face):
        # Text law (2026-07-30): text is black or white by surface luminance —
        # a palette-grey on a mid-grey face is unreadable.  Dark faces take
        # pure white UI text; light faces keep the authentic palette text.
        text = contrast(face)
    face_plus = tuple(min(255, channel + 3) for channel in face)
    light = tuple(round(channel + (255 - channel) * .35) for channel in face)
    color_map = {
        (0xC0, 0xC0, 0xC0): face,
        (0xC3, 0xC3, 0xC3): face_plus,
        (0xD4, 0xD0, 0xC8): face,
        (0xDF, 0xDF, 0xDF): light,
        (0xE0, 0xE0, 0xE0): light,
        (0x00, 0x00, 0x80): select,
    }
    # Dark bevel law (2026-07-30): the donor's Win95 light-theme bevel is
    # wrong on a dark face — the white/#ececec highlights glow, the doubled
    # highlight reads 2px thick, and the mid-grey shadows smudge.  Dark faces
    # collapse the inner highlight into the face, keep one subtle highlight
    # (~face+25% toward white), take a face-derived bevel shadow, and end in a
    # pure black outer shadow.  The extra entries live in a PNG-only map:
    # remapping #ffffff in the text files would defeat the base_color regex
    # below, which must still see the donor's literal white.
    dark = is_dark_face(face)
    png_map = dict(color_map)
    if dark:
        highlight = toward_white(face, .25)
        color_map[(0xDF, 0xDF, 0xDF)] = face
        color_map[(0xE0, 0xE0, 0xE0)] = face
        png_map.update(color_map)
        png_map.update({
            (0xFF, 0xFF, 0xFF): highlight,
            (0xEC, 0xEC, 0xEC): highlight,
            (0x80, 0x80, 0x80): toward_black(face, .5),
            (0x40, 0x40, 0x40): (0, 0, 0),
        })
    # Scrollbar/spinner arrow glyphs are black triangles that vanish on a dark
    # face; only inside arrows/ is black unambiguously a glyph.
    arrows_map = dict(png_map)
    if dark:
        arrows_map[(0x00, 0x00, 0x00)] = (
            text if not is_dark_face(text) else (192, 192, 192)
        )
    text_extensions = {".css", ".rc", ".svg", ".ini", ".theme"}
    for path in target.rglob("*"):
        if not path.is_file() or path.is_symlink():
            continue
        if (
            path.suffix.lower() in text_extensions
            or path.name.startswith("gtkrc")
        ):
            content = path.read_text(encoding="latin-1")
            for old, new in color_map.items():
                old_hex = "#%02x%02x%02x" % old
                new_hex = hx(new)
                content = re.sub(re.escape(old_hex), new_hex, content,
                                 flags=re.IGNORECASE)
                spaced = f"{old[0]}, {old[1]}, {old[2]}"
                compact = f"{old[0]},{old[1]},{old[2]}"
                content = content.replace(spaced, f"{new[0]}, {new[1]}, {new[2]}")
                content = content.replace(compact, f"{new[0]},{new[1]},{new[2]}")
            content = content.replace("Windows-95", name)
            content = content.replace("Windows 95", name)
            # Per-surface text law (2026-07-31, the MGBreizh lesson): fg sits
            # on the FACE, view text sits on the BASE/window field — flipping
            # both by face luminance painted white tree labels onto
            # MGBreizh's white base.  Each surface judges its own contrast.
            view_text = contrast(window) if is_dark_face(face) else text
            content = re.sub(
                r"(fg_color\s*[:=]\s*)#000000",
                lambda match: match.group(1) + hx(text),
                content,
                flags=re.IGNORECASE,
            )
            content = re.sub(
                r"(text_color\s*[:=]\s*)#000000",
                lambda match: match.group(1) + hx(view_text),
                content,
                flags=re.IGNORECASE,
            )
            content = re.sub(
                r"((?:base|unfocused_base)_color\s*[:=]\s*)#(?:fff|ffffff)",
                lambda match: match.group(1) + hx(window),
                content,
                flags=re.IGNORECASE,
            )
            if dark and path.suffix.lower() == ".css":
                # GTK3/4 draw the widgets the room actually shows, and they
                # do it in CSS, not pixmaps (found 2026-07-30 after a fix
                # verified only against the gtk-2.0 pngs).  Same dark bevel
                # law, CSS edition: text out of black, base fields out of
                # white, the #ececec highlight family to the single subtle
                # highlight, the #7d7d7d shadow family to the face shadow.
                # border-color/box-shadow #000000 stays — that IS the outer
                # shadow the law wants.
                css_text = text if not is_dark_face(text) else (192, 192, 192)
                content = re.sub(
                    r"(?<![-\w])color:\s*#000000", "color: " + hx(css_text),
                    content,
                )
                if view_text != css_text:
                    # View-scoped rule blocks (.view, iconview, textview) hold
                    # text that sits on the BASE field, not the face — the
                    # generic flip above painted MGBreizh's icon-view labels
                    # white on its white base (found 2026-07-31).  Re-judge
                    # those blocks against the base surface.  Property-anchored
                    # so background-color stays untouched.
                    def _viewfix(match):
                        body = re.sub(
                            r"(?<![-\w])color:\s*"
                            + re.escape(hx(css_text)),
                            "color: " + hx(view_text),
                            match.group(2), flags=re.IGNORECASE,
                        )
                        return match.group(1) + "{" + body + "}"
                    content = re.sub(
                        r"([^{}]*(?:iconview|textview|\.view)[^{}]*)"
                        r"\{([^{}]*)\}",
                        _viewfix, content,
                    )
                content = re.sub(
                    r"(@define-color theme_(?:fg|unfocused_fg)_color) #000000",
                    r"\1 " + hx(css_text), content,
                )
                content = re.sub(
                    r"(@define-color theme_(?:text|unfocused_text)_color)"
                    r" #000000",
                    r"\1 " + hx(view_text), content,
                )
                content = re.sub(
                    r"(@define-color (?:theme_base|insensitive_base|"
                    r"theme_unfocused_base)_color) #ffffff",
                    r"\1 " + hx(window), content, flags=re.IGNORECASE,
                )
                content = re.sub(
                    r"(background(?:-color)?:\s*)#(?:ffffff|fff\b)",
                    r"\g<1>" + hx(window), content, flags=re.IGNORECASE,
                )
                css_highlight = hx(toward_white(face, .25))
                css_shadow = hx(toward_black(face, .5))
                for old, new in (("#ececec", css_highlight),
                                 ("#e3e3e3", css_highlight),
                                 ("#7d7d7d", css_shadow),
                                 ("#a3a3a3", css_shadow)):
                    content = re.sub(re.escape(old), new, content,
                                     flags=re.IGNORECASE)
            path.write_text(content, encoding="latin-1")
        elif path.suffix.lower() == ".png":
            # GTK3 draws its scrollbar steppers from assets/arrow-*.png, not
            # from an arrows/ dir — both carry black triangle glyphs that
            # vanish on a dark face (found 2026-07-30).
            mapping = (
                arrows_map
                if "arrows" in path.parts or path.name.startswith("arrow")
                else png_map
            )
            with Image.open(path) as original:
                image = original.convert("RGBA")
            pixels = image.load()
            changed = False
            for y in range(image.height):
                for x in range(image.width):
                    red, green, blue, alpha = pixels[x, y]
                    replacement = mapping.get((red, green, blue))
                    if replacement is not None:
                        pixels[x, y] = (*replacement, alpha)
                        changed = True
            if changed:
                image.save(path)


def convert_gtk(
    repo_root: Path,
    dp: Path,
    name: str,
    slug: str,
    widget_style: str,
    pal: dict[str, tuple[int, int, int]],
) -> None:
    if widget_style not in {"classic", "motif"}:
        raise SystemExit(f"{slug}: unsupported widget style {widget_style!r}")
    helper = repo_root / "linux/.local/bin/redstone-9x-cde-convert"
    subprocess.run(
        [str(helper), "--kde98", str(dp), name, slug, "", str(repo_root)],
        check=True,
    )
    if widget_style == "classic":
        recolor_classic_gtk(repo_root, name, pal)
    mark_payload(repo_root / "linux/.themes" / name)
    mark_payload(repo_root / "linux/.config/Kvantum" / name)


def build_macos_platinum_kvantum(repo_root: Path, source_name: str) -> str:
    """Fork the converted Mac Qt theme onto the PLATINUM widget palette."""
    source = repo_root / "linux/.config/Kvantum" / source_name
    target = repo_root / "linux/.config/Kvantum" / MACOS_PLATINUM_KVANTUM
    if not source.is_dir():
        raise SystemExit(f"MacOS Kvantum donor missing: {source}")
    if target.exists():
        legacy_first_pass = {
            path.name for path in target.iterdir()
        } == {
            ".gitattributes",
            f"{MACOS_PLATINUM_KVANTUM}.kvconfig",
            f"{MACOS_PLATINUM_KVANTUM}.svg",
        }
        if not (target / GENERATED_MARKER).is_file() and not legacy_first_pass:
            raise SystemExit(f"refusing to replace unmarked Kvantum theme: {target}")
        shutil.rmtree(target)
    shutil.copytree(source, target)

    source_stem = source_name
    target_stem = MACOS_PLATINUM_KVANTUM
    for extension in (".kvconfig", ".svg"):
        old = target / f"{source_stem}{extension}"
        new = target / f"{target_stem}{extension}"
        old.rename(new)
        text = new.read_text(encoding="utf-8")
        text = text.replace(source_stem, target_stem)
        # PLATINUM's declared GTK palette: face #dfdfdf, white/light
        # highlights, #a1a2a1 shadow, and pale-lavender selection.
        replacements = {
            "#cecece": "#dfdfdf",
            "#afafaf": "#ffffff",
            "#a6a6a6": "#efefef",
            "#efebe7": "#dfdfdf",
            "#ebe0da": "#ffffff",
            "#e7deda": "#efefef",
            "#6e6e6e": "#a1a2a1",
            "#676767": "#a1a2a1",
            "#eeeeee": "#efefef",
            "#b5b5b5": "#ceceff",
        }
        for old_color, new_color in replacements.items():
            text = re.sub(
                re.escape(old_color), new_color, text, flags=re.IGNORECASE,
            )
        new.write_text(text, encoding="utf-8")
    mark_payload(target)
    (target / GENERATED_MARKER).write_text(
        f"{PINNED_HEAD}\nsource={source_name}\n",
        encoding="ascii",
    )
    return target_stem


def mark_payload(path: Path) -> None:
    """Keep imported/donor bytes exact without weakening source checks."""
    (path / ".gitattributes").write_text("** -whitespace\n", encoding="ascii")


def write_qt(path: Path, pal: dict[str, tuple[int, int, int]]) -> None:
    def argb(rgb):
        return "#ff%02x%02x%02x" % rgb
    face, fg = pal["face"], pal["text"]
    if is_dark_face(face):
        # Text law (2026-07-30): black or white by surface luminance.
        fg = contrast(face)
        # Dark bevel law (2026-07-30): Qt's Light/Midlight/Dark palette roles
        # ARE the widget bevel.  Pure-white Light glows on a dark face; the
        # law wants one subtle highlight, a face shadow, black stays black.
        highlight = toward_white(face, .25)
        light = highlight
        midlight = face
        mid = toward_black(face, .72)
        dark = toward_black(face, .5)
        disabled_text = mix_rgb(face, fg, .5)
    else:
        highlight = (255, 255, 255)
        light = tuple(round(c + (255 - c) * .55) for c in face)
        midlight = light
        mid = tuple(round(c * .72) for c in face)
        dark = tuple(round(c * .48) for c in face)
        disabled_text = dark
    roles = [
        fg, face, highlight, midlight, dark, mid, fg, (255, 255, 255),
        fg, pal["window"], face, (0, 0, 0), pal["select"], pal["select_text"],
        (0, 0, 255), (128, 0, 128), light, (0, 0, 0), (255, 255, 225),
        (0, 0, 0), dark, pal["select"],
    ]
    disabled = list(roles)
    for idx in (0, 6, 8, 12, 21):
        disabled[idx] = disabled_text
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(
        "[ColorScheme]\n"
        + "active_colors=" + ", ".join(map(argb, roles)) + "\n"
        + "disabled_colors=" + ", ".join(map(argb, disabled)) + "\n"
        + "inactive_colors=" + ", ".join(map(argb, roles)) + "\n",
        encoding="ascii",
    )


def write_wine_reg(path: Path, pal: dict[str, tuple[int, int, int]]) -> None:
    """Emit the scheme's Wine classic colours (gap found 2026-07-30: no KDE
    scheme shipped a .reg, so Wine windows silently kept whichever scheme
    last wrote one).  Bevels follow the dark bevel law on dark faces."""
    face, text = pal["face"], pal["text"]
    if is_dark_face(face):
        hilight = toward_white(face, .25)
        shadow = toward_black(face, .5)
        # Text law (2026-07-30): black or white per surface.
        pal = dict(pal)
        text = contrast(face)
        pal["text"] = text
        pal["active_text"] = contrast(pal["active"])
        pal["inactive_text"] = contrast(pal["inactive"])
        pal["window_text"] = contrast(pal["window"])
        pal["select_text"] = contrast(pal["select"])
    else:
        hilight = toward_white(face, .6)
        shadow = toward_black(face, .6)
    def dec(rgb):
        return f'"{rgb[0]} {rgb[1]} {rgb[2]}"'
    keys = {
        "ActiveBorder": face, "ActiveTitle": pal["active"],
        "AppWorkspace": (128, 128, 128), "Background": face,
        "ButtonDkShadow": (0, 0, 0), "ButtonFace": face,
        "ButtonHilight": hilight, "ButtonLight": face,
        "ButtonShadow": shadow, "ButtonText": text,
        "GradientActiveTitle": pal["active"],
        "GradientInactiveTitle": pal["inactive"],
        "GrayText": mix_rgb(face, text, .5),
        "Hilight": pal["select"], "HilightText": pal["select_text"],
        "InactiveBorder": face, "InactiveTitle": pal["inactive"],
        "InactiveTitleText": pal["inactive_text"],
        "InfoText": (0, 0, 0), "InfoWindow": (255, 255, 225),
        "Menu": face, "MenuText": text,
        "Scrollbar": hilight, "TitleText": pal["active_text"],
        "Window": pal["window"], "WindowFrame": (0, 0, 0),
        "WindowText": pal["window_text"],
    }
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(
        "REGEDIT4\n\n[HKEY_CURRENT_USER\\Control Panel\\Colors]\n"
        + "".join(f'"{key}"={dec(value)}\n' for key, value in sorted(keys.items())),
        encoding="ascii",
    )


def append_icewm_colors(path: Path, title: str, pal) -> None:
    if is_dark_face(pal["face"]):
        # Text law (2026-07-30): every text colour resolves to black or white
        # against its own surface; palette-grey text on dark chrome is out.
        pal = dict(pal)
        pal["text"] = contrast(pal["face"])
        pal["active_text"] = contrast(pal["active"])
        # Inactive text matches the dimmed inactive caption-button glyphs
        # (mix of face and glyph at .55, same formula as the button pass).
        pal["inactive_text"] = mix_rgb(pal["face"], contrast(pal["face"]), .55)
        pal["text_dim"] = pal["inactive_text"]
        pal["window_text"] = contrast(pal["window"])
        pal["select_text"] = contrast(pal["select"])
    text = path.read_text(encoding="latin-1")
    block = f"""

# ==== KDE 1 original first-appearance conversion ====
ThemeDescription="{title}"
ColorNormalButton="{hx(pal['face'])}"
ColorNormalButtonText="{hx(pal['text'])}"
ColorActiveButton="{hx(pal['face'])}"
ColorActiveButtonText="{hx(pal['text'])}"
ColorNormalTitleBar="{hx(pal['inactive'])}"
ColorNormalTitleBarText="{hx(pal['inactive_text'])}"
ColorActiveTitleBar="{hx(pal['active'])}"
ColorActiveTitleBarText="{hx(pal['active_text'])}"
ColorActiveBorder="{hx(pal['face'])}"
ColorNormalBorder="{hx(pal['face'])}"
ColorDialog="{hx(pal['face'])}"
ColorListBox="{hx(pal['window'])}"
ColorListBoxText="{hx(pal['window_text'])}"
ColorListBoxSelection="{hx(pal['select'])}"
ColorListBoxSelectionText="{hx(pal['select_text'])}"
ColorNormalMenu="{hx(pal['face'])}"
ColorActiveMenuItem="{hx(pal['select'])}"
ColorNormalMenuItemText="{hx(pal['text'])}"
ColorActiveMenuItemText="{hx(pal['select_text'])}"
ColorDefaultTaskBar="{hx(pal['face'])}"
ColorNormalTaskBarApp="{hx(pal['face'])}"
ColorActiveTaskBarApp="{hx(pal['select'])}"
ColorNormalTaskBarAppText="{hx(pal.get('text_dim', pal['text']))}"
ColorActiveTaskBarAppText="{hx(pal['select_text'])}"
ColorClock="{hx(pal['face'])}"
ColorClockText="{hx(pal['text'])}"
"""
    path.write_text(text + block, encoding="latin-1")


FRAME_MAP = {
    "shapePixmapTop": ("frameAT.xpm", "frameIT.xpm", "dframeAT.xpm", "dframeIT.xpm"),
    "shapePixmapBottom": ("frameAB.xpm", "frameIB.xpm", "dframeAB.xpm", "dframeIB.xpm"),
    "shapePixmapLeft": ("frameAL.xpm", "frameIL.xpm", "dframeAL.xpm", "dframeIL.xpm"),
    "shapePixmapRight": ("frameAR.xpm", "frameIR.xpm", "dframeAR.xpm", "dframeIR.xpm"),
    "shapePixmapTopLeft": ("frameATL.xpm", "frameITL.xpm", "dframeATL.xpm", "dframeITL.xpm"),
    "shapePixmapTopRight": ("frameATR.xpm", "frameITR.xpm", "dframeATR.xpm", "dframeITR.xpm"),
    "shapePixmapBottomLeft": ("frameABL.xpm", "frameIBL.xpm", "dframeABL.xpm", "dframeIBL.xpm"),
    "shapePixmapBottomRight": ("frameABR.xpm", "frameIBR.xpm", "dframeABR.xpm", "dframeIBR.xpm"),
}
BUTTON_MAP = {
    "CloseButton": ("closeA.xpm", "closeI.xpm"),
    "MaximizeButton": ("maximizeA.xpm", "maximizeI.xpm"),
    "MaximizeDownButton": ("restoreA.xpm", "restoreI.xpm"),
    "MinimizeButton": ("minimizeA.xpm", "minimizeI.xpm"),
    "MenuButton": ("menuButtonA.xpm", "menuButtonI.xpm"),
}


def recolor_pixmap_file(
    path: Path,
    color_map: dict[tuple[int, int, int], tuple[int, int, int]],
) -> None:
    if path.suffix.lower() == ".xpm":
        content = path.read_text(encoding="latin-1")
        for old, new in color_map.items():
            old_hex = "#%02x%02x%02x" % old
            content = re.sub(
                re.escape(old_hex), hx(new), content, flags=re.IGNORECASE,
            )
        path.write_text(content, encoding="latin-1")
    elif path.suffix.lower() == ".png":
        with Image.open(path) as original:
            image = original.convert("RGBA")
        pixels = image.load()
        changed = False
        for y in range(image.height):
            for x in range(image.width):
                red, green, blue, alpha = pixels[x, y]
                replacement = color_map.get((red, green, blue))
                if replacement is not None:
                    pixels[x, y] = (*replacement, alpha)
                    changed = True
        if changed:
            image.save(path)


def recolor_theme_pixmaps(
    theme: Path,
    color_map: dict[tuple[int, int, int], tuple[int, int, int]],
) -> None:
    for path in theme.rglob("*"):
        if not path.is_file() or path.is_symlink():
            continue
        recolor_pixmap_file(path, color_map)


def override_theme_values(path: Path, values: dict[str, str]) -> None:
    """Replace IceWM keys once, then append one authoritative override block."""
    keys = set(values)
    lines = [
        line for line in path.read_text(encoding="latin-1").splitlines()
        if line.split("=", 1)[0].strip() not in keys
    ]
    lines += ["", "# ==== Redstone KDE MacOS geometry ===="]
    lines += [f"{key}={value}" for key, value in values.items()]
    path.write_text("\n".join(lines) + "\n", encoding="latin-1")


def macos_icewm_font_values() -> dict[str, str]:
    """Use the bundled narrow Mac OS Charcoal face for every IceWM role."""
    regular = f'"{MACOS_FONT_FAMILY}:size={MACOS_UI_FONT_SIZE}"'
    bold = f'"{MACOS_FONT_FAMILY}:size={MACOS_UI_FONT_SIZE}:bold"'
    return {
        "TitleFontNameXft": (
            f'"{MACOS_FONT_FAMILY}:size={MACOS_TITLE_FONT_SIZE}"'
        ),
        "MenuFontNameXft": regular,
        "ActiveMenuFontNameXft": bold,
        "NormalButtonFontNameXft": regular,
        "ActiveButtonFontNameXft": bold,
        "ToolButtonFontNameXft": regular,
        "NormalTaskBarFontNameXft": regular,
        "ActiveTaskBarFontNameXft": bold,
        "NormalWorkspaceFontNameXft": regular,
        "ActiveWorkspaceFontNameXft": bold,
        "MinimizedWindowFontNameXft": regular,
        "QuickSwitchFontNameXft": regular,
        "StatusFontNameXft": regular,
        "ToolTipFontNameXft": regular,
        "ClockFontNameXft": regular,
        "ApmFontNameXft": regular,
        "TempFontNameXft": regular,
        "InputFontNameXft": regular,
        "LabelFontNameXft": regular,
        "ListBoxFontNameXft": regular,
    }


def write_taskbar_strip(
    path: Path,
    face: tuple[int, int, int],
    *,
    pressed: bool,
) -> None:
    """Write a horizontally seamless strip at the live IceWM panel height.

    IceWM tiles task-button pixmaps instead of stretching their edge pixels.
    The old 59px Alpha button therefore repeated its left/right bevel through
    every wide task button.  These strips retain only the horizontal bevels;
    every row is deliberately identical across its three pixels.  The panel
    is 31px high at 96 DPI; a 28px donor repeated its first three rows along
    the bottom edge.
    """
    light = tuple(round(channel + (255 - channel) * .45) for channel in face)
    shadow = tuple(round(channel * .66) for channel in face)
    black = (0, 0, 0)
    white = (255, 255, 255)
    inner_height = MACOS_TASKBAR_HEIGHT - 4
    if pressed:
        rows = [black, shadow] + [face] * inner_height + [light, white]
    else:
        rows = [white, light] + [face] * inner_height + [shadow, black]
    colors = {
        ".": face,
        "l": light,
        "s": shadow,
        "b": black,
        "w": white,
    }
    chars = {
        face: ".",
        light: "l",
        shadow: "s",
        black: "b",
        white: "w",
    }
    if path.is_symlink() or path.exists():
        path.unlink()
    path.write_text(
        "/* XPM */\n"
        "static char * taskbar_strip_xpm[] = {\n"
        f'"3 {MACOS_TASKBAR_HEIGHT} {len(colors)} 1",\n'
        + "".join(f'"{char} c {hx(rgb)}",\n' for char, rgb in colors.items())
        + "".join(
            f'"{chars[row] * 3}"'
            f'{"," if index < MACOS_TASKBAR_HEIGHT - 1 else ""}\n'
            for index, row in enumerate(rows)
        )
        + "};\n",
        encoding="ascii",
    )


def repair_macos_taskbar(taskbar: Path, face: tuple[int, int, int]) -> None:
    normal = (
        "taskbarbg.xpm",
        "taskbuttonbg.xpm",
        "taskbuttonminimized.xpm",
        "toolbuttonbg.xpm",
        "workspacebuttonbg.xpm",
    )
    active = ("taskbuttonactive.xpm", "workspacebuttonactive.xpm")
    for name in normal:
        write_taskbar_strip(taskbar / name, face, pressed=False)
    for name in active:
        write_taskbar_strip(taskbar / name, face, pressed=True)


def build_macos_icewm(
    repo_root: Path,
    icewm: Path,
    pal: dict[str, tuple[int, int, int]],
) -> None:
    """Adapt Tosh's native IceWM geometry to the original KDE Mac palette."""
    donor = repo_root / "linux/.icewm/themes/Tosh"
    taskbar_donor = repo_root / "linux/.icewm/themes/KDE-1-Alpha/taskbar"
    if not (donor / "default.theme").is_file():
        raise SystemExit(f"MacOS IceWM donor missing: {donor}")
    if not taskbar_donor.is_dir():
        raise SystemExit(f"MacOS taskbar donor missing: {taskbar_donor}")
    shutil.copytree(donor, icewm)
    default = icewm / "default.theme"
    text = default.read_text(encoding="latin-1")
    text = text.replace("TaskBarShowStartMenu=0", "TaskBarShowStartMenu=1")
    default.write_text(text, encoding="latin-1")
    override_theme_values(
        default,
        {
            "TitleBarCentered": "0",
            "TitleBarJustify": "0",
            "TitleBarVertOffset": "-1",
            "TaskBarHeight": str(MACOS_TASKBAR_HEIGHT),
            **macos_icewm_font_values(),
        },
    )

    # KDE's 50x10 panel.xpm is application-panel artwork, not an IceWM
    # taskbar background.  Preserve it in the historical upstream payload,
    # but use the Alpha theme's one-pixel-wide, taskbar-height-safe chrome.
    shutil.copytree(taskbar_donor, icewm / "taskbar")
    face = pal["face"]
    face_plus = tuple(min(255, channel + 3) for channel in face)
    light = tuple(round(channel + (255 - channel) * .35) for channel in face)
    recolor_theme_pixmaps(
        icewm,
        {
            (0xF0, 0xF0, 0xF0): face,
            (0xC0, 0xC0, 0xC0): face,
            (0xC3, 0xC3, 0xC3): face_plus,
            (0xD4, 0xD0, 0xC8): face,
            (0xCC, 0xCC, 0xCC): pal["active"],
            (0xDD, 0xDD, 0xDD): pal["inactive"],
            (0xDF, 0xDF, 0xDF): light,
            (0xEA, 0xE8, 0xE4): light,
            (0x73, 0xAD, 0xEF): pal["select"],
        },
    )
    repair_macos_taskbar(icewm / "taskbar", pal["face"])


def macos_title_strip(
    source: Path,
    state: str,
    panel_source: Path,
) -> Image.Image:
    """Derive IceWM's 17px strip from the catalogued KDE Mac artwork.

    KWM clipped the original active alternating-line XPM into a much shorter
    caption.  Tiling that 17px source verbatim in IceWM creates eight thin
    rules down the full caption.  Preserve its face/highlight pixels and use
    the historical panel artwork's shadow to reconstruct the three chunky
    two-pixel bevels visible in the bundled preview.
    """
    with Image.open(source) as original:
        source_strip = original.convert("RGBA")
    if state != "A":
        return source_strip.crop((0, 0, 1, 17))

    face = (*(
        MACOS_TITLE_FACE if state == "A" else MACOS_INACTIVE_TITLE_FACE
    ), 255)
    highlight = source_strip.getpixel((0, 1))
    with Image.open(panel_source) as original:
        panel = original.convert("RGBA")
    opaque = {
        pixel for pixel in panel.getdata()
        if pixel[3] and pixel[:3] not in {face[:3], highlight[:3]}
    }
    shadow = min(
        opaque,
        key=lambda pixel: abs(sum(pixel[:3]) / 3 - sum(face[:3]) / 3 * .8),
    )
    strip = Image.new("RGBA", (1, 17), face)
    for top in (3, 7, 11):
        strip.putpixel((0, top), highlight)
        strip.putpixel((0, top + 1), shadow)
    return strip


def macos_caption_background(
    state: str,
    width: int,
) -> Image.Image:
    """Return a solid widget-face bed around titlebar controls."""
    face = (
        MACOS_TITLE_FACE if state == "A" else MACOS_INACTIVE_TITLE_FACE
    )
    return Image.new("RGBA", (width, 17), (*face, 255))


def write_macos_title_parts(
    source: Path,
    target: Path,
    state: str,
    panel_source: Path,
) -> None:
    """Install KDE grooves around a solid caption bed with 4px P/M pads."""
    strip = macos_title_strip(source, state, panel_source)
    # IceWM repeats S across the entire left pane and B across the entire
    # right pane.  Only P and M are fixed-width transitions immediately
    # before and after the title text.
    for segment in ("B", "L", "R", "S"):
        strip.save(target / f"title{state}{segment}.png")
    for segment in ("M", "P"):
        macos_caption_background(state, 4).save(
            target / f"title{state}{segment}.png"
        )
    macos_caption_background(state, 1).save(target / f"title{state}T.png")


def write_macos_caption_sprite(
    source: Path,
    destination: Path,
    state: str,
) -> None:
    """Place KDE's original 13px button on two solid 20px widget-face beds."""
    with Image.open(source) as original:
        button = original.convert("RGBA")
    background = macos_caption_background(state, 20)
    sprite = Image.new("RGBA", (20, 34))
    sprite.alpha_composite(background, (0, 0))
    sprite.alpha_composite(background, (0, 17))
    sprite.alpha_composite(button, (3, 2))
    sprite.alpha_composite(button, (4, 19))
    sprite.save(destination)


def write_macos_menu_button_sprite(destination: Path, state: str) -> None:
    """Give IceWM a solid bed on which to draw the application icon."""
    background = macos_caption_background(state, 20)
    sprite = Image.new("RGBA", (20, 34))
    sprite.alpha_composite(background, (0, 0))
    sprite.alpha_composite(background, (0, 17))
    sprite.save(destination)


def build_macos_authentic_icewm(
    current: Path,
    authentic: Path,
    upstream: Path,
) -> None:
    """Fork the retromod with KDE's own 1998 Mac caption artwork."""
    shutil.copytree(current, authentic)
    default = authentic / "default.theme"
    override_theme_values(
        default,
        {
            "TitleBarCentered": "1",
            "TitleBarJustify": "50",
            "TitleBarVertOffset": "0",
            'TitleButtonsSupported': '"sxmi"',
            'TitleButtonsRight': '"xmi"',
            'TitleButtonsLeft': '"s"',
            "TitleBarHeight": "17",
            "BorderSizeX": "1",
            "BorderSizeY": "1",
            "CornerSizeX": "1",
            "CornerSizeY": "1",
            "DlgBorderSizeX": "1",
            "DlgBorderSizeY": "1",
            "ButtonX": "20",
            "ButtonY": "17",
            **macos_icewm_font_values(),
        },
    )

    # Tosh's multipart grooves and six-pixel lower frame belong only to the
    # retromod.  The authentic fork uses KDE's own 17px groove strip and a
    # one-pixel colour frame, so its bottom edge blends into the window.
    for pattern in ("titleA*", "titleI*", "frameA*", "frameI*", "dframe*"):
        for path in authentic.glob(pattern):
            path.unlink()
    panel_source = upstream / "panel.xpm"
    write_macos_title_parts(
        upstream / "active.xpm", authentic, "A", panel_source,
    )
    write_macos_title_parts(
        upstream / "inactive.xpm", authentic, "I", panel_source,
    )

    button_sources = {
        "close": upstream / "close.xpm",
        "minimize": upstream / "iconify.xpm",
        "maximize": upstream / "maximize.xpm",
        "restore": upstream / "maximize.xpm",
    }
    for stem, source in button_sources.items():
        for state in ("A", "I"):
            for old in authentic.glob(f"{stem}{state}.*"):
                old.unlink()
            write_macos_caption_sprite(
                source,
                authentic / f"{stem}{state}.png",
                state,
            )
    for state in ("A", "I"):
        for old in authentic.glob(f"menuButton{state}.*"):
            old.unlink()
        write_macos_menu_button_sprite(
            authentic / f"menuButton{state}.png", state,
        )


def build_curated_icon_theme(
    repo_root: Path,
    name: str = MACOS_ICON_THEME,
    mac_places: bool = False,
) -> Path:
    """Build Classic Silver, then KDE-Classic, before Windows fallbacks.

    With mac_places the Platinum9 Mac folders and trash are grafted over
    the Classic Silver places; without it the same curated alias layer sits
    on Classic Silver's own untouched folders and trash.
    """
    if mac_places:
        platinum = repo_root / "linux/.local/share/icons/Platinum9"
        resolved = run(platinum, "rev-parse", "HEAD").decode().strip()
        if resolved != PLATINUM9_COMMIT:
            raise SystemExit(
                f"Platinum9 commit mismatch: expected {PLATINUM9_COMMIT}, got {resolved}"
            )
        if run(platinum, "status", "--porcelain"):
            raise SystemExit(f"Platinum9 donor worktree is dirty: {platinum}")

        donor_dirs = {
            size: platinum / f"NineIcons/places/{size}"
            for size in (16, 32)
        }
        for size, donor_dir in donor_dirs.items():
            donor = donor_dir / "folder.png"
            if (
                not donor.is_file()
                or sha256(donor.read_bytes()) != PLATINUM9_FOLDER_SHA256[size]
            ):
                raise SystemExit(f"Platinum9 {size}px folder checksum mismatch")
            for name_ in ("user-trash.png", "user-trash-full.png"):
                trash = donor_dir / name_
                if (
                    not trash.is_file()
                    or sha256(trash.read_bytes())
                    != PLATINUM9_TRASH_SHA256[(size, name_)]
                ):
                    raise SystemExit(f"Platinum9 {size}px {name_} checksum mismatch")
        charcoal = platinum / "Charcoal.ttf"
        if (
            not charcoal.is_file()
            or sha256(charcoal.read_bytes()) != PLATINUM9_CHARCOAL_SHA256
        ):
            raise SystemExit("Platinum9 Charcoal font checksum mismatch")
        font_target = repo_root / "linux/.config/redstone-9x/fonts/Charcoal.ttf"
        font_target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(charcoal, font_target)

    base = repo_root / "linux/.local/share/icons/KDE-1-Classic-Silver-Original"
    if not (base / "index.theme").is_file():
        raise SystemExit(f"KDE Classic Silver icon donor missing: {base}")
    kde_classic = repo_root / "linux/.local/share/icons/KDE-Classic"
    if not (kde_classic / "index.theme").is_file():
        raise SystemExit(f"KDE-Classic compatibility donor missing: {kde_classic}")
    chicago = repo_root / "linux/.local/share/icons/Chicago95"
    if not (chicago / "index.theme").is_file():
        raise SystemExit(f"Chicago95 icon fallback missing: {chicago}")
    beos_icons = repo_root / "linux/.local/share/icons/BeOS-r5-Icons"
    if not (beos_icons / "index.theme").is_file():
        raise SystemExit(f"BeOS icon donor missing: {beos_icons}")
    for donor, expected_commit, label in (
        (chicago, CHICAGO95_COMMIT, "Chicago95"),
        (beos_icons, BEOS_R5_ICONS_COMMIT, "BeOS-r5-Icons"),
    ):
        resolved = run(donor, "rev-parse", "HEAD").decode().strip()
        if resolved != expected_commit:
            raise SystemExit(
                f"{label} commit mismatch: expected {expected_commit}, got {resolved}"
            )
        if run(donor, "status", "--porcelain"):
            raise SystemExit(f"{label} donor worktree is dirty: {donor}")
    for size, expected in CHICAGO95_FIREFOX_SHA256.items():
        firefox = chicago / f"apps/{size}/firefox.png"
        if not firefox.is_file() or sha256(firefox.read_bytes()) != expected:
            raise SystemExit(f"Chicago95 {size}px Firefox checksum mismatch")
    communicator = beos_icons / "apps/32/netscape-communicator.png"
    if (
        not communicator.is_file()
        or sha256(communicator.read_bytes()) != BEOS_R5_COMMUNICATOR_SHA256
    ):
        raise SystemExit("BeOS-r5-Icons Communicator checksum mismatch")
    for category, fallback_name in CHICAGO95_REQUIRED_FALLBACKS:
        fallback = chicago / category / "16" / f"{fallback_name}.png"
        if not fallback.is_file():
            raise SystemExit(f"Chicago95 required fallback missing: {fallback}")
    target = repo_root / f"linux/.local/share/icons/{name}"
    if target.exists() and not (target / GENERATED_MARKER).is_file():
        raise SystemExit(f"refusing to replace unmarked icon theme: {target}")
    if target.exists():
        shutil.rmtree(target)
    shutil.copytree(base, target)
    (target / GENERATED_MARKER).write_text(PLATINUM9_COMMIT + "\n", encoding="ascii")
    (target / ".gitattributes").write_text("** -whitespace\n", encoding="ascii")

    sizes = (16, 22, 24, 32, 48)
    if mac_places:
        for size in sizes:
            source_size = 16 if size == 16 else 32
            donors = sorted(donor_dirs[source_size].glob("folder*.png"))
            donors += [
                donor_dirs[source_size] / "user-trash.png",
                donor_dirs[source_size] / "user-trash-full.png",
            ]
            destination = target / f"{size}x{size}/places"
            destination.mkdir(parents=True, exist_ok=True)
            rendered = {}
            for donor in donors:
                with Image.open(donor) as original:
                    icon = original.convert("RGBA")
                if icon.size != (size, size):
                    icon = icon.resize((size, size), Image.Resampling.NEAREST)
                icon.save(destination / donor.name)
                rendered[donor.name] = icon
            for alias in ("trash.png", "kfm-trash.png"):
                rendered["user-trash.png"].save(destination / alias)
            for alias in ("trash-full.png", "kfm-fulltrash.png"):
                rendered["user-trash-full.png"].save(destination / alias)
            apps = target / f"{size}x{size}/apps"
            apps.mkdir(parents=True, exist_ok=True)
            rendered["user-trash.png"].save(apps / "kfm-trash.png")
            rendered["user-trash-full.png"].save(apps / "kfm-fulltrash.png")
    else:
        # The recycle-bin launcher (and XDG lookups generally) ask for
        # user-trash-full, which Classic Silver ships only as apps/
        # kfm-fulltrash.  Alias the theme's OWN full-trash art into places/
        # so the desktop trash can renders in every Curated-based scheme —
        # Classic Silver pixels, no Platinum9 graft (gap found 2026-07-30:
        # the launcher icon resolved to nothing and the trash can vanished
        # from every KDE scheme).
        for size in sizes:
            full = target / f"{size}x{size}/apps/kfm-fulltrash.png"
            if not full.is_file():
                continue
            places = target / f"{size}x{size}/places"
            places.mkdir(parents=True, exist_ok=True)
            with Image.open(full) as original:
                icon = original.convert("RGBA")
            if icon.size != (size, size):
                icon = icon.resize((size, size), Image.Resampling.NEAREST)
            for alias in ("user-trash-full.png", "trash-full.png"):
                icon.save(places / alias)

    index = target / "index.theme"
    text = index.read_text(encoding="utf-8")
    theme_title = (
        "KDE 1 Classic Silver MacOS" if mac_places
        else "KDE 1 Classic Silver Curated"
    )
    theme_comment = (
        "Classic Silver with KDE-Classic compatibility and Platinum9 folders."
        if mac_places else
        "Classic Silver with KDE-Classic compatibility and original folders."
    )
    text = re.sub(r"(?m)^Name=.*$", f"Name={theme_title}", text)
    text = re.sub(
        r"(?m)^Comment=.*$",
        f"Comment={theme_comment}",
        text,
    )
    text = re.sub(r"(?m)^Inherits=.*$", "Inherits=KDE-Classic,hicolor", text)
    index.write_text(text, encoding="utf-8")

    categories = (
        "apps", "places", "actions", "devices", "filesystems", "mimes",
        "mimetypes", "status", "categories",
    )
    source_sizes = (16, 22, 24, 32, 48, 64)
    donor_roots = {
        "classic-silver": target,
        "kde-classic": kde_classic,
        "chicago95": chicago,
        "beos-r5": beos_icons,
    }

    def kde_icon(layer: str, name: str, requested: int) -> Image.Image:
        root = donor_roots.get(layer)
        if root is None:
            raise SystemExit(f"unsupported KDE alias donor layer: {layer}")
        candidates = []
        for source_size in source_sizes:
            for category_rank, category in enumerate(categories):
                source = (
                    root / f"{source_size}x{source_size}"
                    / category / f"{name}.png"
                )
                if source.is_file():
                    candidates.append(
                        (
                            abs(source_size - requested),
                            -source_size,
                            category_rank,
                            source,
                        )
                    )
            legacy_source = root / f"apps/{source_size}/{name}.png"
            if legacy_source.is_file():
                candidates.append(
                    (
                        abs(source_size - requested),
                        -source_size,
                        len(categories),
                        legacy_source,
                    )
                )
        if not candidates:
            raise SystemExit(f"KDE alias donor missing: {layer}/{name}")
        source = min(candidates)[-1]
        with Image.open(source) as original:
            return original.convert("RGBA")

    alias_lines = [
        "alias\tdonor_layer\tdonor_name\tdonor_epoch\trationale"
    ]
    seen_aliases = set()
    for alias, donor_layer, donor_name, donor_epoch, rationale in (
        MACOS_KDE_ALIAS_LEDGER
    ):
        if alias in seen_aliases:
            raise SystemExit(f"duplicate KDE semantic alias: {alias}")
        seen_aliases.add(alias)
        alias_lines.append(
            f"{alias}\t{donor_layer}\t{donor_name}\t{donor_epoch}\t{rationale}"
        )
        for size in sizes:
            icon = kde_icon(donor_layer, donor_name, size)
            if icon.size != (size, size):
                icon = icon.resize((size, size), Image.Resampling.NEAREST)
            destination = target / f"{size}x{size}/apps"
            destination.mkdir(parents=True, exist_ok=True)
            icon.save(destination / f"{alias}.png")
    (target / "ALIASES.tsv").write_text(
        "\n".join(alias_lines) + "\n",
        encoding="utf-8",
    )

    for cache in target.rglob("icon-theme.cache"):
        cache.unlink()
    (target / "PROVENANCE").write_text(
        "Base payload: complete KDE-1-Classic-Silver-Original clone\n"
        "Epoch boundary: no KDE HiColor payload is included\n"
        "KDE compatibility fallback: KDE-Classic, without overrides\n"
        "KDE semantic aliases: ALIASES.tsv records donor layer, name, epoch, and rationale\n"
        f"KDE semantic alias count: {len(MACOS_KDE_ALIAS_LEDGER)}\n"
        "KDE-Classic inherits Chicago95, then hicolor\n"
        "Chicago95 therefore fills only names absent from both KDE layers.\n"
        "Browser aliases: Silver mini.netscape (1997-09-12), pinned Chicago95 "
        "Firefox, and pinned BeOS-r5-Icons Netscape Communicator.\n"
        f"Chicago95 commit: {CHICAGO95_COMMIT}\n"
        f"BeOS-r5-Icons commit: {BEOS_R5_ICONS_COMMIT}\n"
        + (
            "Folder donors: Platinum9/NineIcons/places/{16,32}/folder*.png\n"
            "Trash donors: Platinum9 user-trash.png and user-trash-full.png\n"
            f"Platinum9 commit: {PLATINUM9_COMMIT}\n"
            f"16px SHA-256: {PLATINUM9_FOLDER_SHA256[16]}\n"
            f"32px SHA-256: {PLATINUM9_FOLDER_SHA256[32]}\n"
            "Generated 22px, 24px, and 48px: nearest-neighbour from 32px.\n"
            "Trash aliases: user-trash, trash, kfm-trash and full-state forms.\n"
            if mac_places else
            "Folders and trash: Classic Silver originals; no Platinum9 payload.\n"
        ),
        encoding="utf-8",
    )
    return target


def compose_repaired_buttons(
    upstream: Path,
    icewm: Path,
    title: dict,
) -> None:
    """Compose IceWM two-frame button pixmaps from KWM single-frame art.

    KWM buttons are single-state squares (Nostalgy: 15x15); IceWM loads a
    width x 2*height pixmap of stacked normal+pressed frames, so a raw copy
    clips and tiles.  Repair keeps the bundle's own art: centre it on the
    donor-sized canvas (padded with the art's own edge colour), and offset
    the pressed frame one pixel down-right.  The donor .png is overwritten
    and any raw-grafted .xpm removed so the repaired frame is what loads.
    """
    for key, targets in BUTTON_MAP.items():
        src = upstream / title.get(key, "")
        if not src.is_file():
            continue
        with Image.open(src) as original:
            art = original.convert("RGBA")
        # Pad with the art's own dominant OPAQUE colour — the XPM corners are
        # transparent, and padding with them left see-through gaps around
        # every button (found 2026-07-31).
        counts: dict = {}
        for pixel in art.getdata():
            if pixel[3] > 0:
                counts[pixel] = counts.get(pixel, 0) + 1
        dominant = max(counts, key=counts.get) if counts else (192, 192, 192, 255)
        edge = (dominant[0], dominant[1], dominant[2], 255)
        for target in targets:
            donor = icewm / target.replace(".xpm", ".png")
            if donor.is_file():
                with Image.open(donor) as existing:
                    width, height = existing.size
            else:
                width, height = art.width + 3, (art.height + 3) * 2
            # MacOS-authentic margins: at least 4px of solid bed either side
            # of the art, so the button sits on a clear widget-face bed.
            width = max(width, art.width + 8)
            frame_h = height // 2
            canvas = Image.new("RGBA", (width, height), edge)
            x = (width - art.width) // 2
            y = (frame_h - art.height) // 2
            canvas.paste(art, (x, y), art)
            canvas.paste(art, (x + 1, frame_h + y + 1), art)
            canvas.save(donor)
            (icewm / target).unlink(missing_ok=True)


def write_repair_frames(
    icewm: Path,
    light: tuple = ((0x00, 0x00, 0x00), (0xFF, 0xFF, 0xFF),
                    (0xCC, 0xCC, 0xCC), (0xC0, 0xC0, 0xC0)),
    dark: tuple = ((0x00, 0x00, 0x00), (0x00, 0x00, 0x00),
                   (0x99, 0x99, 0x99), (0xC0, 0xC0, 0xC0)),
) -> None:
    """Synthesize the 4px window frame from the original's colour rings.

    Numerically captured from the REAL KDE 1 Nostalgy running in MiDesktop
    on :95 (2026-07-31) — the from-memory spec had the order inverted.  The
    genuine border, outer->inner: top/left #000000 #ffffff #cccccc #c0c0c0
    (black is the OUTERMOST outline; no black groove near the content),
    bottom/right #000000 #000000 #999999 #c0c0c0 (shadowed edge, no white).
    Corners miter the two rings along the diagonal.  Dialog frames stay on
    the grafted 3px art, which fits their 3px border exactly.
    """
    depth = len(light)
    def strip(ring, vertical: bool, reverse: bool) -> Image.Image:
        colors = list(reversed(ring)) if reverse else list(ring)
        img = Image.new("RGB", (8, depth) if not vertical else (depth, 8))
        for i, color in enumerate(colors):
            for j in range(8):
                img.putpixel((j, i) if not vertical else (i, j), color)
        return img
    def corner(ring_a, ring_b, flip_x: bool, flip_y: bool) -> Image.Image:
        # ring_a rules the horizontal edge, ring_b the vertical; nearest
        # edge wins, ring_a on the tie (the top/left strip overlays KWM's
        # corners the same way).
        img = Image.new("RGB", (depth, depth))
        for y in range(depth):
            for x in range(depth):
                dx = depth - 1 - x if flip_x else x
                dy = depth - 1 - y if flip_y else y
                img.putpixel((x, y),
                             ring_a[dy] if dy <= dx else ring_b[dx])
        return img
    pieces = {
        "T": strip(light, False, False), "B": strip(dark, False, True),
        "L": strip(light, True, False), "R": strip(dark, True, True),
        "TL": corner(light, light, False, False),
        "TR": corner(light, dark, True, False),
        "BL": corner(dark, light, False, True),
        "BR": corner(dark, dark, True, True),
    }
    for state in ("A", "I"):
        for suffix, img in pieces.items():
            (icewm / f"frame{state}{suffix}.xpm").unlink(missing_ok=True)
            img.save(icewm / f"frame{state}{suffix}.png")


def graft_kwm_assets(
    upstream: Path,
    icewm: Path,
    cp: configparser.ConfigParser,
    repair_buttons: bool = False,
) -> None:
    sections = {s.lower(): cp[s] for s in cp.sections()}
    border = sections.get("window border", {})
    title = sections.get("window titlebar", {})
    for key, targets in FRAME_MAP.items():
        src = upstream / border.get(key, "")
        if src.is_file():
            for target in targets:
                shutil.copy2(src, icewm / target)
    if repair_buttons:
        compose_repaired_buttons(upstream, icewm, title)
    else:
        for key, targets in BUTTON_MAP.items():
            src = upstream / title.get(key, "")
            if src.is_file():
                for target in targets:
                    shutil.copy2(src, icewm / target)
    for key, target in (
        ("TitlebarPixmapActive", "titleAB.xpm"),
        ("TitlebarPixmapInactive", "titleIB.xpm"),
    ):
        src = upstream / title.get(key, "")
        if src.is_file():
            shutil.copy2(src, icewm / target)
    panel = sections.get("panel", {})
    src = upstream / panel.get("background", "")
    if src.is_file():
        shutil.copy2(src, icewm / "taskbar/taskbarbg.xpm")


def write_title_gradient(
    path: Path,
    start: tuple[int, int, int],
    end: tuple[int, int, int],
    height: int = 18,
) -> None:
    """Write a two-endpoint horizontal-gradient XPM for IceWM's Gradients key."""
    identifier = re.sub(r"\W", "_", path.stem)
    rows = ",\n".join('"ab"' for _ in range(height))
    path.write_text(
        "/* XPM */\n"
        f"static char * {identifier}_xpm[] = {{\n"
        f'"2 {height} 2 1",\n'
        f'"a c {hx(start)}",\n'
        f'"b c {hx(end)}",\n'
        f"{rows}}};\n",
        encoding="ascii",
    )


def is_dark_face(face: tuple[int, int, int]) -> bool:
    return contrast(face) == (255, 255, 255)


def toward_white(face, fraction: float) -> tuple[int, int, int]:
    return tuple(round(c + (255 - c) * fraction) for c in face)


def toward_black(face, fraction: float) -> tuple[int, int, int]:
    return tuple(round(c * fraction) for c in face)


def bundle_chrome_ramp(
    face: tuple[int, int, int],
) -> dict[tuple[int, int, int], tuple[int, int, int]]:
    """Map the Alpha donor's Win95 grey ramp onto a bundle-face bevel ramp.

    Dark faces get the dark bevel law (2026-07-30): the Win95 light-theme
    bevel is wrong on a dark face — the white highlight glows, the inner
    highlight doubles it to 2px, and the mid-grey shadows read as smudges.
    Dark faces take ONE subtle highlight (~face+25% toward white), inner
    highlight collapsed to the face, a face-derived bevel shadow, and a pure
    black outer right/bottom shadow.
    """
    if is_dark_face(face):
        highlight = toward_white(face, .25)
        return {
            (0xC0, 0xC0, 0xC0): face,
            (0xD4, 0xD0, 0xC8): face,
            (0xC3, 0xC3, 0xC3): tuple(min(255, c + 3) for c in face),
            (0xDF, 0xDF, 0xDF): face,
            (0xE0, 0xE0, 0xE0): face,
            (0xEC, 0xEC, 0xEC): highlight,
            (0xF8, 0xFC, 0xF8): highlight,
            (0xFF, 0xFF, 0xFF): highlight,
            (0x80, 0x80, 0x80): toward_black(face, .5),
            (0x70, 0x70, 0x70): toward_black(face, .5),
            (0x40, 0x40, 0x40): (0, 0, 0),
        }
    return {
        (0xC0, 0xC0, 0xC0): face,
        (0xD4, 0xD0, 0xC8): face,
        (0xC3, 0xC3, 0xC3): tuple(min(255, c + 3) for c in face),
        (0xDF, 0xDF, 0xDF): toward_white(face, .35),
        (0xE0, 0xE0, 0xE0): toward_white(face, .35),
        (0xFF, 0xFF, 0xFF): toward_white(face, .6),
        (0x80, 0x80, 0x80): toward_black(face, .5),
        (0x70, 0x70, 0x70): toward_black(face, .4),
        (0x40, 0x40, 0x40): toward_black(face, .25),
    }


def mix_rgb(a, b, fraction: float) -> tuple[int, int, int]:
    return tuple(round(x + (y - x) * fraction) for x, y in zip(a, b))


def recolor_start_button_gradient(
    path: Path,
    start: tuple[int, int, int],
    end: tuple[int, int, int],
) -> None:
    """Repaint the K menu button's neutral-grey face with the titlebar gradient.

    Neutral-grey pixels (bevel and face) take the given colour sweep by
    luminance transfer anchored on the #D2D2D2 face, start->end across the
    pixmap width (start==end paints a flat panel-matching face); coloured
    art and dark outlines stay untouched.  Tolerance 14 also catches the
    donor's warm #D4D0C8 chrome grey while leaving real art alone.
    """
    anchor = 0xD2
    with Image.open(path) as original:
        image = original.convert("RGBA")
    pixels = image.load()
    width = max(1, image.width - 1)
    for y in range(image.height):
        for x in range(image.width):
            red, green, blue, alpha = pixels[x, y]
            if max(red, green, blue) - min(red, green, blue) > 14 or red < 0x30:
                continue
            base = mix_rgb(start, end, x / width)
            if red <= anchor:
                shade = tuple(round(c * red / anchor) for c in base)
            else:
                shade = toward_white(base, (red - anchor) / (255 - anchor) * .5)
            pixels[x, y] = (*shade, alpha)
    image.save(path)


def graft_restrained_chrome(
    icewm: Path,
    values: dict[str, str],
    pal: dict[str, tuple[int, int, int]],
) -> None:
    """Build restrained bundle chrome from the bundle's own themerc data.

    The KWM facade bitmaps are skipped entirely: the donor's four-pixel frame
    and Alpha caption buttons keep their geometry and are ramp-recoloured to
    the bundle palette, while the titlebar becomes the bundle's declared
    activeBackground->activeBlend gradient rendered through IceWM's Gradients
    smooth-scaling instead of pixel art the slots would clip.
    """
    active_blend = color_value(values.get("activeblend"), pal["active"])
    inactive_blend = color_value(values.get("inactiveblend"), pal["inactive"])
    for name, start, end in (
        ("titleAT.xpm", pal["active"], active_blend),
        ("titleAB.xpm", pal["active"], active_blend),
        ("titleIT.xpm", pal["inactive"], inactive_blend),
        ("titleIB.xpm", pal["inactive"], inactive_blend),
    ):
        write_title_gradient(icewm / name, start, end)
    override_theme_values(
        icewm / "default.theme",
        {"Gradients": '"titleAT.xpm titleIT.xpm titleAB.xpm titleIB.xpm"'},
    )
    ramp = bundle_chrome_ramp(pal["face"])
    chrome = [
        path for pattern in ("frame*.png", "dframe*.png")
        for path in sorted(icewm.glob(pattern))
    ]
    chrome += sorted((icewm / "taskbar").glob("*.xpm"))
    for path in chrome:
        recolor_pixmap_file(path, ramp)
    # Caption glyphs: on dark faces the donor's black glyphs vanish, so the
    # active glyph takes the scheme text colour and the inactive glyph a
    # face/text blend (dark bevel law, 2026-07-30).  Light faces keep the
    # authentic black glyphs.
    button_map = dict(ramp)
    if is_dark_face(pal["face"]):
        # Text law (2026-07-30): glyphs are black or white by face luminance.
        glyph = contrast(pal["face"])
        button_map[(0x00, 0x00, 0x00)] = glyph
        button_map[(0x70, 0x70, 0x70)] = mix_rgb(pal["face"], glyph, .55)
    for pattern in ("close*.png", "minimize*.png", "maximize*.png", "restore*.png"):
        for path in sorted(icewm.glob(pattern)):
            recolor_pixmap_file(path, button_map)
    # Corrected 2026-07-31 (the first pass had these two swapped): the
    # TITLEBAR menu button is the part that carries the titlebar gradient —
    # KWM drew its gradient straight across the button bed — while the K
    # button in the taskbar matches the PANEL, so its face stays flat.
    for name, start_c, end_c in (
        ("menuButtonA.png", pal["active"], active_blend),
        ("menuButtonI.png", pal["inactive"], inactive_blend),
    ):
        path = icewm / name
        if path.is_file():
            recolor_start_button_gradient(path, start_c, end_c)
    start_button = icewm / "taskbar/start.png"
    if start_button.is_file():
        recolor_start_button_gradient(start_button, pal["face"], pal["face"])


def render_desktop_gradient(cp, destination: Path) -> Path | None:
    """Honour a themerc [Display] ColorMode0=Gradient desktop declaration."""
    sections = {s.lower(): cp[s] for s in cp.sections()}
    display = {k.lower(): v for k, v in sections.get("display", {}).items()}
    if (display.get("colormode0") or "").lower() != "gradient":
        return None
    start = color_value(display.get("color0_1"), (84, 84, 84))
    end = color_value(display.get("color0_2"), (192, 192, 192))
    destination.parent.mkdir(parents=True, exist_ok=True)
    column = Image.new("RGB", (1, 1080))
    for y in range(1080):
        t = y / 1079
        column.putpixel((0, y), tuple(
            round(a + (b - a) * t) for a, b in zip(start, end)
        ))
    column.resize((1920, 1080), Image.Resampling.NEAREST).save(destination)
    return destination


def render_palette_gradient(
    pal: dict[str, tuple[int, int, int]],
    destination: Path,
) -> Path:
    """Clean vertical face-derived gradient for bundles whose bitmap
    wallpaper was ruled out (Wood) and whose themerc declares no gradient."""
    face = pal["face"]
    start = toward_white(face, .1)
    end = toward_black(face, .55)
    destination.parent.mkdir(parents=True, exist_ok=True)
    column = Image.new("RGB", (1, 1080))
    for y in range(1080):
        t = y / 1079
        column.putpixel((0, y), tuple(
            round(a + (b - a) * t) for a, b in zip(start, end)
        ))
    column.resize((1920, 1080), Image.Resampling.NEAREST).save(destination)
    return destination


def render_wallpaper(
    upstream: Path,
    cp,
    pal,
    destination: Path,
    fill: tuple[int, int, int] | None = None,
) -> Path | None:
    sections = {s.lower(): cp[s] for s in cp.sections()}
    display = sections.get("display", {})
    lower = {k.lower(): v for k, v in display.items()}
    name = lower.get("wallpaper0") or lower.get("wallpaper")
    if not name or not (upstream / name).is_file():
        return None
    src = upstream / name
    mode = (lower.get("wallpapermode0") or lower.get("wallpapermode") or "center").lower()
    destination.parent.mkdir(parents=True, exist_ok=True)
    with Image.open(src) as image:
        image = image.convert("RGB")
        canvas = Image.new("RGB", (1920, 1080), fill or pal["face"])
        if mode in ("tiled", "tile"):
            for y in range(0, 1080, image.height):
                for x in range(0, 1920, image.width):
                    canvas.paste(image, (x, y))
        elif mode in ("scaled", "scale", "stretched", "stretch"):
            canvas = image.resize((1920, 1080), Image.Resampling.LANCZOS)
        else:
            canvas.paste(image, ((1920 - image.width) // 2, (1080 - image.height) // 2))
        canvas.save(destination)
    return destination


def render_macos_blue_wallpaper(source: Path, destination: Path) -> Path:
    """Recolour the original 82px texture into a Mac OS 9 blue desktop."""
    if sha256(source.read_bytes()) != MACOS_DESKTOP_SHA256:
        raise SystemExit("MacOS desktop.jpg checksum mismatch")
    with Image.open(source) as original:
        texture = original.convert("RGB")
    luminance = texture.convert("L")
    mean = sum(luminance.getdata()) / (texture.width * texture.height)
    base = MACOS_BLUE_DESKTOP
    blue = Image.new("RGB", texture.size)
    pixels = blue.load()
    values = luminance.load()
    for y in range(texture.height):
        for x in range(texture.width):
            delta = round((values[x, y] - mean) * .28)
            pixels[x, y] = tuple(
                max(0, min(255, channel + delta)) for channel in base
            )
    canvas = Image.new("RGB", (1920, 1080), base)
    for y in range(0, canvas.height, blue.height):
        for x in range(0, canvas.width, blue.width):
            canvas.paste(blue, (x, y))
    destination.parent.mkdir(parents=True, exist_ok=True)
    canvas.save(destination)
    return destination


def render_macos_authentic_wallpaper(
    source_repo: Path,
    destination: Path,
) -> Path:
    """Tile KDE's corrected 79x83 ocean texture without scaling or blur."""
    payload = run(
        source_repo,
        "show",
        f"{PINNED_HEAD}:{MACOS_AUTHENTIC_WALLPAPER_PATH}",
    )
    if sha256(payload) != MACOS_AUTHENTIC_WALLPAPER_SHA256:
        raise SystemExit("MacOS authentic ocean01.jpg checksum mismatch")
    with Image.open(io.BytesIO(payload)) as original:
        tile = original.convert("RGB")
    if tile.size != (79, 83):
        raise SystemExit(
            f"MacOS authentic ocean01.jpg dimensions changed: {tile.size}"
        )
    canvas = Image.new("RGB", (1920, 1080))
    for y in range(0, canvas.height, tile.height):
        for x in range(0, canvas.width, tile.width):
            canvas.paste(tile, (x, y))
    destination.parent.mkdir(parents=True, exist_ok=True)
    canvas.save(destination)
    return destination


SOUND_MAP = {
    "startup": "startup.wav",
    "logoutmessage": "logout.wav",
    "windowclose": "windowClose.wav",
    "windowiconify": "windowMin.wav",
    "windowdeiconify": "windowRestore.wav",
    "windowmaximize": "windowMax.wav",
    "windowunmaximize": "windowRestore.wav",
    "windowtransnew": "windowOpen.wav",
}


def deploy_sounds(upstream: Path, cp, root: Path, slug: str) -> None:
    section = next((cp[s] for s in cp.sections() if s.lower() == "sounds"), None)
    if section is None:
        return
    target = root / f"linux/.local/share/sounds/schemes/{slug}/icewm"
    for key, value in section.items():
        source = upstream / value
        mapped = SOUND_MAP.get(key.lower())
        if source.is_file() and mapped:
            target.mkdir(parents=True, exist_ok=True)
            shutil.copy2(source, target / mapped)


def load_kde_system_sounds(source_repo: Path) -> dict[str, bytes]:
    """Load and checksum the original KDE system sound pack once."""
    payloads = {}
    for mapped, (source_name, expected_sha256) in KDE_SYSTEM_SOUNDS.items():
        payload = run(
            source_repo,
            "show",
            f"{KDE_SYSTEM_SOUND_COMMIT}:{KDE_SYSTEM_SOUND_PATH}/{source_name}",
        )
        if sha256(payload) != expected_sha256:
            raise SystemExit(f"KDE system sound checksum mismatch: {source_name}")
        payloads[mapped] = payload
    return payloads


def deploy_kde_system_sound_fallback(
    payloads: dict[str, bytes],
    root: Path,
    slug: str,
) -> None:
    """Preserve theme sounds and fill only their gaps with original KDE art."""
    target = root / f"linux/.local/share/sounds/schemes/{slug}"
    icewm = target / "icewm"
    icewm.mkdir(parents=True, exist_ok=True)
    inherited = []
    for mapped, payload in payloads.items():
        destination = icewm / mapped
        if destination.is_file():
            continue
        destination.write_bytes(payload)
        inherited.append(mapped)

    # sanctuary-sound reads the flat startup file while icesound reads icewm/.
    # Both consumers must resolve the same native chime.
    shutil.copy2(icewm / "startup.wav", target / "startup.wav")
    (target / "KDE1-SOUND-PROVENANCE").write_text(
        "Theme-native sounds take precedence.\n"
        f"Missing events inherit KDE's original system pack, first introduced "
        f"{KDE_SYSTEM_SOUND_DATE}.\n"
        f"Commit: {KDE_SYSTEM_SOUND_COMMIT}\n"
        f"Path: {KDE_SYSTEM_SOUND_PATH}\n"
        f"Inherited events: {', '.join(inherited) if inherited else 'none'}\n"
        "Flat and IceWM startup copies are identical.\n",
        encoding="utf-8",
    )


def write_scheme(path: Path, *, title: str, date: str, icewm: str, gtk: str,
                 icons: str, pal, wallpaper: Path | None, sound: str,
                 kvantum: str | None = None,
                 desktop: tuple[int, int, int] | None = None,
                 gtk_font: str = "Sans 8") -> None:
    desktop = desktop or pal["face"]
    label = contrast(desktop)
    shadow = (255, 255, 255) if label == (0, 0, 0) else (0, 0, 0)
    lines = [
        f"# Redstone 9X — {title}; first introduced {date}.",
        f'SCHEME_TITLE="{title} [{date}]"',
        f'ICEWM_THEME="{icewm}"',
        f'GTK_THEME="{gtk}"',
        f'ICON_THEME="{icons}"',
        'CURSOR_THEME="Chicago95_Cursor_White"',
        'CURSOR_SIZE="24"',
        f'GTK_FONT="{gtk_font}"',
        f'DESKTOP_BG="{hx(desktop)}"',
        'DESKTOP_ICON_LABEL_MODE="box"',
        f'DESKTOP_ICON_LABEL_BACKGROUND="{hx(desktop)}"',
        f'DESKTOP_LABEL_FOREGROUND="{hx(label)}"',
        f'DESKTOP_LABEL_SHADOW="{hx(shadow)}"',
        f'SEL_BG="{hx(pal["select"])}"',
        f'SEL_FG="{hx(pal["select_text"])}"',
        f'QT6CT_COLORS="{path.stem}.conf"',
        'QT_STYLE="kvantum"',
        f'KVANTUM_THEME="{kvantum or gtk}"',
        f'SOUND_SCHEME="{sound}"',
        f'FOX_BASE="{hx(pal["face"])}"',
        f'FOX_SEL_BG="{hx(pal["select"])}"',
        f'FOX_SEL_FG="{hx(pal["select_text"])}"',
        f'FOX_MENU_BG="{hx(pal["select"])}"',
        f'FOX_MENU_FG="{hx(pal["select_text"])}"',
    ]
    # FOX substrate (found 2026-07-30: schemes only set FOX_BASE/SEL, so ice2k
    # apps fell back to black-on-dark text and the light-theme bevel).  Same
    # dark bevel + text law as every other substrate.
    fox_dark = is_dark_face(pal["face"])
    fox_text = contrast(pal["face"]) if fox_dark else pal["text"]
    lines += [
        f'FOX_FG="{hx(fox_text)}"',
        f'FOX_BG="{hx(pal["window"])}"',
        f'FOX_HILITE="{hx(toward_white(pal["face"], .25) if fox_dark else (255, 255, 255))}"',
        f'FOX_SHADOW="{hx(toward_black(pal["face"], .5) if fox_dark else (128, 128, 128))}"',
        'FOX_BORDER="#000000"',
        f'FOX_FOCUS="{hx(fox_text)}"',
    ]
    if wallpaper:
        lines += [
            f'WALLPAPER="$HOME/{wallpaper.as_posix()}"',
            'WALLPAPER_MODE="center"',
        ]
    lines.append(
        'ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;'
        'TaskBarShowNetStatus=1;NetDevice=\\"wlan0 eth0\\";'
        'TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;'
        'ClockCommand=\\"i2kcal\\";CPUStatusCommand=\\"dbus-run-session '
        'mate-system-monitor\\";NetStatusCommand=\\"netactview\\";'
        'TaskBarShowWorkspaces=1"'
    )
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")


def export_catalog(repo: Path, output: Path) -> int:
    log = run(
        repo, "log", "--reverse", "--date=short",
        "--format=@@%H%x09%ad", "--diff-filter=A", "--name-only", PINNED_HEAD,
    ).decode("utf-8", "surrogateescape")
    commit = date = None
    first: dict[str, tuple[str, str]] = {}
    for line in log.splitlines():
        if line.startswith("@@"):
            commit, date = line[2:].split("\t", 1)
        elif line and commit and date:
            lower = line.lower()
            suffix = Path(lower).suffix
            if suffix in CATALOG_EXTENSIONS or lower.endswith(".tar.gz"):
                first.setdefault(line, (commit, date))
    manifest = ["date\tcommit\tsha256\tpath"]
    for original, (item_commit, item_date) in sorted(first.items()):
        try:
            payload = run(repo, "show", f"{item_commit}:{original}")
        except subprocess.CalledProcessError:
            continue
        target = output / "asset-catalog" / item_date / original
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(payload)
        manifest.append(f"{item_date}\t{item_commit}\t{sha256(payload)}\t{original}")
    (output / "FIRST-APPEARANCE-ASSETS.tsv").write_text(
        "\n".join(manifest) + "\n", encoding="utf-8",
    )
    return len(manifest) - 1


def reuse_catalog(existing: Path, output: Path) -> int:
    """Preserve the complete catalog during a focused conversion rebuild."""
    catalog = existing / "asset-catalog"
    manifest = existing / "FIRST-APPEARANCE-ASSETS.tsv"
    if not catalog.is_dir() or not manifest.is_file():
        raise SystemExit(
            "--skip-catalog requires an existing generated history catalog"
        )
    shutil.copytree(catalog, output / "asset-catalog")
    shutil.copy2(manifest, output / manifest.name)
    return max(0, len(manifest.read_text(encoding="utf-8").splitlines()) - 1)


def build_wallpaper_index(output: Path) -> int:
    """Build a flat, provenance-labelled symlink view of every wallpaper."""
    catalog = output / "asset-catalog"
    index = output / "wallpapers"
    index.mkdir()
    count = 0
    for source in sorted(catalog.rglob("*")):
        if not source.is_file():
            continue
        relative = source.relative_to(catalog)
        if "/pics/wallpapers/" not in f"/{relative.as_posix()}":
            continue
        link = index / f"{relative.parts[0]} -- {source.name}"
        if link.exists() or link.is_symlink():
            raise SystemExit(f"duplicate wallpaper index name: {link.name}")
        link.symlink_to(os.path.relpath(source, index))
        count += 1
    (index / "README").write_text(
        "KDE 1 historical wallpapers, flattened for visual browsing.\n"
        "Each relative symlink points into asset-catalog; its date is the "
        "wallpaper path's first appearance in kde1-kdebase.\n"
        f"Wallpaper count: {count}\n",
        encoding="utf-8",
    )
    return count


def same_tree(a: Path, b: Path) -> bool:
    def digest(root):
        entries = []
        for p in sorted(root.rglob("*")):
            if p.is_file():
                entries.append((p.relative_to(root).as_posix(), sha256(p.read_bytes())))
        return entries
    return a.exists() and digest(a) == digest(b)


def install_tree(built: Path, target: Path) -> str:
    if same_tree(target, built):
        return "unchanged"
    if target.exists() and not (target / GENERATED_MARKER).is_file():
        raise SystemExit(f"refusing to replace unmarked path: {target}")
    if target.exists():
        shutil.rmtree(target)
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.move(str(built), target)
    return "updated"


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("source_repo", type=Path)
    parser.add_argument("--repo-root", type=Path, default=Path.home() / "DotCortex")
    parser.add_argument("--skip-catalog", action="store_true")
    args = parser.parse_args()
    source = args.source_repo.expanduser().resolve()
    root = args.repo_root.expanduser().resolve()
    verify_commit(source, PINNED_HEAD)
    color_slugs = {spec.slug for spec in COLORS}
    theme_slugs = {spec.slug for spec in THEMES}
    if set(COLOR_WIDGET_STYLES) != color_slugs:
        raise SystemExit("COLOR_WIDGET_STYLES must cover every color exactly")
    if set(THEME_WIDGET_STYLES) != theme_slugs:
        raise SystemExit("THEME_WIDGET_STYLES must cover every theme exactly")

    with tempfile.TemporaryDirectory(prefix="kde1-history-") as td:
        built = Path(td) / "history"
        built.mkdir()
        (built / GENERATED_MARKER).write_text(PINNED_HEAD + "\n", encoding="ascii")
        (built / ".gitattributes").write_text(
            "** -whitespace\n"
            "asset-catalog/** -text -diff\n"
            "colors/**/*.kcsrc -text -diff\n"
            "themes/**/upstream/** -text -diff\n",
            encoding="ascii",
        )
        if args.skip_catalog:
            catalog_count = reuse_catalog(root / HISTORY_ROOT, built)
        else:
            catalog_count = export_catalog(source, built)
        wallpaper_count = build_wallpaper_index(built)
        kde_system_sounds = load_kde_system_sounds(source)
        ledger = ["kind\tname\tdate\tcommit\ttree\tsha256\tpath\twidget_style"]
        build_curated_icon_theme(root, MACOS_ICON_THEME, mac_places=True)
        build_curated_icon_theme(root, CURATED_ICON_THEME, mac_places=False)

        for spec in COLORS:
            verify_commit(source, spec.commit, spec.tree)
            payload = run(source, "show", f"{spec.commit}:{spec.path}")
            if sha256(payload) != spec.sha256:
                raise SystemExit(f"{spec.name}: color checksum mismatch")
            item = built / "colors" / spec.slug
            item.mkdir(parents=True)
            original = item / Path(spec.path).name
            original.write_bytes(payload)
            cp, values = parse_ini(original)
            pal = palette(values)
            dp = item / f"{spec.slug}.dp"
            write_dp(dp, pal, pal["face"])
            attested_style = COLOR_WIDGET_STYLES[spec.slug]
            icewm = f"KDE1-Color-{spec.slug}"
            icewm_dir = root / "linux/.icewm/themes" / icewm
            if icewm_dir.exists():
                shutil.rmtree(icewm_dir)
            shutil.copytree(root / "linux/.icewm/themes/KDE-1-Alpha", icewm_dir)
            append_icewm_colors(icewm_dir / "default.theme",
                                f"KDE 1 Color {spec.name}", pal)
            mark_payload(icewm_dir)
            # KDE 1's kdisplay style tab offered "Draw widgets in the style
            # of Windows 95" as a checkbox, so every colour scheme legitimately
            # existed in both control geometries.  The historically-attested
            # style keeps the unsuffixed scheme/theme identity; the counterpart
            # style is emitted alongside it with an explicit -w95/-cde suffix.
            for widget_style in ("classic", "motif"):
                style_tag = "Win95" if widget_style == "classic" else "CDE"
                if widget_style == attested_style:
                    variant = f"kde1-color-{spec.slug}"
                    gtk = f"KDE1-Color-{spec.slug}"
                else:
                    suffix = "w95" if widget_style == "classic" else "cde"
                    variant = f"kde1-color-{spec.slug}-{suffix}"
                    gtk = f"KDE1-Color-{spec.slug}-{suffix}"
                convert_gtk(root, dp, gtk, variant, widget_style, pal)
                scheme = (
                    root / f"linux/.config/redstone-9x/schemes/{variant}.scheme"
                )
                write_scheme(
                    scheme,
                    title=f"KDE 1 Color — {spec.name} · {style_tag} widgets",
                    date=spec.date,
                    icewm=icewm, gtk=gtk, icons=CURATED_ICON_THEME,
                    pal=pal, wallpaper=None, sound="kde-0.1",
                )
                write_qt(
                    root
                    / f"linux/.config/redstone-9x/qt6ct/colors/{scheme.stem}.conf",
                    pal,
                )
                write_wine_reg(
                    root / f"linux/.config/redstone-9x/wine/{scheme.stem}.reg",
                    pal,
                )
            (item / "PROVENANCE").write_text(
                f"Name: {spec.name}\nFirst introduced: {spec.date}\n"
                f"Commit: {spec.commit}\nTree: {spec.tree}\n"
                f"SHA-256: {spec.sha256}\nPath: {spec.path}\n"
                f"Attested widget style: {attested_style}\n"
                "Emitted widget styles: classic (Win95) and motif (CDE); the "
                "attested style keeps the unsuffixed identity.\n",
                encoding="utf-8",
            )
            ledger.append(f"color\t{spec.name}\t{spec.date}\t{spec.commit}\t"
                          f"{spec.tree}\t{spec.sha256}\t{spec.path}\t{attested_style}")

        for spec in THEMES:
            item = built / "themes" / spec.slug
            upstream = item / "upstream"
            upstream.mkdir(parents=True)
            extract_theme(source, spec, upstream)
            themerc = next(upstream.glob("*.themerc"), None)
            if themerc is None:
                raise SystemExit(f"{spec.name}: no .themerc in earliest bundle")
            cp, values = parse_ini(themerc)
            pal = palette(values)
            dp = item / f"{spec.slug}.dp"
            write_dp(dp, pal, pal["face"])
            gtk = f"KDE1-Theme-{spec.slug}"
            widget_style = THEME_WIDGET_STYLES[spec.slug]
            convert_gtk(
                root, dp, gtk, f"kde1-theme-{spec.slug}", widget_style, pal,
            )
            scheme_gtk = gtk
            scheme_icons = CURATED_ICON_THEME
            scheme_kvantum = None
            if spec.slug == "macos":
                scheme_gtk = "PLATINUM"
                scheme_icons = MACOS_ICON_THEME
                scheme_kvantum = build_macos_platinum_kvantum(root, gtk)
            icewm = f"KDE1-Theme-{spec.slug}"
            icewm_dir = root / "linux/.icewm/themes" / icewm
            if icewm_dir.exists():
                shutil.rmtree(icewm_dir)
            if spec.slug == "macos":
                build_macos_icewm(root, icewm_dir, pal)
            else:
                shutil.copytree(root / "linux/.icewm/themes/KDE-1-Alpha", icewm_dir)
            append_icewm_colors(icewm_dir / "default.theme",
                                f"KDE 1 Theme {spec.name}", pal)
            if spec.slug == "macos":
                override_theme_values(
                    icewm_dir / "default.theme",
                    {'ColorActiveTaskBarAppText': '"#000000"'},
                )
            if spec.slug in RESTRAINED_SLUGS:
                graft_restrained_chrome(icewm_dir, values, pal)
            elif spec.slug in REPAIR_SLUGS:
                graft_kwm_assets(upstream, icewm_dir, cp, repair_buttons=True)
                sections = {s.lower(): cp[s] for s in cp.sections()}
                alignment = sections.get("window titlebar", {}).get(
                    "TitleAlignment", "",
                )
                if alignment.lower() == "middle":
                    # Modern IceWM positions the title with TitleBarJustify
                    # (0-100); TitleBarCentered alone was ignored by the
                    # room's build (found 2026-07-31).  Set both.
                    override_theme_values(
                        icewm_dir / "default.theme",
                        {"TitleBarCentered": "1", "TitleBarJustify": "50"},
                    )
                # Solid bed behind the centred title text, the exact MacOS
                # authentic mechanism (write_macos_title_parts): the pattern
                # art repeats across the S (left pane) and B (right pane)
                # pieces so the grooves stay visible either side, while the
                # fixed 4px P/M pads and the stretching T piece carry a solid
                # bed in the art's own base colour — a T-only bed covered the
                # grooves left of the text (found 2026-07-31).
                for state_, art_name in (("A", "titleAB.xpm"),
                                         ("I", "titleIB.xpm")):
                    art_path = icewm_dir / art_name
                    if not art_path.is_file():
                        continue
                    with Image.open(art_path) as art_img:
                        art_rgba = art_img.convert("RGBA")
                    base_counts: dict = {}
                    for pixel in art_rgba.convert("RGB").getdata():
                        base_counts[pixel] = base_counts.get(pixel, 0) + 1
                    bed = max(base_counts, key=base_counts.get)
                    for segment in ("S", "B", "L", "R"):
                        art_rgba.save(
                            icewm_dir / f"title{state_}{segment}.png",
                        )
                    height = art_rgba.height
                    pad = Image.new("RGBA", (4, height), (*bed, 255))
                    for segment in ("P", "M"):
                        pad.save(icewm_dir / f"title{state_}{segment}.png")
                    Image.new("RGBA", (2, height), (*bed, 255)).save(
                        icewm_dir / f"title{state_}T.png",
                    )
                    (icewm_dir / art_name).unlink()
                    # The original draws the app icon straight on the
                    # titlebar with no button bevel under it — give IceWM a
                    # plain solid bed the same size as the repaired buttons
                    # (MiDesktop side-by-side, 2026-07-31).
                    for old in icewm_dir.glob(f"menuButton{state_}.*"):
                        old.unlink()
                    Image.new("RGBA", (23, 40), (*bed, 255)).save(
                        icewm_dir / f"menuButton{state_}.png",
                    )
                write_repair_frames(icewm_dir)
                # The MacOS theme carries the correct face and size for
                # Nostalgy's design — reuse its bundled font mapping.
                override_theme_values(
                    icewm_dir / "default.theme", macos_icewm_font_values(),
                )
            elif spec.slug != "macos":
                graft_kwm_assets(upstream, icewm_dir, cp)
            wallpaper_dest = icewm_dir / f"backgrounds/{spec.slug}-1920x1080.png"
            if spec.slug in RESTRAINED_FORCE_GRADIENT:
                wallpaper_file = (
                    render_desktop_gradient(cp, wallpaper_dest)
                    or render_palette_gradient(pal, wallpaper_dest)
                )
            else:
                wallpaper_file = render_wallpaper(
                    upstream, cp, pal, wallpaper_dest,
                    fill=(0, 0, 0) if spec.slug in CENTERED_BLACK_SLUGS else None,
                )
                if wallpaper_file is None and spec.slug in RESTRAINED_SLUGS:
                    wallpaper_file = render_desktop_gradient(cp, wallpaper_dest)
            mark_payload(icewm_dir)
            wallpaper = (
                Path(f".icewm/themes/{icewm}/backgrounds/{wallpaper_file.name}")
                if wallpaper_file else None
            )
            if spec.slug == "macos":
                blue_wallpaper_file = render_macos_blue_wallpaper(
                    upstream / "desktop.jpg",
                    icewm_dir / "backgrounds/macos-blue-texture-1920x1080.png",
                )
                wallpaper = Path(
                    f".icewm/themes/{icewm}/backgrounds/"
                    f"{blue_wallpaper_file.name}"
                )
            scheme_id = f"kde1-theme-{spec.slug}"
            deploy_sounds(upstream, cp, root, scheme_id)
            deploy_kde_system_sound_fallback(
                kde_system_sounds, root, scheme_id,
            )
            scheme = root / f"linux/.config/redstone-9x/schemes/{scheme_id}.scheme"
            scheme_title = (
                "Redstone 9X KDE Alpha MacOS Retromod"
                if spec.slug == "macos"
                else f"KDE 1 Theme — {spec.name}"
            )
            write_scheme(
                scheme, title=scheme_title, date=spec.date,
                icewm=icewm, gtk=scheme_gtk, icons=scheme_icons,
                pal=pal, wallpaper=wallpaper, sound=scheme_id,
                kvantum=scheme_kvantum,
                desktop=(
                    MACOS_BLUE_DESKTOP if spec.slug == "macos"
                    else (0, 0, 0) if spec.slug in CENTERED_BLACK_SLUGS
                    else None
                ),
                # Nostalgy shares the MacOS bundled face — the repair ruling
                # (2026-07-31): the MacOS theme carries the correct font and
                # size for Nostalgy's design.
                gtk_font=(
                    MACOS_GTK_FONT if spec.slug == "macos"
                    or spec.slug in REPAIR_SLUGS else "Sans 8"
                ),
            )
            write_qt(root / f"linux/.config/redstone-9x/qt6ct/colors/{scheme.stem}.conf", pal)
            write_wine_reg(
                root / f"linux/.config/redstone-9x/wine/{scheme.stem}.reg", pal,
            )
            if spec.slug == "macos":
                if wallpaper_file is None:
                    raise SystemExit("MacOS: original wallpaper was not rendered")
                authentic_icewm = "KDE1-Theme-macos-authentic"
                authentic_dir = root / "linux/.icewm/themes" / authentic_icewm
                if authentic_dir.exists():
                    shutil.rmtree(authentic_dir)
                build_macos_authentic_icewm(
                    icewm_dir, authentic_dir, upstream,
                )
                authentic_wallpaper_file = render_macos_authentic_wallpaper(
                    source,
                    authentic_dir
                    / "backgrounds/ocean01-tiled-1920x1080.png",
                )
                append_icewm_colors(
                    authentic_dir / "default.theme",
                    "KDE 1 Theme MacOS Authentic",
                    pal,
                )
                override_theme_values(
                    authentic_dir / "default.theme",
                    {'ColorActiveTaskBarAppText': '"#000000"'},
                )
                mark_payload(authentic_dir)
                authentic_scheme_id = "kde1-theme-macos-authentic"
                authentic_scheme = (
                    root
                    / "linux/.config/redstone-9x/schemes"
                    / f"{authentic_scheme_id}.scheme"
                )
                authentic_wallpaper = Path(
                    f".icewm/themes/{authentic_icewm}/backgrounds/"
                    f"{authentic_wallpaper_file.name}"
                )
                write_scheme(
                    authentic_scheme,
                    title="KDE 1 Theme — MacOS Authentic",
                    date=spec.date,
                    icewm=authentic_icewm,
                    gtk=gtk,
                    icons=MACOS_ICON_THEME,
                    pal=pal,
                    wallpaper=authentic_wallpaper,
                    sound=scheme_id,
                    gtk_font=MACOS_GTK_FONT,
                )
                write_qt(
                    root
                    / "linux/.config/redstone-9x/qt6ct/colors"
                    / f"{authentic_scheme.stem}.conf",
                    pal,
                )
                write_wine_reg(
                    root
                    / f"linux/.config/redstone-9x/wine/{authentic_scheme.stem}.reg",
                    pal,
                )
                (item / "AUTHENTIC-CONVERSION").write_text(
                    "Variant: KDE 1 Theme — MacOS Authentic\n"
                    "Caption grooves/buttons: original 1998 MacOS bundle\n"
                    "Caption layout: application icon at left; centered title; "
                    "min | max | close at right\n"
                    "Caption control beds: solid #CECECE active widget face\n"
                    "Caption text bed: solid with fixed 4px P/M pads "
                    "(about 2px visible per side); "
                    "three KDE grooves remain outside it\n"
                    f"System font: bundled {MACOS_FONT_FAMILY} "
                    f"{MACOS_UI_FONT_SIZE}; caption "
                    f"{MACOS_TITLE_FONT_SIZE} regular\n"
                    "Lower frame: one-pixel colour frame; no Tosh bottom bevel\n"
                    f"Icons: {MACOS_ICON_THEME}\n"
                    "Wallpaper: KDE pics/wallpapers/ocean01.jpg from pinned "
                    "head, tiled at native 79x83 into 1920x1080\n"
                    f"Wallpaper SHA-256: {MACOS_AUTHENTIC_WALLPAPER_SHA256}\n",
                    encoding="utf-8",
                )
            (item / "PROVENANCE").write_text(
                f"Name: {spec.name}\nFirst introduced: {spec.date}\n"
                f"Commit: {spec.commit}\nTree: {spec.tree}\n"
                f"Source kind: {spec.source_kind}\nSHA-256: {spec.sha256}\n"
                f"Path: {spec.path}\nWidget style: {widget_style}\n"
                f"Missing sounds inherit KDE's original system pack from "
                f"{KDE_SYSTEM_SOUND_DATE} ({KDE_SYSTEM_SOUND_COMMIT}).\n"
                + (
                    "IceWM conversion donor: Tosh 0.2 frame geometry; "
                    "KDE-1-Alpha taskbar chrome\n"
                    "Retromod caption vertical offset: -1px\n"
                    "Retromod widgets: PLATINUM GTK; palette-matched "
                    f"{MACOS_PLATINUM_KVANTUM} Qt\n"
                    f"Retromod icons: {MACOS_ICON_THEME}\n"
                    f"Mac system font: bundled {MACOS_FONT_FAMILY} "
                    f"{MACOS_UI_FONT_SIZE}; caption "
                    f"{MACOS_TITLE_FONT_SIZE} regular; "
                    f"SHA-256 {PLATINUM9_CHARCOAL_SHA256}\n"
                    "Original wallpaper: upstream/desktop.jpg (82x82 JPEG)\n"
                    f"Original wallpaper SHA-256: {MACOS_DESKTOP_SHA256}\n"
                    "Original MacOS.themerc: Wallpaper0=desktop.jpg; "
                    "WallpaperMode0=Tiled\n"
                    "Retromod wallpaper: original desktop.jpg texture "
                    "recoloured Mac OS 9 blue and tiled at 1920x1080\n"
                    "Authentic wallpaper override: pinned KDE "
                    f"{MACOS_AUTHENTIC_WALLPAPER_PATH}, native 79x83 tile; "
                    f"SHA-256 {MACOS_AUTHENTIC_WALLPAPER_SHA256}\n"
                    if spec.slug == "macos" else ""
                )
                + (
                    "Chrome: restrained — KWM facade bitmaps skipped; "
                    "KDE-1-Alpha donor geometry and caption buttons "
                    "ramp-recoloured to the bundle palette\n"
                    "Titlebar: bundle themerc activeBackground->activeBlend "
                    "and inactiveBackground->inactiveBlend horizontal "
                    "gradients via IceWM Gradients\n"
                    "Wallpaper: themerc [Display] ColorMode0=Gradient "
                    "rendered as declared when no bitmap wallpaper exists\n"
                    "Dark bevel law: dark faces take one subtle highlight, "
                    "face-derived bevel shadow, black outer shadow; caption "
                    "glyphs in scheme text colour\n"
                    "K menu button: gear art repainted onto the active "
                    "titlebar gradient; titlebar menu button takes the "
                    "gradient end colours\n"
                    if spec.slug in RESTRAINED_SLUGS else ""
                )
                + (
                    "Chrome: repaired — bundle's own titlebar, border, and "
                    "button art retained; single-frame KWM buttons composed "
                    "into IceWM two-frame pixmaps (pressed frame +1px "
                    "offset), donor slots overwritten\n"
                    "Title alignment: centred per themerc TitleAlignment\n"
                    if spec.slug in REPAIR_SLUGS else ""
                )
                + (
                    "Wallpaper: upstream bitmap ruled out; clean procedural "
                    "palette gradient instead\n"
                    if spec.slug in RESTRAINED_FORCE_GRADIENT else ""
                ),
                encoding="utf-8",
            )
            ledger.append(f"theme\t{spec.name}\t{spec.date}\t{spec.commit}\t"
                          f"{spec.tree}\t{spec.sha256}\t{spec.path}\t{widget_style}")

        base_pal = {
            "face": (192, 192, 192), "text": (0, 0, 0),
            "select": (0, 0, 128), "select_text": (255, 255, 255),
            "active": (0, 0, 0), "active_text": (255, 255, 255),
            "inactive": (128, 128, 128), "inactive_text": (192, 192, 192),
            "window": (255, 255, 255), "window_text": (0, 0, 0),
        }
        for title, slug, date, icons in ICON_EPOCHS:
            scheme = root / f"linux/.config/redstone-9x/schemes/kde1-icons-{slug}.scheme"
            write_scheme(
                scheme, title=f"KDE 1 Icons — {title}", date=date,
                icewm="KDE-1-Alpha", gtk="Motif95", icons=icons,
                pal=base_pal,
                wallpaper=Path(".icewm/themes/KDE-1-Alpha/backgrounds/KDE_1_Alpha.png"),
                sound="kde-0.1",
            )
            write_qt(root / f"linux/.config/redstone-9x/qt6ct/colors/{scheme.stem}.conf",
                     base_pal)
            write_wine_reg(
                root / f"linux/.config/redstone-9x/wine/{scheme.stem}.reg",
                base_pal,
            )

        (built / "FIRST-INTRODUCTIONS.tsv").write_text(
            "\n".join(ledger) + "\n", encoding="utf-8",
        )
        status = install_tree(built, root / HISTORY_ROOT)
    print(
        f"redstone-9x-kde1-history-import: status={status} "
        f"colors={len(COLORS)} themes={len(THEMES)} "
        f"icon_epochs={len(ICON_EPOCHS)} catalog_assets={catalog_count} "
        f"wallpapers={wallpaper_count}"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
