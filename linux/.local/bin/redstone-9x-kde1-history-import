def recolor_theme_pixmaps(
    theme: Path,
    color_map: dict[tuple[int, int, int], tuple[int, int, int]],
) -> None:
    for path in theme.rglob("*"):
        if not path.is_file() or path.is_symlink():
            continue
        if path.suffix.lower() == ".xpm":
            content = path.read_text(encoding="latin-1")
            for old, new in color_map.items():
                old_hex = "#%02x%02x%02x" % old
                content = re.sub(
                    re.escape(old_hex), hx(new), content, flags=re.IGNORECASE,
                )
            path.write_text(content, encoding="latin-1")
        elif path.suffix.lower() == ".png":
            with Image.open(path) as original:
                image = original.convert("RGBA")
            pixels = image.load()
            changed = False
            for y in range(image.height):
                for x in range(image.width):
                    red, green, blue, alpha = pixels[x, y]
                    replacement = color_map.get((red, green, blue))
                    if replacement is not None:
                        pixels[x, y] = (*replacement, alpha)
                        changed = True
            if changed:
                image.save(path)


def override_theme_values(path: Path, values: dict[str, str]) -> None:
    """Replace IceWM keys once, then append one authoritative override block."""
    keys = set(values)
    lines = [
        line for line in path.read_text(encoding="latin-1").splitlines()
        if line.split("=", 1)[0].strip() not in keys
    ]
    lines += ["", "# ==== Redstone KDE MacOS geometry ===="]
    lines += [f"{key}={value}" for key, value in values.items()]
    path.write_text("\n".join(lines) + "\n", encoding="latin-1")


def macos_icewm_font_values() -> dict[str, str]:
    """Use the bundled narrow Mac OS Charcoal face for every IceWM role."""
    regular = f'"{MACOS_FONT_FAMILY}:size=8"'
    bold = f'"{MACOS_FONT_FAMILY}:size=8:bold"'
    return {
        "TitleFontNameXft": f'"{MACOS_FONT_FAMILY}:size=10:bold"',
        "MenuFontNameXft": regular,
        "ActiveMenuFontNameXft": bold,
        "NormalButtonFontNameXft": regular,
        "ActiveButtonFontNameXft": bold,
        "ToolButtonFontNameXft": regular,
        "NormalTaskBarFontNameXft": regular,
        "ActiveTaskBarFontNameXft": bold,
        "NormalWorkspaceFontNameXft": regular,
        "ActiveWorkspaceFontNameXft": bold,
        "MinimizedWindowFontNameXft": regular,
        "QuickSwitchFontNameXft": regular,
        "StatusFontNameXft": regular,
        "ToolTipFontNameXft": regular,
        "ClockFontNameXft": regular,
        "ApmFontNameXft": regular,
        "TempFontNameXft": regular,
        "InputFontNameXft": regular,
        "LabelFontNameXft": regular,
        "ListBoxFontNameXft": regular,
    }


def write_taskbar_strip(
    path: Path,
    face: tuple[int, int, int],
    *,
    pressed: bool,
) -> None:
    """Write a horizontally seamless strip at the live IceWM panel height.

    IceWM tiles task-button pixmaps instead of stretching their edge pixels.
    The old 59px Alpha button therefore repeated its left/right bevel through
    every wide task button.  These strips retain only the horizontal bevels;
    every row is deliberately identical across its three pixels.  The panel
    is 31px high at 96 DPI; a 28px donor repeated its first three rows along
    the bottom edge.
    """
    light = tuple(round(channel + (255 - channel) * .45) for channel in face)
    shadow = tuple(round(channel * .66) for channel in face)
    black = (0, 0, 0)
    white = (255, 255, 255)
    inner_height = MACOS_TASKBAR_HEIGHT - 4
    if pressed:
        rows = [black, shadow] + [face] * inner_height + [light, white]
    else:
        rows = [white, light] + [face] * inner_height + [shadow, black]
    colors = {
        ".": face,
        "l": light,
        "s": shadow,
        "b": black,
        "w": white,
    }
    chars = {
        face: ".",
        light: "l",
        shadow: "s",
        black: "b",
        white: "w",
    }
    if path.is_symlink() or path.exists():
        path.unlink()
    path.write_text(
        "/* XPM */\n"
        "static char * taskbar_strip_xpm[] = {\n"
        f'"3 {MACOS_TASKBAR_HEIGHT} {len(colors)} 1",\n'
        + "".join(f'"{char} c {hx(rgb)}",\n' for char, rgb in colors.items())
        + "".join(
            f'"{chars[row] * 3}"'
            f'{"," if index < MACOS_TASKBAR_HEIGHT - 1 else ""}\n'
            for index, row in enumerate(rows)
        )
        + "};\n",
        encoding="ascii",
    )


def repair_macos_taskbar(taskbar: Path, face: tuple[int, int, int]) -> None:
    normal = (
        "taskbarbg.xpm",
        "taskbuttonbg.xpm",
        "taskbuttonminimized.xpm",
        "toolbuttonbg.xpm",
        "workspacebuttonbg.xpm",
    )
    active = ("taskbuttonactive.xpm", "workspacebuttonactive.xpm")
    for name in normal:
        write_taskbar_strip(taskbar / name, face, pressed=False)
    for name in active:
        write_taskbar_strip(taskbar / name, face, pressed=True)


def build_macos_icewm(
    repo_root: Path,
    icewm: Path,
    pal: dict[str, tuple[int, int, int]],
) -> None:
    """Adapt Tosh's native IceWM geometry to the original KDE Mac palette."""
    donor = repo_root / "linux/.icewm/themes/Tosh"
    taskbar_donor = repo_root / "linux/.icewm/themes/KDE-1-Alpha/taskbar"
    if not (donor / "default.theme").is_file():
        raise SystemExit(f"MacOS IceWM donor missing: {donor}")
    if not taskbar_donor.is_dir():
        raise SystemExit(f"MacOS taskbar donor missing: {taskbar_donor}")
    shutil.copytree(donor, icewm)
    default = icewm / "default.theme"
    text = default.read_text(encoding="latin-1")
    text = text.replace("TaskBarShowStartMenu=0", "TaskBarShowStartMenu=1")
    default.write_text(text, encoding="latin-1")
    override_theme_values(
        default,
        {
            "TitleBarCentered": "0",
            "TitleBarJustify": "0",
            "TaskBarHeight": str(MACOS_TASKBAR_HEIGHT),
            **macos_icewm_font_values(),
        },
    )

    # KDE's 50x10 panel.xpm is application-panel artwork, not an IceWM
    # taskbar background.  Preserve it in the historical upstream payload,
    # but use the Alpha theme's one-pixel-wide, taskbar-height-safe chrome.
    shutil.copytree(taskbar_donor, icewm / "taskbar")
    face = pal["face"]
    face_plus = tuple(min(255, channel + 3) for channel in face)
    light = tuple(round(channel + (255 - channel) * .35) for channel in face)
    recolor_theme_pixmaps(
        icewm,
        {
            (0xF0, 0xF0, 0xF0): face,
            (0xC0, 0xC0, 0xC0): face,
            (0xC3, 0xC3, 0xC3): face_plus,
            (0xD4, 0xD0, 0xC8): face,
            (0xCC, 0xCC, 0xCC): pal["active"],
            (0xDD, 0xDD, 0xDD): pal["inactive"],
            (0xDF, 0xDF, 0xDF): light,
            (0xEA, 0xE8, 0xE4): light,
            (0x73, 0xAD, 0xEF): pal["select"],
        },
    )
    repair_macos_taskbar(icewm / "taskbar", pal["face"])


def macos_title_strip(
    source: Path,
    state: str,
    panel_source: Path,
) -> Image.Image:
    """Derive IceWM's 17px strip from the catalogued KDE Mac artwork.

    KWM clipped the original active alternating-line XPM into a much shorter
    caption.  Tiling that 17px source verbatim in IceWM creates eight thin
    rules down the full caption.  Preserve its face/highlight pixels and use
    the historical panel artwork's shadow to reconstruct the three chunky
    two-pixel bevels visible in the bundled preview.
    """
    with Image.open(source) as original:
        source_strip = original.convert("RGBA")
    if state != "A":
        return source_strip.crop((0, 0, 1, 17))

    face = (*(
        MACOS_TITLE_FACE if state == "A" else MACOS_INACTIVE_TITLE_FACE
    ), 255)
    highlight = source_strip.getpixel((0, 1))
    with Image.open(panel_source) as original:
        panel = original.convert("RGBA")
    opaque = {
        pixel for pixel in panel.getdata()
        if pixel[3] and pixel[:3] not in {face[:3], highlight[:3]}
    }
    shadow = min(
        opaque,
        key=lambda pixel: abs(sum(pixel[:3]) / 3 - sum(face[:3]) / 3 * .8),
    )
    strip = Image.new("RGBA", (1, 17), face)
    for top in (3, 7, 11):
        strip.putpixel((0, top), highlight)
        strip.putpixel((0, top + 1), shadow)
    return strip


def macos_caption_background(
    state: str,
    width: int,
) -> Image.Image:
    """Return a solid widget-face bed around titlebar controls."""
    face = (
        MACOS_TITLE_FACE if state == "A" else MACOS_INACTIVE_TITLE_FACE
    )
    return Image.new("RGBA", (width, 17), (*face, 255))


def write_macos_title_parts(
    source: Path,
    target: Path,
    state: str,
    panel_source: Path,
) -> None:
    """Install the reconstructed KDE groove across every caption segment."""
    strip = macos_title_strip(source, state, panel_source)
    for segment in ("B", "L", "M", "P", "R", "S", "T"):
        strip.save(target / f"title{state}{segment}.png")


def write_macos_caption_sprite(
    source: Path,
    destination: Path,
    state: str,
) -> None:
    """Place KDE's original 13px button on two solid 20px widget-face beds."""
    with Image.open(source) as original:
        button = original.convert("RGBA")
    background = macos_caption_background(state, 20)
    sprite = Image.new("RGBA", (20, 34))
    sprite.alpha_composite(background, (0, 0))
    sprite.alpha_composite(background, (0, 17))
    sprite.alpha_composite(button, (3, 2))
    sprite.alpha_composite(button, (4, 19))
    sprite.save(destination)


def write_macos_menu_button_sprite(destination: Path, state: str) -> None:
    """Give IceWM a solid bed on which to draw the application icon."""
    background = macos_caption_background(state, 20)
    sprite = Image.new("RGBA", (20, 34))
    sprite.alpha_composite(background, (0, 0))
    sprite.alpha_composite(background, (0, 17))
    sprite.save(destination)


def build_macos_authentic_icewm(
    current: Path,
    authentic: Path,
    upstream: Path,
) -> None:
    """Fork the retromod with KDE's own 1998 Mac caption artwork."""
    shutil.copytree(current, authentic)
    default = authentic / "default.theme"
    override_theme_values(
        default,
        {
            "TitleBarCentered": "1",
            "TitleBarJustify": "50",
            'TitleButtonsSupported': '"sxmi"',
            'TitleButtonsRight': '"xmi"',
            'TitleButtonsLeft': '"s"',
            "TitleBarHeight": "17",
            "BorderSizeX": "1",
            "BorderSizeY": "1",
            "CornerSizeX": "1",
            "CornerSizeY": "1",
            "DlgBorderSizeX": "1",
            "DlgBorderSizeY": "1",
            "ButtonX": "20",
            "ButtonY": "17",
            **macos_icewm_font_values(),
        },
    )

    # Tosh's multipart grooves and six-pixel lower frame belong only to the
    # retromod.  The authentic fork uses KDE's own 17px groove strip and a
    # one-pixel colour frame, so its bottom edge blends into the window.
    for pattern in ("titleA*", "titleI*", "frameA*", "frameI*", "dframe*"):
        for path in authentic.glob(pattern):
            path.unlink()
    panel_source = upstream / "panel.xpm"
    write_macos_title_parts(
        upstream / "active.xpm", authentic, "A", panel_source,
    )
    write_macos_title_parts(
        upstream / "inactive.xpm", authentic, "I", panel_source,
    )

    button_sources = {
        "close": upstream / "close.xpm",
        "minimize": upstream / "iconify.xpm",
        "maximize": upstream / "maximize.xpm",
        "restore": upstream / "maximize.xpm",
    }
    for stem, source in button_sources.items():
        for state in ("A", "I"):
            for old in authentic.glob(f"{stem}{state}.*"):
                old.unlink()
            write_macos_caption_sprite(
                source,
                authentic / f"{stem}{state}.png",
                state,
            )
    for state in ("A", "I"):
        for old in authentic.glob(f"menuButton{state}.*"):
            old.unlink()
        write_macos_menu_button_sprite(
            authentic / f"menuButton{state}.png", state,
        )


def build_macos_icon_theme(repo_root: Path) -> Path:
    """Build Classic Silver, then KDE-Classic, before Windows fallbacks."""
    platinum = repo_root / "linux/.local/share/icons/Platinum9"
    resolved = run(platinum, "rev-parse", "HEAD").decode().strip()
    if resolved != PLATINUM9_COMMIT:
        raise SystemExit(
            f"Platinum9 commit mismatch: expected {PLATINUM9_COMMIT}, got {resolved}"
        )
    if run(platinum, "status", "--porcelain"):
        raise SystemExit(f"Platinum9 donor worktree is dirty: {platinum}")

    donor_dirs = {
        size: platinum / f"NineIcons/places/{size}"
        for size in (16, 32)
    }
    for size, donor_dir in donor_dirs.items():
        donor = donor_dir / "folder.png"
        if (
            not donor.is_file()
            or sha256(donor.read_bytes()) != PLATINUM9_FOLDER_SHA256[size]
        ):
            raise SystemExit(f"Platinum9 {size}px folder checksum mismatch")
        for name in ("user-trash.png", "user-trash-full.png"):
            trash = donor_dir / name
            if (
                not trash.is_file()
                or sha256(trash.read_bytes())
                != PLATINUM9_TRASH_SHA256[(size, name)]
            ):
                raise SystemExit(f"Platinum9 {size}px {name} checksum mismatch")
    charcoal = platinum / "Charcoal.ttf"
    if (
        not charcoal.is_file()
        or sha256(charcoal.read_bytes()) != PLATINUM9_CHARCOAL_SHA256
    ):
        raise SystemExit("Platinum9 Charcoal font checksum mismatch")
    font_target = repo_root / "linux/.config/redstone-9x/fonts/Charcoal.ttf"
    font_target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(charcoal, font_target)

    base = repo_root / "linux/.local/share/icons/KDE-1-Classic-Silver-Original"
    if not (base / "index.theme").is_file():
        raise SystemExit(f"KDE Classic Silver icon donor missing: {base}")
    kde_classic = repo_root / "linux/.local/share/icons/KDE-Classic"
    if not (kde_classic / "index.theme").is_file():
        raise SystemExit(f"KDE-Classic compatibility donor missing: {kde_classic}")
    chicago = repo_root / "linux/.local/share/icons/Chicago95"
    if not (chicago / "index.theme").is_file():
        raise SystemExit(f"Chicago95 icon fallback missing: {chicago}")
    beos_icons = repo_root / "linux/.local/share/icons/BeOS-r5-Icons"
    if not (beos_icons / "index.theme").is_file():
        raise SystemExit(f"BeOS icon donor missing: {beos_icons}")
    for donor, expected_commit, label in (
        (chicago, CHICAGO95_COMMIT, "Chicago95"),
        (beos_icons, BEOS_R5_ICONS_COMMIT, "BeOS-r5-Icons"),
    ):
        resolved = run(donor, "rev-parse", "HEAD").decode().strip()
        if resolved != expected_commit:
            raise SystemExit(
                f"{label} commit mismatch: expected {expected_commit}, got {resolved}"
            )
        if run(donor, "status", "--porcelain"):
            raise SystemExit(f"{label} donor worktree is dirty: {donor}")
    for size, expected in CHICAGO95_FIREFOX_SHA256.items():
        firefox = chicago / f"apps/{size}/firefox.png"
        if not firefox.is_file() or sha256(firefox.read_bytes()) != expected:
            raise SystemExit(f"Chicago95 {size}px Firefox checksum mismatch")
    communicator = beos_icons / "apps/32/netscape-communicator.png"
    if (
        not communicator.is_file()
        or sha256(communicator.read_bytes()) != BEOS_R5_COMMUNICATOR_SHA256
    ):
        raise SystemExit("BeOS-r5-Icons Communicator checksum mismatch")
    for category, name in CHICAGO95_REQUIRED_FALLBACKS:
        fallback = chicago / category / "16" / f"{name}.png"
        if not fallback.is_file():
            raise SystemExit(f"Chicago95 required fallback missing: {fallback}")
    target = repo_root / f"linux/.local/share/icons/{MACOS_ICON_THEME}"
    if target.exists() and not (target / GENERATED_MARKER).is_file():
        raise SystemExit(f"refusing to replace unmarked icon theme: {target}")
    if target.exists():
        shutil.rmtree(target)
    shutil.copytree(base, target)
    (target / GENERATED_MARKER).write_text(PLATINUM9_COMMIT + "\n", encoding="ascii")
    (target / ".gitattributes").write_text("** -whitespace\n", encoding="ascii")

    sizes = (16, 22, 24, 32, 48)
    for size in sizes:
        source_size = 16 if size == 16 else 32
        donors = sorted(donor_dirs[source_size].glob("folder*.png"))
        donors += [
            donor_dirs[source_size] / "user-trash.png",
            donor_dirs[source_size] / "user-trash-full.png",
        ]
        destination = target / f"{size}x{size}/places"
        destination.mkdir(parents=True, exist_ok=True)
        rendered = {}
        for donor in donors:
            with Image.open(donor) as original:
                icon = original.convert("RGBA")
            if icon.size != (size, size):
                icon = icon.resize((size, size), Image.Resampling.NEAREST)
            icon.save(destination / donor.name)
            rendered[donor.name] = icon
        for alias in ("trash.png", "kfm-trash.png"):
            rendered["user-trash.png"].save(destination / alias)
        for alias in ("trash-full.png", "kfm-fulltrash.png"):
            rendered["user-trash-full.png"].save(destination / alias)
        apps = target / f"{size}x{size}/apps"
        apps.mkdir(parents=True, exist_ok=True)
        rendered["user-trash.png"].save(apps / "kfm-trash.png")
        rendered["user-trash-full.png"].save(apps / "kfm-fulltrash.png")

    index = target / "index.theme"
    text = index.read_text(encoding="utf-8")
    text = re.sub(r"(?m)^Name=.*$", "Name=KDE 1 Classic Silver MacOS", text)
    text = re.sub(
        r"(?m)^Comment=.*$",
        "Comment=Classic Silver with KDE-Classic compatibility and Platinum9 folders.",
        text,
    )
    text = re.sub(r"(?m)^Inherits=.*$", "Inherits=KDE-Classic,hicolor", text)
    index.write_text(text, encoding="utf-8")

    categories = (
        "apps", "places", "actions", "devices", "filesystems", "mimes",
        "mimetypes", "status", "categories",
    )
    source_sizes = (16, 22, 24, 32, 48, 64)
    donor_roots = {
        "classic-silver": target,
        "kde-classic": kde_classic,
        "chicago95": chicago,
        "beos-r5": beos_icons,
    }

    def kde_icon(layer: str, name: str, requested: int) -> Image.Image:
        root = donor_roots.get(layer)
        if root is None:
            raise SystemExit(f"unsupported KDE alias donor layer: {layer}")
        candidates = []
        for source_size in source_sizes:
            for category_rank, category in enumerate(categories):
                source = (
                    root / f"{source_size}x{source_size}"
                    / category / f"{name}.png"
                )
                if source.is_file():
                    candidates.append(
                        (
                            abs(source_size - requested),
                            -source_size,
                            category_rank,
                            source,
                        )
                    )
            legacy_source = root / f"apps/{source_size}/{name}.png"
            if legacy_source.is_file():
                candidates.append(
                    (
                        abs(source_size - requested),
                        -source_size,
                        len(categories),
                        legacy_source,
                    )
                )
        if not candidates:
            raise SystemExit(f"KDE alias donor missing: {layer}/{name}")
        source = min(candidates)[-1]
        with Image.open(source) as original:
            return original.convert("RGBA")

    alias_lines = [
        "alias\tdonor_layer\tdonor_name\tdonor_epoch\trationale"
    ]
    seen_aliases = set()
    for alias, donor_layer, donor_name, donor_epoch, rationale in (
        MACOS_KDE_ALIAS_LEDGER
    ):
        if alias in seen_aliases:
            raise SystemExit(f"duplicate KDE semantic alias: {alias}")
        seen_aliases.add(alias)
        alias_lines.append(
            f"{alias}\t{donor_layer}\t{donor_name}\t{donor_epoch}\t{rationale}"
        )
        for size in sizes:
            icon = kde_icon(donor_layer, donor_name, size)
            if icon.size != (size, size):
                icon = icon.resize((size, size), Image.Resampling.NEAREST)
            destination = target / f"{size}x{size}/apps"
            destination.mkdir(parents=True, exist_ok=True)
            icon.save(destination / f"{alias}.png")
    (target / "ALIASES.tsv").write_text(
        "\n".join(alias_lines) + "\n",
        encoding="utf-8",
    )

    for cache in target.rglob("icon-theme.cache"):
        cache.unlink()
    (target / "PROVENANCE").write_text(
        "Base payload: complete KDE-1-Classic-Silver-Original clone\n"
        "Epoch boundary: no KDE HiColor payload is included\n"
        "KDE compatibility fallback: KDE-Classic, without overrides\n"
        "KDE semantic aliases: ALIASES.tsv records donor layer, name, epoch, and rationale\n"
        f"KDE semantic alias count: {len(MACOS_KDE_ALIAS_LEDGER)}\n"
        "KDE-Classic inherits Chicago95, then hicolor\n"
        "Chicago95 therefore fills only names absent from both KDE layers.\n"
        "Browser aliases: Silver mini.netscape (1997-09-12), pinned Chicago95 "
        "Firefox, and pinned BeOS-r5-Icons Netscape Communicator.\n"
        f"Chicago95 commit: {CHICAGO95_COMMIT}\n"
        f"BeOS-r5-Icons commit: {BEOS_R5_ICONS_COMMIT}\n"
        "Folder donors: Platinum9/NineIcons/places/{16,32}/folder*.png\n"
        "Trash donors: Platinum9 user-trash.png and user-trash-full.png\n"
        f"Platinum9 commit: {PLATINUM9_COMMIT}\n"
        f"16px SHA-256: {PLATINUM9_FOLDER_SHA256[16]}\n"
        f"32px SHA-256: {PLATINUM9_FOLDER_SHA256[32]}\n"
        "Generated 22px, 24px, and 48px: nearest-neighbour from 32px.\n"
        "Trash aliases: user-trash, trash, kfm-trash and full-state forms.\n",
        encoding="utf-8",
    )
    return target


def graft_kwm_assets(upstream: Path, icewm: Path, cp: configparser.ConfigParser) -> None:
    sections = {s.lower(): cp[s] for s in cp.sections()}
    border = sections.get("window border", {})
    title = sections.get("window titlebar", {})
    for key, targets in FRAME_MAP.items():
        src = upstream / border.get(key, "")
        if src.is_file():
            for target in targets:
                shutil.copy2(src, icewm / target)
    for key, targets in BUTTON_MAP.items():
        src = upstream / title.get(key, "")
        if src.is_file():
            for target in targets:
                shutil.copy2(src, icewm / target)
    for key, target in (
        ("TitlebarPixmapActive", "titleAB.xpm"),
        ("TitlebarPixmapInactive", "titleIB.xpm"),
    ):
        src = upstream / title.get(key, "")
        if src.is_file():
            shutil.copy2(src, icewm / target)
    panel = sections.get("panel", {})
    src = upstream / panel.get("background", "")
    if src.is_file():
        shutil.copy2(src, icewm / "taskbar/taskbarbg.xpm")


def render_wallpaper(upstream: Path, cp, pal, destination: Path) -> Path | None:
    sections = {s.lower(): cp[s] for s in cp.sections()}
    display = sections.get("display", {})
    lower = {k.lower(): v for k, v in display.items()}
    name = lower.get("wallpaper0") or lower.get("wallpaper")
    if not name or not (upstream / name).is_file():
        return None
    src = upstream / name
    mode = (lower.get("wallpapermode0") or lower.get("wallpapermode") or "center").lower()
    destination.parent.mkdir(parents=True, exist_ok=True)
    with Image.open(src) as image:
        image = image.convert("RGB")
        canvas = Image.new("RGB", (1920, 1080), pal["face"])
        if mode in ("tiled", "tile"):
            for y in range(0, 1080, image.height):
                for x in range(0, 1920, image.width):
                    canvas.paste(image, (x, y))
        elif mode in ("scaled", "scale", "stretched", "stretch"):
            canvas = image.resize((1920, 1080), Image.Resampling.LANCZOS)
        else:
            canvas.paste(image, ((1920 - image.width) // 2, (1080 - image.height) // 2))
        canvas.save(destination)
    return destination


def render_macos_blue_wallpaper(source: Path, destination: Path) -> Path:
    """Recolour the original 82px texture into a Mac OS 9 blue desktop."""
    if sha256(source.read_bytes()) != MACOS_DESKTOP_SHA256:
        raise SystemExit("MacOS desktop.jpg checksum mismatch")
    with Image.open(source) as original:
        texture = original.convert("RGB")
    luminance = texture.convert("L")
    mean = sum(luminance.getdata()) / (texture.width * texture.height)
    base = MACOS_BLUE_DESKTOP
    blue = Image.new("RGB", texture.size)
    pixels = blue.load()
    values = luminance.load()
    for y in range(texture.height):
        for x in range(texture.width):
            delta = round((values[x, y] - mean) * .28)
            pixels[x, y] = tuple(
                max(0, min(255, channel + delta)) for channel in base
            )
    canvas = Image.new("RGB", (1920, 1080), base)
    for y in range(0, canvas.height, blue.height):
        for x in range(0, canvas.width, blue.width):
            canvas.paste(blue, (x, y))
    destination.parent.mkdir(parents=True, exist_ok=True)
    canvas.save(destination)
    return destination


def render_macos_authentic_wallpaper(
    source_repo: Path,
    destination: Path,
) -> Path:
    """Tile KDE's corrected 79x83 ocean texture without scaling or blur."""
    payload = run(
        source_repo,
        "show",
        f"{PINNED_HEAD}:{MACOS_AUTHENTIC_WALLPAPER_PATH}",
    )
    if sha256(payload) != MACOS_AUTHENTIC_WALLPAPER_SHA256:
        raise SystemExit("MacOS authentic ocean01.jpg checksum mismatch")
    with Image.open(io.BytesIO(payload)) as original:
        tile = original.convert("RGB")
    if tile.size != (79, 83):
        raise SystemExit(
            f"MacOS authentic ocean01.jpg dimensions changed: {tile.size}"
        )
    canvas = Image.new("RGB", (1920, 1080))
    for y in range(0, canvas.height, tile.height):
        for x in range(0, canvas.width, tile.width):
            canvas.paste(tile, (x, y))
    destination.parent.mkdir(parents=True, exist_ok=True)
    canvas.save(destination)
    return destination


SOUND_MAP = {
    "startup": "startup.wav",
    "logoutmessage": "logout.wav",
    "windowclose": "windowClose.wav",
    "windowiconify": "windowMin.wav",
    "windowdeiconify": "windowRestore.wav",
    "windowmaximize": "windowMax.wav",
    "windowunmaximize": "windowRestore.wav",
    "windowtransnew": "windowOpen.wav",
}


def deploy_sounds(upstream: Path, cp, root: Path, slug: str) -> None:
    section = next((cp[s] for s in cp.sections() if s.lower() == "sounds"), None)
    if section is None:
        return
    target = root / f"linux/.local/share/sounds/schemes/{slug}/icewm"
    for key, value in section.items():
        source = upstream / value
        mapped = SOUND_MAP.get(key.lower())
        if source.is_file() and mapped:
            target.mkdir(parents=True, exist_ok=True)
            shutil.copy2(source, target / mapped)


def write_scheme(path: Path, *, title: str, date: str, icewm: str, gtk: str,
                 icons: str, pal, wallpaper: Path | None, sound: str,
                 kvantum: str | None = None,
                 desktop: tuple[int, int, int] | None = None,
                 gtk_font: str = "Sans 8") -> None:
    desktop = desktop or pal["face"]
    label = contrast(desktop)
    shadow = (255, 255, 255) if label == (0, 0, 0) else (0, 0, 0)
    lines = [
        f"# Redstone 9X — {title}; first introduced {date}.",
        f'SCHEME_TITLE="{title} [{date}]"',
        f'ICEWM_THEME="{icewm}"',
        f'GTK_THEME="{gtk}"',
        f'ICON_THEME="{icons}"',
        'CURSOR_THEME="Chicago95_Cursor_White"',
        'CURSOR_SIZE="24"',
        f'GTK_FONT="{gtk_font}"',
        f'DESKTOP_BG="{hx(desktop)}"',
        'DESKTOP_ICON_LABEL_MODE="box"',
        f'DESKTOP_ICON_LABEL_BACKGROUND="{hx(desktop)}"',
        f'DESKTOP_LABEL_FOREGROUND="{hx(label)}"',
        f'DESKTOP_LABEL_SHADOW="{hx(shadow)}"',
        f'SEL_BG="{hx(pal["select"])}"',
        f'SEL_FG="{hx(pal["select_text"])}"',
        f'QT6CT_COLORS="{path.stem}.conf"',
        'QT_STYLE="kvantum"',
        f'KVANTUM_THEME="{kvantum or gtk}"',
        f'SOUND_SCHEME="{sound}"',
        f'FOX_BASE="{hx(pal["face"])}"',
        f'FOX_SEL_BG="{hx(pal["select"])}"',
        f'FOX_SEL_FG="{hx(pal["select_text"])}"',
        f'FOX_MENU_BG="{hx(pal["select"])}"',
        f'FOX_MENU_FG="{hx(pal["select_text"])}"',
    ]
    if wallpaper:
        lines += [
            f'WALLPAPER="$HOME/{wallpaper.as_posix()}"',
            'WALLPAPER_MODE="center"',
        ]
    lines.append(
        'ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;'
        'TaskBarShowNetStatus=1;NetDevice=\\"wlan0 eth0\\";'
        'TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;'
        'ClockCommand=\\"i2kcal\\";CPUStatusCommand=\\"dbus-run-session '
        'mate-system-monitor\\";NetStatusCommand=\\"netactview\\";'
        'TaskBarShowWorkspaces=1"'
    )
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")


def export_catalog(repo: Path, output: Path) -> int:
    log = run(
        repo, "log", "--reverse", "--date=short",
        "--format=@@%H%x09%ad", "--diff-filter=A", "--name-only", PINNED_HEAD,
    ).decode("utf-8", "surrogateescape")
    commit = date = None
    first: dict[str, tuple[str, str]] = {}
    for line in log.splitlines():
        if line.startswith("@@"):
            commit, date = line[2:].split("\t", 1)
        elif line and commit and date:
            lower = line.lower()
            suffix = Path(lower).suffix
            if suffix in CATALOG_EXTENSIONS or lower.endswith(".tar.gz"):
                first.setdefault(line, (commit, date))
    manifest = ["date\tcommit\tsha256\tpath"]
    for original, (item_commit, item_date) in sorted(first.items()):
        try:
            payload = run(repo, "show", f"{item_commit}:{original}")
        except subprocess.CalledProcessError:
            continue
        target = output / "asset-catalog" / item_date / original
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(payload)
        manifest.append(f"{item_date}\t{item_commit}\t{sha256(payload)}\t{original}")
    (output / "FIRST-APPEARANCE-ASSETS.tsv").write_text(
        "\n".join(manifest) + "\n", encoding="utf-8",
    )
    return len(manifest) - 1


def same_tree(a: Path, b: Path) -> bool:
    def digest(root):
        entries = []
        for p in sorted(root.rglob("*")):
            if p.is_file():
                entries.append((p.relative_to(root).as_posix(), sha256(p.read_bytes())))
        return entries
    return a.exists() and digest(a) == digest(b)


def install_tree(built: Path, target: Path) -> str:
    if same_tree(target, built):
        return "unchanged"
    if target.exists() and not (target / GENERATED_MARKER).is_file():
        raise SystemExit(f"refusing to replace unmarked path: {target}")
    if target.exists():
        shutil.rmtree(target)
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.move(str(built), target)
    return "updated"


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("source_repo", type=Path)
    parser.add_argument("--repo-root", type=Path, default=Path.home() / "DotCortex")
    parser.add_argument("--skip-catalog", action="store_true")
    args = parser.parse_args()
    source = args.source_repo.expanduser().resolve()
    root = args.repo_root.expanduser().resolve()
    verify_commit(source, PINNED_HEAD)
    color_slugs = {spec.slug for spec in COLORS}
    theme_slugs = {spec.slug for spec in THEMES}
    if set(COLOR_WIDGET_STYLES) != color_slugs:
        raise SystemExit("COLOR_WIDGET_STYLES must cover every color exactly")
    if set(THEME_WIDGET_STYLES) != theme_slugs:
        raise SystemExit("THEME_WIDGET_STYLES must cover every theme exactly")

    with tempfile.TemporaryDirectory(prefix="kde1-history-") as td:
        built = Path(td) / "history"
        built.mkdir()
        (built / GENERATED_MARKER).write_text(PINNED_HEAD + "\n", encoding="ascii")
        (built / ".gitattributes").write_text(
            "** -whitespace\n"
            "asset-catalog/** -text -diff\n"
            "colors/**/*.kcsrc -text -diff\n"
            "themes/**/upstream/** -text -diff\n",
            encoding="ascii",
        )
        catalog_count = 0 if args.skip_catalog else export_catalog(source, built)
        ledger = ["kind\tname\tdate\tcommit\ttree\tsha256\tpath\twidget_style"]
        build_macos_icon_theme(root)

        for spec in COLORS:
            verify_commit(source, spec.commit, spec.tree)
            payload = run(source, "show", f"{spec.commit}:{spec.path}")
            if sha256(payload) != spec.sha256:
                raise SystemExit(f"{spec.name}: color checksum mismatch")
            item = built / "colors" / spec.slug
            item.mkdir(parents=True)
            original = item / Path(spec.path).name
            original.write_bytes(payload)
            cp, values = parse_ini(original)
            pal = palette(values)
            dp = item / f"{spec.slug}.dp"
            write_dp(dp, pal, pal["face"])
            gtk = f"KDE1-Color-{spec.slug}"
            widget_style = COLOR_WIDGET_STYLES[spec.slug]
            convert_gtk(
                root, dp, gtk, f"kde1-color-{spec.slug}", widget_style, pal,
            )
            icewm = f"KDE1-Color-{spec.slug}"
            icewm_dir = root / "linux/.icewm/themes" / icewm
            if icewm_dir.exists():
                shutil.rmtree(icewm_dir)
            shutil.copytree(root / "linux/.icewm/themes/KDE-1-Alpha", icewm_dir)
            append_icewm_colors(icewm_dir / "default.theme",
                                f"KDE 1 Color {spec.name}", pal)
            mark_payload(icewm_dir)
            scheme = root / f"linux/.config/redstone-9x/schemes/kde1-color-{spec.slug}.scheme"
            write_scheme(
                scheme, title=f"KDE 1 Color — {spec.name}", date=spec.date,
                icewm=icewm, gtk=gtk, icons=chronological_icon(spec.date),
                pal=pal, wallpaper=None, sound="kde-0.1",
            )
            write_qt(root / f"linux/.config/redstone-9x/qt6ct/colors/{scheme.stem}.conf", pal)
            (item / "PROVENANCE").write_text(
                f"Name: {spec.name}\nFirst introduced: {spec.date}\n"
                f"Commit: {spec.commit}\nTree: {spec.tree}\n"
                f"SHA-256: {spec.sha256}\nPath: {spec.path}\n"
                f"Widget style: {widget_style}\n",
                encoding="utf-8",
            )
            ledger.append(f"color\t{spec.name}\t{spec.date}\t{spec.commit}\t"
                          f"{spec.tree}\t{spec.sha256}\t{spec.path}\t{widget_style}")

        for spec in THEMES:
            item = built / "themes" / spec.slug
            upstream = item / "upstream"
            upstream.mkdir(parents=True)
            extract_theme(source, spec, upstream)
            themerc = next(upstream.glob("*.themerc"), None)
            if themerc is None:
                raise SystemExit(f"{spec.name}: no .themerc in earliest bundle")
            cp, values = parse_ini(themerc)
            pal = palette(values)
            dp = item / f"{spec.slug}.dp"
            write_dp(dp, pal, pal["face"])
            gtk = f"KDE1-Theme-{spec.slug}"
            widget_style = THEME_WIDGET_STYLES[spec.slug]
            convert_gtk(
                root, dp, gtk, f"kde1-theme-{spec.slug}", widget_style, pal,
            )
            scheme_gtk = gtk
            scheme_icons = chronological_icon(spec.date)
            scheme_kvantum = None
            if spec.slug == "macos":
                scheme_gtk = "PLATINUM"
                scheme_icons = MACOS_ICON_THEME
                scheme_kvantum = build_macos_platinum_kvantum(root, gtk)
            icewm = f"KDE1-Theme-{spec.slug}"
            icewm_dir = root / "linux/.icewm/themes" / icewm
            if icewm_dir.exists():
                shutil.rmtree(icewm_dir)
            if spec.slug == "macos":
                build_macos_icewm(root, icewm_dir, pal)
            else:
                shutil.copytree(root / "linux/.icewm/themes/KDE-1-Alpha", icewm_dir)
            append_icewm_colors(icewm_dir / "default.theme",
                                f"KDE 1 Theme {spec.name}", pal)
            if spec.slug == "macos":
                override_theme_values(
                    icewm_dir / "default.theme",
                    {'ColorActiveTaskBarAppText': '"#000000"'},
                )
            if spec.slug != "macos":
                graft_kwm_assets(upstream, icewm_dir, cp)
            wallpaper_file = render_wallpaper(
                upstream, cp, pal, icewm_dir / f"backgrounds/{spec.slug}-1920x1080.png",
            )
            mark_payload(icewm_dir)
            wallpaper = (
                Path(f".icewm/themes/{icewm}/backgrounds/{wallpaper_file.name}")
                if wallpaper_file else None
            )
            if spec.slug == "macos":
                blue_wallpaper_file = render_macos_blue_wallpaper(
                    upstream / "desktop.jpg",
                    icewm_dir / "backgrounds/macos-blue-texture-1920x1080.png",
                )
                wallpaper = Path(
                    f".icewm/themes/{icewm}/backgrounds/"
                    f"{blue_wallpaper_file.name}"
                )
            scheme_id = f"kde1-theme-{spec.slug}"
            deploy_sounds(upstream, cp, root, scheme_id)
            scheme = root / f"linux/.config/redstone-9x/schemes/{scheme_id}.scheme"
            scheme_title = (
                "Redstone 9X KDE Alpha MacOS Retromod"
                if spec.slug == "macos"
                else f"KDE 1 Theme — {spec.name}"
            )
            write_scheme(
                scheme, title=scheme_title, date=spec.date,
                icewm=icewm, gtk=scheme_gtk, icons=scheme_icons,
                pal=pal, wallpaper=wallpaper, sound=scheme_id,
                kvantum=scheme_kvantum,
                desktop=MACOS_BLUE_DESKTOP if spec.slug == "macos" else None,
                gtk_font=MACOS_GTK_FONT if spec.slug == "macos" else "Sans 8",
            )
            write_qt(root / f"linux/.config/redstone-9x/qt6ct/colors/{scheme.stem}.conf", pal)
            if spec.slug == "macos":
                if wallpaper_file is None:
                    raise SystemExit("MacOS: original wallpaper was not rendered")
                authentic_icewm = "KDE1-Theme-macos-authentic"
                authentic_dir = root / "linux/.icewm/themes" / authentic_icewm
                if authentic_dir.exists():
                    shutil.rmtree(authentic_dir)
                build_macos_authentic_icewm(
                    icewm_dir, authentic_dir, upstream,
                )
                authentic_wallpaper_file = render_macos_authentic_wallpaper(
                    source,
                    authentic_dir
                    / "backgrounds/ocean01-tiled-1920x1080.png",
                )
                append_icewm_colors(
                    authentic_dir / "default.theme",
                    "KDE 1 Theme MacOS Authentic",
                    pal,
                )
                override_theme_values(
                    authentic_dir / "default.theme",
                    {'ColorActiveTaskBarAppText': '"#000000"'},
                )
                mark_payload(authentic_dir)
                authentic_scheme_id = "kde1-theme-macos-authentic"
                authentic_scheme = (
                    root
                    / "linux/.config/redstone-9x/schemes"
                    / f"{authentic_scheme_id}.scheme"
                )
                authentic_wallpaper = Path(
                    f".icewm/themes/{authentic_icewm}/backgrounds/"
                    f"{authentic_wallpaper_file.name}"
                )
                write_scheme(
                    authentic_scheme,
                    title="KDE 1 Theme — MacOS Authentic",
                    date=spec.date,
                    icewm=authentic_icewm,
                    gtk=gtk,
                    icons=MACOS_ICON_THEME,
                    pal=pal,
                    wallpaper=authentic_wallpaper,
                    sound=scheme_id,
                    gtk_font=MACOS_GTK_FONT,
                )
                write_qt(
                    root
                    / "linux/.config/redstone-9x/qt6ct/colors"
                    / f"{authentic_scheme.stem}.conf",
                    pal,
                )
                (item / "AUTHENTIC-CONVERSION").write_text(
                    "Variant: KDE 1 Theme — MacOS Authentic\n"
                    "Caption grooves/buttons: original 1998 MacOS bundle\n"
                    "Caption layout: application icon at left; centered title; "
                    "min | max | close at right\n"
                    "Caption control beds: solid #CECECE active widget face\n"
                    f"System font: bundled {MACOS_FONT_FAMILY}\n"
                    "Lower frame: one-pixel colour frame; no Tosh bottom bevel\n"
                    f"Icons: {MACOS_ICON_THEME}\n"
                    "Wallpaper: KDE pics/wallpapers/ocean01.jpg from pinned "
                    "head, tiled at native 79x83 into 1920x1080\n"
                    f"Wallpaper SHA-256: {MACOS_AUTHENTIC_WALLPAPER_SHA256}\n",
                    encoding="utf-8",
                )
            (item / "PROVENANCE").write_text(
                f"Name: {spec.name}\nFirst introduced: {spec.date}\n"
                f"Commit: {spec.commit}\nTree: {spec.tree}\n"
                f"Source kind: {spec.source_kind}\nSHA-256: {spec.sha256}\n"
                f"Path: {spec.path}\nWidget style: {widget_style}\n"
                + (
                    "IceWM conversion donor: Tosh 0.2 frame geometry; "
                    "KDE-1-Alpha taskbar chrome\n"
                    "Retromod widgets: PLATINUM GTK; palette-matched "
                    f"{MACOS_PLATINUM_KVANTUM} Qt\n"
                    f"Retromod icons: {MACOS_ICON_THEME}\n"
                    f"Mac system font: bundled {MACOS_FONT_FAMILY}; "
                    f"SHA-256 {PLATINUM9_CHARCOAL_SHA256}\n"
                    "Original wallpaper: upstream/desktop.jpg (82x82 JPEG)\n"
                    f"Original wallpaper SHA-256: {MACOS_DESKTOP_SHA256}\n"
                    "Original MacOS.themerc: Wallpaper0=desktop.jpg; "
                    "WallpaperMode0=Tiled\n"
                    "Retromod wallpaper: original desktop.jpg texture "
                    "recoloured Mac OS 9 blue and tiled at 1920x1080\n"
                    "Authentic wallpaper override: pinned KDE "
                    f"{MACOS_AUTHENTIC_WALLPAPER_PATH}, native 79x83 tile; "
                    f"SHA-256 {MACOS_AUTHENTIC_WALLPAPER_SHA256}\n"
                    if spec.slug == "macos" else ""
                ),
                encoding="utf-8",
            )
            ledger.append(f"theme\t{spec.name}\t{spec.date}\t{spec.commit}\t"
                          f"{spec.tree}\t{spec.sha256}\t{spec.path}\t{widget_style}")

        base_pal = {
            "face": (192, 192, 192), "text": (0, 0, 0),
            "select": (0, 0, 128), "select_text": (255, 255, 255),
            "active": (0, 0, 0), "active_text": (255, 255, 255),
            "inactive": (128, 128, 128), "inactive_text": (192, 192, 192),
            "window": (255, 255, 255), "window_text": (0, 0, 0),
        }
        for title, slug, date, icons in ICON_EPOCHS:
            scheme = root / f"linux/.config/redstone-9x/schemes/kde1-icons-{slug}.scheme"
            write_scheme(
                scheme, title=f"KDE 1 Icons — {title}", date=date,
                icewm="KDE-1-Alpha", gtk="Motif95", icons=icons,
                pal=base_pal,
                wallpaper=Path(".icewm/themes/KDE-1-Alpha/backgrounds/KDE_1_Alpha.png"),
                sound="kde-0.1",
            )
            write_qt(root / f"linux/.config/redstone-9x/qt6ct/colors/{scheme.stem}.conf",
                     base_pal)

        (built / "FIRST-INTRODUCTIONS.tsv").write_text(
            "\n".join(ledger) + "\n", encoding="utf-8",
        )
        status = install_tree(built, root / HISTORY_ROOT)
    print(
        f"redstone-9x-kde1-history-import: status={status} "
        f"colors={len(COLORS)} themes={len(THEMES)} "
        f"icon_epochs={len(ICON_EPOCHS)} catalog_assets={catalog_count}"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
