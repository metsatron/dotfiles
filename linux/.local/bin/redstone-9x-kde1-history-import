def run(repo: Path, *args: str) -> bytes:
    return subprocess.run(
        ["git", "-C", str(repo), *args],
        check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
    ).stdout


def sha256(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def verify_commit(repo: Path, commit: str, tree: str | None = None) -> None:
    resolved = run(repo, "rev-parse", "--verify", f"{commit}^{{commit}}").decode().strip()
    if resolved != commit:
        raise SystemExit(f"commit mismatch: expected {commit}, got {resolved}")
    if tree:
        actual = run(repo, "show", "-s", "--format=%T", commit).decode().strip()
        if actual != tree:
            raise SystemExit(f"{commit}: tree mismatch: expected {tree}, got {actual}")


def safe_tar_members(tf: tarfile.TarFile):
    for member in tf.getmembers():
        p = PurePosixPath(member.name)
        if p.is_absolute() or ".." in p.parts or member.issym() or member.islnk():
            raise SystemExit(f"unsafe historical archive member: {member.name}")
        yield member


def extract_theme(repo: Path, spec: ThemeSpec, destination: Path) -> None:
    verify_commit(repo, spec.commit, spec.tree)
    if spec.source_kind == "tar":
        payload = run(repo, "show", f"{spec.commit}:{spec.path}")
        if sha256(payload) != spec.sha256:
            raise SystemExit(f"{spec.name}: tarball checksum mismatch")
        with tarfile.open(fileobj=io.BytesIO(payload), mode="r:gz") as tf:
            tf.extractall(destination, members=safe_tar_members(tf))
    else:
        payload = run(repo, "archive", "--format=tar", spec.commit, spec.path)
        if sha256(payload) != spec.sha256:
            raise SystemExit(f"{spec.name}: git archive checksum mismatch")
        with tempfile.TemporaryDirectory(prefix="kde1-theme-") as td:
            tmp = Path(td)
            with tarfile.open(fileobj=io.BytesIO(payload), mode="r:") as tf:
                tf.extractall(tmp, members=safe_tar_members(tf))
            shutil.copytree(tmp / spec.path, destination, dirs_exist_ok=True)


def color_value(value: str | None, fallback: tuple[int, int, int]) -> tuple[int, int, int]:
    if not value:
        return fallback
    value = value.strip()
    named = {"black": (0, 0, 0), "white": (255, 255, 255)}
    if value.lower() in named:
        return named[value.lower()]
    if re.fullmatch(r"#[0-9a-fA-F]{6}", value):
        return tuple(int(value[i:i + 2], 16) for i in (1, 3, 5))
    if re.fullmatch(r"\d+\s*,\s*\d+\s*,\s*\d+", value):
        return tuple(max(0, min(255, int(x))) for x in value.split(","))
    return fallback


def parse_ini(path: Path) -> tuple[configparser.ConfigParser, dict[str, str]]:
    cp = configparser.ConfigParser(strict=False, interpolation=None)
    cp.optionxform = str
    cp.read(path, encoding="latin-1")
    section = next((cp[s] for s in cp.sections() if s.lower() in ("colors", "color scheme")), {})
    return cp, {k.lower(): v for k, v in section.items()}


def palette(values: dict[str, str]) -> dict[str, tuple[int, int, int]]:
    def pick(keys, fallback):
        return color_value(next((values[k] for k in keys if k in values), None), fallback)
    return {
        "face": pick(("backgroundcolor", "background"), (192, 192, 192)),
        "text": pick(("textcolor", "foreground"), (0, 0, 0)),
        "select": pick(("selectcolor", "selectbackground"), (0, 0, 128)),
        "select_text": pick(("selecttextcolor", "selectforeground"), (255, 255, 255)),
        "active": pick(("activetitlebarcolor", "activebackground"), (0, 0, 128)),
        "active_text": pick(("activetitletextcolor", "activeforeground"), (255, 255, 255)),
        "inactive": pick(("inactivetitlebarcolor", "inactivebackground"), (128, 128, 128)),
        "inactive_text": pick(("inactivetitletextcolor", "inactiveforeground"), (192, 192, 192)),
        "window": pick(("windowcolor", "windowbackground"), (255, 255, 255)),
        "window_text": pick(("windowtextcolor", "windowforeground"), (0, 0, 0)),
    }


def hx(rgb: tuple[int, int, int]) -> str:
    return "#%02X%02X%02X" % rgb


def contrast(rgb: tuple[int, int, int]) -> tuple[int, int, int]:
    lum = 0.2126 * rgb[0] + 0.7152 * rgb[1] + 0.0722 * rgb[2]
    return (0, 0, 0) if lum >= 140 else (255, 255, 255)


def chronological_icon(date: str) -> str:
    return "KDE-1-HiColor-Original" if date >= "1999-08-01" else "KDE-1-Classic-Silver-Original"


def write_dp(path: Path, pal: dict[str, tuple[int, int, int]], desktop) -> None:
    sets = (pal["active"], pal["face"], pal["face"], pal["window"],
            pal["face"], pal["face"], pal["select"], desktop)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(
        "".join("#" + "".join(f"{c:02x}00" for c in rgb) + "\n" for rgb in sets),
        encoding="ascii",
    )


def recolor_classic_gtk(
    repo_root: Path,
    name: str,
    pal: dict[str, tuple[int, int, int]],
) -> None:
    """Clone Windows-95 controls while retaining the historical KDE palette."""
    source = repo_root / "linux/.themes/Windows-95"
    target = repo_root / "linux/.themes" / name
    if not source.is_dir():
        raise SystemExit(f"Windows-Classic GTK donor missing: {source}")
    if target.exists():
        shutil.rmtree(target)
    target.mkdir(parents=True)
    for dirname in ("gtk-2.0", "gtk-3.0", "gtk-4.0"):
        if (source / dirname).is_dir():
            shutil.copytree(source / dirname, target / dirname)
    for filename in ("index.theme", "LICENSE", "README.md"):
        if (source / filename).is_file():
            shutil.copy2(source / filename, target / filename)

    face = pal["face"]
    select = pal["select"]
    text = pal["text"]
    window = pal["window"]
    face_plus = tuple(min(255, channel + 3) for channel in face)
    light = tuple(round(channel + (255 - channel) * .35) for channel in face)
    color_map = {
        (0xC0, 0xC0, 0xC0): face,
        (0xC3, 0xC3, 0xC3): face_plus,
        (0xD4, 0xD0, 0xC8): face,
        (0xDF, 0xDF, 0xDF): light,
        (0xE0, 0xE0, 0xE0): light,
        (0x00, 0x00, 0x80): select,
    }
    text_extensions = {".css", ".rc", ".svg", ".ini", ".theme"}
    for path in target.rglob("*"):
        if not path.is_file() or path.is_symlink():
            continue
        if (
            path.suffix.lower() in text_extensions
            or path.name.startswith("gtkrc")
        ):
            content = path.read_text(encoding="latin-1")
            for old, new in color_map.items():
                old_hex = "#%02x%02x%02x" % old
                new_hex = hx(new)
                content = re.sub(re.escape(old_hex), new_hex, content,
                                 flags=re.IGNORECASE)
                spaced = f"{old[0]}, {old[1]}, {old[2]}"
                compact = f"{old[0]},{old[1]},{old[2]}"
                content = content.replace(spaced, f"{new[0]}, {new[1]}, {new[2]}")
                content = content.replace(compact, f"{new[0]},{new[1]},{new[2]}")
            content = content.replace("Windows-95", name)
            content = content.replace("Windows 95", name)
            content = re.sub(
                r"((?:fg|text)_color\s*[:=]\s*)#000000",
                lambda match: match.group(1) + hx(text),
                content,
                flags=re.IGNORECASE,
            )
            content = re.sub(
                r"((?:base|unfocused_base)_color\s*[:=]\s*)#(?:fff|ffffff)",
                lambda match: match.group(1) + hx(window),
                content,
                flags=re.IGNORECASE,
            )
            path.write_text(content, encoding="latin-1")
        elif path.suffix.lower() == ".png":
            with Image.open(path) as original:
                image = original.convert("RGBA")
            pixels = image.load()
            changed = False
            for y in range(image.height):
                for x in range(image.width):
                    red, green, blue, alpha = pixels[x, y]
                    replacement = color_map.get((red, green, blue))
                    if replacement is not None:
                        pixels[x, y] = (*replacement, alpha)
                        changed = True
            if changed:
                image.save(path)


def convert_gtk(
    repo_root: Path,
    dp: Path,
    name: str,
    slug: str,
    widget_style: str,
    pal: dict[str, tuple[int, int, int]],
) -> None:
    if widget_style not in {"classic", "motif"}:
        raise SystemExit(f"{slug}: unsupported widget style {widget_style!r}")
    helper = repo_root / "linux/.local/bin/redstone-9x-cde-convert"
    subprocess.run(
        [str(helper), "--kde98", str(dp), name, slug, "", str(repo_root)],
        check=True,
    )
    if widget_style == "classic":
        recolor_classic_gtk(repo_root, name, pal)
    mark_payload(repo_root / "linux/.themes" / name)
    mark_payload(repo_root / "linux/.config/Kvantum" / name)


def build_macos_platinum_kvantum(repo_root: Path, source_name: str) -> str:
    """Fork the converted Mac Qt theme onto the PLATINUM widget palette."""
    source = repo_root / "linux/.config/Kvantum" / source_name
    target = repo_root / "linux/.config/Kvantum" / MACOS_PLATINUM_KVANTUM
    if not source.is_dir():
        raise SystemExit(f"MacOS Kvantum donor missing: {source}")
    if target.exists():
        legacy_first_pass = {
            path.name for path in target.iterdir()
        } == {
            ".gitattributes",
            f"{MACOS_PLATINUM_KVANTUM}.kvconfig",
            f"{MACOS_PLATINUM_KVANTUM}.svg",
        }
        if not (target / GENERATED_MARKER).is_file() and not legacy_first_pass:
            raise SystemExit(f"refusing to replace unmarked Kvantum theme: {target}")
        shutil.rmtree(target)
    shutil.copytree(source, target)

    source_stem = source_name
    target_stem = MACOS_PLATINUM_KVANTUM
    for extension in (".kvconfig", ".svg"):
        old = target / f"{source_stem}{extension}"
        new = target / f"{target_stem}{extension}"
        old.rename(new)
        text = new.read_text(encoding="utf-8")
        text = text.replace(source_stem, target_stem)
        # PLATINUM's declared GTK palette: face #dfdfdf, white/light
        # highlights, #a1a2a1 shadow, and pale-lavender selection.
        replacements = {
            "#cecece": "#dfdfdf",
            "#afafaf": "#ffffff",
            "#a6a6a6": "#efefef",
            "#efebe7": "#dfdfdf",
            "#ebe0da": "#ffffff",
            "#e7deda": "#efefef",
            "#6e6e6e": "#a1a2a1",
            "#676767": "#a1a2a1",
            "#eeeeee": "#efefef",
            "#b5b5b5": "#ceceff",
        }
        for old_color, new_color in replacements.items():
            text = re.sub(
                re.escape(old_color), new_color, text, flags=re.IGNORECASE,
            )
        new.write_text(text, encoding="utf-8")
    mark_payload(target)
    (target / GENERATED_MARKER).write_text(
        f"{PINNED_HEAD}\nsource={source_name}\n",
        encoding="ascii",
    )
    return target_stem


def mark_payload(path: Path) -> None:
    """Keep imported/donor bytes exact without weakening source checks."""
    (path / ".gitattributes").write_text("** -whitespace\n", encoding="ascii")


def write_qt(path: Path, pal: dict[str, tuple[int, int, int]]) -> None:
    def argb(rgb):
        return "#ff%02x%02x%02x" % rgb
    face, fg = pal["face"], pal["text"]
    light = tuple(round(c + (255 - c) * .55) for c in face)
    mid = tuple(round(c * .72) for c in face)
    dark = tuple(round(c * .48) for c in face)
    roles = [
        fg, face, (255, 255, 255), light, dark, mid, fg, (255, 255, 255),
        fg, pal["window"], face, (0, 0, 0), pal["select"], pal["select_text"],
        (0, 0, 255), (128, 0, 128), light, (0, 0, 0), (255, 255, 225),
        (0, 0, 0), dark, pal["select"],
    ]
    disabled = list(roles)
    for idx in (0, 6, 8, 12, 21):
        disabled[idx] = dark
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(
        "[ColorScheme]\n"
        + "active_colors=" + ", ".join(map(argb, roles)) + "\n"
        + "disabled_colors=" + ", ".join(map(argb, disabled)) + "\n"
        + "inactive_colors=" + ", ".join(map(argb, roles)) + "\n",
        encoding="ascii",
    )


def append_icewm_colors(path: Path, title: str, pal) -> None:
    text = path.read_text(encoding="latin-1")
    block = f"""

# ==== KDE 1 original first-appearance conversion ====
ThemeDescription="{title}"
ColorNormalButton="{hx(pal['face'])}"
ColorNormalButtonText="{hx(pal['text'])}"
ColorActiveButton="{hx(pal['face'])}"
ColorActiveButtonText="{hx(pal['text'])}"
ColorNormalTitleBar="{hx(pal['inactive'])}"
ColorNormalTitleBarText="{hx(pal['inactive_text'])}"
ColorActiveTitleBar="{hx(pal['active'])}"
ColorActiveTitleBarText="{hx(pal['active_text'])}"
ColorActiveBorder="{hx(pal['face'])}"
ColorNormalBorder="{hx(pal['face'])}"
ColorDialog="{hx(pal['face'])}"
ColorListBox="{hx(pal['window'])}"
ColorListBoxText="{hx(pal['window_text'])}"
ColorListBoxSelection="{hx(pal['select'])}"
ColorListBoxSelectionText="{hx(pal['select_text'])}"
ColorNormalMenu="{hx(pal['face'])}"
ColorActiveMenuItem="{hx(pal['select'])}"
ColorNormalMenuItemText="{hx(pal['text'])}"
ColorActiveMenuItemText="{hx(pal['select_text'])}"
ColorDefaultTaskBar="{hx(pal['face'])}"
ColorNormalTaskBarApp="{hx(pal['face'])}"
ColorActiveTaskBarApp="{hx(pal['select'])}"
ColorNormalTaskBarAppText="{hx(pal['text'])}"
ColorActiveTaskBarAppText="{hx(pal['select_text'])}"
ColorClock="{hx(pal['face'])}"
ColorClockText="{hx(pal['text'])}"
"""
    path.write_text(text + block, encoding="latin-1")


FRAME_MAP = {
