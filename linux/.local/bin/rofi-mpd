#!/usr/bin/env bash
P="$HOME/.guix-extra-profiles/core/core"; [ -r "$P/etc/profile" ] && . "$P/etc/profile"
set -euo pipefail
R() { rofi -dmenu -i -p "$1"; }
now=$(mpc current 2>/dev/null || true)
pick=$(printf '%s\n' "⏯ Play/Pause${now:+  —  $now}" "⏭ Next" "⏮ Previous" "🎵 Songs" "📜 Playlists" "🔀 Shuffle queue" "🧹 Clear queue" | R "mpd")
case "$pick" in
  ⏯*) mpc toggle >/dev/null ;;
  ⏭*) mpc next >/dev/null ;;
  ⏮*) mpc prev >/dev/null ;;
  🎵*) song=$(mpc listall | R "song") && [ -n "$song" ] && { mpc insert "$song"; mpc play >/dev/null; } ;;
  📜*) pl=$(mpc lsplaylists | R "playlist") && [ -n "$pl" ] && { mpc clear -q; mpc load "$pl"; mpc play >/dev/null; } ;;
  🔀*) mpc shuffle >/dev/null ;;
  🧹*) mpc clear >/dev/null ;;
esac
