#!/usr/bin/env bash
set -euo pipefail

SANCTUARY="sanctuary-redstone-9x"
GUESTS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/dotcortex/guests"
GUEST_HOME="${GUESTS_DIR}/${SANCTUARY}/home"
WINEPREFIX="${WINEPREFIX:-${GUEST_HOME}/.wine-redstone}"
STAGE="${GUESTS_DIR}/${SANCTUARY}/wep"
DEST="${WINEPREFIX}/drive_c/BOWEP"
WINDIR="${WINEPREFIX}/drive_c/windows"
ICONDIR="${GUEST_HOME}/.local/share/icons"
MARKER="${DEST}/.dotcortex-wep-complete"
WINE_PROFILE="${HOME}/.guix-extra-profiles/room-windows-compat/room-windows-compat"

# The disk image is operator-supplied and never vendored: these are copyrighted
# Microsoft binaries and DotCortex is public.
IMG="${WEP_IMG:-${HOME}/Downloads/wep_best-of/wep_best-of.img}"

FORCE=0
[[ "${1:-}" == "--force" ]] && FORCE=1

if [[ -f "${MARKER}" && "${FORCE}" -eq 0 ]]; then
  echo "redstone-9x-wep: already provisioned (${DEST}) — use --force to redo"
  exit 0
fi

if [[ ! -f "${IMG}" ]]; then
  echo "redstone-9x-wep: disk image not found: ${IMG}"
  echo "  Supply one with WEP_IMG=/path/to/wep_best-of.img, or fetch the"
  echo "  Internet Archive item 'wep_best-of'. Skipping."
  exit 0
fi

if [[ ! -d "${WINEPREFIX}" ]]; then
  echo "redstone-9x-wep: Wine prefix missing: ${WINEPREFIX}" >&2
  echo "  Launch the sanctuary once so the prefix initialiser runs." >&2
  exit 1
fi

# python3 that actually works. The guest ships a broken shim, and this script may
# be invoked from an environment that inherited it, so probe rather than trust.
find_python() {
  local c
  for c in "${HOME}/.guix-extra-profiles/desktop-common/desktop-common/bin/python3" \
           "${HOME}/.guix-extra-profiles/core/core/bin/python3" \
           python3; do
    "${c}" -c 'import struct' >/dev/null 2>&1 || continue
    printf '%s\n' "${c}"
    return 0
  done
  return 1
}

PY="$(find_python)" || { echo "redstone-9x-wep: no working python3 found" >&2; exit 1; }

mkdir -p "${STAGE}" "${DEST}" "${ICONDIR}"

echo "redstone-9x-wep: reading ${IMG}…"
"${PY}" - "${IMG}" "${STAGE}/expanded" <<'PYWEP'
"""Read a FAT12 floppy image and expand its SZDD-compressed members.

Deliberately dependency-free: mtools and msexpand are not declared anywhere in
DotCortex, and this must work on any machine that can run the sanctuary. Both
formats are simple and fully specified, so implementing them is cheaper and more
portable than adding two packages.
"""
import os
import struct
import sys

img_path, out_dir = sys.argv[1], sys.argv[2]
data = open(img_path, "rb").read()

# --- FAT12 -----------------------------------------------------------------
bps = struct.unpack_from("<H", data, 0x0B)[0]      # bytes per sector
spc = data[0x0D]                                   # sectors per cluster
reserved = struct.unpack_from("<H", data, 0x0E)[0]
nfats = data[0x10]
root_entries = struct.unpack_from("<H", data, 0x11)[0]
spf = struct.unpack_from("<H", data, 0x16)[0]      # sectors per FAT

fat_start = reserved * bps
root_start = fat_start + nfats * spf * bps
root_bytes = root_entries * 32
data_start = root_start + root_bytes
fat = data[fat_start:fat_start + spf * bps]


def fat_entry(cluster):
    off = cluster + (cluster // 2)
    val = struct.unpack_from("<H", fat, off)[0]
    return val & 0x0FFF if cluster % 2 == 0 else val >> 4


def read_chain(first, size):
    out = bytearray()
    cluster = first
    while 2 <= cluster < 0xFF0 and len(out) < size:
        off = data_start + (cluster - 2) * spc * bps
        out += data[off:off + spc * bps]
        cluster = fat_entry(cluster)
    return bytes(out[:size])


def root_files():
    for i in range(root_entries):
        e = data[root_start + i * 32:root_start + i * 32 + 32]
        if e[0] in (0x00,):
            break
        if e[0] == 0xE5:                 # deleted
            continue
        attr = e[0x0B]
        if attr & 0x08 or attr & 0x10:   # volume label / directory
            continue
        if attr & 0x02:                  # hidden
            continue
        name = e[0:8].decode("ascii", "replace").rstrip()
        ext = e[8:11].decode("ascii", "replace").rstrip()
        first = struct.unpack_from("<H", e, 0x1A)[0]
        size = struct.unpack_from("<I", e, 0x1C)[0]
        yield (f"{name}.{ext}" if ext else name), read_chain(first, size)


# --- SZDD ------------------------------------------------------------------
MAGIC = b"SZDD\x88\xf0\x27\x33"
# The archived disk stores 0x00 as the "missing character", so the final letter
# of each extension is recovered by convention instead of from the header.
EXT_MAP = {
    ".EX_": "E", ".DL_": "L", ".HL_": "P", ".WA_": "V", ".MI_": "D",
    ".DA_": "T", ".VB_": "X", ".IN_": "F", ".MS_": "T",
}


def szdd_expand(blob):
    if blob[8:9] != b"A":
        raise ValueError(f"unsupported SZDD mode {blob[8:9]!r}")
    size = struct.unpack_from("<I", blob, 10)[0]
    window = bytearray(b"\x20" * 4096)
    pos = 4096 - 16
    out = bytearray()
    i, end = 14, len(blob)
    while i < end and len(out) < size:
        control = blob[i]
        i += 1
        for bit in range(8):
            if i >= end or len(out) >= size:
                break
            if control & (1 << bit):
                b = blob[i]
                i += 1
                out.append(b)
                window[pos] = b
                pos = (pos + 1) & 0xFFF
            else:
                if i + 1 >= end:
                    break
                lo, hi = blob[i], blob[i + 1]
                i += 2
                match = lo | ((hi & 0xF0) << 4)
                for _ in range((hi & 0x0F) + 3):
                    if len(out) >= size:
                        break
                    b = window[match]
                    match = (match + 1) & 0xFFF
                    out.append(b)
                    window[pos] = b
                    pos = (pos + 1) & 0xFFF
    if len(out) != size:
        raise ValueError(f"short expand: {len(out)} of {size}")
    return bytes(out)


def target_name(name):
    stem, ext = os.path.splitext(name)
    if len(ext) == 4 and ext.endswith("_"):
        tail = EXT_MAP.get(ext.upper())
        if tail is None:
            raise ValueError(f"no extension mapping for {ext} ({name})")
        return stem + ext[:-1] + tail
    return name


os.makedirs(out_dir, exist_ok=True)
expanded = copied = 0
for name, blob in root_files():
    if blob[:8] == MAGIC:
        blob = szdd_expand(blob)
        name = target_name(name)
        expanded += 1
    else:
        copied += 1
    with open(os.path.join(out_dir, name), "wb") as f:
        f.write(blob)
print(f"redstone-9x-wep: expanded {expanded}, copied {copied}")
PYWEP

SRC="${STAGE}/expanded"

# Sanity gate: every game must be a real NE binary before anything is installed.
# A decompressor that silently produced garbage would otherwise be discovered
# only as a mystery failure at play time.
"${PY}" - "${SRC}" <<'PYCHECK'
import struct
import sys

src = sys.argv[1]
games = ["TETRIS", "FREECELL", "PIPE", "CHIPS", "TP", "TUTSTOMB", "RODENT",
         "TRIPEAKS", "GOLF", "SKI", "JEZZBALL", "BLAKJAK", "TETRAVEX"]
bad = []
for g in games:
    p = f"{src}/{g}.EXE"
    try:
        d = open(p, "rb").read()
        ne = struct.unpack_from("<I", d, 0x3C)[0]
        if d[ne:ne + 2] != b"NE":
            bad.append(f"{g}: not an NE binary")
    except Exception as exc:
        bad.append(f"{g}: {exc}")
if bad:
    sys.exit("redstone-9x-wep: FAILED integrity check\n  " + "\n  ".join(bad))
print(f"redstone-9x-wep: {len(games)} NE binaries verified")
PYCHECK

# Install per the original SETUP.INF: games to C:\BOWEP, the two shared runtimes
# to the Windows directory. Setup Toolkit's own machinery is not installed.
echo "redstone-9x-wep: installing to ${DEST}…"
for f in "${SRC}"/*; do
  base="$(basename "${f}")"
  case "${base}" in
    SETUP.EXE|SETUP.INF|SETUP.LST|SETUPAPI.INF|_MSTEST.EXE|BOWEP.MST|MSCOMSTF.DLL|MSCUISTF.DLL|MSDETSTF.DLL|MSINSSTF.DLL|MSSHLSTF.DLL|MSUILSTF.DLL)
      continue ;;
  esac
  cp -f "${f}" "${DEST}/${base}"
done

for f in WEPUTIL.DLL VBRUN100.DLL; do
  [[ -f "${SRC}/${f}" ]] && cp -f "${SRC}/${f}" "${WINDIR}/${f}"
done

# Icons, straight out of the 1994 binaries. Optional by design — a missing
# icoutils must never block the install, so every step here is soft.
WRESTOOL="${WINE_PROFILE}/bin/wrestool"
ICOTOOL="${WINE_PROFILE}/bin/icotool"
if [[ -x "${WRESTOOL}" && -x "${ICOTOOL}" ]]; then
  echo "redstone-9x-wep: extracting icons…"
  TMPICO="$(mktemp -d)"
  trap 'rm -rf "${TMPICO}"' EXIT
  # icoutils has no locale data in the Guix profile and warns on every call.
  # Harmless, but it buries real errors, so pin the C locale.
  export LC_ALL=C
  n=0
  for entry in \
    "tetris:TETRIS" "freecell:FREECELL" "pipe:PIPE" "chips:CHIPS" \
    "taipei:TP" "tutstomb:TUTSTOMB" "rodent:RODENT" "tripeaks:TRIPEAKS" \
    "golf:GOLF" "ski:SKI" "jezzball:JEZZBALL" "blakjak:BLAKJAK" \
    "tetravex:TETRAVEX"; do
    slug="${entry%%:*}"; exe="${entry##*:}"
    rm -rf "${TMPICO:?}"/*
    mkdir -p "${TMPICO}/out"
    # -t 14 is RT_GROUP_ICON. wrestool names its output <exe>_14_<id>.ico, and
    # some of these carry several groups (ids 1, 100, 256); the lowest-numbered
    # one is the application icon.
    "${WRESTOOL}" -x -t 14 -o "${TMPICO}" "${DEST}/${exe}.EXE" 2>/dev/null || true
    ico="$(find "${TMPICO}" -maxdepth 1 -type f -name '*.ico' | sort | head -1)"
    [[ -n "${ico}" ]] || continue
    "${ICOTOOL}" -x -o "${TMPICO}/out" "${ico}" 2>/dev/null || true
    # icotool writes <base>_<idx>_<W>x<H>x<depth>.png. Every group here holds a
    # 16-colour and a monochrome image at the same size, so pick by colour depth
    # (the trailing field) — sorting by name would take the 1-bit one.
    png="$(find "${TMPICO}/out" -type f -name '*.png' \
             | awk -F'x' '{print $NF, $0}' | sort -rn | head -1 | cut -d' ' -f2-)"
    if [[ -n "${png}" ]]; then
      cp -f "${png}" "${ICONDIR}/wep-${slug}.png"
      n=$((n + 1))
    fi
  done
  echo "redstone-9x-wep: ${n} icons installed to ${ICONDIR}"
else
  echo "redstone-9x-wep: icoutils not in room-windows-compat — menu will use the generic Wine icon"
  echo "  (build it with: make guix-room-windows-compat)"
fi

touch "${MARKER}"
echo "redstone-9x-wep: ready — 13 games in ${DEST}"
echo "  Launch one with: redstone-9x-wep tetris"
