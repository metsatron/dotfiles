#!/bin/env bash
# desktop-heal - DE-aware desktop repair entry point

# [[file:../../../services.org::*desktop-heal - DE-aware desktop repair entry point][desktop-heal - DE-aware desktop repair entry point:1]]
set -euo pipefail

log() {
  printf '[desktop-heal] %s\n' "$*"
}

detect_desktop() {
  local current="${XDG_CURRENT_DESKTOP:-}"
  local session="${DESKTOP_SESSION:-}"

  if pgrep -x plasmashell >/dev/null 2>&1 ||
     pgrep -x ksmserver >/dev/null 2>&1 ||
     pgrep -x krunner >/dev/null 2>&1 ||
     [[ "$current" == *KDE* ]] ||
     [[ "$session" == plasma* || "$session" == sonic* ]]; then
    printf '%s\n' plasma
    return 0
  fi

  if pgrep -x xfce4-session >/dev/null 2>&1 ||
     pgrep -x xfce4-panel >/dev/null 2>&1 ||
     [[ "$current" == *XFCE* ]] ||
     [[ "$session" == xfce* ]]; then
    printf '%s\n' xfce
    return 0
  fi

  printf '%s\n' unknown
}

source_guix_desktop_env() {
  if [ -r "$HOME/.xsessionrc.d/20-guix-core-profile.sh" ]; then
    set +u
    # shellcheck disable=SC1091
    . "$HOME/.xsessionrc.d/20-guix-core-profile.sh"
    set -u
  fi
  XDG_DATA_DIRS="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  export XDG_DATA_DIRS
  unset GIO_EXTRA_MODULES
}

heal_plasma() {
  export DISPLAY="${DISPLAY:-:0}"
  export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR}/bus}"
  export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-KDE}"
  export DESKTOP_SESSION="${DESKTOP_SESSION:-plasmax11}"
  export KDE_SESSION_VERSION="${KDE_SESSION_VERSION:-6}"

  source_guix_desktop_env

  log "Detected Plasma/SonicDE session."
  log "Using XDG_DATA_DIRS=${XDG_DATA_DIRS}"

  if command -v systemctl >/dev/null 2>&1; then
    systemctl --user import-environment DISPLAY XAUTHORITY DBUS_SESSION_BUS_ADDRESS XDG_RUNTIME_DIR XDG_DATA_DIRS XDG_CURRENT_DESKTOP DESKTOP_SESSION KDE_SESSION_VERSION PATH GUIX_PROFILE GUIX_LOCPATH 2>/dev/null || true
  fi

  if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment DISPLAY XAUTHORITY DBUS_SESSION_BUS_ADDRESS XDG_RUNTIME_DIR XDG_DATA_DIRS XDG_CURRENT_DESKTOP DESKTOP_SESSION KDE_SESSION_VERSION PATH GUIX_PROFILE GUIX_LOCPATH >/dev/null 2>&1 || true
  fi

  if command -v kbuildsycoca6 >/dev/null 2>&1; then
    log "Rebuilding KDE service cache..."
    kbuildsycoca6 --noincremental >/dev/null 2>&1 || true
  elif command -v kbuildsycoca5 >/dev/null 2>&1; then
    log "Rebuilding KDE service cache..."
    kbuildsycoca5 --noincremental >/dev/null 2>&1 || true
  fi

  local x11_session=0
  if [[ "${XDG_SESSION_TYPE:-}" == x11 ]]; then
    x11_session=1
  elif [[ -n "${DISPLAY:-}" && -z "${WAYLAND_DISPLAY:-}" ]]; then
    x11_session=1
  fi

  if (( x11_session )); then
    if command -v kwin_x11 >/dev/null 2>&1; then
      log "Restoring kwin_x11 compositor..."
      nohup env DISPLAY="$DISPLAY" DBUS_SESSION_BUS_ADDRESS="$DBUS_SESSION_BUS_ADDRESS" XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" XDG_DATA_DIRS="$XDG_DATA_DIRS" PATH="$PATH" GUIX_PROFILE="${GUIX_PROFILE:-}" kwin_x11 --replace >/tmp/dotcortex-kwin_x11.log 2>&1 &
      sleep 1
    else
      log "kwin_x11 not found in PATH."
    fi
  else
    log "Skipping kwin_x11 restore on non-X11 session."
  fi

  if pgrep -x krunner >/dev/null 2>&1; then
    log "Restarting krunner..."
    kquitapp6 krunner >/dev/null 2>&1 || pkill -x krunner >/dev/null 2>&1 || true
    sleep 0.5
  fi
  if command -v krunner >/dev/null 2>&1; then
    nohup env DISPLAY="$DISPLAY" DBUS_SESSION_BUS_ADDRESS="$DBUS_SESSION_BUS_ADDRESS" XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" XDG_DATA_DIRS="$XDG_DATA_DIRS" PATH="$PATH" GUIX_PROFILE="${GUIX_PROFILE:-}" krunner --daemon >/tmp/dotcortex-krunner.log 2>&1 &
  fi

  log "Starting plasmashell..."
  if command -v plasmashell >/dev/null 2>&1; then
    if pgrep -x plasmashell >/dev/null 2>&1; then
      nohup env DISPLAY="$DISPLAY" DBUS_SESSION_BUS_ADDRESS="$DBUS_SESSION_BUS_ADDRESS" XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" XDG_DATA_DIRS="$XDG_DATA_DIRS" PATH="$PATH" GUIX_PROFILE="${GUIX_PROFILE:-}" plasmashell --replace >/tmp/dotcortex-plasmashell.log 2>&1 &
    else
      nohup env DISPLAY="$DISPLAY" DBUS_SESSION_BUS_ADDRESS="$DBUS_SESSION_BUS_ADDRESS" XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" XDG_DATA_DIRS="$XDG_DATA_DIRS" PATH="$PATH" GUIX_PROFILE="${GUIX_PROFILE:-}" plasmashell >/tmp/dotcortex-plasmashell.log 2>&1 &
    fi
  else
    log "plasmashell not found in PATH."
  fi

  sleep 2
  pgrep -af 'plasmashell|krunner|kwin_x11|ksmserver' || true
}

heal_xfce() {
  local helper="$HOME/.local/bin/xfce4-heal"
  [ -x "$helper" ] || helper="$HOME/DotCortex/x230/.local/bin/xfce4-heal"
  if [ -x "$helper" ]; then
    log "Detected XFCE session; delegating to $helper"
    "$helper"
  else
    log "xfce4-heal not found."
    return 1
  fi
}

case "$(detect_desktop)" in
  plasma) heal_plasma ;;
  xfce) heal_xfce ;;
  *)
    log "Could not detect supported desktop; trying XFCE helper first."
    heal_xfce
    ;;
esac
# desktop-heal - DE-aware desktop repair entry point:1 ends here
