#!/bin/bash
# TRX launcher wrapper


# [[file:../../../sanctuary-redstone-9x.org::*TRX launcher wrapper][TRX launcher wrapper:1]]
# Launch Lost Artefacts TRX from a Redstone desktop entry using the shared X230
# Games tree.  The binary/data are host-owned; config, saves, cache, and
# screenshots remain mutable guest state under the Redstone home.
set -euo pipefail

TRX_ROOT="${TRX_ROOT:-/run/dotcortex/games/tomb-raider-trx/runtime}"
TRX_BIN="${TRX_BIN:-${TRX_ROOT}/TRX}"
TRX_GAMES_DIR="${TRX_GAMES_DIR:-${TRX_ROOT}/games}"
TRX_HOST_ROOT="${TRX_HOST_ROOT:-/home/metsatron/Games/tomb-raider-trx/runtime}"
TRX_HOST_BIN="${TRX_HOST_BIN:-${TRX_HOST_ROOT}/TRX}"
TRX_HOST_SPAWN="${TRX_HOST_SPAWN:-/run/host/home/metsatron/.local/bin/host-spawn}"
TRX_HOST_LOADER="${TRX_HOST_LOADER:-/run/host/lib/x86_64-linux-gnu/ld-linux-x86-64.so.2}"
# TRX's bundled cfg/ tree contains shaders, presets, and shared strings.  Keep
# that immutable runtime tree as the default; only cache, saves, and screenshots
# belong in the mutable guest home.
TRX_CONFIG_DIR="${TRX_CONFIG_DIR:-${TRX_ROOT}/cfg}"
TRX_CACHE_DIR="${TRX_CACHE_DIR:-${HOME}/.cache/trx}"
TRX_SAVES_DIR="${TRX_SAVES_DIR:-${HOME}/.local/share/trx/saves}"
TRX_SCREENSHOTS_DIR="${TRX_SCREENSHOTS_DIR:-${HOME}/Pictures/TRX}"

mod="tr1"
if [[ "${1:-}" == "--mod" ]]; then
  [[ $# -ge 2 ]] || { echo "usage: redstone-9x-trx [--mod tr1|tr2|tr3] [TRX options...]" >&2; exit 2; }
  mod="$2"
  shift 2
fi
case "${mod}" in
  tr1|tr2|tr3) ;;
  *) echo "redstone-9x-trx: unsupported game module: ${mod}" >&2; exit 2 ;;
esac

[[ -x "${TRX_BIN}" ]] || { echo "redstone-9x-trx: TRX runtime missing: ${TRX_BIN}" >&2; exit 1; }
[[ -d "${TRX_GAMES_DIR}/${mod}" ]] || { echo "redstone-9x-trx: game data missing: ${TRX_GAMES_DIR}/${mod}" >&2; exit 1; }
mkdir -p "${TRX_CONFIG_DIR}" "${TRX_CACHE_DIR}" "${TRX_SAVES_DIR}" "${TRX_SCREENSHOTS_DIR}"
export TRX_CONFIG_DIR TRX_CACHE_DIR TRX_GAMES_DIR TRX_SAVES_DIR TRX_SCREENSHOTS_DIR
cd "${TRX_ROOT}"

# The portable TRX release is a static PIE which uses the system ELF loader at
# startup.  Redstone's Guix guest intentionally has no /lib64 loader, while
# the host does.  Run the host-owned binary through host-spawn when that guest
# loader is absent; DISPLAY remains the caller's Redstone Xephyr display, so
# the window still belongs to this desktop rather than the host desktop.
if [[ -e /lib64/ld-linux-x86-64.so.2 ]]; then
  exec "${TRX_BIN}" --mod "${mod}" "$@"
fi

if [[ ! -x "${TRX_HOST_SPAWN}" || ! -x "${TRX_HOST_LOADER}" ]]; then
  echo "redstone-9x-trx: guest loader absent and host TRX bridge is unavailable" >&2
  exit 127
fi

TRX_CONFIG_DIR="${TRX_HOST_ROOT}/cfg"
TRX_GAMES_DIR="${TRX_HOST_ROOT}/games"
export TRX_CONFIG_DIR TRX_GAMES_DIR
host_env="HOME,DISPLAY,XAUTHORITY,TRX_CONFIG_DIR,TRX_CACHE_DIR,TRX_GAMES_DIR,TRX_SAVES_DIR,TRX_SCREENSHOTS_DIR,SDL_VIDEODRIVER,SDL_AUDIODRIVER,SDL_RENDER_DRIVER"
exec "${TRX_HOST_LOADER}" \
  --library-path /run/host/lib/x86_64-linux-gnu:/run/host/usr/lib/x86_64-linux-gnu \
  "${TRX_HOST_SPAWN}" -no-pty -cwd "${TRX_HOST_ROOT}" -env "${host_env}" -- \
  "${TRX_HOST_BIN}" --mod "${mod}" "$@"
# TRX launcher wrapper:1 ends here
