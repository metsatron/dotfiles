#!/usr/bin/env bash
# Logseq bridge
# NFS sub-mounts under =$HOME= are not automatically bind-mounted into Flatpak sandboxes.
# This grants the Flatpak Logseq access to the vault path on the NFS mount.

# [[file:../../../package-flatpak.org::*Logseq bridge][Logseq bridge:1]]
set -euo pipefail

APP_ID="com.logseq.Logseq"
LOGSEQ_VAULT="${LOGSEQ_VAULT:-$HOME/mnt/x230/HelmCortex/LOGS/Logseq}"

echo "Granting $APP_ID access to $LOGSEQ_VAULT"
flatpak override --user --filesystem="$LOGSEQ_VAULT" "$APP_ID"

echo "Done."
# Logseq bridge:1 ends here
