DONOR_RELATIVE = Path("linux/.themes/QTStepWMakerDefault19p/xfwm4")
PALETTE_RELATIVE = Path("linux/.config/redstone-9x/nextstep-palettes.json")
TOSH_DEFAULT_RELATIVE = Path("linux/.icewm/themes/Tosh/default.theme")
NEXT_LOGO_SVG_RELATIVE = Path("linux/.config/gnustep-sanctuary/Icons/NeXT_logo.svg")
OUTPUTS = {
    "base": "NeXTSTEP-Trial-OneStepBack-Base",
    "darkadobe": "NeXTSTEP-Trial-DarkAdobe",
    "default": "NeXTSTEP-Trial-Default",
}
AUTHENTIC_BUTTON_STYLES = {
    "gray": {"face": "base_color", "glyph": "black_color"},
    "black": {"face": "black_color", "glyph": "white_color"},
}
# Hand-authored, no-antialias close glyphs. The even pressed frame keeps the
# same historical 10px bbox; every row is its horizontal mirror and the row
# order is its vertical mirror, so all four diagonal arms have equal weight.
AUTHENTIC_CLOSE_GLYPHS = {
    False: (
        "XX.......XX",
        ".XX.....XX.",
        "..XX...XX..",
        "...XX.XX...",
        "....XXX....",
        ".....X.....",
        "....XXX....",
        "...XX.XX...",
        "..XX...XX..",
        ".XX.....XX.",
        "XX.......XX",
    ),
    True: (
        "XX......XX",
        ".XX....XX.",
        "..XX..XX..",
        "...XXXX...",
        "....XX....",
        "....XX....",
        "...XXXX...",
        "..XX..XX..",
        ".XX....XX.",
        "XX......XX",
    ),
}
# Button margins are a construction choice independent of face/glyph colour.
# The old flat-margin construction remains the GNUstep-reusable path; the
# authentic Default wraps the titlebar bevel through each button's margins.
BUTTON_MARGIN_STYLES = {
    "nextstep-wrap": "bar rows through button margins",
    "gnustep-flat": "flat slab colour through button margins",
}
# Authentic Default geometry: highlight, slab, shadow, then separator.
AUTHENTIC_TITLE_SLAB_HEIGHT = 20
AUTHENTIC_TITLE_BAR_HEIGHT = AUTHENTIC_TITLE_SLAB_HEIGHT + 3
AUTHENTIC_BUTTON_ART_SIZE = 16
# Measure the 2px breathing room from the bevel itself: row/column 0 is the
# bevel, rows/columns 1..2 are clear slab, and the 16px art starts at 3.
AUTHENTIC_BUTTON_ART_TOP = 3
# IceWM's taskbar Start image is a single taskbar-height raster.  Keep the
# established 22px height independently of the 23px titlebar, and derive
# width from the actual content so the
# button has only the requested 3px outer pads and 4px icon/text gap.
AUTHENTIC_START_HEIGHT = 22
AUTHENTIC_START_ICON_WIDTH = 15
AUTHENTIC_START_ICON_HEIGHT = 18
AUTHENTIC_START_TEXT = "NeXT"
AUTHENTIC_START_PAD = 3
AUTHENTIC_START_GAP = 4
AUTHENTIC_START_PIXEL_GAP = 2
# A hand-authored pixel face avoids the disconnected fragments produced by
# thresholding a size-12 vector.  Diagonal strokes are intentionally
# 8-connected, while every letter remains one authored component.
AUTHENTIC_START_PIXEL_GLYPHS = {
    "N": (
        "#...#", "##..#", "#.#.#", "#..##", "#...#",
        "#...#", "#...#", "#...#", "#...#",
    ),
    "e": (
        ".###.", "#...#", "#####", "#....", "#...#", ".###.",
    ),
    "X": (
        "#...#", ".#.#.", "..#..", ".#.#.", "#...#",
        ".#.#.", "..#..", ".#.#.", "#...#",
    ),
    "T": (
        "#####", "..#..", "..#..", "..#..", "..#..",
        "..#..", "..#..", "..#..", "..#..",
    ),
}
# Flat, hand-authored 15x18 cube: K=black edge, Y=yellow top, G=green left,
# M=magenta right, .=transparent.  The three facets follow the tilted-cube
# geometry of the canonical SVG; its letter paths are intentionally omitted.
AUTHENTIC_START_CUBE_PIXELS = (
    ".......K.......", "......KKK......", ".....KYYYK.....",
    "....KYYYYYK....", "...KYYYYYYYK...", "..KYYYYYYYYYK..",
    ".KGGGGGKMMMMMK.", ".KGGGGGKMMMMMK.", "..KGGGGKMMMMK..",
    "..KGGGGKMMMMK..", "...KGGGKMMMK...", "...KGGGKMMMK...",
    "....KGGKMMK....", "....KGGKMMK....", ".....KGKMK.....",
    ".....KGKMK.....", "......KKK......", ".......K.......",
)
REQUIRED_PALETTE_KEYS = (
    "base_color", "black_color", "darker_color", "lighter_color",
    "scale_color", "white_color",
)
XPM_HEADER = re.compile(r'^\s*"(\d+)\s+(\d+)\s+(\d+)\s+(\d+)"')
COLOUR_LINE = re.compile(r'\bc\s+(.+?)\s*$')
HEX = re.compile(r'^#[0-9a-fA-F]{6}$')


class Xpm:
    def __init__(self, width: int, height: int, colours: dict[str, str | None],
                 pixels: list[str]) -> None:
        self.width = width
        self.height = height
        self.colours = colours
        self.pixels = pixels


def quoted(line: str) -> str:
    start = line.find('"')
    end = line.rfind('"')
    if start < 0 or end <= start:
        raise ValueError(f"not an XPM string: {line!r}")
    return line[start + 1:end]


def read_xpm(path: Path) -> Xpm:
    lines = path.read_text(encoding="latin-1").splitlines()
    header_index = next(
        (index for index, line in enumerate(lines) if XPM_HEADER.match(line)),
        None,
    )
    if header_index is None:
        raise ValueError(f"XPM header missing: {path}")
    match = XPM_HEADER.match(lines[header_index])
    assert match is not None
    width, height, colour_count, cpp = map(int, match.groups())
    if cpp != 1:
        raise ValueError(f"unsupported XPM chars-per-pixel in {path}: {cpp}")
    colours: dict[str, str | None] = {}
    for line in lines[header_index + 1:header_index + 1 + colour_count]:
        value = quoted(line)
        symbol = value[:cpp]
        colour_match = COLOUR_LINE.search(value[cpp:])
        if colour_match is None:
            raise ValueError(f"XPM colour missing in {path}: {line}")
        colour = colour_match.group(1).split()[0]
        if colour.lower() == "none":
            colours[symbol] = None
        elif HEX.fullmatch(colour):
            colours[symbol] = colour.upper()
        else:
            raise ValueError(f"unsupported XPM colour in {path}: {colour}")
    pixel_start = header_index + 1 + colour_count
    pixels = [quoted(line) for line in lines[pixel_start:pixel_start + height]]
    if len(pixels) != height or any(len(row) != width for row in pixels):
        raise ValueError(f"incomplete XPM pixels: {path}")
    if any(symbol not in colours for row in pixels for symbol in row):
        raise ValueError(f"XPM pixel refers to an undeclared colour: {path}")
    return Xpm(width, height, colours, pixels)


def write_xpm(path: Path, colours: list[str | None], pixels: list[list[str | None]]) -> None:
    unique = list(dict.fromkeys(colours))
    symbols = ".+@#$%&*=-;:!?ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
    if None in unique:
        symbols = " " + symbols
    if len(unique) > len(symbols):
        raise ValueError(f"too many output colours for {path}: {len(unique)}")
    symbol_for = {colour: symbols[index] for index, colour in enumerate(unique)}
    width = len(pixels[0])
    height = len(pixels)
    lines = [
        "/* XPM */",
        f"static char *{path.stem.replace('-', '_')}_xpm[] = {{",
        f'"{width} {height} {len(unique)} 1",',
    ]
    for colour in unique:
        symbol = symbol_for[colour]
        encoded = "None" if colour is None else colour
        lines.append(f'"{symbol} c {encoded}",')
    for row in pixels[:-1]:
        lines.append('"' + "".join(symbol_for[colour] for colour in row) + '",')
    lines.append('"' + "".join(symbol_for[colour] for colour in pixels[-1]) + '"};')
    path.write_text("\n".join(lines) + "\n", encoding="latin-1")


def rgb_luma(colour: str) -> int:
    red, green, blue = (int(colour[index:index + 2], 16) for index in (1, 3, 5))
    return (299 * red + 587 * green + 114 * blue) // 1000


def ice_colour(colour: str) -> str:
    return f"rgb:{colour[1:3]}/{colour[3:5]}/{colour[5:7]}"


def dark_chrome(colour: str) -> str:
    # 2026-08-11 live verdict: a literal black outline was rejected.  The
    # single outer contour is dark chrome of the skew's face family: 50%
    # darker_color mixed toward black, never a fixed #000000 frame band.
    channels = [int(colour[index:index + 2], 16) // 2 for index in (1, 3, 5)]
    return "#" + "".join(f"{channel:02X}" for channel in channels)


def palette_row(data: dict, skew: str) -> dict[str, str]:
    # The authentic default NeXT trial is black-focused, but its unfocused
    # face and bevel remain the normal OneStepBack gray family.  Keep one
    # validated palette source and make the focused-title exception explicit.
    palette_skew = "base" if skew == "default" else skew
    raw = data.get("one_step_back", {}).get(palette_skew)
    if not isinstance(raw, dict):
        raise SystemExit(f"palette row is missing or ambiguous: one_step_back.{palette_skew}")
    missing = [key for key in REQUIRED_PALETTE_KEYS if key not in raw]
    if missing:
        raise SystemExit(f"palette row one_step_back.{palette_skew} is missing: {', '.join(missing)}")
    row = {key: str(raw[key]).lower() for key in REQUIRED_PALETTE_KEYS}
    for key, value in row.items():
        if not HEX.fullmatch(value):
            raise SystemExit(f"palette row one_step_back.{palette_skew} has invalid {key}: {value}")
    row.update({
        # WMakerDefault's focused body is a dark slab.  The differing
        # darker_color role is the deliberate palette-responsive title face.
        "active_title": row["darker_color"],
        "inactive_title": row["base_color"],
        "bright": row["lighter_color"] if skew == "darkadobe" else row["white_color"],
    })
    if skew == "default":
        row["active_title"] = row["black_color"]
    return row


def donor_colour_map(row: dict[str, str]) -> dict[str, str]:
    return {
        "#000000": row["black_color"],
        "#040004": row["black_color"],
        "#384246": row["base_color"],
        "#0D171B": row["darker_color"],
        "#434D51": row["scale_color"],
        "#FFFFFF": row["bright"],
        "#AEAAAE": row["base_color"],
        "#8D979B": row["lighter_color"],
        "#837F83": row["darker_color"],
        "#595559": row["darker_color"],
        "#4D575B": row["darker_color"],
        "#ACAAAC": row["lighter_color"],
        # This single source accent occurs in title-2-active.xpm; it is
        # donor-derived and is made responsive through the palette accent.
        "#40A740": row["scale_color"],
    }


def recolour_xpm(source: Path, row: dict[str, str], state: str, context: str,
                 fallbacks: set[tuple[str, str]]) -> tuple[int, int, list[list[str | None]]]:
    image = read_xpm(source)
    mapping = donor_colour_map(row)
    body_symbol: str | None = None
    if context == "title":
        interior = [
            symbol for line in image.pixels[2:-2] for symbol in line
            if image.colours[symbol] is not None
        ]
        body_symbol = collections.Counter(interior).most_common(1)[0][0]
    output: list[list[str | None]] = []
    for line in image.pixels:
        output_line: list[str | None] = []
        for symbol in line:
            old = image.colours[symbol]
            if old is None:
                output_line.append(None)
                continue
            if context == "title" and symbol == body_symbol:
                new = row["active_title"] if state == "active" else row["inactive_title"]
            else:
                new = mapping.get(old.upper())
                if new is None:
                    fallbacks.add((source.name, old.upper()))
                    new = old.upper()
            output_line.append(new)
        output.append(output_line)
    return image.width, image.height, output


def write_recoloured(source: Path, destination: Path, row: dict[str, str], state: str,
                     context: str, fallbacks: set[tuple[str, str]]) -> None:
    width, height, pixels = recolour_xpm(source, row, state, context, fallbacks)
    write_xpm(destination, [colour for line in pixels for colour in line], pixels)
    if (width, height) != (len(pixels[0]), len(pixels)):
        raise AssertionError(f"XPM size changed during recolour: {source}")


def title_sources() -> dict[str, str]:
    return {
        "B": "title-5", "T": "title-3", "S": "title-1",
        "L": "title-1", "R": "title-5", "M": "title-2", "P": "title-4",
    }


def write_titles(donor: Path, output: Path, row: dict[str, str],
                 fallbacks: set[tuple[str, str]]) -> None:
    for state, suffix in (("active", "A"), ("inactive", "I")):
        for stem, donor_stem in title_sources().items():
            source = donor / f"{donor_stem}-{state}.xpm"
            write_recoloured(source, output / f"title{suffix}{stem}.xpm", row,
                             state, "title", fallbacks)


def write_authentic_titles(donor: Path, output: Path,
                           row: dict[str, str]) -> None:
    """Emit the original NeXT titlebar with a bevel wrapping its boundary."""
    for state, suffix in (("active", "A"), ("inactive", "I")):
        title = row["active_title"] if state == "active" else row["inactive_title"]
        highlight = row["lighter_color"]
        shadow = row["darker_color"]
        separator = row["black_color"]
        for stem, donor_stem in title_sources().items():
            source = donor / f"{donor_stem}-{state}.xpm"
            image = read_xpm(source)
            # IceWM sizes the title buttons from their loaded pixmap width.
            # Match the L/R title segments to the 23px button frame; the donor
            # L/R width is 23px and otherwise leaves a one-pixel strip before
            # each outermost button.
            segment_width = (AUTHENTIC_TITLE_BAR_HEIGHT
                             if stem in {"L", "R"} else image.width)
            # Authentic NeXT wraps the assembled bar: highlight first, then
            # the 19px slab, shadow last, and a black separator.  L/R are
            # adjacent to the caption buttons, so they are horizontal-only;
            # the outermost button pixmaps alone carry the vertical edges.
            pixels = [[title for _ in range(segment_width)]
                      for _ in range(AUTHENTIC_TITLE_BAR_HEIGHT)]
            pixels[0] = [highlight] * segment_width
            pixels[AUTHENTIC_TITLE_SLAB_HEIGHT + 1] = [shadow] * segment_width
            pixels[AUTHENTIC_TITLE_SLAB_HEIGHT + 2] = [separator] * segment_width
            write_xpm(output / f"title{suffix}{stem}.xpm",
                      [colour for line in pixels for colour in line], pixels)


def write_frames(output: Path, row: dict[str, str]) -> None:
    contour = dark_chrome(row["darker_color"])
    face = row["base_color"]
    highlight = row["lighter_color"]
    shadow = row["darker_color"]
    pixels = {
        # Cross-sections run from outside toward the window interior.
        "T": [[contour], [highlight], [face]],
        "L": [[contour, highlight, face]],
        "R": [[face, shadow, contour]],
        "B": [[face], [shadow], [contour]],
        "TL": [
            [contour, contour, contour],
            [contour, highlight, highlight],
            [contour, highlight, face],
        ],
        "TR": [
            [contour, contour, contour],
            [highlight, highlight, shadow],
            [face, face, contour],
        ],
        "BL": [
            [contour, highlight, face],
            [contour, shadow, shadow],
            [contour, contour, contour],
        ],
        "BR": [
            [face, face, contour],
            [shadow, shadow, contour],
            [contour, contour, contour],
        ],
    }
    for suffix in ("A", "I"):
        for prefix in ("frame", "dframe"):
            for stem, frame in pixels.items():
                write_xpm(
                    output / f"{prefix}{suffix}{stem}.xpm",
                    [colour for line in frame for colour in line],
                    frame,
                )


def write_authentic_frames(output: Path, row: dict[str, str]) -> None:
    """Emit the one-pixel black outer window frame for authentic NeXT."""
    black = row["black_color"]
    for suffix in ("A", "I"):
        for prefix in ("frame", "dframe"):
            for stem in ("T", "L", "R", "B", "TL", "TR", "BL", "BR"):
                write_xpm(output / f"{prefix}{suffix}{stem}.xpm",
                          [black], [[black]])


def authentic_button_pixels(row: dict[str, str], kind: str,
                            pressed: bool,
                            button_style: str,
                            bar_color: str,
                            margin_style: str,
                            edge: str | None) -> list[list[str]]:
    """Build one 23px IceWM frame with a 16px NeXT button inset.

    IceWM copies half of a stacked button pixmap into a widget exactly
    TitleBarHeight high.  The 16px button therefore sits at x/y=3..18 inside
    this 23px frame: the bevel is row/column 0, two full slab rows/columns
    1..2 remain clear, and the three terminal rows/columns 19..21 reach the
    shadow/separator boundary, with the black terminal pixel serving as the
    phantom shadow.  Its bevel occupies the first 15px; the final
    row/column are a distinct outer black shadow.  At button-local (14, 0),
    the one-pixel bevel-shadow corner is diagonal to that outer shadow and
    deliberately remains a single square.
    """
    style = AUTHENTIC_BUTTON_STYLES.get(button_style)
    if style is None:
        raise SystemExit(f"unknown authentic button style: {button_style}")
    size = AUTHENTIC_BUTTON_ART_SIZE
    black = row["black_color"]
    highlight = row["white_color"]
    shadow = row["darker_color"]
    face = row[style["face"]]
    glyph = row[style["glyph"]]
    pixels = [[face for _ in range(size)] for _ in range(size)]
    bevel_edge = size - 2
    for x in range(bevel_edge):
        pixels[0][x] = highlight
    pixels[0][bevel_edge] = shadow
    for y in range(1, bevel_edge):
        pixels[y][0] = highlight
        pixels[y][bevel_edge] = shadow
    for x in range(1, bevel_edge + 1):
        pixels[bevel_edge][x] = shadow
    # The final row/column are the extra black outer shadow, distinct from
    # the bevel shadow.  They are part of the visible 16px construction.
    for y in range(size):
        pixels[y][size - 1] = black
    for x in range(size):
        pixels[size - 1][x] = black

    offset = 1 if pressed else 0
    if kind == "maximize":
        glyph_left = 2 + offset
        glyph_right = min(size - 4, size - 3 + offset)
        glyph_top = 2 + offset
        glyph_bottom = min(size - 4, size - 3 + offset)
        for y in range(glyph_top, glyph_top + 3):
            if y < size - 1:
                for x in range(glyph_left, glyph_right + 1):
                    pixels[y][x] = glyph
        for x in (glyph_left, glyph_right):
            for y in range(glyph_top + 3, glyph_bottom + 1):
                if y < size - 1:
                    pixels[y][x] = glyph
        for x in range(glyph_left, glyph_right + 1):
            if x < size - 1:
                pixels[glyph_bottom][x] = glyph
    elif kind == "close":
        glyph_left = 2 + offset
        for y, pattern in enumerate(AUTHENTIC_CLOSE_GLYPHS[pressed],
                                    start=glyph_left):
            for x, bead in enumerate(pattern, start=glyph_left):
                if bead == "X":
                    pixels[y][x] = glyph
    frame_size = AUTHENTIC_TITLE_BAR_HEIGHT
    if margin_style not in BUTTON_MARGIN_STYLES:
        raise SystemExit(f"unknown button margin style: {margin_style}")
    # IceWM copies the button pixmap over the title pixmap.  The named
    # GNUstep-flat mode deliberately leaves every margin at the slab colour;
    # authentic NeXT wraps the full bar pattern through the margins.
    frame = [[bar_color for _ in range(frame_size)] for _ in range(frame_size)]
    if margin_style == "nextstep-wrap":
        frame[0] = [row["lighter_color"] for _ in range(frame_size)]
        frame[AUTHENTIC_TITLE_SLAB_HEIGHT + 1] = [row["darker_color"] for _ in range(frame_size)]
        frame[AUTHENTIC_TITLE_SLAB_HEIGHT + 2] = [row["black_color"] for _ in range(frame_size)]
    inset_y = AUTHENTIC_BUTTON_ART_TOP
    # The close button moves one pixel right inside its frame; its right edge
    # remains the bar-right shadow column. Every other button keeps x=3..18.
    inset_x = (AUTHENTIC_BUTTON_ART_TOP + 1
               if kind == "close" else AUTHENTIC_BUTTON_ART_TOP)
    if inset_y + size > AUTHENTIC_TITLE_SLAB_HEIGHT + 1:
        raise SystemExit("authentic button art does not fit inside title slab")
    if inset_x + size > frame_size:
        raise SystemExit("authentic button art does not fit inside button frame")
    for y, row_pixels in enumerate(pixels, start=inset_y):
        frame[y][inset_x:inset_x + size] = row_pixels
    # In this theme TitleButtonsLeft="m" is maximize and
    # TitleButtonsRight="x" is close.  Preserve the L/R vertical bevel in
    # only those two outer edge columns after art insertion; title L/R and all
    # other generated button assets have no edge claim and retain horizontal
    # rows only.
    if margin_style == "nextstep-wrap" and edge == "left":
        for y in range(1, AUTHENTIC_TITLE_SLAB_HEIGHT + 1):
            frame[y][0] = row["lighter_color"]
    elif margin_style == "nextstep-wrap" and edge == "right":
        for y in range(1, AUTHENTIC_TITLE_SLAB_HEIGHT + 1):
            frame[y][-1] = row["darker_color"]
    return frame


def write_authentic_buttons(output: Path, row: dict[str, str],
                            button_style: str,
                            margin_style: str) -> None:
    """Emit styled 16px NeXT buttons as stacked 23px frames (23x46)."""
    targets = {
        "close": "close", "minimize": "minimize", "maximize": "maximize",
        "restore": "restore", "rollup": "rollup", "rolldown": "rolldown",
        "menuButton": "menuButton",
    }
    edge_by_target = {"maximize": "left", "close": "right"}
    for target, kind in targets.items():
        glyph_kind = kind if kind in {"close", "maximize"} else ""
        for suffix, bar_color in (("A", row["active_title"]),
                                  ("I", row["inactive_title"])):
            normal = authentic_button_pixels(
                row, glyph_kind, pressed=False, button_style=button_style,
                bar_color=bar_color, margin_style=margin_style,
                edge=edge_by_target.get(target))
            pressed = authentic_button_pixels(
                row, glyph_kind, pressed=True, button_style=button_style,
                bar_color=bar_color, margin_style=margin_style,
                edge=edge_by_target.get(target))
            write_xpm(
                output / f"{target}{suffix}.xpm",
                [colour for line in normal + pressed for colour in line],
                normal + pressed)


def write_authentic_start(output: Path, repo: Path) -> dict[str, str]:
    """Emit the NeXT taskbar Start image through the established raster path.

    The canonical SVG is a cube made from four colored facet paths, not a
    letter glyph source.  The cube is rasterized directly; the mixed-case
    NeXT label is hand-authored as connected pixel matrices, then surrounded
    by the required black dilation before conversion to the theme-local XPM.
    """
    from PIL import Image

    svg = repo / NEXT_LOGO_SVG_RELATIVE
    png2xpm = repo / "linux/.local/bin/png2xpm.py"
    if not svg.is_file():
        raise SystemExit(f"NeXT Start SVG missing: {svg}")
    if not png2xpm.is_file():
        raise SystemExit(f"PNG-to-XPM helper missing: {png2xpm}")
    svg_text = svg.read_text(encoding="utf-8")
    svg_fills = re.findall(r'fill="(#[0-9a-fA-F]{6})"', svg_text)
    if len(svg_fills) != len(AUTHENTIC_START_TEXT):
        raise SystemExit(
            "NeXT Start SVG must expose exactly four coloured facet paths"
        )
    if re.search(r"<text\b|glyph-name=|aria-label=", svg_text):
        raise SystemExit("NeXT Start SVG unexpectedly contains letter glyph data")
    # The SVG has four facet fills in path order: red, magenta, green, yellow;
    # it has no N/e/X/T glyphs.  Apply the ruling's corrected e/T assignment.
    letter_colours = {
        "N": svg_fills[0], "e": svg_fills[3],
        "X": svg_fills[2], "T": svg_fills[1],
    }

    def components(pixels: set[tuple[int, int]]) -> int:
        remaining = set(pixels)
        count = 0
        while remaining:
            count += 1
            pending = [remaining.pop()]
            while pending:
                x, y = pending.pop()
                for dx in (-1, 0, 1):
                    for dy in (-1, 0, 1):
                        neighbour = (x + dx, y + dy)
                        if neighbour in remaining:
                            remaining.remove(neighbour)
                            pending.append(neighbour)
        return count

    def rgb(hex_colour: str) -> tuple[int, int, int, int]:
        return tuple(int(hex_colour[index:index + 2], 16)
                     for index in (1, 3, 5)) + (255,)

    text_height = max(len(rows) for rows in AUTHENTIC_START_PIXEL_GLYPHS.values())
    text_width = sum(
        max(len(row) for row in AUTHENTIC_START_PIXEL_GLYPHS[letter])
        for letter in AUTHENTIC_START_TEXT
    ) + AUTHENTIC_START_PIXEL_GAP * (len(AUTHENTIC_START_TEXT) - 1)
    core_layer = Image.new("RGBA", (text_width, text_height), (0, 0, 0, 0))
    core_pixels = core_layer.load()
    letter_counts: dict[str, int] = {}
    cursor = 0
    text_y = (AUTHENTIC_START_HEIGHT - text_height) // 2
    for letter in AUTHENTIC_START_TEXT:
        matrix = AUTHENTIC_START_PIXEL_GLYPHS[letter]
        width = max(len(row) for row in matrix)
        pixels = set()
        for row, values in enumerate(matrix):
            if any(value not in ".#" for value in values):
                raise SystemExit(f"invalid pixel glyph data for {letter}")
            for column, value in enumerate(values):
                if value == "#":
                    core_pixels[cursor + column, row] = rgb(letter_colours[letter])
                    pixels.add((cursor + column, row))
        if components(pixels) != 1:
            raise SystemExit(f"pixel glyph {letter} is not one connected component")
        letter_counts[letter] = len(pixels)
        cursor += width + AUTHENTIC_START_PIXEL_GAP

    cube_rows = AUTHENTIC_START_CUBE_PIXELS
    if (len(cube_rows) != AUTHENTIC_START_ICON_HEIGHT or
            any(len(row) != AUTHENTIC_START_ICON_WIDTH for row in cube_rows)):
        raise SystemExit("NeXT Start cube matrix must be exactly 15x18")
    cube_colours = {
        ".": (0, 0, 0, 0), "K": (0, 0, 0, 255),
        "Y": rgb(svg_fills[3]), "G": rgb(svg_fills[2]),
        "M": rgb(svg_fills[1]),
    }
    icon = Image.new("RGBA", (AUTHENTIC_START_ICON_WIDTH,
                               AUTHENTIC_START_ICON_HEIGHT), (0, 0, 0, 0))
    icon_pixels = icon.load()
    for y, row in enumerate(cube_rows):
        for x, value in enumerate(row):
            if value not in cube_colours:
                raise SystemExit(f"invalid NeXT Start cube pixel: {value}")
            icon_pixels[x, y] = cube_colours[value]

    plate_width = text_width + 4
    plate_height = text_height + 4
    plate_origin = (
        AUTHENTIC_START_PAD + icon.width + AUTHENTIC_START_GAP,
        (AUTHENTIC_START_HEIGHT - plate_height) // 2,
    )
    core_origin = (plate_origin[0] + 2, plate_origin[1] + 2)
    plate = Image.new("RGBA", (plate_width, plate_height), (0, 0, 0, 255))
    destination = output / "taskbar/start.xpm"
    destination.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="nextstep-start-") as temp_dir:
        start_png = Path(temp_dir) / "start.png"
        canvas = Image.new("RGBA", (256, AUTHENTIC_START_HEIGHT),
                           (0, 0, 0, 0))
        # The cube and plate are independent flat pixel-art layers.  No
        # dilation or antialiasing touches the cube.
        canvas.alpha_composite(icon, (AUTHENTIC_START_PAD, 2))
        canvas.alpha_composite(plate, plate_origin)
        canvas.alpha_composite(core_layer, core_origin)
        opaque_alpha = lambda image: image.getchannel("A").point(
            lambda pixel: 255 if pixel >= 128 else 0
        ).getbbox()
        core_bbox = opaque_alpha(core_layer)
        if core_bbox is None:
            raise SystemExit("NeXT Start pixel face unexpectedly has no content")
        alpha_bbox = opaque_alpha(canvas)
        if alpha_bbox is None:
            raise SystemExit("NeXT Start canvas unexpectedly has no content")
        core_bbox_global = tuple(
            coordinate + (core_origin[0] if index % 2 == 0 else core_origin[1])
            for index, coordinate in enumerate(core_bbox)
        )
        plate_bbox_global = (
            plate_origin[0], plate_origin[1],
            plate_origin[0] + plate_width, plate_origin[1] + plate_height,
        )
        width = alpha_bbox[2] + AUTHENTIC_START_PAD
        canvas = canvas.crop((0, 0, width, AUTHENTIC_START_HEIGHT))
        canvas.save(start_png)

        converted = subprocess.run(
            [sys.executable, str(png2xpm), str(start_png), str(destination),
             "start_xpm"],
            check=True, capture_output=True, text=True,
        )
        if converted.stdout.strip():
            print(converted.stdout.strip())

    return {
        "canvas": f"{width}x{AUTHENTIC_START_HEIGHT}",
        "icon": f"{AUTHENTIC_START_ICON_WIDTH}x{AUTHENTIC_START_ICON_HEIGHT}",
        "icon_source": str(NEXT_LOGO_SVG_RELATIVE),
        "text": AUTHENTIC_START_TEXT,
        "font": "hand-authored 1px pixel matrices; mixed-case N/e/X/T; no vector font",
        "text_bbox": f"core=x={core_bbox_global[0]}..{core_bbox_global[2] - 1},y={core_bbox_global[1]}..{core_bbox_global[3] - 1},height={core_bbox_global[3] - core_bbox_global[1]}; plate=x={plate_bbox_global[0]}..{plate_bbox_global[2] - 1},y={plate_bbox_global[1]}..{plate_bbox_global[3] - 1},height={plate_bbox_global[3] - plate_bbox_global[1]}",
        "layer_offset": f"plate_origin=({plate_origin[0]},{plate_origin[1]}); core_origin=({core_origin[0]},{core_origin[1]}); icon_gap={AUTHENTIC_START_GAP}px; letter_gap={AUTHENTIC_START_PIXEL_GAP}px; plate_pad=2px",
        "outline": "none: deliberate black plate; colored pixels sit directly on it",
        "letter_colours": ",".join(f"{letter}={colour}" for letter, colour in letter_colours.items()),
        "letter_counts": ",".join(f"{letter}={letter_counts[letter]}px/1-component" for letter in AUTHENTIC_START_TEXT),
        "svg_finding": "facet-only SVG: four filled paths, no letter glyphs; e/T corrected; cube=flat three-facet matrix",
        "target": "taskbar/start.xpm",
    }


def write_buttons(donor: Path, output: Path, row: dict[str, str],
                  fallbacks: set[tuple[str, str]]) -> None:
    """Keep the donor's flat-margin construction for GNUstep reuse."""
    sources = {
        "close": "close", "minimize": "hide", "maximize": "maximize",
        "restore": "maximize-toggled", "rollup": "shade",
        "rolldown": "shade-toggled", "menuButton": "menu",
    }
    for state, suffix in (("active", "A"), ("inactive", "I")):
        for target, source_stem in sources.items():
            normal = read_xpm(donor / f"{source_stem}-{state}.xpm")
            pressed = read_xpm(donor / f"{source_stem}-pressed.xpm")
            normal_path = donor / f"{source_stem}-{state}.xpm"
            pressed_path = donor / f"{source_stem}-pressed.xpm"
            _, _, top = recolour_xpm(normal_path, row, state, "button", fallbacks)
            _, _, bottom = recolour_xpm(pressed_path, row, state, "button", fallbacks)
            if (normal.width, normal.height) != (19, 19) or (pressed.width, pressed.height) != (19, 19):
                raise SystemExit(f"caption button geometry changed in donor: {source_stem}")
            write_xpm(output / f"{target}{suffix}.xpm", [
                colour for line in top + bottom for colour in line
            ], top + bottom)


def tosh_colour_keys(path: Path) -> list[str]:
    keys = []
    for line in path.read_text(encoding="latin-1").splitlines():
        match = re.match(r"^(Color[A-Za-z0-9]+)=", line)
        if match:
            keys.append(match.group(1))
    if not keys:
        raise SystemExit(f"Tosh Color* checklist is empty: {path}")
    return keys


def contrast(row: dict[str, str], background: str) -> str:
    return row["black_color"] if rgb_luma(background) >= 128 else row["white_color"]


def colour_values(row: dict[str, str], authentic: bool = False,
                  button_style: str = "gray") -> dict[str, str]:
    face = row["base_color"]
    active = row["active_title"]
    light = row["lighter_color"]
    dark = row["darker_color"]
    frame = row["black_color"] if authentic else dark_chrome(dark)
    accent = row["scale_color"]
    face_text = contrast(row, face)
    active_text = contrast(row, active)
    accent_text = contrast(row, accent)
    if authentic:
        style = AUTHENTIC_BUTTON_STYLES.get(button_style)
        if style is None:
            raise SystemExit(f"unknown authentic button style: {button_style}")
        button_face = row[style["face"]]
        button_text = row[style["glyph"]]
        button_active = button_face
        button_active_text = button_text
    else:
        button_face = face
        button_text = face_text
        button_active = accent
        button_active_text = accent_text
    return {
        "ColorDialog": face,
        "ColorActiveBorder": frame,
        "ColorNormalBorder": frame,
        "ColorNormalTitleButton": button_face,
        "ColorNormalTitleButtonText": button_text,
        "ColorNormalButton": button_face,
        "ColorNormalButtonText": button_text,
        "ColorActiveButton": button_active,
        "ColorActiveButtonText": button_active_text,
        "ColorActiveTitleBar": active,
        "ColorNormalTitleBar": row["inactive_title"],
        "ColorActiveTitleBarText": active_text,
        "ColorNormalTitleBarText": face_text,
        "ColorNormalMinimizedWindow": face,
        "ColorNormalMinimizedWindowText": face_text,
        "ColorActiveMinimizedWindow": accent,
        "ColorActiveMinimizedWindowText": accent_text,
        "ColorNormalMenu": face,
        "ColorActiveMenuItem": accent,
        "ColorActiveMenuItemText": accent_text,
        "ColorNormalMenuItemText": face_text,
        "ColorDisabledMenuItemText": dark,
        "ColorMoveSizeStatus": face,
        "ColorMoveSizeStatusText": face_text,
        "ColorQuickSwitch": face,
        "ColorQuickSwitchText": face_text,
        "ColorDefaultTaskBar": face,
        "ColorNormalTaskBarApp": face,
        "ColorNormalTaskBarAppText": face_text,
        "ColorActiveTaskBarApp": accent,
        "ColorActiveTaskBarAppText": accent_text,
        "ColorMinimizedTaskBarApp": face,
        "ColorMinimizedTaskBarAppText": face_text,
        "ColorInvisibleTaskBarApp": dark,
        "ColorInvisibleTaskBarAppText": face_text,
        "ColorScrollBar": face,
        "ColorScrollBarArrow": light,
        "ColorScrollBarSlider": dark,
        "ColorListBox": face,
        "ColorListBoxText": face_text,
        "ColorListBoxSelection": accent,
        "ColorListBoxSelectionText": accent_text,
        "ColorToolTip": light,
        "ColorToolTipText": contrast(row, light),
        "ColorClock": face,
        "ColorClockText": face_text,
        "ColorApm": face,
        "ColorApmText": face_text,
        "ColorLabel": face,
        "ColorLabelText": face_text,
        "ColorInput": face,
        "ColorInputText": face_text,
        "ColorInputSelection": accent,
        "ColorInputSelectionText": accent_text,
    }


def write_default(path: Path, row: dict[str, str], skew: str, donor: Path,
                  tosh_keys: list[str], authentic: bool = False,
                  button_style: str = "gray") -> None:
    colours = colour_values(row, authentic=authentic,
                            button_style=button_style)
    missing = [key for key in tosh_keys if key not in colours]
    if missing:
        raise SystemExit(f"default.theme key derivation missing Tosh keys: {missing}")
    extra = sorted(set(colours) - set(tosh_keys))
    if extra:
        raise SystemExit(f"default.theme has unreviewed extra Color* keys: {extra}")
    lines = [
        "# Generated by redstone-9x-nextstep-borders-build; do not hand-edit.",
        f'ThemeDescription="NeXTSTEP Trial - {OUTPUTS[skew]}"',
        'ThemeAuthor="DotCortex; QTStepWMakerDefault xfwm4 donor"',
        "Look=pixmap",
        'Gradients=""',
        "TitleBarCentered=1" if authentic else "TitleBarCentered=0",
        "TitleBarJustify=50" if authentic else "",
        'TitleButtonsLeft="m"' if authentic else 'TitleButtonsLeft="s"',
        'TitleButtonsRight="x"' if authentic else 'TitleButtonsRight="ximr"',
        'TitleButtonsSupported="mx"' if authentic else 'TitleButtonsSupported="xmirhs"',
        "TaskBarShowStartMenu=1" if authentic else "",
        "ShowMenuButtonIcon=0",
        # Authentic Default has a 1px highlight, 19px slab, 1px shadow, and
        # 1px separator. Its 16px buttons use 2px top/left plus 4px physical
        # bottom/right margins; one latter pixel is the invisible shadow.
        "TitleBarHeight=23" if authentic else "TitleBarHeight=19",
        "TitleBarHorzOffset=0" if authentic else "TitleBarHorzOffset=2",
        "TitleBarVertOffset=0" if authentic else "TitleBarVertOffset=2",
        "BorderSizeX=1" if authentic else "BorderSizeX=3",
        "BorderSizeY=1" if authentic else "BorderSizeY=3",
        "CornerSizeX=1" if authentic else "CornerSizeX=3",
        "CornerSizeY=1" if authentic else "CornerSizeY=3",
        "DlgBorderSizeX=1" if authentic else "DlgBorderSizeX=3",
        "DlgBorderSizeY=1" if authentic else "DlgBorderSizeY=3",
        "ButtonX=16" if authentic else "ButtonX=19",
        "ButtonY=16" if authentic else "ButtonY=19",
        'TitleFontNameXft="Charcoal:size=8:bold"' if authentic else "",
    ]
    lines = [line for line in lines if line]
    lines.extend(f'{key}="{ice_colour(colours[key])}"' for key in tosh_keys)
    path.write_text("\n".join(lines) + "\n", encoding="latin-1")


def build(repo: Path, skew: str, button_style: str = "gray",
          margin_style: str = "nextstep-wrap") -> Path:
    palette_path = repo / PALETTE_RELATIVE
    donor = repo / DONOR_RELATIVE
    tosh = repo / TOSH_DEFAULT_RELATIVE
    if not palette_path.is_file():
        raise SystemExit(f"palette table missing: {palette_path}")
    if not donor.is_dir():
        raise SystemExit(f"QTStep xfwm4 donor missing: {donor}")
    if not tosh.is_file():
        raise SystemExit(f"Tosh key checklist missing: {tosh}")
    row = palette_row(json.loads(palette_path.read_text(encoding="utf-8")), skew)
    donor_title = read_xpm(donor / "title-1-active.xpm")
    donor_side = read_xpm(donor / "left-active.xpm")
    donor_corner = read_xpm(donor / "top-left-active.xpm")
    donor_button = read_xpm(donor / "close-active.xpm")
    if donor_title.height != 19 or donor_button.width != 19 or donor_button.height != 19:
        raise SystemExit("donor TitleBarHeight/button geometry is not the measured 19px contract")
    if donor_side.width != 1 or donor_side.height != 23 or donor_corner.width != 1 or donor_corner.height != 19:
        raise SystemExit("donor border-strip geometry changed; refuse to guess")
    donor_border = donor_side.colours[donor_side.pixels[0][0]]
    if donor_border is None:
        raise SystemExit("donor border pixel is transparent")
    output = repo / "linux/.icewm/themes" / OUTPUTS[skew]
    if output.exists() or output.is_symlink():
        if output.is_symlink() or not output.is_dir():
            output.unlink()
        else:
            shutil.rmtree(output)
    output.mkdir(parents=True)
    authentic = skew == "default"
    fallbacks: set[tuple[str, str]] = set()
    start_info: dict[str, str] | None = None
    if authentic:
        write_authentic_titles(donor, output, row)
        write_authentic_frames(output, row)
        write_authentic_buttons(output, row, button_style, margin_style)
        start_info = write_authentic_start(output, repo)
    else:
        write_titles(donor, output, row, fallbacks)
        write_frames(output, row)
        write_buttons(donor, output, row, fallbacks)
    tosh_keys = tosh_colour_keys(tosh)
    write_default(output / "default.theme", row, skew, donor, tosh_keys,
                  authentic=authentic, button_style=button_style)
    (output / "PROVENANCE").write_text(
        "NeXTSTEP/OpenStep trial border representative\n"
        f"Palette row: one_step_back.{'base' if skew == 'default' else skew}\n"
        + ("Focused title law: authentic NeXT black slab with white caption text; unfocused remains base face\n"
           if skew == "default" else "")
        + (f"Style mode: authentic-nextstep; 1px black frame; 1px highlight + 19px slab + 1px shadow + 1px separator; centered caption; 16px {button_style}-face buttons; no caption-text bevel\n"
           if authentic else "Style mode: gray GNUstep-reusable palette bevel\n")
        + f"xfwm4 donor: {DONOR_RELATIVE}\n"
        + "Donor measures: title 19px source; authentic title 23px; title-1 23px wide; title-2 4px wide; "
        + "side 1x23; corner 1x19; buttons 19x19\n"
        + ("IceWM authentic frame: 1px black window border; titlebar bevel is in title XPMs\n"
           if authentic else "IceWM trial frame: 1px contour + GTK face/highlight/shadow bevel\n")
        + (f"Authentic buttons: 23x46 stacked normal/pressed; 16px {button_style}-face art at x/y=3..18 except close shifted right to x=4..19 (row/column 0 bevel, slab rows/columns 1..2 clear, art 3..18, slab rows/columns 19..20, shadow row/column 21, black separator/phantom row/column 22; art row 18 supplies the phantom third black-under-button pixel in the active slab; close columns=slab 0..3, art 4..19, slab 20..21, edge 22); margin-style={margin_style}; bar rows continue through margins; 1px bevel + 1px black bottom/right outer shadow; corner square=(17,3); maximize=L edge, close=R edge; title L/R horizontal-only\n"
           if authentic else "")
        + (f"Taskbar Start: {start_info['target']} via IceWM taskbarStartImage; canvas={start_info['canvas']}; SVG raster={start_info['icon']} from {start_info['icon_source']}; text={start_info['text']}; font={start_info['font']}; bbox={start_info['text_bbox']}; {start_info['layer_offset']}; {start_info['outline']}; letters={start_info['letter_counts']}; SVG={start_info['svg_finding']}; facet colours={start_info['letter_colours']}\n"
           if start_info else "")
        + "Colour law: all donor colours map to palette roles; no donor icons or schemes\n"
        + "Builder: redstone-9x-nextstep-borders-build\n",
        encoding="utf-8",
    )
    print(f"skew={skew}")
    print(f"style={'authentic-nextstep' if authentic else 'gray-gnu-step-reusable'}")
    print(f"button_style={button_style if authentic else 'gray-reusable'}")
    print(f"button_margin_style={margin_style if authentic else 'gnustep-flat'}")
    print(
        f"palette=one_step_back.{'base' if skew == 'default' else skew}"
        + (" default_focused_title=black" if skew == "default" else "")
    )
    print(f"active_title_dominant={row['active_title']}")
    print(f"inactive_title_body={row['inactive_title']}")
    print(f"donor_border={donor_border} donor_side={donor_side.width}x{donor_side.height}")
    print(
        "frame_cross_section="
        + ("border:#000000" if authentic else
           f"contour:{dark_chrome(row['darker_color'])},"
           f"face:{row['base_color']},"
           f"highlight:{row['lighter_color']},"
           f"shadow:{row['darker_color']}")
    )
    print("title_row_budget=outer_frame:1,bevel_highlight:1,slab:20,bevel_shadow:1,separator:1,client:after" if authentic else "title_row_budget=gray-donor")
    print("font=Charcoal:size=8:bold (Xft; room profile Charcoal.ttf)" if authentic else "font=donor-default")
    print("metrics=TitleBarHeight:23 Button:16x16 logical (23x46 stacked; art x/y=3..18; slab rows/columns 19..20 plus art row/column 18 phantom black-under-button pixel; shadow row/column 21; separator row/column 22) Border:1" if authentic
          else "metrics=TitleBarHeight:19 Button:19x19 TrialBorder:3")
    if start_info:
        print("taskbar_start=" + ";".join(f"{key}:{value}" for key, value in start_info.items()))
    print(f"theme={output} files={sum(1 for path in output.iterdir() if path.is_file())}")
    if fallbacks:
        print("donor_fallbacks=" + ",".join(f"{name}:{colour}" for name, colour in sorted(fallbacks)))
    else:
        print("donor_fallbacks=none")
    return output


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo-root", default=None)
    parser.add_argument("--skew", choices=sorted(OUTPUTS), required=True)
    parser.add_argument("--button-style", choices=sorted(AUTHENTIC_BUTTON_STYLES),
                        default="gray")
    parser.add_argument("--button-margin-style", choices=sorted(BUTTON_MARGIN_STYLES),
                        default="nextstep-wrap")
    args = parser.parse_args()
    script_root = Path(__file__).resolve().parents[3]
    repo = Path(args.repo_root).expanduser().resolve() if args.repo_root else script_root
    build(repo, args.skew, args.button_style, args.button_margin_style)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
