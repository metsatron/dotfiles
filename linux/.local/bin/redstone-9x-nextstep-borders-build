#!/usr/bin/env python3
"""Build exactly one palette-responsive NeXTSTEP IceWM border trial."""

from __future__ import annotations

import argparse
import collections
import json
import re
import shutil
from pathlib import Path


DONOR_RELATIVE = Path("linux/.themes/QTStepWMakerDefault19p/xfwm4")
PALETTE_RELATIVE = Path("linux/.config/redstone-9x/nextstep-palettes.json")
TOSH_DEFAULT_RELATIVE = Path("linux/.icewm/themes/Tosh/default.theme")
OUTPUTS = {
    "base": "NeXTSTEP-Trial-OneStepBack-Base",
    "darkadobe": "NeXTSTEP-Trial-DarkAdobe",
    "default": "NeXTSTEP-Trial-Default",
}
REQUIRED_PALETTE_KEYS = (
    "base_color", "black_color", "darker_color", "lighter_color",
    "scale_color", "white_color",
)
XPM_HEADER = re.compile(r'^\s*"(\d+)\s+(\d+)\s+(\d+)\s+(\d+)"')
COLOUR_LINE = re.compile(r'\bc\s+(.+?)\s*$')
HEX = re.compile(r'^#[0-9a-fA-F]{6}$')


class Xpm:
    def __init__(self, width: int, height: int, colours: dict[str, str | None],
                 pixels: list[str]) -> None:
        self.width = width
        self.height = height
        self.colours = colours
        self.pixels = pixels


def quoted(line: str) -> str:
    start = line.find('"')
    end = line.rfind('"')
    if start < 0 or end <= start:
        raise ValueError(f"not an XPM string: {line!r}")
    return line[start + 1:end]


def read_xpm(path: Path) -> Xpm:
    lines = path.read_text(encoding="latin-1").splitlines()
    header_index = next(
        (index for index, line in enumerate(lines) if XPM_HEADER.match(line)),
        None,
    )
    if header_index is None:
        raise ValueError(f"XPM header missing: {path}")
    match = XPM_HEADER.match(lines[header_index])
    assert match is not None
    width, height, colour_count, cpp = map(int, match.groups())
    if cpp != 1:
        raise ValueError(f"unsupported XPM chars-per-pixel in {path}: {cpp}")
    colours: dict[str, str | None] = {}
    for line in lines[header_index + 1:header_index + 1 + colour_count]:
        value = quoted(line)
        symbol = value[:cpp]
        colour_match = COLOUR_LINE.search(value[cpp:])
        if colour_match is None:
            raise ValueError(f"XPM colour missing in {path}: {line}")
        colour = colour_match.group(1).split()[0]
        if colour.lower() == "none":
            colours[symbol] = None
        elif HEX.fullmatch(colour):
            colours[symbol] = colour.upper()
        else:
            raise ValueError(f"unsupported XPM colour in {path}: {colour}")
    pixel_start = header_index + 1 + colour_count
    pixels = [quoted(line) for line in lines[pixel_start:pixel_start + height]]
    if len(pixels) != height or any(len(row) != width for row in pixels):
        raise ValueError(f"incomplete XPM pixels: {path}")
    if any(symbol not in colours for row in pixels for symbol in row):
        raise ValueError(f"XPM pixel refers to an undeclared colour: {path}")
    return Xpm(width, height, colours, pixels)


def write_xpm(path: Path, colours: list[str | None], pixels: list[list[str | None]]) -> None:
    unique = list(dict.fromkeys(colours))
    symbols = ".+@#$%&*=-;:!?ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
    if None in unique:
        symbols = " " + symbols
    if len(unique) > len(symbols):
        raise ValueError(f"too many output colours for {path}: {len(unique)}")
    symbol_for = {colour: symbols[index] for index, colour in enumerate(unique)}
    width = len(pixels[0])
    height = len(pixels)
    lines = [
        "/* XPM */",
        f"static char *{path.stem.replace('-', '_')}_xpm[] = {{",
        f'"{width} {height} {len(unique)} 1",',
    ]
    for colour in unique:
        symbol = symbol_for[colour]
        encoded = "None" if colour is None else colour
        lines.append(f'"{symbol} c {encoded}",')
    for row in pixels[:-1]:
        lines.append('"' + "".join(symbol_for[colour] for colour in row) + '",')
    lines.append('"' + "".join(symbol_for[colour] for colour in pixels[-1]) + '"};')
    path.write_text("\n".join(lines) + "\n", encoding="latin-1")


def rgb_luma(colour: str) -> int:
    red, green, blue = (int(colour[index:index + 2], 16) for index in (1, 3, 5))
    return (299 * red + 587 * green + 114 * blue) // 1000


def ice_colour(colour: str) -> str:
    return f"rgb:{colour[1:3]}/{colour[3:5]}/{colour[5:7]}"


def dark_chrome(colour: str) -> str:
    # 2026-08-11 live verdict: a literal black outline was rejected.  The
    # single outer contour is dark chrome of the skew's face family: 50%
    # darker_color mixed toward black, never a fixed #000000 frame band.
    channels = [int(colour[index:index + 2], 16) // 2 for index in (1, 3, 5)]
    return "#" + "".join(f"{channel:02X}" for channel in channels)


def palette_row(data: dict, skew: str) -> dict[str, str]:
    # The authentic default NeXT trial is black-focused, but its unfocused
    # face and bevel remain the normal OneStepBack gray family.  Keep one
    # validated palette source and make the focused-title exception explicit.
    palette_skew = "base" if skew == "default" else skew
    raw = data.get("one_step_back", {}).get(palette_skew)
    if not isinstance(raw, dict):
        raise SystemExit(f"palette row is missing or ambiguous: one_step_back.{palette_skew}")
    missing = [key for key in REQUIRED_PALETTE_KEYS if key not in raw]
    if missing:
        raise SystemExit(f"palette row one_step_back.{palette_skew} is missing: {', '.join(missing)}")
    row = {key: str(raw[key]).lower() for key in REQUIRED_PALETTE_KEYS}
    for key, value in row.items():
        if not HEX.fullmatch(value):
            raise SystemExit(f"palette row one_step_back.{palette_skew} has invalid {key}: {value}")
    row.update({
        # WMakerDefault's focused body is a dark slab.  The differing
        # darker_color role is the deliberate palette-responsive title face.
        "active_title": row["darker_color"],
        "inactive_title": row["base_color"],
        "bright": row["lighter_color"] if skew == "darkadobe" else row["white_color"],
    })
    if skew == "default":
        row["active_title"] = row["black_color"]
    return row


def donor_colour_map(row: dict[str, str]) -> dict[str, str]:
    return {
        "#000000": row["black_color"],
        "#040004": row["black_color"],
        "#384246": row["base_color"],
        "#0D171B": row["darker_color"],
        "#434D51": row["scale_color"],
        "#FFFFFF": row["bright"],
        "#AEAAAE": row["base_color"],
        "#8D979B": row["lighter_color"],
        "#837F83": row["darker_color"],
        "#595559": row["darker_color"],
        "#4D575B": row["darker_color"],
        "#ACAAAC": row["lighter_color"],
        # This single source accent occurs in title-2-active.xpm; it is
        # donor-derived and is made responsive through the palette accent.
        "#40A740": row["scale_color"],
    }


def recolour_xpm(source: Path, row: dict[str, str], state: str, context: str,
                 fallbacks: set[tuple[str, str]]) -> tuple[int, int, list[list[str | None]]]:
    image = read_xpm(source)
    mapping = donor_colour_map(row)
    body_symbol: str | None = None
    if context == "title":
        interior = [
            symbol for line in image.pixels[2:-2] for symbol in line
            if image.colours[symbol] is not None
        ]
        body_symbol = collections.Counter(interior).most_common(1)[0][0]
    output: list[list[str | None]] = []
    for line in image.pixels:
        output_line: list[str | None] = []
        for symbol in line:
            old = image.colours[symbol]
            if old is None:
                output_line.append(None)
                continue
            if context == "title" and symbol == body_symbol:
                new = row["active_title"] if state == "active" else row["inactive_title"]
            else:
                new = mapping.get(old.upper())
                if new is None:
                    fallbacks.add((source.name, old.upper()))
                    new = old.upper()
            output_line.append(new)
        output.append(output_line)
    return image.width, image.height, output


def write_recoloured(source: Path, destination: Path, row: dict[str, str], state: str,
                     context: str, fallbacks: set[tuple[str, str]]) -> None:
    width, height, pixels = recolour_xpm(source, row, state, context, fallbacks)
    write_xpm(destination, [colour for line in pixels for colour in line], pixels)
    if (width, height) != (len(pixels[0]), len(pixels)):
        raise AssertionError(f"XPM size changed during recolour: {source}")


def title_sources() -> dict[str, str]:
    return {
        "B": "title-5", "T": "title-3", "S": "title-1",
        "L": "title-1", "R": "title-5", "M": "title-2", "P": "title-4",
    }


def write_titles(donor: Path, output: Path, row: dict[str, str],
                 fallbacks: set[tuple[str, str]]) -> None:
    for state, suffix in (("active", "A"), ("inactive", "I")):
        for stem, donor_stem in title_sources().items():
            source = donor / f"{donor_stem}-{state}.xpm"
            write_recoloured(source, output / f"title{suffix}{stem}.xpm", row,
                             state, "title", fallbacks)


def write_authentic_titles(donor: Path, output: Path,
                           row: dict[str, str]) -> None:
    """Emit the original NeXT titlebar: bevel the titlebar, not its text."""
    for state, suffix in (("active", "A"), ("inactive", "I")):
        title = row["active_title"] if state == "active" else row["inactive_title"]
        highlight = row["lighter_color"]
        shadow = row["darker_color"]
        for stem, donor_stem in title_sources().items():
            source = donor / f"{donor_stem}-{state}.xpm"
            image = read_xpm(source)
            pixels = [[title for _ in range(image.width)] for _ in range(image.height)]
            # One-pixel bevel around the titlebar itself.  Caption text is
            # drawn by IceWM over the flat interior and is never boxed here.
            pixels[0] = [highlight] * image.width
            pixels[-1] = [shadow] * image.width
            # IceWM assembles these pieces around the caption: only the
            # outermost L/R pieces may carry vertical bevel edges.  S/P/T/M/B
            # are interior joints and must remain seamless.
            if stem == "L":
                for y in range(1, image.height - 1):
                    pixels[y][0] = highlight
            elif stem == "R":
                for y in range(1, image.height - 1):
                    pixels[y][-1] = shadow
            write_xpm(output / f"title{suffix}{stem}.xpm",
                      [colour for line in pixels for colour in line], pixels)


def write_frames(output: Path, row: dict[str, str]) -> None:
    contour = dark_chrome(row["darker_color"])
    face = row["base_color"]
    highlight = row["lighter_color"]
    shadow = row["darker_color"]
    pixels = {
        # Cross-sections run from outside toward the window interior.
        "T": [[contour], [highlight], [face]],
        "L": [[contour, highlight, face]],
        "R": [[face, shadow, contour]],
        "B": [[face], [shadow], [contour]],
        "TL": [
            [contour, contour, contour],
            [contour, highlight, highlight],
            [contour, highlight, face],
        ],
        "TR": [
            [contour, contour, contour],
            [highlight, highlight, shadow],
            [face, face, contour],
        ],
        "BL": [
            [contour, highlight, face],
            [contour, shadow, shadow],
            [contour, contour, contour],
        ],
        "BR": [
            [face, face, contour],
            [shadow, shadow, contour],
            [contour, contour, contour],
        ],
    }
    for suffix in ("A", "I"):
        for prefix in ("frame", "dframe"):
            for stem, frame in pixels.items():
                write_xpm(
                    output / f"{prefix}{suffix}{stem}.xpm",
                    [colour for line in frame for colour in line],
                    frame,
                )


def write_authentic_frames(output: Path, row: dict[str, str]) -> None:
    """Emit the one-pixel black outer window frame for authentic NeXT."""
    black = row["black_color"]
    for suffix in ("A", "I"):
        for prefix in ("frame", "dframe"):
            for stem in ("T", "L", "R", "B", "TL", "TR", "BL", "BR"):
                write_xpm(output / f"{prefix}{suffix}{stem}.xpm",
                          [black], [[black]])


def authentic_button_pixels(row: dict[str, str], kind: str,
                            pressed: bool) -> list[list[str | None]]:
    """Build one 19px IceWM button frame with a 15px NeXT button inset.

    IceWM copies half of a stacked button pixmap into a widget exactly
    TitleBarHeight high.  The 15px button therefore sits at y=2..16 inside
    this 19px frame.  Its bevel occupies the first 14px; the final
    row/column are a distinct outer black shadow.  At button-local (13, 0),
    the one-pixel bevel-shadow corner is diagonal to that outer shadow and
    deliberately remains a single square.
    """
    size = 15
    black = row["black_color"]
    highlight = row["lighter_color"]
    shadow = row["darker_color"]
    glyph = row["white_color"]
    pixels = [[black for _ in range(size)] for _ in range(size)]
    for x in range(13):
        pixels[0][x] = highlight
    pixels[0][13] = shadow
    for y in range(1, 13):
        pixels[y][0] = highlight
        pixels[y][13] = shadow
    for x in range(1, 14):
        pixels[13][x] = shadow
    # x=14 and y=14 are the extra black outer shadow, distinct from shadow.
    for y in range(size):
        pixels[y][14] = black
    for x in range(size):
        pixels[14][x] = black

    offset = 1 if pressed else 0
    if kind == "maximize":
        for x in range(4 + offset, 11 + offset):
            if x < size - 1:
                pixels[4 + offset][x] = glyph
                pixels[10 + offset][x] = glyph
        for y in range(4 + offset, 11 + offset):
            if y < size - 1:
                pixels[y][4 + offset] = glyph
                pixels[y][10 + offset] = glyph
    elif kind == "close":
        for index in range(7):
            x = 4 + index + offset
            y = 4 + index + offset
            if x < size - 1 and y < size - 1:
                pixels[y][x] = glyph
            x = 10 - index + offset
            if x >= 1 and y < size - 1:
                pixels[y][x] = glyph
    frame = [[None for _ in range(size)] for _ in range(19)]
    for y, row_pixels in enumerate(pixels, start=2):
        frame[y] = row_pixels
    return frame


def write_authentic_buttons(output: Path, row: dict[str, str]) -> None:
    """Emit 15px black NeXT buttons as stacked 19px frames (15x38)."""
    targets = {
        "close": "close", "minimize": "minimize", "maximize": "maximize",
        "restore": "restore", "rollup": "rollup", "rolldown": "rolldown",
        "menuButton": "menuButton",
    }
    for target, kind in targets.items():
        glyph_kind = kind if kind in {"close", "maximize"} else ""
        normal = authentic_button_pixels(row, glyph_kind, pressed=False)
        pressed = authentic_button_pixels(row, glyph_kind, pressed=True)
        write_xpm(output / f"{target}A.xpm",
                  [colour for line in normal + pressed for colour in line],
                  normal + pressed)
        write_xpm(output / f"{target}I.xpm",
                  [colour for line in normal + pressed for colour in line],
                  normal + pressed)


def write_buttons(donor: Path, output: Path, row: dict[str, str],
                  fallbacks: set[tuple[str, str]]) -> None:
    sources = {
        "close": "close", "minimize": "hide", "maximize": "maximize",
        "restore": "maximize-toggled", "rollup": "shade",
        "rolldown": "shade-toggled", "menuButton": "menu",
    }
    for state, suffix in (("active", "A"), ("inactive", "I")):
        for target, source_stem in sources.items():
            normal = read_xpm(donor / f"{source_stem}-{state}.xpm")
            pressed = read_xpm(donor / f"{source_stem}-pressed.xpm")
            normal_path = donor / f"{source_stem}-{state}.xpm"
            pressed_path = donor / f"{source_stem}-pressed.xpm"
            _, _, top = recolour_xpm(normal_path, row, state, "button", fallbacks)
            _, _, bottom = recolour_xpm(pressed_path, row, state, "button", fallbacks)
            if (normal.width, normal.height) != (19, 19) or (pressed.width, pressed.height) != (19, 19):
                raise SystemExit(f"caption button geometry changed in donor: {source_stem}")
            write_xpm(output / f"{target}{suffix}.xpm", [
                colour for line in top + bottom for colour in line
            ], top + bottom)


def tosh_colour_keys(path: Path) -> list[str]:
    keys = []
    for line in path.read_text(encoding="latin-1").splitlines():
        match = re.match(r"^(Color[A-Za-z0-9]+)=", line)
        if match:
            keys.append(match.group(1))
    if not keys:
        raise SystemExit(f"Tosh Color* checklist is empty: {path}")
    return keys


def contrast(row: dict[str, str], background: str) -> str:
    return row["black_color"] if rgb_luma(background) >= 128 else row["white_color"]


def colour_values(row: dict[str, str], authentic: bool = False) -> dict[str, str]:
    face = row["base_color"]
    active = row["active_title"]
    light = row["lighter_color"]
    dark = row["darker_color"]
    frame = row["black_color"] if authentic else dark_chrome(dark)
    accent = row["scale_color"]
    face_text = contrast(row, face)
    active_text = contrast(row, active)
    accent_text = contrast(row, accent)
    button_face = row["black_color"] if authentic else face
    button_text = row["white_color"] if authentic else face_text
    button_active = row["black_color"] if authentic else accent
    button_active_text = row["white_color"] if authentic else accent_text
    return {
        "ColorDialog": face,
        "ColorActiveBorder": frame,
        "ColorNormalBorder": frame,
        "ColorNormalTitleButton": button_face,
        "ColorNormalTitleButtonText": button_text,
        "ColorNormalButton": button_face,
        "ColorNormalButtonText": button_text,
        "ColorActiveButton": button_active,
        "ColorActiveButtonText": button_active_text,
        "ColorActiveTitleBar": active,
        "ColorNormalTitleBar": row["inactive_title"],
        "ColorActiveTitleBarText": active_text,
        "ColorNormalTitleBarText": face_text,
        "ColorNormalMinimizedWindow": face,
        "ColorNormalMinimizedWindowText": face_text,
        "ColorActiveMinimizedWindow": accent,
        "ColorActiveMinimizedWindowText": accent_text,
        "ColorNormalMenu": face,
        "ColorActiveMenuItem": accent,
        "ColorActiveMenuItemText": accent_text,
        "ColorNormalMenuItemText": face_text,
        "ColorDisabledMenuItemText": dark,
        "ColorMoveSizeStatus": face,
        "ColorMoveSizeStatusText": face_text,
        "ColorQuickSwitch": face,
        "ColorQuickSwitchText": face_text,
        "ColorDefaultTaskBar": face,
        "ColorNormalTaskBarApp": face,
        "ColorNormalTaskBarAppText": face_text,
        "ColorActiveTaskBarApp": accent,
        "ColorActiveTaskBarAppText": accent_text,
        "ColorMinimizedTaskBarApp": face,
        "ColorMinimizedTaskBarAppText": face_text,
        "ColorInvisibleTaskBarApp": dark,
        "ColorInvisibleTaskBarAppText": face_text,
        "ColorScrollBar": face,
        "ColorScrollBarArrow": light,
        "ColorScrollBarSlider": dark,
        "ColorListBox": face,
        "ColorListBoxText": face_text,
        "ColorListBoxSelection": accent,
        "ColorListBoxSelectionText": accent_text,
        "ColorToolTip": light,
        "ColorToolTipText": contrast(row, light),
        "ColorClock": face,
        "ColorClockText": face_text,
        "ColorApm": face,
        "ColorApmText": face_text,
        "ColorLabel": face,
        "ColorLabelText": face_text,
        "ColorInput": face,
        "ColorInputText": face_text,
        "ColorInputSelection": accent,
        "ColorInputSelectionText": accent_text,
    }


def write_default(path: Path, row: dict[str, str], skew: str, donor: Path,
                  tosh_keys: list[str], authentic: bool = False) -> None:
    colours = colour_values(row, authentic=authentic)
    missing = [key for key in tosh_keys if key not in colours]
    if missing:
        raise SystemExit(f"default.theme key derivation missing Tosh keys: {missing}")
    extra = sorted(set(colours) - set(tosh_keys))
    if extra:
        raise SystemExit(f"default.theme has unreviewed extra Color* keys: {extra}")
    lines = [
        "# Generated by redstone-9x-nextstep-borders-build; do not hand-edit.",
        f'ThemeDescription="NeXTSTEP Trial - {OUTPUTS[skew]}"',
        'ThemeAuthor="DotCortex; QTStepWMakerDefault xfwm4 donor"',
        "Look=pixmap",
        'Gradients=""',
        "TitleBarCentered=1" if authentic else "TitleBarCentered=0",
        "TitleBarJustify=50" if authentic else "",
        'TitleButtonsLeft="m"' if authentic else 'TitleButtonsLeft="s"',
        'TitleButtonsRight="x"' if authentic else 'TitleButtonsRight="ximr"',
        'TitleButtonsSupported="mx"' if authentic else 'TitleButtonsSupported="xmirhs"',
        "ShowMenuButtonIcon=0",
        # 19 is read from title XPMs. Authentic 15px buttons leave 2px above
        # and below inside the 19px titlebar; gray mode retains its 19px art.
        "TitleBarHeight=19",
        "TitleBarHorzOffset=0" if authentic else "TitleBarHorzOffset=2",
        "TitleBarVertOffset=0" if authentic else "TitleBarVertOffset=2",
        "BorderSizeX=1" if authentic else "BorderSizeX=3",
        "BorderSizeY=1" if authentic else "BorderSizeY=3",
        "CornerSizeX=1" if authentic else "CornerSizeX=3",
        "CornerSizeY=1" if authentic else "CornerSizeY=3",
        "DlgBorderSizeX=1" if authentic else "DlgBorderSizeX=3",
        "DlgBorderSizeY=1" if authentic else "DlgBorderSizeY=3",
        "ButtonX=15" if authentic else "ButtonX=19",
        "ButtonY=15" if authentic else "ButtonY=19",
    ]
    lines = [line for line in lines if line]
    lines.extend(f'{key}="{ice_colour(colours[key])}"' for key in tosh_keys)
    path.write_text("\n".join(lines) + "\n", encoding="latin-1")


def build(repo: Path, skew: str) -> Path:
    palette_path = repo / PALETTE_RELATIVE
    donor = repo / DONOR_RELATIVE
    tosh = repo / TOSH_DEFAULT_RELATIVE
    if not palette_path.is_file():
        raise SystemExit(f"palette table missing: {palette_path}")
    if not donor.is_dir():
        raise SystemExit(f"QTStep xfwm4 donor missing: {donor}")
    if not tosh.is_file():
        raise SystemExit(f"Tosh key checklist missing: {tosh}")
    row = palette_row(json.loads(palette_path.read_text(encoding="utf-8")), skew)
    donor_title = read_xpm(donor / "title-1-active.xpm")
    donor_side = read_xpm(donor / "left-active.xpm")
    donor_corner = read_xpm(donor / "top-left-active.xpm")
    donor_button = read_xpm(donor / "close-active.xpm")
    if donor_title.height != 19 or donor_button.width != 19 or donor_button.height != 19:
        raise SystemExit("donor TitleBarHeight/button geometry is not the measured 19px contract")
    if donor_side.width != 1 or donor_side.height != 23 or donor_corner.width != 1 or donor_corner.height != 19:
        raise SystemExit("donor border-strip geometry changed; refuse to guess")
    donor_border = donor_side.colours[donor_side.pixels[0][0]]
    if donor_border is None:
        raise SystemExit("donor border pixel is transparent")
    output = repo / "linux/.icewm/themes" / OUTPUTS[skew]
    if output.exists() or output.is_symlink():
        if output.is_symlink() or not output.is_dir():
            output.unlink()
        else:
            shutil.rmtree(output)
    output.mkdir(parents=True)
    authentic = skew == "default"
    fallbacks: set[tuple[str, str]] = set()
    if authentic:
        write_authentic_titles(donor, output, row)
        write_authentic_frames(output, row)
        write_authentic_buttons(output, row)
    else:
        write_titles(donor, output, row, fallbacks)
        write_frames(output, row)
        write_buttons(donor, output, row, fallbacks)
    tosh_keys = tosh_colour_keys(tosh)
    write_default(output / "default.theme", row, skew, donor, tosh_keys,
                  authentic=authentic)
    (output / "PROVENANCE").write_text(
        "NeXTSTEP/OpenStep trial border representative\n"
        f"Palette row: one_step_back.{'base' if skew == 'default' else skew}\n"
        + ("Focused title law: authentic NeXT black slab with white caption text; unfocused remains base face\n"
           if skew == "default" else "")
        + ("Style mode: authentic-nextstep; 1px black frame; 1px titlebar bevel; centered caption; 15px black buttons; no caption-text bevel\n"
           if authentic else "Style mode: gray GNUstep-reusable palette bevel\n")
        + f"xfwm4 donor: {DONOR_RELATIVE}\n"
        + "Donor measures: title 19px; title-1 23x19; title-2 4x19; "
        + "side 1x23; corner 1x19; buttons 19x19\n"
        + ("IceWM authentic frame: 1px black window border; titlebar bevel is in title XPMs\n"
           if authentic else "IceWM trial frame: 1px contour + GTK face/highlight/shadow bevel\n")
        + ("Authentic buttons: 15x38 stacked normal/pressed; 15px art at y=2..16 in each 19px frame; 1px bevel + 1px black bottom/right outer shadow; corner square=(13,0)\n"
           if authentic else "")
        + "Colour law: all donor colours map to palette roles; no icons or schemes\n"
        + "Builder: redstone-9x-nextstep-borders-build\n",
        encoding="utf-8",
    )
    print(f"skew={skew}")
    print(f"style={'authentic-nextstep' if authentic else 'gray-gnu-step-reusable'}")
    print(
        f"palette=one_step_back.{'base' if skew == 'default' else skew}"
        + (" default_focused_title=black" if skew == "default" else "")
    )
    print(f"active_title_dominant={row['active_title']}")
    print(f"inactive_title_body={row['inactive_title']}")
    print(f"donor_border={donor_border} donor_side={donor_side.width}x{donor_side.height}")
    print(
        "frame_cross_section="
        + ("border:#000000" if authentic else
           f"contour:{dark_chrome(row['darker_color'])},"
           f"face:{row['base_color']},"
           f"highlight:{row['lighter_color']},"
           f"shadow:{row['darker_color']}")
    )
    print("metrics=TitleBarHeight:19 Button:15x15 logical (15x38 stacked; 2px inset per frame) Border:1" if authentic
          else "metrics=TitleBarHeight:19 Button:19x19 TrialBorder:3")
    print(f"theme={output} files={sum(1 for path in output.iterdir() if path.is_file())}")
    if fallbacks:
        print("donor_fallbacks=" + ",".join(f"{name}:{colour}" for name, colour in sorted(fallbacks)))
    else:
        print("donor_fallbacks=none")
    return output


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo-root", default=None)
    parser.add_argument("--skew", choices=sorted(OUTPUTS), required=True)
    args = parser.parse_args()
    script_root = Path(__file__).resolve().parents[3]
    repo = Path(args.repo_root).expanduser().resolve() if args.repo_root else script_root
    build(repo, args.skew)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
