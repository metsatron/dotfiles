#!/usr/bin/env bash
# [[file:../../../package-pip.org::*Nanobot Telegram runtime (Linux, uv-managed)][Nanobot Telegram runtime (Linux, uv-managed):11]]
# ~/DotCortex/linux/.local/bin/nanobot-health
set -euo pipefail

WORKSPACE="${NANOBOT_WORKSPACE:-$HOME/HelmCortex/FORGE/brain/nanobot}"
VENV="${NANOBOT_VENV:-$WORKSPACE/.venv}"
CONFIG_DIR="${NANOBOT_CONFIG_DIR:-$HOME/.config/nanobot-telegram}"
CONFIG="${NANOBOT_CONFIG:-$CONFIG_DIR/config.json}"

if [ ! -x "$VENV/bin/nanobot" ]; then
    echo "nanobot: MISSING ($VENV); run loom nanobot:apply"
    exit 1
fi

"$VENV/bin/nanobot" --version
"$VENV/bin/python" -c 'import telegram; print("telegram adapter", telegram.__version__)'
printf 'workspace: %s\nconfig: %s\n' "$WORKSPACE" "$CONFIG"
if [ -r "$CONFIG" ]; then
    stat -c 'config mode: %a' "$CONFIG"
    "$VENV/bin/python" - "$CONFIG" <<'PY'
import json
import sys
from pathlib import Path

data = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
tools = data.get("tools", {})
servers = tools.get("mcpServers", {})
print(f"workspace restriction: {tools.get('restrictToWorkspace')}")
print(f"exec sandbox: {tools.get('exec', {}).get('sandbox')!r}")
print("mcp servers: " + ", ".join(sorted(servers)))
PY
else
    echo "config: MISSING"
    exit 1
fi
# Nanobot Telegram runtime (Linux, uv-managed):11 ends here
