#!/bin/bash
# redstone-9x-serenity-themes-import — rebuild all 32 SerenityOS variants.
set -euo pipefail
NEX="${HOME}/HelmCortex/NEXUS/sanctuaries/sanctuary-redstone-9x/themes"
SER="${NEX}/serenity/Base/res/themes"; RET="${NEX}/serenity-retired"
[[ -d "${SER}" && -d "${RET}" ]] || { echo "ERROR: serenity sources missing under ${NEX} — NEXUS archive not reachable" >&2; exit 1; }
TMP="$(mktemp -d)"; trap 'rm -rf "${TMP}"' EXIT
python3 - "${SER}" "${RET}" "${TMP}" <<'PYSER'
import sys, os, re, glob
ser, ret, out = sys.argv[1], sys.argv[2], sys.argv[3]
def slug(s):
    return s.lower().replace("'", '').replace(' ', '-')
inis = {}
for d in (ser, ret):
    for p in glob.glob(os.path.join(d, '*.ini')):
        inis[slug(os.path.splitext(os.path.basename(p))[0])] = p
schemes = sorted(glob.glob(os.path.expanduser(
    '~/DotCortex/linux/.config/redstone-9x/schemes/serenity-*.scheme')))
missing, rows = [], []
for s in schemes:
    sid = os.path.splitext(os.path.basename(s))[0]
    key = sid[len('serenity-'):]
    p = inis.get(key)
    if p is None:
        missing.append(sid); continue
    m = re.search(r'ICEWM_THEME="([^"]+)"', open(s).read())
    tname = m.group(1).replace('-', ' ') if m else 'Serenity ' + key.title()
    rows.append((p, tname, sid))
if missing:
    raise SystemExit(f"FATAL: no source .ini for: {missing}")
with open(os.path.join(out, 'manifest.tsv'), 'w') as f:
    for p, tn, sid in rows:
        f.write(f'{p}\t{tn}\t{sid}\n')
print(f"matched {len(rows)} serenity variants to sources")
PYSER
while IFS=$'\t' read -r path tname sid; do
  echo "== ${sid}"
  redstone-9x-theme-convert "${path}" "${tname}" "${sid}"
done < "${TMP}/manifest.tsv"
# Per-variant Start buttons (LadyBall on the variant's own face) — the
# menu-buttons/ tree is a separate delivery from the theme dirs and must be
# regenerated with the schemes (caught live 2026-08-07).
redstone-9x-start-recolor --all
echo "serenity variants imported"
