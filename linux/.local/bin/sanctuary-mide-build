#!/usr/bin/env bash
# Source build: sanctuary-mide-build

# Host-side build driver following the =sanctuary-cde-build= pattern: an inner script heredoc executed through =sanctuary-exec= inside the container. Build order is Osiris 2.4.4 (meson), then MiDesktop =libs= → =base= → =utils= (CMake + Ninja, =CMAKE_BUILD_TYPE=Debug= per upstream README). Each stage is guarded by its own sentinel file inside =/opt/kde1= and the whole script is safe to re-run; a re-run after success is a fast no-op. Upstream notes CMake may warn about missing xcb/xkb/libtiff even when they are present — ignorable as long as compilation succeeds.


# [[file:../../../sanctuary-mide.org::*Source build: sanctuary-mide-build][Source build: sanctuary-mide-build:1]]
# Build Osiris 2.4.4 + MiDesktop 1.2 from source inside sanctuary-mide.
# Run once from the host: sanctuary-mide-build
# Sources: https://centre.libranext.com/libranext/{osiris,mide}
set -euo pipefail

usage() {
  cat <<EOF
sanctuary-mide-build - build Osiris + MiDesktop inside sanctuary-mide

Usage: sanctuary-mide-build
       sanctuary-mide-build -h | --help

No arguments. Clones, compiles, and installs the Osiris toolkit (2.4.4)
and MiDesktop (branch 1.2: libs, base, utils) into /opt/kde1 — a bind
volume backed by the host at
~/.local/share/dotcortex/guests/sanctuary-mide/opt-kde1, so the install
and its stage sentinels survive container recreation. Idempotent:
completed stages are skipped via sentinel files.
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if (( $# > 0 )); then
  usage >&2
  exit 1
fi

OSIRIS_TAG="2.4.4"
MIDE_BRANCH="1.2"
SANCTUARY="sanctuary-mide"
GUIX_PROFILES="${HOME}/.guix-extra-profiles"

# Heredoc builds the inner script — outer-shell vars (OSIRIS_TAG, MIDE_BRANCH,
# GUIX_PROFILES) expand at heredoc time; inner-shell vars are deferred via \$.
INNER_SCRIPT=$(cat <<INNER_EOF
set -eo pipefail

PREFIX=/opt/kde1
SRC=\${HOME}/.local/share/mide-src

# Pre-declare vars the Guix profile scripts append to — they run under set -u
# semantics in some layers and must never hit an unbound variable.
export PKG_CONFIG_PATH="\${PKG_CONFIG_PATH:-}"
export LD_LIBRARY_PATH="\${LD_LIBRARY_PATH:-}"
export CMAKE_PREFIX_PATH="\${CMAKE_PREFIX_PATH:-}"

GUIX_PROFILE=${GUIX_PROFILES}/desktop-common/desktop-common
. \${GUIX_PROFILE}/etc/profile
GUIX_PROFILE=${GUIX_PROFILES}/sanctuary-mide/sanctuary-mide
. \${GUIX_PROFILE}/etc/profile
export CURL_CA_BUNDLE=\${GIT_SSL_CAINFO}

if [ ! -d "\${PREFIX}" ] || [ ! -w "\${PREFIX}" ]; then
  echo "\${PREFIX} is missing or not writable — the opt-kde1 bind volume is absent." >&2
  echo "Recreate the container: distrobox-sanctuaries-create sanctuary-mide" >&2
  exit 1
fi

# Single merged prefix: Osiris and MiDesktop both live in /opt/kde1
# (KDE1-era merged QTDIR/KDEDIR convention).
export QTDIR=\${PREFIX}
export KDEDIR=\${PREFIX}
export CMAKE_PREFIX_PATH=\${PREFIX}\${CMAKE_PREFIX_PATH:+:\${CMAKE_PREFIX_PATH}}
export PKG_CONFIG_PATH=\${PREFIX}/lib/pkgconfig\${PKG_CONFIG_PATH:+:\${PKG_CONFIG_PATH}}
# Osiris (meson, --libdir=lib) installs to lib; MiDesktop (CMake) detects
# lib64 — both are live library dirs in this prefix.
export LD_LIBRARY_PATH=\${PREFIX}/lib:\${PREFIX}/lib64\${LD_LIBRARY_PATH:+:\${LD_LIBRARY_PATH}}
export PATH=\${PREFIX}/bin:\${PATH}

mkdir -p "\${SRC}"
cd "\${SRC}"

if [ ! -d osiris ]; then
  echo "Cloning Osiris ${OSIRIS_TAG}..."
  git clone --depth 1 --branch ${OSIRIS_TAG} https://centre.libranext.com/libranext/osiris.git
fi
if [ ! -d mide ]; then
  echo "Cloning MiDesktop ${MIDE_BRANCH}..."
  git clone --depth 1 --branch ${MIDE_BRANCH} https://centre.libranext.com/libranext/mide.git
fi

# ── Stage 1: Osiris toolkit (meson) ─────────────────────────────────────────
if [ ! -f "\${PREFIX}/.sentinel-osiris-${OSIRIS_TAG}" ]; then
  echo "Building Osiris ${OSIRIS_TAG}..."
  cd "\${SRC}/osiris"
  # Osiris' post-install script writes /etc/ld.so.conf.d and /etc/profile.d,
  # which are root-owned container-layer paths an unprivileged sanctuary user
  # cannot touch — and unnecessary here: the launcher and this build export
  # PATH/LD_LIBRARY_PATH explicitly. Neutralize it (idempotent).
  if ! grep -q 'DotCortex: skipped' _install_generate_ldconfig_profile.sh; then
    sed -i '1a exit 0 # DotCortex: skipped — /etc unwritable in sanctuary; env set by launcher' \
      _install_generate_ldconfig_profile.sh
  fi
  # --libdir=lib pins the meson libdir so PKG_CONFIG_PATH/LD_LIBRARY_PATH above
  # stay correct regardless of platform-detected multiarch defaults.
  meson setup build --prefix="\${PREFIX}" --libdir=lib
  ninja -C build
  ninja -C build install
  touch "\${PREFIX}/.sentinel-osiris-${OSIRIS_TAG}"
else
  echo "Osiris ${OSIRIS_TAG} already installed (sentinel present)"
fi

# MiDesktop's OsirisMacros.cmake hardcodes /opt/osiris/bin/moc; Osiris is
# co-installed in /opt/kde1 here — repoint it (idempotent).
sed -i 's|/opt/osiris/bin/moc|/opt/kde1/bin/moc|g' \
  "\${SRC}/mide/libs/cmake/OsirisMacros.cmake"
# libs installs its CMake modules (FindKDE1.cmake etc.) into CMAKE_ROOT and an
# ld.so.conf.d snippet into /etc — the former is the read-only Guix store, the
# latter is disposable container layer. Keep both inside the prefix; base and
# utils get the module dir via -DCMAKE_MODULE_PATH below. (idempotent)
sed -i \
  -e 's|DESTINATION \${CMAKE_ROOT}/Modules)|DESTINATION \${CMAKE_INSTALL_PREFIX}/share/cmake/Modules)|' \
  -e 's|DESTINATION "/etc/ld.so.conf.d/")|DESTINATION "\${CMAKE_INSTALL_PREFIX}/etc/ld.so.conf.d/")|' \
  "\${SRC}/mide/libs/CMakeLists.txt"
# base likewise installs a profile.d snippet and a display-manager xsession
# entry to absolute system paths — unwritable and pointless in the sanctuary
# (the launcher execs startmidesktop directly). Keep them in the prefix.
sed -i \
  -e 's|DESTINATION "/etc/profile.d/"|DESTINATION "\${CMAKE_INSTALL_PREFIX}/etc/profile.d/"|' \
  -e 's|DESTINATION "/usr/share/xsessions/"|DESTINATION "\${CMAKE_INSTALL_PREFIX}/share/xsessions/"|' \
  "\${SRC}/mide/base/CMakeLists.txt"

# kwm's init-phase X error handler (base/kwm/main.C) aborts the whole window
# manager on ANY X error except BadWindow/BadColor. In a nested Xephyr, kwm
# intermittently gets a transient X_CopyArea(0x0): BadDrawable while building a
# titlebar decoration whose pixmap momentarily loads as 0x0 — one async error
# then kills the session (observed 2026-07-30). Extend the existing ignore list
# to also tolerate BadDrawable/BadPixmap during init, exactly as it already
# tolerates BadWindow/BadColor. Idempotent (guarded); invalidate the base
# sentinel so kwm is rebuilt when the patch is first applied.
if ! grep -q 'DotCortex: tolerate transient pixmap' "\${SRC}/mide/base/kwm/main.C"; then
  # NB: use '#' as the sed delimiter — the C pattern contains '||', which would
  # collide with a '|' delimiter and mis-parse the command.
  sed -i 's#e->error_code == BadWindow || e->error_code == BadColor))#e->error_code == BadWindow || e->error_code == BadColor || e->error_code == BadDrawable || e->error_code == BadPixmap)) /* DotCortex: tolerate transient pixmap errors during init */#' \
    "\${SRC}/mide/base/kwm/main.C"
  rm -f "\${PREFIX}/.sentinel-mide-base"
fi

# kcmdisplay's wallpaper selector carries a KDE1-era inverted condition: a
# real image is written with UseWallpaper=false, while "No wallpaper" enters
# the image-loading branch. Correct that one branch at the upstream source
# boundary and rebuild the base stage so Control Center's Apply action reaches
# kbgndwm with the intended wallpaper flag. Idempotent and sentinel-guarded.
KDISPLAY_BG_SRC="\${SRC}/mide/base/kcontrol/display/backgnd.cpp"
if ! grep -q 'DotCortex: fix inverted wallpaper selection' "\${KDISPLAY_BG_SRC}"; then
  sed -i 's|if ( filename != i18n("No wallpaper"))|if ( filename == i18n("No wallpaper")) /* DotCortex: fix inverted wallpaper selection */|' \
    "\${KDISPLAY_BG_SRC}"
  rm -f "\${PREFIX}/.sentinel-mide-base"
fi

# ── Stages 2-4: MiDesktop libs → base → utils (CMake + Ninja) ───────────────
for section in libs base utils; do
  if [ -f "\${PREFIX}/.sentinel-mide-\${section}" ]; then
    echo "MiDesktop \${section} already installed (sentinel present)"
    continue
  fi
  echo "Building MiDesktop \${section}..."
  cd "\${SRC}/mide/\${section}"
  mkdir -p build
  cd build
  # MiDesktop's bundled FindOsiris.cmake searches only the hardcoded
  # /opt/osiris prefix; point it at the co-installed /opt/kde1 tree instead.
  cmake -G Ninja \
    -DCMAKE_INSTALL_PREFIX="\${PREFIX}" \
    -DCMAKE_BUILD_TYPE=Debug \
    -DCMAKE_PREFIX_PATH="\${PREFIX}" \
    -DOSIRIS_INCLUDE_DIR="\${PREFIX}/include/osiris" \
    -DOSIRIS_LIBRARY_DIR="\${PREFIX}/lib" \
    -DCMAKE_MODULE_PATH="\${PREFIX}/share/cmake/Modules" \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    ..
  ninja
  ninja install
  touch "\${PREFIX}/.sentinel-mide-\${section}"
done

# MiDE's KWrite target installs the executable but leaves its KDE1 artwork in
# the source tree.  Project the three source-size variants into the persistent
# prefix so the declarative launcher can use the real Advanced Editor icon
# instead of a generic document fallback after a clean build or recreation.
KW_SRC="\${SRC}/mide/utils/kwrite"
if [ -f "\${KW_SRC}/kwrite.xpm" ]; then
  mkdir -p "\${PREFIX}/share/icons/large" "\${PREFIX}/share/icons/mini"
  cp -f "\${KW_SRC}/kwrite.xpm" "\${PREFIX}/share/icons/kwrite.xpm"
  for size in large mini; do
    if [ -f "\${KW_SRC}/\${size}-kwrite.xpm" ]; then
      cp -f "\${KW_SRC}/\${size}-kwrite.xpm" \
        "\${PREFIX}/share/icons/\${size}/kwrite.xpm"
    fi
  done
fi

# KDE1's documentation installer uses the locale tree (currently en), while
# kdehelp's original runtime resolves its startup page through the historical
# default locale alias. Keep that alias in the persistent prefix so the help
# browser can find its own bundled documentation after a build or container
# recreation.
DOC_ROOT="\${PREFIX}/share/doc/HTML"
if [ -d "\${DOC_ROOT}/en" ] && [ ! -e "\${DOC_ROOT}/default" ]; then
  ln -s en "\${DOC_ROOT}/default"
fi

# ── Stage 5: selected KDE 1 historical applications ───────────────────────
# MiDE's preserved tree contains only KWrite.  These six applications come
# from the KDE historical repositories: their CMake files are close enough to
# MiDE's Osiris port to build with a small compatibility shim and three narrow
# Qt2 API edits.  Keep the source and build tree in the persistent guest-home
# volume so a container recreation does not discard the recovered applications.
if [ ! -f "\${PREFIX}/.sentinel-mide-archived-apps-kshisen" ]; then
  echo "Building selected KDE 1 historical applications..."
  ARCHIVE_SRC="\${SRC}/archived-kde1-upstream"
  mkdir -p "\${ARCHIVE_SRC}"

  fetch_archived_repo() {
    name="\$1"
    url="\$2"
    commit="\$3"
    repo="\${ARCHIVE_SRC}/\${name}"
    if [ ! -d "\${repo}/.git" ]; then
      if [ -e "\${repo}" ]; then
        echo "\${repo} exists but is not a Git checkout — refusing to replace it." >&2
        exit 1
      fi
      git clone --depth 1 "\${url}" "\${repo}"
    fi
    git -C "\${repo}" remote set-url origin "\${url}"
    git -C "\${repo}" fetch --depth 1 origin "\${commit}"
    git -C "\${repo}" checkout --detach "\${commit}"
  }

  fetch_archived_repo kde1-kdegames \
    https://invent.kde.org/historical/kde1-kdegames.git \
    b2b0d3aefc92ed9150babfad7e30a0c0054dc250
  fetch_archived_repo kde1-kdemultimedia \
    https://invent.kde.org/historical/kde1-kdemultimedia.git \
    f38454787b319382a7298de4b85a5f9e7dda5ff6

  # KDE's archived CMake conversion retains Qt1 macro and target names.  MiDE
  # exposes the equivalent Osiris generators and library through FindKDE1.
  mkdir -p "\${ARCHIVE_SRC}/cmake" "\${ARCHIVE_SRC}/probe"
  cat >"\${ARCHIVE_SRC}/cmake/Qt1Macros.cmake" <<'ARCHIVE_SHIM_EOF'
include_guard(GLOBAL)

macro(QT1_WRAP_MOC outfiles)
  OSIRIS_WRAP_MOC(\${outfiles} \${ARGN})
endmacro()

macro(QT1_WRAP_CPP outfiles)
  OSIRIS_WRAP_CPP(\${outfiles} \${ARGN})
endmacro()
ARCHIVE_SHIM_EOF

  cat >"\${ARCHIVE_SRC}/probe/CMakeLists.txt" <<'ARCHIVE_PROBE_EOF'
cmake_minimum_required(VERSION 3.16)
project(mide_archived_kde1_probe CXX)
set(CMAKE_INCLUDE_CURRENT_DIR ON)
set(CMAKE_CXX_FLAGS "\${CMAKE_CXX_FLAGS} -fpermissive -std=c++98 -Wno-write-strings")

find_package(KDE1 REQUIRED)
include(Qt1Macros)
include(KDE1Macros)
include(KDE1InstallDirs)
include_directories(\${OSIRIS_INCLUDE_DIR})
include_directories(\${CMAKE_BINARY_DIR})
file(WRITE "\${CMAKE_BINARY_DIR}/config.h"
  "/* Minimal config header for the archived KDE1 probe. */\\n")

if(NOT TARGET Qt::Qt1)
  add_library(Qt::Qt1 INTERFACE IMPORTED GLOBAL)
  set_property(TARGET Qt::Qt1 PROPERTY INTERFACE_LINK_LIBRARIES
    "\${OSIRIS_LIBRARIES}")
endif()

if(NOT APP_SOURCE)
  message(FATAL_ERROR "APP_SOURCE must point at one archived application")
endif()
add_subdirectory("\${APP_SOURCE}" app)
ARCHIVE_PROBE_EOF

  # These edits are intentionally bounded to targets that have been compiled
  # successfully in the live MiDE prefix.  They are idempotent across reruns.
  kblackbox_src="\${ARCHIVE_SRC}/kde1-kdegames/kblackbox/kbbgame.cpp"
  if ! grep -q 'QMessageBox::Ok, trans->translate' "\${kblackbox_src}"; then
    sed -i 's/mb\.setButtonText( trans->translate(/mb.setButtonText(QMessageBox::Ok, trans->translate(/g' \
      "\${kblackbox_src}"
  fi
  kmines_src="\${ARCHIVE_SRC}/kde1-kdegames/kmines/main.cpp"
  if ! grep -q 'QEvent::MouseButtonPress' "\${kmines_src}"; then
    sed -i 's/e->type()!=Event_MouseButtonPress/e->type()!=QEvent::MouseButtonPress/' \
      "\${kmines_src}"
  fi
  kpat_src="\${ARCHIVE_SRC}/kde1-kdegames/kpat/cardmaps.cpp"
  if ! grep -q 'QApplication::palette().normal()' "\${kpat_src}"; then
    sed -i 's/QApplication::palette()->normal()/QApplication::palette().normal()/g' \
      "\${kpat_src}"
  fi
  kpat_card_src="\${ARCHIVE_SRC}/kde1-kdegames/kpat/basiccard.cpp"
  if grep -q 'static QColorGroup colgrp( black' "\${kpat_card_src}" || \
     grep -q 'darkGreen, black, white);' "\${kpat_card_src}"; then
    sed -i \
      -e 's/static QColorGroup colgrp( black, white, darkGreen.light(), darkGreen.dark(),/static QColorGroup colgrp( Qt::black, Qt::white, Qt::darkGreen.light(), Qt::darkGreen.dark(),/' \
      -e 's/darkGreen, black, white);/Qt::darkGreen, Qt::black, Qt::white);/' \
      "\${kpat_card_src}"
  fi
  # MiDE's image layer has no BMP handler. Keep the historical BMP files in
  # the pinned checkout, compile KPat against XPM names, and regenerate the
  # equivalent XPM payloads into the persistent prefix after installation.
  sed -i 's/\.bmp/\.xpm/g' \
    "\${ARCHIVE_SRC}/kde1-kdegames/kpat/cardmaps.cpp" \
    "\${ARCHIVE_SRC}/kde1-kdegames/kpat/pwidget.cpp"
  cat >"\${ARCHIVE_SRC}/bmp-to-xpm.py" <<'K_PAT_XPM_EOF'
#!/usr/bin/env python3
import pathlib
import struct
import sys

SYMBOLS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!#$%&'()*+,-./:;<=>?@[]^_{|}~"

def read_bmp(path):
    data = path.read_bytes()
    if data[:2] != b"BM":
        raise ValueError("not a BMP: %s" % path)
    offset = struct.unpack_from("<I", data, 10)[0]
    dib = struct.unpack_from("<I", data, 14)[0]
    width = struct.unpack_from("<i", data, 18)[0]
    height_field = struct.unpack_from("<i", data, 22)[0]
    planes = struct.unpack_from("<H", data, 26)[0]
    bpp = struct.unpack_from("<H", data, 28)[0]
    compression = struct.unpack_from("<I", data, 30)[0]
    if planes != 1 or bpp not in (4, 8) or compression != 0:
        raise ValueError("unsupported BMP: %s" % path)
    height = abs(height_field)
    count = struct.unpack_from("<I", data, 46)[0] or (1 << bpp)
    palette = []
    palette_offset = 14 + dib
    for index in range(count):
        blue, green, red, _ = struct.unpack_from("<BBBB", data, palette_offset + index * 4)
        palette.append((red, green, blue))
    stride = ((width * bpp + 31) // 32) * 4
    rows = []
    for y in range(height):
        source_y = y if height_field < 0 else height - 1 - y
        row = offset + source_y * stride
        values = []
        for x in range(width):
            value = data[row + x] if bpp == 8 else data[row + x // 2]
            values.append(value if bpp == 8 else ((value >> 4) & 15 if x % 2 == 0 else value & 15))
        rows.append(values)
    return width, height, palette, rows

def write_xpm(source, destination):
    width, height, palette, rows = read_bmp(source)
    base = len(SYMBOLS)
    keys = [SYMBOLS[index // base] + SYMBOLS[index % base] for index in range(len(palette))]
    lines = ["/* XPM */", "static char * image[] = {", '"%d %d %d 2",' % (width, height, len(palette))]
    lines += ['"%s c #%02x%02x%02x",' % (key, red, green, blue) for key, (red, green, blue) in zip(keys, palette)]
    for index, row in enumerate(rows):
        suffix = "," if index != len(rows) - 1 else ""
        lines.append('"%s"%s' % ("".join(keys[value] for value in row), suffix))
    lines.append("};")
    destination.write_text("\n".join(lines) + "\n", encoding="ascii")

def main():
    if len(sys.argv) != 3:
        raise SystemExit("usage: bmp-to-xpm.py SOURCE-DIR DESTINATION-DIR")
    source_dir, destination_dir = map(pathlib.Path, sys.argv[1:])
    destination_dir.mkdir(parents=True, exist_ok=True)
    for source in sorted(source_dir.glob("*.bmp")):
        write_xpm(source, destination_dir / (source.stem + ".xpm"))

if __name__ == "__main__":
    main()
K_PAT_XPM_EOF
  chmod +x "\${ARCHIVE_SRC}/bmp-to-xpm.py"

  # KAbalone performs arithmetic directly on QString indexing. Make the
  # intended byte conversion explicit at that serialization boundary.
  kabalone_src="\${ARCHIVE_SRC}/kde1-kdegames/kabalone/Board.cpp"
  if ! grep -q 'state\[0\]\.latin1()' "\${kabalone_src}"; then
    sed -i \
      -e "s/state\\[0\\] - 'A'/state[0].latin1() - 'A'/g" \
      -e "s/state\\[1\\] - 'A'/state[1].latin1() - 'A'/g" \
      -e "s/state\\[2\\] - 'A'/state[2].latin1() - 'A'/g" \
      -e "s/state\\[j\\] - '@'/state[j].latin1() - '@'/g" \
      "\${kabalone_src}"
  fi

  build_archived_app() {
    repo_name="\$1"
    app_name="\$2"
    target_name="\$3"
    app_source="\${ARCHIVE_SRC}/\${repo_name}/\${app_name}"
    build_dir="\${ARCHIVE_SRC}/build-\${target_name}"
    cmake -G Ninja \
      -S "\${ARCHIVE_SRC}/probe" \
      -B "\${build_dir}" \
      -DAPP_SOURCE="\${app_source}" \
      -DCMAKE_BUILD_TYPE=Debug \
      -DCMAKE_INSTALL_PREFIX="\${PREFIX}" \
      -DCMAKE_PREFIX_PATH="\${PREFIX}" \
      -DCMAKE_MODULE_PATH="\${ARCHIVE_SRC}/cmake;\${PREFIX}/share/cmake/Modules" \
      -DKDE1_INCLUDES="\${PREFIX}/include" \
      -DKDE1_LIBRARIES="\${PREFIX}/lib64" \
      -DOSIRIS_INCLUDE_DIR="\${PREFIX}/include/osiris" \
      -DOSIRIS_LIBRARY_DIR="\${PREFIX}/lib"
    cmake --build "\${build_dir}" --target "\${target_name}" -j2
    cmake --build "\${build_dir}" --target install -j2
  }

  build_archived_app kde1-kdemultimedia kmedia kmedia
  build_archived_app kde1-kdegames kblackbox kblackbox1
  build_archived_app kde1-kdegames kmines kmines1
  build_archived_app kde1-kdegames kpat kpat1
  build_archived_app kde1-kdegames kabalone kabalone
  build_archived_app kde1-kdegames kshisen kshisen1
  python3 "\${ARCHIVE_SRC}/bmp-to-xpm.py" \
    "\${ARCHIVE_SRC}/kde1-kdegames/kpat/pics" \
    "\${PREFIX}/share/apps/kpat/pics"
  test -f "\${PREFIX}/share/apps/kpat/pics/52.xpm"
  test -f "\${PREFIX}/share/apps/kpat/pics/back1.xpm"
  touch "\${PREFIX}/.sentinel-mide-archived-apps-kshisen"
else
  echo "Selected KDE 1 historical applications already installed (sentinel present)"
fi

# ── Stage 6: KDE 1 accessories, graphics, and a first game tranche ────────
# The first recovered batch above stays immutable behind its original
# sentinel.  This follow-on stage adds the small desktop applications and
# games that are useful in the everyday MiDesktop room, using separate
# per-target output checks so one stubborn Qt1 port cannot hide the others.
EXTRA_ARCHIVE_SRC="\${SRC}/archived-kde1-upstream"
EXTRA_STAGE_SENTINEL="\${PREFIX}/.sentinel-mide-archived-apps-extra-v1"
if [ ! -f "\${EXTRA_STAGE_SENTINEL}" ]; then
  echo "Building additional KDE 1 accessories, graphics, and games..."

  fetch_extra_repo() {
    name="\$1"
    url="\$2"
    commit="\$3"
    repo="\${EXTRA_ARCHIVE_SRC}/\${name}"
    if [ ! -d "\${repo}/.git" ]; then
      if [ -e "\${repo}" ]; then
        echo "\${repo} exists but is not a Git checkout — refusing to replace it." >&2
        return 1
      fi
      git clone --depth 1 "\${url}" "\${repo}" || return 1
    fi
    git -C "\${repo}" remote set-url origin "\${url}"
    git -C "\${repo}" fetch --depth 1 origin "\${commit}"
    git -C "\${repo}" checkout --detach "\${commit}"
  }

  fetch_extra_repo kde1-kdeutils \
    https://invent.kde.org/historical/kde1-kdeutils.git \
    0754b27dbe5e7470b24be83b539ff1c3d5092a48
  fetch_extra_repo kde1-kdegraphics \
    https://invent.kde.org/historical/kde1-kdegraphics.git \
    4bf9d8a32634d7dcc9c6f08be2cd22a11b8f1fe6

  if [ ! -f "\${EXTRA_ARCHIVE_SRC}/probe/CMakeLists.txt" ]; then
    echo "KDE1 compatibility probe is missing — the archived-app stage must run first." >&2
    exit 1
  fi

  # Osiris keeps the Qt2 QString API, while these KDE1 utilities still carry
  # a few Qt1-only detach/size/event spellings.  Keep the edits at the
  # archived-source boundary so the public source remains pinned and the
  # compatibility work is replayed on every clean guest.
  kedit_root="\${EXTRA_ARCHIVE_SRC}/kde1-kdeutils/kedit"
  if grep -R -q -E 'detach\(\)|Event_Paint|Event_MouseButtonPress|^[[:space:]]*(fillstr\.mailcmd|filenamebackup|filename|file|pi\.command|command|netFile)[[:space:]]*$' "\${kedit_root}" --include='*.cpp'; then
    sed -i \
      -e 's/\.detach();/;/g' \
      -e 's/string\.size()/string.length()/g' \
      -e 's/Event_Paint/QEvent::Paint/g' \
      -e 's/Event_MouseButtonPress/QEvent::MouseButtonPress/g' \
      -e 's/^[[:space:]]*fillstr\.mailcmd[[:space:]]*$/  ;/' \
      -e 's/^[[:space:]]*filenamebackup[[:space:]]*$/  ;/' \
      -e 's/^[[:space:]]*filename[[:space:]]*$/  ;/' \
      -e 's/^[[:space:]]*file[[:space:]]*$/  ;/' \
      -e 's/^[[:space:]]*pi\.command[[:space:]]*$/  ;/' \
      -e 's/^[[:space:]]*command[[:space:]]*$/  ;/' \
      -e 's/^[[:space:]]*netFile[[:space:]]*$/  ;/' \
      "\${kedit_root}"/*.cpp
  fi

  kjots_root="\${EXTRA_ARCHIVE_SRC}/kde1-kdeutils/kjots"
  if grep -R -q -E 'detach\(\)|switch\( value\[i\] \)|^[[:space:]]*(command|buf)[[:space:]]*$' "\${kjots_root}" --include='*.cpp'; then
    sed -i \
      -e 's/\.detach();/;/g' \
      -e 's/^[[:space:]]*command[[:space:]]*$/          ;/' \
      -e 's/^[[:space:]]*buf[[:space:]]*$/      ;/' \
      -e 's/switch( (char) value\[i\] )/switch( value[i].latin1() )/' \
      "\${kjots_root}"/*.cpp
  fi
  # The persistent source may already have been normalised to the Qt2-shaped
  # cast by an earlier retry.  Keep this exact QCharRef conversion replayable
  # independently of the broader KJots guard above.
  sed -i 's/switch( (char) value\[i\] )/switch( value[i].latin1() )/' \
    "\${kjots_root}/ReadListConf.cpp"

  kcalc_root="\${EXTRA_ARCHIVE_SRC}/kde1-kdeutils/kcalc"
  if grep -R -q 'GCI' "\${kcalc_root}" --include='stats.*'; then
    sed -i 's/\bGCI\b/QCollection::Item/g' \
      "\${kcalc_root}/stats.h" "\${kcalc_root}/stats.cpp"
  fi

  kview_root="\${EXTRA_ARCHIVE_SRC}/kde1-kdegraphics/kview"
  if grep -q 'QString name( 100 )' "\${kview_root}/canvas.cpp"; then
    sed -i \
      -e 's/QString name( 100 );/char name[L_tmpnam];/' \
      -e 's/tmpnam( name\.data() )/tmpnam( name )/' \
      -e 's/return name;/return QString(name);/' \
      "\${kview_root}/canvas.cpp"
  fi
  if grep -q 'setStr(' "\${kview_root}/viewer.cpp"; then
    sed -i \
      -e 's/_transSrc->setStr( url );/\*_transSrc = url;/' \
      -e 's/_transDest->setStr( tempnam( 0, "kview_") );/\*_transDest = tempnam( 0, "kview_");/' \
      "\${kview_root}/viewer.cpp"
  fi
  # The historical menu helper carries an extra string argument, and the
  # label's ampersand must be escaped in sed's replacement text.  Repair both
  # the pristine spelling and any malformed result from an earlier retry.
  # Regex end anchors are escaped because this block sits inside an unquoted
  # outer heredoc.
  sed -i \
    -e 's#^[[:space:]]*conn( i18n("i18n.*_imageList,\$#  conn( i18n("\&Slideshow On/Off"), _imageList,#' \
    -e 's#^[[:space:]]*_aggreg->insertItem( i18n("i18n.*\$#  _aggreg->insertItem( i18n("\&Slideshow On/Off"),#' \
    -e 's#i18n("&Slideshow On/Off"), "Slideshow",#i18n("\&Slideshow On/Off"),#' \
    "\${kview_root}/viewer.cpp"
  sed -i \
    -e 's/\.detach();/;/g' \
    -e 's/^[[:space:]]*cap[[:space:]]*$/        ;/' \
    "\${kview_root}/ilistdlg.cpp"
  sed -i 's/Event_Resize/QEvent::Resize/g' "\${kview_root}/baglayout.cpp"

  knotes_root="\${EXTRA_ARCHIVE_SRC}/kde1-kdeutils/knotes"
  if grep -R -q -E 'detach\(\)|Event_|\.size\(\)|const QStrList \*list = d\.entryList|QColor blackC\(black\)' \
      "\${knotes_root}" --include='*.cpp' --include='*.h'; then
    sed -i \
      -e 's/\.detach();/;/g' \
      -e 's/Event_FocusOut/QEvent::FocusOut/g' \
      -e 's/Event_FocusIn/QEvent::FocusIn/g' \
      -e 's/Event_MouseButtonRelease/QEvent::MouseButtonRelease/g' \
      -e 's/Event_MouseButtonPress/QEvent::MouseButtonPress/g' \
      -e 's/Event_MouseMove/QEvent::MouseMove/g' \
      -e 's/string\.size()/string.length()/g' \
      -e 's/QColor blackC(black);/QColor blackC("black");/' \
      -e 's/QColor yellowC(yellow);/QColor yellowC("yellow");/' \
      "\${knotes_root}"/*.cpp
    if ! grep -q '#include <qstringlist.h>' "\${knotes_root}/knotes.h"; then
      sed -i '/#include <qdir.h>/a #include <qstringlist.h>' "\${knotes_root}/knotes.h"
    fi
    if ! grep -q '^#undef FocusOut$' "\${knotes_root}/knotes.cpp"; then
      sed -i '/#include <X11\/Xlib.h>/a #undef FocusOut' "\${knotes_root}/knotes.cpp"
      sed -i '/#include <X11\/Xlib.h>/a #undef FocusIn' "\${knotes_root}/knotes.cpp"
    fi
    sed -i \
      -e 's/const QStrList \*list = d.entryList();/QStringList list = d.entryList();/' \
      -e 's/QStrListIterator it( \*list );      \/\/ create list iterator/QStringList::ConstIterator it = list.begin();/' \
      -e 's/char \*fi;                          \/\/ pointer for traversing/QString fi;                          \/\/ entry name for traversing/' \
      -e 's/while ( (fi=it.current()) )/while ( it != list.end() )/' \
      -e 's/strcmp("\.\",fi)/strcmp(".",fi.data())/' \
      -e 's/strcmp("\.\.",fi)/strcmp("..",fi.data())/' \
      -e 's/strcmp("xyalarms",fi)/strcmp("xyalarms",fi.data())/' \
      -e 's/PostitFilesList\.inSort(fi);/PostitFilesList.inSort(fi.data());/' \
      "\${knotes_root}/knotes.cpp"
  fi
  # X11/Xlib.h defines FocusIn and FocusOut as numeric macros, so the
  # historical QEvent spellings are macro-expanded before the compiler sees
  # them.  Osiris' QEvent enum values are FocusIn=8 and FocusOut=9; use the
  # enum type explicitly at this source boundary to preserve the event calls.
  sed -i \
    -e 's/QEvent::FocusOut/QEvent::Type(9)/g' \
    -e 's/QEvent::FocusIn/QEvent::Type(8)/g' \
    "\${knotes_root}/knotes.cpp"

  materialize_extra_assets() {
    target_name="\$1"
    if [ "\${target_name}" = knotes1 ] && [ -f "\${PREFIX}/share/icons/knotes.xpm" ]; then
      mkdir -p "\${PREFIX}/share/icons/mini"
      cp -f "\${PREFIX}/share/icons/knotes.xpm" "\${PREFIX}/share/icons/mini/knotes.xpm"
    fi
  }

  build_extra_app() {
    repo_name="\$1"
    app_name="\$2"
    target_name="\$3"
    app_source="\${EXTRA_ARCHIVE_SRC}/\${repo_name}/\${app_name}"
    build_dir="\${EXTRA_ARCHIVE_SRC}/build-\${target_name}"
    if [ ! -d "\${app_source}" ]; then
      echo "Missing KDE1 application source: \${app_source}" >&2
      return 1
    fi
    if [ -x "\${PREFIX}/bin/\${target_name}" ]; then
      echo "\${target_name} already installed"
      materialize_extra_assets "\${target_name}"
      return 0
    fi
    cmake -G Ninja \
      -S "\${EXTRA_ARCHIVE_SRC}/probe" \
      -B "\${build_dir}" \
      -DAPP_SOURCE="\${app_source}" \
      -DCMAKE_BUILD_TYPE=Debug \
      -DCMAKE_INSTALL_PREFIX="\${PREFIX}" \
      -DCMAKE_PREFIX_PATH="\${PREFIX}" \
      -DCMAKE_MODULE_PATH="\${EXTRA_ARCHIVE_SRC}/cmake;\${PREFIX}/share/cmake/Modules" \
      -DKDE1_INCLUDES="\${PREFIX}/include" \
      -DKDE1_LIBRARIES="\${PREFIX}/lib64" \
      -DOSIRIS_INCLUDE_DIR="\${PREFIX}/include/osiris" \
      -DOSIRIS_LIBRARY_DIR="\${PREFIX}/lib"
    cmake --build "\${build_dir}" --target "\${target_name}" -j2
    cmake --build "\${build_dir}" --target install -j2
    materialize_extra_assets "\${target_name}"
  }

  extra_ok=1
  for extra_spec in \
    'kde1-kdeutils|kedit|kedit' \
    'kde1-kdeutils|kjots|kjots1' \
    'kde1-kdeutils|kcalc|kcalc1' \
    'kde1-kdeutils|knotes|knotes1' \
    'kde1-kdegraphics|kpaint|kpaint1' \
    'kde1-kdegraphics|kiconedit|kiconedit' \
    'kde1-kdegraphics|kview|kview1' \
    'kde1-kdegames|kmahjongg|kmahjongg1' \
    'kde1-kdegames|konquest|konquest1' \
    'kde1-kdegames|kreversi|kreversi1' \
    'kde1-kdegames|ksame|ksame' \
    'kde1-kdegames|ksokoban|ksokoban'; do
    IFS='|' read -r extra_repo extra_app extra_target <<< "\${extra_spec}"
    if ! build_extra_app "\${extra_repo}" "\${extra_app}" "\${extra_target}"; then
      echo "KDE1 optional application did not build: \${extra_target}" >&2
      extra_ok=0
    fi
  done

  if [ "\${extra_ok}" -eq 1 ]; then
    touch "\${EXTRA_STAGE_SENTINEL}"
  else
    echo "Additional KDE1 application stage incomplete; successful binaries remain installed." >&2
  fi
fi

if [ -x "\${PREFIX}/bin/startmidesktop" ]; then
  echo "MiDesktop ${MIDE_BRANCH} installed to \${PREFIX}"
  echo "Session starter: \${PREFIX}/bin/startmidesktop"
  echo "Launch with: sanctuary-mide-launch"
else
  echo "Build finished but \${PREFIX}/bin/startmidesktop is missing — inspect the base stage." >&2
  exit 1
fi
INNER_EOF
)
sanctuary-exec "${SANCTUARY}" sh -c "${INNER_SCRIPT}"

# Materialise the menu/panel state from the same canonical source immediately
# after a build. This writes only DotCortex-owned .kdelnk files and the marked
# panel block; vendor KDE1 links and user-edited config outside that block stay
# untouched.
MIDE_APPS="${HOME}/.local/bin/sanctuary-mide-apps"
if [[ ! -x "$MIDE_APPS" ]]; then
  MIDE_APPS="${HOME}/DotCortex/linux/.local/bin/sanctuary-mide-apps"
fi
if [[ -x "$MIDE_APPS" ]]; then
  XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}" "$MIDE_APPS" reconcile
fi
# Source build: sanctuary-mide-build:1 ends here
