#!/usr/bin/env bash
# [[file:../../../distrobox.org::*{][{:1]]
set -euo pipefail

GUIX_PROFILES="${HOME}/.guix-extra-profiles"

source_guix_profile() {
  local profile="$1"
  local status=0
  local had_nounset=0

  case $- in
    *u*) had_nounset=1; set +u ;;
  esac

  GUIX_PROFILE="$profile"
  export GUIX_PROFILE

  if . "$profile/etc/profile"; then
    status=0
  else
    status=$?
  fi

  (( had_nounset )) && set -u
  return "$status"
}

for _prof in desktop-common room-gaming room-windows-compat; do
  source_guix_profile "${GUIX_PROFILES}/${_prof}/${_prof}"
done

exec "$@"
# {:1 ends here
