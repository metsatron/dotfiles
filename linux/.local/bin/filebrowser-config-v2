#!/usr/bin/python3
"""Convert a Quantum 1 FileBrowser config to the Quantum 2 shape; dry run unless --apply."""
import argparse, os, pathlib, stat, tempfile, time
import yaml
p = argparse.ArgumentParser(description=__doc__)
p.add_argument('--apply', action='store_true', help='write the converted config; default is a dry run')
p.add_argument('--config', type=pathlib.Path, default=pathlib.Path.home() / '.config/filebrowser/config.yaml')
p.add_argument('--sqlite', type=pathlib.Path, default=pathlib.Path.home() / '.local/state/filebrowser/filebrowser.sqlite',
               help='new SQLite database (must not be named database.db)')
a = p.parse_args()
config = a.config
if config.is_symlink() or not config.is_file() or config.stat().st_uid != os.getuid():
    p.error('expected an owned regular config file, not a symlink')
if a.sqlite.name == 'database.db':
    p.error('Quantum 2 reserves database.db for the legacy file; choose another name')
original = config.read_bytes()
data = yaml.safe_load(original)
if not isinstance(data, dict):
    p.error('expected a YAML mapping')
if 'http' in data:
    p.error('already a Quantum 2 config (it has an http: block); nothing to convert')
server = data.get('server')
if not isinstance(server, dict):
    p.error('the config has no server mapping')
legacy = server.get('database')
if not isinstance(legacy, str) or not legacy:
    p.error('no Quantum 1 server.database path to migrate from')
if a.sqlite.exists():
    p.error('the SQLite target already exists; refusing to reuse it')
http = {key: server.pop(key) for key in ('port', 'listen', 'internalUrl') if key in server}
server['database'] = {'path': str(a.sqlite), 'migrateFrom': legacy}
converted = {'http': http, **data}
print(('Apply' if a.apply else 'Dry-run') + ': http.' + ', http.'.join(http) + '; server.database.path and server.database.migrateFrom')
if not a.apply:
    raise SystemExit(0)
rendered = yaml.safe_dump(converted, sort_keys=False).encode()
if config.read_bytes() != original:
    p.error('config changed during review; refusing write')
backup = config.with_name(config.name + '.before-quantum2-' + str(time.time_ns()))
with os.fdopen(os.open(backup, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), 'wb') as out:
    out.write(original)
a.sqlite.parent.mkdir(parents=True, exist_ok=True)
fd, name = tempfile.mkstemp(prefix='.config.quantum2-', dir=config.parent)
try:
    with os.fdopen(fd, 'wb') as out:
        os.fchmod(out.fileno(), 0o600)
        out.write(rendered)
        out.flush()
        os.fsync(out.fileno())
    if config.read_bytes() != original:
        p.error('config changed before replacement; refusing write')
    os.replace(name, config)
finally:
    if os.path.exists(name):
        os.unlink(name)
print('Config converted; backup ' + backup.name + '. The first Quantum 2 start migrates the old database and leaves it untouched.')
