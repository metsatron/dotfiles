#!/usr/bin/env bash
# Launcher: sanctuary-gnustep-launch

# Moved here from =sanctuary-distrobox.org= (2026-07-30) and extended with the config projection preamble: the three Defaults files above are projected into the guest home every launch (=project_file= copies, redstone pattern — Window Maker rewrites Defaults at runtime, so these must be copies, never symlinks). Dock X is computed from the live Xephyr root once the display is up.


# [[file:../../../sanctuary-gnustep.org::*Launcher: sanctuary-gnustep-launch][Launcher: sanctuary-gnustep-launch:1]]
# Launch sanctuary-gnustep: Xephyr :91 + Window Maker inside the Guix container.
# Switch to Desktop 3 (Ctrl+F3) first.
set -euo pipefail

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  cat <<EOF
sanctuary-gnustep-launch - launch sanctuary-gnustep (Xephyr :91 + Window Maker, GNU/NeXT Sanctuary)

Usage: sanctuary-gnustep-launch

No arguments. Switch to host Desktop 3 (Ctrl+F3) before launching.
Normally invoked via: sanctuary-enter sanctuary-gnustep
EOF
  exit 0
fi

DISPLAY_NUM=":91"
HOST_DISPLAY="${DISPLAY}"
SANCTUARY="sanctuary-gnustep"
GUESTS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/dotcortex/guests"
GUEST_HOME="${GUESTS_DIR}/${SANCTUARY}/home"
GUIX_PROFILES="${HOME}/.guix-extra-profiles"
GWORKSPACE_BACKGROUND="#555577"
DEFAULTS_SRC="${HOME}/DotCortex/linux/.config/gnustep-sanctuary/Defaults"
ICON_SRC="${HOME}/DotCortex/linux/.config/gnustep-sanctuary/Icons/NeXT_logo.xpm"
WINDOW_ATTRIBUTES_SRC="${DEFAULTS_SRC}/WMWindowAttributes"
GTK_SRC="${HOME}/DotCortex/linux/.themes/OneStepBack"
GTK_DEFAULTS_SRC="${HOME}/DotCortex/linux/.config/gnustep-sanctuary"
FASTFETCH_SRC="${HOME}/DotCortex/linux/.config/gnustep-sanctuary/fastfetch.jsonc"
SHELL_SRC="${HOME}/DotCortex/linux/.config/gnustep-sanctuary/shell"

sanctuary-teardown-stale-session "${SANCTUARY}" "${DISPLAY_NUM}"

# sanctuary-teardown-stale-session can stop the room wrapper while guest
# children remain alive in the shared PID namespace. GNUstep's port registry
# is likewise shared through /tmp, so a power-loss restart can leave a dead
# GWorkspace name (or a duplicate live Workspace Manager) behind. Remove only
# the exact GWorkspace executable and only port records whose owning PID is no
# longer alive; never sweep another GNUstep application's live registration.
cleanup_gworkspace_runtime() {
  local runtime_root="/tmp/GNUstepSecure${UID}"
  local gws_path="${GUEST_HOME}/.local/share/gnustep/lib/GNUstep/Applications/GWorkspace.app/GWorkspace"
  local fswatcher_path="${GUEST_HOME}/.local/share/gnustep/bin/fswatcher"
  local ddbd_path="${GUEST_HOME}/.local/share/gnustep/bin/ddbd"
  local app_root="${GUEST_HOME}/.local/share/gnustep/lib/GNUstep/Applications/"
  local name_file port_file port_path port_pid pid
  local -a gws_pids fswatcher_pids ddbd_pids app_pids

  mapfile -t gws_pids < <(
    ps -eo pid=,args= | awk -v path="${gws_path}" \
      'index($0, path) { print $1 }'
  )
  for pid in "${gws_pids[@]}"; do
    [[ "${pid}" =~ ^[0-9]+$ ]] || continue
    kill -TERM "${pid}" 2>/dev/null || true
  done
  for _ in {1..20}; do
    mapfile -t gws_pids < <(
      ps -eo pid=,args= | awk -v path="${gws_path}" \
        'index($0, path) { print $1 }'
    )
    ((${#gws_pids[@]} == 0)) && break
    sleep 0.1
  done
  for pid in "${gws_pids[@]}"; do
    [[ "${pid}" =~ ^[0-9]+$ ]] || continue
    kill -KILL "${pid}" 2>/dev/null || true
  done

  # A power-loss restart can leave fswatcher orphaned after GWorkspace dies.
  # It owns a live GNUstep name, so the generic dead-record pass below cannot
  # identify it as stale.  Preserve it whenever another GNUstep application
  # is still using the shared daemon; otherwise remove only this exact binary.
  mapfile -t app_pids < <(
    ps -eo pid=,args= | awk -v path="${app_root}" \
      'index($0, path) { print $1 }'
  )
  if ((${#app_pids[@]} == 0)); then
    mapfile -t fswatcher_pids < <(
      ps -eo pid=,args= | awk -v path="${fswatcher_path}" \
        '$2 == path && $3 == "--daemon" && $4 == "--auto" { print $1 }'
    )
    for pid in "${fswatcher_pids[@]}"; do
      [[ "${pid}" =~ ^[0-9]+$ ]] || continue
      kill -KILL "${pid}" 2>/dev/null || true
    done
    mapfile -t ddbd_pids < <(
      ps -eo pid=,args= | awk -v path="${ddbd_path}" \
        '$2 == path && $3 == "--daemon" && $4 == "--auto" { print $1 }'
    )
    for pid in "${ddbd_pids[@]}"; do
      [[ "${pid}" =~ ^[0-9]+$ ]] || continue
      kill -KILL "${pid}" 2>/dev/null || true
    done
  fi

  [[ -d "${runtime_root}/NSMessagePort" ]] || return 0
  for name_file in "${runtime_root}/NSMessagePort/names/"*; do
    [[ -f "${name_file}" ]] || continue
    port_path="$(sed -n '1p' "${name_file}" 2>/dev/null || true)"
    port_pid="$(sed -n '2p' "${name_file}" 2>/dev/null || true)"
    if [[ "${port_pid}" =~ ^[0-9]+$ ]] && kill -0 "${port_pid}" 2>/dev/null; then
      continue
    fi
    rm -f "${name_file}"
    [[ "${port_path}" == "${runtime_root}/NSMessagePort/ports/"* ]] && \
      rm -f "${port_path}"
  done
  for port_file in "${runtime_root}/NSMessagePort/ports/"*; do
    [[ -S "${port_file}" ]] || continue
    port_pid="${port_file##*/}"
    port_pid="${port_pid%%.*}"
    if [[ ! "${port_pid}" =~ ^[0-9]+$ ]] || ! kill -0 "${port_pid}" 2>/dev/null; then
      rm -f "${port_file}"
    fi
  done

  # GSLaunchedApplications is a session registry, not a durable preference.
  # Drop it only when no other GNUstep application bundle is still running.
  mapfile -t app_pids < <(
    ps -eo pid=,args= | awk -v path="${app_root}" \
      'index($0, path) { print $1 }'
  )
  if ((${#app_pids[@]} == 0)); then
    rm -f "${runtime_root}/GSLaunchedApplications"
  fi
}

cleanup_gworkspace_runtime

mapfile -t XEPHYR_GEOMETRY < <(sanctuary-xephyr-geometry)
Xephyr "${DISPLAY_NUM}" "${XEPHYR_GEOMETRY[@]}" -br -ac -glamor -no-host-grab &
XEPHYR_PID=$!
trap "kill ${XEPHYR_PID} 2>/dev/null || true" EXIT

timeout 10 sh -c "until DISPLAY=${DISPLAY_NUM} xdpyinfo >/dev/null 2>&1; do sleep 0.1; done" \
  || { echo "Xephyr ${DISPLAY_NUM} did not become ready"; kill "${XEPHYR_PID}"; exit 1; }

sanctuary-xephyr-place "${DISPLAY_NUM}" "${HOST_DISPLAY}" "${SANCTUARY}"

sanctuary-clip-bridge "${HOST_DISPLAY}" "${DISPLAY_NUM}" &
CLIP_BRIDGE_PID=$!
ICON_SHELF_PID=""
cleanup_room_processes() {
  kill "${XEPHYR_PID}" "${CLIP_BRIDGE_PID}" 2>/dev/null || true
  if [[ -n "${ICON_SHELF_PID}" ]]; then
    kill "${ICON_SHELF_PID}" 2>/dev/null || true
  fi
}
trap cleanup_room_processes EXIT

# ── Shield trash:/// from host fleet NFS mounts (see sanctuary-trash-shield) ──
sanctuary-trash-shield "${SANCTUARY}" "${HOME}"

# ── Materialise only executable catalogue entries into the guest menu ──
# The helper is deliberately host-side: it reads the persistent guest home,
# then Window Maker inherits the generated menu file when its environment is
# sourced below. A missing buildable candidate is a ledger row, never a fake
# launcher.
sanctuary-gnustep-apps ledger >/dev/null
sanctuary-gnustep-apps menu >/dev/null

# ── Project DotCortex-managed Window Maker config into the guest home ──
# Copies, not symlinks: Window Maker rewrites Defaults files at runtime, and a
# symlinked WMState would let the room dirty the repo checkout. Projection every
# launch is deliberate — the desktop is declarative, in-room rearrangements are
# ephemeral (ruled 2026-07-30).
project_file() {
  local src="$1" dst="$2"
  mkdir -p "$(dirname "${dst}")"
  rm -f "${dst}"
  cp -f "${src}" "${dst}"
}
project_emacs_icon() {
  local app_dir="${GUEST_HOME}/.local/share/gnustep/lib/GNUstep/Applications/Emacs.app"
  local app_icon="${app_dir}/Resources/emacs.tiff"
  local old_app_icon="${app_dir}.pre-native-emacs-30.2/Resources/emacs.tiff"
  local app_plist="${app_dir}/Resources/Info-gnustep.plist"
  local app_desktop="${app_dir}/Resources/Emacs.desktop"
  [[ -f "${old_app_icon}" && -d "${app_dir}" ]] || return 0

  # Keep the native build's modern icon recoverable, then restore the exact
  # 48x48 GNU artwork from the pre-native bundle. GWorkspace's shelf reads
  # ApplicationIcon/NSIcon from this plist, so this fixes both shelf and
  # miniwindows without raster conversion.
  if [[ -f "${app_icon}" &&
        ! -f "${app_dir}/Resources/emacs-modern.tiff" ]]; then
    cp -p "${app_icon}" "${app_dir}/Resources/emacs-modern.tiff"
  fi
  project_file "${old_app_icon}" "${app_icon}"
  python3 - "${app_plist}" "${app_desktop}" <<'PY'
import os
import re
import sys
import tempfile

plist_path, desktop_path = sys.argv[1:]
if os.path.exists(plist_path):
    with open(plist_path, encoding="utf-8") as stream:
        plist = stream.read()
    plist, application_count = re.subn(
        r"(?m)^    ApplicationIcon\s*=\s*[^;]+;",
        "    ApplicationIcon = emacs.tiff;",
        plist,
        count=1,
    )
    plist, ns_count = re.subn(
        r"(?m)^    NSIcon\s*=\s*[^;]+;",
        "    NSIcon = emacs.tiff;",
        plist,
        count=1,
    )
    if application_count != 1 or ns_count != 1:
        raise SystemExit("unexpected GNUstep Emacs plist icon layout")
    mode = os.stat(plist_path).st_mode & 0o777
    fd, temporary = tempfile.mkstemp(prefix=".emacs-icon.", dir=os.path.dirname(plist_path))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            stream.write(plist)
        os.chmod(temporary, mode)
        os.replace(temporary, plist_path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
if os.path.exists(desktop_path):
    with open(desktop_path, encoding="utf-8") as stream:
        desktop = stream.read()
    desktop = re.sub(r"(?m)^Icon=emacs\.(?:png|tiff)$", "Icon=emacs.tiff", desktop)
    with open(desktop_path, "w", encoding="utf-8") as stream:
        stream.write(desktop)
PY
}
project_window_attributes() {
  local dst="$1"
  local temporary="${dst}.tmp"
  local emacs_x_icon='  emacs.Emacs = {Icon = defaultAppIcon.tiff;};'
  local emacs_gnustep_icon='  Emacs.GNUstep = {Icon = defaultAppIcon.tiff;};'
  local emacs_bundle_icon="${GUEST_HOME}/.local/share/gnustep/lib/GNUstep/Applications/Emacs.app/Resources/emacs.tiff"
  if [[ ! -f "${emacs_bundle_icon}" ]]; then
    emacs_bundle_icon="${GUEST_HOME}/.local/share/gnustep/lib/GNUstep/Applications/Emacs.app/Resources/emacs.png"
  fi
  if [[ -f "${emacs_bundle_icon}" ]]; then
    emacs_x_icon="  emacs.Emacs = {Icon = \"${emacs_bundle_icon}\";};"
    emacs_gnustep_icon="  Emacs.GNUstep = {Icon = \"${emacs_bundle_icon}\";};"
  fi
  mkdir -p "$(dirname "${dst}")"
  sed -e "s|@NEXT_LOGO_ICON@|${GUEST_HOME}/GNUstep/Library/WindowMaker/Icons/NeXT_logo.xpm|" \
    -e "s|@EMACS_X_ICON@|${emacs_x_icon}|" \
    -e "s|@EMACS_GNUSTEP_ICON@|${emacs_gnustep_icon}|" \
    "${WINDOW_ATTRIBUTES_SRC}" > "${temporary}"
  mv -f "${temporary}" "${dst}"
}
project_windowmaker_defaults() {
  local dst="$1"
  local temporary="${dst}.tmp"
  local tile="${GUEST_HOME}/.local/share/gnustep/lib/GNUstep/Themes/NextSpace.theme/Resources/ThemeImages/common_Tile.tiff"
  local icon_back='  IconBack = (solid, "#aaaaaa");'
  local miniwindow_back='  MiniwindowBack = (solid, "#aaaaaa");'
  local user_titlebar_style=""
  # WPrefs owns this one preference. Preserve a valid saved choice while
  # re-projecting the declarative colors, fonts, and icon backgrounds.
  if [[ -f "${dst}" ]]; then
    user_titlebar_style="$(sed -nE 's/^[[:space:]]*NewStyle[[:space:]]*=[[:space:]]*(new|old|next);[[:space:]]*$/\1/p' "${dst}" | head -1)"
  fi
  if [[ -f "${tile}" ]]; then
    icon_back="  IconBack = (tpixmap, \"${tile}\", \"#000000\");"
    miniwindow_back="  MiniwindowBack = (tpixmap, \"${tile}\", \"#000000\");"
  fi
  mkdir -p "$(dirname "${dst}")"
  sed -e "s|@NEXTSPACE_ICON_BACK@|${icon_back}|" \
      -e "s|@NEXTSPACE_MINIWINDOW_BACK@|${miniwindow_back}|" \
      "${DEFAULTS_SRC}/WindowMaker" > "${temporary}"
  if [[ -n "${user_titlebar_style}" ]]; then
    sed -i "s/^  NewStyle = .*/  NewStyle = ${user_titlebar_style};/" "${temporary}"
  fi
  mv -f "${temporary}" "${dst}"
}
project_theme() {
  local src="$1" dst="$2"
  if [[ -e "${dst}" && ! -L "${dst}" ]]; then
    echo "${SANCTUARY}: refusing to replace non-symlink projected theme: ${dst}" >&2
    return 1
  fi
  mkdir -p "$(dirname "${dst}")"
  ln -sfnT "${src}" "${dst}"
}
project_windowmaker_defaults "${GUEST_HOME}/GNUstep/Defaults/WindowMaker"
project_file "${DEFAULTS_SRC}/WMRootMenu"  "${GUEST_HOME}/GNUstep/Defaults/WMRootMenu"
project_emacs_icon
project_window_attributes "${GUEST_HOME}/GNUstep/Defaults/WMWindowAttributes"
project_file "${ICON_SRC}" "${GUEST_HOME}/GNUstep/Library/WindowMaker/Icons/NeXT_logo.xpm"
project_theme "${GTK_SRC}" "${GUEST_HOME}/.themes/OneStepBack"
project_file "${GTK_DEFAULTS_SRC}/gtk-3.0/settings.ini" "${GUEST_HOME}/.config/gtk-3.0/settings.ini"
project_file "${GTK_DEFAULTS_SRC}/gtk-4.0/settings.ini" "${GUEST_HOME}/.config/gtk-4.0/settings.ini"
project_file "${FASTFETCH_SRC}" "${GUEST_HOME}/.config/fastfetch/config.jsonc"
# Replace the shared modern zsh prompt only inside this room; the room rc
# sources the global config first and remains a live symlink for iteration.
if [[ -f "${SHELL_SRC}/zshrc" ]]; then
  ln -sfnT "${SHELL_SRC}/zshrc" "${GUEST_HOME}/.zshrc"
fi

# Window Maker owns the room desktop and already paints the declarative
# #555577 background. Keep GWorkspace's full-screen desktop surface disabled:
# on this stock Window Maker/GNUstep combination it can sit above client
# bodies while their managed title frames remain visible. Merge only the
# declarative keys into the private plist; preserve every other user/runtime
# preference in that mutable file. plistlib is used instead of replacing the
# whole file with a DotCortex-owned template.
project_gworkspace_background() {
  local plist="$1"
  python3 - "${plist}" "${GWORKSPACE_BACKGROUND}" <<'PY'
import os
import plistlib
import sys
import tempfile

path, colour = sys.argv[1:]
channels = {
    "red": int(colour[1:3], 16) / 255.0,
    "green": int(colour[3:5], 16) / 255.0,
    "blue": int(colour[5:7], 16) / 255.0,
    "alpha": 1.0,
}

if os.path.exists(path):
    with open(path, "rb") as stream:
        defaults = plistlib.load(stream)
    mode = os.stat(path).st_mode & 0o777
else:
    defaults = {}
    mode = 0o600

desktopinfo = defaults.setdefault("desktopinfo", {})
desktopinfo["backcolor"] = channels
# GWorkspace's own dock duplicates Window Maker's app icons and uses a
# different, non-NeXT bevel. Window Maker is the room's single dock surface.
defaults["hidedock"] = True
# The Window Maker desktop is the room background; GWorkspace's desktop
# surface otherwise occludes the body of managed File Viewer windows.
defaults["no_desktop"] = True

directory = os.path.dirname(path)
os.makedirs(directory, exist_ok=True)
fd, temporary = tempfile.mkstemp(prefix=".gworkspace.", dir=directory)
try:
    with os.fdopen(fd, "wb") as stream:
        stream.write(plistlib.dumps(defaults, fmt=plistlib.FMT_XML, sort_keys=False))
    os.chmod(temporary, mode)
    os.replace(temporary, path)
finally:
    if os.path.exists(temporary):
        os.unlink(temporary)
PY
}
project_gworkspace_background "${GUEST_HOME}/GNUstep/Defaults/org.gnustep.GWorkspace.plist"

# Populate GWorkspace's NeXT-style tabbed shelf from the same verified bundle
# catalogue that feeds Window Maker's Applications menu.  Only installed,
# executable bundles become shelf icons; catalogue-only GAP candidates remain
# visible in the ledger without becoming broken launch targets.  Preserve any
# user-created tabs outside the managed set.
project_gworkspace_tabshelf() {
  local plist="$1"
  local catalogue="${HOME}/DotCortex/all/.config/gnustep-sanctuary/apps.ssv"
  local prefix="${GUEST_HOME}/.local/share/gnustep"
  python3 - "${plist}" "${catalogue}" "${prefix}" <<'PY'
import os
import plistlib
import sys
import tempfile

path, catalogue_path, prefix = sys.argv[1:]
managed_labels = {"Applications", "Accessories", "Development", "Games",
                  "Graphics", "Multimedia", "Networking"}
category_order = ["Accessories", "Games", "Development", "Graphics",
                  "Multimedia", "Networking"]

def installed_bundle(bundle, binary):
    for root, dirs, files in os.walk(prefix):
        if os.path.basename(root) != bundle or binary not in files:
            continue
        candidate = os.path.join(root, binary)
        if os.access(candidate, os.X_OK):
            return root
    return None

installed = []
with open(catalogue_path, encoding="utf-8") as stream:
    for raw in stream:
        raw = raw.rstrip("\n")
        if not raw or raw.startswith("#"):
            continue
        fields = raw.split("|", 8)
        if len(fields) != 9:
            continue
        app_id, category, display, bundle, binary = fields[:5]
        # GWorkspace is the room's Workspace Manager, not a second shelf
        # application. Exposing it here lets one click create a second
        # Workspace Manager (and therefore a second tabbed shelf).
        if app_id == "gworkspace":
            continue
        app_path = installed_bundle(bundle, binary)
        if app_path:
            installed.append((category, display, app_path))

tabs = []

def make_tab(label, rows):
    return {label: {"icons": [
        {"index": index, "paths": [app_path]}
        for index, (_category, _display, app_path) in enumerate(rows)
    ], "iconstype": 0}}

all_rows = sorted(installed, key=lambda row: row[1].casefold())
if all_rows:
    tabs.append(make_tab("Applications", all_rows))
for category in category_order:
    rows = sorted((row for row in installed if row[0] == category),
                  key=lambda row: row[1].casefold())
    if rows:
        tabs.append(make_tab(category, rows))

if os.path.exists(path):
    with open(path, "rb") as stream:
        defaults = plistlib.load(stream)
    mode = os.stat(path).st_mode & 0o777
else:
    defaults = {}
    mode = 0o600

old_shelf = defaults.get("tabshelf", {})
old_tabs = old_shelf.get("tabs", []) if isinstance(old_shelf, dict) else []
for entry in old_tabs:
    if not isinstance(entry, dict) or not entry:
        continue
    label = next(iter(entry))
    if label not in managed_labels and label != "last":
        tabs.append(entry)

# GWorkspace keeps the special `last` tab outside its ordinary tab list.
tabs.append({"last": {"icons": [], "iconstype": 0}})
defaults["tabshelf"] = {"auto_hide": False, "tabs": tabs}
defaults["tshelf"] = bool(all_rows)
# The managed shelf is presented as the room's application launcher. Keep its
# NeXT-style single-click affordance explicit instead of inheriting the
# upstream double-click default, which otherwise looks like a dead shelf.
defaults["singleclicklaunch"] = True

directory = os.path.dirname(path)
os.makedirs(directory, exist_ok=True)
fd, temporary = tempfile.mkstemp(prefix=".gworkspace.", dir=directory)
try:
    with os.fdopen(fd, "wb") as stream:
        stream.write(plistlib.dumps(defaults, fmt=plistlib.FMT_XML,
                                    sort_keys=False))
    os.chmod(temporary, mode)
    os.replace(temporary, path)
finally:
    if os.path.exists(temporary):
        os.unlink(temporary)
PY
}
project_gworkspace_tabshelf "${GUEST_HOME}/GNUstep/Defaults/org.gnustep.GWorkspace.plist"

# Dock on the right edge at live room geometry: tiles are 64px, so x = width-64.
ROOM_WIDTH="$(DISPLAY=${DISPLAY_NUM} xdpyinfo | awk '/dimensions:/{split($2,a,"x"); print a[1]; exit}')"
DOCK_X=$(( ROOM_WIDTH - 64 ))
mkdir -p "${GUEST_HOME}/GNUstep/Defaults"
sed "s/@DOCK_X@/${DOCK_X}/" "${DEFAULTS_SRC}/WMState.template" \
  > "${GUEST_HOME}/GNUstep/Defaults/WMState"

# Window Maker's top-right miniwindow placement deliberately avoids the Dock
# by using the adjacent 64px column. Keep those client icons below the six
# dock tiles where the tabbed shelf cannot cover them.
ICON_SHELF="${HOME}/.local/bin/sanctuary-gnustep-icon-shelf"
if [[ -x "${ICON_SHELF}" ]]; then
  DISPLAY="${DISPLAY_NUM}" XAUTHORITY="${XAUTHORITY:-${HOME}/.Xauthority}" \
    "${ICON_SHELF}" "${DISPLAY_NUM}" "${ROOM_WIDTH}" "6" &
  ICON_SHELF_PID=$!
fi

echo "${SANCTUARY}: Xephyr ${DISPLAY_NUM} ready — sourcing Guix profiles and starting Window Maker…"
DISPLAY="${DISPLAY_NUM}" sanctuary-exec "${SANCTUARY}" sh -c "
  GUIX_PROFILE=${GUIX_PROFILES}/desktop-common/desktop-common
  . \${GUIX_PROFILE}/etc/profile
  GUIX_PROFILE=${GUIX_PROFILES}/sanctuary-gnustep/sanctuary-gnustep
  . \${GUIX_PROFILE}/etc/profile
  # Keep GTK applications inside the room on the vendored classic theme.
  # Disable host/global GTK app-menu export for the GNU Emacs window.
  export GTK_THEME=OneStepBack
  export UBUNTU_MENUPROXY=0
  # GAP Terminal 0.9.9 passes SHELL to execv(), which does not search PATH.
  # The room profile may expose the user's shell as the conventional bare
  # name (for example, "zsh"); normalize it before GNUstep applications
  # inherit the environment so Terminal can actually spawn its shell.
  case "\${SHELL:-}" in
    /*) ;;
    *)
      SHELL_BIN=\$(command -v "\${SHELL:-sh}" 2>/dev/null || true)
      if [ -n "\${SHELL_BIN}" ]; then
        export SHELL="\${SHELL_BIN}"
      fi
      ;;
  esac
  # GNUstep runtime (Phase B, sanctuary-gnustep-build). When built, source its
  # environment so the root menu and Tools resolve, and boot GWorkspace as the
  # Workspace Manager — NeXT starts in Workspace, not a bare WM.
  GS_ROOT=\${HOME}/.local/share/gnustep
  if [ -f \${GS_ROOT}/share/GNUstep/Makefiles/GNUstep.sh ]; then
    . \${GS_ROOT}/share/GNUstep/Makefiles/GNUstep.sh
    # GNUstep.sh replaces EMACSLOADPATH with only its profile-local site-lisp
    # directory.  That hides Emacs' standard Lisp tree, so the native Emacs
    # bundle aborts on cl-lib before the shared classic config can start.
    # Keep both Guix package profiles and the trailing empty element that
    # restores Emacs' compiled-in standard load path.
    export EMACSLOADPATH=\"${GUIX_PROFILES}/desktop-common/desktop-common/share/emacs/site-lisp:${GUIX_PROFILES}/sanctuary-gnustep/sanctuary-gnustep/share/emacs/site-lisp:\"
    export GNUSTEP_INSTALLATION_DOMAIN=LOCAL
    export GNUSTEP_LOCAL_APPS=\${GS_ROOT}/lib/GNUstep/Applications
    # GWorkspace's NSWorkspace loads .GNUstepAppList once at process start.
    # Refresh it before launching GWorkspace so newly installed applications
    # and corrected document registrations are visible in this room session.
    MAKE_SERVICES_BIN=\${GS_ROOT}/bin/make_services
    APP_CACHE=\${HOME}/GNUstep/Library/Services/.GNUstepAppList
    if [ -x \"\${MAKE_SERVICES_BIN}\" ]; then
      \"\${MAKE_SERVICES_BIN}\" --quiet
      [ -s \"\${APP_CACHE}\" ] || {
        echo \"GNUstep application registry is missing after make_services\" >&2
        exit 1
      }
    else
      echo \"GNUstep make_services is missing: \${MAKE_SERVICES_BIN}\" >&2
      exit 1
    fi
    NEXTSPACE_THEME=\${GS_ROOT}/lib/GNUstep/Themes/NextSpace.theme
    if [ -d \"\${NEXTSPACE_THEME}\" ]; then
      # The pinned donor theme is compatible with this Cairo runtime when
      # GWorkspace's full-screen desktop surface is disabled above. Select it
      # here so the room gets NEXTSPACE's folder artwork and widget geometry.
      export XCURSOR_THEME=NextSpace
      export XCURSOR_PATH=\"\${HOME}/.local/share/icons:\${XCURSOR_PATH:-}\"
      DEFAULTS_BIN=\$(command -v defaults || true)
      if [ -n \"\${DEFAULTS_BIN}\" ] && [ -x \"\${DEFAULTS_BIN}\" ]; then
        \"\${DEFAULTS_BIN}\" write NSGlobalDomain GSTheme NextSpace >/dev/null 2>&1 || true
      else
        echo \"NEXTSPACE assets installed but defaults is unavailable; theme selection skipped\" >&2
      fi
    fi
    DDBD_BIN=\$(find \${GS_ROOT} -type f -path '*/bin/ddbd' -print -quit)
    if [ -n "\${DDBD_BIN}" ] && [ -x "\${DDBD_BIN}" ]; then
      if ! ps -eo args= | awk -v path="\${DDBD_BIN}" '\$1 == path && \$2 == "--daemon" && \$3 == "--auto" { found = 1 } END { exit !found }'; then
        "\${DDBD_BIN}" --daemon --auto >/dev/null 2>&1 &
        sleep 0.5
      fi
    fi
    GWS_BIN=\$(find \${GS_ROOT} -type f -name GWorkspace -path '*GWorkspace.app*' | head -1)
    if [ -n \"\${GWS_BIN}\" ] && [ -x \"\${GWS_BIN}\" ]; then
      ( sleep 2 && exec \"\${GWS_BIN}\" ) &
    fi
  fi
  exec wmaker
"

kill "${XEPHYR_PID}" 2>/dev/null || true
# Launcher: sanctuary-gnustep-launch:1 ends here
