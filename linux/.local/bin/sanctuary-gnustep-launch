#!/usr/bin/env bash
# [[file:../../../distrobox.org::*Sanctuary Launcher Scripts][Sanctuary Launcher Scripts:2]]
# Launch sanctuary-gnustep on Xephyr :91 (full-screen on current host desktop).
# Bind: host Super+2 → switch to Desktop 2, then run this.
set -euo pipefail

DISPLAY_NUM=":91"
SANCTUARY="sanctuary-gnustep"

Xephyr "${DISPLAY_NUM}" -fullscreen -br -ac &
XEPHYR_PID=$!

timeout 10 sh -c "until DISPLAY=${DISPLAY_NUM} xdpyinfo >/dev/null 2>&1; do sleep 0.1; done" \
  || { echo "Xephyr ${DISPLAY_NUM} did not become ready"; kill ${XEPHYR_PID}; exit 1; }

echo "Xephyr ${DISPLAY_NUM} ready — starting ${SANCTUARY}…"
DISPLAY="${DISPLAY_NUM}" distrobox exec --name "${SANCTUARY}" -- wmaker

kill "${XEPHYR_PID}" 2>/dev/null || true
# Sanctuary Launcher Scripts:2 ends here
