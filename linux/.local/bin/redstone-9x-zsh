#!/bin/bash
# [[file:../../../sanctuary-redstone-9x-desktop.org::*Bash and Zsh PowerShell-frame launchers (Run-box safe)][Bash and Zsh PowerShell-frame launchers (Run-box safe):2]]
set -u
# Same contract as redstone-9x-bash, for zsh — the default PowerShell-frame
# shell (Terminals menu lists Zsh first).
self_dir="$(cd "$(dirname "$0")" && pwd)"
shell_name="zsh"
real=""
IFS=: read -ra _dirs <<< "${PATH}"
for _d in "${_dirs[@]}"; do
  [ "${_d}" = "${self_dir}" ] && continue
  [ -x "${_d}/${shell_name}" ] && { real="${_d}/${shell_name}"; break; }
done
[ -n "${real}" ] || real="/bin/${shell_name}"

if [ "${1:-}" != "--window" ]; then
  if [ $# -gt 0 ] || [ -t 0 ] || [ -z "${DISPLAY:-}" ] \
     || [ "$(readlink -f /proc/self/fd/0 2>/dev/null)" != "/dev/null" ]; then
    exec "${real}" "$@"
  fi
fi

exec redstone-9x-run urxvt -name redstone-bash-powershell -title "Zsh" \
  -geometry 80x25 +sb -bg rgb:01/24/56 -fg rgb:ee/ed/f0 -cr rgb:ee/ed/f0 \
  -fn "xft:Cascadia Mono:size=11:antialias=true,xft:Consolas:size=11:antialias=true" \
  -e "${real}"
# Bash and Zsh PowerShell-frame launchers (Run-box safe):2 ends here
