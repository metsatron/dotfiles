#!/bin/bash
# [[file:../../../sanctuary-redstone-9x-desktop.org::*Bash and Zsh PowerShell-frame launchers (Run-box safe)][Bash and Zsh PowerShell-frame launchers (Run-box safe):2]]
set -u
# Same passthrough contract as redstone-9x-bash.  --window keeps the fixed
# PowerShell-frame Zsh terminal; --default-window is the one scheme-aware
# URxvt/Zsh terminal used by the main menu and quick-launch strips.
self_dir="$(cd "$(dirname "$0")" && pwd)"
shell_name="zsh"
real=""
IFS=: read -ra _dirs <<< "${PATH}"
for _d in "${_dirs[@]}"; do
  [ "${_d}" = "${self_dir}" ] && continue
  [ -x "${_d}/${shell_name}" ] && { real="${_d}/${shell_name}"; break; }
done
[ -n "${real}" ] || real="/bin/${shell_name}"

if [ "${1:-}" = "--default-window" ]; then
  REDSTONE_TERM_SCHEME="Windows 95"
  REDSTONE_TERM_BG="#000080"
  REDSTONE_TERM_FG="#ffffff"
  REDSTONE_TERM_CURSOR="#ffffff"
  REDSTONE_TERM_FONT="xft:PxPlus IBM VGA 9x14:size=14:antialias=true,xft:monospace:size=14:antialias=true"
  theme_module="${HOME}/.config/redstone-9x/terminal-theme.zsh"
  # The module is deliberately shell-sourceable: this launcher consumes its
  # URxvt values, then the child Zsh consumes its prompt/modeline values.
  [ -r "${theme_module}" ] && . "${theme_module}"
  # Sixteen ANSI slots, contrast-corrected against this scheme's background by
  # redstone-9x-scheme-apply. Without them URxvt falls back to a dark-background
  # default palette, and on the light schemes (serenity, the BeOS greys, CDE)
  # ANSI yellow and cyan come out unreadable for anything that colours its own
  # output — ls, git, grep, completion. Deliberately unquoted: the value is a
  # space-separated list of hex colours, which contain no globs or whitespace.
  ansi_args=""
  if [ -n "${REDSTONE_TERM_ANSI:-}" ]; then
    _i=0
    for _c in ${REDSTONE_TERM_ANSI}; do
      ansi_args="${ansi_args} -color${_i} ${_c}"
      _i=$((_i + 1))
    done
  fi
  # shellcheck disable=SC2086
  exec redstone-9x-run urxvt -name redstone-zsh-default \
    -title "Terminal — ${REDSTONE_TERM_SCHEME}" -geometry 80x25 +sb -sl 10000 \
    -bg "${REDSTONE_TERM_BG}" -fg "${REDSTONE_TERM_FG}" \
    -cr "${REDSTONE_TERM_CURSOR}" -fn "${REDSTONE_TERM_FONT}" \
    ${ansi_args} \
    -e env REDSTONE_ZSH_THEME=1 "${real}"
fi

if [ "${1:-}" != "--window" ]; then
  if [ $# -gt 0 ] || [ -t 0 ] || [ -z "${DISPLAY:-}" ] \
     || [ "$(readlink -f /proc/self/fd/0 2>/dev/null)" != "/dev/null" ]; then
    exec "${real}" "$@"
  fi
fi

exec redstone-9x-run urxvt -name redstone-bash-powershell -title "Zsh" \
  -geometry 80x25 +sb -bg rgb:01/24/56 -fg rgb:ee/ed/f0 -cr rgb:ee/ed/f0 \
  -fn "xft:Cascadia Mono:size=11:antialias=true,xft:Consolas:size=11:antialias=true" \
  -e "${real}"
# Bash and Zsh PowerShell-frame launchers (Run-box safe):2 ends here
