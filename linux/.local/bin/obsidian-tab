#!/usr/bin/env bash
# obsidian-tab — vault in a kitty tab via Carbonyl

# Opens the obsidian-web server (spike: X230 tailnet, see HelmCortex TODO "obsidian-web spike") in a new kitty tab rendered by Carbonyl. Inside kitty it opens a real tab via remote control; outside kitty it just runs Carbonyl in the current terminal. Override the target with =OBSIDIAN_WEB_URL= or a URL argument.


# [[file:../../../tools.org::*obsidian-tab — vault in a kitty tab via Carbonyl][obsidian-tab — vault in a kitty tab via Carbonyl:1]]
set -euo pipefail

url="${1:-${OBSIDIAN_WEB_URL:-}}"
if [ -z "$url" ]; then
  # rule 21: derive the serving host's tailnet IP at runtime, no addresses in source.
  # Default target is the caddy gate (obsidian-web-gate, app.org) on the X230.
  ip="$(tailscale ip -4 thinkpad-x230 2>/dev/null | head -n1)"
  if [ -z "$ip" ]; then
    echo "obsidian-tab: cannot resolve thinkpad-x230 tailnet IP (is tailscaled running?)" >&2
    exit 1
  fi
  url="http://$ip:${OBSIDIAN_GATE_PORT:-8443}/mobile"
  # Pin a vault so the mobile runtime skips the /start picker (which routes to
  # the desktop client). Set OBSIDIAN_WEB_VAULT to the 16-hex vault id in the
  # machine environment — never hardcoded here (public repo).
  [ -n "${OBSIDIAN_WEB_VAULT:-}" ] && url="$url?vault=$OBSIDIAN_WEB_VAULT"
fi

if ! command -v carbonyl >/dev/null 2>&1; then
  echo "obsidian-tab: carbonyl not found — Lane 1 tool, encode/apply via DotCortex package-npm.org (loom npm:apply)" >&2
  exit 1
fi

if [ -n "${KITTY_LISTEN_ON:-}" ] || [ -n "${KITTY_WINDOW_ID:-}" ]; then
  exec kitten @ launch --type=tab --tab-title "Obsidian" carbonyl "$url"
fi

exec carbonyl "$url"
# obsidian-tab — vault in a kitty tab via Carbonyl:1 ends here
