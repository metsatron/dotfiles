#!/usr/bin/env bash
# [[file:../../../sanctuary-cortex.org::*Guix profile][Guix profile:2]]
set -euo pipefail

ROOT="${DOTCORTEX_ROOT:-$HOME/DotCortex}"
MANIFEST="${SANCTUARY_CORTEX_MANIFEST:-$ROOT/all/.config/guix/manifests/sanctuaries/sanctuary-cortex.scm}"
PROFILE_ROOT="${SANCTUARY_CORTEX_PROFILE_ROOT:-$HOME/.guix-extra-profiles/sanctuary-cortex}"
PROFILE="${PROFILE_ROOT}/sanctuary-cortex"

[[ -f "$MANIFEST" ]] || { echo "sanctuary-cortex-guix-apply: missing $MANIFEST" >&2; exit 1; }
GUIX="${GUIX:-}"
if [[ -z "$GUIX" ]]; then
  GUIX="$(command -v guix 2>/dev/null || true)"
fi
if [[ -z "$GUIX" && -x "$HOME/.config/guix/current/bin/guix" ]]; then
  GUIX="$HOME/.config/guix/current/bin/guix"
fi
[[ -x "$GUIX" ]] || { echo "sanctuary-cortex-guix-apply: Guix not found" >&2; exit 127; }

mkdir -p "$PROFILE_ROOT"
"$GUIX" package --manifest="$MANIFEST" --profile="$PROFILE"
echo "sanctuary-cortex-guix-apply: profile ready at $PROFILE"
# Guix profile:2 ends here
