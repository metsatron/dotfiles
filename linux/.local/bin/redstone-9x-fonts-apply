#!/usr/bin/env bash
# Font provision script

# Stages Microsoft and period-appropriate fonts into the room's private font directory
# at =~/.local/share/dotcortex/guests/sanctuary-redstone-9x/fonts/=.  This path is
# outside DotCortex git (mutable guest state).  The launch script symlinks this dir
# into the guest home's =.local/share/fonts/redstone-9x= for fontconfig.

# The default themed URxVT terminal shares Godzilla XS's exact terminal face.  That
# font is private host payload, so DotCortex declares its family and checksum rather
# than carrying the binary.  NeXTSTEP schemes use TeX Gyre Heros, which is free and
# therefore belongs declaratively in the =room-gaming= Guix profile.  This helper
# materializes both sources into Redstone's persistent font stage and rebuilds the
# guest-local fontconfig cache.  It runs during both a full launch and
# =loom redstone:refresh=, and verifies that neither family silently fell back.


# [[file:../../../sanctuary-redstone-9x-desktop.org::*Font provision script][Font provision script:1]]
set -euo pipefail

SANCTUARY="sanctuary-redstone-9x"
GUESTS_DIR="${XDG_DATA_HOME:-${HOME}/.local/share}/dotcortex/guests"
GUEST_HOME="${GUESTS_DIR}/${SANCTUARY}/home"
FONT_STAGE="${GUESTS_DIR}/${SANCTUARY}/fonts"
GUEST_FONT_LINK="${GUEST_HOME}/.local/share/fonts/redstone-9x"
ROOM_PROFILE="${HOME}/.guix-extra-profiles/room-gaming/room-gaming"
FONTCONFIG_BIN="${ROOM_PROFILE}/bin"
PRIVATE_FAMILY="PxPlus IBM VGA 9x14"
PRIVATE_EXPECTED_SHA="03c0a9a7d169fdac7c4f2c1a4aeb2a9c6f19175325d250e2765c6365e6eb588b"
NEXTSTEP_FAMILY="TeX Gyre Heros"
NEXTSTEP_FONT_DIR="${ROOM_PROFILE}/share/fonts/opentype"
NEXTSTEP_FONT_FILES=(
  texgyreheros-regular.otf
  texgyreheros-bold.otf
  texgyreheros-italic.otf
  texgyreheros-bolditalic.otf
)
MODE="apply"

if [[ "${1:-}" == "--check" ]]; then
  MODE="check"
  shift
fi
if (( $# )); then
  echo "usage: redstone-9x-fonts-apply [--check]" >&2
  exit 2
fi

FC_MATCH="$(command -v fc-match 2>/dev/null || true)"
[[ -n "${FC_MATCH}" ]] || { echo "redstone-9x-fonts-apply: host fc-match unavailable" >&2; exit 1; }
[[ -x "${FONTCONFIG_BIN}/fc-cache" && -x "${FONTCONFIG_BIN}/fc-match" \
   && -x "${FONTCONFIG_BIN}/fc-scan" ]] || {
  echo "redstone-9x-fonts-apply: room-gaming fontconfig profile unavailable" >&2
  exit 1
}

private_resolved_family="$(${FC_MATCH} -f '%{family[0]}' "${PRIVATE_FAMILY}")"
private_source_file="$(${FC_MATCH} -f '%{file}' "${PRIVATE_FAMILY}")"
[[ "${private_resolved_family}" == "${PRIVATE_FAMILY}" && -f "${private_source_file}" ]] || {
  echo "redstone-9x-fonts-apply: required host font unavailable: ${PRIVATE_FAMILY}" >&2
  exit 1
}
actual_sha="$(sha256sum "${private_source_file}" | awk '{print $1}')"
[[ "${actual_sha}" == "${PRIVATE_EXPECTED_SHA}" ]] || {
  echo "redstone-9x-fonts-apply: checksum mismatch for ${PRIVATE_FAMILY}" >&2
  echo "  expected: ${PRIVATE_EXPECTED_SHA}" >&2
  echo "  actual:   ${actual_sha}" >&2
  exit 1
}

for font_name in "${NEXTSTEP_FONT_FILES[@]}"; do
  source_file="${NEXTSTEP_FONT_DIR}/${font_name}"
  [[ -f "${source_file}" ]] || {
    echo "redstone-9x-fonts-apply: room-gaming lacks ${source_file}; apply the profile" >&2
    exit 1
  }
  scanned_family="$("${FONTCONFIG_BIN}/fc-scan" -f '%{family[0]}' "${source_file}")"
  [[ "${scanned_family}" == "${NEXTSTEP_FAMILY}" ]] || {
    echo "redstone-9x-fonts-apply: ${font_name} is ${scanned_family}, expected ${NEXTSTEP_FAMILY}" >&2
    exit 1
  }
done

guest_font_env=(
  "HOME=${GUEST_HOME}"
  "XDG_DATA_HOME=${GUEST_HOME}/.local/share"
  "XDG_CACHE_HOME=${GUEST_HOME}/.cache"
  "PATH=${FONTCONFIG_BIN}:/usr/bin:/bin"
)

verify_guest_font() {
  local family="$1" guest_family guest_file
  guest_family="$(env -i "${guest_font_env[@]}" "${FONTCONFIG_BIN}/fc-match" -f '%{family[0]}' "${family}")"
  guest_file="$(env -i "${guest_font_env[@]}" "${FONTCONFIG_BIN}/fc-match" -f '%{file}' "${family}")"
  [[ "${guest_family}" == "${family}" ]] \
    && [[ "${guest_file}" == "${GUEST_FONT_LINK}/"* || "${guest_file}" == "${FONT_STAGE}/"* ]]
}

if [[ "${MODE}" == "check" ]]; then
  verify_guest_font "${PRIVATE_FAMILY}" && verify_guest_font "${NEXTSTEP_FAMILY}"
  exit
fi

mkdir -p "${FONT_STAGE}" "$(dirname "${GUEST_FONT_LINK}")" "${GUEST_HOME}/.cache"
if [[ -e "${GUEST_FONT_LINK}" && ! -L "${GUEST_FONT_LINK}" ]]; then
  echo "redstone-9x-fonts-apply: refusing to replace non-symlink ${GUEST_FONT_LINK}" >&2
  exit 1
fi
project_font() {
  local source_file="$1" family="$2" destination
  destination="${FONT_STAGE}/$(basename "${source_file}")"
  if [[ ! -f "${destination}" ]] || ! cmp -s "${source_file}" "${destination}"; then
    install -m0644 "${source_file}" "${destination}.new"
    mv -f "${destination}.new" "${destination}"
    echo "redstone-9x-fonts-apply: projected ${family}: $(basename "${source_file}")"
  fi
}

project_font "${private_source_file}" "${PRIVATE_FAMILY}"
for font_name in "${NEXTSTEP_FONT_FILES[@]}"; do
  project_font "${NEXTSTEP_FONT_DIR}/${font_name}" "${NEXTSTEP_FAMILY}"
done
ln -sfnT "${FONT_STAGE}" "${GUEST_FONT_LINK}"
env -i "${guest_font_env[@]}" "${FONTCONFIG_BIN}/fc-cache" -f "${GUEST_FONT_LINK}" >/dev/null
for family in "${PRIVATE_FAMILY}" "${NEXTSTEP_FAMILY}"; do
  verify_guest_font "${family}" || {
    echo "redstone-9x-fonts-apply: guest verification failed for ${family}" >&2
    exit 1
  }
  echo "redstone-9x-fonts-apply: ${family} verified"
done
# Font provision script:1 ends here
