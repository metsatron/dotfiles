#!/usr/bin/env bash
# Sanctuary Launcher Scripts

# Each launcher starts Xephyr full-screen on the current host desktop, waits for
# the display, then sources the Guix profiles inside the container and starts the
# selected WM/session.

# All entries go through =sanctuary-enter=. Distrobox 1.8.2.4 copies almost every host
# environment variable into =podman exec --env= arguments; the helper starts Distrobox
# under =env -i= and restores only the variables required for identity, locale, display,
# session D-Bus, and audio. API keys and agent sockets must never cross this boundary.


# [[file:../../../sanctuary-distrobox.org::*Sanctuary Launcher Scripts][Sanctuary Launcher Scripts:1]]
# Select and launch a tested graphical habitat profile.
# Usage: sanctuary-enter [profile-id]
#
# Desktop skews: each sanctuary may declare multiple desktop options.
# Add entries below as new desktops are validated.
# Key: sanctuary-name (as it appears in distrobox list)
# Value: space-separated list of desktop identifiers for that sanctuary.
# The first deskop listed is the default (used when no :desktop suffix is given).
declare -A SANCTUARY_DESKTOPS=(
  ["sanctuary-redstone-9x"]="icewm fvwm95"
  ["sanctuary-cde"]="cde"
  ["sanctuary-godzilla-xs"]="xfce4"
  ["sanctuary-gnustep"]="wmaker"
  ["sanctuary-qtile"]="qtile"
  ["sanctuary-retropie"]="emulationstation"
)

# Visible habitat identities (display only). Technical identifiers never
# change — Machine Law, HelmCortex Godzilla-XS-86000.md. Sanctuaries without
# an entry display their technical name.
declare -A SANCTUARY_TITLES=(
  ["sanctuary-redstone-9x"]="Redstone 9X"
  ["sanctuary-cde"]="CDE"
  ["sanctuary-godzilla-xs"]="Godzilla XS"
  ["sanctuary-gnustep"]="GNUstep"
  ["sanctuary-qtile"]="Qtile (Emacs Sanctuary)"
  ["sanctuary-retropie"]="RetroPie"
)

# Remote Xpra sanctuaries — persistent displays on headless fleet hosts,
# reached with `xpra attach ssh://<alias>/<display>`. Keyed by SSH ALIAS, never
# by address: DotCortex is public, and the alias resolves through each
# machine's hand-managed ~/.ssh/config (rule 21), so no IP or tailnet address
# ever appears in this repo. Value: "<ssh-alias> <display-number>".
# A remote entry is offered only when the alias is actually defined in the
# local ssh config (and hidden on its own host, where the session is local).
declare -A REMOTE_XPRA_SANCTUARIES=(
  ["xpra-cortex"]="kikin 101"
  ["xpra-cortex-apps"]="kikin 100"
)
declare -A REMOTE_XPRA_TITLES=(
  ["xpra-cortex"]="Cortex Pillar (kikin-kushi) — full desktop"
  ["xpra-cortex-apps"]="Cortex Pillar (kikin-kushi) — seamless apps"
)

usage() {
  cat <<EOF
sanctuary-enter - select and launch a tested graphical habitat profile

Usage:
  sanctuary-enter                       Interactive fzf picker over available sanctuaries
  sanctuary-enter <sanctuary-name>[:desktop]
  sanctuary-enter -h | --help

With no argument, discovers sanctuaries via 'distrobox list', cross-references
the desktop skews declared below, and offers an fzf menu
(Alt-e down, Alt-i up, Alt-o enter, Alt-n cancel). A bare sanctuary name
launches its first/default desktop; append ':desktop' to pick another.

Known sanctuaries and their desktop skews:
$(for _s in "${!SANCTUARY_DESKTOPS[@]}"; do printf '  %-22s %-24s %s\n' "${_s}" "${SANCTUARY_TITLES[${_s}]:-}" "${SANCTUARY_DESKTOPS[${_s}]}"; done | sort)

Remote Xpra sanctuaries (offered when their SSH alias is configured locally):
$(for _r in "${!REMOTE_XPRA_SANCTUARIES[@]}"; do printf '  %-22s %s\n' "${_r}" "${REMOTE_XPRA_TITLES[${_r}]:-}"; done | sort)

For a plain shell instead of a graphical session: distrobox-room enter <sanctuary-name>
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

set -euo pipefail

if (( $# > 1 )); then
  echo "Usage: sanctuary-enter [sanctuary-name[:desktop]]" >&2
  echo "For a shell: distrobox-room enter <sanctuary-name>" >&2
  exit 2
fi

if (( $# == 1 )); then
  PROFILE="$1"
else
  DISTROBOX_BIN="$(command -v distrobox)" \
    || { echo "sanctuary-enter: distrobox not found" >&2; exit 127; }
  FZF_BIN="$(command -v fzf)" \
    || { echo "sanctuary-enter: fzf not found" >&2; exit 127; }

  # Discover sanctuaries from distrobox list.
  AVAILABLE_SANCTUARIES="$(
    "${DISTROBOX_BIN}" list --no-color | awk -F '|' '
      NR > 1 {
        name = $2
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", name)
        print name
      }
    '
  )"

  # Build fzf menu: for each discovered sanctuary that has a declared desktop
  # skew and a matching launcher script, emit one menu line per desktop.
  PROFILES=""
  while IFS= read -r SANCTUARY; do
    DESKTOPS="${SANCTUARY_DESKTOPS[${SANCTUARY}]:-}"
    if [[ -z "${DESKTOPS}" ]]; then
      continue
    fi
    # Verify launcher script exists.
    LAUNCHER_NAME="${SANCTUARY}-launch"
    if ! command -v "${LAUNCHER_NAME}" >/dev/null 2>&1; then
      continue
    fi
    TITLE="${SANCTUARY_TITLES[${SANCTUARY}]:-${SANCTUARY}}"
    for DESKTOP in ${DESKTOPS}; do
      PROFILES="${PROFILES}${SANCTUARY}:${DESKTOP}"$'\t'"${TITLE} — ${DESKTOP}"$'\n'
    done
  done <<< "${AVAILABLE_SANCTUARIES}"

  # Offer remote Xpra sanctuaries whose SSH alias is defined locally. The
  # alias test is offline: `ssh -G <alias>` echoes the alias back as hostname
  # when no Host block defines it, and echoes the configured HostName when one
  # does. Skip entries whose alias is undefined, and skip xpra-less viewers.
  if command -v xpra >/dev/null 2>&1; then
    for REMOTE_ID in "${!REMOTE_XPRA_SANCTUARIES[@]}"; do
      read -r REMOTE_ALIAS REMOTE_DISPLAY <<< "${REMOTE_XPRA_SANCTUARIES[${REMOTE_ID}]}"
      RESOLVED="$(ssh -G "${REMOTE_ALIAS}" 2>/dev/null | awk '/^hostname /{print $2; exit}')"
      if [[ -z "${RESOLVED}" || "${RESOLVED}" == "${REMOTE_ALIAS}" ]]; then
        continue
      fi
      TITLE="${REMOTE_XPRA_TITLES[${REMOTE_ID}]:-${REMOTE_ID}}"
      PROFILES="${PROFILES}${REMOTE_ID}"$'\t'"${TITLE}"$'\n'
    done
  fi

  if [[ -z "${PROFILES}" ]]; then
    echo "sanctuary-enter: no available sanctuaries" >&2
    exit 1
  fi

  # Menu lines are "id:desktop<TAB>Display Title — desktop"; fzf shows only
  # the display half, and the selection is cut back to the technical id.
  PROFILE="$(
    printf '%s\n' "${PROFILES}" \
      | "${FZF_BIN}" \
          --prompt='habitat> ' \
          --height=40% \
          --layout=reverse \
          --border \
          --delimiter='\t' \
          --with-nth=2 \
          --header='Alt-e down · Alt-i up · Alt-o enter · Alt-n cancel' \
          --bind='alt-e:down,alt-i:up,alt-o:accept,alt-n:abort'
  )" || exit 130
  PROFILE="${PROFILE%%$'\t'*}"
fi

# Remote Xpra entries dispatch straight to an attach — no local launcher.
if [[ -n "${REMOTE_XPRA_SANCTUARIES[${PROFILE}]:-}" ]]; then
  read -r REMOTE_ALIAS REMOTE_DISPLAY <<< "${REMOTE_XPRA_SANCTUARIES[${PROFILE}]}"
  TITLE="${REMOTE_XPRA_TITLES[${PROFILE}]:-${PROFILE}}"
  echo "sanctuary-enter: attaching ${TITLE} (ssh://${REMOTE_ALIAS}/${REMOTE_DISPLAY})"
  exec xpra attach "ssh://${REMOTE_ALIAS}/${REMOTE_DISPLAY}" --title="${TITLE}"
fi

# Resolve PROFILE (sanctuary-name:desktop) into a launcher script.
# A bare sanctuary-name (no colon) uses the first/only declared desktop.
SANCTUARY_NAME="${PROFILE%%:*}"

# Validate the sanctuary is known.
DESKTOPS="${SANCTUARY_DESKTOPS[${SANCTUARY_NAME}]:-}"
if [[ -z "${DESKTOPS}" ]]; then
  echo "sanctuary-enter: unknown sanctuary: ${SANCTUARY_NAME}" >&2
  exit 2
fi

# If no :desktop suffix, default to the first declared desktop.
if [[ "${PROFILE}" != *:* ]]; then
  PROFILE="${PROFILE}:${DESKTOPS%% *}"
fi

LAUNCHER="${SANCTUARY_NAME}-launch"
LAUNCHER_BIN="$(command -v "${LAUNCHER}")" \
  || { echo "sanctuary-enter: launcher not found: ${LAUNCHER}" >&2; exit 127; }

# Export selected desktop so the launcher can act on it if it supports multiple.
export SANCTUARY_DESKTOP="${PROFILE#*:}"
exec "${LAUNCHER_BIN}"
# Sanctuary Launcher Scripts:1 ends here
