#!/usr/bin/env bash
# Shared VM Utilities


# [[file:../../../qemu.org::*Shared VM Utilities][Shared VM Utilities:1]]
# List known VMs and their current QEMU process status.
set -euo pipefail

vms=(azure-neptune)

echo "Virtual Habitat — KVM VM status"
echo "--------------------------------"
for vm in "${vms[@]}"; do
  if pgrep -f "qemu.*${vm}" >/dev/null 2>&1; then
    echo "  [running] $vm"
  else
    echo "  [stopped] $vm"
  fi
done
# Shared VM Utilities:1 ends here
