#!/usr/bin/env bash
# Wine prefix initialiser

# Idempotent script run by the launch script before IceWM starts.  Creates
# the Wine prefix in the isolated guest home, installs Wine package fonts into
# the Windows =Fonts= directory, and imports the CMD console registry template.

# Requires environment: =WINEPREFIX=, =DOTCORTEX_DIR=, =wine= in PATH.


# [[file:../../../sanctuary-redstone-9x-desktop.org::*Wine prefix initialiser][Wine prefix initialiser:1]]
set -euo pipefail

MARKER="${WINEPREFIX}/.dotcortex-wineprefix-complete"
WINE_USER="${WINEPREFIX}/drive_c/users/$(id -un)"

# Retire only the two raw-device mappings left by the old optical experiment.
# Keep any other user-created mapping intact, and quarantine the symlinks rather
# than deleting them so the migration is recoverable from the private prefix.
retire_raw_device_links() {
  local mapping drive target link quarantine stamp
  [[ -d "${WINEPREFIX}/dosdevices" ]] || return 0
  quarantine="${WINEPREFIX}/.dotcortex-retired-drive-mappings"
  stamp="$(date +%Y%m%d-%H%M%S)"
  for mapping in "d /dev/sda1" "e /dev/sda"
  do
    drive="${mapping%% *}"
    target="${mapping#* }"
    link="${WINEPREFIX}/dosdevices/${drive}:"
    [[ -L "${link}" ]] || continue
    [[ "$(readlink "${link}")" == "${target}" ]] || continue
    mkdir -p "${quarantine}"
    mv -- "${link}" "${quarantine}/${drive}:.${stamp}"
    echo "redstone-9x: retired raw Wine mapping ${drive}: -> ${target}"
  done
}

# The POSIX home tree is canonical.  Wine's user profile is only a Windows
# compatibility projection into that tree.  Reconcile it on every launch so an
# existing completed prefix can be repaired without re-running wineboot or the
# expensive font/registry/winetricks work below.
sync_wine_user_dirs() {
  local _name _target _link _current

  # wineboot creates this profile on a fresh prefix; there is nothing to link
  # until it exists.
  [[ -d "${WINE_USER}" ]] || return 0

  for _name in Desktop Documents Downloads Music Pictures Videos "Saved Games" Searches Links Favorites Contacts; do
    _target="${HOME}/${_name}"
    _link="${WINE_USER}/${_name}"
    mkdir -p "${_target}"

    if [[ -L "${_link}" ]]; then
      _current="$(readlink "${_link}")"
      if [[ "${_current}" == "${_target}" ]]; then
        continue
      fi
      # Never overwrite an unknown symlink: it may be a user compatibility
      # choice.  Only the exact target above is managed by this initializer.
      echo "redstone-9x: ${_link} points to ${_current} — left as-is" >&2
      continue
    elif [[ -d "${_link}" ]]; then
      # Existing empty Wine skeleton directories are safe to replace.  Any
      # non-empty directory is preserved, with no migration or deletion.
      if ! rmdir "${_link}" 2>/dev/null; then
        echo "redstone-9x: ${_link} is non-empty — left as-is" >&2
        continue
      fi
    elif [[ -e "${_link}" ]]; then
      echo "redstone-9x: ${_link} is not a directory — left as-is" >&2
      continue
    fi

    ln -s "${_target}" "${_link}"
  done
}

retire_raw_device_links
sync_wine_user_dirs
if [[ -f "${MARKER}" ]]; then
  exit 0
fi

echo "redstone-9x: initialising Wine prefix at ${WINEPREFIX}…"

WINEDEBUG=-all wineboot -u
sync_wine_user_dirs

# 1. Copy Wine package fonts (from Guix profile)
WINE_FONTS_SRC="$(dirname "$(dirname "$(command -v wine)")")/share/wine/fonts"
WINE_FONTS_DST="${WINEPREFIX}/drive_c/windows/Fonts"
if [[ -d "${WINE_FONTS_SRC}" && -d "${WINE_FONTS_DST}" ]]; then
  cp -n "${WINE_FONTS_SRC}"/*.ttf "${WINE_FONTS_DST}/" 2>/dev/null || true
fi

# 2. Copy staged Microsoft fonts (provisioned by redstone-9x-font-provision)
FONT_STAGE="${WINEPREFIX%/.wine-redstone}/../fonts"
if [[ -d "${FONT_STAGE}" ]]; then
  cp -n "${FONT_STAGE}"/*.ttf "${WINE_FONTS_DST}/" 2>/dev/null || true
  cp -n "${FONT_STAGE}"/*.TTF "${WINE_FONTS_DST}/" 2>/dev/null || true
fi

# 3. Import CMD console appearance registry template
REG="${DOTCORTEX_DIR}/linux/.config/redstone-9x/wine-cmd-console.reg"
if [[ -f "${REG}" ]]; then
  WINEDEBUG=-all wine regedit "${REG}"
fi

# 4. bash.cmd bridge: typing 'bash' in Wine CMD opens a Bash-CMD frame.
#    Uses Wine's start /unix extension to spawn a native Linux process.
BASH_CMD="${WINEPREFIX}/drive_c/windows/system32/bash.cmd"
cat > "${BASH_CMD}" <<'BASHCMD'
@echo off
start /unix urxvt -name redstone-bash-cmd -title "Bash"
BASHCMD

# 5. Install Internet Explorer declaratively via winetricks. ie6 (2002) is the
#    oldest winetricks can fetch unattended and the most period-appropriate for a
#    Win95 desktop; IE 4/5/5.5 + Netscape Communicator (true 1996-2000 era) are a
#    planned follow-up, sourced from the evolt.org browser archive (browsers.evolt.org).
IE_WINETRICKS_VERB="ie6"
IE_EXE_64="${WINEPREFIX}/drive_c/Program Files/Internet Explorer/iexplore.exe"
IE_EXE_32="${WINEPREFIX}/drive_c/Program Files (x86)/Internet Explorer/iexplore.exe"
if [[ -f "${IE_EXE_64}" || -f "${IE_EXE_32}" ]]; then
  echo "redstone-9x: Internet Explorer already present — skipping ${IE_WINETRICKS_VERB}"
else
  winetricks -q "${IE_WINETRICKS_VERB}"
fi

fc-cache -s 2>/dev/null || true
touch "${MARKER}"
echo "redstone-9x: Wine prefix ready"
# Wine prefix initialiser:1 ends here
