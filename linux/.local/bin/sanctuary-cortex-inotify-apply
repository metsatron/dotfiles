#!/bin/env bash
# Host resource provisioning

# HelmCortex contains large generated trees. Obsidian uses one Linux inotify
# instance while indexing a vault, and the default Devuan ceiling is shared by
# the desktop's accessibility and portal processes. Provision the host ceilings
# before Cortex starts so the private vault can be opened without changing the
# vault layout or the sanctuary container.


# [[file:../../../sanctuary-cortex.org::*Host resource provisioning][Host resource provisioning:1]]
set -euo pipefail

CONFIG_PATH="${SANCTUARY_CORTEX_INOTIFY_CONFIG:-/etc/sysctl.d/90-dotcortex-sanctuary-cortex.conf}"
WATCHES="${SANCTUARY_CORTEX_INOTIFY_WATCHES:-1048576}"
INSTANCES="${SANCTUARY_CORTEX_INOTIFY_INSTANCES:-1024}"

[[ "${WATCHES}" =~ ^[0-9]+$ && "${INSTANCES}" =~ ^[0-9]+$ ]] || {
  echo "sanctuary-cortex-inotify-apply: limits must be numeric" >&2
  exit 2
}

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
printf '%s\n' \
  '# Managed by DotCortex: sanctuary-cortex Obsidian capacity.' \
  "fs.inotify.max_user_watches = ${WATCHES}" \
  "fs.inotify.max_user_instances = ${INSTANCES}" > "$tmp"

if [[ "$(id -u)" -eq 0 ]]; then
  install -D -m 0644 "$tmp" "$CONFIG_PATH"
  sysctl -w "fs.inotify.max_user_watches=${WATCHES}" \
          "fs.inotify.max_user_instances=${INSTANCES}"
else
  command -v sudo >/dev/null 2>&1 || {
    echo "sanctuary-cortex-inotify-apply: sudo is required to provision ${CONFIG_PATH}" >&2
    exit 127
  }
  sudo -n install -D -m 0644 "$tmp" "$CONFIG_PATH"
  sudo -n sysctl -w "fs.inotify.max_user_watches=${WATCHES}" \
                   "fs.inotify.max_user_instances=${INSTANCES}"
fi

echo "sanctuary-cortex-inotify-apply: watches=${WATCHES} instances=${INSTANCES}"
# Host resource provisioning:1 ends here
