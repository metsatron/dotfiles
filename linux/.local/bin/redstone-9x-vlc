#!/bin/bash
# [[file:../../../distrobox.org::*xclass Explorer launcher wrapper][xclass Explorer launcher wrapper:2]]
# VLC is already installed in the sanctuary-sx Guix profile (not room-gaming);
# project it into Redstone by sourcing that profile here. Avoids reinstalling
# or duplicating the package. NO_AT_BRIDGE suppresses at-spi2 bus spawning.
set -euo pipefail
SX="/home/metsatron/.guix-extra-profiles/sanctuary-sx/sanctuary-sx"
if [[ -f "${SX}/etc/profile" ]]; then
  GUIX_PROFILE="${SX}" . "${SX}/etc/profile"
fi
export NO_AT_BRIDGE=1
exec vlc "$@"
# xclass Explorer launcher wrapper:2 ends here
