#!/bin/env bash
# [[file:../../../sanctuary-cortex.org::*Private migration bridges][Private migration bridges:2]]
set -euo pipefail

PRIVATE_ROOT="${SANCTUARY_CORTEX_PRIVATE_ROOT:-$HOME/HelmCortex/NEXUS/sanctuaries/sanctuary-cortex}"
PROFILE="${PRIVATE_ROOT}/firefox-profile"
GUEST_HOME="${SANCTUARY_CORTEX_GUEST_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/dotcortex/guests/sanctuary-cortex/home}"
TARGET="${GUEST_HOME}/.config/sanctuary/cortex-firefox-profile"
LEGACY_TARGET="${GUEST_HOME}/.firedragon/flatpak-migrate"

[[ -d "$PROFILE" && -f "$PROFILE/prefs.js" && -f "$PROFILE/places.sqlite" ]] || {
  echo "profile-apply: private Cortex profile is not ready: $PROFILE" >&2
  exit 1
}
mkdir -p "$(dirname "$TARGET")"

# FireDragon's Flatpak metadata reserves .firedragon as a persistent app
# directory. A profile symlink below it makes bubblewrap fail before the app
# starts, so retire the old bridge into a timestamped recovery path.
if [[ -e "$LEGACY_TARGET" || -L "$LEGACY_TARGET" ]]; then
  legacy_backup="${LEGACY_TARGET}.before-cortex-persistent.$(date +%Y%m%d-%H%M%S)"
  mv "$LEGACY_TARGET" "$legacy_backup"
  echo "profile-apply: retired legacy profile link to $legacy_backup"
fi

for lock in lock .parentlock parent.lock SingletonLock SingletonSocket SingletonCookie; do
  if [[ -e "$TARGET/$lock" || -L "$TARGET/$lock" ]]; then
    echo "profile-apply: refusing a live or stale target profile lock: $TARGET/$lock" >&2
    exit 1
  fi
done

if [[ -e "$TARGET" && ! -L "$TARGET" ]]; then
  backup="${TARGET}.before-cortex.$(date +%Y%m%d-%H%M%S)"
  mv "$TARGET" "$backup"
  echo "profile-apply: existing guest profile moved to $backup"
fi
ln -sfnT "$PROFILE" "$TARGET"
echo "profile-apply: $TARGET -> $PROFILE"
# Private migration bridges:2 ends here
