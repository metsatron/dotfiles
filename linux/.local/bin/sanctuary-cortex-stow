#!/usr/bin/env bash
# [[file:../../../sanctuary-cortex.org::*Private migration bridges][Private migration bridges:5]]
set -euo pipefail

ROOT="${DOTCORTEX_ROOT:-$HOME/DotCortex}"
GUEST_HOME="${SANCTUARY_CORTEX_GUEST_HOME:-}"
OPERATOR_HOME="$HOME"
PRIVATE_ROOT="${SANCTUARY_CORTEX_PRIVATE_ROOT:-$OPERATOR_HOME/HelmCortex/NEXUS/sanctuaries/sanctuary-cortex}"

if [[ -n "$GUEST_HOME" ]]; then
  [[ -d "$GUEST_HOME" ]] || { echo "sanctuary-cortex-stow: guest home not found: $GUEST_HOME" >&2; exit 1; }
  export HOME="$GUEST_HOME"
  export XDG_CONFIG_HOME="$HOME/.config"
  export XDG_DATA_HOME="$HOME/.local/share"
  export XDG_STATE_HOME="$HOME/.local/state"
fi

LOOM="${DOTCORTEX_LOOM:-$ROOT/all/.local/bin/loom}"

[[ -x "$LOOM" ]] || { echo "sanctuary-cortex-stow: loom not found: $LOOM" >&2; exit 127; }
[[ -d "$ROOT" ]] || { echo "sanctuary-cortex-stow: DotCortex root not found: $ROOT" >&2; exit 1; }

cd "$ROOT"
export DOTCORTEX_STOW_CONTEXT=sanctuary-cortex
export PATH="/run/host/usr/bin:/run/host/usr/sbin:$PATH"
MAAK_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/maak/maak.scm"
if [[ ! -r "$MAAK_CONF" ]]; then
  echo "sanctuary-cortex-stow: bootstrapping maak with safe-stow"
  STOW_PKGS='all linux debian x230' make -C "$ROOT" safe-stow
fi
bash "$LOOM" stow:x230

# Stow intentionally ignores icon/theme roots: they contain submodules and
# need real home directories with repo-backed entries rather than one root
# symlink. Materialize them as part of the Cortex stow contract.
ICON_SYNC="$ROOT/all/.local/bin/icons-home-sync"
[[ -x "$ICON_SYNC" ]] || { echo "sanctuary-cortex-stow: icons-home-sync not found: $ICON_SYNC" >&2; exit 1; }
python3 "$ICON_SYNC" --repo-root "$ROOT" --home-root "$HOME"

# The container's DotCortex mount carries the repository shape but may expose
# empty submodule worktrees for large theme payloads. Project the two active
# X230 themes into the guest home as real, repo-derived directories so GTK and
# XFWM can load them inside the sanctuary.
THEME_STATE="$PRIVATE_ROOT/xfce4-state/.config/xfce4/xfconf/xfce-perchannel-xml"
GTK_THEME="$(sed -n 's/.*name="ThemeName".*value="\([^"]*\)".*/\1/p' "$THEME_STATE/xsettings.xml" 2>/dev/null | head -1)"
XFWM_THEME="$(sed -n 's/.*name="theme".*value="\([^"]*\)".*/\1/p' "$THEME_STATE/xfwm4.xml" 2>/dev/null | head -1)"
THEME_STAMP="$(date +%Y%m%d-%H%M%S)"
THEME_ROOT="$HOME/.themes"
if [[ -L "$THEME_ROOT" ]]; then
  mv "$THEME_ROOT" "${THEME_ROOT}.before-cortex.${THEME_STAMP}"
elif [[ -e "$THEME_ROOT" && ! -d "$THEME_ROOT" ]]; then
  mv "$THEME_ROOT" "${THEME_ROOT}.before-cortex.${THEME_STAMP}"
fi
mkdir -p "$THEME_ROOT"
for theme in "$GTK_THEME" "$XFWM_THEME"; do
  [[ -n "$theme" ]] || continue
  source_theme="$ROOT/linux/.themes/$theme"
  [[ -d "$source_theme" ]] || {
    echo "sanctuary-cortex-stow: active X230 theme is missing: $source_theme" >&2
    exit 1
  }
  if [[ "$theme" == "$GTK_THEME" ]]; then
    [[ -f "$source_theme/gtk-3.0/gtk.css" ]] || {
      echo "sanctuary-cortex-stow: GTK theme payload is empty: $source_theme" >&2
      echo "Initialize the pinned theme submodule before stowing Cortex." >&2
      exit 1
    }
  fi
  if [[ "$theme" == "$XFWM_THEME" ]]; then
    [[ -f "$source_theme/xfwm4/themerc" ]] || {
      echo "sanctuary-cortex-stow: XFWM theme payload is empty: $source_theme" >&2
      echo "Initialize the pinned theme submodule before stowing Cortex." >&2
      exit 1
    }
  fi
  target_theme="$THEME_ROOT/$theme"
  if [[ -L "$target_theme" ]]; then
    mv "$target_theme" "${target_theme}.before-cortex.${THEME_STAMP}"
  elif [[ -e "$target_theme" && ! -d "$target_theme" ]]; then
    mv "$target_theme" "${target_theme}.before-cortex.${THEME_STAMP}"
  fi
  mkdir -p "$target_theme"
  rsync -a --delete "$source_theme/" "$target_theme/"
  echo "sanctuary-cortex-stow: projected theme $theme"
done

# Fonts are deliberately private HelmCortex artifacts. Keep the guest root
# real, then expose both the public NerdFonts payload and the private X230 font
# families beneath it. A root symlink to DotCortex would hide the HelmCortex
# families and made San Francisco Display silently fall back to DejaVu Sans.
FONT_ROOT="$HOME/.local/share/fonts"
PRIVATE_FONT_ROOT="$OPERATOR_HOME/HelmCortex/NEXUS/stow/linux/.local/share/fonts"
[[ -d "$PRIVATE_FONT_ROOT" ]] || {
  echo "sanctuary-cortex-stow: private font root missing: $PRIVATE_FONT_ROOT" >&2
  exit 1
}
if [[ -L "$FONT_ROOT" ]]; then
  mv "$FONT_ROOT" "${FONT_ROOT}.before-cortex.${THEME_STAMP}"
elif [[ -e "$FONT_ROOT" && ! -d "$FONT_ROOT" ]]; then
  mv "$FONT_ROOT" "${FONT_ROOT}.before-cortex.${THEME_STAMP}"
fi
mkdir -p "$FONT_ROOT"
ln -sfnT "$ROOT/all/.local/share/fonts" "$FONT_ROOT/DotCortex"
ln -sfnT "$PRIVATE_FONT_ROOT" "$FONT_ROOT/HelmCortex"
if command -v fc-cache >/dev/null 2>&1; then
  fc-cache -f "$FONT_ROOT" >/dev/null 2>&1 || true
fi

# The XFCE tree and panel XML are private mutable state, but they are part of
# the Cortex migration contract. Apply the captured X230 state on every Cortex
# stow so a fresh guest cannot silently retain the first-run panel layout.
CONFIG_APPLY="$ROOT/linux/.local/bin/sanctuary-cortex-config-apply"
[[ -x "$CONFIG_APPLY" ]] || { echo "sanctuary-cortex-stow: config helper not found: $CONFIG_APPLY" >&2; exit 1; }
if [[ -n "$GUEST_HOME" ]]; then
  SANCTUARY_CORTEX_PRIVATE_ROOT="$PRIVATE_ROOT" \
    SANCTUARY_CORTEX_GUEST_HOME="$HOME" \
    bash "$CONFIG_APPLY"
fi

# The public all overlay contains the launcher shim, but the browser profile is
# private mutable state. Stow may back up that link while resolving the public
# overlay conflict, so restore the HelmCortex-owned link after the public layer
# has been applied. The profile helper refuses live profile locks.
PROFILE_APPLY="$ROOT/linux/.local/bin/sanctuary-cortex-profile-apply"
if [[ -n "$GUEST_HOME" && -x "$PROFILE_APPLY" ]]; then
  SANCTUARY_CORTEX_PRIVATE_ROOT="$PRIVATE_ROOT" \
    SANCTUARY_CORTEX_GUEST_HOME="$HOME" \
    bash "$PROFILE_APPLY"
fi
# Private migration bridges:5 ends here
