#!/usr/bin/env bash
# Future Habitat Content

# Once the visual grammar is stable, sanctuary-sx is intended to host machine-islands for:

# - X68000 (Sharp MZ/X68k emulation)
# - PC-98 (Neko Project II / np21w)
# - FM Towns (Tsugaru)
# - DOSBox-X (MS-DOS / Windows 3.x / 9x)
# - Wine (Windows compatibility)
# - ScummVM (adventure game engine)
# - Native Linux applications in the SX visual frame

# These are future content, not a requirement for the initial declaration.


# [[file:../../../distrobox.org::*Future Habitat Content][Future Habitat Content:1]]
# Launch sanctuary-sx: Xephyr :94 + XFCE inside the Guix container.
# Switch to an empty host desktop before launching (Xephyr fills the display).
# Prerequisites:
#   loom guix:sanctuary-apply   ← builds desktop-common + sanctuary-sx
#   distrobox-sanctuaries-create
#   vm-homes-init
set -euo pipefail

DISPLAY_NUM=":94"
SANCTUARY="sanctuary-sx"
GUESTS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/dotcortex/guests"
GUEST_HOME="${GUESTS_DIR}/${SANCTUARY}/home"
GUIX_PROFILES="${HOME}/.guix-extra-profiles"
DOTCORTEX_SX="${HOME}/DotCortex/linux/.config/sanctuary-sx"

# Preflight: verify required Guix profiles exist.
for _prof in desktop-common sanctuary-sx; do
  _path="${GUIX_PROFILES}/${_prof}/${_prof}/etc/profile"
  if [[ ! -f "${_path}" ]]; then
    echo "${SANCTUARY}: ERROR — Guix profile not built: ${_prof}"
    echo "  Build it with: make guix-${_prof}"
    exit 1
  fi
done

# Project DotCortex-managed XFCE config into guest home (only after capture pass exists).
# On first launch these directories are absent; XFCE starts from its own defaults.
if [[ -d "${DOTCORTEX_SX}/xfconf" ]]; then
  mkdir -p "${GUEST_HOME}/.config/xfce4/xfconf"
  ln -sfnT "${DOTCORTEX_SX}/xfconf" "${GUEST_HOME}/.config/xfce4/xfconf/xfce-perchannel-xml"
fi
if [[ -d "${DOTCORTEX_SX}/panel" ]]; then
  mkdir -p "${GUEST_HOME}/.config/xfce4"
  ln -sfnT "${DOTCORTEX_SX}/panel" "${GUEST_HOME}/.config/xfce4/panel"
fi
if [[ -d "${DOTCORTEX_SX}/themes" ]]; then
  mkdir -p "${GUEST_HOME}/.themes"
  for _theme_dir in "${DOTCORTEX_SX}/themes/"*/; do
    [[ -d "${_theme_dir}" ]] || continue
    ln -sfnT "${_theme_dir}" "${GUEST_HOME}/.themes/$(basename "${_theme_dir}")"
  done
fi
if [[ -d "${DOTCORTEX_SX}/icons" ]]; then
  mkdir -p "${GUEST_HOME}/.icons"
  for _icon_dir in "${DOTCORTEX_SX}/icons/"*/; do
    [[ -d "${_icon_dir}" ]] || continue
    ln -sfnT "${_icon_dir}" "${GUEST_HOME}/.icons/$(basename "${_icon_dir}")"
  done
fi
if [[ -d "${DOTCORTEX_SX}/applications" ]]; then
  mkdir -p "${GUEST_HOME}/.local/share/applications"
  for _desktop in "${DOTCORTEX_SX}/applications/"*.desktop; do
    [[ -f "${_desktop}" ]] || continue
    ln -sfnT "${_desktop}" "${GUEST_HOME}/.local/share/applications/$(basename "${_desktop}")"
  done
fi

Xephyr "${DISPLAY_NUM}" -fullscreen -br -ac &
XEPHYR_PID=$!
trap "kill ${XEPHYR_PID} 2>/dev/null || true" EXIT

timeout 10 sh -c "until DISPLAY=${DISPLAY_NUM} xdpyinfo >/dev/null 2>&1; do sleep 0.1; done" \
  || { echo "Xephyr ${DISPLAY_NUM} did not become ready"; kill "${XEPHYR_PID}"; exit 1; }

echo "${SANCTUARY}: Xephyr ${DISPLAY_NUM} ready — sourcing Guix profiles and starting XFCE…"
DISPLAY="${DISPLAY_NUM}" sanctuary-exec "${SANCTUARY}" sh -c "
  GUIX_PROFILE=${GUIX_PROFILES}/desktop-common/desktop-common
  . \${GUIX_PROFILE}/etc/profile
  GUIX_PROFILE=${GUIX_PROFILES}/sanctuary-sx/sanctuary-sx
  . \${GUIX_PROFILE}/etc/profile
  exec dbus-run-session xfce4-session
"

kill "${XEPHYR_PID}" 2>/dev/null || true
# Future Habitat Content:1 ends here
