#!/usr/bin/env bash
# [[file:../../../sanctuary-sx.org::*Declared font projection][Declared font projection:2]]
# Launch sanctuary-sx: Xephyr :94 + XFCE inside the Guix container.
# Switch to an empty host desktop before launching (Xephyr fills the display).
# Prerequisites:
#   loom guix:sanctuary-apply   ← builds desktop-common + sanctuary-sx
#   distrobox-sanctuaries-create
#   vm-homes-init
set -euo pipefail

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  cat <<EOF
sanctuary-sx-launch - launch sanctuary-sx (Xephyr :94 + XFCE, Godzilla XS-86000)

Usage: sanctuary-sx-launch

No arguments. Switch to an empty host desktop before launching (Xephyr fills the display).

Prerequisites:
  loom guix:sanctuary-apply   (desktop-common + sanctuary-sx)
  distrobox-sanctuaries-create
  vm-homes-init

Normally invoked via: sanctuary-enter sanctuary-sx
EOF
  exit 0
fi

DISPLAY_NUM=":94"
HOST_DISPLAY="${DISPLAY}"
SANCTUARY="sanctuary-sx"
GUESTS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/dotcortex/guests"
GUEST_HOME="${GUESTS_DIR}/${SANCTUARY}/home"
GUIX_PROFILES="${HOME}/.guix-extra-profiles"
DOTCORTEX_SX="${HOME}/DotCortex/linux/.config/sanctuary-sx"

# Preflight: verify required Guix profiles exist.
for _prof in desktop-common sanctuary-sx; do
  _path="${GUIX_PROFILES}/${_prof}/${_prof}/etc/profile"
  if [[ ! -f "${_path}" ]]; then
    echo "${SANCTUARY}: ERROR — Guix profile not built: ${_prof}"
    echo "  Build it with: make guix-${_prof}"
    exit 1
  fi
done

# Enforce the exact, checksummed font payload in the persistent guest home.
FONTS_APPLY="${HOME}/DotCortex/linux/.local/bin/sanctuary-sx-fonts-apply"
if [[ ! -x "${FONTS_APPLY}" ]]; then
  echo "${SANCTUARY}: ERROR — declarative font helper missing: ${FONTS_APPLY}" >&2
  echo "  Tangle sanctuary-sx.org before launching." >&2
  exit 1
fi
"${FONTS_APPLY}"

# Stable XFCE state is applied after any stale session has been stopped.  The
# guest files remain writable during use; they are never symlinked to tangled
# output, so manual changes can be reviewed and promoted through capture.
CONFIG_APPLY="${HOME}/DotCortex/linux/.local/bin/sanctuary-sx-config-apply"
if [[ ! -x "${CONFIG_APPLY}" ]]; then
  echo "${SANCTUARY}: ERROR — declarative config helper missing: ${CONFIG_APPLY}" >&2
  echo "  Tangle sanctuary-sx.org before launching." >&2
  exit 1
fi
COLEMAK_APPLY="${HOME}/DotCortex/linux/.local/bin/sanctuary-sx-colemak-apply"
if [[ ! -x "${COLEMAK_APPLY}" ]]; then
  echo "${SANCTUARY}: ERROR — Colemak helper missing: ${COLEMAK_APPLY}" >&2
  echo "  Tangle sanctuary-sx.org before launching." >&2
  exit 1
fi
mkdir -p "${GUEST_HOME}/.local/bin"
ln -sfnT "${COLEMAK_APPLY}" "${GUEST_HOME}/.local/bin/sanctuary-sx-colemak-apply"
if [[ -d "${DOTCORTEX_SX}/themes" ]]; then
  mkdir -p "${GUEST_HOME}/.themes"
  for _theme_dir in "${DOTCORTEX_SX}/themes/"*/; do
    [[ -d "${_theme_dir}" ]] || continue
    ln -sfnT "${_theme_dir}" "${GUEST_HOME}/.themes/$(basename "${_theme_dir}")"
  done
fi
if [[ -d "${DOTCORTEX_SX}/icons" ]]; then
  mkdir -p "${GUEST_HOME}/.icons"
  for _icon_dir in "${DOTCORTEX_SX}/icons/"*/; do
    [[ -d "${_icon_dir}" ]] || continue
    ln -sfnT "${_icon_dir}" "${GUEST_HOME}/.icons/$(basename "${_icon_dir}")"
  done
fi
if [[ -d "${DOTCORTEX_SX}/autostart" ]]; then
  mkdir -p "${GUEST_HOME}/.config/autostart"
  for _desktop in "${DOTCORTEX_SX}/autostart/"*.desktop; do
    [[ -f "${_desktop}" ]] || continue
    ln -sfnT "${_desktop}" "${GUEST_HOME}/.config/autostart/$(basename "${_desktop}")"
  done
fi
if [[ -d "${DOTCORTEX_SX}/applications" ]]; then
  mkdir -p "${GUEST_HOME}/.local/share/applications"
  for _desktop in "${DOTCORTEX_SX}/applications/"*.desktop; do
    [[ -f "${_desktop}" ]] || continue
    ln -sfnT "${_desktop}" "${GUEST_HOME}/.local/share/applications/$(basename "${_desktop}")"
  done
fi
if [[ -d "${DOTCORTEX_SX}/desktop-directories" ]]; then
  mkdir -p "${GUEST_HOME}/.local/share/desktop-directories"
  for _directory in "${DOTCORTEX_SX}/desktop-directories/"*.directory; do
    [[ -f "${_directory}" ]] || continue
    ln -sfnT "${_directory}" "${GUEST_HOME}/.local/share/desktop-directories/$(basename "${_directory}")"
  done
fi
if [[ -d "${DOTCORTEX_SX}/menus" ]]; then
  mkdir -p "${GUEST_HOME}/.config/menus"
  for _menu in "${DOTCORTEX_SX}/menus/"*.menu; do
    [[ -f "${_menu}" ]] || continue
    ln -sfnT "${_menu}" "${GUEST_HOME}/.config/menus/$(basename "${_menu}")"
  done
fi
if [[ -d "${DOTCORTEX_SX}/godzilla-xs" ]]; then
  mkdir -p "${GUEST_HOME}/.config/sanctuary-sx"
  ln -sfnT "${DOTCORTEX_SX}/godzilla-xs" "${GUEST_HOME}/.config/sanctuary-sx/godzilla-xs"
fi

# Sanctuary-local Godzilla state roots and narrow Wine prefixes.
if command -v godzilla-xs-init >/dev/null 2>&1; then
  HOME="${GUEST_HOME}" \
  XDG_DATA_HOME="${GUEST_HOME}/.local/share" \
  XDG_CONFIG_HOME="${GUEST_HOME}/.config" \
  godzilla-xs-init
fi

# Expose host theme and icon collections to the guest.
# ~/.themes and ~/.icons (legacy cursor path) — skip if DotCortex capture dir exists.
[[ -d "${HOME}/.themes" ]] && [[ ! -e "${GUEST_HOME}/.themes" ]] && ln -sfnT "${HOME}/.themes" "${GUEST_HOME}/.themes"
[[ -d "${HOME}/.icons"  ]] && [[ ! -e "${GUEST_HOME}/.icons"  ]] && ln -sfnT "${HOME}/.icons"  "${GUEST_HOME}/.icons"
# ~/.local/share/icons (XDG standard path — where Irixium, irix-icons-linux, BeOS-r5-Icons, etc. live).
if [[ -d "${HOME}/.local/share/icons" ]] && [[ ! -e "${GUEST_HOME}/.local/share/icons" ]]; then
  mkdir -p "${GUEST_HOME}/.local/share"
  ln -sfnT "${HOME}/.local/share/icons" "${GUEST_HOME}/.local/share/icons"
fi

# Project GTK3 settings (overlay scrollbar off, font, icon theme baseline).
if [[ -f "${DOTCORTEX_SX}/gtk-3.0/settings.ini" ]]; then
  mkdir -p "${GUEST_HOME}/.config/gtk-3.0"
  ln -sfnT "${DOTCORTEX_SX}/gtk-3.0/settings.ini" "${GUEST_HOME}/.config/gtk-3.0/settings.ini"
fi

# GTK4 CSD-disable (same decoration-layout trick).
if [[ -f "${DOTCORTEX_SX}/gtk-4.0/settings.ini" ]]; then
  mkdir -p "${GUEST_HOME}/.config/gtk-4.0"
  ln -sfnT "${DOTCORTEX_SX}/gtk-4.0/settings.ini" "${GUEST_HOME}/.config/gtk-4.0/settings.ini"
fi

# Project fastfetch config (Human68k SYSINFO theme) for sanctuary terminal greeting.
# The Command module runs sanctuary-sx-fastfetch-grid live inside the container,
# gathering /proc, hostname, xfconf, gsettings at display time.
if [[ -f "${DOTCORTEX_SX}/fastfetch.jsonc" ]]; then
  mkdir -p "${GUEST_HOME}/.config/fastfetch"
  ln -sfnT "${DOTCORTEX_SX}/fastfetch.jsonc" "${GUEST_HOME}/.config/fastfetch/config.jsonc"
fi
# Project the SYSINFO grid helper into the guest so fastfetch can find it.
if [[ -f "${HOME}/DotCortex/linux/.local/bin/sanctuary-sx-fastfetch-grid" ]]; then
  mkdir -p "${GUEST_HOME}/.local/bin"
  ln -sfnT "${HOME}/DotCortex/linux/.local/bin/sanctuary-sx-fastfetch-grid" "${GUEST_HOME}/.local/bin/sanctuary-sx-fastfetch-grid"
fi
# ── Godzilla XS shell identity: Human68k A:\ prompt (shared sanctuary grammar) ──
# Symlink the DotCortex shell rc live into the guest home (edits reflect without a
# relaunch). The zsh link supersedes the old newuser stub; the sanctuary zshrc sources
# the global one itself, so nothing global is edited.
if [[ -d "${DOTCORTEX_SX}/shell" ]]; then
  ln -sfnT "${DOTCORTEX_SX}/shell/bashrc"       "${GUEST_HOME}/.bashrc"
  ln -sfnT "${DOTCORTEX_SX}/shell/bash_profile" "${GUEST_HOME}/.bash_profile"
  ln -sfnT "${DOTCORTEX_SX}/shell/zshrc"        "${GUEST_HOME}/.zshrc"
fi
if [[ -f "${HOME}/DotCortex/linux/.local/bin/sanctuary-sx-colemak-apply" ]]; then
  mkdir -p "${GUEST_HOME}/.local/bin"
  ln -sfnT "${HOME}/DotCortex/linux/.local/bin/sanctuary-sx-colemak-apply" "${GUEST_HOME}/.local/bin/sanctuary-sx-colemak-apply"
fi
if [[ -f "${HOME}/DotCortex/linux/.local/bin/firefox" ]]; then
  mkdir -p "${GUEST_HOME}/.local/bin"
  ln -sfnT "${HOME}/DotCortex/linux/.local/bin/firefox" "${GUEST_HOME}/.local/bin/firefox"
fi
# Ensure guest ~/.local/bin is in the container session PATH.
export PATH="${GUEST_HOME}/.local/bin:${PATH}"

# Lutris-created desktop shortcuts call `flatpak run` directly.  Inside a
# sanctuary they must go through the wrapper so they inherit the sanctuary
# home, shared Games/RetroPie paths, and Lutris config links.
if [[ -d "${GUEST_HOME}/.local/share/applications" ]]; then
  for _desktop in "${GUEST_HOME}/.local/share/applications"/net.lutris.*.desktop; do
    [[ -f "${_desktop}" ]] || continue
    sed -i \
      's#^Exec=env LUTRIS_SKIP_INIT=1 flatpak run net\.lutris\.Lutris \(lutris:rungameid/.*\)$#Exec=env LUTRIS_SKIP_INIT=1 /home/metsatron/.local/share/dotcortex/guests/sanctuary-sx/home/.local/bin/sanctuary-flatpak-run net.lutris.Lutris -- \1#' \
      "${_desktop}"
  done
fi

# Project managed Audacious Winamp skins into the guest.
# Use a merge so Audacious can extract/use skin directories without DotCortex
# replacing guest-local runtime state.
if [[ -d "${HOME}/DotCortex/linux/.local/share/audacious/Skins" ]]; then
  mkdir -p "${GUEST_HOME}/.local/share/audacious/Skins"
  cp -rn "${HOME}/DotCortex/linux/.local/share/audacious/Skins/"*.wsz "${GUEST_HOME}/.local/share/audacious/Skins/" 2>/dev/null || true
fi
if [[ -d "${HOME}/DotCortex/linux/.qmmp/skins" ]]; then
  mkdir -p "${GUEST_HOME}/.local/share/audacious/Skins"
  for skin in "${HOME}/DotCortex/linux/.qmmp/skins/"*.wsz; do
    [[ -f "${skin}" ]] || continue
    ln -sfnT "${skin}" "${GUEST_HOME}/.local/share/audacious/Skins/$(basename "${skin}")"
  done
fi
mkdir -p "${GUEST_HOME}/.config/audacious"
if [[ -f "${DOTCORTEX_SX}/audacious/config" ]] && [[ ! -e "${GUEST_HOME}/.config/audacious/config" ]]; then
  cp -f "${DOTCORTEX_SX}/audacious/config" "${GUEST_HOME}/.config/audacious/config"
fi

# ── Tear down any surviving prior session before launching fresh ──
sanctuary-teardown-stale-session "${SANCTUARY}" "${DISPLAY_NUM}"

# Never overwrite uncaptured desktop changes.  A fresh guest home is populated
# automatically; an existing divergent home is preserved and still launches so
# it can be promoted later or explicitly restored with --force.
"${CONFIG_APPLY}"

Xephyr "${DISPLAY_NUM}" -fullscreen -br -ac -no-host-grab &
XEPHYR_PID=$!
trap "kill ${XEPHYR_PID} 2>/dev/null || true" EXIT

timeout 10 sh -c "until DISPLAY=${DISPLAY_NUM} xdpyinfo >/dev/null 2>&1; do sleep 0.1; done" \
  || { echo "Xephyr ${DISPLAY_NUM} did not become ready"; kill "${XEPHYR_PID}"; exit 1; }

_sx_apply_colemak() {
  DISPLAY="${DISPLAY_NUM}" /usr/bin/setxkbmap -layout us -variant colemak -option terminate:ctrl_alt_bksp
}

_sx_apply_colemak
(
  while kill -0 "${XEPHYR_PID}" 2>/dev/null; do
    _sx_current="$(DISPLAY="${DISPLAY_NUM}" /usr/bin/setxkbmap -query 2>/dev/null || true)"
    if ! grep -qx 'variant:[[:space:]]*colemak' <<<"${_sx_current}"; then
      _sx_apply_colemak 2>/dev/null || true
    fi
    sleep 2
  done
) &
KEYMAP_GUARD_PID=$!

sanctuary-clip-bridge "${HOST_DISPLAY}" "${DISPLAY_NUM}" &
CLIP_BRIDGE_PID=$!
trap "kill ${XEPHYR_PID} ${CLIP_BRIDGE_PID} ${KEYMAP_GUARD_PID} 2>/dev/null || true" EXIT

# ── Shield trash:/// from host fleet NFS mounts (see sanctuary-trash-shield) ──
sanctuary-trash-shield "${SANCTUARY}" "${HOME}"

# GUI sessions do not consume a terminal.  Asking crun for one fails when the
# sanctuary's host /dev projection leaves /dev/ptmx unsuitable for ptsname(3),
# so enter explicitly without a TTY while retaining sanctuary-exec's strict
# environment allowlist (in particular, never inherit host credentials).
DISTROBOX_BIN="$(command -v distrobox 2>/dev/null)" \
  || DISTROBOX_BIN="${HOME}/.guix-extra-profiles/core/core/bin/distrobox"
[[ -x "${DISTROBOX_BIN}" ]] \
  || { echo "${SANCTUARY}: ERROR — distrobox not found" >&2; exit 127; }

sx_enter_env=(
  "HOME=${HOME}"
  "USER=${USER:-$(id -un)}"
  "LOGNAME=${LOGNAME:-${USER:-$(id -un)}}"
  "PATH=${PATH}"
  "PWD=${PWD}"
  "SHELL=${SHELL:-/bin/sh}"
  "DISPLAY=${DISPLAY_NUM}"
)
sx_optional_env=(
  TERM COLORTERM
  LANG LANGUAGE LC_ALL LC_CTYPE LC_COLLATE LC_MESSAGES LC_MONETARY LC_NUMERIC LC_TIME
  XAUTHORITY XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS PULSE_SERVER PIPEWIRE_REMOTE
)
for variable in "${sx_optional_env[@]}"; do
  [[ -v "${variable}" ]] && sx_enter_env+=("${variable}=${!variable}")
done

echo "${SANCTUARY}: Xephyr ${DISPLAY_NUM} ready — sourcing Guix profiles and starting XFCE…"
env -i "${sx_enter_env[@]}" "${DISTROBOX_BIN}" enter --no-tty "${SANCTUARY}" -- sh -c "
  GUIX_PROFILE=${GUIX_PROFILES}/desktop-common/desktop-common
  . \${GUIX_PROFILE}/etc/profile
  GUIX_PROFILE=${GUIX_PROFILES}/sanctuary-sx/sanctuary-sx
  . \${GUIX_PROFILE}/etc/profile
  export PATH="${GUEST_HOME}/.local/bin:${GUIX_PROFILES}/sanctuary-sx/sanctuary-sx/bin:${GUIX_PROFILES}/desktop-common/desktop-common/bin:/usr/local/bin:/usr/bin:/bin"
  export XDG_DATA_DIRS=${GUIX_PROFILES}/sanctuary-sx/sanctuary-sx/share:${GUIX_PROFILES}/desktop-common/desktop-common/share:/usr/local/share:/usr/share
  export XDG_CONFIG_DIRS=${GUIX_PROFILES}/sanctuary-sx/sanctuary-sx/etc/xdg:${GUIX_PROFILES}/desktop-common/desktop-common/etc/xdg:/etc/xdg
  export GTK_CSD=0
  export GTK_OVERLAY_SCROLLING=0
  export LIBOVERLAY_SCROLLBAR=0
  # The SX room does not use portal file pickers, and fcitx5/tumbler can
  # otherwise drag xdg-desktop-portal + document portal activation into the
  # session, producing long startup stalls and FUSE timeout noise.
  export GTK_USE_PORTAL=0
  export GIO_USE_PORTAL=0
  # gvfs tries to spawn gvfsd-fuse via fusermount3 inside the sanctuary. That
  # binary is not present in the room contract, and the failed FUSE mount path
  # is just noise/risk here: SX needs gvfs' D-Bus backends for thunar trash:///
  # and volume metadata, not the ~/.gvfs FUSE mirror.
  export GVFS_DISABLE_FUSE=1
  # Suppress the at-spi2 accessibility bridge: each GTK app launched inside
  # dbus-run-session otherwise spawns its own at-spi2 bus daemon (1 inotify
  # instance each, never reaped) and can saturate max_user_instances=128.
  # sanctuary-sx does not need accessibility services for the default room.
  export NO_AT_BRIDGE=1
  exec dbus-run-session sh -c 'gamemoded -d >/dev/null 2>&1 || true; exec startxfce4'
"

kill "${XEPHYR_PID}" 2>/dev/null || true
# Declared font projection:2 ends here
