# [[file:../../../distrobox.org::*Sanctuary Launcher Scripts][Sanctuary Launcher Scripts:19]]
#!/usr/bin/env bash
# Sanctuary Firefox launcher with Diet Netscape profile chrome.
set -euo pipefail

THEME_ROOT="${FIREFOX_DIET_NETSCAPE_ROOT:-${HOME}/DotCortex/linux/.local/share/sanctuaries/firefox-chrome/Diet-Netscape-Theme}"
OVERLAY_ROOT="${FIREFOX_DIET_NETSCAPE_OVERLAY:-${HOME}/DotCortex/linux/.local/share/sanctuaries/firefox-chrome/diet-netscape-dotcortex}"
PROFILE="${FIREFOX_PROFILE:-}"
if [[ -z "${PROFILE}" ]]; then
  firefox_root="${HOME}/.mozilla/firefox"
  profiles_ini="${firefox_root}/profiles.ini"
  if [[ -f "${profiles_ini}" ]]; then
    default_path="$(
      awk '
        /^\[Profile/ { in_profile=1; path=""; default_profile=0; next }
        /^\[/ { if (in_profile && default_profile && path != "") { print path; exit }; in_profile=0 }
        in_profile && /^Path=/ { path=substr($0, 6) }
        in_profile && /^Default=1/ { default_profile=1 }
        END { if (in_profile && default_profile && path != "") print path }
      ' "${profiles_ini}" | head -1
    )"
    if [[ -n "${default_path}" ]]; then
      if grep -q "Path=${default_path}" "${profiles_ini}" && grep -q "IsRelative=1" "${profiles_ini}"; then
        PROFILE="${firefox_root}/${default_path}"
      else
        PROFILE="${default_path}"
      fi
    fi
  fi
  PROFILE="${PROFILE:-${firefox_root}/diet-netscape}"
fi
CHROME_DIR="${PROFILE}/chrome"

find_real_firefox() {
  local candidate real_self
  real_self="$(readlink -f "$0" 2>/dev/null || printf '%s\n' "$0")"

  for candidate in \
    "${HOME}/.guix-extra-profiles/sanctuary-cde/sanctuary-cde/bin/firefox" \
    "${HOME}/.guix-extra-profiles/sanctuary-sx/sanctuary-sx/bin/firefox" \
    "${HOME}/.guix-extra-profiles/room-gaming/room-gaming/bin/firefox" \
    "${HOME}/.guix-extra-profiles/desktop-common/desktop-common/bin/firefox" \
    /gnu/store/*-profile/bin/firefox \
    /gnu/store/*firefox*/bin/firefox
  do
    [[ -x "${candidate}" ]] || continue
    [[ "$(readlink -f "${candidate}" 2>/dev/null || true)" == "${real_self}" ]] && continue
    printf '%s\n' "${candidate}"
    return 0
  done
  return 1
}

preserve_or_link() {
  local source="$1"
  local target="$2"
  local preserved

  if [[ -e "${target}" && ! -L "${target}" ]]; then
    preserved="${target}.before-diet-netscape"
    if [[ ! -e "${preserved}" ]]; then
      mv "${target}" "${preserved}"
    else
      echo "firefox: preserving existing profile chrome path: ${target}" >&2
      return 0
    fi
  fi
  ln -sfnT "${source}" "${target}"
}

if [[ ! -d "${THEME_ROOT}/chrome" ]]; then
  echo "firefox: Diet Netscape Theme not found at ${THEME_ROOT}" >&2
  echo "firefox: expected chrome/userChrome.css under that directory" >&2
  exit 1
fi

for required in userChrome.css tabs_below_content.css non_floating_sharp_tabs.css image; do
  if [[ ! -e "${THEME_ROOT}/chrome/${required}" ]]; then
    echo "firefox: Diet Netscape Theme is missing chrome/${required}" >&2
    exit 1
  fi
done

FIREFOX_BIN="$(find_real_firefox)" \
  || { echo "firefox: no real Guix Firefox binary found; refusing to launch host browser" >&2; exit 127; }

mkdir -p "${CHROME_DIR}"
if [[ -f "${OVERLAY_ROOT}/userChrome.css" ]]; then
  preserve_or_link "${OVERLAY_ROOT}/userChrome.css" "${CHROME_DIR}/userChrome.css"
else
  preserve_or_link "${THEME_ROOT}/chrome/userChrome.css" "${CHROME_DIR}/userChrome.css"
fi
preserve_or_link "${THEME_ROOT}/chrome/tabs_below_content.css" "${CHROME_DIR}/tabs_below_content.css"
preserve_or_link "${THEME_ROOT}/chrome/non_floating_sharp_tabs.css" "${CHROME_DIR}/non_floating_sharp_tabs.css"
preserve_or_link "${THEME_ROOT}/chrome/image" "${CHROME_DIR}/image"

USER_JS="${PROFILE}/user.js"
if [[ ! -f "${USER_JS}" ]] || ! grep -q 'toolkit\.legacyUserProfileCustomizations\.stylesheets' "${USER_JS}"; then
  {
    echo ''
    echo '// Diet Netscape Theme chrome'
    echo 'user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);'
  } >> "${USER_JS}"
fi

exec "${FIREFOX_BIN}" --profile "${PROFILE}" "$@"
# Sanctuary Launcher Scripts:19 ends here
