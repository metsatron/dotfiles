#!/bin/bash
# Command Prompt and PowerShell Run-box shims

# Small launchers so typing =cmd= or =powershell= / =pwsh= in the Run box (the
# rofi Run box or the ice2k =runbox=) opens the same styled terminals as the
# Terminals menu.  The sanctuary launcher symlinks =cmd=, =powershell= and =pwsh=
# to these on the guest =PATH=.


# [[file:../../../sanctuary-redstone-9x-desktop.org::*Command Prompt and PowerShell Run-box shims][Command Prompt and PowerShell Run-box shims:1]]
set -euo pipefail
# `cmd` in the Run box -> the Win-styled Command Prompt (wine cmd.exe in a
# Lucida-Console urxvt), matching the Terminals menu "Command Prompt" entry.
exec redstone-9x-run urxvt -hold -name redstone-bash-cmd -title "Command Prompt" \
  -geometry 80x25 +sb -bg rgb:0c/0c/0c -fg rgb:cc/cc/cc -cr rgb:cc/cc/cc \
  -fn "xft:Lucida Console:pixelsize=14:antialias=true" -e bash -lc 'exec wine cmd.exe'
# Command Prompt and PowerShell Run-box shims:1 ends here
