#!/bin/bash
# redstone-9x-win98-build [tarball] [out-dir]
set -euo pipefail
TAR="${1:-${HOME}/HelmCortex/NEXUS/sanctuaries/sanctuary-redstone-9x/donors/Windows-95.tar.gz}"
OUT="${2:-${HOME}/DotCortex/linux/.icewm/themes/Windows-98}"
TMP="$(mktemp -d)"
trap 'rm -rf "${TMP}"' EXIT
tar xzf "${TAR}" -C "${TMP}"
SRC="$(find "${TMP}" -maxdepth 2 -name default.theme -printf '%h' -quit)"
[[ -n "${SRC}" ]] || { echo "no theme in ${TAR}" >&2; exit 1; }
rm -rf "${OUT}"
cp -a "${SRC}" "${OUT}"
sed -i 's|Windows 95|Windows 98|g' "${OUT}/default.theme"
cat >> "${OUT}/default.theme" <<'EOF98'

# ---- Windows 98 (official colours; meters in Task-Manager set) ----
ColorActiveTaskBarApp="rgb:EA/E8/E4"
ColorCPUStatusUser="rgb:00/A8/00"
ColorCPUStatusSystem="rgb:CC/00/00"
ColorCPUStatusIdle="rgb:00/00/00"
ColorMEMStatusUser="rgb:00/A8/00"
ColorMEMStatusBuffers="rgb:C4/A0/00"
ColorMEMStatusCached="rgb:80/00/80"
ColorMEMStatusFree="rgb:00/00/00"
ColorNetSend="rgb:CC/00/00"
ColorNetReceive="rgb:00/A8/00"
ColorNetIdle="rgb:00/00/00"
EOF98
redstone-9x-title-gradient "${OUT}" '#000080' '#1084D0' '#808080' '#B5B5B5'
echo "Windows-98 theme built at ${OUT}"
