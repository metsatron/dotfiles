#!/bin/env bash
# Verification helpers


# [[file:../../../sanctuary-cortex.org::*Verification helpers][Verification helpers:1]]
set -euo pipefail

ROOT="${DOTCORTEX_ROOT:-$HOME/DotCortex}"
PRIVATE_ROOT="${SANCTUARY_CORTEX_PRIVATE_ROOT:-$HOME/HelmCortex/NEXUS/sanctuaries/sanctuary-cortex}"
GUEST_HOME="${SANCTUARY_CORTEX_GUEST_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/dotcortex/guests/sanctuary-cortex/home}"
PROFILE="${SANCTUARY_CORTEX_PROFILE:-$HOME/.guix-extra-profiles/sanctuary-cortex/sanctuary-cortex}"

printf 'guest registry: '
grep -q '^sanctuary-cortex[[:space:]]' "$ROOT/linux/.config/virtualisation/guests.conf" && echo ok || echo missing
printf 'private root:   '
[[ -d "$PRIVATE_ROOT" ]] && echo ok || echo missing
printf 'private profile: '
[[ -f "$PRIVATE_ROOT/firefox-profile/prefs.js" && -f "$PRIVATE_ROOT/firefox-profile/places.sqlite" ]] && echo ok || echo missing
printf 'XFCE capture:   '
[[ -d "$PRIVATE_ROOT/xfce4-state/.config/xfce4" ]] && echo ok || echo missing
printf 'guest home:     '
[[ -d "$GUEST_HOME" ]] && echo ok || echo missing
if [[ -L "$GUEST_HOME/.config/sanctuary/cortex-firefox-profile" ]]; then
  printf 'guest profile:  %s\n' "$(readlink "$GUEST_HOME/.config/sanctuary/cortex-firefox-profile")"
else
  echo 'guest profile:  not linked'
fi
printf 'KDE Connect:    '
if [[ -x "$PROFILE/bin/kdeconnectd" && -x "$PROFILE/bin/kdeconnect-indicator" ]]; then
  echo ready
else
  echo missing
fi
printf 'KDE autostart:  '
if [[ -r "$GUEST_HOME/.config/autostart/kdeconnect-indicator.desktop" ]]; then
  echo ready
else
  echo missing
fi
printf 'capture lane:   '
if [[ -x "$GUEST_HOME/.local/bin/capture-lane" ]]; then
  echo ready
  HOME="$GUEST_HOME" \
    XDG_CONFIG_HOME="$GUEST_HOME/.config" \
    XDG_DATA_HOME="$GUEST_HOME/.local/share" \
    "$GUEST_HOME/.local/bin/capture-lane" health sanctuary-cortex
else
  echo missing
fi
# Verification helpers:1 ends here
