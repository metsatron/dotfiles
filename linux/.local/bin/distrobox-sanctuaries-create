# [[file:../../../distrobox.org::*Sanctuary Create Script][Sanctuary Create Script:1]]
# Create the three Phase 1 Distrobox sanctuaries.
# Run once per machine, or after `distrobox rm <name>` to recreate.
#
# Prerequisites:
#   - podman installed (via nala:apply)
#   - distrobox installed (via guix:apply → core.scm)
#   - base images built (via sanctuary-base-build)
# Guest homes are host-visible: $GUESTS_DIR/<name>/home/
set -euo pipefail

GUESTS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/dotcortex/guests"

# --- sanctuary-qtile: Emacs Sanctuary ---
# Base image: sanctuary-qtile:latest (built by sanctuary-base-build)
# SANCTUARY_QTILE_IMAGE="sanctuary-qtile:latest"
#
# distrobox create \
#   --name sanctuary-qtile \
#   --image "$SANCTUARY_QTILE_IMAGE" \
#   --home "$GUESTS_DIR/sanctuary-qtile/home" \
#   --no-entry

# --- sanctuary-gnustep: GNU/NeXT Lineage Sanctuary ---
# Base image: either guix-packed or debian:bookworm-slim (apt-based install on first entry)
# SANCTUARY_GNUSTEP_IMAGE="sanctuary-gnustep:latest"
#
# distrobox create \
#   --name sanctuary-gnustep \
#   --image "$SANCTUARY_GNUSTEP_IMAGE" \
#   --home "$GUESTS_DIR/sanctuary-gnustep/home" \
#   --no-entry

# --- sanctuary-cde: Motif/Sun Sanctuary (Phase 1B) ---
# Base image: sanctuary-cde:latest (built by sanctuary-base-build)
# SANCTUARY_CDE_IMAGE="sanctuary-cde:latest"
#
# distrobox create \
#   --name sanctuary-cde \
#   --image "$SANCTUARY_CDE_IMAGE" \
#   --home "$GUESTS_DIR/sanctuary-cde/home" \
#   --no-entry

echo "distrobox-sanctuaries-create: all blocks commented out — build base images first"
