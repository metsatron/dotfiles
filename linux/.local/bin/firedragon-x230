#!/usr/bin/env bash
# Desktop launchers

# [[file:../../../flatpak.org::*Desktop launchers][Desktop launchers:1]]
#!/usr/bin/env bash
set -euo pipefail

if [ -x "$HOME/.local/bin/ssh-agent-ensure" ]; then
    eval "$("$HOME/.local/bin/ssh-agent-ensure" --print)"
fi

MOUNT_POINT="$HOME/mnt/x230"
X230_HOST="${X230_SSH_HOST:-x230}"
REMOTE_HOME="${X230_REMOTE_HOME:-/home/metsatron}"
PROFILE_PATH="$MOUNT_POINT/.firedragon/flatpak-migrate"

mkdir -p "$MOUNT_POINT"

if ! mountpoint -q "$MOUNT_POINT"; then
    echo "X230 not mounted -- mounting now..."
    sshfs "$X230_HOST:$REMOTE_HOME" "$MOUNT_POINT" \
        -o reconnect,ServerAliveInterval=15,ServerAliveCountMax=3,cache=yes,kernel_cache
    sleep 1
fi

if [ ! -d "$PROFILE_PATH" ]; then
    echo "ERROR: Profile not accessible at $PROFILE_PATH" >&2
    echo "Check SSH connectivity and that the path exists on the X230." >&2
    exit 1
fi

args=(--profile "$PROFILE_PATH")
if [ "$#" -gt 0 ] && [ -n "${1:-}" ]; then
    args+=(--new-tab "$1")
fi

exec /usr/bin/flatpak run \
    --branch=stable \
    --arch=x86_64 \
    --command=/app/lib/firedragon/firedragon \
    org.garudalinux.firedragon \
    "${args[@]}"
# Desktop launchers:1 ends here
