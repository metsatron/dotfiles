#!/bin/bash
# redstone-9x-gtk-to-wine <scheme-id> [outroot]
#   Emit linux/.config/redstone-9x/wine/<WINE_COLORS or scheme-id>.reg derived
#   from the scheme's GTK_THEME gtk-3.0 @define-color palette + ICEWM_THEME
#   default.theme titlebar colours. Re-run after any GTK recolour to keep Wine
#   aligned with the widget layers. Fleet-consistent with the CDE .dp converter.
set -euo pipefail
SID="${1:?usage: redstone-9x-gtk-to-wine <scheme-id> [outroot]}"
OUTROOT="${2:-$HOME/DotCortex}"
SCHEME="${OUTROOT}/linux/.config/redstone-9x/schemes/${SID}.scheme"
[ -f "$SCHEME" ] || { echo "redstone-9x-gtk-to-wine: no scheme: $SCHEME" >&2; exit 1; }
python3 - "$SID" "$OUTROOT" "$SCHEME" <<'PYGTKWINE'
import sys, os, re
SID, OUTROOT, SCHEME = sys.argv[1:4]

def unhex(h):
    h = h.lstrip('#')
    if len(h) == 3: h = ''.join(c * 2 for c in h)
    return tuple(int(h[i:i+2], 16) for i in (0, 2, 4))
def hx(c): return '#%02x%02x%02x' % tuple(max(0, min(255, round(v))) for v in c)
def lum(c): return 0.299 * c[0] + 0.587 * c[1] + 0.114 * c[2]
def contrast(c): return (0, 0, 0) if lum(c) >= 128 else (255, 255, 255)
def blend_white(c, f): return tuple(x + (255 - x) * f for x in c)
def blend_black(c, f): return tuple(x * (1 - f) for x in c)

scheme_txt = open(SCHEME).read()
def sk(key, default=None):
    m = re.search(r'^%s="?([^"\n]+)"?' % re.escape(key), scheme_txt, re.M)
    return m.group(1) if m else default

GTK_THEME   = sk('GTK_THEME')
ICEWM_THEME = sk('ICEWM_THEME')
DESKTOP_BG  = sk('DESKTOP_BG', '#3f3f3f')
OUT_REG     = sk('WINE_COLORS', SID + '.reg')

# --- GTK-3.0 @define-color palette (the canonical widget colours) ---
gtkcss = os.path.join(OUTROOT, 'linux/.themes', GTK_THEME or '', 'gtk-3.0/gtk.css')
css = open(gtkcss).read() if GTK_THEME and os.path.exists(gtkcss) else ''
if not css:
    print('redstone-9x-gtk-to-wine: WARNING no gtk.css for %r, using greyscale defaults' % GTK_THEME, file=sys.stderr)
def gc(name, default):
    m = re.search(r'@define-color\s+%s\s+(#[0-9a-fA-F]{3,8})' % re.escape(name), css)
    return unhex(m.group(1)[:7]) if m else unhex(default)
FACE  = gc('theme_bg_color', '#d8d8d8')
BASE  = gc('theme_base_color', '#ffffff')
FG    = gc('theme_fg_color', '#000000')
TEXT  = gc('theme_text_color', hx(FG))
SEL   = gc('theme_selected_bg_color', '#989898')
SELTX = gc('theme_selected_fg_color', '#000000')
GRAY  = gc('insensitive_fg_color', '#7f7f7f')

# --- IceWM default.theme titlebar (real per-variant; the BeOS yellow tab is a
#     pixmap with no flat key, so the file's own flat value is the honest one) ---
icewmtheme = os.path.join(OUTROOT, 'linux/.icewm/themes', ICEWM_THEME or '', 'default.theme')
itxt = open(icewmtheme).read() if ICEWM_THEME and os.path.exists(icewmtheme) else ''
def tk(key, default):
    m = re.search(r'^%s\s*=\s*"?(#[0-9a-fA-F]{6})"?' % re.escape(key), itxt, re.M)
    return unhex(m.group(1)) if m else unhex(default)
ATITLE   = tk('ColorActiveTitleBar', hx(FACE))
ITITLE   = tk('ColorNormalTitleBar', hx(FACE))
ATITLETX = tk('ColorActiveTitleBarText', hx(contrast(ATITLE)))
ITITLETX = tk('ColorNormalTitleBarText', hx(contrast(ITITLE)))
BG = unhex(DESKTOP_BG)

# Dark bevel law (2026-07-30): subtle highlight + deep shadow on dark faces
FACE_DARK = 0.2126*FACE[0] + 0.7152*FACE[1] + 0.0722*FACE[2] < 140
regmap = {
    'ActiveBorder': FACE, 'ActiveTitle': ATITLE, 'AppWorkspace': (128, 128, 128),
    'Background': BG, 'ButtonDkShadow': (0, 0, 0), 'ButtonFace': FACE,
    'ButtonHilight': blend_white(FACE, 0.25 if FACE_DARK else 0.6),
    'ButtonLight': FACE,
    'ButtonShadow': blend_black(FACE, 0.5 if FACE_DARK else 0.4), 'ButtonText': FG,
    'GradientActiveTitle': blend_white(ATITLE, 0.5),
    'GradientInactiveTitle': blend_white(ITITLE, 0.5),
    'GrayText': GRAY, 'Hilight': SEL, 'HilightText': SELTX,
    'InactiveBorder': FACE, 'InactiveTitle': ITITLE, 'InactiveTitleText': ITITLETX,
    'InfoText': (0, 0, 0), 'InfoWindow': (255, 255, 225),
    'Menu': FACE, 'MenuText': FG, 'Scrollbar': blend_white(FACE, 0.3),
    'TitleText': ATITLETX, 'Window': BASE, 'WindowFrame': (0, 0, 0), 'WindowText': TEXT,
}

outpath = os.path.join(OUTROOT, 'linux/.config/redstone-9x/wine', OUT_REG)
os.makedirs(os.path.dirname(outpath), exist_ok=True)
with open(outpath, 'w', newline='\r\n') as f:
    f.write('REGEDIT4\n\n[HKEY_CURRENT_USER\\Control Panel\\Colors]\n')
    for k in sorted(regmap):
        r, g, b = (max(0, min(255, round(v))) for v in regmap[k])
        f.write('"%s"="%d %d %d"\n' % (k, r, g, b))
print('redstone-9x-gtk-to-wine: %s <- gtk:%s icewm:%s  face=%s title=%s sel=%s'
      % (OUT_REG, GTK_THEME, ICEWM_THEME, hx(FACE), hx(ATITLE), hx(SEL)))
PYGTKWINE
