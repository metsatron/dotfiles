#!/bin/env bash
# Agentify Cortex — host-side browser-session lane

# =agentify-cortex= starts Agentify Desktop (=agentify-desktop=, encoded in =agents-mcp.org=) on the Cortex sanctuary's full desktop. Unlike the seamless-app launchers above it is deliberately HOST-side: node/npx, the pinned launcher, and the native Brave that agentify drives all live on the T1700 host, and the control center only needs the sanctuary's X display — never the guest. Three launch lessons are baked in from the first bring-up (2026-08-16): never route through =distrobox-host-exec= (the guests keep separate homes under =~/.local/share/dotcortex/guests/= and the bridge strips the environment); the host-spawned process needs a full PATH (launcher + npx + node); and Electron dies by GLib SIGTRAP unless =XDG_DATA_DIRS= carries the compiled =org.appmenu.gtk-module= GSettings schema, which the Xpra desktop's XSETTINGS forces every GTK-linked app to load — the sanctuary-cortex guix profile ships it. On any other fleet machine the launcher is a front door that SSHes to kikin, same as its siblings.


# [[file:../../../sanctuary-cortex.org::*Agentify Cortex — host-side browser-session lane][Agentify Cortex — host-side browser-session lane:1]]
set -euo pipefail

if [ -x "$HOME/.local/bin/sanctuary-cortex-xpra" ]; then
  DISPLAY_NUM="${SANCTUARY_CORTEX_FULL_DISPLAY:-:101}"
  XPRA_BIN="${AGENTIFY_CORTEX_XPRA_BIN:-xpra}"
  CURL_BIN="${AGENTIFY_CORTEX_CURL_BIN:-curl}"
  GDBUS_BIN="${AGENTIFY_CORTEX_GDBUS_BIN:-gdbus}"
  DBUS_RUN_SESSION_BIN="${AGENTIFY_CORTEX_DBUS_RUN_SESSION_BIN:-dbus-run-session}"
  AGENTIFY_DESKTOP_BIN="${AGENTIFY_CORTEX_DESKTOP_BIN:-$HOME/.local/bin/agentify-desktop}"
  AGENTIFY_STATE="${AGENTIFY_CORTEX_STATE:-$HOME/.agentify-desktop/state.json}"
  AGENTIFY_LOCK="${AGENTIFY_CORTEX_LOCK:-$HOME/.agentify-desktop/agentify-cortex.lock}"

  if ! "$XPRA_BIN" list 2>/dev/null | grep -Fq "$DISPLAY_NUM"; then
    "$HOME/.local/bin/sanctuary-cortex-xpra" start-full
  fi

  mkdir -p "$(dirname -- "$AGENTIFY_STATE")"
  exec 9>"$AGENTIFY_LOCK"
  flock 9

  state_is_healthy() {
    local pid port server_id health
    [ -s "$AGENTIFY_STATE" ] || return 1
    pid="$(jq -er '.pid | select(type == "number" and floor == .)' "$AGENTIFY_STATE" 2>/dev/null)" || return 1
    port="$(jq -er '.port | select(type == "number" and floor == . and . >= 1 and . <= 65535)' "$AGENTIFY_STATE" 2>/dev/null)" || return 1
    server_id="$(jq -er '.serverId | select(type == "string" and length > 0)' "$AGENTIFY_STATE" 2>/dev/null)" || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    health="$("$CURL_BIN" -fsS --max-time 3 "http://127.0.0.1:$port/health" 2>/dev/null)" || return 1
    jq -e --arg server_id "$server_id" '.ok == true and .serverId == $server_id' >/dev/null 2>&1 <<<"$health"
  }

  if state_is_healthy; then
    echo "agentify-cortex: already running on $DISPLAY_NUM (control center healthy)"
    exit 0
  fi

  XAUTHORITY_FILE="${SANCTUARY_CORTEX_XAUTHORITY:-${XAUTHORITY:-$HOME/.Xauthority}}"
  [[ -r "$XAUTHORITY_FILE" ]] || {
    echo "agentify-cortex: Xauthority file is unavailable: $XAUTHORITY_FILE" >&2
    exit 1
  }
  [[ -x "$AGENTIFY_DESKTOP_BIN" ]] || {
    echo "agentify-cortex: Agentify Desktop launcher is unavailable: $AGENTIFY_DESKTOP_BIN" >&2
    exit 1
  }

  LOG="${AGENTIFY_CORTEX_LOG:-$HOME/.agentify-desktop/agentify-cortex.log}"
  AGENTIFY_DESKTOP_ARGS=(--disable-gpu)
  COMMON_ENV=(
    DISPLAY="$DISPLAY_NUM"
    XAUTHORITY="$XAUTHORITY_FILE"
    XDG_DATA_DIRS="$HOME/.guix-extra-profiles/sanctuary-cortex/sanctuary-cortex/share:/usr/share:/usr/local/share"
    PATH="$HOME/.local/bin:$HOME/.npm-global/bin:$HOME/.guix-extra-profiles/core/core/bin:/usr/local/bin:/usr/bin:/bin"
    AGENTIFY_DESKTOP_BROWSER_BACKEND=chrome-cdp
  )
  bus_is_usable() {
    [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] || return 1
    "$GDBUS_BIN" call --session --dest org.freedesktop.DBus \
      --object-path /org/freedesktop/DBus --method org.freedesktop.DBus.ListNames \
      >/dev/null 2>&1
  }

  if bus_is_usable; then
    setsid env "${COMMON_ENV[@]}" "$AGENTIFY_DESKTOP_BIN" "${AGENTIFY_DESKTOP_ARGS[@]}" >"$LOG" 2>&1 &
  else
    setsid "$DBUS_RUN_SESSION_BIN" -- env "${COMMON_ENV[@]}" "$AGENTIFY_DESKTOP_BIN" "${AGENTIFY_DESKTOP_ARGS[@]}" >"$LOG" 2>&1 &
  fi
  launch_pid=$!

  for _ in $(seq 1 "${AGENTIFY_CORTEX_START_WAIT:-75}"); do
    if state_is_healthy; then
      echo "agentify-cortex: started on $DISPLAY_NUM (control center healthy)"
      exit 0
    fi
    if ! kill -0 "$launch_pid" 2>/dev/null; then
      echo "agentify-cortex: Agentify Desktop exited before publishing healthy state; see $LOG" >&2
      exit 1
    fi
    sleep 0.2
  done
  kill "$launch_pid" 2>/dev/null || true
  echo "agentify-cortex: timed out waiting for a healthy control center; see $LOG" >&2
  exit 1
fi

REMOTE="${SANCTUARY_CORTEX_SSH_ALIAS:-kikin}"
exec ssh "$REMOTE" agentify-cortex "$@"
# Agentify Cortex — host-side browser-session lane:1 ends here
