#!/bin/env bash
# Agentify Cortex — host-side browser-session lane

# =agentify-cortex= starts Agentify Desktop (=agentify-desktop=, encoded in =agents-mcp.org=) on the Cortex sanctuary's full desktop. Unlike the seamless-app launchers above it is deliberately HOST-side: node/npx, the pinned launcher, and the native Brave that agentify drives all live on the T1700 host, and the control center only needs the sanctuary's X display — never the guest. Three launch lessons are baked in from the first bring-up (2026-08-16): never route through =distrobox-host-exec= (the guests keep separate homes under =~/.local/share/dotcortex/guests/= and the bridge strips the environment); the host-spawned process needs a full PATH (launcher + npx + node); and Electron dies by GLib SIGTRAP unless =XDG_DATA_DIRS= carries the compiled =org.appmenu.gtk-module= GSettings schema, which the Xpra desktop's XSETTINGS forces every GTK-linked app to load — the sanctuary-cortex guix profile ships it. On any other fleet machine the launcher is a front door that SSHes to kikin, same as its siblings.


# [[file:../../../sanctuary-cortex.org::*Agentify Cortex — host-side browser-session lane][Agentify Cortex — host-side browser-session lane:1]]
set -euo pipefail

if [ -x "$HOME/.local/bin/sanctuary-cortex-xpra" ]; then
  DISPLAY_NUM="${SANCTUARY_CORTEX_FULL_DISPLAY:-:101}"
  if ! xpra list 2>/dev/null | grep -Fq "$DISPLAY_NUM"; then
    "$HOME/.local/bin/sanctuary-cortex-xpra" start-full
  fi
  # Liveness guard (2026-08-25): probe the control center's own /health, not a
  # process pattern. =pgrep -f '@agentify/desktop'= false-matched the stdio MCP
  # bridge processes every live agent session leaves running (=… @agentify/desktop@X
  # mcp=), so it reported "already running" while the actual GUI was dead, and it
  # ignored a stale state.json pointing at a dead pid. The control center writes its
  # port to state.json and serves an unauthenticated /health; probing that fixes both.
  AGENTIFY_STATE="$HOME/.agentify-desktop/state.json"
  if [ -f "$AGENTIFY_STATE" ]; then
    AGENTIFY_PORT="$(grep -oE '"port"[[:space:]]*:[[:space:]]*[0-9]+' "$AGENTIFY_STATE" 2>/dev/null | grep -oE '[0-9]+' | head -1 || true)"
    if [ -n "$AGENTIFY_PORT" ] && curl -fs --max-time 3 "http://127.0.0.1:$AGENTIFY_PORT/health" >/dev/null 2>&1; then
      echo "agentify-cortex: already running on $DISPLAY_NUM (control center healthy on port $AGENTIFY_PORT)"
      exit 0
    fi
  fi
  XAUTHORITY_FILE="${SANCTUARY_CORTEX_XAUTHORITY:-${XAUTHORITY:-$HOME/.Xauthority}}"
  [[ -r "$XAUTHORITY_FILE" ]] || {
    echo "agentify-cortex: Xauthority file is unavailable: $XAUTHORITY_FILE" >&2
    exit 1
  }
  mkdir -p "$HOME/.agentify-desktop"
  LOG="$HOME/.agentify-desktop/agentify-cortex.log"
  setsid env \
    DISPLAY="$DISPLAY_NUM" \
    XAUTHORITY="$XAUTHORITY_FILE" \
    XDG_DATA_DIRS="$HOME/.guix-extra-profiles/sanctuary-cortex/sanctuary-cortex/share:/usr/share:/usr/local/share" \
    PATH="$HOME/.local/bin:$HOME/.npm-global/bin:$HOME/.guix-extra-profiles/core/core/bin:/usr/local/bin:/usr/bin:/bin" \
    "$HOME/.local/bin/agentify-desktop" >"$LOG" 2>&1 &
  echo "agentify-cortex: launched on $DISPLAY_NUM (log: $LOG)"
  exit 0
fi

REMOTE="${SANCTUARY_CORTEX_SSH_ALIAS:-kikin}"
exec ssh "$REMOTE" agentify-cortex "$@"
# Agentify Cortex — host-side browser-session lane:1 ends here
