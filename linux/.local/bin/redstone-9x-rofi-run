#!/bin/bash
# [[file:../../../sanctuary-redstone-9x-desktop.org::*FVWM95 configuration][FVWM95 configuration:13]]
GUIX_PROFILE="$HOME/.guix-extra-profiles/desktop-common/desktop-common"; export GUIX_PROFILE
[ -r "$GUIX_PROFILE/etc/profile" ] && . "$GUIX_PROFILE/etc/profile"
GUIX_PROFILE="$HOME/.guix-extra-profiles/room-gaming/room-gaming"; export GUIX_PROFILE
[ -r "$GUIX_PROFILE/etc/profile" ] && . "$GUIX_PROFILE/etc/profile"
set -euo pipefail
runtime="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}"
pidfile="$runtime/rofi-run95-$(id -u).pid"
theme="$HOME/.config/redstone-9x/rofi/Windows95-Run.rasi"

case "${1-}" in
  --check-theme)
    exec rofi -no-config -theme "$theme" -dump-theme
    ;;
esac

# Fixed-geometry Windows-95 Run box on stock rofi: the listview stays disabled
# and nothing toggles it at runtime, so the managed window keeps one stable size
# (the old toggle-listview-on-mode-next resize is what oscillated under IceWM).
# Two Win95 combobox affordances, each a themed button that exits rofi with a
# distinct code (rofi kb-custom-N -> exit 10 + N-1), handled below by relaunching
# a different rofi view — no binary patch, no in-place resize:
#   Browse...  (button-browse  -> kb-custom-1 -> 10) -> the drun application window
#   ▼ dropdown (combo-button   -> kb-custom-2 -> 11) -> the Run command history
# Once IceWM maps the Rofi window, retitle it (a real Win95 dialog reads "Run",
# not "rofi - Run") and centre it — rofi ignores its own theme location under
# -normal-window, so IceWM would otherwise pin it top-left and clip the titlebar.
# The map + WM handshake outruns a fixed delay, so poll (icesh ships with IceWM).
_frame_rofi() {
  local title="$1"
  ( for _i in $(seq 1 50); do
      if icesh -c Rofi list 2>/dev/null | grep -q Rofi; then
        icesh -c Rofi setWindowTitle "${title}" 2>/dev/null
        icesh -c Rofi center 2>/dev/null
        break
      fi
      sleep 0.08
    done ) &
}

_frame_rofi "Run"
rc=0
rofi \
  -x11 \
  -config "$HOME/.config/redstone-9x/rofi/config.rasi" \
  -theme "$theme" \
  -normal-window \
  -modes run \
  -show run \
  -display-run "Run" \
  -pid "$pidfile" \
  -kb-accept-entry "Control+j,Control+m" \
  -kb-accept-custom "Return,KP_Enter,Control+Return" \
  "$@" || rc=$?

if [ "$rc" -eq 10 ]; then
  # Browse... -> the rofi application launcher (drun).  A standard rofi window
  # (not -normal-window) so its listview grows freely without the geometry
  # oscillation that -normal-window fixed-height would reintroduce.
  exec rofi \
    -config "$HOME/.config/redstone-9x/rofi/config.rasi" \
    -show drun \
    -show-icons \
    -display-drun "Programs"
fi
if [ "$rc" -eq 11 ]; then
  # ▼ dropdown -> the Run command history, in the same framed Win95 dialog style.
  _frame_rofi "Run history"
  exec rofi \
    -x11 \
    -config "$HOME/.config/redstone-9x/rofi/config.rasi" \
    -normal-window \
    -modes run \
    -show run \
    -display-run "Run history" \
    -pid "$pidfile"
fi
exit "$rc"
# FVWM95 configuration:13 ends here
