#!/bin/bash
# [[file:../../../sanctuary-redstone-9x-desktop.org::*FVWM95 configuration][FVWM95 configuration:12]]
GUIX_PROFILE="$HOME/.guix-extra-profiles/desktop-common/desktop-common"; export GUIX_PROFILE
[ -r "$GUIX_PROFILE/etc/profile" ] && . "$GUIX_PROFILE/etc/profile"
GUIX_PROFILE="$HOME/.guix-extra-profiles/room-gaming/room-gaming"; export GUIX_PROFILE
[ -r "$GUIX_PROFILE/etc/profile" ] && . "$GUIX_PROFILE/etc/profile"
set -euo pipefail
runtime="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}"
pidfile="$runtime/rofi-run95-$(id -u).pid"
theme="$HOME/.config/redstone-9x/rofi/Windows95-Run.rasi"

case "${1-}" in
  --check-theme)
    exec rofi -no-config -theme "$theme" -dump-theme
    ;;
esac

# Fixed-geometry Windows-95 Run box on stock rofi: the listview stays disabled
# and nothing toggles it at runtime, so the managed window keeps one stable size
# (the old toggle-listview-on-mode-next resize is what oscillated under IceWM).
# Browse... (button-browse -> kb-custom-1) exits rofi with code 10; we relaunch
# the run history as a separate list instead of expanding the dialog in place.
rc=0
rofi \
  -x11 \
  -config "$HOME/.config/redstone-9x/rofi/config.rasi" \
  -theme "$theme" \
  -normal-window \
  -modes run \
  -show run \
  -display-run "Run" \
  -pid "$pidfile" \
  -kb-accept-entry "Control+j,Control+m" \
  -kb-accept-custom "Return,KP_Enter,Control+Return" \
  "$@" || rc=$?

if [ "$rc" -eq 10 ]; then
  exec rofi \
    -x11 \
    -config "$HOME/.config/redstone-9x/rofi/config.rasi" \
    -normal-window \
    -modes run \
    -show run \
    -display-run "Run history" \
    -pid "$pidfile"
fi
exit "$rc"
# FVWM95 configuration:12 ends here
