#!/usr/bin/env bash
# [[file:../../../sanctuary-sx.org::*Godzilla XS-86000 library, state, and menu foundation][Godzilla XS-86000 library, state, and menu foundation:15]]
set -euo pipefail

if [[ -x /run/host/usr/bin/setxkbmap ]]; then
  exec /run/host/usr/bin/setxkbmap -layout us -variant colemak -option terminate:ctrl_alt_bksp
fi

if command -v setxkbmap >/dev/null 2>&1; then
  exec "$(command -v setxkbmap)" -layout us -variant colemak -option terminate:ctrl_alt_bksp
fi

if [[ -x /usr/bin/setxkbmap ]]; then
  exec /usr/bin/setxkbmap -layout us -variant colemak -option terminate:ctrl_alt_bksp
fi

exit 0
# Godzilla XS-86000 library, state, and menu foundation:15 ends here
