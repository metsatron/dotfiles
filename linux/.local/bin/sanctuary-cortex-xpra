#!/bin/env bash
# [[file:../../../sanctuary-cortex.org::*T1700 Xpra runtime][T1700 Xpra runtime:3]]
set -euo pipefail

FULL_DISPLAY="${SANCTUARY_CORTEX_FULL_DISPLAY:-:101}"
APPS_DISPLAY="${SANCTUARY_CORTEX_APPS_DISPLAY:-:100}"
GEOMETRY="${SANCTUARY_CORTEX_GEOMETRY:-1920x1080}"
SESSION="${SANCTUARY_CORTEX_SESSION:-$HOME/.local/bin/sanctuary-cortex-session}"
RESOURCE_APPLY="${SANCTUARY_CORTEX_RESOURCE_APPLY:-$HOME/.local/bin/sanctuary-cortex-inotify-apply}"

usage() { echo "Usage: sanctuary-cortex-xpra start-full|start-apps|stop|status" >&2; }
command -v xpra >/dev/null 2>&1 || { echo "sanctuary-cortex-xpra: xpra is required on the T1700 host" >&2; exit 127; }

apply_resource_limits() {
  [[ -x "$RESOURCE_APPLY" ]] || {
    echo "sanctuary-cortex-xpra: missing resource helper: $RESOURCE_APPLY" >&2
    exit 1
  }
  "$RESOURCE_APPLY"
}

start_full() {
  [[ -x "$SESSION" ]] || { echo "sanctuary-cortex-xpra: missing session helper: $SESSION" >&2; exit 1; }
  apply_resource_limits
  export GST_PLUGIN_SYSTEM_PATH=/usr/lib/x86_64-linux-gnu/gstreamer-1.0
  xpra start-desktop "$FULL_DISPLAY" --daemon=yes --exit-with-children=yes \
    --resize-display="$GEOMETRY" --mdns=no \
    --min-quality=70 --min-speed=40 \
    --auto-refresh-delay=0.5 \
    --video-scaling=off \
    --av-sync=no \
    --compress=1 \
    --start-child="$SESSION"
}

start_apps() {
  apply_resource_limits
  export GST_PLUGIN_SYSTEM_PATH=/usr/lib/x86_64-linux-gnu/gstreamer-1.0
  xpra start "$APPS_DISPLAY" --daemon=yes --exit-with-children=no \
    --resize-display="$GEOMETRY" --mdns=no --start-new-commands=yes \
    --min-quality=70 --min-speed=40 \
    --auto-refresh-delay=0.5 \
    --video-scaling=off \
    --av-sync=no
}

case "${1:-}" in
  start-full) start_full ;;
  start-apps) start_apps ;;
  stop) xpra stop "$FULL_DISPLAY" 2>/dev/null || true; xpra stop "$APPS_DISPLAY" 2>/dev/null || true ;;
  status) xpra list ;;
  *) usage; exit 2 ;;
esac
# T1700 Xpra runtime:3 ends here
