#!/usr/bin/env bash
set -euo pipefail

REPO_URL="https://github.com/jakbin/plank-reloaded"
PINNED_COMMIT="388a0b71e71f519032e1476f2daf441bfefbd9c2"
SRC_ROOT="${PLANK_RELOADED_SRC_ROOT:-$HOME/.local/share/dotcortex/src}"
SRC="${SRC_ROOT}/plank-reloaded"
BUILD="${PLANK_RELOADED_BUILD_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/dotcortex/plank-reloaded-build}"
PREFIX="${PLANK_RELOADED_PREFIX:-/usr/local}"

die() { printf 'plank-reloaded-build: %s\n' "$*" >&2; exit 1; }

for tool in git meson ninja valac pkg-config; do
  command -v "$tool" >/dev/null 2>&1 || die "$tool missing — run nala:apply for the declared build dependencies"
done

case "$PREFIX" in
  /*) ;;
  *) die "PLANK_RELOADED_PREFIX must be an absolute path" ;;
esac

mkdir -p "$SRC_ROOT"
if [ -d "$SRC/.git" ]; then
  origin="$(git -C "$SRC" remote get-url origin 2>/dev/null || true)"
  origin="${origin%.git}"
  [ "$origin" = "$REPO_URL" ] || die "existing checkout origin is $origin, expected $REPO_URL"
  git -C "$SRC" fetch --quiet origin "$PINNED_COMMIT" \
    || git -C "$SRC" fetch --quiet --depth=1 origin master
else
  git clone --quiet "$REPO_URL" "$SRC"
fi

git -C "$SRC" cat-file -e "${PINNED_COMMIT}^{commit}" 2>/dev/null \
  || git -C "$SRC" fetch --quiet origin "$PINNED_COMMIT"
git -C "$SRC" checkout --quiet --detach "$PINNED_COMMIT"
actual_commit="$(git -C "$SRC" rev-parse HEAD)"
[ "$actual_commit" = "$PINNED_COMMIT" ] \
  || die "checkout is $actual_commit, expected $PINNED_COMMIT"

if [ "${FORCE:-0}" = "1" ]; then
  rm -rf "$BUILD"
fi

if [ -d "$BUILD" ]; then
  meson setup --reconfigure "$BUILD" "$SRC" \
    --prefix="$PREFIX" --libdir=lib --buildtype=release
else
  meson setup "$BUILD" "$SRC" \
    --prefix="$PREFIX" --libdir=lib --buildtype=release
fi
meson compile -C "$BUILD"

sudo meson install -C "$BUILD"
sudo ldconfig

# The old distro package owns /usr/bin/plank. Remove it only after the fork has
# installed successfully, leaving /usr/local/bin/plank as the sole resolution.
if dpkg-query -W -f='${Status}\n' plank 2>/dev/null | grep -q '^install ok installed$'; then
  sudo apt-get remove -y plank libplank-common libplank1
fi

resolved="$(command -v plank || true)"
[ "$resolved" = "$PREFIX/bin/plank" ] \
  || die "plank resolves to ${resolved:-nothing}, expected $PREFIX/bin/plank"

printf 'installed plank-reloaded\n'
printf '  source: %s\n' "$REPO_URL"
printf '  commit: %s\n' "$actual_commit"
printf '  binary: %s\n' "$resolved"
"$resolved" -v 2>&1 | head -n 1 || true
