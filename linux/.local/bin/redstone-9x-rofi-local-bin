#!/bin/bash
# [[file:../../../sanctuary-redstone-9x-fvwm95.org::*Dynamic menus — recent Documents + Desktop folder][Dynamic menus — recent Documents + Desktop folder:13]]
GUIX_PROFILE="$HOME/.guix-extra-profiles/desktop-common/desktop-common"; export GUIX_PROFILE
[ -r "$GUIX_PROFILE/etc/profile" ] && . "$GUIX_PROFILE/etc/profile"
GUIX_PROFILE="$HOME/.guix-extra-profiles/room-gaming/room-gaming"; export GUIX_PROFILE
[ -r "$GUIX_PROFILE/etc/profile" ] && . "$GUIX_PROFILE/etc/profile"
set -euo pipefail
choice="$(
    for candidate in "$HOME/.local/bin"/*; do
        [ -f "$candidate" ] && [ -x "$candidate" ] || continue
        basename "$candidate"
    done | sort -f | rofi -config "$HOME/.config/redstone-9x/rofi/config.rasi" -dmenu -i -p "local/bin"
)"
[ -n "$choice" ] || exit 0
exec "$HOME/.local/bin/$choice"
# Dynamic menus — recent Documents + Desktop folder:13 ends here
