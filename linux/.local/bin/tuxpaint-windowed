# [[file:../../../sanctuary-distrobox.org::*Sanctuary Launcher Scripts][Sanctuary Launcher Scripts:17]]
#!/usr/bin/env bash
# Tux Paint — CDE Windowed mode.
# Runs in a CDE-managed window with no sound, no input grab, advanced complexity.
exec tuxpaint \
    --windowed \
    --windowsize=1024x768 \
    --nosound \
    --nofancycursors \
    --dontgrab \
    --complexity=advanced \
    "$@"
