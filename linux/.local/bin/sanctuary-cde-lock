# [[file:../../../distrobox.org::*Sanctuary Launcher Scripts][Sanctuary Launcher Scripts:9]]
#!/usr/bin/env bash
# Activate the CDE screen blanker from inside the sanctuary session.
# dtlock cannot authenticate in Xephyr/rootless DistroBox (no PAM path).
# This wrapper activates the CDE screen saver (dtscreen -mode blank) instead.
# The FrontPanel Lock button also uses this via the dtlock binary wrapper
# installed by sanctuary-cde-build.
# Host session locking: use host methods (Super+L / XFCE lock panel applet).
DISPLAY="${DISPLAY:-:92}"
CDE_BIN="${HOME}/.local/share/cde/bin"
if [ -x "${CDE_BIN}/dtscreen" ]; then
    exec "${CDE_BIN}/dtscreen" -mode blank
else
    exec xset s activate 2>/dev/null || true
fi
