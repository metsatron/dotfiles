# [[file:../../../sanctuary-distrobox.org::*Sanctuary Launcher Scripts][Sanctuary Launcher Scripts:13]]
#!/usr/bin/env bash
# Activate the X11 screen blanker from inside the sanctuary session.
# dtlock cannot authenticate in Xephyr/rootless DistroBox (no PAM path).
# This wrapper activates X11 blanking directly instead.
# The FrontPanel Lock button also uses this via the dtlock binary wrapper
# installed by sanctuary-cde-build.
# Host session locking: use host methods (Super+L / XFCE lock panel applet).
DISPLAY="${DISPLAY:-:92}"
exec xset s activate
# Sanctuary Launcher Scripts:13 ends here
