#!/bin/bash
# Virtual My Computer namespace

# The Win95 desktop's =My Computer= icon opens this small generated namespace rather
# than exposing the sanctuary's real root directory.  It keeps the useful Windows
# shell metaphor while making the actual compatibility boundaries explicit:

# - =C:\= is the active Redstone Wine prefix's =drive_c=.
# - =Z:\= is Wine's root mapping, which opens the guest filesystem.
# - =Control Panel= is the native ice2k replica, not a Wine executable.
# - =Network Neighborhood= is one visible launcher; its internal drawer lives
#   outside this directory because PCManFM is configured to show hidden files.

# DOSEMU2 and DOSBox-X remain desktop launchers.  They are runtimes, not drives in
# this namespace; DOSEMU2's C: is a generated directory bridge and DOSBox-X has no
# declared disk image to expose here.

# The namespace lives below =~/.local/share/redstone-9x/My Computer= so it does not
# create a visible =~/My Computer= recursion.  Its entries are regenerated
# idempotently at session startup, and all paths are resolved by the guest shell
# when clicked.


# [[file:../../../sanctuary-redstone-9x-desktop.org::*Virtual My Computer namespace][Virtual My Computer namespace:1]]
set -euo pipefail

STATE_ROOT="${HOME}/.local/share/redstone-9x"
DEFAULT_ROOT="${STATE_ROOT}/My Computer"
ROOT="${REDSTONE_MY_COMPUTER_ROOT:-${DEFAULT_ROOT}}"
LEGACY_ROOT="${HOME}/.local/share/redstone-9x/my-computer"
if [[ "${ROOT}" == "${DEFAULT_ROOT}" && ! -e "${ROOT}" && -d "${LEGACY_ROOT}" ]]; then
  mv "${LEGACY_ROOT}" "${ROOT}"
fi

NETWORK="${STATE_ROOT}/.network-neighborhood"
for _legacy_network in "${ROOT}/.Network Neighborhood" "${ROOT}/Network Neighborhood"; do
  [[ -d "${_legacy_network}" ]] || continue
  if [[ ! -e "${NETWORK}" ]]; then
    mv "${_legacy_network}" "${NETWORK}"
  else
    for _entry in "${_legacy_network}"/*.desktop; do
      [[ -f "${_entry}" ]] || continue
      _dest="${NETWORK}/$(basename "${_entry}")"
      [[ -e "${_dest}" ]] || mv "${_entry}" "${_dest}"
    done
    rmdir "${_legacy_network}" 2>/dev/null || true
  fi
done
WINE_PREFIX="${WINEPREFIX:-${HOME}/.wine-redstone}"
HOST_HOME="${REDSTONE_HOST_HOME:-/run/host/home/$(id -un)}"

mkdir -p "${NETWORK}"

write_entry() {
  local file="$1" name="$2" comment="$3" icon="$4" exec_line="$5"
  local tmp="${file}.tmp.$$"

  {
    printf '%s\n' '[Desktop Entry]' 'Version=1.0' 'Type=Application'
    printf 'Name=%s\nComment=%s\nExec=%s\nIcon=%s\nTerminal=false\n' \
      "${name}" "${comment}" "${exec_line}" "${icon}"
  } > "${tmp}"
  chmod 644 "${tmp}"
  mv -f "${tmp}" "${file}"
}

remove_generated_entry() {
  local file="$1" name="$2"
  if [[ -f "${file}" ]] && grep -q "^Name=${name}$" "${file}"; then
    rm -f "${file}"
  fi
}

# These are absolute guest paths because the helper runs inside sanctuary-exec;
# that keeps the entries tied to the active prefix even if a file manager is
# launched outside the shell that exported WINEPREFIX.
C_EXEC="sh -c 'exec pcmanfm \"${WINE_PREFIX}/dosdevices/c:\"'"
Z_EXEC="sh -c 'exec pcmanfm \"${WINE_PREFIX}/dosdevices/z:\"'"
CD_EXEC="sh -c 'exec pcmanfm \"${WINE_PREFIX}/dosdevices/f:\"'"
CONTROL_EXEC="sh -c 'exec \"${HOME}/.local/ice2k/bin/control\"'"
NETWORK_EXEC="sh -c 'exec pcmanfm \"${NETWORK}\"'"
HOST_HOME_EXEC="sh -c 'exec pcmanfm \"${HOST_HOME}\"'"
WORKGROUP_EXEC="sh -c 'exec \"${HOME}/.local/bin/redstone-9x-host-gtk\" \"/home/metsatron/.guix-extra-profiles/room-gaming/room-gaming/bin/pcmanfm\" \"/home/metsatron/mnt\"'"

remove_generated_entry "${ROOT}/Network Neighborhood.desktop" 'Network Neighborhood'
remove_generated_entry "${NETWORK}/Host Mounts.desktop" 'Host Mounts'

write_entry "${ROOT}/C:.desktop" \
  'Local Disk (C:)' 'Open the active Redstone Wine C drive' drive-harddisk "${C_EXEC}"
write_entry "${ROOT}/Z:.desktop" \
  'Root Disk (Z:)' 'Open the Wine root filesystem mapping' drive-harddisk "${Z_EXEC}"
write_entry "${ROOT}/CD-ROM.desktop" \
  'Compact Disc (F:)' 'Open the Redstone optical media drive (F:)' drive-optical "${CD_EXEC}"
write_entry "${ROOT}/Control Panel.desktop" \
  'Control Panel' 'Open the native Redstone Control Panel' redstone-control-panel "${CONTROL_EXEC}"
write_entry "${ROOT}/Network Neighborhood.desktop" \
  'Network Neighborhood' 'Browse host resources shared with the sanctuary' network-workgroup "${NETWORK_EXEC}"
write_entry "${NETWORK}/Host Home.desktop" \
  'Host Home' 'Browse the host home directory' user-home "${HOST_HOME_EXEC}"
write_entry "${NETWORK}/Workgroup.desktop" \
  'Workgroup' 'Browse the host ~/mnt collection' network-workgroup "${WORKGROUP_EXEC}"
# Virtual My Computer namespace:1 ends here
