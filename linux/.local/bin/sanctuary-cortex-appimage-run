#!/bin/bash
# [[file:../../../sanctuary-cortex.org::*Private migration bridges][Private migration bridges:7]]
set -euo pipefail

[[ "$#" -ge 1 ]] || {
  echo "Usage: sanctuary-cortex-appimage-run <AppImage> [arguments...]" >&2
  exit 2
}

HOST_HOME="${SANCTUARY_HOST_HOME:-/home/metsatron}"
APPIMAGE="$1"
shift

# The AppImage is a host ELF. Running it by pathname from the guest makes the
# guest kernel try the host binary's /lib64/ld-linux-x86-64.so.2, which is not
# the host loader in this Distrobox mount. Relay the AppImage itself through
# host-spawn so the complete process starts in Kikin's host namespace. The
# host-session bus is captured before dbus-run-session replaces the guest
# desktop bus; /tmp is shared between host and guest on this sanctuary.
if [[ "$HOME" == */.local/share/dotcortex/guests/*/home ]]; then
  HOST_BUS_FILE="$HOME/.config/sanctuary/host-session-bus"
  HOST_BUS=""
  [[ -r "$HOST_BUS_FILE" ]] && HOST_BUS="$(head -n1 "$HOST_BUS_FILE")"
  if [[ -n "$HOST_BUS" && -x /usr/bin/host-spawn ]]; then
    export DBUS_SESSION_BUS_ADDRESS="$HOST_BUS"
    HOST_ENV=()
    for variable in DISPLAY XAUTHORITY HOME XDG_CONFIG_HOME XDG_DATA_HOME XDG_STATE_HOME XDG_CACHE_HOME; do
      [[ -v "$variable" ]] && HOST_ENV+=("$variable")
    done
    ENV_LIST="$(IFS=,; printf '%s' "${HOST_ENV[*]}")"
    exec /usr/bin/host-spawn -no-pty -env "$ENV_LIST" \
      "$APPIMAGE" --appimage-extract-and-run "$@"
  fi
  echo "sanctuary-cortex-appimage-run: host-spawn session bus is unavailable" >&2
  echo "sanctuary-cortex-appimage-run: restart the Cortex session before launching AppImages" >&2
  exit 1
fi

# A direct host invocation remains useful for diagnostics and for any future
# host-side caller. It still uses extraction mode because rootless FUSE is not
# guaranteed on Kikin.
APPIMAGED="${SANCTUARY_APPIMAGED:-$HOST_HOME/.local/bin/appimaged}"
if [[ -x "$APPIMAGED" ]]; then
  exec "$APPIMAGED" wrap "$APPIMAGE" --appimage-extract-and-run "$@"
fi
exec "$APPIMAGE" --appimage-extract-and-run "$@"
# Private migration bridges:7 ends here
