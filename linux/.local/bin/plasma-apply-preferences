#!/usr/bin/env bash
set -euo pipefail

KWRITE="${KWRITE:-kwriteconfig6}"
QDBUS="${QDBUS:-qdbus6}"
KGLOBAL="$HOME/.config/kglobalshortcutsrc"

need() {
  command -v "$1" >/dev/null 2>&1 || {
    printf 'missing required command: %s\n' "$1" >&2
    exit 1
  }
}

backup_once() {
  local path="$1"
  [ -e "$path" ] || return 0
  cp "$path" "$path.backup-$(date +%Y%m%d-%H%M%S)"
}

kset() {
  "$KWRITE" --file "$KGLOBAL" --group "$1" --key "$2" "$3"
}

kset2() {
  "$KWRITE" --file "$KGLOBAL" --group "$1" --group "$2" --key "$3" "$4"
}

need "$KWRITE"

mkdir -p "$(dirname "$KGLOBAL")"
backup_once "$KGLOBAL"

# Keyboard layout switching.
kset 'KDE Keyboard Layout Switcher' 'Switch to Last-Used Keyboard Layout' \
  'Meta+Alt+L,Meta+Alt+L,Switch to Last-Used Keyboard Layout'
kset 'KDE Keyboard Layout Switcher' 'Switch to Next Keyboard Layout' \
  'Meta+Alt+K,Meta+Alt+K,Switch to Next Keyboard Layout'

# Session actions.
kset ksmserver 'Lock Session' $'Meta+L\tScreensaver,Meta+L\tScreensaver,Lock Session'
kset ksmserver 'Log Out' 'Ctrl+Alt+Del,Ctrl+Alt+Del,Show Logout Screen'

# KWin: Alt window switching only. Meta+Tab is deliberately not bound here.
kset kwin 'Walk Through Windows' \
  'Alt+Tab,Alt+Tab,Walk Through Windows'
kset kwin 'Walk Through Windows (Reverse)' \
  'Alt+Shift+Tab,Alt+Shift+Tab,Walk Through Windows (Reverse)'
kset kwin 'Walk Through Windows of Current Application' \
  'Alt+`,Alt+`,Walk Through Windows of Current Application'
kset kwin 'Walk Through Windows of Current Application (Reverse)' \
  'Alt+~,Alt+~,Walk Through Windows of Current Application (Reverse)'

# KWin: common window and desktop controls.
kset kwin 'Activate Window Demanding Attention' \
  'Meta+Ctrl+A,Meta+Ctrl+A,Activate Window Demanding Attention'
kset kwin 'Kill Window' \
  'Meta+Ctrl+Esc,Meta+Ctrl+Esc,Kill Window'
kset kwin 'Show Desktop' \
  'Meta+D,Meta+D,Peek at Desktop'
kset kwin 'Suspend Compositing' \
  'Alt+Shift+F12,Alt+Shift+F12,Suspend Compositing'
kset kwin 'Window Close' \
  'Alt+F4,Alt+F4,Close Window'
kset kwin 'Window Maximize' \
  'Meta+PgUp,Meta+PgUp,Maximise Window'
kset kwin 'Window Minimize' \
  'Meta+PgDown,Meta+PgDown,Minimise Window'
kset kwin 'Window Operations Menu' \
  'Alt+F3,Alt+F3,Window Menu'

kset kwin 'Switch One Desktop Down' \
  'Meta+Ctrl+Down,Meta+Ctrl+Down,Switch One Desktop Down'
kset kwin 'Switch One Desktop Up' \
  'Meta+Ctrl+Up,Meta+Ctrl+Up,Switch One Desktop Up'
kset kwin 'Switch One Desktop to the Left' \
  'Meta+Ctrl+Left,Meta+Ctrl+Left,Switch One Desktop to the Left'
kset kwin 'Switch One Desktop to the Right' \
  'Meta+Ctrl+Right,Meta+Ctrl+Right,Switch One Desktop to the Right'
kset kwin 'Window One Desktop Down' \
  'Meta+Ctrl+Shift+Down,Meta+Ctrl+Shift+Down,Window One Desktop Down'
kset kwin 'Window One Desktop Up' \
  'Meta+Ctrl+Shift+Up,Meta+Ctrl+Shift+Up,Window One Desktop Up'
kset kwin 'Window One Desktop to the Left' \
  'Meta+Ctrl+Shift+Left,Meta+Ctrl+Shift+Left,Window One Desktop to the Left'
kset kwin 'Window One Desktop to the Right' \
  'Meta+Ctrl+Shift+Right,Meta+Ctrl+Shift+Right,Window One Desktop to the Right'

kset kwin 'Switch Window Down' \
  'Meta+Alt+Down,Meta+Alt+Down,Switch to Window Below'
kset kwin 'Switch Window Left' \
  'Meta+Alt+Left,Meta+Alt+Left,Switch to Window to the Left'
kset kwin 'Switch Window Right' \
  'Meta+Alt+Right,Meta+Alt+Right,Switch to Window to the Right'
kset kwin 'Switch Window Up' \
  'Meta+Alt+Up,Meta+Alt+Up,Switch to Window Above'

kset kwin 'Switch to Desktop 1' 'Ctrl+F1,Ctrl+F1,Switch to Desktop 1'
kset kwin 'Switch to Desktop 2' 'Ctrl+F2,Ctrl+F2,Switch to Desktop 2'
kset kwin 'Switch to Desktop 3' 'Ctrl+F3,Ctrl+F3,Switch to Desktop 3'
kset kwin 'Switch to Desktop 4' 'Ctrl+F4,Ctrl+F4,Switch to Desktop 4'

kset kwin 'Window Quick Tile Bottom' \
  'Meta+Down,Meta+Down,Quick Tile Window to the Bottom'
kset kwin 'Window Quick Tile Left' \
  'Meta+Left,Meta+Left,Quick Tile Window to the Left'
kset kwin 'Window Quick Tile Right' \
  'Meta+Right,Meta+Right,Quick Tile Window to the Right'
kset kwin 'Window Quick Tile Top' \
  'Meta+Up,Meta+Up,Quick Tile Window to the Top'
kset kwin 'Window to Next Screen' \
  'Meta+Shift+Right,Meta+Shift+Right,Move Window to Next Screen'
kset kwin 'Window to Previous Screen' \
  'Meta+Shift+Left,Meta+Shift+Left,Move Window to Previous Screen'

kset kwin 'view_actual_size' 'Meta+0,Meta+0,Zoom to Actual Size'
kset kwin 'view_zoom_in' $'Meta++\tMeta+=,Meta++\tMeta+=,Zoom In'
kset kwin 'view_zoom_out' 'Meta+-,Meta+-,Zoom Out'

# Plasma shell shortcuts. Keep launcher on Alt+F1 only; no bare Meta binding.
kset plasmashell 'activate application launcher' \
  'Alt+F1,Alt+F1,Activate Application Launcher'
for n in 1 2 3 4 5 6 7 8 9; do
  kset plasmashell "activate task manager entry $n" \
    "Meta+$n,Meta+$n,Activate Task Manager Entry $n"
done
kset plasmashell 'clipboard_action' \
  'Meta+Ctrl+X,Meta+Ctrl+X,Automatic Action Popup Menu'
kset plasmashell 'cycle-panels' \
  'Meta+Alt+P,Meta+Alt+P,Move keyboard focus between panels'
kset plasmashell 'manage activities' \
  'Meta+Q,Meta+Q,Show Activity Switcher'
kset plasmashell 'show dashboard' \
  'Ctrl+F12,Ctrl+F12,Show Desktop'

# Custom application shortcuts.
kset2 services 'org.dotcortex.pclip-default.desktop' '_launch' \
  'none,Meta+V,Speak Clipboard'
kset2 services 'pclip-default.desktop' '_launch' \
  'Meta+V,Meta+V,Speak Clipboard'

# Rofi launcher suite — mirrors the XFCE Virtual Habitat bindings (x11.org) onto
# SonicDE. XFCE Super+{space,x,period,z,w,r} → Meta+{Space,X,.,Z,W,R}. Emoji is on
# Meta+. — the Windows Win+. emoji-panel reflex — because Meta+E is Dolphin (a KDE
# compiled-in default, invisible in this file until overridden) and Meta+B is
# powerdevil's Switch Power Profile; the XFCE side uses Super+. to match. Dual-entry
# per launcher follows the pclip pattern above: the org.dotcortex.* component is
# held at none, the bare basename carries the real accelerator.
kset2 services 'org.dotcortex.rofi-launch.desktop' '_launch' \
  'none,Meta+Space,Rofi Launcher'
kset2 services 'rofi-launch.desktop' '_launch' \
  'Meta+Space,Meta+Space,Rofi Launcher'
kset2 services 'org.dotcortex.rofi-actions.desktop' '_launch' \
  'none,Meta+X,Rofi Actions'
kset2 services 'rofi-actions.desktop' '_launch' \
  'Meta+X,Meta+X,Rofi Actions'
kset2 services 'org.dotcortex.rofi-emoji-menu.desktop' '_launch' \
  'none,Meta+.,Rofi Emoji'
kset2 services 'rofi-emoji-menu.desktop' '_launch' \
  'Meta+.,Meta+.,Rofi Emoji'
kset2 services 'org.dotcortex.clipmenu-rofi.desktop' '_launch' \
  'none,Meta+Z,Clipboard History'
kset2 services 'clipmenu-rofi.desktop' '_launch' \
  'Meta+Z,Meta+Z,Clipboard History'
kset2 services 'org.dotcortex.rofi-window.desktop' '_launch' \
  'none,Meta+W,Rofi Windows'
kset2 services 'rofi-window.desktop' '_launch' \
  'Meta+W,Meta+W,Rofi Windows'
kset2 services 'org.dotcortex.rofi-run.desktop' '_launch' \
  'none,Meta+R,Rofi Run'
kset2 services 'rofi-run.desktop' '_launch' \
  'Meta+R,Meta+R,Rofi Run'

# Keep KWin Overview off Meta+W so it cannot silently re-grab the accelerator from
# rofi-window. Overview's default IS Meta+W; asserting none makes the rofi binding
# durable across a kglobalaccel reset (same silent-collision class as the xfwm4
# Super+4 bug documented in x11.org).
kset kwin 'Overview' \
  'none,Meta+W,Toggle Overview'

if command -v "$QDBUS" >/dev/null 2>&1; then
  "$QDBUS" org.kde.KWin /KWin org.kde.KWin.reconfigure >/dev/null 2>&1 || true
  "$QDBUS" org.kde.kglobalaccel /MainApplication org.qtproject.Qt.QCoreApplication.quit >/dev/null 2>&1 || true
fi

if [ -x /usr/lib/x86_64-linux-gnu/libexec/kglobalacceld ]; then
  setsid -f env -u LD_PRELOAD /usr/lib/x86_64-linux-gnu/libexec/kglobalacceld >/dev/null 2>&1 || true
fi

printf 'Plasma/SonicDE preferences applied.\n'
