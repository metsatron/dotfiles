#!/usr/bin/env bash
# Declarative XFCE state capture


# [[file:../../../sanctuary-sx.org::*Declarative XFCE state capture][Declarative XFCE state capture:1]]
# Promote the writable sanctuary-sx XFCE desktop into canonical Org source.
set -euo pipefail

usage() {
  cat <<'EOF'
sanctuary-sx-capture - compare or promote live XFCE desktop state

Usage: sanctuary-sx-capture
       sanctuary-sx-capture --apply
       sanctuary-sx-capture -h | --help

Default is read-only: generate a candidate sanctuary-sx-state.org and show its
diff.  --apply requires the SX session to be closed, backs up the old source,
updates the canonical Org snapshot, tangles it, and applies it to the guest.
EOF
}

APPLY=0
case "${1:-}" in
  "") ;;
  --apply) APPLY=1 ;;
  -h|--help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac
(( $# <= 1 )) || { usage >&2; exit 2; }

REPO="${DOTCORTEX_ROOT:-${HOME}/DotCortex}"
GUEST_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/dotcortex/guests/sanctuary-sx/home"
STATE_ORG="${REPO}/sanctuary-sx-state.org"
DECLARED="${REPO}/linux/.config/sanctuary-sx"
XFCONF_SRC="${GUEST_HOME}/.config/xfce4/xfconf/xfce-perchannel-xml"
PANEL_SRC="${GUEST_HOME}/.config/xfce4/panel"
DESKTOP_SRC="${GUEST_HOME}/.config/xfce4/desktop"
BACKUP_ROOT="${XDG_STATE_HOME:-${HOME}/.local/state}/dotcortex/sanctuary-sx-capture"

[[ -d "${GUEST_HOME}" ]] || { echo "sanctuary-sx-capture: guest home missing: ${GUEST_HOME}" >&2; exit 1; }
[[ -d "${XFCONF_SRC}" ]] || { echo "sanctuary-sx-capture: XFCE state missing: ${XFCONF_SRC}" >&2; exit 1; }

sx_session_running() {
  local pid display
  for pid in $(pgrep -x xfce4-session 2>/dev/null || true); do
    display="$(tr '\0' '\n' < "/proc/${pid}/environ" 2>/dev/null | sed -n 's/^DISPLAY=//p' | head -1)"
    [[ "${display}" == ":94" ]] && return 0
  done
  return 1
}

is_excluded_channel() {
  case "$1" in
    xfce4-session.xml|xfce4-notifyd.xml|displays.xml|xfce4-power-manager.xml|keyboards.xml) return 0 ;;
    *) return 1 ;;
  esac
}

declare -a records=()
declare -a source_files=()

add_text_tree() {
  local root="$1" prefix="$2" path rel
  [[ -d "${root}" ]] || return 0
  while IFS= read -r -d '' path; do
    rel="${prefix}/${path#${root}/}"
    [[ "${rel}" != *$'\t'* && "${rel}" != *'..'* ]] || { echo "unsafe path: ${rel}" >&2; exit 1; }
    records+=("text"$'\t'"${rel}"$'\t'"${path}")
    source_files+=("${path}")
  done < <(find "${root}" -type f -print0 | sort -z)
}

while IFS= read -r -d '' path; do
  base="$(basename "${path}")"
  is_excluded_channel "${base}" && continue
  records+=("text"$'\t'"xfconf/${base}"$'\t'"${path}")
  source_files+=("${path}")
done < <(find -L "${XFCONF_SRC}" -maxdepth 1 -type f -name '*.xml' -print0 | sort -z)

add_text_tree "${PANEL_SRC}" panel
add_text_tree "${DESKTOP_SRC}" desktop

for asset in "${GUEST_HOME}"/Pictures/*; do
  [[ -f "${asset}" ]] || continue
  case "${asset,,}" in *.png|*.jpg|*.jpeg|*.svg|*.xpm) ;; *) continue ;; esac
  if grep -Fq -- "${asset}" "${source_files[@]}"; then
    rel="Pictures/$(basename "${asset}")"
    records+=("asset"$'\t'"${rel}"$'\t'"${asset}")
  fi
done

mapfile -t records < <(printf '%s\n' "${records[@]}" | LC_ALL=C sort -t $'\t' -k2,2)

tmp_dir="$(mktemp -d)"
trap 'rm -rf -- "${tmp_dir}"' EXIT
candidate="${tmp_dir}/sanctuary-sx-state.org"
new_manifest="${tmp_dir}/state.manifest"

normalize_text() {
  local rel="$1" src="$2"
  case "${rel}" in
    panel/*.desktop)
      sed -E \
        -e 's#^(Exec=)/gnu/store/[^/]+/bin/#\1#' \
        -e '/^X-XFCE-Source=file:\/\/\/gnu\/store\//d' \
        "${src}"
      ;;
    *) cat "${src}" ;;
  esac
}

validate_text() {
  local rel="$1" src="$2" mime
  mime="$(file -b --mime-type "${src}")"
  case "${mime}" in text/*|application/xml|application/x-desktop|application/x-yaml|inode/x-empty) ;; *)
    echo "sanctuary-sx-capture: refusing non-text config ${rel} (${mime})" >&2; exit 1 ;;
  esac
  if rg -n '^#\+END_SRC[[:space:]]*$' "${src}" >/dev/null; then
    echo "sanctuary-sx-capture: Org terminator found in ${rel}" >&2; exit 1
  fi
  if rg -ni '(api[_-]?key|access[_-]?token|bearer[[:space:]]+[A-Za-z0-9]|BEGIN [A-Z ]*PRIVATE KEY)' "${src}" >/dev/null; then
    echo "sanctuary-sx-capture: secret-like content found in ${rel}" >&2; exit 1
  fi
  if rg -n '(^|[^0-9])([0-9]{1,3}\.){3}[0-9]{1,3}([^0-9]|$)' "${src}" >/dev/null; then
    echo "sanctuary-sx-capture: network address found in ${rel}" >&2; exit 1
  fi
}

org_lang() {
  case "$1" in *.xml) echo xml ;; *) echo conf ;; esac
}

{
  sed 's/^|//' <<'EOF'
|#+TITLE: sanctuary-sx — Captured XFCE Desktop State
|#+DESCRIPTION: Machine-generated declarative snapshot of the Godzilla XS-86000 XFCE desktop
|#+PROPERTY: header-args :mkdirp yes :results silent
|
|* Captured desktop state
|
|This file is generated by =sanctuary-sx-capture --apply=.  Shape the desktop
|inside =sanctuary-sx=, close the sanctuary, review =sanctuary-sx-capture=, and
|then promote the live state into this canonical Org source.  Do not edit the
|tangled files under =linux/.config/sanctuary-sx/= directly.
|
|** State manifest
|
EOF

  printf '%s\n' '#+BEGIN_SRC text :tangle linux/.config/sanctuary-sx/state.manifest :comments no :mkdirp yes'

  for record in "${records[@]}"; do
    IFS=$'\t' read -r kind rel src <<< "${record}"
    if [[ "${kind}" == text ]]; then
      printf 'text\t%s\t%s\n' "${rel}" "${rel}"
    else
      printf 'asset\t%s\tassets-base64/%s.b64\n' "${rel}" "${rel}"
    fi
  done

  printf '%s\n\n' '#+END_SRC'

  for record in "${records[@]}"; do
    IFS=$'\t' read -r kind rel src <<< "${record}"
    printf '** =%s=\n\n' "${rel}"
    if [[ "${kind}" == text ]]; then
      normalized="${tmp_dir}/normalized"
      normalize_text "${rel}" "${src}" > "${normalized}"
      validate_text "${rel}" "${normalized}"
      printf '#+BEGIN_SRC %s :tangle linux/.config/sanctuary-sx/%s :comments no :mkdirp yes\n' "$(org_lang "${rel}")" "${rel}"
      cat "${normalized}"
      [[ "$(tail -c 1 "${normalized}" | od -An -t x1 | tr -d ' ')" == 0a ]] || printf '\n'
    else
      printf '#+BEGIN_SRC text :tangle linux/.config/sanctuary-sx/assets-base64/%s.b64 :comments no :mkdirp yes\n' "${rel}"
      base64 -w 76 "${src}"
    fi
    printf '#+END_SRC\n\n'
  done
} > "${candidate}"

# The block loop separates entries with a blank line; remove only the final
# separator so the generated Org source ends with exactly one newline.
truncate -s -1 "${candidate}"

awk '
  /^#\+BEGIN_SRC text :tangle linux\/\.config\/sanctuary-sx\/state\.manifest / { in_manifest=1; next }
  in_manifest && /^#\+END_SRC/ { exit }
  in_manifest { print }
' "${candidate}" > "${new_manifest}"

set +e
if [[ -f "${STATE_ORG}" ]]; then
  diff -u --label a/sanctuary-sx-state.org --label b/sanctuary-sx-state.org "${STATE_ORG}" "${candidate}"
  diff_status=$?
else
  diff -u --label /dev/null --label b/sanctuary-sx-state.org /dev/null "${candidate}"
  diff_status=$?
fi
set -e

if (( diff_status == 0 )); then
  echo "sanctuary-sx-capture: live desktop matches canonical state"
  exit 0
elif (( diff_status != 1 )); then
  echo "sanctuary-sx-capture: diff failed" >&2
  exit "${diff_status}"
elif (( APPLY == 0 )); then
  echo "sanctuary-sx-capture: live desktop differs; review above, then run --apply"
  exit 1
fi

if sx_session_running; then
  echo "sanctuary-sx-capture: XFCE is still running on :94" >&2
  echo "  Close sanctuary-sx before promoting its state." >&2
  exit 1
fi

while IFS= read -r dirty; do
  case "${dirty}" in
    sanctuary-sx.org|sanctuary-sx-state.org|linux/.config/sanctuary-sx/*|linux/.local/bin/sanctuary-sx-*) ;;
    *) echo "sanctuary-sx-capture: unrelated unstaged path blocks apply: ${dirty}" >&2; exit 1 ;;
  esac
done < <(git -C "${REPO}" diff --name-only)

mkdir -p "${BACKUP_ROOT}"
timestamp="$(date +%Y%m%d-%H%M%S)"
if [[ -f "${STATE_ORG}" ]]; then
  cp -a "${STATE_ORG}" "${BACKUP_ROOT}/sanctuary-sx-state.org.backup-${timestamp}"
  if ! git -C "${REPO}" diff --quiet -- sanctuary-sx-state.org; then
    git -C "${REPO}" add -- sanctuary-sx-state.org
  fi
fi

old_manifest="${tmp_dir}/old.manifest"
[[ -f "${DECLARED}/state.manifest" ]] && cp -a "${DECLARED}/state.manifest" "${old_manifest}"
install -m0644 "${candidate}" "${STATE_ORG}.new"
mv -f "${STATE_ORG}.new" "${STATE_ORG}"
cmp -s "${candidate}" "${STATE_ORG}" || { echo "sanctuary-sx-capture: source verification failed" >&2; exit 1; }

(cd "${REPO}" && "${REPO}/all/.local/bin/tangle-one" sanctuary-sx-state.org)

if [[ -f "${old_manifest}" ]]; then
  awk -F '\t' '$1 == "text" {print $3} $1 == "asset" {print $3}' "${old_manifest}" | LC_ALL=C sort > "${tmp_dir}/old.outputs"
  awk -F '\t' '$1 == "text" {print $3} $1 == "asset" {print $3}' "${new_manifest}" | LC_ALL=C sort > "${tmp_dir}/new.outputs"
  while IFS= read -r stale; do
    case "${stale}" in xfconf/*|panel/*|desktop/*|assets-base64/*) rm -f -- "${DECLARED}/${stale}" ;; esac
  done < <(comm -23 "${tmp_dir}/old.outputs" "${tmp_dir}/new.outputs")
fi

"${REPO}/linux/.local/bin/sanctuary-sx-config-apply" --force

echo "sanctuary-sx-capture: canonical desktop state updated"
echo "  source backup: ${BACKUP_ROOT}/sanctuary-sx-state.org.backup-${timestamp}"
echo "  review: git diff -- sanctuary-sx-state.org linux/.config/sanctuary-sx/"
# Declarative XFCE state capture:1 ends here
