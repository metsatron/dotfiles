#!/usr/bin/env bash
# [[file:../../../distrobox.org::*Sanctuary Launcher Scripts][Sanctuary Launcher Scripts:5]]
# Launch sanctuary-cde: Xephyr :92 + CDE inside the Guix container.
# Launch from the host desktop; Xephyr does not need a workspace hop.
# Escape: Super+1 / Ctrl+F1 works while Xephyr has focus (-no-host-grab).
# Host-side exit: sanctuary-cde-stop (from any terminal, tmux, or SSH).
# Clipboard: cde-copy-to-host exports CDE selection to host; bridge auto-runs.
# Prerequisite: run sanctuary-cde-build to compile CDE 2.5.3 first.
set -euo pipefail

DISPLAY_NUM=":92"
SANCTUARY="sanctuary-cde"
GUIX_PROFILES="${HOME}/.guix-extra-profiles"
DOTCORTEX_RUN="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/dotcortex"
STATE_FILE="${DOTCORTEX_RUN}/sanctuary-cde.pid"
HOST_DISPLAY="${DISPLAY}"   # capture before DISPLAY is changed by exec chains

XEPHYR_PID=0
BRIDGE_PID=0

_cde_cleanup() {
    [[ "${XEPHYR_PID}" -gt 0 ]] && kill "${XEPHYR_PID}" 2>/dev/null || true
    [[ "${BRIDGE_PID}" -gt 0 ]]  && kill "${BRIDGE_PID}"  2>/dev/null || true
    rm -f "${STATE_FILE}"
}
trap _cde_cleanup EXIT

mkdir -p "${DOTCORTEX_RUN}"

# -no-host-grab: Xephyr does not grab host keyboard/mouse, so host workspace
# shortcuts (Super+1/Ctrl+F1) reach XFWM4 even when the nested display has focus.
Xephyr "${DISPLAY_NUM}" -fullscreen -br -ac -no-host-grab &
XEPHYR_PID=$!
printf 'PID=%s\nDISPLAY=%s\n' "${XEPHYR_PID}" "${DISPLAY_NUM}" > "${STATE_FILE}"

timeout 10 sh -c "until DISPLAY=${DISPLAY_NUM} xdpyinfo >/dev/null 2>&1; do sleep 0.1; done" \
  || { echo "Xephyr ${DISPLAY_NUM} did not become ready"; exit 1; }

echo "${SANCTUARY}: Xephyr ${DISPLAY_NUM} ready — adding CDE fonts and starting CDE…"
CDE_HOME="${HOME}/.local/share/dotcortex/guests/sanctuary-cde/home/.local/share/cde"
DISPLAY="${DISPLAY_NUM}" xset fp+ "${CDE_HOME}/etc/cde/fontaliases"
DISPLAY="${DISPLAY_NUM}" xset fp+ "${CDE_HOME}/share/cde/fontaliases"
DISPLAY="${DISPLAY_NUM}" xset fp rehash

# Clipboard bridge: forward CDE :92 PRIMARY to host CLIPBOARD (one-way).
# Requires xclip in desktop-common profile.
cde-clipboard-bridge "${HOST_DISPLAY}" "${DISPLAY_NUM}" &
BRIDGE_PID=$!

DISPLAY="${DISPLAY_NUM}" sanctuary-exec "${SANCTUARY}" sh -c "
  GUIX_PROFILE=${GUIX_PROFILES}/desktop-common/desktop-common
  . \${GUIX_PROFILE}/etc/profile
  GUIX_PROFILE=${GUIX_PROFILES}/sanctuary-cde/sanctuary-cde
  . \${GUIX_PROFILE}/etc/profile
  export PATH=\${PATH}:/usr/bin:/bin
  export DTSPSYSAPPHOSTS=\${HOME}/.local/share/cde/appconfig
  export TTPATH=\${HOME}/.local/share/cde/appconfig/tttypes
  export DTINFOLIB=\${HOME}/.local/share/cde/infolib
  exec \${HOME}/.local/share/cde/bin/Xsession
"
# Sanctuary Launcher Scripts:5 ends here
