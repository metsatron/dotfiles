#!/usr/bin/env bash
# [[file:../../../distrobox.org::*Sanctuary Launcher Scripts][Sanctuary Launcher Scripts:5]]
# Launch sanctuary-cde: Xephyr :92 + CDE inside the Guix container.
# Switch to Desktop 4 (Super+4) first.
# Prerequisite: run sanctuary-cde-build to compile CDE 2.5.3 first.
set -euo pipefail

DISPLAY_NUM=":92"
SANCTUARY="sanctuary-cde"
GUIX_PROFILES="${HOME}/.guix-extra-profiles"

Xephyr "${DISPLAY_NUM}" -fullscreen -br -ac &
XEPHYR_PID=$!

timeout 10 sh -c "until DISPLAY=${DISPLAY_NUM} xdpyinfo >/dev/null 2>&1; do sleep 0.1; done" \
  || { echo "Xephyr ${DISPLAY_NUM} did not become ready"; kill "${XEPHYR_PID}"; exit 1; }

echo "${SANCTUARY}: Xephyr ${DISPLAY_NUM} ready — sourcing Guix profiles and starting CDE…"
DISPLAY="${DISPLAY_NUM}" sanctuary-exec "${SANCTUARY}" sh -c "
  GUIX_PROFILE=${GUIX_PROFILES}/desktop-common/desktop-common
  . \${GUIX_PROFILE}/etc/profile
  GUIX_PROFILE=${GUIX_PROFILES}/sanctuary-cde/sanctuary-cde
  . \${GUIX_PROFILE}/etc/profile
  exec \${HOME}/.local/share/cde/bin/Xsession
"

kill "${XEPHYR_PID}" 2>/dev/null || true
# Sanctuary Launcher Scripts:5 ends here
