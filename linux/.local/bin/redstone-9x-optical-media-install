#!/usr/bin/env bash
# [[file:../../../sanctuary-redstone-9x-fvwm95.org::*Dynamic menus — recent Documents + Desktop folder][Dynamic menus — recent Documents + Desktop folder:29]]
set -Eeuo pipefail

RULE_NAME="60-redstone-9x-optical-media.rules"
RULE_SOURCE="${HOME}/.local/share/polkit-1/rules.d/${RULE_NAME}"
MEDIA_USER="${REDSTONE_MEDIA_USER:-${SUDO_USER:-$(id -un)}}"
MEDIA_ROOT="${REDSTONE_MEDIA_HOST_ROOT:-/run/media/${MEDIA_USER}}"
MEDIA_UDISKS_ROOT="${REDSTONE_MEDIA_UDISKS_ROOT:-/media/${MEDIA_USER}}"

usage() {
  cat <<'EOF'
redstone-9x-optical-media-install - prepare the host optical-media broker

Usage:
  redstone-9x-optical-media-install          install the polkit rule and root propagation
  redstone-9x-optical-media-install --check inspect the current host gate without changing it
EOF
}

check_gate() {
  local propagation
  command -v udisksctl >/dev/null 2>&1 || echo "MISSING udisksctl"
  [[ -f "${RULE_SOURCE}" ]] && echo "OK rule source: ${RULE_SOURCE}" || echo "MISSING rule source: ${RULE_SOURCE}"
  if [[ -d "${MEDIA_ROOT}" ]]; then
    propagation="$(findmnt --noheadings --output PROPAGATION --target "${MEDIA_ROOT}" 2>/dev/null || true)"
    echo "media root: ${MEDIA_ROOT} (${propagation:-not-mounted})"
  else
    echo "MISSING media root: ${MEDIA_ROOT}"
  fi
  if [[ -d "${MEDIA_UDISKS_ROOT}" ]]; then
    propagation="$(findmnt --noheadings --output PROPAGATION --target "${MEDIA_UDISKS_ROOT}" 2>/dev/null || true)"
    echo "UDisks root: ${MEDIA_UDISKS_ROOT} (${propagation:-not-mounted})"
  else
    echo "MISSING UDisks root: ${MEDIA_UDISKS_ROOT}"
  fi
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi
if [[ "${1:-}" == "--check" ]]; then
  check_gate
  exit 0
fi
(( $# == 0 )) || { usage >&2; exit 2; }

if (( EUID != 0 )); then
  exec sudo -- "$0"
fi

TARGET_HOME="$(getent passwd "${MEDIA_USER}" | cut -d: -f6)"
[[ -n "${TARGET_HOME}" ]] || { echo "unknown media user: ${MEDIA_USER}" >&2; exit 1; }
RULE_SOURCE="${TARGET_HOME}/.local/share/polkit-1/rules.d/${RULE_NAME}"
[[ -f "${RULE_SOURCE}" ]] || { echo "rule source is not stowed: ${RULE_SOURCE}" >&2; exit 1; }

install -d -m 0755 /etc/polkit-1/rules.d
rule_tmp="$(mktemp)"
trap 'rm -f "${rule_tmp}"' EXIT
sed "s/@REDSTONE_MEDIA_USER@/${MEDIA_USER}/g" "${RULE_SOURCE}" > "${rule_tmp}"
install -o root -g root -m 0644 "${rule_tmp}" "/etc/polkit-1/rules.d/${RULE_NAME}"

MEDIA_GROUP="$(id -gn "${MEDIA_USER}")"
install -d -m 0755 -o "${MEDIA_USER}" -g "${MEDIA_GROUP}" "${MEDIA_ROOT}"
if ! findmnt --mountpoint "${MEDIA_ROOT}" >/dev/null 2>&1; then
  mount --bind "${MEDIA_ROOT}" "${MEDIA_ROOT}"
fi
mount --make-shared "${MEDIA_ROOT}"

install -d -m 0755 "${MEDIA_UDISKS_ROOT}"
if [[ "${MEDIA_UDISKS_ROOT}" != "${MEDIA_ROOT}" ]] && ! findmnt --mountpoint "${MEDIA_UDISKS_ROOT}" >/dev/null 2>&1; then
  mount --bind "${MEDIA_ROOT}" "${MEDIA_UDISKS_ROOT}"
fi
if [[ "${MEDIA_UDISKS_ROOT}" != "${MEDIA_ROOT}" ]]; then
  mount --make-shared "${MEDIA_UDISKS_ROOT}"
fi

propagation="$(findmnt --noheadings --output PROPAGATION --mountpoint "${MEDIA_ROOT}")"
case "${propagation}" in
  shared*|*+shared*|*shared+*) ;;
  *) echo "media root is not shared after setup: ${propagation}" >&2; exit 1 ;;
esac
udisks_propagation="$(findmnt --noheadings --output PROPAGATION --mountpoint "${MEDIA_UDISKS_ROOT}")"
case "${udisks_propagation}" in
  shared*|*+shared*|*shared+*) ;;
  *) echo "UDisks media root is not shared after setup: ${udisks_propagation}" >&2; exit 1 ;;
esac
echo "installed ${RULE_NAME} for ${MEDIA_USER}"
echo "prepared ${MEDIA_ROOT} (${propagation})"
echo "prepared UDisks alias ${MEDIA_UDISKS_ROOT} (${udisks_propagation})"
echo "next: recreate sanctuary-redstone-9x with the declared rslave media bind"
# Dynamic menus — recent Documents + Desktop folder:29 ends here
