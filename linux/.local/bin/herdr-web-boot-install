#!/usr/bin/env bash
# Herdr web boot owner — Linux fleet

# Herdr is communication substrate, not a desktop accessory.  The existing XDG
# autostart remains a login-time fallback, but the canonical owner is a
# login-independent cron launch plus a three-minute self-heal.  The
# =herdr-web-tailnet --autostart= supervisor holds an exclusive lock, so cron,
# desktop login, and manual recovery can meet without producing duplicate
# daemons or bridges.


# [[file:../../../services.org::*Herdr web boot owner — Linux fleet][Herdr web boot owner — Linux fleet:1]]
set -euo pipefail

TAG="dotcortex-herdr-web-boot"
DEFAULT_TARGET="/etc/cron.d/dotcortex-herdr-web"
target="${HERDR_WEB_BOOT_CRON_TARGET:-$DEFAULT_TARGET}"
target_home="${HERDR_WEB_BOOT_HOME:-$HOME}"
user_name="${HERDR_WEB_BOOT_USER:-$(id -un)}"
user_id="${HERDR_WEB_BOOT_UID:-$(id -u)}"
launcher="$target_home/.local/bin/herdr-web-tailnet"
state_dir="$target_home/.local/state/herdr-web"
core_bin="$target_home/.guix-extra-profiles/core/core/bin"
cron_path="$core_bin:$target_home/.local/bin:/usr/local/bin:/usr/bin:/bin"

usage() {
  cat <<'EOF'
Usage: herdr-web-boot-install [--dry-run|--check|--help]

Install the login-independent Herdr daemon + tailnet web bridge owner.
The managed cron contract starts at boot and retries every three minutes;
the launcher's exclusive lock keeps the operation singleton.
EOF
}

case "${1:-}" in
  --help|-h) usage; exit 0 ;;
  --dry-run|'') ;;
  --check) ;;
  *) usage >&2; exit 2 ;;
esac

[ -x "$launcher" ] || {
  printf '%s: missing launcher: %s\n' "$TAG" "$launcher" >&2
  exit 1
}
case "$target_home:$user_name:$user_id" in
  *[[:space:]]*) printf '%s: whitespace is not valid in cron identity fields\n' "$TAG" >&2; exit 2 ;;
esac

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
cat >"$tmp" <<EOF
# DotCortex login-independent Herdr owner; managed by $TAG.
SHELL=/bin/sh
@reboot $user_name HOME=$target_home PATH=$cron_path $launcher --autostart
*/3 * * * * $user_name HOME=$target_home PATH=$cron_path $launcher --autostart
EOF

if [ "${1:-}" = "--dry-run" ]; then
  cat "$tmp"
  exit 0
fi
if [ "${1:-}" = "--check" ]; then
  cmp -s "$tmp" "$target" || {
    printf '%s: drift or missing target: %s\n' "$TAG" "$target" >&2
    exit 1
  }
  printf '%s: installed contract matches %s\n' "$TAG" "$target"
  exit 0
fi

mkdir -p "$state_dir"
if [ "$target" = "$DEFAULT_TARGET" ]; then
  sudo -n install -m 0644 "$tmp" "$target"
else
  install -m 0644 "$tmp" "$target"
fi
printf '%s: installed %s\n' "$TAG" "$target"
# Herdr web boot owner — Linux fleet:1 ends here
