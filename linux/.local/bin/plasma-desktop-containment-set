#!/usr/bin/env bash
set -euo pipefail

QDBUS="${QDBUS:-qdbus6}"

usage() {
  cat >&2 <<'EOF'
usage: plasma-desktop-containment-set KEY VALUE

Writes KEY=VALUE to all org.kde.plasma.folder desktop containments, then calls
reloadConfig(). VALUE is parsed as bool, integer, float, or string.
EOF
  exit "${1:-1}"
}

[ "${1:-}" ] || usage
[ "${2:-}" ] || usage

KEY="$1"
VALUE="$2"
KEY_JSON="$(python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$KEY")"
VALUE_JSON="$(python3 -c '
import json, sys
s = sys.argv[1]
low = s.lower()
if low in ("true", "false"):
    v = low == "true"
else:
    try:
        v = int(s)
    except ValueError:
        try:
            v = float(s)
        except ValueError:
            v = s
print(json.dumps(v))
' "$VALUE")"

run_plasma_script() {
  local script="$1"
  local pid
  pid="$(pgrep -x plasmashell | head -1 || true)"
  if [ -n "$pid" ] && [ -r "/proc/$pid/environ" ]; then
    bash -c 'mapfile -d "" -t E < "/proc/$1/environ"; shift; exec env -i "${E[@]}" "$@"' \
      _ "$pid" "$QDBUS" org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "$script"
  else
    "$QDBUS" org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "$script"
  fi
}

run_plasma_script "
var key = $KEY_JSON;
var value = $VALUE_JSON;
var out = [];
desktops().forEach(function (desktop) {
  if (desktop.readConfig('plugin') !== 'org.kde.plasma.folder') {
    return;
  }
  desktop.currentConfigGroup = ['General'];
  var before = desktop.readConfig(key);
  desktop.writeConfig(key, value);
  desktop.reloadConfig();
  out.push({
    id: desktop.id,
    screen: desktop.screen,
    activity: desktop.activity,
    key: key,
    before: before,
    after: desktop.readConfig(key)
  });
});
print(JSON.stringify(out, null, 2));
"
