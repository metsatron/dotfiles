#!/usr/bin/env bash
# [[file:../../../sanctuary-distrobox.org::*Sanctuary Launcher Scripts][Sanctuary Launcher Scripts:7]]
# sanctuary-xephyr-output — resolve the one host RandR output used by every
# sanctuary. Explicit overrides win; otherwise prefer a built-in laptop panel,
# then a landscape primary, then a landscape output, then the primary, and only
# use portrait when no safer output exists.
set -euo pipefail

host_display="${1:-${DISPLAY:-}}"
[[ -n "${host_display}" ]] || exit 1
command -v xrandr >/dev/null 2>&1 || exit 1
xrandr_output="$(DISPLAY="${host_display}" xrandr --query 2>/dev/null || true)"
[[ -n "${xrandr_output}" ]] || exit 1

override="${SANCTUARY_XEPHYR_OUTPUT:-}"
if [[ -n "${override}" ]]; then
  if ! printf '%s\n' "${xrandr_output}" | awk -v output="${override}" '$1 == output && $2 == "connected" { found = 1 } END { exit(found ? 0 : 1) }'; then
    echo "sanctuary-xephyr-output: requested output is not connected: ${override}" >&2
    exit 2
  fi
  printf '%s\n' "${override}"
  exit 0
fi

printf '%s\n' "${xrandr_output}" | awk '
  $2 != "connected" { next }
  {
    name = $1
    primary = ($3 == "primary")
    geometry = (primary ? $4 : $3)
    split(geometry, dimensions, "x")
    width = dimensions[1]
    height = dimensions[2]
    sub(/[+-].*$/, "", height)
    if (width !~ /^[0-9]+$/ || height !~ /^[0-9]+$/) next
    internal = (name ~ /^(eDP|LVDS|DSI)-/)
    if (internal && internal_output == "") internal_output = name
    if (width >= height && primary && primary_landscape == "") primary_landscape = name
    if (width >= height && landscape == "") landscape = name
    if (primary && primary_output == "") primary_output = name
    if (any == "") any = name
  }
  END {
    if (internal_output != "") print internal_output
    else if (primary_landscape != "") print primary_landscape
    else if (landscape != "") print landscape
    else if (primary_output != "") print primary_output
    else if (any != "") print any
    else exit 1
  }
'
# Sanctuary Launcher Scripts:7 ends here
