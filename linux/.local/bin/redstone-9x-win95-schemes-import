#!/bin/bash
# redstone-9x-win95-schemes-import [shell2.inf]
# Decode Windows 95 Appearance scheme blobs -> .theme files -> theme-convert.
set -euo pipefail
INF="${1:-${HOME}/HelmCortex/NEXUS/sanctuaries/sanctuary-redstone-9x/themes/win95-schemes/shell2.inf}"
[[ -f "${INF}" ]] || { echo "ERROR: ${INF} missing — NEXUS source archive not reachable" >&2; exit 1; }
TMP="$(mktemp -d)"; trap 'rm -rf "${TMP}"' EXIT
python3 - "${INF}" "${TMP}" <<'PYW95'
import sys, re, os
inf, out = sys.argv[1], sys.argv[2]
text = open(inf, encoding='latin-1').read()
# Curated set: token -> display name. Large (_L/_EL beyond Pumpkin), contrast
# and OSR1-leftover schemes intentionally absent.
CURATED = {
    'BRICK_256': 'Brick', 'DESERT_256': 'Desert', 'EGGPLANT_256': 'Eggplant',
    'LILAC_256': 'Lilac', 'MAPLE_256': 'Maple', 'MARINE_HC': 'Marine',
    'PLUM_HC': 'Plum', 'PUMPKIN_EL_256': 'Pumpkin', 'RAINY_DAY_256': 'Rainy Day',
    'ROSE_256': 'Rose', 'SLATE': 'Slate', 'SPRUCE_256': 'Spruce',
    'STARS_STRIPES_16': 'Red White and Blue', 'STORM_16': 'Storm',
    'TEAL_16': 'Teal', 'WHEAT_256': 'Wheat',
}
# SYSCOLOR index order of the 25 trailing COLORREF dwords.
KEYS = ['Scrollbar', 'Background', 'ActiveTitle', 'InactiveTitle', 'Menu',
        'Window', 'WindowFrame', 'MenuText', 'WindowText', 'TitleText',
        'ActiveBorder', 'InactiveBorder', 'AppWorkspace', 'Hilight',
        'HilightText', 'ButtonFace', 'ButtonShadow', 'GrayText', 'ButtonText',
        'InactiveTitleText', 'ButtonHilight', 'ButtonDkShadow', 'ButtonLight',
        'InfoText', 'InfoWindow']
entries = {}
pat = re.compile(r'HKCU,"Control Panel\\Appearance\\Schemes",%([A-Z0-9_]+)%,1,\\\n((?:[ \t]*[0-9a-fA-F, \t]+,?\\?\n)+)')
for m in pat.finditer(text):
    token, body = m.group(1), m.group(2)
    hexbytes = re.findall(r'[0-9a-fA-F]{2}', body)
    entries[token] = bytes(int(h, 16) for h in hexbytes)
made = []
for token, name in sorted(CURATED.items()):
    blob = entries.get(token)
    if blob is None:
        print(f"SKIP {token}: no blob in {os.path.basename(inf)}", file=sys.stderr)
        continue
    if len(blob) < 100:
        raise SystemExit(f"FATAL {token}: blob too short ({len(blob)} bytes)")
    tail = blob[-100:]
    colors = [(tail[i], tail[i+1], tail[i+2]) for i in range(0, 100, 4)]
    flags = [tail[i+3] for i in range(0, 100, 4)]
    if sum(1 for f in flags if f in (0, 2)) < 20:
        raise SystemExit(f"FATAL {token}: colour-array flags look wrong: {flags}")
    slug = name.lower().replace(' ', '-').replace("'", '')
    path = os.path.join(out, slug + '.theme')
    with open(path, 'w') as f:
        f.write('[Control Panel\\Colors]\n')
        for k, (r, g, b) in zip(KEYS, colors):
            f.write(f'{k}={r} {g} {b}\n')
    made.append((path, name, 'w95-' + slug))
with open(os.path.join(out, 'manifest.tsv'), 'w') as f:
    for path, name, sid in made:
        f.write(f'{path}\tWin95 {name}\t{sid}\n')
print(f"decoded {len(made)} schemes from {os.path.basename(inf)}")
PYW95
while IFS=$'\t' read -r path tname sid; do
  echo "== ${sid}"
  FLAT_TITLE=1 REDSTONE_ICON_THEME=Chicago95 redstone-9x-theme-convert "${path}" "${tname}" "${sid}"
done < "${TMP}/manifest.tsv"
echo "win95 default schemes imported"
