#!/bin/bash
# redstone-9x-cde-convert [--kde98] <palette.dp> <Name> <slug> <backdrop.bm> [outroot]
#   --kde98: widget-only flavor. Emits ONLY the GTK widget theme (proven cdetheme
#            engine + our Motif shading, recoloured to the palette), named <Name>
#            with NO "CDE-" prefix, NO CDE Motif IceWM chrome, NO backdrop/scheme.
#            For the KDE dynasty (Motif/CDE widgets under Win9x window frames):
#            the hand-authored kde-* scheme pairs this theme with Win95 frames and
#            Win95 fonts. Default (no flag) path is unchanged. backdrop optional.
set -euo pipefail
KDE98=0
if [[ "${1:-}" == "--kde98" ]]; then KDE98=1; shift; fi
DP="${1:?path to .dp palette}"; NAME="${2:?display name}"; SLUG="${3:?scheme slug (cdep-<slug>)}"
if [[ "${KDE98}" == "1" ]]; then BACKDROP="${4:-}"; else BACKDROP="${4:?path to .bm backdrop}"; fi
OUTROOT="${5:-${HOME}/DotCortex}"
python3 - "${KDE98}" "${DP}" "${NAME}" "${SLUG}" "${BACKDROP}" "${OUTROOT}" <<'PYCDE'
import sys, os, re, shutil, colorsys

KDE98 = sys.argv[1] == "1"
DP, NAME, SLUG, BACKDROP, OUTROOT = sys.argv[2:7]
DOTCORTEX = os.path.expanduser("~/DotCortex")
# Window chrome (title/frame/glyph Motif pixmaps) come from nIceCDE; the TASKBAR
# comes from Windows-98-Plus. nIceCDE's taskbar tiles the app-button pixmap into
# a repeating grid (an IceWM quirk we could not defeat, 2026-07-20), while the
# Windows-98-Plus taskbar renders the same style of button bevel stretched and
# clean. So the CDE theme is BUILT ON the Windows taskbar base with the CDE
# Motif chrome grafted on and everything recoloured to the palette.
CDE_CHROME = f"{DOTCORTEX}/linux/.icewm/themes/nIceCDE.Default"
WIN_ICEWM = f"{DOTCORTEX}/linux/.icewm/themes/Windows-98-Plus"
CDE_LOGO = f"{DOTCORTEX}/linux/.icewm/cde-assets/cde-start.png"
GTK_SRC = f"{DOTCORTEX}/linux/.themes/cdetheme"

def hx(c):
    return '#%02x%02x%02x' % tuple(max(0, min(255, round(v))) for v in c)

def unhex(h):
    h = h.lstrip('#')
    return tuple(int(h[i:i+2], 16) for i in (0, 2, 4))

def lum(c):
    return 0.299 * c[0] + 0.587 * c[1] + 0.114 * c[2]

def hsv(c):
    r, g, b = (v / 255.0 for v in c)
    h, s, v = colorsys.rgb_to_hsv(r, g, b)
    return h * 360.0, s, v

def contrast(bar_rgb):
    return (0, 0, 0) if lum(bar_rgb) >= 128 else (255, 255, 255)

def blend_white(c, f):
    return tuple(x + (255 - x) * f for x in c)

def blend_black(c, f):
    return tuple(x * (1 - f) for x in c)

def parse_dp(path):
    sets = []
    with open(path, encoding='latin-1') as f:
        for line in f:
            line = line.strip()
            if not line.startswith('#'):
                continue
            h = line.lstrip('#')
            groups = [h[i:i+4] for i in (0, 4, 8)]
            rgb = tuple(int(g, 16) >> 8 for g in groups)
            sets.append(rgb)
    if len(sets) != 8:
        raise ValueError(f"{path}: expected 8 sets, got {len(sets)}")
    return sets

def scale_to(rgb, target, ref):
    """Reproduce this pixel's tonal position relative to its file's own
    reference tone (blend toward white for highlights, toward black for
    shadows) on the new target anchor -- not a multiplicative luminance
    ratio, which clamps/blows out highlights and drifts hue at extremes
    (rejected at the mandatory ground-truth gate, 2026-07-20)."""
    lp, lr = lum(rgb), lum(ref)
    if abs(lp - lr) < 1e-6:
        return tuple(round(c) for c in target)
    if lp > lr:
        frac = (lp - lr) / max(1e-6, 255 - lr)
        out = blend_white(target, frac)
    else:
        frac = (lr - lp) / max(1e-6, lr)
        out = blend_black(target, frac)
    return tuple(max(0, min(255, round(c))) for c in out)

def classify_family(rgb, base1, base2, hue_band=22.0, sat_neutral=0.06):
    h, s, v = hsv(rgb)
    if s < sat_neutral:
        return None
    h1, _, _ = hsv(base1)
    h2, _, _ = hsv(base2)
    def hd(a, b):
        d = abs(a - b) % 360
        return min(d, 360 - d)
    d1, d2 = hd(h, h1), hd(h, h2)
    if min(d1, d2) > hue_band:
        return None
    return 1 if d1 <= d2 else 2

ACTIVE_PREFIX_RE = re.compile(r'^(title|frame|dframe|close|maximize|minimize|menuButton|restore|rolldown|rollup)(A|I)')

def file_family(basename):
    m = ACTIVE_PREFIX_RE.match(basename)
    if m:
        return 1 if m.group(2) == 'A' else 2
    if basename == 'menusel':
        return 1
    if basename == 'menusep':
        return 2
    return 2

def recolor_xpm_to(path, target):
    """Luminance-transfer recolour an xpm toward one explicit anchor
    (the same math as recolor_xpm, but the family/target is forced by the
    caller rather than inferred from the filename -- used for the cloned
    task-button pixmaps, whose names carry no A/I family cue)."""
    text = open(path, encoding='latin-1').read()
    colors = re.findall(r'c\s+(#[0-9A-Fa-f]{6})', text)
    uniq = sorted(set(colors), key=lambda h: lum(unhex(h)))
    if not uniq:
        return
    ref = unhex(uniq[len(uniq) // 2])
    mapping = {h: hx(scale_to(unhex(h), target, ref)) for h in uniq}
    for old, new in mapping.items():
        text = re.sub(re.escape(old), new, text, flags=re.I)
    open(path, 'w', encoding='latin-1').write(text)

def recolor_xpm(path, set1, set2):
    base = os.path.basename(path)[:-4]
    target = set1 if file_family(base) == 1 else set2
    recolor_xpm_to(path, target)

def recolor_default_theme(path, set1, set2, set8, bg_theme_path):
    """`path` is the Windows-98-Plus default.theme (copied into the CDE theme).
    Append a CDE Motif override block so it wins (IceWM keeps the last value of
    a key): CDE title/frame geometry, palette title/frame/menu/taskbar colours,
    and serif taskbar fonts. Windows' taskbar geometry -- which renders the
    app-button bevel STRETCHED and clean rather than tiled -- is left intact, so
    the task buttons keep working while the rest reads as CDE."""
    text = open(path, encoding='latin-1').read()
    at, af = hx(set1), hx(set2)                        # active / face
    atx, afx = hx(contrast(set1)), hx(contrast(set2))  # legible text on each
    inact = hx(tuple(c * 0.62 for c in set2))          # muted inactive titlebar
    bg = hx(set8)
    ov = f'''

# ==== CDE Motif chrome grafted over the Windows-98-Plus taskbar base ====
# Base swapped from nIceCDE (2026-07-20): nIceCDE's taskbar TILES the app-button
# pixmap into a repeating grid; the Windows base renders it clean. Window chrome
# + palette + serif fonts below restore the CDE look. Taskbar geometry untouched.
Look="flat"
TitleBarHeight=24
TitleBarJustify=50
BorderSizeX=6
BorderSizeY=6
DlgBorderSizeX=6
DlgBorderSizeY=6
TitleButtonsLeft="s"
TitleButtonsRight="mi"
TitleButtonsSupported="xmirs"
Gradients="menusel.xpm"
ColorActiveTitleBar="{at}"
ColorNormalTitleBar="{inact}"
ColorActiveTitleBarText="{atx}"
ColorNormalTitleBarText="{afx}"
ColorActiveBorder="{af}"
ColorNormalBorder="{af}"
ColorNormalButton="{af}"
ColorActiveButton="{at}"
ColorNormalButtonText="{afx}"
ColorActiveButtonText="{atx}"
ColorNormalMenu="{af}"
ColorActiveMenuItem="{at}"
ColorNormalMenuItemText="{afx}"
ColorActiveMenuItemText="{atx}"
ColorDefaultTaskBar="{af}"
ColorNormalTaskBarApp="{af}"
ColorActiveTaskBarApp="{at}"
ColorNormalTaskBarAppText="{afx}"
ColorActiveTaskBarAppText="{atx}"
ColorMinimizedTaskBarApp="{af}"
ColorMinimizedTaskBarAppText="{afx}"
ColorClock="{af}"
ColorClockText="{afx}"
TitleFontNameXft="serif:size=10:bold"
MenuFontNameXft="serif:size=10"
NormalTaskBarFontNameXft="serif:size=12"
ActiveTaskBarFontNameXft="serif:size=12:bold"
ClockFontNameXft="serif:size=11"
DesktopBackgroundColor="{bg}"
'''
    # NOTE: no DesktopBackgroundImage here on purpose. pcmanfm --desktop is the
    # sole desktop-background owner (see .icewm/startup). If IceWM also owns a
    # root PIXMAP via DesktopBackgroundImage, the two race on _XROOTPMAP_ID and
    # pcmanfm crashes with a RENDER BadDrawable, killing all desktop icons for
    # the rest of the session. The CDE backdrop still shows: the cdep scheme's
    # WALLPAPER points pcmanfm at this same rendered PNG. Solid Color only here.
    open(path, 'w', encoding='latin-1').write(text + ov)

def parse_xbm(path):
    text = open(path, encoding='latin-1').read()
    text = re.sub(r'/\*.*?\*/', '', text, flags=re.S)
    w = int(re.search(r'_width\s+(\d+)', text).group(1))
    h = int(re.search(r'_height\s+(\d+)', text).group(1))
    bits = [int(x, 16) for x in re.findall(r'0x([0-9A-Fa-f]{2})', text)]
    return w, h, bits

def render_backdrop(bm_path, out_png, set8):
    from PIL import Image
    w, h, bits = parse_xbm(bm_path)
    fg = tuple(round(c * 0.72) for c in set8)
    img = Image.new('RGB', (w, h), set8)
    px = img.load()
    row_bytes = (w + 7) // 8
    for y in range(h):
        for xb in range(row_bytes):
            idx = y * row_bytes + xb
            if idx >= len(bits):
                continue
            byte = bits[idx]
            for bit in range(8):
                x = xb * 8 + bit
                if x >= w:
                    continue
                if (byte >> bit) & 1:
                    px[x, y] = fg
    # Pre-tile the pattern onto a large canvas. pcmanfm's own wallpaper_mode=
    # "tile" is broken in the sanctuary (it uses the flaky XRender tiling path
    # and paints white — same RENDER fragility that crashed pcmanfm on the
    # IceWM root pixmap). Every other mode renders fine, so we tile in PIL and
    # ship a full image the scheme displays with wallpaper_mode=center: pixel-
    # perfect, no scaling, no border on any sanctuary-sized display.
    CW, CH = 2560, 1600
    canvas = Image.new('RGB', (CW, CH), set8)
    for ty in range(0, CH, h):
        for tx in range(0, CW, w):
            canvas.paste(img, (tx, ty))
    os.makedirs(os.path.dirname(out_png), exist_ok=True)
    canvas.save(out_png)

def pick_kvantum(set2):
    # Decree 2026-07-20: commonalitygris across the whole palette fleet —
    # the grey base never fights any palette's chrome. (The earlier hue rule
    # picked sienna/Commonality by set2 warmth; superseded.)
    return 'commonalitygris'

GTK_FAMILY1 = ['#eda870', '#ca8f5f', '#7f5a3c', '#eca770']
GTK_FAMILY2 = ['#c6b2a8', '#a8978f', '#6b605b', '#c5b2a8', '#beafaa']

def build_gtk_family_map(set1, set2):
    base1, base2 = unhex('#eda870'), unhex('#c6b2a8')
    m = {}
    for h in GTK_FAMILY1:
        m[h.lower()] = hx(scale_to(unhex(h), set1, base1))
    for h in GTK_FAMILY2:
        m[h.lower()] = hx(scale_to(unhex(h), set2, base2))
    return m

def recolor_gtk_text_files(root, set1, set2):
    fam_map = build_gtk_family_map(set1, set2)
    n = 0
    for dp, dirs, fs in os.walk(root):
        dirs[:] = [d for d in dirs if d not in ('bak', 'src', '.git')]
        for fn in fs:
            if not (fn.endswith('.css') or fn.startswith('gtkrc') or fn.endswith('.rc')):
                continue
            p = os.path.join(dp, fn)
            try:
                t = open(p, encoding='latin-1').read()
            except Exception:
                continue
            orig = t
            t = re.sub(r'#[0-9A-Fa-f]{6}', lambda m: fam_map.get(m.group(0).lower(), m.group(0)), t)
            if t != orig:
                open(p, 'w', encoding='latin-1').write(t)
                n += 1
    return n

def recolor_gtk_pngs(root, set1, set2):
    from PIL import Image
    base1, base2 = unhex('#eda870'), unhex('#c6b2a8')
    n = 0
    for dp, dirs, fs in os.walk(root):
        dirs[:] = [d for d in dirs if d not in ('bak', 'src', '.git')]
        for fn in fs:
            if not fn.lower().endswith('.png'):
                continue
            p = os.path.join(dp, fn)
            try:
                im = Image.open(p).convert('RGBA')
            except Exception:
                continue
            colors = im.getcolors(maxcolors=1_000_000)
            if not colors:
                continue
            cmap, changed = {}, False
            for _, (r, g, b, a) in colors:
                fam = classify_family((r, g, b), base1, base2)
                if fam is None:
                    continue
                target, ref = (set1, base1) if fam == 1 else (set2, base2)
                cmap[(r, g, b)] = (*scale_to((r, g, b), target, ref), a)
                changed = True
            if not changed:
                continue
            px = im.load()
            for y in range(im.height):
                for x in range(im.width):
                    c = px[x, y]
                    m = cmap.get((c[0], c[1], c[2]))
                    if m:
                        px[x, y] = m
            im.save(p)
            n += 1
    return n

def write_qt6ct(path, face, base, highlight, hitext, fg):
    def a8(rgb):
        return '#ff%02x%02x%02x' % tuple(round(v) for v in rgb)
    K, W = (0, 0, 0), (255, 255, 255)
    MIDL = blend_white(face, 0.5)
    MID = blend_black(face, 0.22)
    DARK = blend_black(face, 0.40)
    ALT = blend_white(face, 0.65)
    # Role order mirrors redstone-9x-theme-convert's qt6ct emitter (Qt palette
    # serialization): WindowText Button Light Midlight Dark Mid Text BrightText
    # ButtonText Base Window Shadow Highlight HighlightedText Link LinkVisited
    # AlternateBase NoRole ToolTipBase ToolTipText PlaceholderText Accent
    active = [a8(fg), a8(face), a8(W), a8(MIDL), a8(DARK), a8(MID), a8(fg), a8(W),
              a8(fg), a8(base), a8(face), a8(K), a8(highlight), a8(hitext),
              '#ff0000ff', '#ff800080', a8(ALT), a8(K), '#ffffffe1', a8(K),
              a8(DARK), a8(highlight)]
    disabled = list(active)
    disabled[0] = disabled[6] = disabled[8] = a8(DARK)
    disabled[9] = a8(face)
    disabled[12] = a8(DARK)
    disabled[13] = a8(W)
    disabled[21] = a8(DARK)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, 'w') as f:
        f.write('[ColorScheme]\n')
        f.write('active_colors=' + ', '.join(active) + '\n')
        f.write('disabled_colors=' + ', '.join(disabled) + '\n')
        f.write('inactive_colors=' + ', '.join(active) + '\n')

def write_wine_reg(path, set1, set2, set4, set8):
    hi, hitext = set1, contrast(set1)
    regmap = {
        'ActiveBorder': set2, 'ActiveTitle': set1, 'AppWorkspace': (128, 128, 128),
        'Background': set8, 'ButtonDkShadow': (0, 0, 0), 'ButtonFace': set2,
        'ButtonHilight': blend_white(set2, 0.6),
        'ButtonLight': set2, 'ButtonShadow': blend_black(set2, 0.4),
        'ButtonText': contrast(set2),
        'GradientActiveTitle': blend_white(set1, 0.5),
        'GradientInactiveTitle': (192, 192, 192),
        'GrayText': (128, 128, 128), 'Hilight': hi, 'HilightText': hitext,
        'InactiveBorder': set2, 'InactiveTitle': (128, 128, 128),
        'InactiveTitleText': contrast(set2), 'InfoText': (0, 0, 0),
        'InfoWindow': (255, 255, 225), 'Menu': (255, 255, 255),
        'MenuText': (0, 0, 0), 'Scrollbar': blend_white(set2, 0.3),
        'TitleText': contrast(set1), 'Window': set4, 'WindowFrame': (0, 0, 0),
        'WindowText': (0, 0, 0),
    }
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, 'w', newline='\r\n') as f:
        f.write('REGEDIT4\n\n[HKEY_CURRENT_USER\\Control Panel\\Colors]\n')
        for k in sorted(regmap):
            r, g, b = (round(v) for v in regmap[k])
            f.write(f'"{k}"="{r} {g} {b}"\n')

def write_scheme(path, name, slug, set1, set2, set4, set8, backdrop_pat, kvantum):
    sel_fg = contrast(set1)
    desktop_fg = contrast(set8)
    prefs = ('TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;'
             'NetDevice=\\"wlan0 eth0\\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;'
             'CPUStatusCommand=\\"dbus-run-session mate-system-monitor\\";'
             'NetStatusCommand=\\"netactview\\"')
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, 'w') as f:
        f.write(f"# Redstone 9X Desktop Scheme — CDE {name} (raided CDE palette dynasty, 2026-07-20).\n")
        f.write(f'SCHEME_TITLE="CDE {name}"\n')
        f.write(f'ICEWM_THEME="CDE-{name}"\n')
        f.write(f'GTK_THEME="CDE-{name}"\n')
        f.write('ICON_THEME="Irixium"\n')
        f.write('CURSOR_THEME="Chicago95_Cursor_White"\n')
        f.write('CURSOR_SIZE="24"\n')
        f.write('GTK_FONT="Sans 8"\n')
        f.write(f'DESKTOP_BG="{hx(set8)}"\n')
        f.write('DESKTOP_ICON_LABEL_MODE="box"\n')
        f.write(f'DESKTOP_ICON_LABEL_FOREGROUND="{hx(desktop_fg)}"\n')
        f.write(f'DESKTOP_ICON_LABEL_BACKGROUND="{hx(set8)}"\n')
        f.write(f'SEL_BG="{hx(set1)}"\n')
        f.write(f'SEL_FG="{hx(sel_fg)}"\n')
        f.write(f'QT6CT_COLORS="cdep-{slug}.conf"\n')
        f.write('QT_STYLE="kvantum"\n')
        f.write(f'KVANTUM_THEME="{kvantum}"\n')
        f.write(f'WINE_COLORS="cdep-{slug}.reg"\n')
        f.write(f'SOUND_SCHEME="cdep-{slug}"\n')
        f.write(f'WALLPAPER="$HOME/.icewm/themes/CDE-{name}/backgrounds/{backdrop_pat}.png"\n')
        # center, not tile: the backdrop PNG is already pre-tiled to a full
        # canvas by render_backdrop (pcmanfm's own tile mode is broken here).
        f.write('WALLPAPER_MODE="center"\n')
        f.write(f'FOX_BASE="{hx(set2)}"\n')
        f.write(f'FOX_SEL_BG="{hx(set1)}"\n')
        f.write(f'FOX_SEL_FG="{hx(sel_fg)}"\n')
        f.write(f'FOX_MENU_BG="{hx(set1)}"\n')
        f.write(f'FOX_MENU_FG="{hx(sel_fg)}"\n')
        f.write(f'ICEWM_PREFS="{prefs}"\n')

def regen_cdecolors(css_path, sets):
    lines = ['/*', f' Regenerated by redstone-9x-cde-convert for palette {NAME}.dp',
             ' (upstream MotifColors.py conventions: ts=+45% white, bs=55%, sel=85%)', '*/', '']
    for i, s in enumerate(sets, 1):
        fgc = contrast(s)
        lines += [f'@define-color bg_color_{i} {hx(s)}; ',
                  f'@define-color fg_color_{i} {hx(fgc)}; ',
                  f'@define-color ts_color_{i} {hx(blend_white(s, 0.45))}; ',
                  f'@define-color bs_color_{i} {hx(blend_black(s, 0.45))}; ',
                  f'@define-color sel_color_{i} {hx(blend_black(s, 0.15))}; ', '']
    with open(css_path, 'w') as f:
        f.write('\n'.join(lines) + '\n')

sets = parse_dp(DP)
set1, set2, set4, set8 = sets[0], sets[1], sets[3], sets[7]
print(f"parsed {NAME}: set1={hx(set1)} set2={hx(set2)} set4={hx(set4)} set8={hx(set8)}")

if KDE98:
    # --kde98 widget-only flavor: Motif/CDE GTK widgets recoloured to the palette
    # (proven cdetheme engine + our regen_cdecolors Motif shading), theme named
    # {NAME} with NO CDE- prefix. No CDE Motif IceWM chrome, backdrop, or scheme —
    # the hand-authored kde-* scheme pairs these widgets with Win9x window frames
    # and Win95 fonts. Regenerates cdecolors for every gtk-3.x version present so
    # modern GTK (which reads gtk-3.20) shows the palette, not frozen Broica.
    gtk_out = f"{OUTROOT}/linux/.themes/{NAME}"
    shutil.rmtree(gtk_out, ignore_errors=True)
    shutil.copytree(GTK_SRC, gtk_out, ignore=shutil.ignore_patterns('.git'))
    nrc = recolor_gtk_text_files(gtk_out, set1, set2)
    npng = recolor_gtk_pngs(gtk_out, set1, set2)
    for _ver in ('gtk-3.0', 'gtk-3.16', 'gtk-3.20'):
        _cp = os.path.join(gtk_out, _ver, 'cdecolors.css')
        if os.path.exists(_cp):
            regen_cdecolors(_cp, sets)
    # cdetheme's scrollbar slider + arrow buttons carry only a 1px bevel and read
    # almost flat; KDE alpha Motif had a chunkier 2px RAISED bevel (light top-left,
    # dark bottom-right). Append a 2px Motif-bevel override — later rules win at
    # equal specificity, so no fragile in-place edit of the existing CSS. Slider
    # min-width drops to 7px so 7+2+2 still equals the 11px trough width.
    # Scrollbar well (trough) is a touch darker than the widget face — #aeaeae for
    # the #c0c0c0 Win95 palette (blend_black ~0.094), palette-derived for variants.
    _well = hx(blend_black(sets[4], 0.094))
    bevel = (
        "\n/* --kde98: scrollbar widened to 14px for the authentic KDE arrow bitmaps;\n"
        "   2px Motif bevel on the SLIDER (the arrow buttons carry their bevel in the\n"
        "   triangle bitmap, recoloured below — a CSS box-bevel read as a bevel around\n"
        "   the square button, not the KDE look). Well/trough slightly darker than the\n"
        "   face. Full button selectors so these beat cdetheme's button.up/down. */\n"
        "scrollbar.vertical trough, scrollbar.horizontal trough {\n"
        "  min-width: 14px; min-height: 14px; background-color: __WELL__; }\n"
        "scrollbar.vertical button.up, scrollbar.vertical button.down,\n"
        "scrollbar.horizontal button.up, scrollbar.horizontal button.down {\n"
        "  min-width: 14px; min-height: 14px; padding: 0; }\n"
        "scrollbar slider {\n"
        "  min-width: 10px; min-height: 10px;\n"
        "  border-width: 2px; border-style: solid;\n"
        "  border-top-color: @ts_gen; border-left-color: @ts_gen;\n"
        "  border-right-color: @bs_gen; border-bottom-color: @bs_gen; }\n")
    bevel = bevel.replace("__WELL__", _well)
    for _ver in ('gtk-3.0', 'gtk-3.16', 'gtk-3.20'):
        _wc = os.path.join(gtk_out, _ver, 'widgets.css')
        if os.path.exists(_wc):
            with open(_wc, 'a') as _f:
                _f.write(bevel)
    # Accent sync: cdetheme derives selection per-colorset (sel_gen=grey #a3a3a3 on
    # icon labels, sel_hi=near-black navy on widgets) — they disagree. Force EVERY
    # selection/highlight to the titlebar accent (set1) with contrast text, so GTK
    # widget selections and desktop icon-label highlights match the titlebar in every
    # palette variant. Redefine the theme's sel_* colours AND override :selected.
    _accent = hx(set1); _accent_fg = hx(contrast(set1))
    # Accent-sync cdetheme's own selection colours (used by its iconview/menu rules)
    # and GTK's STANDARD named selection colours, which cdetheme omits entirely. The
    # precise, cascade-WINNING selection override lives in the user gtk.css
    # (gtk.css.in — higher priority than the theme); a same-priority theme append
    # loses to cdetheme's own treeview.view:selected rule (verified by offscreen
    # render), and over-broad label rules there whitened unselected menu text.
    for _ver in ('gtk-3.0', 'gtk-3.16', 'gtk-3.20'):
        _cc = os.path.join(gtk_out, _ver, 'colors.css')
        if os.path.exists(_cc):
            _t = open(_cc).read()
            for _k in ('sel_gen', 'sel_text', 'sel_menu', 'sel_hi'):
                _t = re.sub(rf'@define-color {_k} [^;]*;', f'@define-color {_k} {_accent};', _t)
            # GTK's STANDARD named selection colours — cdetheme omits them entirely, so
            # widgets that query them programmatically (pcmanfm's treeview selection,
            # menu/label selected text) fall back to a built-in black no CSS rule can
            # touch. Defining them = accent/contrast is what actually fixes the tree
            # and the white selected text.
            _t += (f"\n@define-color theme_selected_bg_color {_accent};\n"
                   f"@define-color theme_selected_fg_color {_accent_fg};\n"
                   f"@define-color theme_unfocused_selected_bg_color {_accent};\n"
                   f"@define-color theme_unfocused_selected_fg_color {_accent_fg};\n")
            open(_cc, 'w').write(_t)
    # Scrollbar arrows: prefer the authentic KDE Motif arrows raided from the KDE
    # alpha screenshot (14x14 beveled triangles, stored as flavor assets); fall back
    # to cdetheme's own img/arrow*.orig.png beveled triangles. Either way, recolour
    # the grey ramp to the palette face (luminance transfer — same scale_to as the
    # chrome, anchored so the face lands on set2) so the bevel is ON the triangle,
    # baked into the pixels, and palette-matched for any variant.
    _arrows_src = f"{DOTCORTEX}/linux/.config/redstone-9x/kde98-assets/scroll-arrows"
    from PIL import Image as _ImgArrow
    def _bevel_arrow(src, dst, target):
        im = _ImgArrow.open(src).convert('RGBA'); px = im.load()
        tones = sorted(round(lum((px[x, y][0], px[x, y][1], px[x, y][2])))
                       for x in range(im.width) for y in range(im.height) if px[x, y][3] > 128)
        ref = (tones[len(tones) // 2],) * 3 if tones else (128, 128, 128)
        for y in range(im.height):
            for x in range(im.width):
                r, g, b, a = px[x, y]
                if a < 8:
                    continue
                nr, ng, nb = scale_to((r, g, b), target, ref)
                px[x, y] = (nr, ng, nb, a)
        im.save(dst)
    _imgdir = os.path.join(gtk_out, 'img')
    for _d in ('up', 'down', 'left', 'right'):
        _kde = os.path.join(_arrows_src, f'arrow-{_d}.png')
        _orig = os.path.join(_imgdir, f'arrow{_d}.orig.png')
        _src = _kde if os.path.exists(_kde) else (_orig if os.path.exists(_orig) else None)
        if _src:
            _bevel_arrow(_src, os.path.join(_imgdir, f'arrow{_d}.png'), set2)
            _bevel_arrow(_src, os.path.join(_imgdir, f'arrow{_d}pressed.png'), set2)
    # Qt: generate a palette-matched Kvantum theme named {NAME}. The Commonality
    # donor is CDE-shaped — a full teal ACCENT ramp (~15 shades) + tan chrome. A
    # fixed dict left ~12 teal shades leaking (the teal menu highlight). Instead map
    # by TONE: every teal/blue -> the navy accent ramp (set1), every tan/warm -> the
    # grey chrome ramp (set2), neutrals untouched — each at its own lightness via the
    # same scale_to transfer as the chrome. Then patch the kvconfig so the MENUBAR is
    # flat grey with black text (CDE paints it accent-coloured; Win95/KDE wants grey)
    # and every selection-state text is white (navy selection).
    _kv_src = f"{OUTROOT}/linux/.config/Kvantum/Commonality"
    _kv_out = f"{OUTROOT}/linux/.config/Kvantum/{NAME}"
    _teal_ref = (0x49, 0x92, 0xa7); _tan_ref = (0xc6, 0xb3, 0xa9)
    _hexre = re.compile(r'#[0-9a-fA-F]{6}')
    def _kv_remap(_m):
        _c = unhex(_m.group(0)); _h, _s, _v = hsv(_c)
        if _s < 0.10:
            return _m.group(0)
        if 150.0 <= _h <= 260.0:
            return hx(scale_to(_c, set1, _teal_ref))
        if _h <= 55.0 or _h >= 320.0:
            return hx(scale_to(_c, set2, _tan_ref))
        return _m.group(0)
    def _grey_menu_bg(_svg):
        # menu-normal is the menu/menubar BACKGROUND *and* its bevel border — the CDE
        # donor paints both the accent (same teal as selection), so the remap made
        # them navy. Grey ONLY the menu-normal group subtrees (interior + the frame
        # sub-elements menu-normal-{top,bottom,topleft,…}); selection elements
        # (iview/menuitem/mbitem-toggled/-pressed/-focused) keep their own ids and
        # stay navy. The navy fills live in CHILD <rect> nodes, so the whole
        # <g …id="menu-normal…">…</g> subtree must be recoloured, not just the
        # opening tag (-left/-right are <use> refs to -top/-bottom and inherit).
        def _tag(_m):
            def _f(_fm):
                _c = unhex(_fm.group(1))
                return 'fill:' + (hx(scale_to(_c, set2, (0, 0, 0x80))) if _c[2] > _c[0] + 20 else _fm.group(1))
            return re.sub(r'fill:(#[0-9a-fA-F]{6})', _f, _m.group(0))
        # The interior (id="menu-normal") is a standalone self-closing <rect> with an
        # inline navy fill; the bevel sub-elements are <g> groups whose navy lives in
        # child <rect>s. Match BOTH shapes or the interior background regresses to navy.
        return re.sub(r'<g\b[^>]*id="menu-normal[^"]*"[^>]*>.*?</g>'
                      r'|<(?:rect|path|use)\b[^>]*id="menu-normal[^"]*"[^>]*/>',
                      _tag, _svg, flags=re.S)
    if os.path.isdir(_kv_src):
        shutil.rmtree(_kv_out, ignore_errors=True); os.makedirs(_kv_out)
        for _ext in ('.kvconfig', '.svg'):
            _kt = _hexre.sub(_kv_remap, open(f"{_kv_src}/Commonality{_ext}", encoding='utf-8').read())
            if _ext == '.svg':
                _kt = _grey_menu_bg(_kt)
            if _ext == '.kvconfig':
                # selection-state text -> white everywhere (navy selection), INCLUDING
                # the .inactive variants: an unfocused tree/list still shows its
                # selected row, and the donor left text.press.inactive=blue there, so
                # a clicked-away tree row read as dark text on the accent.
                _kt = re.sub(r'text\.(press|focus|toggle)(\.inactive)?\.color=\S+', r'text.\1\2.color=white', _kt)
                # inactive selection bg -> navy too (donor paints it dark grey), so an
                # unfocused selected row matches the focused one instead of muddy grey.
                _kt = re.sub(r'inactive\.highlight\.color=\S+', f'inactive.highlight.color={_accent}', _kt)
                # item-view HOVER text: Kvantum uses text.focus.* for a moused-over row,
                # and text.focus.INACTIVE.* when the tree isn't the focused widget (the
                # usual case in a docs pane). The donor never defined the inactive one, so
                # hover fell back to dark text. Add it (white) so hover reads white too.
                def _add_focus_inactive(_s):
                    if 'text.focus.inactive.color' not in _s:
                        _s = _s.replace('text.focus.color=white',
                                        'text.focus.color=white\ntext.focus.inactive.color=white', 1)
                    return _s
                _kt = re.sub(r'\[ItemView\]\n.*?(?=\n\[)',
                             lambda m: _add_focus_inactive(m.group(0)), _kt, flags=re.S)
                # menubar: flat grey bg with BLACK text (grey menubar reads black, not
                # the accent). The item loses its navy interior (interior=false); the
                # container keeps its grey bg. Both get black text in every state.
                def _blacktext(_s):
                    return re.sub(r'text\.\w+\.color=\S+',
                                  lambda m: m.group(0).rsplit('=', 1)[0] + '=black', _s)
                _kt = re.sub(r'\[MenuBarItem\].*?(?=\n\[)',
                             lambda m: _blacktext(re.sub(r'interior=true', 'interior=false', m.group(0))),
                             _kt, flags=re.S)
                _kt = re.sub(r'\[MenuBar\].*?(?=\n\[)', lambda m: _blacktext(m.group(0)), _kt, flags=re.S)
                # popup menu: inactive item text -> black (donor paints it white on the
                # accent bg), and a thin Win95 border (3px frame -> 1px). Selected-item
                # text stays white (the press/focus/toggle pass above).
                def _norm_black(_s):
                    return re.sub(r'text\.normal\.color=\S+', 'text.normal.color=black', _s)
                _kt = re.sub(r'\[MenuItem\]\n.*?(?=\n\[)', lambda m: _norm_black(m.group(0)), _kt, flags=re.S)
                _kt = re.sub(r'\[Menu\]\n.*?(?=\n\[)',
                             lambda m: _norm_black(re.sub(r'frame\.(top|bottom|left|right)=\d+', r'frame.\1=1', m.group(0))),
                             _kt, flags=re.S)
            open(f"{_kv_out}/{NAME}{_ext}", 'w', encoding='utf-8').write(_kt)
        print(f"kvantum theme {NAME} generated (palette-matched Qt: teal->navy, tan->grey, grey menubar)")
    print(f"built kde98 widget theme {NAME}: gtk={gtk_out} ({nrc} text, {npng} pngs, slider bevel + baked arrows)")
    sys.exit(0)

icewm_out = f"{OUTROOT}/linux/.icewm/themes/CDE-{NAME}"
