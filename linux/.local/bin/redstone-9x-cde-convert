# cdetheme's cdecolors.css files are GENERATED artifacts of upstream's own
# MotifColors.py, shipped frozen for whatever palette upstream last ran
# (gtk-3.0: Broica, gtk-4.0: Golden1 — the olive+lavender mixer bug,
# 2026-07-20). They define the exact 8-set CDE interface (bg/fg/ts/bs/sel
# per set) — so REGENERATE them from OUR palette with Motif shading math
# instead of recolouring frozen output. (regen_cdecolors is defined up near the
# palette parse so the --kde98 widget flavor can reuse it.)
cp = os.path.join(gtk_out, 'gtk-3.0', 'cdecolors.css')
if os.path.exists(cp):
    regen_cdecolors(cp, sets)
print("cdecolors.css regenerated for gtk-3.0")

# netrunner's gtk-4.0 is a thin early port: 190 css lines, ZERO slider/tab
# rules — colours right, widgets unformatted (the broken mixer, 2026-07-20).
# The Windows-95 base gtk-4.0 (2550 lines, full widget coverage — proven on
# the Valve mixer) recoloured to the palette replaces it: classic bevels are
# Motif's close cousin and sit coherently under CDE chrome.
from PIL import Image as _Img4
W95_GTK4 = os.path.expanduser('~/DotCortex/linux/.themes/Windows-95/gtk-4.0')
g4 = os.path.join(gtk_out, 'gtk-4.0')
shutil.rmtree(g4, ignore_errors=True)
shutil.copytree(W95_GTK4, g4)
fgc2 = contrast(set2)
for dp2, _, fs2 in os.walk(g4):
    for fn2 in fs2:
        p2 = os.path.join(dp2, fn2)
        if fn2.endswith('.css'):
            t2 = open(p2, encoding='latin-1').read()
            t2 = re.sub(r'#c0c0c0', hx(set2), t2, flags=re.I)
            t2 = re.sub(r'\b192,\s*192,\s*192\b', '%d, %d, %d' % tuple(round(v) for v in set2), t2)
            t2 = re.sub(r'#000080', hx(set1), t2, flags=re.I)
            t2 = re.sub(r'\b0,\s*0,\s*128\b', '%d, %d, %d' % tuple(round(v) for v in set1), t2)
            # levelbar trough is unstyled in the Win95 base (padding + radius
            # only), so pavucontrol's GTK4 peak meters render as flat borderless
            # bars — the "inactive background" Mètsàtron caught, present on every
            # face, light and dark (hence not fixed by the dark-only grey pass).
            # Give it the sunken Motif bevel + face background the progressbar
            # trough directly above it already carries, so idle meters read as
            # recessed fields that follow the palette. Unconditional (all faces).
            t2 = t2.replace(
                'levelbar trough {\n  padding: 1px;\n  border-radius: 0; }',
                'levelbar trough {\n  padding: 1px;\n  border-radius: 0;\n'
                '  border: 1px solid #7d7d7d;\n  border-bottom-color: white;\n'
                '  border-right-color: white;\n  background-color: ' + hx(set2) + '; }')
            # Notebook page background is hardcoded #FFFFFF in the Win95 base, and
            # the #c0c0c0->face swap never touches it — so any GTK4 app whose
            # content lives on a notebook page (pavucontrol: Window > Notebook >
            # ScrolledWindow > streams) renders its ENTIRE background white
            # instead of the palette face. This was THE "missing background"
            # Mètsàtron reported (verified by headless pavucontrol grab). A Win95/
            # CDE tabbed dialog page is the face, not white (white is only for
            # data views — entries/lists keep #FFFFFF). Remap the page to face.
            t2 = t2.replace(
                'notebook > stack:not(:only-child) {\n  background-color: #FFFFFF; }',
                'notebook > stack:not(:only-child) {\n  background-color: ' + hx(set2) + '; }')
            t2 = t2.replace(
                'notebook > stack:not(:only-child):backdrop {\n    background-color: #FFFFFF; }',
                'notebook > stack:not(:only-child):backdrop {\n    background-color: ' + hx(set2) + '; }')
            if fgc2 != (0, 0, 0):
                t2 = re.sub(r'(?<![-\w])color:\s*#000000', 'color: ' + hx(fgc2), t2)
                t2 = re.sub(r'(@define-color theme_(?:fg|text|unfocused_fg|unfocused_text)_color) #000000',
                            r'\1 ' + hx(fgc2), t2)
                # Dark face: the Windows-95 base's light neutral-grey ramp
                # (backdrop / insensitive / bevel tones — #ececec, #b6b6b6, …)
                # survives the face swap and reads as light patches against a
                # dark CDE face — the exact leak the SerenityOS dark themes had
                # on GTK4 (fixed in redstone-9x-theme-convert's PYDARK pass;
                # never ported here — cde-convert only flipped fg). Mix each
                # neutral toward the face so inactive/backdrop backgrounds read
                # as face-relative tones. Same dict, same mix() as PYDARK.
                _F4 = tuple(round(v) for v in set2)
                def _mix4(f, _F=_F4):
                    return '#%02x%02x%02x' % tuple(round(c + (255 - c) * f) for c in _F)
                _BRIGHT4 = {'#ececec': _mix4(0.10), '#e0e0e0': _mix4(0.08),
                            '#dedede': _mix4(0.08), '#d5d5d5': _mix4(0.06),
                            '#cccccc': _mix4(0.06), '#c5c5c5': _mix4(0.04),
                            '#b6b6b6': _mix4(0.02), '#adadad': _mix4(0.02),
                            '#f5f5f5': _mix4(0.12), '#fafafa': _mix4(0.12),
                            '#e8e8e8': _mix4(0.09)}
                for _k4, _v4 in _BRIGHT4.items():
                    t2 = re.sub(re.escape(_k4), _v4, t2, flags=re.I)
            open(p2, 'w', encoding='latin-1').write(t2)
        elif fn2.endswith('.png'):
            im2 = _Img4.open(p2).convert('RGBA'); px2 = im2.load(); ch2 = False
            for y2 in range(im2.height):
                for x2 in range(im2.width):
                    r2, g2, b2, a2 = px2[x2, y2]
                    if (r2, g2, b2) == (192, 192, 192):
                        px2[x2, y2] = (round(set2[0]), round(set2[1]), round(set2[2]), a2); ch2 = True
                    elif (r2, g2, b2) == (0, 0, 128):
                        px2[x2, y2] = (round(set1[0]), round(set1[1]), round(set1[2]), a2); ch2 = True
            if ch2:
                im2.save(p2)
print("gtk-4.0 replaced with recoloured Windows-95 base (full widget coverage)")

# Per-palette Kvantum theme: kvantum paints from its OWN kvconfig/svg and
# ignores qt6ct palettes entirely — a static Commonality means Qt never
# follows the palette. Clone the LIGHT Commonality donor (gris is dark;
# dark->light hex mapping inverts its shading) and remap its colour
# families onto the sets. Accent teals are its selection art -> set1 ramp.
KVMAP = {
    '#c6b3a9': set2,                      # window/face
    '#bdaa9f': blend_black(set2, 0.06),
    '#a8988f': set4, '#a09088': set4,     # base/text areas
    '#ebe0da': blend_white(set2, 0.45),   # topshadow family
    '#efebe7': blend_white(set2, 0.45),
    '#eeeeee': blend_white(set2, 0.60),
    '#e6e6e6': blend_white(set2, 0.60),
    '#e1e1e1': blend_white(set2, 0.60),
    '#6a605a': blend_black(set2, 0.45),   # bottomshadow family
    '#554c48': blend_black(set2, 0.45),
    '#4e4e4e': blend_black(set2, 0.55),
    '#686f82': set1,                      # highlight
    '#4992a7': set1,                      # accent teal ramp -> set1
    '#244953': blend_black(set1, 0.45),
    '#adced7': blend_white(set1, 0.50),
}
kv_out = f"{OUTROOT}/linux/.config/Kvantum/CDE-{NAME}"
shutil.rmtree(kv_out, ignore_errors=True)
os.makedirs(kv_out)
kv_src = f"{OUTROOT}/linux/.config/Kvantum/Commonality"
for ext in ('.kvconfig', '.svg'):
    t = open(f"{kv_src}/Commonality{ext}", encoding='utf-8').read()
    for src, dst in KVMAP.items():
        t = re.sub(re.escape(src), hx(dst), t, flags=re.I)
    if ext == '.kvconfig' and lum(set2) < 96:
        # dark palette: flip the literal text-colour words
        t = re.sub(r'(\.text\.color=)black', r'\g<1>white', t)
        t = re.sub(r'(^text\.color=)black', r'\g<1>white', t, flags=re.M)
    open(f"{kv_out}/CDE-{NAME}{ext}", 'w', encoding='utf-8').write(t)
print(f"kvantum theme CDE-{NAME} generated from Commonality donor")

kvantum = f"CDE-{NAME}"
write_scheme(f"{OUTROOT}/linux/.config/redstone-9x/schemes/cdep-{SLUG}.scheme",
             NAME, SLUG, set1, set2, set4, set8, pat, kvantum)
write_qt6ct(f"{OUTROOT}/linux/.config/redstone-9x/qt6ct/colors/cdep-{SLUG}.conf",
            set2, set4, set1, contrast(set1), contrast(set2))
