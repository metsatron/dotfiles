#!/usr/bin/env bash
# swap-guardian-cron-apply
# #+NAME: swap-guardian-cron-apply

# [[file:../../../services.org::swap-guardian-cron-apply][swap-guardian-cron-apply]]
set -euo pipefail

TAG="swap-guardian-cron-apply"
EXPECTED_HOST="kikin-kushi"
DRY=0
REMOVE=0
HOSTNAME_BIN="${SWAP_GUARDIAN_CRON_HOSTNAME_BIN:-hostname}"
CRON_BIN="${SWAP_GUARDIAN_CRON_BIN:-crontab}"
BEGIN="# BEGIN dotcortex-swap-guardian (managed by $TAG)"
END="# END dotcortex-swap-guardian (managed by $TAG)"

usage() {
  cat <<'EOF'
Usage: swap-guardian-cron-apply [--host HOST] [--dry-run] [--remove]

Install or remove the 5-minute swap-guardian user crontab entry.
Idempotent: replaces only its own managed block.

Options:
  --host HOST   Expected hostname (default: kikin-kushi)
  --dry-run     Print the crontab modifications without applying
  --remove      Remove the managed block from crontab
  -h, --help    Show this help
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --host) [ "$#" -ge 2 ] || { echo "$TAG: --host requires a value" >&2; exit 2; }; EXPECTED_HOST="$2"; shift ;;
    --dry-run) DRY=1 ;;
    --remove) REMOVE=1 ;;
    -h|--help|help) usage; exit 0 ;;
    *) echo "$TAG: unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

if [ "$REMOVE" = 0 ]; then
  CURRENT_HOST="$($HOSTNAME_BIN -s 2>/dev/null || $HOSTNAME_BIN)"
  if [ -n "$EXPECTED_HOST" ] && [ "$CURRENT_HOST" != "$EXPECTED_HOST" ]; then
    echo "$TAG: warning: running on $CURRENT_HOST; expected $EXPECTED_HOST" >&2
  fi
fi

GUARDIAN="$HOME/.local/bin/swap-guardian"
[ "$DRY" = 1 ] || [ "$REMOVE" = 1 ] || [ -x "$GUARDIAN" ] || { echo "$TAG: missing $GUARDIAN; tangle and stow first" >&2; exit 1; }

CRON_PATH="$HOME/.guix-extra-profiles/core/core/bin:$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"
STATE_DIR="$HOME/.local/state/swap-guardian"

existing="$("$CRON_BIN" -l 2>/dev/null || true)"
stripped="$(printf '%s\n' "$existing" | awk -v begin="$BEGIN" -v end="$END" '
  $0 == begin { skip = 1; next }
  $0 == end { skip = 0; next }
  !skip { print }
')"

if [ "$REMOVE" = 1 ]; then
  if [ -z "$(printf '%s' "$stripped" | tr -d '[:space:]')" ]; then
    if [ "$DRY" = 1 ]; then echo "remove crontab (empty)"; else "$CRON_BIN" -r; echo "$TAG: crontab removed (was only ours)"; fi
  else
    if [ "$DRY" = 1 ]; then printf '%s\n' "$stripped"; else printf '%s\n' "$stripped" | "$CRON_BIN" -; echo "$TAG: removed managed block"; fi
  fi
  exit 0
fi

desired="$(printf '%s\n' "$stripped" | cat -s)"
[ -n "$desired" ] && desired="$desired
"
desired="${desired}${BEGIN}
*/5 * * * * HOME=$HOME PATH=$CRON_PATH mkdir -p $STATE_DIR && $GUARDIAN >>$STATE_DIR/cron.log 2>&1
${END}"

if [ "$DRY" = 1 ]; then
  printf '%s\n' "$desired"
else
  printf '%s\n' "$desired" | "$CRON_BIN" -
  echo "$TAG: installed user crontab block ($GUARDIAN)"
fi
# swap-guardian-cron-apply ends here
