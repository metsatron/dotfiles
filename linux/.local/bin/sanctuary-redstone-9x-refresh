#!/usr/bin/env bash
# Live refresh helper

# This is the supported bridge between tangled DotCortex output and an already-running
# Redstone 9X room.  It refreshes only the lightweight, guest-home projection layer;
# Guix profiles, process-start environment, mounts, Xephyr geometry, and session startup
# still require a full sanctuary relaunch.


# [[file:../../../sanctuary-redstone-9x-refresh.org::*Live refresh helper][Live refresh helper:1]]
set -Eeuo pipefail

SANCTUARY="${SANCTUARY:-sanctuary-redstone-9x}"
DISPLAY_NUM="${DISPLAY_NUM:-:93}"
REPO_ROOT="${DOTCORTEX_ROOT:-${HOME}/DotCortex}"
GUESTS_DIR="${XDG_DATA_HOME:-${HOME}/.local/share}/dotcortex/guests"
GUEST_HOME="${GUESTS_DIR}/${SANCTUARY}/home"
GUIX_PROFILES="${HOME}/.guix-extra-profiles"
KDE1_WALLPAPER_SOURCE="${REPO_ROOT}/linux/.local/share/kde1-history/wallpapers"
KDE1_WALLPAPER_TARGET="${GUEST_HOME}/Pictures/Wallpaper/KDE 1 Historical"
KDE1_WALLPAPER_GUEST_SOURCE="/run/host${KDE1_WALLPAPER_SOURCE}"
WALLPAPER_SOURCE="${REPO_ROOT}/linux/.config/redstone-9x/wallpapers"
WALLPAPER_TARGET="${GUEST_HOME}/.config/redstone-9x/wallpapers"
MODE="refresh"
RELOAD=1

usage() {
  cat <<'EOF'
sanctuary-redstone-9x-refresh - refresh the running Redstone 9X projection

Usage:
  sanctuary-redstone-9x-refresh [--check] [--no-reload] [--layout] [--capture-layout]

  --check           report whether the room and key projected files are current
  --no-reload       project files and reapply the active scheme without reloading IceWM
  --layout          apply the declared desktop icon layout and bounce the desktop layer
  --capture-layout  freeze the room's CURRENT icon arrangement back into the manifest
  -h, --help        show this help

This command is for guest-home configuration: IceWM menu/toolbar/preferences,
desktop launchers, Redstone wrappers, shell/rofi config, and Desktop Schemes.
Relaunch the sanctuary after profile, environment, mount, Xephyr, or startup-process
changes. Never copy files into the guest by hand; use `loom redstone:refresh`.
EOF
}

while (( $# )); do
  case "$1" in
    --check) MODE="check" ;;
    --no-reload) RELOAD=0 ;;
    --layout) MODE="layout" ;;
    --capture-layout) MODE="capture-layout" ;;
    -h|--help) usage; exit 0 ;;
    *) echo "redstone refresh: unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

die() {
  echo "redstone refresh: ERROR - $*" >&2
  exit 1
}

proc_env_value() {
  local pid="$1" key="$2"
  [[ -r "/proc/${pid}/environ" ]] || return 1
  tr '\0' '\n' < "/proc/${pid}/environ" | sed -n "s/^${key}=//p" | head -n 1
}

find_room_icewm() {
  local pid display
  while read -r pid; do
    [[ -n "${pid}" ]] || continue
    display="$(proc_env_value "${pid}" DISPLAY 2>/dev/null || true)"
    if [[ "${display}" == "${DISPLAY_NUM}" || "${display}" == "${DISPLAY_NUM}.0" ]]; then
      printf '%s\n' "${pid}"
      return 0
    fi
  done < <(pgrep -x icewm 2>/dev/null || true)
  # The sanctuary desktop runs in the container PID namespace.  On hosts where
  # that namespace is not visible from the loom process, confirm the live
  # desktop through the supported distrobox bridge instead of treating a
  # running room as absent.
  if distrobox enter "${SANCTUARY}" -- pgrep -x icewm >/dev/null 2>&1; then
    printf '%s\n' container
    return 0
  fi
  if sanctuary-exec "${SANCTUARY}" pgrep -x icewm >/dev/null 2>&1; then
    printf '%s\n' container
    return 0
  fi
  return 1
}

[[ -d "${REPO_ROOT}/linux" ]] || die "DotCortex checkout not found: ${REPO_ROOT}"
[[ -d "${GUEST_HOME}" ]] || die "guest home missing: ${GUEST_HOME}"
[[ -S /tmp/.X11-unix/X93 ]] || die "Xephyr ${DISPLAY_NUM} is not running"
ICEWM_PID="$(find_room_icewm || true)"
[[ -n "${ICEWM_PID}" ]] || die "no IceWM process belongs to ${DISPLAY_NUM}"

ACTIVE_SCHEME="$(cat "${GUEST_HOME}/.config/redstone-9x/scheme" 2>/dev/null || echo windows-95)"
SCHEME_SOURCE="${REPO_ROOT}/linux/.config/redstone-9x/schemes/${ACTIVE_SCHEME}.scheme"
if [[ ! -f "${SCHEME_SOURCE}" ]]; then
  echo "redstone refresh: warning - unknown active scheme '${ACTIVE_SCHEME}'; using windows-95" >&2
  ACTIVE_SCHEME="windows-95"
  SCHEME_SOURCE="${REPO_ROOT}/linux/.config/redstone-9x/schemes/windows-95.scheme"
fi
[[ -f "${SCHEME_SOURCE}" ]] || die "baseline scheme missing: ${SCHEME_SOURCE}"

key_pairs=(
  "linux/.icewm/menu|.icewm/menu"
  "linux/.icewm/toolbar|.icewm/toolbar"
  "linux/.icewm/preferences|.icewm/preferences"
  "linux/.icewm/winoptions|.icewm/winoptions"
  "linux/.icewm/startup|.icewm/startup"
  "linux/.local/bin/redstone-buildstamp|.local/bin/redstone-buildstamp"
  "linux/.local/bin/redstone-buildstamp-generate|.local/bin/redstone-buildstamp-generate"
  "linux/.config/redstone-9x/buildstamp.conf|.config/redstone-9x/buildstamp.conf"
  "linux/.config/redstone-9x/placements.conf|.config/redstone-9x/placements.conf"
  "linux/.local/bin/redstone-9x-zsh|.local/bin/redstone-9x-zsh"
  "linux/.local/bin/redstone-9x-bash|.local/bin/redstone-9x-bash"
  "linux/.local/bin/redstone-9x-clippy|.local/bin/redstone-9x-clippy"
  "linux/.local/bin/redstone-9x-place|.local/bin/redstone-9x-place"
  "linux/.local/bin/redstone-9x-disc|.local/bin/redstone-9x-disc"
  "linux/.local/bin/redstone-9x-fonts-apply|.local/bin/redstone-9x-fonts-apply"
  "linux/.local/bin/redstone-9x-dosemu2-shell|.local/bin/redstone-9x-dosemu2-shell"
  "linux/.local/bin/redstone-9x-border-apply|.local/bin/redstone-9x-border-apply"
  "linux/.local/bin/redstone-9x-menu-window-borders|.local/bin/redstone-9x-menu-window-borders"
  "linux/.local/bin/redstone-9x-nextstep-menu|.local/bin/redstone-9x-nextstep-menu"
  "linux/.local/bin/redstone-9x-nextstep-dockapps|.local/bin/redstone-9x-nextstep-dockapps"
  "linux/.icewm/desktop/bash-cmd.desktop|Desktop/bash-cmd.desktop"
  "linux/.icewm/desktop/dosemu2.desktop|Desktop/dosemu2.desktop"
)

if [[ "${MODE}" == "check" ]]; then
  stale=0
  for pair in "${key_pairs[@]}"; do
    src="${REPO_ROOT}/${pair%%|*}"
    dst="${GUEST_HOME}/${pair#*|}"
    if [[ ! -f "${dst}" ]]; then
      printf 'MISSING  %s\n' "${pair#*|}"
      stale=$((stale + 1))
    elif [[ "${pair#*|}" == ".icewm/menu" ]]; then
      if ! sed \
        -e "s|@ROOM_QT6_PLUGINS@|${GUIX_PROFILES}/room-gaming/room-gaming/lib/qt6/plugins|g" \
        -e "s|@ROOM_QT6_QML@|${GUIX_PROFILES}/room-gaming/room-gaming/lib/qt6/qml|g" \
        -e "s|@ROOM_SHARE@|${GUIX_PROFILES}/room-gaming/room-gaming/share|g" \
        -e "s|@DESKTOP_COMMON_SSL_CERT@|${GUIX_PROFILES}/desktop-common/desktop-common/etc/ssl/certs/ca-certificates.crt|g" \
        "${src}" | cmp -s - "${dst}"; then
        printf 'STALE    %s\n' "${pair#*|}"
        stale=$((stale + 1))
      fi
    elif ! cmp -s "${src}" "${dst}"; then
      printf 'STALE    %s\n' "${pair#*|}"
      stale=$((stale + 1))
    fi
  done
  if [[ -e "${GUEST_HOME}/Desktop/bash-ps.desktop" ]]; then
    printf 'OBSOLETE Desktop/bash-ps.desktop\n'
    stale=$((stale + 1))
  fi
  if [[ ! -f "${GUEST_HOME}/.config/redstone-9x/terminal-theme.zsh" ]]; then
    printf 'MISSING  .config/redstone-9x/terminal-theme.zsh\n'
    stale=$((stale + 1))
  fi
  if [[ ! -f "${GUEST_HOME}/.local/share/redstone-9x/build.ini" ]]; then
    printf 'MISSING  .local/share/redstone-9x/build.ini\n'
    stale=$((stale + 1))
  fi
  for src in "${REPO_ROOT}/linux/.config/redstone-9x/fonts/"*.ttf; do
    [[ -f "${src}" ]] || continue
    dst="${GUEST_HOME}/.local/share/fonts/redstone-schemes/$(basename "${src}")"
    if [[ ! -f "${dst}" ]]; then
      printf 'MISSING  .local/share/fonts/redstone-schemes/%s\n' \
        "$(basename "${src}")"
      stale=$((stale + 1))
    elif ! cmp -s "${src}" "${dst}"; then
      printf 'STALE    .local/share/fonts/redstone-schemes/%s\n' \
        "$(basename "${src}")"
      stale=$((stale + 1))
    fi
  done
  if ! "${REPO_ROOT}/linux/.local/bin/redstone-9x-fonts-apply" --check >/dev/null 2>&1; then
    printf 'MISSING  font: PxPlus IBM VGA 9x14\n'
    stale=$((stale + 1))
  fi
  if [[ ! -d "${WALLPAPER_TARGET}" ]]; then
    printf 'MISSING  .config/redstone-9x/wallpapers\n'
    stale=$((stale + 1))
  elif ! diff -rq "${WALLPAPER_SOURCE}" "${WALLPAPER_TARGET}" >/dev/null 2>&1; then
    printf 'STALE    .config/redstone-9x/wallpapers\n'
    stale=$((stale + 1))
  fi
  if [[ ! -L "${KDE1_WALLPAPER_TARGET}" ]] \
    || [[ "$(readlink "${KDE1_WALLPAPER_TARGET}" 2>/dev/null || true)" \
          != "${KDE1_WALLPAPER_GUEST_SOURCE}" ]]; then
    printf 'MISSING  Pictures/Wallpaper/KDE 1 Historical\n'
    stale=$((stale + 1))
  fi
  printf 'room=%s display=%s icewm_pid=%s scheme=%s stale=%d\n' \
    "${SANCTUARY}" "${DISPLAY_NUM}" "${ICEWM_PID}" "${ACTIVE_SCHEME}" "${stale}"
  (( stale == 0 ))
  exit
fi

project_file() {
  local src="$1" dst="$2" mode="${3:-}"
  [[ -f "${src}" ]] || die "managed source missing: ${src}"
  mkdir -p "$(dirname "${dst}")"
  rm -f -- "${dst}"
  cp -f -- "${src}" "${dst}"
  [[ -z "${mode}" ]] || chmod "${mode}" "${dst}"
}

project_dir() {
  local src="$1" dst="$2" tmp="${2}.refresh-tmp"
  [[ -d "${src}" ]] || die "managed source directory missing: ${src}"
  mkdir -p "$(dirname "${dst}")"
  rm -rf -- "${tmp}"
  cp -a -- "${src}" "${tmp}"
  rm -rf -- "${dst}"
  mv -- "${tmp}" "${dst}"
}

if [[ "${MODE}" == "layout" || "${MODE}" == "capture-layout" ]]; then
  # Desktop icon layout is a narrow, explicit operation: it must NOT ride along
  # with a normal refresh, because a refresh is routine and moving someone's
  # icons is not. Both directions run against the GUEST home from the host --
  # the config file is plain host-side state -- but the pcmanfm bounce that
  # makes the new positions take effect has to happen inside the room, via
  # `distrobox enter` (never bare `podman exec`, which runs as container root
  # and would leave root-owned files behind).
  LAYOUT_BIN="${GUEST_HOME}/.local/bin/redstone-9x-desktop-layout"
  project_file "${REPO_ROOT}/linux/.local/bin/redstone-9x-desktop-layout" "${LAYOUT_BIN}" 755
  project_file "${REPO_ROOT}/linux/.config/redstone-9x/desktop-layout.ssv" \
    "${GUEST_HOME}/.config/redstone-9x/desktop-layout.ssv"

  if [[ "${MODE}" == "capture-layout" ]]; then
    # Capture writes the REPO manifest, not the guest copy — the repo is the
    # source of truth, and a capture that only updated the projection would be
    # silently discarded by the next refresh.
    HOME="${GUEST_HOME}" \
      REDSTONE_DESKTOP_MANIFEST="${REPO_ROOT}/linux/.config/redstone-9x/desktop-layout.ssv" \
      /bin/bash "${LAYOUT_BIN}" --capture
    echo "[redstone-refresh] manifest updated in place — re-tangle sanctuary-redstone-9x-desktop.org to fold it back into org source"
    exit 0
  fi

  # DISPLAY must be the ROOM's, not the host's. The writer probes the screen to
  # decide rows-per-column, and this runs on the host, where $DISPLAY is the
  # host session -- a different resolution on any machine where the two differ.
  # Xephyr runs with -ac, so a host-side xdpyinfo against :93 succeeds.
  HOME="${GUEST_HOME}" DISPLAY="${DISPLAY_NUM}" /bin/bash "${LAYOUT_BIN}"

  LIVE_XAUTHORITY="$(proc_env_value "${ICEWM_PID}" XAUTHORITY 2>/dev/null || true)"
  [[ -n "${LIVE_XAUTHORITY}" ]] || LIVE_XAUTHORITY="${HOME}/.Xauthority"
  layout_env=(
    "HOME=${GUEST_HOME}"
    "DISPLAY=${DISPLAY_NUM}"
    "XAUTHORITY=${LIVE_XAUTHORITY}"
    "XDG_CONFIG_HOME=${GUEST_HOME}/.config"
    "XDG_DATA_HOME=${GUEST_HOME}/.local/share"
    "XDG_CACHE_HOME=${GUEST_HOME}/.cache"
    "PATH=${GUEST_HOME}/.local/bin:${GUIX_PROFILES}/desktop-common/desktop-common/bin:${GUIX_PROFILES}/room-gaming/room-gaming/bin:/usr/local/bin:/usr/bin:/bin"
  )
  echo "[redstone-refresh] bouncing the desktop layer to load the new layout"
  # --desktop-off then --desktop, NOT a bare --desktop: against a running
  # instance the second invocation is a single-instance handoff that never
  # re-reads desktop-items-0.conf. Same reason scheme-apply cycles it.
  distrobox enter "${SANCTUARY}" -- env "${layout_env[@]}" pcmanfm --desktop-off || true
  sleep 1
  distrobox enter "${SANCTUARY}" -- env "${layout_env[@]}" pcmanfm --desktop >/dev/null 2>&1 &
  sleep 1
  # Destroying the desktop window takes the build-stamp renderer down with it --
  # its glyph windows are stacked against the desktop, so `--desktop-off` leaves
  # no stamp on screen and nothing restarts it. The full refresh path already
  # ends with this for the same reason; the narrow layout path needs it too.
  distrobox enter "${SANCTUARY}" -- env "${layout_env[@]}" \
    "${GUEST_HOME}/.local/bin/redstone-buildstamp" refresh >/dev/null 2>&1 || true
  echo "[redstone-refresh] desktop layout applied"
  exit 0
fi

echo "[redstone-refresh] projecting lightweight config into ${GUEST_HOME}"

if [[ ! -d "${KDE1_WALLPAPER_SOURCE}" ]]; then
  echo "redstone-refresh: missing KDE 1 wallpaper index: ${KDE1_WALLPAPER_SOURCE}" >&2
  exit 1
fi
mkdir -p "$(dirname "${KDE1_WALLPAPER_TARGET}")"
ln -sfnT "${KDE1_WALLPAPER_GUEST_SOURCE}" "${KDE1_WALLPAPER_TARGET}"

mkdir -p "${GUEST_HOME}/.icewm" "${GUEST_HOME}/Desktop" "${GUEST_HOME}/.local/bin"
for name in preferences menu toolbar keys winoptions startup; do
  mode=""
  [[ "${name}" == "startup" ]] && mode="755"
  project_file "${REPO_ROOT}/linux/.icewm/${name}" "${GUEST_HOME}/.icewm/${name}" "${mode}"
done
project_dir "${REPO_ROOT}/linux/.icewm/menu-buttons" "${GUEST_HOME}/.icewm/menu-buttons"
sed -i \
  -e "s|@ROOM_QT6_PLUGINS@|${GUIX_PROFILES}/room-gaming/room-gaming/lib/qt6/plugins|g" \
  -e "s|@ROOM_QT6_QML@|${GUIX_PROFILES}/room-gaming/room-gaming/lib/qt6/qml|g" \
  -e "s|@ROOM_SHARE@|${GUIX_PROFILES}/room-gaming/room-gaming/share|g" \
  -e "s|@DESKTOP_COMMON_SSL_CERT@|${GUIX_PROFILES}/desktop-common/desktop-common/etc/ssl/certs/ca-certificates.crt|g" \
  "${GUEST_HOME}/.icewm/menu"

# IceWM themes: launch bulk-copies the whole themes tree once; refresh converges
# each scheme-declared ICEWM_THEME dir — projecting the ones the running guest is
# missing, and re-projecting the ones whose contents have drifted from the repo.
# Without the missing half, a NEW scheme's chrome (e.g. the BeOS-tab dynasty:
# BeOS-Max-Tab / BeOS-Personal-Tab / icedano) is unselectable in a refreshed room
# — the same defect class as the wine/ reg projection gap (2026-07-22).
#
# This used to skip on mere existence (`[[ -e … ]] && continue`), which made it
# gap-fill only: a theme dir already in the guest could never be updated, so any
# EDIT to an existing theme's pixmaps was invisible forever while a brand-new
# theme appeared fine. That is what stranded the SerenityOS caption buttons
# (2026-07-25): the triangle glyphs landed correctly in all 33 Serenity-* dirs in
# the repo, but only the 3 whose guest copies had been deleted by hand during
# that session picked them up — the other 30 kept the Win95 donor's bar/square
# minimize glyph, so the arrow captions looked like they applied to some Serenity
# themes and not others. The repo was right the whole time; the projection was
# the liar.
#
# The original reason for the skip was real but narrower than the guard: the
# guest themes dir ALSO carries ice2k's theme symlinks, and project_dir rm -rf's
# its destination. So exclude symlinks specifically, and converge everything
# else. diff -rq is cheap here — these are small pixmap dirs, and each distinct
# ICEWM_THEME is only examined once even though ~104 schemes reference them.
mkdir -p "${GUEST_HOME}/.icewm/themes"
_seen_themes=""
for _schemefile in "${REPO_ROOT}/linux/.config/redstone-9x/schemes/"*.scheme; do
  [[ -f "${_schemefile}" ]] || continue
  # shellcheck disable=SC1090
  _itheme="$(. "${_schemefile}"; printf %s "${ICEWM_THEME:-}")"
  [[ -n "${_itheme}" ]] || continue
  # Many schemes share one IceWM theme; only consider each dir once per refresh.
  case ":${_seen_themes}:" in *":${_itheme}:"*) continue ;; esac
  _seen_themes="${_seen_themes}:${_itheme}"
  _isrc="${REPO_ROOT}/linux/.icewm/themes/${_itheme}"
  _idst="${GUEST_HOME}/.icewm/themes/${_itheme}"
  [[ -d "${_isrc}" ]] || continue
  # ice2k's entries are symlinks into its own tree — never ours to replace.
  [[ -L "${_idst}" ]] && continue
  if [[ ! -e "${_idst}" ]] || ! diff -rq "${_isrc}" "${_idst}" >/dev/null 2>&1; then
    project_dir "${_isrc}" "${_idst}"
  fi
done

# GTK theme payloads travel the same lane. The launch script projects every
# scheme-declared GTK_THEME at room start, but until 2026-07-27 the refresh
# never did — so a newly added scheme's GTK theme (the 19 real Win98 Plus!
# themes were the first victims) existed in the repo and appeared in the menu
# while every GTK app in the room silently fell back to Adwaita until the next
# full relaunch. Same defect class as the gap-fill trap above: the repo was
# right, the projection was the liar. Converge with the same rules — never
# replace symlinks, diff before copying, each distinct theme examined once.
mkdir -p "${GUEST_HOME}/.themes"
_seen_gtk=""
for _schemefile in "${REPO_ROOT}/linux/.config/redstone-9x/schemes/"*.scheme; do
  [[ -f "${_schemefile}" ]] || continue
  # shellcheck disable=SC1090
  _gtk="$(. "${_schemefile}"; printf %s "${GTK_THEME:-}")"
  [[ -n "${_gtk}" ]] || continue
  case ":${_seen_gtk}:" in *":${_gtk}:"*) continue ;; esac
  _seen_gtk="${_seen_gtk}:${_gtk}"
  _gsrc="${REPO_ROOT}/linux/.themes/${_gtk}"
  _gdst="${GUEST_HOME}/.themes/${_gtk}"
  [[ -d "${_gsrc}" ]] || continue
  [[ -L "${_gdst}" ]] && continue
  if [[ ! -e "${_gdst}" ]] || ! diff -rq "${_gsrc}" "${_gdst}" >/dev/null 2>&1; then
    project_dir "${_gsrc}" "${_gdst}"
  fi
done

# Icon themes are scheme assets too, and were the last projection gap in this
# lane (found 2026-07-30: the KDE-1-Classic-Silver-Curated theme existed in
# the repo, every KDE scheme declared it, the menu offered it — and the room
# fell back to hicolor because only the LAUNCH script links icon themes into
# the guest). The launcher's contract is per-theme symlinks into the repo
# (project_link), so existing links never go stale; the refresh only needs to
# create the links a post-launch theme is missing. Never touch a real
# directory here — a non-symlink entry is either a guest-local theme or the
# retirement quarantine's business, not ours.
mkdir -p "${GUEST_HOME}/.local/share/icons"
_seen_icons=""
for _schemefile in "${REPO_ROOT}/linux/.config/redstone-9x/schemes/"*.scheme; do
  [[ -f "${_schemefile}" ]] || continue
  # shellcheck disable=SC1090
  _icon="$(. "${_schemefile}"; printf %s "${ICON_THEME:-}")"
  [[ -n "${_icon}" ]] || continue
  case ":${_seen_icons}:" in *":${_icon}:"*) continue ;; esac
  _seen_icons="${_seen_icons}:${_icon}"
  _isrc="${REPO_ROOT}/linux/.local/share/icons/${_icon}"
  _idst="${GUEST_HOME}/.local/share/icons/${_icon}"
  [[ -d "${_isrc}" ]] || continue
  if [[ ! -e "${_idst}" && ! -L "${_idst}" ]]; then
    ln -sfnT "${_isrc}" "${_idst}"
    echo "[redstone-refresh] linked icon theme ${_icon}"
  fi
done

# Kvantum payloads are scheme assets too. A scheme whose GTK and IceWM layers
# arrived but whose KVANTUM_THEME did not would be only partially deployed:
# qt6ct would select Kvantum correctly, then Kvantum would silently fall back
# because its named theme was absent. Converge every declared directory with
# the same symlink-preserving, diff-before-copy contract as GTK and IceWM.
mkdir -p "${GUEST_HOME}/.config/Kvantum"
_seen_kvantum=""
for _schemefile in "${REPO_ROOT}/linux/.config/redstone-9x/schemes/"*.scheme; do
  [[ -f "${_schemefile}" ]] || continue
  # shellcheck disable=SC1090
  _kvantum="$(. "${_schemefile}"; printf %s "${KVANTUM_THEME:-}")"
  [[ -n "${_kvantum}" ]] || continue
  case ":${_seen_kvantum}:" in *":${_kvantum}:"*) continue ;; esac
  _seen_kvantum="${_seen_kvantum}:${_kvantum}"
  _ksrc="${REPO_ROOT}/linux/.config/Kvantum/${_kvantum}"
  _kdst="${GUEST_HOME}/.config/Kvantum/${_kvantum}"
  [[ -d "${_ksrc}" ]] || continue
  [[ -L "${_kdst}" ]] && continue
  if [[ ! -e "${_kdst}" ]] || ! diff -rq "${_ksrc}" "${_kdst}" >/dev/null 2>&1; then
    project_dir "${_ksrc}" "${_kdst}"
  fi
done

# Original theme sound sets use the same scheme declaration. Project only the
# named managed directories, leaving every unrelated guest sound untouched.
mkdir -p "${GUEST_HOME}/.local/share/sounds/schemes"
_seen_sounds=""
for _schemefile in "${REPO_ROOT}/linux/.config/redstone-9x/schemes/"*.scheme; do
  [[ -f "${_schemefile}" ]] || continue
  # shellcheck disable=SC1090
  _sound="$(. "${_schemefile}"; printf %s "${SOUND_SCHEME:-}")"
  [[ -n "${_sound}" ]] || continue
  case ":${_seen_sounds}:" in *":${_sound}:"*) continue ;; esac
  _seen_sounds="${_seen_sounds}:${_sound}"
  _ssrc="${REPO_ROOT}/linux/.local/share/sounds/schemes/${_sound}"
  _sdst="${GUEST_HOME}/.local/share/sounds/schemes/${_sound}"
  [[ -d "${_ssrc}" ]] || continue
  [[ -L "${_sdst}" ]] && continue
  if [[ ! -e "${_sdst}" ]] || ! diff -rq "${_ssrc}" "${_sdst}" >/dev/null 2>&1; then
    project_dir "${_ssrc}" "${_sdst}"
  fi
done

# Converge the managed desktop corpus while preserving unrelated user files.
rm -f "${GUEST_HOME}/Desktop/bash-ps.desktop"
for src in "${REPO_ROOT}/linux/.icewm/desktop/"*.desktop; do
  [[ -f "${src}" ]] || continue
  desktop_name="$(basename "${src}")"
  if [[ "${desktop_name}" == tomb-raider-*.desktop ]]; then
    project_file "${src}" "${GUEST_HOME}/Desktop/${desktop_name}" 755
  else
    project_file "${src}" "${GUEST_HOME}/Desktop/${desktop_name}"
  fi
done

scripts=(
  fxmixer
  ports-menu-gen
  ports-engine-run
  runcommand-shim
  sanctuary-flatpak-run
  sanctuary-sound
  redstone-9x-run
  redstone-9x-compat-init
  redstone-9x-pwsh
  redstone-9x-cmd
  redstone-9x-powershell
  redstone-9x-bash
  redstone-9x-zsh
  redstone-9x-clippy
  redstone-9x-place
  redstone-9x-disc
  redstone-9x-fonts-apply
  redstone-9x-dosemu2-init
  redstone-9x-dos
  redstone-9x-dosemu2-shell
  redstone-9x-dosbox-x
  redstone-9x-explorer
  redstone-9x-icons-grid
  redstone-9x-border-apply
  redstone-9x-menu-window-borders
  redstone-9x-nextstep-menu
  redstone-9x-nextstep-dockapps
  redstone-9x-ie
  redstone-9x-wine
  redstone-9x-rofi-run
  redstone-9x-rofi-desktop
  redstone-9x-rofi-launcher
  redstone-9x-rofi-emoji
  redstone-9x-rofi-clipboard
  redstone-9x-rofi-local-bin
  redstone-9x-vlc
  redstone-9x-openra
  redstone-9x-trx
  redstone-9x-trx-icons
  redstone-9x-micropolis
  redstone-9x-pinball
  redstone-9x-dsdmine
  redstone-9x-recycle-bin-watch
  redstone-9x-flatpak-session
  redstone-buildstamp
  redstone-buildstamp-generate
  redstone-9x-scheme-apply
  redstone-9x-icons-graft
  redstone-9x-host-gtk
  redstone-9x-menu-recent
  redstone-9x-menu-desktop
  redstone-9x-desktop-layout
  redstone-9x-program-tree
)

# Preserve the host-session bus that was resolved at launch. The live IceWM bus
# is the sanctuary-private bus, not the host Flatpak bus needed by host-spawn.
HOST_SESSION_BUS=""
if [[ -f "${GUEST_HOME}/.local/bin/redstone-9x-host-gtk" ]]; then
  HOST_SESSION_BUS="$(sed -n "s/^export DBUS_SESSION_BUS_ADDRESS='\(.*\)'$/\1/p" \
    "${GUEST_HOME}/.local/bin/redstone-9x-host-gtk" | head -n 1)"
fi
for name in "${scripts[@]}"; do
  project_file "${REPO_ROOT}/linux/.local/bin/${name}" "${GUEST_HOME}/.local/bin/${name}" 755
done
# The TRX runtime is a host bind visible only inside the sanctuary.  Run the
# small WebP -> PNG icon projection there, after the helper itself is staged;
# the desktop entries then point at guest-home files PCManFM can decode.
ICON_ENV=(
  "HOME=${GUEST_HOME}"
  "PATH=${GUEST_HOME}/.local/bin:${GUIX_PROFILES}/room-gaming/room-gaming/bin:/usr/local/bin:/usr/bin:/bin"
)
distrobox enter "${SANCTUARY}" -- env "${ICON_ENV[@]}" \
  "${GUEST_HOME}/.local/bin/redstone-9x-trx-icons" \
  || echo "redstone refresh: warning - TRX icon projection failed" >&2
project_file "${REPO_ROOT}/linux/.config/redstone-9x/buildstamp.conf" \
  "${GUEST_HOME}/.config/redstone-9x/buildstamp.conf"
project_file "${REPO_ROOT}/linux/.config/redstone-9x/placements.conf" \
  "${GUEST_HOME}/.config/redstone-9x/placements.conf"
HOME="${GUEST_HOME}" \
  XDG_DATA_HOME="${GUEST_HOME}/.local/share" \
  DOTCORTEX_ROOT="${REPO_ROOT}" \
  "${GUEST_HOME}/.local/bin/redstone-buildstamp-generate" \
  || echo "redstone refresh: warning - build-stamp metadata generation failed" >&2
sed -i "s|@HOST_SESSION_BUS@|${HOST_SESSION_BUS}|g" "${GUEST_HOME}/.local/bin/redstone-9x-host-gtk"
# Keep the runtime bus FILE in step with the token: sanctuary-flatpak-run and
# lutris-play read ~/.config/sanctuary/host-session-bus at click time.
if [[ -n "${HOST_SESSION_BUS}" ]]; then
  mkdir -p "${GUEST_HOME}/.config/sanctuary"
  printf '%s\n' "${HOST_SESSION_BUS}" > "${GUEST_HOME}/.config/sanctuary/host-session-bus"
fi

# Recreate the Run-box shell/terminal aliases after refreshing their targets.
ln -sfnT "${GUEST_HOME}/.local/bin/redstone-9x-cmd" "${GUEST_HOME}/.local/bin/cmd"
ln -sfnT "${GUEST_HOME}/.local/bin/redstone-9x-powershell" "${GUEST_HOME}/.local/bin/powershell"
ln -sfnT "${GUEST_HOME}/.local/bin/redstone-9x-bash" "${GUEST_HOME}/.local/bin/bash"
ln -sfnT "${GUEST_HOME}/.local/bin/redstone-9x-zsh" "${GUEST_HOME}/.local/bin/zsh"

# Scheme-specific public fonts are part of the lightweight appearance payload,
# just like GTK, IceWM, and Kvantum themes.  The launch path already projects
# this directory; refresh must converge it too or a newly selected scheme can
# request a family that is absent until the next full room relaunch.
mkdir -p "${GUEST_HOME}/.local/share/fonts/redstone-schemes"
for src in "${REPO_ROOT}/linux/.config/redstone-9x/fonts/"*.ttf; do
  [[ -f "${src}" ]] || continue
  project_file "${src}" \
    "${GUEST_HOME}/.local/share/fonts/redstone-schemes/$(basename "${src}")"
done

# Materialize and cache the private Godzilla XS terminal font, plus the
# scheme-specific faces above, before the active scheme regenerates the
# default URxVT module that names its terminal font.
"${GUEST_HOME}/.local/bin/redstone-9x-fonts-apply"

mkdir -p "${GUEST_HOME}/.config/redstone-9x/rofi" \
         "${GUEST_HOME}/.config/redstone-9x/powershell" \
         "${GUEST_HOME}/.config/gtk-3.0" \
         "${GUEST_HOME}/.config/qt6ct/colors"
for name in Windows95.rasi Windows95-Run.rasi config.rasi; do
  project_file "${REPO_ROOT}/linux/.config/redstone-9x/rofi/${name}" \
    "${GUEST_HOME}/.config/redstone-9x/rofi/${name}"
done
project_file "${REPO_ROOT}/linux/.config/redstone-9x/powershell/basic-repl.ps1" \
  "${GUEST_HOME}/.config/redstone-9x/powershell/basic-repl.ps1"
project_file "${REPO_ROOT}/linux/.config/powershell/Microsoft.PowerShell_profile.ps1" \
  "${GUEST_HOME}/.config/powershell/Microsoft.PowerShell_profile.ps1"
project_file "${REPO_ROOT}/linux/.config/redstone-9x/gtk-3.0/settings.ini" \
  "${GUEST_HOME}/.config/gtk-3.0/settings.ini"
project_file "${REPO_ROOT}/linux/.config/redstone-9x/gtk-3.0/gtk.css.in" \
  "${GUEST_HOME}/.config/gtk-3.0/gtk.css.in"
project_file "${REPO_ROOT}/linux/.config/redstone-9x/gtk-2.0/gtkrc" "${GUEST_HOME}/.gtkrc-2.0"
# Declarative desktop icon layout manifest. Projected, but deliberately NOT
# applied here: a refresh must not move icons the user has since dragged. Apply
# explicitly with `loom redstone:layout`.
project_file "${REPO_ROOT}/linux/.config/redstone-9x/desktop-layout.ssv" \
  "${GUEST_HOME}/.config/redstone-9x/desktop-layout.ssv"

project_dir "${REPO_ROOT}/linux/.config/redstone-9x/schemes" \
  "${GUEST_HOME}/.config/redstone-9x/schemes"
# Scheme wallpapers are a managed directory too.  Project every declared
# wallpaper before --boot reapplies the active scheme, preserving the separate
# KDE 1 Historical symlink under Pictures/Wallpaper above.
project_dir "${WALLPAPER_SOURCE}" "${WALLPAPER_TARGET}"
# Wine classic-colour registries: a scheme's WINE_COLORS reg must reach the
# running room too, else a newly added palette (e.g. beos-r5.reg) is invisible
# until a full relaunch — the schemes/ projection alone was not enough.
project_dir "${REPO_ROOT}/linux/.config/redstone-9x/wine" \
  "${GUEST_HOME}/.config/redstone-9x/wine"
project_file "${REPO_ROOT}/linux/.config/redstone-9x/qt6ct/qt6ct.conf" \
  "${GUEST_HOME}/.config/qt6ct/qt6ct.conf"
for src in "${REPO_ROOT}/linux/.config/redstone-9x/qt6ct/colors/"*.conf; do
  [[ -f "${src}" ]] || continue
  project_file "${src}" "${GUEST_HOME}/.config/qt6ct/colors/$(basename "${src}")"
done
sed -i "s|@GUEST_QT6CT_COLORS@|${GUEST_HOME}/.config/qt6ct/colors/win95.conf|g" \
  "${GUEST_HOME}/.config/qt6ct/qt6ct.conf"

# Shell identity files are intentionally live links; the sanctuary-local zshrc
# owns only the themed module and delegates the rest to the global zsh config.
mkdir -p "${GUEST_HOME}/.config/fastfetch"
ln -sfnT "${REPO_ROOT}/linux/.config/redstone-9x/fastfetch.jsonc" \
  "${GUEST_HOME}/.config/fastfetch/config.jsonc"
ln -sfnT "${REPO_ROOT}/linux/.config/redstone-9x/shell/bashrc" "${GUEST_HOME}/.bashrc"
ln -sfnT "${REPO_ROOT}/linux/.config/redstone-9x/shell/bash_profile" "${GUEST_HOME}/.bash_profile"
ln -sfnT "${REPO_ROOT}/linux/.config/redstone-9x/shell/zshrc" "${GUEST_HOME}/.zshrc"

# File effects only: regenerate the active scheme's terminal module, IceWM
# theme pointer, GTK/Qt files, icon graft, and sound links without process surgery.
HOME="${GUEST_HOME}" /bin/bash "${GUEST_HOME}/.local/bin/redstone-9x-scheme-apply" \
  --boot "${ACTIVE_SCHEME}"

# Reproject the Programs menu as a browsable directory tree. Must run AFTER the
# menu above, since it parses the substituted guest copy, and it re-runs the
# dynamic Ports/Lutris generators so their snapshots track the real library.
# Non-fatal: a broken generator must never take a refresh down with it.
HOME="${GUEST_HOME}" /bin/bash "${GUEST_HOME}/.local/bin/redstone-9x-program-tree" \
  || echo "redstone refresh: warning - program tree projection failed" >&2

if (( RELOAD )); then
  LIVE_DBUS="$(proc_env_value "${ICEWM_PID}" DBUS_SESSION_BUS_ADDRESS 2>/dev/null || true)"
  LIVE_XAUTHORITY="$(proc_env_value "${ICEWM_PID}" XAUTHORITY 2>/dev/null || true)"
  LIVE_XDG_CONFIG_HOME="$(proc_env_value "${ICEWM_PID}" XDG_CONFIG_HOME 2>/dev/null || true)"
  LIVE_XDG_DATA_HOME="$(proc_env_value "${ICEWM_PID}" XDG_DATA_HOME 2>/dev/null || true)"
  LIVE_XDG_CACHE_HOME="$(proc_env_value "${ICEWM_PID}" XDG_CACHE_HOME 2>/dev/null || true)"
  LIVE_XDG_RUNTIME_DIR="$(proc_env_value "${ICEWM_PID}" XDG_RUNTIME_DIR 2>/dev/null || true)"
  [[ -n "${LIVE_XAUTHORITY}" ]] || LIVE_XAUTHORITY="${HOME}/.Xauthority"
  [[ -n "${LIVE_XDG_CONFIG_HOME}" ]] || LIVE_XDG_CONFIG_HOME="${GUEST_HOME}/.config"
  [[ -n "${LIVE_XDG_DATA_HOME}" ]] || LIVE_XDG_DATA_HOME="${GUEST_HOME}/.local/share"
  [[ -n "${LIVE_XDG_CACHE_HOME}" ]] || LIVE_XDG_CACHE_HOME="${GUEST_HOME}/.cache"
  [[ -n "${LIVE_XDG_RUNTIME_DIR}" ]] || LIVE_XDG_RUNTIME_DIR="/run/user/$(id -u)"
  LIVE_PATH="${GUEST_HOME}/.local/bin:${GUIX_PROFILES}/desktop-common/desktop-common/bin:${GUIX_PROFILES}/room-gaming/room-gaming/bin:${GUIX_PROFILES}/room-windows-compat/room-windows-compat/bin:/usr/local/bin:/usr/bin:/bin"
  env_args=(
    "HOME=${GUEST_HOME}"
    "DISPLAY=${DISPLAY_NUM}"
    "XAUTHORITY=${LIVE_XAUTHORITY}"
    "XDG_CONFIG_HOME=${LIVE_XDG_CONFIG_HOME}"
    "XDG_DATA_HOME=${LIVE_XDG_DATA_HOME}"
    "XDG_CACHE_HOME=${LIVE_XDG_CACHE_HOME}"
    "XDG_RUNTIME_DIR=${LIVE_XDG_RUNTIME_DIR}"
    "PATH=${LIVE_PATH}"
  )
  [[ -z "${LIVE_DBUS}" ]] || env_args+=("DBUS_SESSION_BUS_ADDRESS=${LIVE_DBUS}")
  echo "[redstone-refresh] reloading IceWM on ${DISPLAY_NUM}"
  distrobox enter "${SANCTUARY}" -- env "${env_args[@]}" icewm -r
  sleep 1
  echo "[redstone-refresh] refreshing desktop build stamp on ${DISPLAY_NUM}"
  distrobox enter "${SANCTUARY}" -- env "${env_args[@]}" \
    "${GUEST_HOME}/.local/bin/redstone-buildstamp" refresh
fi

echo "[redstone-refresh] complete (scheme=${ACTIVE_SCHEME}, reload=${RELOAD})"
# Live refresh helper:1 ends here
