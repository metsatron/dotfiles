#!/usr/bin/env bash
# Live refresh helper

# This is the supported bridge between tangled DotCortex output and an already-running
# Redstone 9X room.  It refreshes only the lightweight, guest-home projection layer;
# Guix profiles, process-start environment, mounts, Xephyr geometry, and session startup
# still require a full sanctuary relaunch.


# [[file:../../../sanctuary-redstone-9x-refresh.org::*Live refresh helper][Live refresh helper:1]]
set -Eeuo pipefail

SANCTUARY="sanctuary-redstone-9x"
DISPLAY_NUM=":93"
REPO_ROOT="${DOTCORTEX_ROOT:-${HOME}/DotCortex}"
GUESTS_DIR="${XDG_DATA_HOME:-${HOME}/.local/share}/dotcortex/guests"
GUEST_HOME="${GUESTS_DIR}/${SANCTUARY}/home"
GUIX_PROFILES="${HOME}/.guix-extra-profiles"
MODE="refresh"
RELOAD=1

usage() {
  cat <<'EOF'
sanctuary-redstone-9x-refresh - refresh the running Redstone 9X projection

Usage:
  sanctuary-redstone-9x-refresh [--check] [--no-reload]

  --check       report whether the room and key projected files are current
  --no-reload   project files and reapply the active scheme without reloading IceWM
  -h, --help    show this help

This command is for guest-home configuration: IceWM menu/toolbar/preferences,
desktop launchers, Redstone wrappers, shell/rofi config, and Desktop Schemes.
Relaunch the sanctuary after profile, environment, mount, Xephyr, or startup-process
changes. Never copy files into the guest by hand; use `loom redstone:refresh`.
EOF
}

while (( $# )); do
  case "$1" in
    --check) MODE="check" ;;
    --no-reload) RELOAD=0 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "redstone refresh: unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

die() {
  echo "redstone refresh: ERROR - $*" >&2
  exit 1
}

proc_env_value() {
  local pid="$1" key="$2"
  [[ -r "/proc/${pid}/environ" ]] || return 1
  tr '\0' '\n' < "/proc/${pid}/environ" | sed -n "s/^${key}=//p" | head -n 1
}

find_room_icewm() {
  local pid display
  while read -r pid; do
    [[ -n "${pid}" ]] || continue
    display="$(proc_env_value "${pid}" DISPLAY 2>/dev/null || true)"
    if [[ "${display}" == "${DISPLAY_NUM}" || "${display}" == "${DISPLAY_NUM}.0" ]]; then
      printf '%s\n' "${pid}"
      return 0
    fi
  done < <(pgrep -x icewm 2>/dev/null || true)
  return 1
}

[[ -d "${REPO_ROOT}/linux" ]] || die "DotCortex checkout not found: ${REPO_ROOT}"
[[ -d "${GUEST_HOME}" ]] || die "guest home missing: ${GUEST_HOME}"
[[ -S /tmp/.X11-unix/X93 ]] || die "Xephyr ${DISPLAY_NUM} is not running"
ICEWM_PID="$(find_room_icewm || true)"
[[ -n "${ICEWM_PID}" ]] || die "no IceWM process belongs to ${DISPLAY_NUM}"

ACTIVE_SCHEME="$(cat "${GUEST_HOME}/.config/redstone-9x/scheme" 2>/dev/null || echo windows-95)"
SCHEME_SOURCE="${REPO_ROOT}/linux/.config/redstone-9x/schemes/${ACTIVE_SCHEME}.scheme"
if [[ ! -f "${SCHEME_SOURCE}" ]]; then
  echo "redstone refresh: warning - unknown active scheme '${ACTIVE_SCHEME}'; using windows-95" >&2
  ACTIVE_SCHEME="windows-95"
  SCHEME_SOURCE="${REPO_ROOT}/linux/.config/redstone-9x/schemes/windows-95.scheme"
fi
[[ -f "${SCHEME_SOURCE}" ]] || die "baseline scheme missing: ${SCHEME_SOURCE}"

key_pairs=(
  "linux/.icewm/menu|.icewm/menu"
  "linux/.icewm/toolbar|.icewm/toolbar"
  "linux/.icewm/preferences|.icewm/preferences"
  "linux/.icewm/winoptions|.icewm/winoptions"
  "linux/.icewm/startup|.icewm/startup"
  "linux/.local/bin/redstone-buildstamp|.local/bin/redstone-buildstamp"
  "linux/.local/bin/redstone-buildstamp-generate|.local/bin/redstone-buildstamp-generate"
  "linux/.config/redstone-9x/buildstamp.conf|.config/redstone-9x/buildstamp.conf"
  "linux/.local/bin/redstone-9x-zsh|.local/bin/redstone-9x-zsh"
  "linux/.local/bin/redstone-9x-bash|.local/bin/redstone-9x-bash"
  "linux/.local/bin/redstone-9x-fonts-apply|.local/bin/redstone-9x-fonts-apply"
  "linux/.local/bin/redstone-9x-dosemu2-shell|.local/bin/redstone-9x-dosemu2-shell"
  "linux/.icewm/desktop/bash-cmd.desktop|Desktop/bash-cmd.desktop"
  "linux/.icewm/desktop/dosemu2.desktop|Desktop/dosemu2.desktop"
)

if [[ "${MODE}" == "check" ]]; then
  stale=0
  for pair in "${key_pairs[@]}"; do
    src="${REPO_ROOT}/${pair%%|*}"
    dst="${GUEST_HOME}/${pair#*|}"
    if [[ ! -f "${dst}" ]]; then
      printf 'MISSING  %s\n' "${pair#*|}"
      stale=$((stale + 1))
    elif [[ "${pair#*|}" == ".icewm/menu" ]]; then
      if ! sed \
        -e "s|@ROOM_QT6_PLUGINS@|${GUIX_PROFILES}/room-gaming/room-gaming/lib/qt6/plugins|g" \
        -e "s|@DESKTOP_COMMON_SSL_CERT@|${GUIX_PROFILES}/desktop-common/desktop-common/etc/ssl/certs/ca-certificates.crt|g" \
        "${src}" | cmp -s - "${dst}"; then
        printf 'STALE    %s\n' "${pair#*|}"
        stale=$((stale + 1))
      fi
    elif ! cmp -s "${src}" "${dst}"; then
      printf 'STALE    %s\n' "${pair#*|}"
      stale=$((stale + 1))
    fi
  done
  if [[ -e "${GUEST_HOME}/Desktop/bash-ps.desktop" ]]; then
    printf 'OBSOLETE Desktop/bash-ps.desktop\n'
    stale=$((stale + 1))
  fi
  if [[ ! -f "${GUEST_HOME}/.config/redstone-9x/terminal-theme.zsh" ]]; then
    printf 'MISSING  .config/redstone-9x/terminal-theme.zsh\n'
    stale=$((stale + 1))
  fi
  if [[ ! -f "${GUEST_HOME}/.local/share/redstone-9x/build.ini" ]]; then
    printf 'MISSING  .local/share/redstone-9x/build.ini\n'
    stale=$((stale + 1))
  fi
  if ! "${REPO_ROOT}/linux/.local/bin/redstone-9x-fonts-apply" --check >/dev/null 2>&1; then
    printf 'MISSING  font: PxPlus IBM VGA 9x14\n'
    stale=$((stale + 1))
  fi
  printf 'room=%s display=%s icewm_pid=%s scheme=%s stale=%d\n' \
    "${SANCTUARY}" "${DISPLAY_NUM}" "${ICEWM_PID}" "${ACTIVE_SCHEME}" "${stale}"
  (( stale == 0 ))
  exit
fi

project_file() {
  local src="$1" dst="$2" mode="${3:-}"
  [[ -f "${src}" ]] || die "managed source missing: ${src}"
  mkdir -p "$(dirname "${dst}")"
  rm -f -- "${dst}"
  cp -f -- "${src}" "${dst}"
  [[ -z "${mode}" ]] || chmod "${mode}" "${dst}"
}

project_dir() {
  local src="$1" dst="$2" tmp="${2}.refresh-tmp"
  [[ -d "${src}" ]] || die "managed source directory missing: ${src}"
  mkdir -p "$(dirname "${dst}")"
  rm -rf -- "${tmp}"
  cp -a -- "${src}" "${tmp}"
  rm -rf -- "${dst}"
  mv -- "${tmp}" "${dst}"
}

echo "[redstone-refresh] projecting lightweight config into ${GUEST_HOME}"

mkdir -p "${GUEST_HOME}/.icewm" "${GUEST_HOME}/Desktop" "${GUEST_HOME}/.local/bin"
for name in preferences menu toolbar keys winoptions startup; do
  mode=""
  [[ "${name}" == "startup" ]] && mode="755"
  project_file "${REPO_ROOT}/linux/.icewm/${name}" "${GUEST_HOME}/.icewm/${name}" "${mode}"
done
project_dir "${REPO_ROOT}/linux/.icewm/menu-buttons" "${GUEST_HOME}/.icewm/menu-buttons"
sed -i \
  -e "s|@ROOM_QT6_PLUGINS@|${GUIX_PROFILES}/room-gaming/room-gaming/lib/qt6/plugins|g" \
  -e "s|@DESKTOP_COMMON_SSL_CERT@|${GUIX_PROFILES}/desktop-common/desktop-common/etc/ssl/certs/ca-certificates.crt|g" \
  "${GUEST_HOME}/.icewm/menu"

# Converge the managed desktop corpus while preserving unrelated user files.
rm -f "${GUEST_HOME}/Desktop/bash-ps.desktop"
for src in "${REPO_ROOT}/linux/.icewm/desktop/"*.desktop; do
  [[ -f "${src}" ]] || continue
  project_file "${src}" "${GUEST_HOME}/Desktop/$(basename "${src}")"
done

scripts=(
  fxmixer
  ports-menu-gen
  runcommand-shim
  sanctuary-flatpak-run
  sanctuary-sound
  redstone-9x-run
  redstone-9x-compat-init
  redstone-9x-pwsh
  redstone-9x-cmd
  redstone-9x-powershell
  redstone-9x-bash
  redstone-9x-zsh
  redstone-9x-fonts-apply
  redstone-9x-dosemu2-init
  redstone-9x-dos
  redstone-9x-dosemu2-shell
  redstone-9x-dosbox-x
  redstone-9x-explorer
  redstone-9x-icons-grid
  redstone-9x-ie
  redstone-9x-wine
  redstone-9x-rofi-run
  redstone-9x-rofi-desktop
  redstone-9x-rofi-launcher
  redstone-9x-rofi-emoji
  redstone-9x-rofi-clipboard
  redstone-9x-rofi-local-bin
  redstone-9x-vlc
  redstone-9x-openra
  redstone-9x-micropolis
  redstone-9x-pinball
  redstone-9x-dsdmine
  redstone-9x-recycle-bin-watch
  redstone-9x-flatpak-session
  redstone-buildstamp
  redstone-buildstamp-generate
  redstone-9x-scheme-apply
  redstone-9x-icons-graft
  redstone-9x-host-gtk
  redstone-9x-menu-recent
  redstone-9x-menu-desktop
)

# Preserve the host-session bus that was resolved at launch. The live IceWM bus
# is the sanctuary-private bus, not the host Flatpak bus needed by host-spawn.
HOST_SESSION_BUS=""
if [[ -f "${GUEST_HOME}/.local/bin/redstone-9x-host-gtk" ]]; then
  HOST_SESSION_BUS="$(sed -n "s/^export DBUS_SESSION_BUS_ADDRESS='\(.*\)'$/\1/p" \
    "${GUEST_HOME}/.local/bin/redstone-9x-host-gtk" | head -n 1)"
fi
for name in "${scripts[@]}"; do
  project_file "${REPO_ROOT}/linux/.local/bin/${name}" "${GUEST_HOME}/.local/bin/${name}" 755
done
project_file "${REPO_ROOT}/linux/.config/redstone-9x/buildstamp.conf" \
  "${GUEST_HOME}/.config/redstone-9x/buildstamp.conf"
HOME="${GUEST_HOME}" \
  XDG_DATA_HOME="${GUEST_HOME}/.local/share" \
  DOTCORTEX_ROOT="${REPO_ROOT}" \
  "${GUEST_HOME}/.local/bin/redstone-buildstamp-generate" \
  || echo "redstone refresh: warning - build-stamp metadata generation failed" >&2
sed -i "s|@HOST_SESSION_BUS@|${HOST_SESSION_BUS}|g" "${GUEST_HOME}/.local/bin/redstone-9x-host-gtk"
# Keep the runtime bus FILE in step with the token: sanctuary-flatpak-run and
# lutris-play read ~/.config/sanctuary/host-session-bus at click time.
if [[ -n "${HOST_SESSION_BUS}" ]]; then
  mkdir -p "${GUEST_HOME}/.config/sanctuary"
  printf '%s\n' "${HOST_SESSION_BUS}" > "${GUEST_HOME}/.config/sanctuary/host-session-bus"
fi

# Recreate the Run-box shell/terminal aliases after refreshing their targets.
ln -sfnT "${GUEST_HOME}/.local/bin/redstone-9x-cmd" "${GUEST_HOME}/.local/bin/cmd"
ln -sfnT "${GUEST_HOME}/.local/bin/redstone-9x-powershell" "${GUEST_HOME}/.local/bin/powershell"
ln -sfnT "${GUEST_HOME}/.local/bin/redstone-9x-bash" "${GUEST_HOME}/.local/bin/bash"
ln -sfnT "${GUEST_HOME}/.local/bin/redstone-9x-zsh" "${GUEST_HOME}/.local/bin/zsh"

# Materialize and cache the private Godzilla XS terminal font before the active
# scheme regenerates the default URxVT module that names it.
"${GUEST_HOME}/.local/bin/redstone-9x-fonts-apply"

mkdir -p "${GUEST_HOME}/.config/redstone-9x/rofi" \
         "${GUEST_HOME}/.config/redstone-9x/powershell" \
         "${GUEST_HOME}/.config/gtk-3.0" \
         "${GUEST_HOME}/.config/qt6ct/colors"
for name in Windows95.rasi Windows95-Run.rasi config.rasi; do
  project_file "${REPO_ROOT}/linux/.config/redstone-9x/rofi/${name}" \
    "${GUEST_HOME}/.config/redstone-9x/rofi/${name}"
done
project_file "${REPO_ROOT}/linux/.config/redstone-9x/powershell/basic-repl.ps1" \
  "${GUEST_HOME}/.config/redstone-9x/powershell/basic-repl.ps1"
project_file "${REPO_ROOT}/linux/.config/powershell/Microsoft.PowerShell_profile.ps1" \
  "${GUEST_HOME}/.config/powershell/Microsoft.PowerShell_profile.ps1"
project_file "${REPO_ROOT}/linux/.config/redstone-9x/gtk-3.0/settings.ini" \
  "${GUEST_HOME}/.config/gtk-3.0/settings.ini"
project_file "${REPO_ROOT}/linux/.config/redstone-9x/gtk-3.0/gtk.css.in" \
  "${GUEST_HOME}/.config/gtk-3.0/gtk.css.in"
project_file "${REPO_ROOT}/linux/.config/redstone-9x/gtk-2.0/gtkrc" "${GUEST_HOME}/.gtkrc-2.0"

project_dir "${REPO_ROOT}/linux/.config/redstone-9x/schemes" \
  "${GUEST_HOME}/.config/redstone-9x/schemes"
# Wine classic-colour registries: a scheme's WINE_COLORS reg must reach the
# running room too, else a newly added palette (e.g. beos-r5.reg) is invisible
# until a full relaunch — the schemes/ projection alone was not enough.
project_dir "${REPO_ROOT}/linux/.config/redstone-9x/wine" \
  "${GUEST_HOME}/.config/redstone-9x/wine"
project_file "${REPO_ROOT}/linux/.config/redstone-9x/qt6ct/qt6ct.conf" \
  "${GUEST_HOME}/.config/qt6ct/qt6ct.conf"
for src in "${REPO_ROOT}/linux/.config/redstone-9x/qt6ct/colors/"*.conf; do
  [[ -f "${src}" ]] || continue
  project_file "${src}" "${GUEST_HOME}/.config/qt6ct/colors/$(basename "${src}")"
done
sed -i "s|@GUEST_QT6CT_COLORS@|${GUEST_HOME}/.config/qt6ct/colors/win95.conf|g" \
  "${GUEST_HOME}/.config/qt6ct/qt6ct.conf"

# Shell identity files are intentionally live links; the sanctuary-local zshrc
# owns only the themed module and delegates the rest to the global zsh config.
mkdir -p "${GUEST_HOME}/.config/fastfetch"
ln -sfnT "${REPO_ROOT}/linux/.config/redstone-9x/fastfetch.jsonc" \
  "${GUEST_HOME}/.config/fastfetch/config.jsonc"
ln -sfnT "${REPO_ROOT}/linux/.config/redstone-9x/shell/bashrc" "${GUEST_HOME}/.bashrc"
ln -sfnT "${REPO_ROOT}/linux/.config/redstone-9x/shell/bash_profile" "${GUEST_HOME}/.bash_profile"
ln -sfnT "${REPO_ROOT}/linux/.config/redstone-9x/shell/zshrc" "${GUEST_HOME}/.zshrc"

# File effects only: regenerate the active scheme's terminal module, IceWM
# theme pointer, GTK/Qt files, icon graft, and sound links without process surgery.
HOME="${GUEST_HOME}" /bin/bash "${GUEST_HOME}/.local/bin/redstone-9x-scheme-apply" \
  --boot "${ACTIVE_SCHEME}"

if (( RELOAD )); then
  LIVE_DBUS="$(proc_env_value "${ICEWM_PID}" DBUS_SESSION_BUS_ADDRESS 2>/dev/null || true)"
  LIVE_XAUTHORITY="$(proc_env_value "${ICEWM_PID}" XAUTHORITY 2>/dev/null || true)"
  LIVE_XDG_CONFIG_HOME="$(proc_env_value "${ICEWM_PID}" XDG_CONFIG_HOME 2>/dev/null || true)"
  LIVE_XDG_DATA_HOME="$(proc_env_value "${ICEWM_PID}" XDG_DATA_HOME 2>/dev/null || true)"
  LIVE_XDG_CACHE_HOME="$(proc_env_value "${ICEWM_PID}" XDG_CACHE_HOME 2>/dev/null || true)"
  LIVE_XDG_RUNTIME_DIR="$(proc_env_value "${ICEWM_PID}" XDG_RUNTIME_DIR 2>/dev/null || true)"
  [[ -n "${LIVE_XAUTHORITY}" ]] || LIVE_XAUTHORITY="${HOME}/.Xauthority"
  [[ -n "${LIVE_XDG_CONFIG_HOME}" ]] || LIVE_XDG_CONFIG_HOME="${GUEST_HOME}/.config"
  [[ -n "${LIVE_XDG_DATA_HOME}" ]] || LIVE_XDG_DATA_HOME="${GUEST_HOME}/.local/share"
  [[ -n "${LIVE_XDG_CACHE_HOME}" ]] || LIVE_XDG_CACHE_HOME="${GUEST_HOME}/.cache"
  [[ -n "${LIVE_XDG_RUNTIME_DIR}" ]] || LIVE_XDG_RUNTIME_DIR="/run/user/$(id -u)"
  LIVE_PATH="${GUEST_HOME}/.local/bin:${GUIX_PROFILES}/desktop-common/desktop-common/bin:${GUIX_PROFILES}/room-gaming/room-gaming/bin:${GUIX_PROFILES}/room-windows-compat/room-windows-compat/bin:/usr/local/bin:/usr/bin:/bin"
  env_args=(
    "HOME=${GUEST_HOME}"
    "DISPLAY=${DISPLAY_NUM}"
    "XAUTHORITY=${LIVE_XAUTHORITY}"
    "XDG_CONFIG_HOME=${LIVE_XDG_CONFIG_HOME}"
    "XDG_DATA_HOME=${LIVE_XDG_DATA_HOME}"
    "XDG_CACHE_HOME=${LIVE_XDG_CACHE_HOME}"
    "XDG_RUNTIME_DIR=${LIVE_XDG_RUNTIME_DIR}"
    "PATH=${LIVE_PATH}"
  )
  [[ -z "${LIVE_DBUS}" ]] || env_args+=("DBUS_SESSION_BUS_ADDRESS=${LIVE_DBUS}")
  echo "[redstone-refresh] reloading IceWM on ${DISPLAY_NUM}"
  distrobox enter "${SANCTUARY}" -- env "${env_args[@]}" icewm -r
  sleep 1
  echo "[redstone-refresh] refreshing desktop build stamp on ${DISPLAY_NUM}"
  distrobox enter "${SANCTUARY}" -- env "${env_args[@]}" \
    "${GUEST_HOME}/.local/bin/redstone-buildstamp" refresh
fi

echo "[redstone-refresh] complete (scheme=${ACTIVE_SCHEME}, reload=${RELOAD})"
# Live refresh helper:1 ends here
