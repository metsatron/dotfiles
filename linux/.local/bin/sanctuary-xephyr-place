#!/usr/bin/env bash
# [[file:../../../sanctuary-distrobox.org::*Sanctuary Launcher Scripts][Sanctuary Launcher Scripts:9]]
# sanctuary-xephyr-place — correct Xephyr's host window after it is ready.
# Some Xephyr builds honor -output for the nested root but place the fullscreen
# host window at a rotated monitor's origin. Every sanctuary calls this one
# helper after xdpyinfo succeeds, so placement is one declarative policy.
set -euo pipefail

display_num="${1:?guest Xephyr display required, e.g. :94}"
host_display="${2:-${DISPLAY:-}}"
sanctuary_name="${3:-sanctuary}"

command -v xrandr >/dev/null 2>&1 || exit 0
command -v wmctrl >/dev/null 2>&1 || exit 0
command -v xdotool >/dev/null 2>&1 || exit 0
[[ -n "${host_display}" ]] || exit 0

xrandr_output="$(DISPLAY="${host_display}" xrandr --query 2>/dev/null || true)"
[[ -n "${xrandr_output}" ]] || exit 0
output="$(sanctuary-xephyr-output "${host_display}" 2>/dev/null || true)"
[[ -n "${output}" ]] || exit 0

line="$(printf '%s\n' "${xrandr_output}" | awk -v output="${output}" '$1 == output && $2 == "connected" { print; exit }')"
geometry="$(printf '%s\n' "${line}" | sed -n 's/.* connected\( primary\)\? \([0-9][0-9]*x[0-9][0-9]*[+-][0-9][0-9]*[+-][0-9][0-9]*\).*/\2/p')"
if [[ ! "${geometry}" =~ ^([0-9]+)x([0-9]+)([+-][0-9]+)([+-][0-9]+)$ ]]; then
  echo "${sanctuary_name}: could not parse host geometry for output ${output}; leaving Xephyr placement unchanged" >&2
  exit 0
fi
width="${BASH_REMATCH[1]}"
height="${BASH_REMATCH[2]}"
x="${BASH_REMATCH[3]#+}"
y="${BASH_REMATCH[4]#+}"
window_name="Xephyr on ${display_num}.0 xephyr"

for _ in {1..50}; do
  window_id="$(DISPLAY="${host_display}" xdotool search --onlyvisible --name "${window_name}" 2>/dev/null | head -n 1 || true)"
  if [[ -n "${window_id}" ]]; then
    DISPLAY="${host_display}" wmctrl -i -r "${window_id}" -b remove,fullscreen || true
    DISPLAY="${host_display}" wmctrl -i -r "${window_id}" -e "0,${x},${y},${width},${height}" || true
    DISPLAY="${host_display}" wmctrl -i -r "${window_id}" -b add,fullscreen || true
    DISPLAY="${host_display}" wmctrl -i -r "${window_id}" -b add,above || true
    echo "${sanctuary_name}: Xephyr placed on ${output} (${geometry})"
    exit 0
  fi
  sleep 0.1
done
echo "${sanctuary_name}: could not find the Xephyr host window for output placement" >&2
# Sanctuary Launcher Scripts:9 ends here
