#!/bin/bash
# [[file:../../../sanctuary-cortex.org::*Private migration bridges][Private migration bridges:8]]
set -euo pipefail

if [[ -z "${SANCTUARY_HOST_HOME:-}" ]]; then
  case "$HOME" in
    */.local/share/dotcortex/guests/*/home)
      echo "sanctuary-cortex-appimage-bridge: SANCTUARY_HOST_HOME is required inside a guest" >&2
      exit 2
      ;;
    *) SANCTUARY_HOST_HOME="$HOME" ;;
  esac
fi

HOST_HOME="$SANCTUARY_HOST_HOME"
GUEST_HOME="${SANCTUARY_CORTEX_GUEST_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/dotcortex/guests/sanctuary-cortex/home}"
SOURCE="$HOST_HOME/.local/share/applications"
DEST="$GUEST_HOME/.local/share/applications"
WRAPPER="$GUEST_HOME/.local/bin/sanctuary-cortex-appimage-run"

[[ -d "$SOURCE" ]] || {
  echo "sanctuary-cortex-appimage-bridge: host application directory is absent: $SOURCE" >&2
  exit 0
}
[[ -x "$WRAPPER" ]] || {
  echo "sanctuary-cortex-appimage-bridge: missing guest runner: $WRAPPER" >&2
  exit 1
}

mkdir -p "$DEST"

while IFS= read -r -d '' stale; do
  if grep -q '^X-Sanctuary-AppImage=true$' "$stale" 2>/dev/null; then
    rm -f "$stale"
  fi
done < <(find "$DEST" -maxdepth 1 -type f -name 'sanctuary-appimage-*.desktop' -print0)

mapfile -t desktop_files < <(
  find "$SOURCE" -maxdepth 1 -type f -name 'appimagekit_*.desktop' -print \
    | sort
)

projected=0
for source in "${desktop_files[@]}"; do
  grep -q '^Exec=.*appimaged.*wrap' "$source" || continue
  basename="${source##*/}"
  target="$DEST/sanctuary-appimage-$basename"
  temporary="$(mktemp "$DEST/.sanctuary-appimage.XXXXXX.desktop")"
  rewritten=0

  while IFS= read -r line || [[ -n "$line" ]]; do
    case "$line" in
      '[Desktop Entry]')
        printf '%s\n' "$line" >> "$temporary"
        printf 'X-Sanctuary-AppImage=true\n' >> "$temporary"
        ;;
      Exec=*)
        payload="${line#Exec=}"
        quoted_prefix="\"$HOST_HOME/.local/bin/appimaged\" wrap "
        plain_prefix="$HOST_HOME/.local/bin/appimaged wrap "
        if [[ "$payload" == "$quoted_prefix"* ]]; then
          rest="${payload#"$quoted_prefix"}"
          printf 'Exec=%s %s\n' "$WRAPPER" "$rest" >> "$temporary"
          rewritten=1
        elif [[ "$payload" == "$plain_prefix"* ]]; then
          rest="${payload#"$plain_prefix"}"
          printf 'Exec=%s %s\n' "$WRAPPER" "$rest" >> "$temporary"
          rewritten=1
        else
          printf '%s\n' "$line" >> "$temporary"
        fi
        ;;
      TryExec=*)
        ;;
      *)
        printf '%s\n' "$line" >> "$temporary"
        ;;
    esac
  done < "$source"

  if [[ "$rewritten" -eq 1 ]]; then
    if command -v desktop-file-validate >/dev/null 2>&1; then
      desktop-file-validate "$temporary"
    fi
    mv -f "$temporary" "$target"
    projected=$((projected + 1))
  else
    rm -f "$temporary"
  fi
done

if command -v update-desktop-database >/dev/null 2>&1; then
  update-desktop-database "$DEST" >/dev/null 2>&1 || true
fi

printf 'sanctuary-cortex-appimage-bridge: projected %d desktop files into %s\n' \
  "$projected" "$DEST"
# Private migration bridges:8 ends here
