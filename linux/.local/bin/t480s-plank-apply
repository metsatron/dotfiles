#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: t480s-plank-apply

Materialize the declared T480s Plank launchers and load their ordered dconf key.

Environment overrides:
  PLANK_LAUNCHER_MANIFEST  Launcher manifest path
  PLANK_DCONF_SOURCE       Plank dconf input path
  PLANK_CONFIG_HOME        Plank configuration directory
  DCONF_BIN                dconf-compatible executable
EOF
}

case "${1-}" in
  -h|--help) usage; exit 0 ;;
  '') ;;
  *) usage >&2; exit 2 ;;
esac

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
manifest="${PLANK_LAUNCHER_MANIFEST:-$config_home/dotcortex/plank-launchers.ssv}"
dconf_source="${PLANK_DCONF_SOURCE:-$config_home/plank/plank.dconf}"
plank_home="${PLANK_CONFIG_HOME:-$config_home/plank}"
dconf_bin="${DCONF_BIN:-/usr/bin/dconf}"
launcher_dir="$plank_home/dock1/launchers"
tmp=
cleanup() {
  [[ -z "${tmp:-}" ]] || rm -f -- "$tmp"
}
trap cleanup EXIT

[[ -r "$manifest" ]] || { printf 't480s-plank-apply: missing manifest: %s\n' "$manifest" >&2; exit 1; }
[[ -r "$dconf_source" ]] || { printf 't480s-plank-apply: missing dconf source: %s\n' "$dconf_source" >&2; exit 1; }
command -v "$dconf_bin" >/dev/null 2>&1 || { printf 't480s-plank-apply: dconf executable not found: %s\n' "$dconf_bin" >&2; exit 1; }

declare -a dockitems=()
declare -A seen=()
while read -r dockitem launcher extra; do
  [[ -n "${dockitem:-}" ]] || continue
  [[ "$dockitem" == \#* ]] && continue
  [[ -z "${extra:-}" ]] || { printf 't480s-plank-apply: malformed manifest row: %s\n' "$dockitem" >&2; exit 1; }
  [[ "$dockitem" == *.dockitem && "$dockitem" != */* ]] \
    || { printf 't480s-plank-apply: invalid dockitem name: %s\n' "$dockitem" >&2; exit 1; }
  [[ -n "${launcher:-}" ]] || { printf 't480s-plank-apply: missing Launcher URI for %s\n' "$dockitem" >&2; exit 1; }
  [[ -z "${seen[$dockitem]:-}" ]] || { printf 't480s-plank-apply: duplicate dockitem: %s\n' "$dockitem" >&2; exit 1; }
  seen["$dockitem"]=1
  dockitems+=("$dockitem")
done < "$manifest"

((${#dockitems[@]} > 0)) || { printf 't480s-plank-apply: empty manifest: %s\n' "$manifest" >&2; exit 1; }

expected="dock-items=["
separator=
for dockitem in "${dockitems[@]}"; do
  expected+="${separator}'${dockitem}'"
  separator=', '
done
expected+=']'

mapfile -t declared_order < <(sed -n '/^dock-items=/p' "$dconf_source")
[[ ${#declared_order[@]} -eq 1 && "${declared_order[0]}" == "$expected" ]] \
  || { printf 't480s-plank-apply: manifest order does not match %s\n' "$dconf_source" >&2; exit 1; }

mkdir -p "$launcher_dir"
while read -r dockitem launcher extra; do
  [[ -n "${dockitem:-}" && "$dockitem" != \#* ]] || continue
  launcher="${launcher//\$\{HOME\}/$HOME}"
  target="$launcher_dir/$dockitem"
  tmp="$(mktemp "${TMPDIR:-/tmp}/t480s-plank-apply.XXXXXX")"
  printf '[PlankDockItemPreferences]\nLauncher=%s\n' "$launcher" > "$tmp"
  if [[ -f "$target" ]] && cmp -s "$tmp" "$target"; then
    rm -f "$tmp"
    tmp=
  else
    install -m 0644 "$tmp" "$target"
    rm -f "$tmp"
    tmp=
  fi
done < "$manifest"

"$dconf_bin" load /net/launchpad/plank/ < "$dconf_source"
