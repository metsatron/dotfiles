#!/bin/sh


# The disc tool. Runs in the guest where PCManFM and the source ports live (the mount must share their namespace). A single-disc drive, period-correct: mounting a new image ejects the previous one first, then opens it in PCManFM — the autorun gesture.


# [[file:../../../sanctuary-redstone-9x-fvwm95.org::*Dynamic menus — recent Documents + Desktop folder][Dynamic menus — recent Documents + Desktop folder:23]]
# redstone-9x-disc — the sanctuary's optical drive: mount/eject ISO images as D:
# System-level userspace fuseiso. No root, no polkit, NO Wine. Owns ONLY
# ~/.local/share/redstone-9x/{discs,drives/D:}. Never touches a Wine dosdevices
# entry or any other drive letter (f: is Encarta's, wholly outside this tool).
# Verbs: mount <iso> | eject | status

DISCS="$HOME/.local/share/redstone-9x/discs"
DRIVES="$HOME/.local/share/redstone-9x/drives"
DRIVE="$DRIVES/D:"
DRIVE_DESKTOP="$HOME/.local/share/redstone-9x/My Computer/D:.desktop"
PATH="/home/metsatron/.guix-extra-profiles/core/core/bin:/home/metsatron/.guix-extra-profiles/room-gaming/room-gaming/bin:/home/metsatron/.guix-extra-profiles/desktop-common/desktop-common/bin:$PATH"

label_of() {
  # ISO9660 PVD volume identifier: 32 bytes at offset 32808
  dd if="$1" bs=1 skip=32808 count=32 2>/dev/null | tr -cd 'A-Za-z0-9._ -' | sed 's/ *$//'
}

# Rename the My Computer drive icon to reflect the loaded disc. On mount the
# label reads "<VOLUME> (D:)"; on eject it returns to "Optical Disc (D:)".
# Edits the projected guest copy only (a plain file, reset to default on relaunch).
set_drive_name() {
  [ -f "$DRIVE_DESKTOP" ] || return 0
  sed -i "s/^Name=.*/Name=$1/" "$DRIVE_DESKTOP"
}

eject_current() {
  cur="$(readlink "$DRIVE" 2>/dev/null)"
  rm -f "$DRIVE"
  set_drive_name "Optical Disc (D:)"
  [ -n "$cur" ] || return 0
  fusermount3 -u "$cur" 2>/dev/null || fusermount -u "$cur" 2>/dev/null || umount "$cur" 2>/dev/null
  rmdir "$cur" 2>/dev/null
}

mount_iso() {
  iso="$1"
  [ -f "$iso" ] || { echo "redstone-9x-disc: no such image: $iso" >&2; exit 1; }
  eject_current
  lbl="$(label_of "$iso")"
  [ -n "$lbl" ] || lbl="UNTITLED"
  mp="$DISCS/$(printf '%s' "$lbl" | tr ' /' '__')"
  mkdir -p "$mp" "$DRIVES"
  if ! fuseiso "$iso" "$mp"; then
    rmdir "$mp" 2>/dev/null
    echo "redstone-9x-disc: mount failed: $iso" >&2
    exit 1
  fi
  ln -sfn "$mp" "$DRIVE"
  set_drive_name "$lbl (D:)"
  echo "$lbl"
}

case "${1:-status}" in
  mount)
    mount_iso "$2" || exit 1
    command -v pcmanfm >/dev/null 2>&1 && (pcmanfm -n "$DRIVE" &)
    ;;
  eject)  eject_current ;;
  status) readlink "$DRIVE" 2>/dev/null || echo "empty" ;;
  *) echo "usage: redstone-9x-disc [mount <iso>|eject|status]" >&2; exit 64 ;;
esac
# Dynamic menus — recent Documents + Desktop folder:23 ends here
