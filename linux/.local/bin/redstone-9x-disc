#!/bin/sh


# The disc tool. Runs in the guest (the .desktop entries launch it there); ISO images are listed from the host =~/Downloads= per the disc-image ruling. A single-disc drive, period-correct: mounting a new image ejects the previous one first. After a successful mount the disc opens in PCManFM — the autorun gesture.


# [[file:../../../sanctuary-redstone-9x-fvwm95.org::*Dynamic menus — recent Documents + Desktop folder][Dynamic menus — recent Documents + Desktop folder:22]]
# redstone-9x-disc — the sanctuary's optical drive: mount/eject ISO images as D:
# Owns d: and d:: ONLY. Never touches any other drive letter (f: is Encarta's).
# Verbs: ui (rofi picker, default) | mount <iso> | eject | status

DISCS="$HOME/.local/share/redstone-9x/discs"
DOS="$HOME/.wine-redstone/dosdevices"
PATH="/home/metsatron/.guix-extra-profiles/core/core/bin:/home/metsatron/.guix-extra-profiles/room-gaming/room-gaming/bin:$PATH"

label_of() {
  # ISO9660 PVD volume identifier: 32 bytes at offset 32808
  dd if="$1" bs=1 skip=32808 count=32 2>/dev/null | tr -cd 'A-Za-z0-9._ -' | sed 's/ *$//'
}

unmount_current() {
  cur="$(readlink "$DOS/d:" 2>/dev/null)"
  [ -n "$cur" ] || return 0
  fusermount3 -u "$cur" 2>/dev/null || fusermount -u "$cur" 2>/dev/null
  rmdir "$cur" 2>/dev/null
  rm -f "$DOS/d:" "$DOS/d::"
}

mount_iso() {
  iso="$1"
  [ -f "$iso" ] || { echo "redstone-9x-disc: no such image: $iso" >&2; exit 1; }
  unmount_current
  lbl="$(label_of "$iso")"
  [ -n "$lbl" ] || lbl="UNTITLED"
  mp="$DISCS/$(printf '%s' "$lbl" | tr ' ' '_')"
  mkdir -p "$mp"
  if ! fuseiso "$iso" "$mp"; then
    rmdir "$mp" 2>/dev/null
    echo "redstone-9x-disc: mount failed: $iso" >&2
    exit 1
  fi
  ln -sfn "$mp" "$DOS/d:"
  ln -sfn "$iso" "$DOS/d::"
  echo "$lbl"
}

case "${1:-ui}" in
  mount)  mount_iso "$2" ;;
  eject)  unmount_current ;;
  status) readlink "$DOS/d:" 2>/dev/null || echo "empty" ;;
  ui)
    cur="$(readlink "$DOS/d:" 2>/dev/null)"
    menu="$(find /home/metsatron/Downloads -maxdepth 3 -iname '*.iso' 2>/dev/null | sort)"
    if [ -n "$cur" ]; then
      menu="$(printf 'Eject  (%s)\n%s' "$(basename "$cur")" "$menu")"
    fi
    choice="$(printf '%s\n' "$menu" | rofi -config "$HOME/.config/redstone-9x/rofi/config.rasi" -dmenu -i -p "Optical Disc (D:)")"
    [ -n "$choice" ] || exit 0
    case "$choice" in
      "Eject "*) unmount_current ;;
      *) mount_iso "$choice" && pcmanfm -n "$DOS/d:" & ;;
    esac
    ;;
  *) echo "usage: redstone-9x-disc [ui|mount <iso>|eject|status]" >&2; exit 64 ;;
esac
# Dynamic menus — recent Documents + Desktop folder:22 ends here
