#!/bin/bash
# Build the Reactionary (ReactOS by phob1an) Desktop Scheme collection (12
# palettes). Two paths: GTK-themed variants read phob1an's own @define-color and
# reuse his GTK; .colors-only variants read the vendored KDE .colors and let
# theme-convert generate a GTK theme. Both feed redstone-9x-theme-convert.
set -euo pipefail
ROOT="${HOME}/DotCortex"
SCH="${ROOT}/linux/.config/redstone-9x/schemes"
COLORS="${ROOT}/linux/.local/share/dotcortex/reactionary/colors"
TMP="$(mktemp -d)"; trap 'rm -rf "${TMP}"' EXIT

# --- helpers ---
getcol(){ grep -hE "@define-color $2 " "${ROOT}/linux/.themes/$1/gtk-3.0/gtk.css" 2>/dev/null | head -1 | grep -oE '#[0-9a-fA-F]{3,6}' | head -1; }
hex6(){ local h="${1#\#}"; if [ "${#h}" -eq 3 ]; then echo "#${h:0:1}${h:0:1}${h:1:1}${h:1:1}${h:2:1}${h:2:1}"; else echo "#${h}"; fi; }
dec(){ local h="${1#\#}"; printf '%d %d %d' "$((16#${h:0:2}))" "$((16#${h:2:2}))" "$((16#${h:4:2}))"; }
shade(){ local h="${1#\#}" p="$2"; printf '%d %d %d' "$((16#${h:0:2}*p/100))" "$((16#${h:2:2}*p/100))" "$((16#${h:4:2}*p/100))"; }        # #hex, pct -> "R G B"
shade_dec(){ local p="$2"; set -- $1; printf '%d %d %d' "$(($1*p/100))" "$(($2*p/100))" "$(($3*p/100))"; }                               # "R G B", pct -> "R G B"
# KDE .colors: <file> <section> <key> -> "R G B" (comma triplet -> space)
colscol(){ awk -v s="[$2]" -v k="$3=" '$0==s{f=1;next} /^\[/{f=0} f&&index($0,k)==1{v=$0;sub(k,"",v);gsub(","," ",v);print v;exit}' "$1"; }
# Wallpaper: machine-local files live OUTSIDE the public repo (upscaled Microsoft
# Plus! originals — copyright), so the scheme carries only the $HOME path. If the
# file is absent (another machine), scheme-apply falls back to the solid DESKTOP_BG.
WPDIR='$HOME/.local/share/redstone-9x/wallpapers'
add_wallpaper(){ printf 'WALLPAPER="%s/%s.jpg"\nWALLPAPER_MODE="center"\n' "${WPDIR}" "$1" >> "${SCH}/$1.scheme"; }
# Windows .theme from decimal "R G B" roles: out face accent base titledark titlelight
write_theme(){ cat > "$1" <<EOF
[Control Panel\\Colors]
ActiveTitle=$5
GradientActiveTitle=$6
TitleText=255 255 255
InactiveTitle=128 128 128
GradientInactiveTitle=192 192 192
InactiveTitleText=224 224 224
ButtonFace=$2
ButtonText=0 0 0
Window=$4
WindowText=0 0 0
Menu=$2
MenuText=0 0 0
Hilight=$3
HilightText=255 255 255
Background=$5
EOF
}

# --- Path A: variants WITH phob1an's own GTK theme -------------------------------
# palette from GTK @define-color; GTK reused (.upstream); bevel-fix on dark faces.
# <GtkTheme(=TNAME)>|<scheme-id>|<Pretty Title>|<icons>
VARIANTS_GTK=(
  "Reactionary|reactionary|Reactionary|Reactionary"
  "ReactionaryCreatures|reactionary-creatures|Reactionary Creatures|SE98"
  "ReactionaryDaVinci|reactionary-davinci|Reactionary DaVinci|SE98"
  "ReactionaryMystery|reactionary-mystery|Reactionary Mystery|SE98"
)
for v in "${VARIANTS_GTK[@]}"; do
  IFS='|' read -r gtk sid title icons <<< "${v}"
  touch "${ROOT}/linux/.themes/${gtk}/.upstream"
  FACE="$(hex6 "$(getcol "${gtk}" bg_color)")"
  ACCENT="$(hex6 "$(getcol "${gtk}" selected_bg_color)")"
  TITLE="$(hex6 "$(getcol "${gtk}" titlebar_bg_color)")"
  BASE="$(hex6 "$(getcol "${gtk}" base_color)")"
  [ -n "${FACE}" ] && [ -n "${TITLE}" ] || { echo "SKIP ${gtk}: palette not readable" >&2; continue; }
  write_theme "${TMP}/${sid}.theme" "$(dec "${FACE}")" "$(dec "${ACCENT}")" "$(dec "${BASE}")" "$(shade "${TITLE}" 72)" "$(dec "${TITLE}")"
  ICON_OVERRIDE="${icons}" redstone-9x-theme-convert "${TMP}/${sid}.theme" "${gtk}" "${sid}"
  sed -i -e "s/^SCHEME_TITLE=.*/SCHEME_TITLE=\"${title}\"/" \
         -e 's/^SOUND_SCHEME=.*/SOUND_SCHEME="windows-2000"/' "${SCH}/${sid}.scheme"
  add_wallpaper "${sid}"
  # Bevel-highlight fix: classic-build lifts a dark face's highlight to face+25%,
  # brighter than phob1an's GTK button bevel. On dark faces (lum<140) repaint the
  # IceWM highlight to phob1an's own border-top colour so the bevels match.
  EDGE="$(grep -hiE 'border-top-color:[[:space:]]*#[0-9a-fA-F]{6}' "${ROOT}/linux/.themes/${gtk}/gtk-3.0/gtk-widgets.css" 2>/dev/null | grep -oiE '#[0-9a-fA-F]{6}' | head -1)"
  python3 - "${ROOT}/linux/.icewm/themes/${gtk}" "${FACE}" "${EDGE}" <<'PYBEVEL'
import sys, os
from PIL import Image
theme, face, edge = sys.argv[1], sys.argv[2], sys.argv[3]
F = tuple(int(face.lstrip('#')[i:i+2], 16) for i in (0, 2, 4))
if 0.2126*F[0] + 0.7152*F[1] + 0.0722*F[2] >= 140 or not edge:
    print(f"bevel-fix: {os.path.basename(theme)} light/none — skip"); raise SystemExit
HI = tuple(round(c + (255 - c) * .25) for c in F)
E = tuple(int(edge.lstrip('#')[i:i+2], 16) for i in (0, 2, 4))
hi_l, hi_u, e_u = '#%02x%02x%02x' % HI, '#%02X%02X%02X' % HI, '#%02X%02X%02X' % E
n = 0
for dp, _, fs in os.walk(theme):
    for fn in fs:
        p = os.path.join(dp, fn); low = fn.lower()
        if os.path.islink(p): continue
        if low.endswith('.xpm'):
            t = open(p, encoding='latin-1').read(); o = t
            t = t.replace(hi_l, e_u).replace(hi_u, e_u)
            if t != o: open(p, 'w', encoding='latin-1').write(t); n += 1
        elif low.endswith('.png'):
            im = Image.open(p).convert('RGBA'); px = im.load(); ch = False
            for y in range(im.height):
                for x in range(im.width):
                    r, g, b, a = px[x, y]
                    if (r, g, b) == HI: px[x, y] = (*E, a); ch = True
            if ch: im.save(p); n += 1
print(f"bevel-fix: {os.path.basename(theme)} {'#%02x%02x%02x'%HI}->{edge} touched {n} pixmaps")
PYBEVEL
  # Highlight-consistency fix (#5): FOX (hilitecolor) and Qt (palette Light role)
  # both default to a pure-white #ffffff bevel highlight, harsher than phob1an's
  # GTK button bevel, which uses its own soft border-top colour (EDGE). Push EDGE
  # into FOX_HILITE and the Qt Light/Midlight roles so every toolkit's raised-bevel
  # highlight matches the GTK theme. Light=EDGE; Midlight sits between face and EDGE
  # so the Light>=Midlight>=face ordering stays correct on dark faces.
  if [ -n "${EDGE}" ]; then
    printf 'FOX_HILITE="%s"\n' "${EDGE}" >> "${SCH}/${sid}.scheme"
    python3 - "${ROOT}/linux/.config/redstone-9x/qt6ct/colors/${sid}.conf" "${FACE}" "${EDGE}" <<'PYQT'
import sys, os
conf, face, edge = sys.argv[1], sys.argv[2], sys.argv[3]
if not os.path.exists(conf):
    print(f"qt-fix: {conf} missing — skip"); raise SystemExit
F = tuple(int(face.lstrip('#')[i:i+2], 16) for i in (0, 2, 4))
E = tuple(int(edge.lstrip('#')[i:i+2], 16) for i in (0, 2, 4))
M = tuple(round((f + e) / 2) for f, e in zip(F, E))
light = '#ff%02x%02x%02x' % E
mid   = '#ff%02x%02x%02x' % M
out = []
for ln in open(conf):
    if ln.startswith(('active_colors=', 'inactive_colors=', 'disabled_colors=')):
        head, _, rest = ln.partition('=')
        cols = [c.strip() for c in rest.rstrip().split(',')]
        if len(cols) > 3:
            cols[2] = light   # QPalette Light  (index 2)
            cols[3] = mid     # QPalette Midlight (index 3)
        ln = head + '=' + ', '.join(cols) + '\n'
    out.append(ln)
open(conf, 'w').writelines(out)
print(f"qt-fix: {os.path.basename(conf)} Light={light} Midlight={mid}")
PYQT
    # Wine bevel highlight (#5): theme-convert's .reg emits no ButtonHilight/
    # ButtonLight, so Wine falls back to its default white 3D edge — harsher than
    # phob1an's GTK. Inject the soft EDGE as both (the reg is regenerated fresh
    # each run, so this stays single, not doubled). Dark shadow edges keep Wine's
    # defaults, which read fine.
    REG="${ROOT}/linux/.config/redstone-9x/wine/${sid}.reg"
    if [ -f "${REG}" ]; then
      ER=$((16#${EDGE:1:2})); EG=$((16#${EDGE:3:2})); EB=$((16#${EDGE:5:2}))
      sed -i "/^\"ButtonFace\"=/a \"ButtonHilight\"=\"${ER} ${EG} ${EB}\"\n\"ButtonLight\"=\"${ER} ${EG} ${EB}\"" "${REG}"
      echo "wine-fix: ${sid}.reg ButtonHilight/ButtonLight=${EDGE}"
    fi
  fi
  # GTK4 backfill (#4): phob1an ships only gtk-2.0/gtk-3.0, so GTK4 apps fall back
  # to the unstyled default. Clone the Windows-95 donor's gtk-4.0 and recolour it
  # to this palette — the same recipe classic-build uses, restricted to gtk-4.0 so
  # phob1an's own gtk-2/3 stay verbatim. All four phob1an palettes use black fg, so
  # the dark-fg pass classic-build runs for non-black fg is not needed here.
  G4="${ROOT}/linux/.themes/${gtk}/gtk-4.0"
  DON="${ROOT}/linux/.themes/Windows-95/gtk-4.0"
  if [ -d "${DON}" ]; then
    rm -rf "${G4}"; cp -r "${DON}" "${G4}"
    # Recolour the Windows-95 gtk-4.0 base to this palette AND apply the two
    # pavucontrol fixes the working themes (redstone-9x-cde-convert) carry: the
    # levelbar trough (peak meters render flat/borderless without a sunken bevel)
    # and the notebook page background (hardcoded #FFFFFF => the "missing
    # background"). Same replacements as cde-convert, keyed to face+accent.
    # GTK4 raised-highlight softening (#4): the Win95 donor uses pure white for
    # button/raised bevels, which pops harshly on the dark/colour palettes while
    # GTK3 uses a subtle EDGE. Match phob1an's own GTK3 button highlight (Path A
    # gtk-widgets.css) or classic-build's (Path B single gtk.css) — the same EDGE
    # the FOX/Qt/Wine fix uses. Separate var so the shared EDGE (IceWM/wine) stays
    # Path-A-only and those approved fixes are untouched.
    G4EDGE="${EDGE}"
    [ -z "${G4EDGE}" ] && G4EDGE="$(grep -hiE 'border-top-color:[[:space:]]*#[0-9a-fA-F]{6}' "${ROOT}/linux/.themes/${gtk}/gtk-3.0/gtk.css" 2>/dev/null | grep -oiE '#[0-9a-fA-F]{6}' | head -1)"
    python3 - "${G4}" "${FACE}" "${ACCENT}" "${G4EDGE}" <<'PYG4'
import sys, os, re
g4, face, accent, edge4 = (sys.argv[1:5] + [''])[:4]
fr, fg, fb = (int(face.lstrip('#')[i:i+2], 16) for i in (0, 2, 4))
ar, ag, ab = (int(accent.lstrip('#')[i:i+2], 16) for i in (0, 2, 4))
for dp, _, fs in os.walk(g4):
    for fn in fs:
        if not fn.endswith('.css'):
            continue
        p = os.path.join(dp, fn); t = open(p, encoding='latin-1').read()
        t = re.sub(r'#c0c0c0', face, t, flags=re.I)
        t = re.sub(r'\b192,\s*192,\s*192\b', '%d, %d, %d' % (fr, fg, fb), t)
        t = re.sub(r'#000080', accent, t, flags=re.I)
        t = re.sub(r'\b0,\s*0,\s*128\b', '%d, %d, %d' % (ar, ag, ab), t)
        t = t.replace(
            'levelbar trough {\n  padding: 1px;\n  border-radius: 0; }',
            'levelbar trough {\n  padding: 1px;\n  border-radius: 0;\n'
            '  border: 1px solid #7d7d7d;\n  border-bottom-color: white;\n'
            '  border-right-color: white;\n  background-color: ' + face + '; }')
        t = t.replace(
            'notebook > stack:not(:only-child) {\n  background-color: #FFFFFF; }',
            'notebook > stack:not(:only-child) {\n  background-color: ' + face + '; }')
        t = t.replace(
            'notebook > stack:not(:only-child):backdrop {\n    background-color: #FFFFFF; }',
            'notebook > stack:not(:only-child):backdrop {\n    background-color: ' + face + '; }')
        # Soften the harsh white raised-bevel highlight to the theme's own EDGE.
        # Only the RAISED highlight edges (top/left); leave sunken entries
        # (bottom/right white) alone so fields keep their inset look.
        if edge4:
            # Soften EVERY harsh bevel to the theme's own EDGE. The Win95 donor
            # uses pure white / #ececec for raised+sunken bevels, box-shadow edges
            # and focus rings, which pops harshly on dark/colour faces (buttons,
            # notebook tab tops, slider grooves, the inset -1px -1px white bottom
            # lines). Rewrite every box-shadow and border-*-color, but keep text
            # colours and real white input-field backgrounds untouched.
            t = t.replace('#ececec', edge4)
            _out = []
            for _ln in t.split('\n'):
                _s = _ln.strip()
                if re.match(r'color:\s*(#[0-9a-fA-F]{3,6}|white)\b', _s) or 'background' in _s:
                    _out.append(_ln); continue
                _ln = re.sub(r'\bwhite\b', edge4, _ln)
                _ln = re.sub(r'#[fF]{6}\b', edge4, _ln)
                _out.append(_ln)
            t = '\n'.join(_out)
        open(p, 'w', encoding='latin-1').write(t)
print("gtk4-backfill: %s recoloured + pavucontrol levelbar/notebook fixes" % os.path.basename(os.path.dirname(g4)))
PYG4
  fi
  echo "built ${sid} (gtk-themed: face=${FACE} title=${TITLE} accent=${ACCENT} icons=${icons})"
done

# --- Path B: .colors-only palettes (no upstream GTK; theme-convert generates GTK) -
# palette from KDE .colors; titlebar derived from the accent; icons SE98. GTK and
# IceWM both come from classic-build, so they are bevel-consistent (no fix needed).
# <ColorsName>|<scheme-id>|<Pretty Title>
VARIANTS_COLORS=(
  "ReactionaryDisc|reactionary-disc|Reactionary Disc"
  "ReactionaryEnTee|reactionary-entee|Reactionary EnTee"
  "ReactionaryLeaves|reactionary-leaves|Reactionary Leaves"
  "ReactionaryRocknRoll|reactionary-rocknroll|Reactionary Rock'n'Roll"
  "ReactionaryScience|reactionary-science|Reactionary Science"
  "ReactionarySea|reactionary-sea|Reactionary Sea"
  "ReactionarySpace|reactionary-space|Reactionary Space"
  "ReactionaryTravel|reactionary-travel|Reactionary Travel"
)
for v in "${VARIANTS_COLORS[@]}"; do
  IFS='|' read -r name sid title <<< "${v}"
  cf="${COLORS}/${name}.colors"
  [ -f "${cf}" ] || { echo "SKIP ${name}: no .colors" >&2; continue; }
  FACE="$(colscol "${cf}" "Colors:Window" BackgroundNormal)"
  ACCENT="$(colscol "${cf}" "Colors:Selection" BackgroundNormal)"
  BASE="$(colscol "${cf}" "Colors:View" BackgroundNormal)"; [ -n "${BASE}" ] || BASE="255 255 255"
  [ -n "${FACE}" ] && [ -n "${ACCENT}" ] || { echo "SKIP ${name}: palette not readable" >&2; continue; }
  rm -f "${ROOT}/linux/.themes/${name}/.upstream"   # ensure theme-convert generates GTK
  write_theme "${TMP}/${sid}.theme" "${FACE}" "${ACCENT}" "${BASE}" "$(shade_dec "${ACCENT}" 72)" "${ACCENT}"
  ICON_OVERRIDE="SE98" redstone-9x-theme-convert "${TMP}/${sid}.theme" "${name}" "${sid}"
  sed -i -e "s/^SCHEME_TITLE=.*/SCHEME_TITLE=\"${title}\"/" \
         -e 's/^SOUND_SCHEME=.*/SOUND_SCHEME="windows-2000"/' "${SCH}/${sid}.scheme"
  add_wallpaper "${sid}"
  echo "built ${sid} (colors: face=${FACE} accent=${ACCENT})"
done

# Reactionary 2000 — the canonical palette on the genuine Windows 2000 SE98 icons.
cp "${SCH}/reactionary.scheme" "${SCH}/reactionary-2000.scheme"
sed -i -e 's/^SCHEME_TITLE=.*/SCHEME_TITLE="Reactionary 2000"/' \
       -e 's/^ICON_THEME=.*/ICON_THEME="SE98"/' "${SCH}/reactionary-2000.scheme"
echo "built reactionary-2000 (canonical chrome + SE98 win2k icons)"
echo "Reactionary collection complete (12 palettes + Reactionary 2000)."
