#!/usr/bin/env bash
# [[file:../../../sanctuary-gnustep.org::*NeXTSTEP application catalogue][NeXTSTEP application catalogue:2]]
# Inventory, build, check, and materialise the GNUstep NeXTSTEP catalogue.
set -euo pipefail

usage() {
  cat <<'EOF'
sanctuary-gnustep-apps - catalogue the NeXTSTEP-era GNUstep application surface

Usage:
  sanctuary-gnustep-apps inventory       print the catalogue as TSV
  sanctuary-gnustep-apps ledger          write the persistent guest-home ledger
  sanctuary-gnustep-apps menu            write the verified Window Maker submenu
  sanctuary-gnustep-apps build <id>      build an explicitly buildable app
  sanctuary-gnustep-apps check <id>      verify an installed app bundle

The menu contains only executable bundles found in the persistent GNUstep
prefix. Source-pinned rows are recorded as build candidates until a live build
and bundle check succeeds; GAP catalogue rows remain research candidates.
EOF
}

MODE="${1:-inventory}"
APP_ID="${2:-}"
case "$MODE" in
  -h|--help)
    usage
    exit 0
    ;;
  inventory|ledger|menu)
    ;;
  build|check)
    [[ -n "$APP_ID" ]] || { usage >&2; exit 2; }
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

SANCTUARY="sanctuary-gnustep"
GUESTS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/dotcortex/guests"
GUEST_HOME="${GUESTS_DIR}/${SANCTUARY}/home"
PREFIX="${GNUSTEP_PREFIX:-${GUEST_HOME}/.local/share/gnustep}"
CATALOGUE_FILE="${GNUSTEP_CATALOGUE:-${HOME}/DotCortex/all/.config/gnustep-sanctuary/apps.ssv}"
LEDGER="${GNUSTEP_LEDGER:-${GUEST_HOME}/.local/share/gnustep/catalogue.tsv}"
MENU_FILE="${GNUSTEP_MENU:-${GUEST_HOME}/GNUstep/Defaults/ApplicationsCatalogue}"

[[ -r "$CATALOGUE_FILE" ]] || {
  echo "sanctuary-gnustep-apps: missing catalogue: $CATALOGUE_FILE" >&2
  exit 1
}

app_path() {
  local bundle="$1" binary="$2" result
  [[ -d "$PREFIX" ]] || return 1
  result="$(find "$PREFIX" -type f -path "*/${bundle}/${binary}" -print -quit 2>/dev/null || true)"
  [[ -n "$result" && -x "$result" ]] || return 1
  printf '%s\n' "$result"
}

find_record() {
  local wanted="$1"
  local id category display bundle binary source_kind ref source_url sha256 provenance
  while IFS='|' read -r id category display bundle binary source_kind ref source_url sha256 provenance; do
    [[ -z "$id" || "$id" == \#* ]] && continue
    if [[ "$id" == "$wanted" ]]; then
      APP_CATEGORY="$category"
      APP_DISPLAY="$display"
      APP_BUNDLE="$bundle"
      APP_BINARY="$binary"
      APP_SOURCE_KIND="$source_kind"
      APP_REF="$ref"
      APP_SOURCE_URL="$source_url"
      APP_SHA256="$sha256"
      APP_PROVENANCE="$provenance"
      return 0
    fi
  done < "$CATALOGUE_FILE"
  return 1
}

inventory() {
  local id category display bundle binary source_kind ref source_url sha256 provenance path status launch
  printf 'status\tcategory\tname\tid\tlaunch\tlocation\tprovenance\n'
  while IFS='|' read -r id category display bundle binary source_kind ref source_url sha256 provenance; do
    [[ -z "$id" || "$id" == \#* ]] && continue
    path="$(app_path "$bundle" "$binary" || true)"
    if [[ -n "$path" ]]; then
      launch="openapp $binary"
      if [[ -f "$MENU_FILE" ]] && grep -Fq "openapp $binary" "$MENU_FILE"; then
        status='installed-and-menu-linked'
      else
        status='installed-unlisted'
      fi
    elif [[ ( "$source_kind" == github && -n "$source_url" && -n "$ref" ) || ( "$source_kind" == tarball && -n "$source_url" && -n "$sha256" ) ]]; then
      launch="openapp $binary"
      status='source-pinned'
      path=''
    elif [[ "$source_kind" == gap ]]; then
      launch="openapp $binary"
      status='catalogued-source'
      path=''
    else
      launch=''
      status='missing'
      path=''
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$status" "$category" "$display" "$id" "$launch" "$path" "$provenance"
  done < "$CATALOGUE_FILE"
}

write_ledger() {
  mkdir -p "$(dirname "$LEDGER")"
  local tmp
  tmp="$(mktemp "${LEDGER}.tmp.XXXXXX")"
  trap 'rm -f "$tmp"' EXIT
  inventory > "$tmp"
  mv -f "$tmp" "$LEDGER"
  trap - EXIT
  printf 'sanctuary-gnustep-apps: wrote %s\n' "$LEDGER"
}

write_menu() {
  mkdir -p "$(dirname "$MENU_FILE")"
  local tmp id category display bundle binary source_kind ref source_url sha256 provenance path entry
  local -a category_order=(Accessories Games Development Graphics Multimedia Networking)
  declare -A rows=()
  while IFS='|' read -r id category display bundle binary source_kind ref source_url sha256 provenance; do
    [[ -z "$id" || "$id" == \#* ]] && continue
    path="$(app_path "$bundle" "$binary" || true)"
    [[ -n "$path" ]] || continue
    entry="    (\"$display\", EXEC, \"openapp $binary\"),"
    if [[ -v "rows[$category]" ]]; then
      rows["$category"]+="${entry}"$'\n'
    else
      rows["$category"]="${entry}"$'\n'
    fi
  done < "$CATALOGUE_FILE"

  tmp="$(mktemp "${MENU_FILE}.tmp.XXXXXX")"
  trap 'rm -f "$tmp"' EXIT
  {
    printf '(\n'
    printf '  "NeXTSTEP Catalogue",\n'
    local wrote=0
    local category
    for category in "${category_order[@]}"; do
      [[ -v "rows[$category]" ]] || continue
      printf '  (\n'
      printf '    %s,\n' "$category"
      printf '%s' "${rows[$category]}"
      printf '  ),\n'
      wrote=1
    done
    if (( wrote == 0 )); then
      printf '  ("No verified applications", SHEXEC, "echo No verified GNUstep applications are installed yet")\n'
    fi
    printf ')\n'
  } > "$tmp"
  mv -f "$tmp" "$MENU_FILE"
  trap - EXIT
  printf 'sanctuary-gnustep-apps: wrote %s\n' "$MENU_FILE"
}

build_app() {
  local q_id q_kind q_ref q_url q_sha256 q_bundle q_binary
  find_record "$APP_ID" || {
    echo "sanctuary-gnustep-apps: unknown application id: $APP_ID" >&2
    exit 2
  }
  [[ ( "$APP_SOURCE_KIND" == github && -n "$APP_SOURCE_URL" && -n "$APP_REF" ) || ( "$APP_SOURCE_KIND" == tarball && -n "$APP_SOURCE_URL" && -n "$APP_SHA256" ) ]] || {
    echo "sanctuary-gnustep-apps: $APP_ID is catalogue-only; source is not pinned" >&2
    exit 3
  }
  printf -v q_id '%q' "$APP_ID"
  printf -v q_kind '%q' "$APP_SOURCE_KIND"
  printf -v q_ref '%q' "$APP_REF"
  printf -v q_url '%q' "$APP_SOURCE_URL"
  printf -v q_sha256 '%q' "$APP_SHA256"
  printf -v q_bundle '%q' "$APP_BUNDLE"
  printf -v q_binary '%q' "$APP_BINARY"
  local gui_profiles="${HOME}/.guix-extra-profiles"
  local inner_script
  inner_script=$(cat <<INNER_EOF
set -eo pipefail

APP_ID=${q_id}
APP_SOURCE_KIND=${q_kind}
APP_REF=${q_ref}
APP_SOURCE_URL=${q_url}
APP_SHA256=${q_sha256}
APP_BUNDLE=${q_bundle}
APP_BINARY=${q_binary}
PREFIX=\${HOME}/.local/share/gnustep
SRC_ROOT=\${HOME}/.local/share/gnustep-src/apps

export PKG_CONFIG_PATH="\${PKG_CONFIG_PATH:-}"
export LD_LIBRARY_PATH="\${LD_LIBRARY_PATH:-}"
export LIBRARY_PATH="\${LIBRARY_PATH:-}"
export CPATH="\${CPATH:-}"
GUIX_PROFILE=${gui_profiles}/desktop-common/desktop-common
. \${GUIX_PROFILE}/etc/profile
GUIX_PROFILE=${gui_profiles}/sanctuary-gnustep/sanctuary-gnustep
. \${GUIX_PROFILE}/etc/profile
export CURL_CA_BUNDLE=\${GIT_SSL_CAINFO:-}
export CC=clang CXX=clang++
GS_PROFILE_LIB=${gui_profiles}/sanctuary-gnustep/sanctuary-gnustep/lib
export LIBRARY_PATH="\${GS_PROFILE_LIB}:\${LIBRARY_PATH}"
export LD_LIBRARY_PATH="\${GS_PROFILE_LIB}:\${LD_LIBRARY_PATH}"
export LDFLAGS="-L\${GS_PROFILE_LIB} -Wl,-rpath,\${GS_PROFILE_LIB} -Wl,--copy-dt-needed-entries \${LDFLAGS:-}"
export CFLAGS="-g -O2 -Wno-error=incompatible-pointer-types"

[ -f "\${PREFIX}/share/GNUstep/Makefiles/GNUstep.sh" ] || {
  echo "GNUstep runtime is not built under \${PREFIX}" >&2
  exit 1
}
. "\${PREFIX}/share/GNUstep/Makefiles/GNUstep.sh"
export GNUSTEP_INSTALLATION_DOMAIN=LOCAL
export GNUSTEP_LOCAL_APPS="\${PREFIX}/lib/GNUstep/Applications"
mkdir -p "\${SRC_ROOT}" "\${PREFIX}"
cd "\${SRC_ROOT}"

if [ "\${APP_SOURCE_KIND}" = github ]; then
  if [ ! -d "\${SRC_ROOT}/\${APP_ID}/.git" ]; then
    git clone "\${APP_SOURCE_URL}" "\${SRC_ROOT}/\${APP_ID}"
  fi
  cd "\${SRC_ROOT}/\${APP_ID}"
  git fetch --tags --force origin

  REPO_NAME=\$(basename "\${APP_SOURCE_URL%.git}")
  REPO_NAME_SHORT=\${REPO_NAME#apps-}
  REF_TAG=
  # A release tag is preferred, but a full commit is equally reproducible and
  # is needed for small GNUstep projects whose upstream has no release tags.
  # The catalogue stores the exact commit, never a moving branch name.
  if git cat-file -e "\${APP_REF}^{commit}" 2>/dev/null; then
    REF_TAG="\${APP_REF}"
  fi
  for candidate in "\${APP_REF}" "v\${APP_REF}" "\${APP_ID}-\${APP_REF}" "\${APP_ID}-\$(printf '%s' "\${APP_REF}" | tr . _)" "\${REPO_NAME}-\${APP_REF}" "\${REPO_NAME}-\$(printf '%s' "\${APP_REF}" | tr . _)" "\${REPO_NAME_SHORT}-\${APP_REF}" "\${REPO_NAME_SHORT}-\$(printf '%s' "\${APP_REF}" | tr . _)"; do
    [[ -n "\${REF_TAG}" ]] && break
    if git show-ref --verify --quiet "refs/tags/\${candidate}"; then
      REF_TAG="\${candidate}"
      break
    fi
  done
  if [ -z "\${REF_TAG}" ]; then
    echo "No exact release tag found for \${APP_ID} \${APP_REF}; refusing an unpinned build." >&2
    git tag --list | tail -20 >&2 || true
    exit 2
  fi
  if git cat-file -e "refs/tags/\${REF_TAG}^{commit}" 2>/dev/null; then
    git checkout --detach "refs/tags/\${REF_TAG}"
  else
    git checkout --detach "\${REF_TAG}^{commit}"
  fi
else
  ARCHIVE_NAME=\$(basename "\${APP_SOURCE_URL%%\?*}")
  ARCHIVE_DIR="\${SRC_ROOT}/archives"
  ARCHIVE_PATH="\${ARCHIVE_DIR}/\${ARCHIVE_NAME}"
  mkdir -p "\${ARCHIVE_DIR}"
  if [ ! -f "\${ARCHIVE_PATH}" ] || ! printf '%s  %s\n' "\${APP_SHA256}" "\${ARCHIVE_PATH}" | sha256sum -c - >/dev/null 2>&1; then
    TEMP_ARCHIVE="\$(mktemp "\${ARCHIVE_PATH}.tmp.XXXXXX")"
    curl -fsSL --retry 3 --connect-timeout 20 "\${APP_SOURCE_URL}" -o "\${TEMP_ARCHIVE}"
    printf '%s  %s\n' "\${APP_SHA256}" "\${TEMP_ARCHIVE}" | sha256sum -c -
    mv -f "\${TEMP_ARCHIVE}" "\${ARCHIVE_PATH}"
  fi
  printf '%s  %s\n' "\${APP_SHA256}" "\${ARCHIVE_PATH}" | sha256sum -c -
  BUILD_DIR="\$(mktemp -d "\${SRC_ROOT}/.\${APP_ID}.XXXXXX")"
  trap 'rm -rf "\${BUILD_DIR}"' EXIT
  TOP_LEVEL=\$(tar -tzf "\${ARCHIVE_PATH}" | awk -F/ 'NF && !seen { print \$1; seen=1 }')
  [ -n "\${TOP_LEVEL}" ] || { echo "Archive has no top-level directory" >&2; exit 2; }
  if tar -tzf "\${ARCHIVE_PATH}" | grep -Eq '(^/|(^|/)\.\.(/|$))'; then
    echo "Archive contains an unsafe path" >&2
    exit 2
  fi
  tar -xzf "\${ARCHIVE_PATH}" -C "\${BUILD_DIR}"
  cd "\${BUILD_DIR}/\${TOP_LEVEL}"
fi
if [ "\${APP_ID}" = scoremaker ]; then
  # ScoreMaker's upstream GNUstep target intentionally emits a standalone
  # binary and has no install target. Adapt that output into the same
  # persistent GNUstep application shape consumed by openapp and GWorkspace.
  make
  SCOREMAKER_APP="\${GNUSTEP_LOCAL_APPS}/ScoreMaker.app"
  mkdir -p "\${SCOREMAKER_APP}/Resources"
  cp -f "build/gnustep/ScoreMaker" "\${SCOREMAKER_APP}/ScoreMaker"
  cp -f ScoreMakerInfo.plist "\${SCOREMAKER_APP}/Resources/Info-gnustep.plist"
  cp -f Resources/* "\${SCOREMAKER_APP}/Resources/"
  chmod +x "\${SCOREMAKER_APP}/ScoreMaker"
else
  if [ "\${APP_ID}" = terminal ]; then
    # Terminal 0.9.9 contains tentative Objective-C globals that Clang's
    # modern -fno-common default rejects at link time. Keep the source pinned
    # and scope the compatibility flag to this legacy application only.
    make ADDITIONAL_OBJCFLAGS=-fcommon
    make ADDITIONAL_OBJCFLAGS=-fcommon install
  else
    make
    make install
  fi
fi

APP_PATH=\$(find "\${PREFIX}" -type f -path "*/\${APP_BUNDLE}/\${APP_BINARY}" -print -quit 2>/dev/null || true)
if [ -z "\${APP_PATH}" ] || [ ! -x "\${APP_PATH}" ]; then
  echo "Build completed but \${APP_BUNDLE}/\${APP_BINARY} was not installed under \${PREFIX}" >&2
  exit 1
fi
printf 'Installed %s at %s\\n' "\${APP_ID}" "\${APP_PATH}"
if [ "\${APP_SOURCE_KIND}" = github ]; then
  printf 'Source commit: %s\\n' "\$(git rev-parse HEAD)"
else
  printf 'Source archive: %s\\n' "\${APP_SOURCE_URL}"
  printf 'Source SHA-256: %s\\n' "\${APP_SHA256}"
fi
INNER_EOF
)
  sanctuary-exec "$SANCTUARY" sh -c "$inner_script"
}

check_app() {
  find_record "$APP_ID" || {
    echo "sanctuary-gnustep-apps: unknown application id: $APP_ID" >&2
    exit 2
  }
  local path
  path="$(app_path "$APP_BUNDLE" "$APP_BINARY" || true)"
  [[ -n "$path" ]] || {
    echo "sanctuary-gnustep-apps: $APP_ID is not installed in $PREFIX" >&2
    exit 1
  }
  printf 'id\tname\tbundle\texecutable\tlaunch\n'
  printf '%s\t%s\t%s\t%s\t%s\n' \
    "$APP_ID" "$APP_DISPLAY" "$APP_BUNDLE" "$path" "openapp $APP_BINARY"
}

case "$MODE" in
  inventory)
    inventory
    ;;
  ledger)
    write_ledger
    ;;
  menu)
    write_menu
    ;;
  build)
    build_app
    ;;
  check)
    check_app
    ;;
esac
# NeXTSTEP application catalogue:2 ends here
