#!/bin/bash
# Redstone runtime spine

# Redstone's shared compatibility substrate lives under =~/.compat/=.  The
# runtime root is intentionally Unix-centric and host-visible, while DOS-visible
# layout is a generated projection layered over it.

# Current spine:

# - =~/.compat/imports/retropie-dosbox-pure/= — DOSBox Pure collection manifests
# - =~/.compat/imports/retropie-ports/= — symlink-aware ports manifests
# - =~/.compat/library/= — future canonical content roots
# - =~/.compat/generated/dos/c/REDSTONE/= — DOS-visible projection for DOSEMU2
# - =~/.compat/state/= — lane-private mutable state
# - =~/.compat/machines/dosbox-x/= — Windows 3.1 / Win9x machine folders

# The current live RetroPie topology is recorded exactly, not inferred:

# - EmulationStation =ports= logical path: =~/RetroPie/roms/ports=
# - Physical backing directory: =~/RetroPie/isos/ports=
# - The logical path is currently a symlink to the backing directory
# - DOSBox Pure PC/DOS collection: =~/RetroPie/isos/pc= (separate import surface)


# [[file:../../../distrobox.org::*Redstone runtime spine][Redstone runtime spine:1]]
set -euo pipefail

QUIET=0
if [[ "${1:-}" == "--quiet" ]]; then
  QUIET=1
  shift
fi

COMPAT_ROOT="${REDSTONE_COMPAT_ROOT:-${HOME}/.compat}"

mkdir -p \
  "${COMPAT_ROOT}/imports/retropie-dosbox-pure" \
  "${COMPAT_ROOT}/imports/retropie-ports" \
  "${COMPAT_ROOT}/library/media/floppy" \
  "${COMPAT_ROOT}/library/media/cdrom" \
  "${COMPAT_ROOT}/library/media/iso" \
  "${COMPAT_ROOT}/library/dos/apps" \
  "${COMPAT_ROOT}/library/dos/toolchains" \
  "${COMPAT_ROOT}/library/games" \
  "${COMPAT_ROOT}/library/ports/engines" \
  "${COMPAT_ROOT}/library/ports/families" \
  "${COMPAT_ROOT}/generated/dos/c/REDSTONE/USR/BIN" \
  "${COMPAT_ROOT}/generated/dos/c/REDSTONE/ETC" \
  "${COMPAT_ROOT}/generated/dos/c/REDSTONE/OPT" \
  "${COMPAT_ROOT}/generated/dos/c/REDSTONE/SHARE" \
  "${COMPAT_ROOT}/generated/dos/c/REDSTONE/HOME" \
  "${COMPAT_ROOT}/generated/dos/c/REDSTONE/TMP" \
  "${COMPAT_ROOT}/generated/dos/c/REDSTONE/VAR" \
  "${COMPAT_ROOT}/generated/dosemu2" \
  "${COMPAT_ROOT}/generated/dosbox-x" \
  "${COMPAT_ROOT}/generated/dosbox-staging" \
  "${COMPAT_ROOT}/generated/retroarch" \
  "${COMPAT_ROOT}/generated/desktop" \
  "${COMPAT_ROOT}/state/shared" \
  "${COMPAT_ROOT}/state/apps" \
  "${COMPAT_ROOT}/state/dosemu2" \
  "${COMPAT_ROOT}/state/dosbox-x" \
  "${COMPAT_ROOT}/state/dosbox-staging" \
  "${COMPAT_ROOT}/state/retroarch" \
  "${COMPAT_ROOT}/state/86box" \
  "${COMPAT_ROOT}/state/wine" \
  "${COMPAT_ROOT}/state/proton" \
  "${COMPAT_ROOT}/state/lutris" \
  "${COMPAT_ROOT}/machines/dosbox-x/win31-standard" \
  "${COMPAT_ROOT}/machines/dosbox-x/win31-upgraded" \
  "${COMPAT_ROOT}/machines/dosbox-x/win95" \
  "${COMPAT_ROOT}/machines/dosbox-x/win98se" \
  "${COMPAT_ROOT}/machines/86box"

if (( ! QUIET )); then
  echo "redstone-9x-compat-init: initialised ${COMPAT_ROOT}"
fi
# Redstone runtime spine:1 ends here
