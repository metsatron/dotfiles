#!/usr/bin/env bash
# KDE 1 application catalogue and MiDesktop state materializer

# The live guest prefix is persistent, but its menu links and panel configuration
# are runtime projections rather than canonical files. This helper is therefore
# the declarative owner of the DotCortex-owned links, the persistent availability
# ledger, the KDEHelp-compatible panel button list, and the wallpaper baseline.
# Native KDE1 links already installed by an application take precedence; this
# helper only owns a direct launcher when no native link for that executable
# exists.
# It does not symlink or replace the whole mutable =.kde= tree.


# [[file:../../../sanctuary-mide.org::*KDE 1 application catalogue and MiDesktop state materializer][KDE 1 application catalogue and MiDesktop state materializer:1]]
set -euo pipefail

MODE="${1:-inventory}"
case "$MODE" in
  inventory|ledger|menu|panel|display|reconcile) ;;
  -h|--help)
    cat <<'EOF'
sanctuary-mide-apps - reconcile MiDesktop KDE1 catalogue and state

Usage: sanctuary-mide-apps [inventory|ledger|menu|panel|display|reconcile]
EOF
    exit 0
    ;;
  *)
    echo "sanctuary-mide-apps: unknown mode: $MODE" >&2
    exit 2
    ;;
esac

GUESTS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/dotcortex/guests"
GUEST_HOME="${GUESTS_DIR}/sanctuary-mide/home"
PREFIX="${MIDE_PREFIX:-${GUESTS_DIR}/sanctuary-mide/opt-kde1}"
APP_LINK_ROOT="${PREFIX}/share/applnk"
LEDGER="${MIDE_LEDGER:-${GUEST_HOME}/.local/share/mide/kde1-applications.tsv}"
PANEL_CONFIG="${GUEST_HOME}/.kde/share/config/kpanelrc"
DESKTOP_CONFIG="${GUEST_HOME}/.kde/share/config/desktop0rc"

[[ -d "$PREFIX" ]] || { echo "missing MiDesktop prefix: $PREFIX" >&2; exit 1; }

# id|category|display name|exec|binary|icon|availability|provenance
CATALOGUE=(
  'kwrite|Applications|Advanced Editor|kwrite|kwrite|kwrite.xpm|installed|MiDE 1.2 utils/kwrite'
  'kfm|Applications|File Manager|kfmclient|kfm|kfm.xpm|installed|MiDE 1.2 base/kfm'
  'kfmbrowser|Internet|KFM Web Browser|kfmclient|kfm|www.xpm|installed|MiDE 1.2 base/kfm'
  'firefox|Internet|Firefox Web Browser|firefox|firefox|www.xpm|bridge|DotCortex guests.org Firefox bridge'
  'kmedia|Multimedia|KMedia|kmedia|kmedia|kmedia.xpm|installed|KDE historical kde1-kdemultimedia'
  'kblackbox|Games|KBlackBox|kblackbox1|kblackbox1|kblackbox.xpm|installed|KDE historical kde1-kdegames'
  'kmines|Games|KMines|kmines1|kmines1|kmines.xpm|installed|KDE historical kde1-kdegames'
  'kpat|Games|KPat / Patience|kpat1|kpat1|kpat.xpm|installed|KDE historical kde1-kdegames'
  'kabalone|Games|KAbalone|kabalone|kabalone|kabalone.xpm|installed|KDE historical kde1-kdegames'
  'kshisen|Games|KShisen|kshisen1|kshisen1|kshisen.xpm|installed|KDE historical kde1-kdegames'
  'kedit|Applications|KEdit|kedit|kedit|kedit.xpm|installed|KDE historical kde1-kdeutils'
  'kview|Graphics|KView|kview1|kview1|kview.xpm|installed|KDE historical kde1-kdegraphics'
  'kjots|Applications|KJots|kjots1|kjots1|kjots.xpm|installed|KDE historical kde1-kdeutils'
  'kcalc|Utilities|KCalc|kcalc1|kcalc1|kcalc.xpm|installed|KDE historical kde1-kdeutils'
  'knotes|Utilities|KNotes|knotes1|knotes1|knotes.xpm|installed|KDE historical kde1-kdeutils'
  'kpaint|Graphics|KPaint|kpaint1|kpaint1|kpaint.xpm|source-available|KDE historical kde1-kdegraphics'
  'kiconedit|Graphics|KIconEdit|kiconedit|kiconedit|kiconedit.xpm|source-available|KDE historical kde1-kdegraphics'
  'kmahjongg|Games|KMahjongg|kmahjongg1|kmahjongg1|kmahjongg.xpm|installed|KDE historical kde1-kdegames'
  'konquest|Games|Konquest|konquest1|konquest1|konquest.xpm|source-available|KDE historical kde1-kdegames'
  'kreversi|Games|KReversi|kreversi1|kreversi1|kreversi.xpm|source-available|KDE historical kde1-kdegames'
  'ksame|Games|KSame|ksame|ksame|ksame.xpm|source-available|KDE historical kde1-kdegames'
  'ksokoban|Games|KSokoban|ksokoban|ksokoban|ksokoban.xpm|source-available|KDE historical kde1-kdegames'
)

icon_path() {
  local requested="$1" candidate
  for candidate in \
    "$PREFIX/share/icons/$requested" \
    "$PREFIX/share/icons/large/$requested" \
    "$PREFIX/share/icons/mini/$requested"; do
    if [[ -f "$candidate" ]]; then
      printf '%s\n' "${candidate#"$PREFIX/share/icons/"}"
      return
    fi
  done
  printf 'missing:%s\n' "$requested"
}

installed() {
  [[ -x "$PREFIX/bin/$1" ]] || {
    [[ "$1" == firefox && -x "$GUEST_HOME/.local/bin/firefox" ]]
  }
}

# KDE1 packages install their own .kdelnk files.  Do not create a second
# DotCortex entry when one of those native links already launches the same
# executable.  The exact Exec prefix also avoids mistaking Settings/kfm.kdelnk
# and Settings/kfmbrowser.kdelnk (which launch kcmkfm) for the file manager.
vendor_menu_entry_exists() {
  local binary="$1" link
  while IFS= read -r -d '' link; do
    [[ "$link" == */dotcortex-*.kdelnk ]] && continue
    if grep -Eq "^Exec=${binary}([[:space:]]|$)" "$link" 2>/dev/null; then
      return 0
    fi
  done < <(find "$APP_LINK_ROOT" -type f -name '*.kdelnk' -print0)
  return 1
}

inventory() {
  printf 'status\tcategory\tname\tbinary\ticon\tprovenance\n'
  local row id category display exec binary icon availability provenance status
  for row in "${CATALOGUE[@]}"; do
    IFS='|' read -r id category display exec binary icon availability provenance <<<"$row"
    if installed "$binary"; then
      if [[ -f "$APP_LINK_ROOT/$category/dotcortex-${id}.kdelnk" ]] || \
        vendor_menu_entry_exists "$binary"; then
        status=installed-and-menu-linked
      else
        status=installed-unlisted
      fi
    elif [[ "$availability" == source-available ]]; then
      status=source-available-not-built
    else
      status=not-present
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$status" "$category" "$display" "$binary" "$(icon_path "$icon")" "$provenance"
  done
}

menu() {
  local row id category display exec binary icon availability provenance destination tmp resolved_icon rel old
  local -A expected_owned=()
  for row in "${CATALOGUE[@]}"; do
    IFS='|' read -r id category display exec binary icon availability provenance <<<"$row"
    installed "$binary" || continue
    destination="$APP_LINK_ROOT/$category/dotcortex-${id}.kdelnk"
    if vendor_menu_entry_exists "$binary"; then
      # Remove only the exact old projection owned by this helper.  The native
      # KDE1 .kdelnk remains untouched and supplies its own correct artwork.
      rm -f "$destination"
      continue
    fi
    resolved_icon="$(icon_path "$icon")"
    if [[ "$resolved_icon" == missing:* ]]; then
      echo "sanctuary-mide-apps: no exact icon for ${id}; leaving it unlisted" >&2
      rm -f "$destination"
      continue
    fi
    expected_owned["${category}/dotcortex-${id}.kdelnk"]=1
    mkdir -p "$(dirname "$destination")"
    tmp="$(mktemp "${destination}.tmp.XXXXXX")"
    {
      printf '# KDE Config File\n[KDE Desktop Entry]\n'
      printf '# DotCortex generated MiDesktop entry; do not edit.\n'
      printf 'Type=Application\nName=%s\n' "$display"
      if [[ "$id" == kfm ]]; then
        printf 'Exec=%s folder file:$HOME\n' "$exec"
      elif [[ "$id" == kfmbrowser ]]; then
        printf 'Exec=%s openURL\n' "$exec"
      elif [[ "$id" == firefox ]]; then
        printf 'Exec=%s\n' "$exec"
      else
        printf 'Exec=%s -caption "%%c" %%i %%m %%f\n' "$exec"
      fi
      printf 'Icon=%s\nMiniIcon=%s\nTerminal=0\nComment=KDE 1 application from MiDesktop\n' "$resolved_icon" "$resolved_icon"
    } >"$tmp"
    mv -f "$tmp" "$destination"
  done

  # Reconciliation is also a migration: remove stale DotCortex projections
  # from older catalogue revisions, but never touch native or user-created
  # KDE1 links.
  while IFS= read -r -d '' old; do
    rel="${old#"$APP_LINK_ROOT/"}"
    [[ ${expected_owned[$rel]+present} ]] || rm -f "$old"
  done < <(find "$APP_LINK_ROOT" -type f -name 'dotcortex-*.kdelnk' -print0)
}

ledger() {
  mkdir -p "$(dirname "$LEDGER")"
  local tmp
  tmp="$(mktemp "${LEDGER}.tmp.XXXXXX")"
  inventory >"$tmp"
  mv -f "$tmp" "$LEDGER"
}

panel() {
  mkdir -p "$(dirname "$PANEL_CONFIG")"
  local tmp
  tmp="$(mktemp "${PANEL_CONFIG}.tmp.XXXXXX")"
  if [[ -f "$PANEL_CONFIG" ]]; then
    awk '
      /^# DotCortex generated MiDesktop panel buttons; do not edit\.$/ {marked=1; next}
      marked && /^\[kpanelButtons\]$/ {skip=1; marked=0; next}
      /^\[kpanelButtons\]$/ {skip=1; next}
      skip && /^\[/ {skip=0}
      !skip {lines[++count]=$0}
      END {
        while (count > 0 && lines[count] == "") count--
        for (line_no = 1; line_no <= count; line_no++) print lines[line_no]
      }
    ' "$PANEL_CONFIG" >"$tmp"
  else
    printf '# KDE Config File\n' >"$tmp"
  fi
  cat >>"$tmp" <<'EOF'

# DotCortex generated MiDesktop panel buttons; do not edit.
[kpanelButtons]
Buttons=system,windowlist,$$KDEAPPS/Home.kdelnk,$$KDEAPPS/Applications/dotcortex-kfm.kdelnk,$$KDEAPPS/Applications/dotcortex-kwrite.kdelnk,$$KDEAPPS/Applications/KEdit.kdelnk,$$KDEAPPS/Utilities,$$KDEAPPS/Help.kdelnk,
EOF
  mv -f "$tmp" "$PANEL_CONFIG"
}

display() {
  mkdir -p "$(dirname "$DESKTOP_CONFIG")"
  if [[ ! -f "$DESKTOP_CONFIG" ]]; then
    cat >"$DESKTOP_CONFIG" <<'EOF'
# KDE Config File
[Desktop0]
UseWallpaper=true
EOF
  elif grep -q '^Wallpaper=' "$DESKTOP_CONFIG"; then
    sed -i 's/^UseWallpaper=.*/UseWallpaper=true/' "$DESKTOP_CONFIG"
  fi
}

case "$MODE" in
  inventory) inventory ;;
  ledger) ledger ;;
  menu) menu ;;
  panel) panel ;;
  display) display ;;
  reconcile) menu; ledger; panel; display ;;
esac
# KDE 1 application catalogue and MiDesktop state materializer:1 ends here
