#!/bin/bash


# The approved NeXTSTEP family matrix is exposed as one dynamic submenu under
# =Themes=, containing =NeXTSTEP Style=, =GNUstep Style=, and =Rhapsody Style=.
# Each nested menu is generated from the deployed Desktop Scheme files: exactly
# 27 matrix entries plus one explicit Rhapsody representative.  The helper reads
# only the quoted =SCHEME_TITLE= field; it never sources scheme code.


# [[file:../../../sanctuary-redstone-9x-fvwm95.org::*FVWM95 configuration][FVWM95 configuration:4]]
# Emit the approved 27-matrix-plus-one-representative NeXTSTEP-family menus.
set -euo pipefail
export LC_ALL=C

root="${HOME}/.config/redstone-9x/schemes"
icon="preferences-desktop-theme"
shopt -s nullglob

escape_menu() {
  local value="${1//\\/\\\\}"
  printf '%s' "${value//\"/\\\"}"
}

valid_scheme_id() {
  [[ "$1" =~ ^[A-Za-z0-9._+-]+$ ]]
}

read_scheme_title() {
  local -a titles=()
  mapfile -t titles < <(sed -n 's/^SCHEME_TITLE="\(.*\)"$/\1/p' "$1")
  (( ${#titles[@]} == 1 )) && [[ -n "${titles[0]}" ]] || return 1
  REPLY="${titles[0]}"
}

menu_label_for() {
  local title="$1" scheme="$2" label
  label="${title#* — }"
  [[ "$label" != "$title" && -n "$label" ]] || label="$title"
  [[ -n "$label" ]] || label="$scheme"
  REPLY="$label"
}

emit_diagnostic() {
  printf 'menu "%s" %s {\n' "$1" "$icon"
  printf '  prog "(%s)" dialog-information true\n' "$(escape_menu "$2")"
  printf '}\n'
}

for lane_spec in \
  'nextstep|NeXTSTEP Style|nextstep-nextstep-rhapsody-canon' \
  'gnustep|GNUstep Style|nextstep-gnustep-rhapsody-canon' \
  'rhapsody|Rhapsody Style|rhapsody-canon'; do
  IFS='|' read -r lane menu_label representative <<< "$lane_spec"
  discovered=("${root}/nextstep-${lane}-"*.scheme)
  matrix_paths=()
  problem=

  for path in "${discovered[@]}"; do
    scheme="${path##*/}"
    scheme="${scheme%.scheme}"
    if ! valid_scheme_id "$scheme"; then
      problem="invalid scheme id: ${scheme}"
      break
    fi
    [[ "$scheme" == "$representative" ]] || matrix_paths+=("$path")
  done

  representative_path="${root}/${representative}.scheme"
  if [[ -z "$problem" && ! -f "$representative_path" ]]; then
    problem="missing representative: ${representative}"
  fi
  if [[ -z "$problem" ]] && ! valid_scheme_id "$representative"; then
    problem="invalid representative id: ${representative}"
  fi
  if [[ -z "$problem" ]] && ! read_scheme_title "$representative_path"; then
    problem="invalid representative title: ${representative}"
  fi
  if [[ -z "$problem" ]] && (( ${#matrix_paths[@]} != 27 )); then
    problem="expected 27 matrix schemes; found ${#matrix_paths[@]}"
  fi

  # Validate every candidate before printing a menu, so a failure cannot leave
  # a partially actionable lane.  The emitted-ID guard also prevents a future
  # loop regression from emitting the explicit representative twice.
  candidate_paths=("${matrix_paths[@]}" "$representative_path")
  declare -A emitted_ids=()
  if [[ -z "$problem" ]]; then
    for path in "${candidate_paths[@]}"; do
      scheme="${path##*/}"
      scheme="${scheme%.scheme}"
      if [[ -n ${emitted_ids[$scheme]+x} ]]; then
        problem="duplicate representative or scheme id: ${scheme}"
        break
      fi
      emitted_ids[$scheme]=1
      if ! read_scheme_title "$path"; then
        problem="invalid scheme title: ${scheme}"
        break
      fi
    done
  fi

  if [[ -n "$problem" ]]; then
    emit_diagnostic "$menu_label" "$problem"
    continue
  fi

  printf 'menu "%s" %s {\n' "$menu_label" "$icon"
  for path in "${matrix_paths[@]}"; do
    scheme="${path##*/}"; scheme="${scheme%.scheme}"
    read_scheme_title "$path"; title="$REPLY"
    menu_label_for "$title" "$scheme"; label="$REPLY"
    printf '  prog "%s" %s redstone-9x-scheme-apply "%s"\n' \
      "$(escape_menu "$label")" "$icon" "$scheme"
  done
  printf '  separator\n'
  read_scheme_title "$representative_path"; title="$REPLY"
  menu_label_for "$title" "$representative"; label="$REPLY"
  printf '  prog "%s" %s redstone-9x-scheme-apply "%s"\n' \
    "$(escape_menu "$label")" "$icon" "$representative"
  printf '}\n'
done
# FVWM95 configuration:4 ends here
