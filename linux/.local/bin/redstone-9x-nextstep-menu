#!/bin/bash


# The approved NeXTSTEP family matrix is exposed as one dynamic submenu under
# =Themes=, containing =NeXTSTEP Style=, =GNUstep Style=, and =Rhapsody Style=.
# Each nested menu is generated from the deployed Desktop Scheme files, so the
# menu cannot drift from the exact 27-row matrix.  The helper reads only the
# quoted =SCHEME_TITLE= field; it never sources scheme code.


# [[file:../../../sanctuary-redstone-9x-fvwm95.org::*FVWM95 configuration][FVWM95 configuration:4]]
# Emit the three approved 27-entry NeXTSTEP-family Desktop Scheme menus.
set -euo pipefail
export LC_ALL=C

root="${HOME}/.config/redstone-9x/schemes"
icon="preferences-desktop-theme"
shopt -s nullglob

escape_menu() {
  local value="${1//\\/\\\\}"
  printf '%s' "${value//\"/\\\"}"
}

for lane_spec in \
  "nextstep|NeXTSTEP Style" \
  "gnustep|GNUstep Style" \
  "rhapsody|Rhapsody Style"; do
  lane="${lane_spec%%|*}"
  menu_label="${lane_spec#*|}"
  schemes=("${root}/nextstep-${lane}-"*.scheme)
  printf 'menu "%s" %s {\n' "${menu_label}" "${icon}"
  if (( ${#schemes[@]} != 27 )); then
    printf '  prog "(expected 27 schemes; found %d)" dialog-information true\n' "${#schemes[@]}"
    printf '}\n'
    continue
  fi
  for path in "${schemes[@]}"; do
    scheme="${path##*/}"
    scheme="${scheme%.scheme}"
    case "${scheme}" in
      *[!A-Za-z0-9._+-]*) continue ;;
    esac
    title="$(sed -n 's/^SCHEME_TITLE="\(.*\)"$/\1/p' "${path}" | head -n 1)"
    label="${title#* — }"
    [[ -n "${label}" && "${label}" != "${title}" ]] || label="${scheme}"
    printf '  prog "%s" %s redstone-9x-scheme-apply "%s"\n' \
      "$(escape_menu "${label}")" "${icon}" "${scheme}"
  done
  printf '}\n'
done
# FVWM95 configuration:4 ends here
