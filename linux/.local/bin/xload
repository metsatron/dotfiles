# [[file:../../../distrobox.org::*Sanctuary Launcher Scripts][Sanctuary Launcher Scripts:14]]
#!/usr/bin/env bash
# xload replacement for sanctuary-cde.
# xload is not available in Guix; this stub opens btop (system monitor)
# in a dtterm window. btop is available in the desktop-common profile.
exec dtterm -title "System Load" -e btop
# Sanctuary Launcher Scripts:14 ends here
