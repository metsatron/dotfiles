#!/bin/bash
# [[file:../../../sanctuary-redstone-9x-fvwm95.org::*Dynamic menus — recent Documents + Desktop folder][Dynamic menus — recent Documents + Desktop folder:12]]
GUIX_PROFILE="$HOME/.guix-extra-profiles/desktop-common/desktop-common"; export GUIX_PROFILE
[ -r "$GUIX_PROFILE/etc/profile" ] && . "$GUIX_PROFILE/etc/profile"
GUIX_PROFILE="$HOME/.guix-extra-profiles/room-gaming/room-gaming"; export GUIX_PROFILE
[ -r "$GUIX_PROFILE/etc/profile" ] && . "$GUIX_PROFILE/etc/profile"
set -euo pipefail
export XDG_CONFIG_HOME="$HOME/.config/redstone-9x"
export CM_LAUNCHER=rofi
exec clipmenu
