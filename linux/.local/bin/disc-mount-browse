#!/usr/bin/env bash
# disc-mount-browse IMAGE
# FUSE-mount a CD/DVD image (.iso/.bin/.cue/.nrg/.mdf/.img/.toc) and open it in
# the file manager. Invoked from a Thunar custom action (%f). No terminal: every
# user-facing failure goes to a zenity dialog.
set -euo pipefail

err() {
  if command -v zenity >/dev/null 2>&1; then
    zenity --error --no-wrap --title="Disc image" --text="$1" 2>/dev/null || true
  else
    printf '%s\n' "$1" >&2
  fi
  exit 1
}

[ "$#" -ge 1 ] && [ -n "${1:-}" ] || err "No disc image given."
command -v fuseiso >/dev/null 2>&1 || \
  err "fuseiso is not installed.\nAdd it via package-guix.org, then: loom guix:apply"

src="$1"
[ -e "$src" ] || err "File not found:\n$src"

dir=$(dirname -- "$src")
base=$(basename -- "$src")
ext_lc=$(printf '%s' "${base##*.}" | tr '[:upper:]' '[:lower:]')

# Resolve the actual image file to hand to fuseiso.
img=""
case "$ext_lc" in
  cue|toc)
    # First FILE "<name>" entry in the sheet; resolve case-insensitively.
    want=$(grep -im1 '^[[:space:]]*FILE' -- "$src" \
      | sed -E 's/^[[:space:]]*FILE[[:space:]]+"?([^"]*)"?[[:space:]]+[A-Za-z0-9]+[[:space:]]*$/\1/I')
    if [ -n "$want" ] && [ -e "$dir/$want" ]; then
      img="$dir/$want"
    elif [ -n "$want" ]; then
      hit=$(cd -- "$dir" && ls -1 2>/dev/null | grep -ixF -- "$want" | head -1 || true)
      [ -n "$hit" ] && img="$dir/$hit"
    fi
    if [ -z "$img" ]; then
      stem="${base%.*}"
      for e in bin img iso nrg mdf BIN IMG ISO NRG MDF; do
        [ -e "$dir/$stem.$e" ] && { img="$dir/$stem.$e"; break; }
      done
    fi
    [ -n "$img" ] || err "Could not find the image referenced by:\n$base"
    ;;
  *)
    img="$src"
    ;;
esac

root="${XDG_RUNTIME_DIR:-$HOME/.cache}/disc-mounts"
name=$(basename -- "$img"); name="${name%.*}"
name=$(printf '%s' "$name" | tr -c 'A-Za-z0-9._-' '_')
mnt="$root/$name"
mkdir -p -- "$mnt"

# Mount only if not already mounted at $mnt.
if ! awk -v mp="$mnt" '$2==mp{f=1} END{exit !f}' /proc/mounts 2>/dev/null; then
  log=$(mktemp)
  if ! fuseiso -- "$img" "$mnt" 2>"$log"; then
    msg=$(cat "$log" 2>/dev/null); rm -f "$log"
    err "fuseiso could not mount:\n$img\n\n${msg:-(no error output)}"
  fi
  rm -f "$log"
fi

# Open the mount in the file manager (no terminal).
if command -v thunar >/dev/null 2>&1; then exec thunar "$mnt"
elif command -v exo-open >/dev/null 2>&1; then exec exo-open "$mnt"
elif command -v pcmanfm >/dev/null 2>&1; then exec pcmanfm "$mnt"
else exec xdg-open "$mnt"; fi
