#!/usr/bin/env bash
# [[file:../../../sanctuary-godzilla-xs.org::*Declared font projection][Declared font projection:2]]
# Launch sanctuary-godzilla-xs: Xephyr :94 + XFCE inside the Guix container.
# Switch to an empty host desktop before launching (Xephyr fills the display).
# Prerequisites:
#   loom guix:sanctuary-apply   ← builds desktop-common + sanctuary-godzilla-xs
#   loom guix:room-retropie    ← builds the compatibility fallback profile
#   distrobox-sanctuaries-create
#   vm-homes-init
set -euo pipefail

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  cat <<EOF
sanctuary-godzilla-xs-launch - launch sanctuary-godzilla-xs (Xephyr :94 + XFCE, Godzilla XS-86000)

Usage: sanctuary-godzilla-xs-launch

No arguments. Switch to an empty host desktop before launching (Xephyr fills the display).

Prerequisites:
  loom guix:sanctuary-apply   (desktop-common + sanctuary-godzilla-xs)
  distrobox-sanctuaries-create
  vm-homes-init

Normally invoked via: sanctuary-enter sanctuary-godzilla-xs
EOF
  exit 0
fi

DISPLAY_NUM=":94"
HOST_DISPLAY="${DISPLAY}"
SANCTUARY="sanctuary-godzilla-xs"
GUESTS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/dotcortex/guests"
GUEST_HOME="${GUESTS_DIR}/${SANCTUARY}/home"
GUIX_PROFILES="${HOME}/.guix-extra-profiles"
RETROPIE_HOST_ROOT="${HOME}/RetroPie"
RETROPIE_CONTAINER_ROOT="/run/dotcortex/retropie"
GAMES_HOST_ROOT="${HOME}/Games"
GAMES_CONTAINER_ROOT="/run/dotcortex/games"
DOTCORTEX_SX="${HOME}/DotCortex/linux/.config/sanctuary-godzilla-xs"
SANCTUARY_SHELL="${GUIX_PROFILES}/desktop-common/desktop-common/bin/zsh"
SANCTUARY_UID="$(id -u)"
SANCTUARY_GID="$(id -g)"

# Preflight: verify required Guix profiles exist.
for _prof in desktop-common sanctuary-godzilla-xs room-retropie; do
  _path="${GUIX_PROFILES}/${_prof}/${_prof}/etc/profile"
  if [[ ! -f "${_path}" ]]; then
    echo "${SANCTUARY}: ERROR — Guix profile not built: ${_prof}"
    echo "  Build it with: make guix-${_prof}"
    exit 1
  fi
done
if [[ ! -x "${SANCTUARY_SHELL}" ]]; then
  echo "${SANCTUARY}: ERROR — shared sanctuary shell missing: ${SANCTUARY_SHELL}" >&2
  exit 1
fi

# Follow the host-side autofs links before the container starts.  The Distrobox
# declaration binds the resolved trees directly; nested autofs mounts cannot
# propagate into an already-created container namespace.
if ! stat -L -- "${RETROPIE_HOST_ROOT}/roms/x68000" >/dev/null 2>&1; then
  echo "${SANCTUARY}: ERROR — RetroPie media tree unavailable: ${RETROPIE_HOST_ROOT}" >&2
  echo "  The host automount did not expose roms/x68000; launch was not attempted." >&2
  exit 1
fi

# Enforce the exact, checksummed font payload in the persistent guest home.
FONTS_APPLY="${HOME}/DotCortex/linux/.local/bin/sanctuary-godzilla-xs-fonts-apply"
if [[ ! -x "${FONTS_APPLY}" ]]; then
  echo "${SANCTUARY}: ERROR — declarative font helper missing: ${FONTS_APPLY}" >&2
  echo "  Tangle sanctuary-godzilla-xs.org before launching." >&2
  exit 1
fi
"${FONTS_APPLY}"

# Stable XFCE state is applied after any stale session has been stopped.  The
# guest files remain writable during use; they are never symlinked to tangled
# output, so manual changes can be reviewed and promoted through capture.
CONFIG_APPLY="${HOME}/DotCortex/linux/.local/bin/sanctuary-godzilla-xs-config-apply"
if [[ ! -x "${CONFIG_APPLY}" ]]; then
  echo "${SANCTUARY}: ERROR — declarative config helper missing: ${CONFIG_APPLY}" >&2
  echo "  Tangle sanctuary-godzilla-xs.org before launching." >&2
  exit 1
fi
COLEMAK_APPLY="${HOME}/DotCortex/linux/.local/bin/sanctuary-godzilla-xs-colemak-apply"
if [[ ! -x "${COLEMAK_APPLY}" ]]; then
  echo "${SANCTUARY}: ERROR — Colemak helper missing: ${COLEMAK_APPLY}" >&2
  echo "  Tangle sanctuary-godzilla-xs.org before launching." >&2
  exit 1
fi
mkdir -p "${GUEST_HOME}/.local/bin"
ln -sfnT "${COLEMAK_APPLY}" "${GUEST_HOME}/.local/bin/sanctuary-godzilla-xs-colemak-apply"
CATALOGUE_APPS="${HOME}/DotCortex/linux/.local/bin/sanctuary-godzilla-xs-apps"
if [[ ! -x "${CATALOGUE_APPS}" ]]; then
  echo "${SANCTUARY}: ERROR — catalogue helper missing: ${CATALOGUE_APPS}" >&2
  echo "  Tangle sanctuary-godzilla-xs.org before launching." >&2
  exit 1
fi
ln -sfnT "${CATALOGUE_APPS}" "${GUEST_HOME}/.local/bin/sanctuary-godzilla-xs-apps"
GAMEMODE_RUNNER="${HOME}/DotCortex/linux/.local/bin/sanctuary-gamemode-run"
if [[ ! -x "${GAMEMODE_RUNNER}" ]]; then
  echo "${SANCTUARY}: ERROR — GameMode runner missing: ${GAMEMODE_RUNNER}" >&2
  echo "  Tangle sanctuary-distrobox.org before launching." >&2
  exit 1
fi
ln -sfnT "${GAMEMODE_RUNNER}" "${GUEST_HOME}/.local/bin/sanctuary-gamemode-run"
# System sound scheme: shared helper + user-supplied media dir (see
# sanctuary-distrobox.org "Sanctuary system sounds" — DotCortex ships no audio).
ln -sfnT "${HOME}/DotCortex/linux/.local/bin/sanctuary-sound" "${GUEST_HOME}/.local/bin/sanctuary-sound"
mkdir -p "${GUEST_HOME}/.local/share/sounds/sanctuary"
if [[ ! -f "${GUEST_HOME}/.local/share/sounds/sanctuary/README.txt" ]]; then
  cat > "${GUEST_HOME}/.local/share/sounds/sanctuary/README.txt" <<'SNDEOF'
Godzilla XS-86000 system sounds — X68000-flavoured audio identity.
Drop user-supplied files named <event>.wav (or .ogg/.flac/.mp3):
  startup logoff error question notify
  device-connect device-disconnect recycle-empty
Missing files are silent no-ops. Played by sanctuary-sound.
SNDEOF
fi
if [[ -d "${DOTCORTEX_SX}/themes" ]]; then
  mkdir -p "${GUEST_HOME}/.themes"
  for _theme_dir in "${DOTCORTEX_SX}/themes/"*/; do
    [[ -d "${_theme_dir}" ]] || continue
    ln -sfnT "${_theme_dir}" "${GUEST_HOME}/.themes/$(basename "${_theme_dir}")"
  done
fi
if [[ -d "${DOTCORTEX_SX}/icons" ]]; then
  mkdir -p "${GUEST_HOME}/.icons"
  for _icon_dir in "${DOTCORTEX_SX}/icons/"*/; do
    [[ -d "${_icon_dir}" ]] || continue
    ln -sfnT "${_icon_dir}" "${GUEST_HOME}/.icons/$(basename "${_icon_dir}")"
  done
fi
if [[ -d "${DOTCORTEX_SX}/autostart" ]]; then
  mkdir -p "${GUEST_HOME}/.config/autostart"
  for _desktop in "${DOTCORTEX_SX}/autostart/"*.desktop; do
    [[ -f "${_desktop}" ]] || continue
    ln -sfnT "${_desktop}" "${GUEST_HOME}/.config/autostart/$(basename "${_desktop}")"
  done
fi
# The shared host autostart is visible through the mounted DotCortex tree, but
# it is not part of the Godzilla room contract.  Remove only that known
# managed symlink so it cannot start an agent with the long guest-home socket
# path; user-owned regular files are left untouched.
_ssh_agent_autostart="${GUEST_HOME}/.config/autostart/ssh-agent-session-sync.desktop"
if [[ -L "${_ssh_agent_autostart}" ]] && [[ "$(readlink -f "${_ssh_agent_autostart}")" == "${HOME}/DotCortex/linux/.config/autostart/ssh-agent-session-sync.desktop" ]]; then
  unlink "${_ssh_agent_autostart}"
fi
if [[ -d "${DOTCORTEX_SX}/applications" ]]; then
  mkdir -p "${GUEST_HOME}/.local/share/applications"
  for _desktop in "${DOTCORTEX_SX}/applications/"*.desktop; do
    [[ -f "${_desktop}" ]] || continue
    ln -sfnT "${_desktop}" "${GUEST_HOME}/.local/share/applications/$(basename "${_desktop}")"
  done
fi
if [[ -d "${DOTCORTEX_SX}/desktop-directories" ]]; then
  mkdir -p "${GUEST_HOME}/.local/share/desktop-directories"
  for _directory in "${DOTCORTEX_SX}/desktop-directories/"*.directory; do
    [[ -f "${_directory}" ]] || continue
    ln -sfnT "${_directory}" "${GUEST_HOME}/.local/share/desktop-directories/$(basename "${_directory}")"
  done
fi
if [[ -d "${DOTCORTEX_SX}/menus" ]]; then
  mkdir -p "${GUEST_HOME}/.config/menus"
  for _menu in "${DOTCORTEX_SX}/menus/"*.menu; do
    [[ -f "${_menu}" ]] || continue
    ln -sfnT "${_menu}" "${GUEST_HOME}/.config/menus/$(basename "${_menu}")"
  done
fi
# Launch-only RetroArch overrides are copied into the guest home rather than
# symlinked: they are consumed from inside the container and must not depend on
# the host repository path being visible there.
  if [[ -d "${DOTCORTEX_SX}/retroarch" ]]; then
    mkdir -p "${GUEST_HOME}/.config/retroarch"
    for _retroarch_config in "${DOTCORTEX_SX}/retroarch/px68k-window.cfg" "${DOTCORTEX_SX}/retroarch/px68k-test-"*.cfg "${DOTCORTEX_SX}/retroarch/fbneo-arcade.cfg"; do
      [[ -f "${_retroarch_config}" ]] || continue
      cp -f "${_retroarch_config}" "${GUEST_HOME}/.config/retroarch/$(basename "${_retroarch_config}")"
    done
    # Seed from Guix-bundled autoconfig profiles first, then overlay room-owned
    # profiles on top.  The Guix retroarch-minimal package sets
    # LIBRETRO_AUTOCONFIG_DIRECTORY via native-search-paths, overriding the
    # config-file joypad_autoconfig_dir.  We override that env var at launch
    # time (see fbneo_launch / x68k launcher), so the guest-home dir must be a
    # superset of the Guix-bundled collection plus our custom profiles.
    _guix_autoconfig="${GUIX_PROFILES}/sanctuary-godzilla-xs/sanctuary-godzilla-xs/share/libretro/autoconfig"
    if [[ -d "${_guix_autoconfig}" ]]; then
      for _autoconfig_subdir in "${_guix_autoconfig}/"*/; do
        [[ -d "${_autoconfig_subdir}" ]] || continue
        _driver="$(basename "${_autoconfig_subdir}")"
        mkdir -p "${GUEST_HOME}/.config/retroarch/autoconfig/${_driver}"
        for _retroarch_autoconfig in "${_autoconfig_subdir}"*.cfg; do
          [[ -f "${_retroarch_autoconfig}" ]] || continue
          cp -n "${_retroarch_autoconfig}" "${GUEST_HOME}/.config/retroarch/autoconfig/${_driver}/$(basename "${_retroarch_autoconfig}")"
        done
      done
    fi
    if [[ -d "${DOTCORTEX_SX}/retroarch/autoconfig" ]]; then
      mkdir -p "${GUEST_HOME}/.config/retroarch/autoconfig"
      for _autoconfig_subdir in "${DOTCORTEX_SX}/retroarch/autoconfig/"*/; do
        [[ -d "${_autoconfig_subdir}" ]] || continue
        _driver="$(basename "${_autoconfig_subdir}")"
        mkdir -p "${GUEST_HOME}/.config/retroarch/autoconfig/${_driver}"
        for _retroarch_autoconfig in "${_autoconfig_subdir}"*.cfg; do
          [[ -f "${_retroarch_autoconfig}" ]] || continue
          cp -f "${_retroarch_autoconfig}" "${GUEST_HOME}/.config/retroarch/autoconfig/${_driver}/$(basename "${_retroarch_autoconfig}")"
        done
      done
    fi
    _ra_cfg="${GUEST_HOME}/.config/retroarch/retroarch.cfg"
    if [[ -f "${_ra_cfg}" ]]; then
      sed -i "s|^joypad_autoconfig_dir = .*|joypad_autoconfig_dir = \"${GUEST_HOME}/.config/retroarch/autoconfig\"|" "${_ra_cfg}"
    fi
  fi
if [[ -d "${DOTCORTEX_SX}/godzilla-xs" ]]; then
  mkdir -p "${GUEST_HOME}/.config/sanctuary-godzilla-xs"
  ln -sfnT "${DOTCORTEX_SX}/godzilla-xs" "${GUEST_HOME}/.config/sanctuary-godzilla-xs/godzilla-xs"
fi

# Sanctuary-local Godzilla state roots and narrow Wine prefixes.
if [[ -e "${GUEST_HOME}/RetroPie" && ! -L "${GUEST_HOME}/RetroPie" ]]; then
  echo "${SANCTUARY}: ERROR — refusing to replace non-symlink guest path: ${GUEST_HOME}/RetroPie" >&2
  exit 1
fi
ln -sfnT "${RETROPIE_CONTAINER_ROOT}" "${GUEST_HOME}/RetroPie"
if [[ -L "${GUEST_HOME}/Games" || ! -e "${GUEST_HOME}/Games" ]]; then
  [[ -d "${GAMES_HOST_ROOT}" ]] && ln -sfnT "${GAMES_CONTAINER_ROOT}" "${GUEST_HOME}/Games"
fi
if command -v godzilla-xs-init >/dev/null 2>&1; then
  HOME="${GUEST_HOME}" \
  XDG_DATA_HOME="${GUEST_HOME}/.local/share" \
  XDG_CONFIG_HOME="${GUEST_HOME}/.config" \
  godzilla-xs-init
fi

# Expose host theme and icon collections to the guest.
# ~/.themes and ~/.icons (legacy cursor path) — skip if DotCortex capture dir exists.
[[ -d "${HOME}/.themes" ]] && [[ ! -e "${GUEST_HOME}/.themes" ]] && ln -sfnT "${HOME}/.themes" "${GUEST_HOME}/.themes"
[[ -d "${HOME}/.icons"  ]] && [[ ! -e "${GUEST_HOME}/.icons"  ]] && ln -sfnT "${HOME}/.icons"  "${GUEST_HOME}/.icons"
# ~/.local/share/icons (XDG standard path — where Irixium, irix-icons-linux, BeOS-r5-Icons, etc. live).
if [[ -d "${HOME}/.local/share/icons" ]] && [[ ! -e "${GUEST_HOME}/.local/share/icons" ]]; then
  mkdir -p "${GUEST_HOME}/.local/share"
  ln -sfnT "${HOME}/.local/share/icons" "${GUEST_HOME}/.local/share/icons"
fi

# Project GTK3 settings (overlay scrollbar off, font, icon theme baseline).
if [[ -f "${DOTCORTEX_SX}/gtk-3.0/settings.ini" ]]; then
  mkdir -p "${GUEST_HOME}/.config/gtk-3.0"
  ln -sfnT "${DOTCORTEX_SX}/gtk-3.0/settings.ini" "${GUEST_HOME}/.config/gtk-3.0/settings.ini"
fi

# GTK4 CSD-disable (same decoration-layout trick).
if [[ -f "${DOTCORTEX_SX}/gtk-4.0/settings.ini" ]]; then
  mkdir -p "${GUEST_HOME}/.config/gtk-4.0"
  ln -sfnT "${DOTCORTEX_SX}/gtk-4.0/settings.ini" "${GUEST_HOME}/.config/gtk-4.0/settings.ini"
fi

# Project fastfetch config (Human68k SYSINFO theme) for sanctuary terminal greeting.
# The Command module runs sanctuary-godzilla-xs-fastfetch-grid live inside the container,
# gathering /proc, hostname, xfconf, gsettings at display time.
if [[ -f "${DOTCORTEX_SX}/fastfetch.jsonc" ]]; then
  mkdir -p "${GUEST_HOME}/.config/fastfetch"
  ln -sfnT "${DOTCORTEX_SX}/fastfetch.jsonc" "${GUEST_HOME}/.config/fastfetch/config.jsonc"
fi
# Project the SYSINFO grid helper into the guest so fastfetch can find it.
if [[ -f "${HOME}/DotCortex/linux/.local/bin/sanctuary-godzilla-xs-fastfetch-grid" ]]; then
  mkdir -p "${GUEST_HOME}/.local/bin"
  ln -sfnT "${HOME}/DotCortex/linux/.local/bin/sanctuary-godzilla-xs-fastfetch-grid" "${GUEST_HOME}/.local/bin/sanctuary-godzilla-xs-fastfetch-grid"
fi
# ── Godzilla XS shell identity: Human68k A:\ prompt (shared sanctuary grammar) ──
# Symlink the DotCortex shell rc live into the guest home (edits reflect without a
# relaunch). The zsh link supersedes the old newuser stub; the sanctuary zshrc sources
# the global one itself, so nothing global is edited.
if [[ -d "${DOTCORTEX_SX}/shell" ]]; then
  ln -sfnT "${DOTCORTEX_SX}/shell/bashrc"       "${GUEST_HOME}/.bashrc"
  ln -sfnT "${DOTCORTEX_SX}/shell/bash_profile" "${GUEST_HOME}/.bash_profile"
  ln -sfnT "${DOTCORTEX_SX}/shell/zshrc"        "${GUEST_HOME}/.zshrc"
fi
if [[ -f "${HOME}/DotCortex/linux/.local/bin/sanctuary-godzilla-xs-colemak-apply" ]]; then
  mkdir -p "${GUEST_HOME}/.local/bin"
  ln -sfnT "${HOME}/DotCortex/linux/.local/bin/sanctuary-godzilla-xs-colemak-apply" "${GUEST_HOME}/.local/bin/sanctuary-godzilla-xs-colemak-apply"
fi
if [[ -f "${HOME}/DotCortex/linux/.local/bin/firefox" ]]; then
  mkdir -p "${GUEST_HOME}/.local/bin"
  ln -sfnT "${HOME}/DotCortex/linux/.local/bin/firefox" "${GUEST_HOME}/.local/bin/firefox"
fi
# Ensure guest ~/.local/bin is in the container session PATH.
export PATH="${GUEST_HOME}/.local/bin:${PATH}"

# Host session bus, projected as a FILE for runtime consumers: the XFCE session
# below runs under its own dbus-run-session bus, which lacks
# org.freedesktop.portal.Flatpak (glycin's flatpak-spawn workers need it), so
# sanctuary-flatpak-run points Lutris at the HOST bus, and lutris-play uses it
# for host-spawn sync relays. Refreshed every launch — the address changes per
# host login session.
mkdir -p "${GUEST_HOME}/.config/sanctuary"
printf '%s\n' "${DBUS_SESSION_BUS_ADDRESS:-}" > "${GUEST_HOME}/.config/sanctuary/host-session-bus"

# Lutris-created desktop shortcuts call `flatpak run` directly.  Inside a
# sanctuary they must go through the lutris-play lease/sync envelope wrapping
# sanctuary-flatpak-run so they inherit the sanctuary home, the shared
# Games/RetroPie payload paths, and the machine-local Lutris state links.
# Both the raw Lutris form and the previous wrapper-only rewrite are matched,
# so pre-envelope shortcuts upgrade in place.
if [[ -d "${GUEST_HOME}/.local/share/applications" ]]; then
  _gxs_bin="/home/metsatron/.local/share/dotcortex/guests/sanctuary-godzilla-xs/home/.local/bin"
  for _desktop in "${GUEST_HOME}/.local/share/applications"/net.lutris.*.desktop; do
    [[ -f "${_desktop}" ]] || continue
    sed -i \
      -e "s#^Exec=env LUTRIS_SKIP_INIT=1 flatpak run net\.lutris\.Lutris \(lutris:rungameid/.*\)\$#Exec=env LUTRIS_SKIP_INIT=1 ${_gxs_bin}/lutris-play -- ${_gxs_bin}/sanctuary-flatpak-run net.lutris.Lutris -- \1#" \
      -e "s#^Exec=env LUTRIS_SKIP_INIT=1 ${_gxs_bin}/sanctuary-flatpak-run net\.lutris\.Lutris -- \(lutris:rungameid/.*\)\$#Exec=env LUTRIS_SKIP_INIT=1 ${_gxs_bin}/lutris-play -- ${_gxs_bin}/sanctuary-flatpak-run net.lutris.Lutris -- \1#" \
      "${_desktop}"
  done
fi

# Project managed Audacious Winamp skins into the guest.
# Use a merge so Audacious can extract/use skin directories without DotCortex
# replacing guest-local runtime state.
if [[ -d "${HOME}/DotCortex/linux/.local/share/audacious/Skins" ]]; then
  mkdir -p "${GUEST_HOME}/.local/share/audacious/Skins"
  cp -rn "${HOME}/DotCortex/linux/.local/share/audacious/Skins/"*.wsz "${GUEST_HOME}/.local/share/audacious/Skins/" 2>/dev/null || true
fi
if [[ -d "${HOME}/DotCortex/linux/.qmmp/skins" ]]; then
  mkdir -p "${GUEST_HOME}/.local/share/audacious/Skins"
  for skin in "${HOME}/DotCortex/linux/.qmmp/skins/"*.wsz; do
    [[ -f "${skin}" ]] || continue
    ln -sfnT "${skin}" "${GUEST_HOME}/.local/share/audacious/Skins/$(basename "${skin}")"
  done
fi
mkdir -p "${GUEST_HOME}/.config/audacious"
if [[ -f "${DOTCORTEX_SX}/audacious/config" ]] && [[ ! -e "${GUEST_HOME}/.config/audacious/config" ]]; then
  cp -f "${DOTCORTEX_SX}/audacious/config" "${GUEST_HOME}/.config/audacious/config"
fi

# ── Tear down any surviving prior session before launching fresh ──
sanctuary-teardown-stale-session "${SANCTUARY}" "${DISPLAY_NUM}"

# Apply the canonical desktop state on every launch.  Existing state is backed
# up by the helper; an interactive preservation run remains available via
# sanctuary-godzilla-xs-config-apply --preserve.
"${CONFIG_APPLY}"

mapfile -t XEPHYR_GEOMETRY < <(sanctuary-xephyr-geometry)
Xephyr "${DISPLAY_NUM}" "${XEPHYR_GEOMETRY[@]}" -br -ac -glamor -no-host-grab &
XEPHYR_PID=$!
trap "kill ${XEPHYR_PID} 2>/dev/null || true" EXIT

timeout 10 sh -c "until DISPLAY=${DISPLAY_NUM} xdpyinfo >/dev/null 2>&1; do sleep 0.1; done" \
  || { echo "Xephyr ${DISPLAY_NUM} did not become ready"; kill "${XEPHYR_PID}"; exit 1; }

sanctuary-xephyr-place "${DISPLAY_NUM}" "${HOST_DISPLAY}" "${SANCTUARY}"

_sx_apply_colemak() {
  DISPLAY="${DISPLAY_NUM}" /usr/bin/setxkbmap -layout us -variant colemak -option terminate:ctrl_alt_bksp
}

_sx_apply_colemak
(
  while kill -0 "${XEPHYR_PID}" 2>/dev/null; do
    _sx_current="$(DISPLAY="${DISPLAY_NUM}" /usr/bin/setxkbmap -query 2>/dev/null || true)"
    if ! grep -qx 'variant:[[:space:]]*colemak' <<<"${_sx_current}"; then
      _sx_apply_colemak 2>/dev/null || true
    fi
    sleep 2
  done
) &
KEYMAP_GUARD_PID=$!

sanctuary-clip-bridge "${HOST_DISPLAY}" "${DISPLAY_NUM}" &
CLIP_BRIDGE_PID=$!
trap "kill ${XEPHYR_PID} ${CLIP_BRIDGE_PID} ${KEYMAP_GUARD_PID} 2>/dev/null || true" EXIT

# ── Shield trash:/// from host fleet NFS mounts (see sanctuary-trash-shield) ──
sanctuary-trash-shield "${SANCTUARY}" "${HOME}"

# GUI sessions do not consume a terminal.  Asking crun for one fails when the
# sanctuary's host /dev projection leaves /dev/ptmx unsuitable for ptsname(3),
# so enter explicitly without a TTY while retaining sanctuary-exec's strict
# environment allowlist (in particular, never inherit host credentials).
DISTROBOX_BIN="$(command -v distrobox 2>/dev/null)" \
  || DISTROBOX_BIN="${HOME}/.guix-extra-profiles/core/core/bin/distrobox"
[[ -x "${DISTROBOX_BIN}" ]] \
  || { echo "${SANCTUARY}: ERROR — distrobox not found" >&2; exit 127; }

# Refresh inside the guest, where RETROPIE resolves to the declared
# /run/dotcortex/retropie bind.  Running this on the host would write host
# media paths into guest .desktop files and make the menu appear correct while
# violating sanctuary-godzilla-xs-apps' own media containment check.
catalogue_env=(
  # Distrobox itself is a host-side client; keep the host HOME here. The guest
  # HOME is supplied only to the command executed inside the container below.
  "HOME=${HOME}"
  "USER=${USER:-$(id -un)}"
  "LOGNAME=${LOGNAME:-${USER:-$(id -un)}}"
  "PATH=${PATH}"
  "DISPLAY=${DISPLAY_NUM}"
  "XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/${SANCTUARY_UID}}"
)
if ! env -i "${catalogue_env[@]}" "${DISTROBOX_BIN}" enter --no-tty \
  --additional-flags "--user ${SANCTUARY_UID}:${SANCTUARY_GID}" \
  "${SANCTUARY}" -- env \
  "HOME=${GUEST_HOME}" \
  "XDG_DATA_HOME=${GUEST_HOME}/.local/share" \
  "XDG_CONFIG_HOME=${GUEST_HOME}/.config" \
  "RETROPIE_ROOT=${GUEST_HOME}/RetroPie" \
  "GODZILLA_XS_PROFILE=${GUIX_PROFILES}/sanctuary-godzilla-xs/sanctuary-godzilla-xs" \
  "GODZILLA_XS_RETROPIE_PROFILE=${GUIX_PROFILES}/room-retropie/room-retropie" \
  "${GUEST_HOME}/.local/bin/sanctuary-godzilla-xs-apps" refresh >/dev/null; then
  echo "${SANCTUARY}: warning — catalogue refresh failed; keeping the room launchable" >&2
fi

sx_enter_env=(
  "HOME=${HOME}"
  "USER=${USER:-$(id -un)}"
  "LOGNAME=${LOGNAME:-${USER:-$(id -un)}}"
  "PATH=${PATH}"
  "PWD=${PWD}"
  # XFCE Terminal requires an absolute executable here.  A relative `zsh`
  # value is rejected and silently falls back to the container account's
  # /bin/sh, bypassing the declared sanctuary shell identity.
  "SHELL=${SANCTUARY_SHELL}"
  "DISPLAY=${DISPLAY_NUM}"
  # The shared zshenv starts the host SSH agent unless this room explicitly
  # opts out.  Godzilla has no host-key contract and must not create a socket
  # below its long guest-home path.
  "DOTCORTEX_DISABLE_SSH_AGENT=1"
)
sx_optional_env=(
  TERM COLORTERM
  LANG LANGUAGE LC_ALL LC_CTYPE LC_COLLATE LC_MESSAGES LC_MONETARY LC_NUMERIC LC_TIME
  XAUTHORITY XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS PULSE_SERVER PIPEWIRE_REMOTE
)
for variable in "${sx_optional_env[@]}"; do
  [[ -v "${variable}" ]] && sx_enter_env+=("${variable}=${!variable}")
done

echo "${SANCTUARY}: Xephyr ${DISPLAY_NUM} ready — sourcing Guix profiles and starting XFCE…"
# Keep-id makes the numeric host UID:GID the stable sanctuary identity.  Pass
# it as Distrobox's final Podman exec flag so crun does not have to resolve the
# symbolic user name against the rootfs before entering the running container.
env -i "${sx_enter_env[@]}" "${DISTROBOX_BIN}" enter --no-tty \
  --additional-flags "--user ${SANCTUARY_UID}:${SANCTUARY_GID}" \
  "${SANCTUARY}" -- sh -c "
  GUIX_PROFILE=${GUIX_PROFILES}/desktop-common/desktop-common
  . \${GUIX_PROFILE}/etc/profile
  GUIX_PROFILE=${GUIX_PROFILES}/sanctuary-godzilla-xs/sanctuary-godzilla-xs
  . \${GUIX_PROFILE}/etc/profile
  GUIX_PROFILE=${GUIX_PROFILES}/room-retropie/room-retropie
  . \${GUIX_PROFILE}/etc/profile
  export GODZILLA_XS_PROFILE=${GUIX_PROFILES}/sanctuary-godzilla-xs/sanctuary-godzilla-xs
  export GODZILLA_XS_RETROPIE_PROFILE=${GUIX_PROFILES}/room-retropie/room-retropie
  # The dedicated Godzilla profile wins all PATH collisions.  Wrappers may
  # consult GODZILLA_XS_RETROPIE_PROFILE for a compatibility fallback, but
  # unrelated RetroPie applications are never silently preferred.
  export PATH=\"${GUEST_HOME}/.local/bin:${GUIX_PROFILES}/sanctuary-godzilla-xs/sanctuary-godzilla-xs/bin:${GUIX_PROFILES}/room-retropie/room-retropie/bin:${GUIX_PROFILES}/desktop-common/desktop-common/bin:/usr/local/bin:/usr/bin:/bin\"
  export SHELL=${SANCTUARY_SHELL}
  export XDG_DATA_DIRS=${GUIX_PROFILES}/sanctuary-godzilla-xs/sanctuary-godzilla-xs/share:${GUIX_PROFILES}/room-retropie/room-retropie/share:${GUIX_PROFILES}/desktop-common/desktop-common/share:/usr/local/share:/usr/share
  export XDG_CONFIG_DIRS=${GUIX_PROFILES}/sanctuary-godzilla-xs/sanctuary-godzilla-xs/etc/xdg:${GUIX_PROFILES}/room-retropie/room-retropie/etc/xdg:${GUIX_PROFILES}/desktop-common/desktop-common/etc/xdg:/etc/xdg
  # The small Guix base image intentionally has no machine identity.  D-Bus
  # clients such as RetroArch still require one, so initialize the writable
  # container /etc once before starting the session.
  if [[ ! -s /etc/machine-id ]] && command -v dbus-uuidgen >/dev/null 2>&1; then
    dbus-uuidgen --ensure=/etc/machine-id || echo \"${SANCTUARY}: warning — could not initialize /etc/machine-id\" >&2
  fi
  export GTK_CSD=0
  export GTK_OVERLAY_SCROLLING=0
  export LIBOVERLAY_SCROLLBAR=0
  # The SX room does not use portal file pickers, and fcitx5/tumbler can
  # otherwise drag xdg-desktop-portal + document portal activation into the
  # session, producing long startup stalls and FUSE timeout noise.
  export GTK_USE_PORTAL=0
  export GIO_USE_PORTAL=0
  # gvfs tries to spawn gvfsd-fuse via fusermount3 inside the sanctuary. That
  # binary is not present in the room contract, and the failed FUSE mount path
  # is just noise/risk here: SX needs gvfs' D-Bus backends for thunar trash:///
  # and volume metadata, not the ~/.gvfs FUSE mirror.
  export GVFS_DISABLE_FUSE=1
  # Suppress the at-spi2 accessibility bridge: each GTK app launched inside
  # dbus-run-session otherwise spawns its own at-spi2 bus daemon (1 inotify
  # instance each, never reaped) and can saturate max_user_instances=128.
  # sanctuary-godzilla-xs does not need accessibility services for the default room.
  export NO_AT_BRIDGE=1
  exec dbus-run-session sh -c 'gamemoded -d >/dev/null 2>&1 || true; exec startxfce4'
"

# Session over — play the logoff sound host-side (host paplay, same Pulse
# server). Backgrounded subshell: the chime outlives this script; teardown
# must never wait on audio.
( sanctuary-sound logoff "${GUEST_HOME}/.local/share/sounds/sanctuary" >/dev/null 2>&1 & ) || true

kill "${XEPHYR_PID}" 2>/dev/null || true
# Declared font projection:2 ends here
