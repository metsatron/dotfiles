#!/usr/bin/env bash
# [[file:../../../sanctuary-distrobox.org::*Sanctuary Launcher Scripts][Sanctuary Launcher Scripts:6]]
# Launch sanctuary-qtile: Xephyr :90 + Qtile inside the Guix container.
# Switch to Desktop 2 (Ctrl+F2) first.
set -euo pipefail

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  cat <<EOF
sanctuary-qtile-launch - launch sanctuary-qtile (Xephyr :90 + Qtile, Emacs Sanctuary)

Usage: sanctuary-qtile-launch

No arguments. Switch to host Desktop 2 (Ctrl+F2) before launching.
Normally invoked via: sanctuary-enter sanctuary-qtile
EOF
  exit 0
fi

DISPLAY_NUM=":90"
HOST_DISPLAY="${DISPLAY}"
SANCTUARY="sanctuary-qtile"
GUIX_PROFILES="${HOME}/.guix-extra-profiles"

sanctuary-teardown-stale-session "${SANCTUARY}" "${DISPLAY_NUM}"

Xephyr "${DISPLAY_NUM}" -fullscreen -br -ac -no-host-grab &
XEPHYR_PID=$!
trap "kill ${XEPHYR_PID} 2>/dev/null || true" EXIT

timeout 10 sh -c "until DISPLAY=${DISPLAY_NUM} xdpyinfo >/dev/null 2>&1; do sleep 0.1; done" \
  || { echo "Xephyr ${DISPLAY_NUM} did not become ready"; kill "${XEPHYR_PID}"; exit 1; }

sanctuary-clip-bridge "${HOST_DISPLAY}" "${DISPLAY_NUM}" &
CLIP_BRIDGE_PID=$!
trap "kill ${XEPHYR_PID} ${CLIP_BRIDGE_PID} 2>/dev/null || true" EXIT

# ── Shield trash:/// from host fleet NFS mounts (see sanctuary-trash-shield) ──
sanctuary-trash-shield "${SANCTUARY}" "${HOME}"

echo "${SANCTUARY}: Xephyr ${DISPLAY_NUM} ready — sourcing Guix profiles and starting Qtile…"
DISPLAY="${DISPLAY_NUM}" sanctuary-exec "${SANCTUARY}" sh -c "
  GUIX_PROFILE=${GUIX_PROFILES}/desktop-common/desktop-common
  . \${GUIX_PROFILE}/etc/profile
  GUIX_PROFILE=${GUIX_PROFILES}/sanctuary-qtile/sanctuary-qtile
  . \${GUIX_PROFILE}/etc/profile
  exec qtile start
"

kill "${XEPHYR_PID}" 2>/dev/null || true
# Sanctuary Launcher Scripts:6 ends here
