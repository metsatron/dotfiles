#!/bin/bash
# Stable renderer wrapper


# [[file:../../../sanctuary-redstone-9x-buildstamp.org::*Stable renderer wrapper][Stable renderer wrapper:1]]
set -euo pipefail

product_default="Mineshaft Redstone 9X"
config_home="${XDG_CONFIG_HOME:-${HOME}/.config}"
data_home="${XDG_DATA_HOME:-${HOME}/.local/share}"
cache_home="${XDG_CACHE_HOME:-${HOME}/.cache}"
runtime_root="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/dotcortex/redstone-9x"
metadata_file="${data_home}/redstone-9x/build.ini"
defaults_file="${config_home}/redstone-9x/buildstamp.conf"
local_file="${config_home}/redstone-9x/buildstamp.local"
scheme_state="${config_home}/redstone-9x/scheme"
scheme_dir="${config_home}/redstone-9x/schemes"
label_state_file="${config_home}/redstone-9x/desktop-label-colors.conf"
text_file="${runtime_root}/buildstamp.txt"
product_text_file="${runtime_root}/buildstamp.product.txt"
detail_text_file="${runtime_root}/buildstamp.details.txt"
pid_file="${runtime_root}/buildstamp.pid"
state_file="${runtime_root}/buildstamp.state"
command_file="${runtime_root}/buildstamp.command"
log_file="${cache_home}/redstone-9x/buildstamp.log"

usage() {
  cat <<'EOF'
Usage: redstone-buildstamp {start|refresh|stop|show|status|label-colors [SCHEME]}

  start    generate two-line runtime text and start both renderers if needed
  refresh  reread identity/theme/style and restart both recorded renderers
  stop     stop only the two validated recorded renderers and remove runtime state
  show     print the exact two-line product/build+theme text without launching XOSD
  status   report both processes, theme, build, display, files, and commands
  label-colors [SCHEME]
           resolve one fresh shared foreground/shadow pair without rendering
EOF
}

warn() {
  mkdir -p "$(dirname "${log_file}")"
  printf 'redstone-buildstamp: %s\n' "$*" | tee -a "${log_file}" >&2
}

ini_value() {
  local key="$1"
  [[ -f "${metadata_file}" ]] || return 0
  awk -F= -v wanted="${key}" '
    /^\[Build\]$/ { in_build=1; next }
    /^\[/ { in_build=0 }
    in_build && $1 == wanted { sub(/^[^=]*=/, ""); print; exit }
  ' "${metadata_file}"
}

# ITU-R BT.601 luma of a #rrggbb colour, 0-255. Same weights the Desktop Scheme
# converter uses for its own dark/light decisions, so the two agree.
hex_luma() {
  local hex="${1#\#}" r g b
  [[ "${hex}" =~ ^[0-9A-Fa-f]{6}$ ]] || return 1
  r=$(( 16#${hex:0:2} )); g=$(( 16#${hex:2:2} )); b=$(( 16#${hex:4:2} ))
  printf '%s\n' $(( (299 * r + 587 * g + 114 * b) / 1000 ))
}

# An interpreter that can actually decode an image. Bare `python3` on the guest
# PATH is a host shim resolving to a /usr/bin/python3 that does not exist inside
# the container; the room sources desktop-common, whose python3 carries Pillow.
pixel_python() {
  local candidate
  for candidate in \
    "${HOME}/.guix-extra-profiles/desktop-common/desktop-common/bin/python3" \
    "${HOME}/.guix-extra-profiles/core/core/bin/python3" \
    python3
  do
    "${candidate}" -c 'from PIL import Image' >/dev/null 2>&1 || continue
    printf '%s\n' "${candidate}"
    return 0
  done
  return 1
}

# Mean luma of the screen region the stamp actually covers. The box is derived
# from the same margins, font sizes and line gap the renderer uses, so what gets
# sampled is what gets drawn over -- not an approximation of the whole desktop.
backdrop_luma() {
  local dims screen_w screen_h detail_off product_off
  local box_x box_y box_w box_h interp sampled mode

  dims="$(xdpyinfo 2>/dev/null | awk '/dimensions:/ { print $2; exit }')" || true
  screen_w="${dims%x*}"; screen_h="${dims#*x}"
  if [[ ! "${screen_w}" =~ ^[0-9]+$ || ! "${screen_h}" =~ ^[0-9]+$ ]]; then
    # Boot-time application may run without a live X display. The scheme's
    # flat desktop colour is the deterministic headless fallback.
    [[ -n "${DESKTOP_BG:-}" ]] || return 1
    hex_luma "${DESKTOP_BG}"
    return
  fi

  detail_off="$(bottom_offset)"
  product_off=$(( detail_off + BUILDSTAMP_DETAIL_FONT_SIZE \
                  + (2 * BUILDSTAMP_SHADOW_OFFSET) + BUILDSTAMP_LINE_GAP ))
  box_h=$(( product_off + BUILDSTAMP_PRODUCT_FONT_SIZE - detail_off ))
  box_w="${BUILDSTAMP_SAMPLE_WIDTH}"
  (( box_w > 0 && box_w < screen_w )) || box_w=$(( screen_w / 4 ))
  box_x=$(( screen_w - BUILDSTAMP_RIGHT_MARGIN - box_w ))
  box_y=$(( screen_h - detail_off - box_h ))
  (( box_x >= 0 )) || box_x=0
  (( box_y >= 0 )) || box_y=0
  (( box_h > 0 )) || box_h=1

  # A wallpaper image wins only if it is readable AND something can decode it;
  # otherwise the scheme's flat desktop colour is the honest answer.
  if [[ -n "${WALLPAPER:-}" && -f "${WALLPAPER}" ]]; then
    interp="$(pixel_python)" || interp=""
    if [[ -n "${interp}" ]]; then
      mode="${WALLPAPER_MODE:-center}"
      sampled="$("${interp}" - "${WALLPAPER}" "${mode}" \
        "${box_x}" "${box_y}" "${box_w}" "${box_h}" \
        "${screen_w}" "${screen_h}" "${DESKTOP_BG:-#000000}" <<'PY' 2>/dev/null || true
import sys
from PIL import Image

path, mode, bx, by, bw, bh, sw, sh, bg = sys.argv[1:10]
bx, by, bw, bh, sw, sh = (int(v) for v in (bx, by, bw, bh, sw, sh))

bg = bg.lstrip('#')
try:
    back = tuple(int(bg[i:i + 2], 16) for i in (0, 2, 4))
except (ValueError, IndexError):
    back = (0, 0, 0)

img = Image.open(path).convert('RGB')
iw, ih = img.size

# Reproduce libfm's placement so the sampled pixels are the drawn pixels.
if mode == 'stretch':
    img = img.resize((sw, sh)); ox = oy = 0
elif mode in ('fit', 'crop', 'screen', 'zoom'):
    pick = max if mode in ('crop', 'screen', 'zoom') else min
    scale = pick(sw / iw, sh / ih)
    nw, nh = max(1, round(iw * scale)), max(1, round(ih * scale))
    img = img.resize((nw, nh))
    ox, oy = (sw - nw) // 2, (sh - nh) // 2
elif mode == 'tile':
    ox = oy = 0
else:  # center
    ox, oy = (sw - iw) // 2, (sh - ih) // 2

iw, ih = img.size
px = img.load()

# A coarse grid is plenty for a mean and keeps a 2560x1600 backdrop cheap.
step = max(1, min(bw, bh) // 16)
total = [0, 0, 0]
count = 0
for y in range(by, by + bh, step):
    for x in range(bx, bx + bw, step):
        if mode == 'tile':
            r, g, b = px[x % iw, y % ih]
        else:
            ix, iy = x - ox, y - oy
            # Outside the image the desktop colour shows through.
            r, g, b = px[ix, iy] if (0 <= ix < iw and 0 <= iy < ih) else back
        total[0] += r; total[1] += g; total[2] += b
        count += 1

if not count:
    sys.exit(1)
r, g, b = (t // count for t in total)
print((299 * r + 587 * g + 114 * b) // 1000)
PY
)"
      if [[ "${sampled}" =~ ^[0-9]+$ ]]; then
        printf '%s\n' "${sampled}"
        return 0
      fi
      warn "could not sample ${WALLPAPER}; falling back to the desktop colour"
    fi
  fi

  [[ -n "${DESKTOP_BG:-}" ]] || return 1
  hex_luma "${DESKTOP_BG}"
}

is_hex_colour() {
  [[ "${1:-}" =~ ^#[0-9A-Fa-f]{6}$ ]]
}

inverse_shadow() {
  local luma
  luma="$(hex_luma "${1}")" || return 1
  if (( luma >= 128 )); then
    printf '#000000\n'
  else
    printf '#ffffff\n'
  fi
}

validate_label_contract() {
  case "${BUILDSTAMP_FOREGROUND}:${BUILDSTAMP_SHADOW}" in
    auto:auto) return 0 ;;
    *auto*)
      warn "desktop-label foreground and shadow must both be auto or both be literal colours"
      return 1
      ;;
  esac
  if ! is_hex_colour "${BUILDSTAMP_FOREGROUND}" \
     || ! is_hex_colour "${BUILDSTAMP_SHADOW}"; then
    warn "invalid desktop-label pair: ${BUILDSTAMP_FOREGROUND} ${BUILDSTAMP_SHADOW}"
    return 1
  fi
}

# Resolve the shared foreground/shadow pair against the sampled backdrop.
# White-on-black is the fallback whenever sampling cannot produce an answer,
# which is exactly what the stamp did before it could sample.
resolve_contrast() {
  local luma="" fg="#ffffff" sh="#000000"

  validate_label_contract || return 1
  [[ "${BUILDSTAMP_FOREGROUND}:${BUILDSTAMP_SHADOW}" == "auto:auto" ]] || return 0

  luma="$(backdrop_luma 2>/dev/null)" || luma=""
  if [[ "${luma}" =~ ^[0-9]+$ ]] \
     && (( luma >= BUILDSTAMP_CONTRAST_THRESHOLD )); then
    fg="#000000"; sh="#ffffff"
  fi

  BUILDSTAMP_FOREGROUND="${fg}"
  BUILDSTAMP_SHADOW="${sh}"
  return 0
}

read_label_state() {
  LABEL_STATE_SCHEME=""
  LABEL_STATE_FOREGROUND=""
  LABEL_STATE_SHADOW=""
  [[ -r "${label_state_file}" ]] || return 1
  while IFS='=' read -r key value; do
    case "${key}" in
      LABEL_STATE_SCHEME) LABEL_STATE_SCHEME="${value}" ;;
      DESKTOP_LABEL_FOREGROUND) LABEL_STATE_FOREGROUND="${value}" ;;
      DESKTOP_LABEL_SHADOW) LABEL_STATE_SHADOW="${value}" ;;
    esac
  done < "${label_state_file}"
  [[ -n "${LABEL_STATE_SCHEME}" && -n "${LABEL_STATE_FOREGROUND}" \
     && -n "${LABEL_STATE_SHADOW}" ]]
}

load_identity() {
  local requested_scheme="${1:-}" contrast_source="${2:-state}"
  local default_label_fg default_label_sh default_build_fg default_build_sh
  local scheme_label_fg="" scheme_label_sh=""

  PRODUCT="$(ini_value product)"
  BUILD_ID="$(ini_value identifier)"
  BUILD_COMMIT="$(ini_value commit)"
  [[ -n "${PRODUCT}" ]] || PRODUCT="${product_default}"
  [[ -n "${BUILD_ID}" ]] || BUILD_ID="${BUILD_COMMIT:-unknown}"

  SCHEME_ID="${requested_scheme:-$(cat "${scheme_state}" 2>/dev/null || printf 'windows-95')}"
  SCHEME_FILE="${scheme_dir}/${SCHEME_ID}.scheme"
  SCHEME_TITLE=""

  BUILDSTAMP_ENABLED=1
  BUILDSTAMP_PRODUCT_FONT="-misc-fixed-bold-r-normal--12-*-*-*-c-*-iso10646-1"
  BUILDSTAMP_PRODUCT_FONT_SIZE=12
  BUILDSTAMP_DETAIL_FONT="-misc-fixed-medium-r-normal--12-*-*-*-c-*-iso10646-1"
  BUILDSTAMP_DETAIL_FONT_SIZE=12
  BUILDSTAMP_LINE_GAP=2
  BUILDSTAMP_FOREGROUND=""
  BUILDSTAMP_SHADOW=""
  BUILDSTAMP_SHADOW_OFFSET=1
  BUILDSTAMP_RIGHT_MARGIN=14
  BUILDSTAMP_BOTTOM_MARGIN=12
  BUILDSTAMP_CONTRAST_THRESHOLD=128
  BUILDSTAMP_SAMPLE_WIDTH=360

  # Backdrop keys owned by the Desktop Scheme, not by the stamp. Cleared before
  # sourcing so a value leaking in from the room environment can never stand in
  # for a scheme that does not declare one.
  WALLPAPER=""
  WALLPAPER_MODE=""
  DESKTOP_BG=""
  DESKTOP_LABEL_FOREGROUND=""
  DESKTOP_LABEL_SHADOW=""
  DESKTOP_ICON_LABEL_FOREGROUND=""
  DESKTOP_ICON_LABEL_SHADOW_COLOR=""

  # shellcheck disable=SC1090
  [[ -r "${defaults_file}" ]] && . "${defaults_file}"
  default_label_fg="${DESKTOP_LABEL_FOREGROUND:-auto}"
  default_label_sh="${DESKTOP_LABEL_SHADOW:-auto}"
  default_build_fg="${BUILDSTAMP_FOREGROUND:-}"
  default_build_sh="${BUILDSTAMP_SHADOW:-}"

  # Clear scheme-owned keys before sourcing so inherited environment/default
  # values cannot masquerade as declarations in this layer.
  DESKTOP_LABEL_FOREGROUND=""
  DESKTOP_LABEL_SHADOW=""
  DESKTOP_ICON_LABEL_FOREGROUND=""
  DESKTOP_ICON_LABEL_SHADOW_COLOR=""
  # Existing Desktop Scheme declarations are trusted shell assignments.
  # shellcheck disable=SC1090
  [[ -r "${SCHEME_FILE}" ]] && . "${SCHEME_FILE}"

  # New shared keys win. Existing icon-label declarations migrate as one pair;
  # when their shadow was implicit, derive the opposite polarity. The older
  # BUILDSTAMP_* scheme keys remain a final compatibility input.
  if [[ -n "${DESKTOP_LABEL_FOREGROUND}" || -n "${DESKTOP_LABEL_SHADOW}" ]]; then
    scheme_label_fg="${DESKTOP_LABEL_FOREGROUND}"
    scheme_label_sh="${DESKTOP_LABEL_SHADOW}"
  elif [[ -n "${DESKTOP_ICON_LABEL_FOREGROUND}" ]]; then
    scheme_label_fg="${DESKTOP_ICON_LABEL_FOREGROUND}"
    scheme_label_sh="${DESKTOP_ICON_LABEL_SHADOW_COLOR}"
    if [[ -z "${scheme_label_sh}" ]] && is_hex_colour "${scheme_label_fg}"; then
      scheme_label_sh="$(inverse_shadow "${scheme_label_fg}")"
    fi
  elif [[ "${BUILDSTAMP_FOREGROUND:-}" != "${default_build_fg}" \
       || "${BUILDSTAMP_SHADOW:-}" != "${default_build_sh}" ]]; then
    scheme_label_fg="${BUILDSTAMP_FOREGROUND:-${default_label_fg}}"
    scheme_label_sh="${BUILDSTAMP_SHADOW:-}"
    if [[ -z "${scheme_label_sh}" ]] && is_hex_colour "${scheme_label_fg}"; then
      scheme_label_sh="$(inverse_shadow "${scheme_label_fg}")"
    fi
  else
    scheme_label_fg="${default_label_fg}"
    scheme_label_sh="${default_label_sh}"
  fi
  BUILDSTAMP_FOREGROUND="${scheme_label_fg}"
  BUILDSTAMP_SHADOW="${scheme_label_sh}"

  # Private overrides remain last. New shared keys are preferred; legacy
  # BUILDSTAMP_* assignments are still accepted and are synchronized on the
  # next scheme application.
  DESKTOP_LABEL_FOREGROUND=""
  DESKTOP_LABEL_SHADOW=""
  # Private user override is sourced last and never belongs to DotCortex.
  # shellcheck disable=SC1090
  [[ -r "${local_file}" ]] && . "${local_file}"
  if [[ -n "${DESKTOP_LABEL_FOREGROUND}" || -n "${DESKTOP_LABEL_SHADOW}" ]]; then
    BUILDSTAMP_FOREGROUND="${DESKTOP_LABEL_FOREGROUND}"
    BUILDSTAMP_SHADOW="${DESKTOP_LABEL_SHADOW}"
  fi

  [[ -n "${SCHEME_TITLE}" ]] || SCHEME_TITLE="${SCHEME_ID:-Unknown Theme}"
  [[ -n "${SCHEME_TITLE}" ]] || SCHEME_TITLE="Unknown Theme"

  # Normal renderer operations consume scheme-apply's exact resolved state.
  # `label-colors` explicitly asks for a fresh decision and is the sole writer's
  # input, preventing two consumers from sampling independently.
  if [[ "${contrast_source}" == fresh ]]; then
    resolve_contrast
  elif read_label_state && [[ "${LABEL_STATE_SCHEME}" == "${SCHEME_ID}" ]]; then
    BUILDSTAMP_FOREGROUND="${LABEL_STATE_FOREGROUND}"
    BUILDSTAMP_SHADOW="${LABEL_STATE_SHADOW}"
    validate_label_contract
  else
    warn "shared desktop-label state missing for ${SCHEME_ID}; apply the Desktop Scheme first"
    return 1
  fi
}

compose_text() {
  printf '%s\nBuild %s  %s\n' "${PRODUCT}" "${BUILD_ID}" "${SCHEME_TITLE}"
}

resolve_display() {
  REDSTONE_DISPLAY="${DISPLAY:-:93}"
  case "${REDSTONE_DISPLAY}" in
    :93|:93.0) ;;
    *) warn "refusing non-Redstone display ${REDSTONE_DISPLAY}"; return 1 ;;
  esac
  export DISPLAY="${REDSTONE_DISPLAY}"
}

render_text() {
  mkdir -p "${runtime_root}"
  local tmp product_tmp detail_tmp
  tmp="$(mktemp "${text_file}.tmp.XXXXXX")"
  product_tmp="$(mktemp "${product_text_file}.tmp.XXXXXX")"
  detail_tmp="$(mktemp "${detail_text_file}.tmp.XXXXXX")"
  compose_text >"${tmp}"
  sed -n '1p' "${tmp}" >"${product_tmp}"
  sed -n '2p' "${tmp}" >"${detail_tmp}"
  if [[ "$(wc -l <"${tmp}")" -ne 2 || "$(wc -l <"${product_tmp}")" -ne 1 \
        || "$(wc -l <"${detail_tmp}")" -ne 1 ]]; then
    rm -f -- "${tmp}" "${product_tmp}" "${detail_tmp}"
    warn "internal error: build stamp must contain exactly two physical lines"
    return 1
  fi
  chmod 0600 "${tmp}" "${product_tmp}" "${detail_tmp}"
  mv -f -- "${tmp}" "${text_file}"
  mv -f -- "${product_tmp}" "${product_text_file}"
  mv -f -- "${detail_tmp}" "${detail_text_file}"
}

renderer_path() {
  command -v osd_cat 2>/dev/null || true
}

font_for_xosd() {
  local role="$1" candidate size weight fallback
  if [[ "${role}" == product ]]; then
    candidate="${BUILDSTAMP_PRODUCT_FONT}"
    size="${BUILDSTAMP_PRODUCT_FONT_SIZE}"
    weight="bold"
    fallback="-misc-fixed-bold-r-normal--12-*-*-*-c-*-iso10646-1"
  else
    candidate="${BUILDSTAMP_DETAIL_FONT}"
    size="${BUILDSTAMP_DETAIL_FONT_SIZE}"
    weight="medium"
    fallback="-misc-fixed-medium-r-normal--12-*-*-*-c-*-iso10646-1"
  fi
  if [[ "${candidate}" != -* ]]; then
    candidate="-*-${candidate// /-}-${weight}-r-normal--${size}-*-*-*-*-*-iso10646-1"
  fi
  if command -v xlsfonts >/dev/null 2>&1 \
     && ! xlsfonts "${candidate}" 2>/dev/null | grep -q .; then
    candidate="${fallback}"
  fi
  printf '%s\n' "${candidate}"
}

bottom_offset() {
  local offset="${BUILDSTAMP_BOTTOM_MARGIN}" dims height workarea wy wh reserved
  if command -v xdpyinfo >/dev/null 2>&1 && command -v xprop >/dev/null 2>&1; then
    dims="$(xdpyinfo 2>/dev/null | awk '/dimensions:/ { print $2; exit }')"
    height="${dims#*x}"
    workarea="$(xprop -root _NET_WORKAREA 2>/dev/null | sed 's/^[^=]*= *//' | cut -d, -f1-4)"
    if [[ "${height}" =~ ^[0-9]+$ && -n "${workarea}" ]]; then
      IFS=, read -r _wx wy _ww wh <<< "${workarea// /}"
      if [[ "${wy}" =~ ^[0-9]+$ && "${wh}" =~ ^[0-9]+$ ]]; then
        reserved=$(( height - wy - wh ))
        (( reserved > 0 )) && offset=$(( reserved + BUILDSTAMP_BOTTOM_MARGIN ))
      fi
    fi
  fi
  printf '%s\n' "${offset}"
}

process_starttime() {
  awk '{ print $22 }' "/proc/$1/stat" 2>/dev/null
}

read_recorded_state() {
  PRODUCT_PID=""
  PRODUCT_START=""
  PRODUCT_EXE=""
  DETAIL_PID=""
  DETAIL_START=""
  DETAIL_EXE=""
  RECORDED_DISPLAY=""
  LEGACY_PID=""
  LEGACY_START=""
  LEGACY_EXE=""
  if [[ -r "${pid_file}" ]]; then
    if [[ "$(cat "${pid_file}")" =~ ^[0-9]+$ ]]; then
      LEGACY_PID="$(cat "${pid_file}")"
    else
      while IFS='=' read -r key value; do
        case "${key}" in
          product) PRODUCT_PID="${value}" ;;
          details) DETAIL_PID="${value}" ;;
        esac
      done <"${pid_file}"
    fi
  fi
  if [[ -r "${state_file}" ]]; then
    while IFS='=' read -r key value; do
      case "${key}" in
        product_starttime) PRODUCT_START="${value}" ;;
        product_executable) PRODUCT_EXE="${value}" ;;
        details_starttime) DETAIL_START="${value}" ;;
        details_executable) DETAIL_EXE="${value}" ;;
        display) RECORDED_DISPLAY="${value}" ;;
        starttime) LEGACY_START="${value}" ;;
        executable) LEGACY_EXE="${value}" ;;
      esac
    done < "${state_file}"
  fi
}

process_is_ours() {
  local pid="$1" start="$2" executable="$3"
  [[ "${pid}" =~ ^[0-9]+$ ]] || return 1
  kill -0 "${pid}" 2>/dev/null || return 1
  [[ -n "${start}" && "$(process_starttime "${pid}")" == "${start}" ]] || return 1
  [[ -n "${executable}" \
     && "$(readlink -f "/proc/${pid}/exe" 2>/dev/null || true)" == "${executable}" ]] || return 1
  return 0
}

recorded_pair_is_ours() {
  read_recorded_state
  process_is_ours "${PRODUCT_PID}" "${PRODUCT_START}" "${PRODUCT_EXE}" \
    && process_is_ours "${DETAIL_PID}" "${DETAIL_START}" "${DETAIL_EXE}"
}

remove_process_state() {
  rm -f -- "${pid_file}" "${state_file}" "${command_file}"
}

remove_runtime_state() {
  remove_process_state
  rm -f -- "${text_file}" "${product_text_file}" "${detail_text_file}"
}

terminate_pid() {
  local pid="$1"
  [[ "${pid}" =~ ^[0-9]+$ ]] || return 0
  kill "${pid}" 2>/dev/null || true
  for _attempt in {1..20}; do
    kill -0 "${pid}" 2>/dev/null || break
    sleep 0.1
  done
  if kill -0 "${pid}" 2>/dev/null; then
    kill -KILL "${pid}" 2>/dev/null || true
  fi
}

stop_renderer() {
  read_recorded_state
  if process_is_ours "${PRODUCT_PID}" "${PRODUCT_START}" "${PRODUCT_EXE}"; then
    terminate_pid "${PRODUCT_PID}"
  fi
  if process_is_ours "${DETAIL_PID}" "${DETAIL_START}" "${DETAIL_EXE}"; then
    terminate_pid "${DETAIL_PID}"
  fi
  # One-time migration from the original single-process state format.
  if process_is_ours "${LEGACY_PID}" "${LEGACY_START}" "${LEGACY_EXE}"; then
    terminate_pid "${LEGACY_PID}"
  fi
  remove_runtime_state
}

validate_detail_width() {
  local font="$1" dims screen_width resolved average_width char_width estimate available
  dims="$(xdpyinfo 2>/dev/null | awk '/dimensions:/ { print $2; exit }')"
  screen_width="${dims%x*}"
  resolved="$(xlsfonts "${font}" 2>/dev/null | head -n 1 || true)"
  average_width="$(awk -F- '{ print $13 }' <<<"${resolved}")"
  [[ "${screen_width}" =~ ^[0-9]+$ ]] || return 0
  if [[ "${average_width}" =~ ^[0-9]+$ && "${average_width}" -gt 0 ]]; then
    char_width=$(( (average_width + 9) / 10 ))
  else
    char_width=$(( (BUILDSTAMP_DETAIL_FONT_SIZE * 3 + 3) / 5 ))
  fi
  estimate=$(( ${#DETAIL_TEXT} * char_width + BUILDSTAMP_SHADOW_OFFSET + 2 ))
  available=$(( screen_width - BUILDSTAMP_RIGHT_MARGIN ))
  if (( estimate > available )); then
    warn "details line is ${estimate}px wide but only ${available}px is available"
    return 1
  fi
}

start_renderer() {
  load_identity
  if [[ "${BUILDSTAMP_ENABLED}" != 1 ]]; then
    stop_renderer
    return 0
  fi
  resolve_display || return 1
  render_text || return 1
  if recorded_pair_is_ours; then
    printf 'redstone-buildstamp: already running (product=%s details=%s)\n' \
      "${PRODUCT_PID}" "${DETAIL_PID}"
    return 0
  fi
  # If only one half survived, stop that exact validated PID before replacing
  # the pair.  Never allow a half-stamp to survive a recovery or refresh.
  stop_renderer
  render_text || return 1
  # Preserve the freshly rendered text while discarding only stale process
  # ownership records before launching its two readers.
  remove_process_state

  local renderer product_font detail_font detail_offset product_offset
  local product_pid detail_pid product_exe detail_exe
  local -a product_args detail_args
  renderer="$(renderer_path)"
  if [[ -z "${renderer}" ]]; then
    warn "osd_cat is unavailable; desktop startup continues without a stamp"
    return 0
  fi
  if ! command -v xdpyinfo >/dev/null 2>&1 || ! xdpyinfo >/dev/null 2>&1; then
    warn "Redstone display ${DISPLAY} is unavailable"
    return 0
  fi
  product_font="$(font_for_xosd product)"
  detail_font="$(font_for_xosd details)"
  DETAIL_TEXT="$(cat "${detail_text_file}")"
  validate_detail_width "${detail_font}" || {
    remove_runtime_state
    return 0
  }
  detail_offset="$(bottom_offset)"
  # XOSD's shaped window includes one shadow extent on both vertical edges.
  # Add that measured glyph-window height to the configured inter-line gap.
  product_offset=$(( detail_offset + BUILDSTAMP_DETAIL_FONT_SIZE \
                     + (2 * BUILDSTAMP_SHADOW_OFFSET) + BUILDSTAMP_LINE_GAP ))
  detail_args=(
    --pos=bottom
    --align=right
    "--offset=${detail_offset}"
    "--indent=${BUILDSTAMP_RIGHT_MARGIN}"
    "--font=${detail_font}"
    "--colour=${BUILDSTAMP_FOREGROUND}"
    "--shadow=${BUILDSTAMP_SHADOW_OFFSET}"
    "--shadowcolour=${BUILDSTAMP_SHADOW}"
    --lines=1
    --delay=0
  )
  product_args=(
    --pos=bottom
    --align=right
    "--offset=${product_offset}"
    "--indent=${BUILDSTAMP_RIGHT_MARGIN}"
    "--font=${product_font}"
    "--colour=${BUILDSTAMP_FOREGROUND}"
    "--shadow=${BUILDSTAMP_SHADOW_OFFSET}"
    "--shadowcolour=${BUILDSTAMP_SHADOW}"
    --lines=1
    --delay=0
  )
  mkdir -p "$(dirname "${log_file}")"
  "${renderer}" "${detail_args[@]}" <"${detail_text_file}" >>"${log_file}" 2>&1 &
  detail_pid=$!
  "${renderer}" "${product_args[@]}" <"${product_text_file}" >>"${log_file}" 2>&1 &
  product_pid=$!
  sleep 0.1
  if ! kill -0 "${product_pid}" 2>/dev/null || ! kill -0 "${detail_pid}" 2>/dev/null; then
    terminate_pid "${product_pid}"
    terminate_pid "${detail_pid}"
    warn "one renderer exited during startup; no half-stamp was retained"
    remove_runtime_state
    return 0
  fi
  product_exe="$(readlink -f "/proc/${product_pid}/exe")"
  detail_exe="$(readlink -f "/proc/${detail_pid}/exe")"
  {
    printf 'product=%s\n' "${product_pid}"
    printf 'details=%s\n' "${detail_pid}"
  } >"${pid_file}"
  {
    printf 'product_starttime=%s\n' "$(process_starttime "${product_pid}")"
    printf 'product_executable=%s\n' "${product_exe}"
    printf 'details_starttime=%s\n' "$(process_starttime "${detail_pid}")"
    printf 'details_executable=%s\n' "${detail_exe}"
    printf 'display=%s\n' "${DISPLAY}"
  } >"${state_file}"
  {
    printf 'product: DISPLAY=%q ' "${DISPLAY}"
    printf '%q ' "${renderer}" "${product_args[@]}"
    printf '< %q\n' "${product_text_file}"
    printf 'details: DISPLAY=%q ' "${DISPLAY}"
    printf '%q ' "${renderer}" "${detail_args[@]}"
    printf '< %q\n' "${detail_text_file}"
  } >"${command_file}"
  chmod 0600 "${pid_file}" "${state_file}" "${command_file}"
  # Revalidate after recording ownership so a process dying in this narrow
  # interval cannot leave a durable one-sided state.
  if ! recorded_pair_is_ours; then
    stop_renderer
    warn "renderer pair did not survive ownership validation"
    return 0
  fi
  printf 'redstone-buildstamp: started (product=%s details=%s)\n' \
    "${product_pid}" "${detail_pid}"
}

show_status() {
  load_identity
  resolve_display >/dev/null 2>&1 || REDSTONE_DISPLAY="${DISPLAY:-unknown}"
  if recorded_pair_is_ours; then
    running="running"
    product_pid="${PRODUCT_PID}"
    detail_pid="${DETAIL_PID}"
  else
    running="stopped"
    product_pid="-"
    detail_pid="-"
    stop_renderer
  fi
  printf 'State: %s\n' "${running}"
  printf 'Product PID: %s\n' "${product_pid}"
  printf 'Details PID: %s\n' "${detail_pid}"
  printf 'Active theme: %s\n' "${SCHEME_TITLE}"
  printf 'Build identity: %s\n' "${BUILD_ID}"
  printf 'Desktop label foreground: %s\n' "${BUILDSTAMP_FOREGROUND}"
  printf 'Desktop label shadow: %s\n' "${BUILDSTAMP_SHADOW}"
  printf 'Display: %s\n' "${REDSTONE_DISPLAY}"
  printf 'Metadata: %s\n' "${metadata_file}"
  printf 'Runtime text: %s\n' "${text_file}"
  if [[ -r "${command_file}" ]]; then
    while IFS= read -r renderer_command; do
      printf 'Renderer command: %s\n' "${renderer_command}"
    done <"${command_file}"
  else
    printf 'Renderer command: %s\n' "$(renderer_path)"
  fi
}

case "${1:-}" in
  start) start_renderer ;;
  refresh)
    load_identity
    if [[ "${BUILDSTAMP_ENABLED}" != 1 ]]; then
      stop_renderer
    else
      stop_renderer
      start_renderer
    fi
    ;;
  stop) stop_renderer ;;
  show) load_identity; compose_text ;;
  status) show_status ;;
  label-colors)
    load_identity "${2:-}" fresh
    printf '%s %s\n' "${BUILDSTAMP_FOREGROUND}" "${BUILDSTAMP_SHADOW}"
    ;;
  -h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
# Stable renderer wrapper:1 ends here
