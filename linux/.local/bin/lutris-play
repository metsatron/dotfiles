#!/bin/bash
# Universal Launch Shim

# Every Lutris launch on every machine and in every sanctuary goes through this. It wraps the real launch command in =lutris-sync begin= / =end=, refusing to launch (with an on-screen message when X is available) when another machine holds the lease.

# Inside a sanctuary the sync verbs run on the *host* via =host-spawn= against the host session bus — the guest's own filesystem view cannot write the hub (autofs does not propagate into containers and the RetroPie bind is deliberately read-only). The host bus address is projected into the guest at session launch as =~/.config/sanctuary/host-session-bus=. If that plumbing is missing the game still launches; sync is skipped with a loud warning, never silently.


# [[file:../../../lutris.org::*Universal Launch Shim][Universal Launch Shim:1]]
set -u

usage() {
  cat <<'EOF'
Usage: lutris-play [-- <command args...>]

Runs the given command (default: launch the Lutris client) inside a
lutris-sync begin/end envelope. Refuses to launch when another machine
holds the playtime lease. LUTRIS_PLAY_STEAL=1 overrides the refusal.
EOF
}

if [[ "${1:-}" = "-h" || "${1:-}" = "--help" ]]; then
  usage
  exit 0
fi
[[ "${1:-}" = "--" ]] && shift

host_home="${SANCTUARY_HOST_HOME:-/home/metsatron}"
in_guest=0
case "$HOME" in
  */.local/share/dotcortex/guests/*/home) in_guest=1 ;;
esac

notify() {
  local msg="$1"
  echo "lutris-play: $msg" >&2
  if [[ -n "${DISPLAY:-}" ]]; then
    if command -v xmessage >/dev/null 2>&1; then
      xmessage -center -timeout 20 "lutris-play: $msg" >/dev/null 2>&1 &
    elif command -v notify-send >/dev/null 2>&1; then
      notify-send "Lutris" "$msg" >/dev/null 2>&1 || true
    fi
  fi
}

sync_call() {
  if [[ "$in_guest" -eq 1 ]]; then
    local bus_file="$HOME/.config/sanctuary/host-session-bus" bus=""
    [[ -r "$bus_file" ]] && bus="$(head -n1 "$bus_file")"
    if [[ -z "$bus" || ! -x /usr/bin/host-spawn ]]; then
      notify "no host bridge for sync ($1 skipped) — playtime will not sync this session"
      return 0
    fi
    DBUS_SESSION_BUS_ADDRESS="$bus" /usr/bin/host-spawn "$host_home/.local/bin/lutris-sync" "$1"
  else
    "$host_home/.local/bin/lutris-sync" "$1"
  fi
}

sync_call begin
begin_rc=$?
if [[ "$begin_rc" -eq 3 ]]; then
  notify "Lutris is live on another machine — close it there first (or LUTRIS_PLAY_STEAL=1)"
  exit 3
elif [[ "$begin_rc" -ne 0 ]]; then
  notify "lutris-sync begin failed (rc=$begin_rc) — launching on local state anyway"
fi

if [[ "$#" -eq 0 ]]; then
  if [[ "$in_guest" -eq 1 ]]; then
    set -- "$HOME/.local/bin/sanctuary-flatpak-run" net.lutris.Lutris
  else
    set -- flatpak run net.lutris.Lutris
  fi
fi

"$@"
run_rc=$?

sync_call end || notify "lutris-sync end failed — run 'lutris-sync push' when the hub is reachable"

exit "$run_rc"
# Universal Launch Shim:1 ends here
