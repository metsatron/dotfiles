#!/bin/bash
# [[file:../../../sanctuary-redstone-9x-desktop.org::*Dynamic menus — recent Documents + Desktop folder][Dynamic menus — recent Documents + Desktop folder:11]]
GUIX_PROFILE="$HOME/.guix-extra-profiles/desktop-common/desktop-common"; export GUIX_PROFILE
[ -r "$GUIX_PROFILE/etc/profile" ] && . "$GUIX_PROFILE/etc/profile"
GUIX_PROFILE="$HOME/.guix-extra-profiles/room-gaming/room-gaming"; export GUIX_PROFILE
[ -r "$GUIX_PROFILE/etc/profile" ] && . "$GUIX_PROFILE/etc/profile"
set -euo pipefail
# rofimoji is a host user package. Its pure-Python payload is visible through
# /run/host; xdotool is likewise a host X utility, so expose that directory.
export PATH="/run/host/usr/bin:$PATH"
export XDG_CONFIG_HOME="$HOME/.config/redstone-9x"
for site in /run/host/home/metsatron/.local/lib/python*/site-packages; do
    [ -d "$site/picker" ] || continue
    export PYTHONPATH="$site${PYTHONPATH:+:$PYTHONPATH}"
    break
done
[ -f /run/host/home/metsatron/.local/bin/rofimoji ] || {
    echo "redstone-9x-rofi-emoji: host rofimoji is unavailable" >&2
    exit 127
}
exec python3 /run/host/home/metsatron/.local/bin/rofimoji --selector rofi --action type "$@"
# Dynamic menus — recent Documents + Desktop folder:11 ends here
