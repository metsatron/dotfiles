#!/usr/bin/env python3
import argparse
import hashlib
import json
import os
from pathlib import Path
import stat
import sys
from datetime import datetime, timezone


HOME = Path.home()
COMPAT_ROOT = Path(os.environ.get("REDSTONE_COMPAT_ROOT", HOME / ".compat"))
RETROPIE = HOME / "RetroPie"
LAUNCHER_SUFFIXES = {".sh", ".desktop", ".cfg", ".bat"}


def stamp():
    return datetime.now(timezone.utc).strftime("manifest-%Y%m%dT%H%M%SZ")


def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as fh:
        for chunk in iter(lambda: fh.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def iter_entries(root: Path, compute_sha256: bool):
    """Stream (rel_path, kind, size, mtime, sha256, target) top-down.
    Never descends into symlinked directories (os.walk followlinks=False).
    Prints one progress line per top-level directory entered, so a long
    corpus never runs silent."""
    last_top = None
    for dirpath, dirnames, filenames in os.walk(root, followlinks=False):
        dirnames.sort()
        filenames.sort()
        rel_dir = Path(dirpath).relative_to(root)
        top = rel_dir.parts[0] if rel_dir.parts else "."
        if top != last_top:
            print(f"[redstone-9x-import-manifest] scanning {top}/", file=sys.stderr)
            last_top = top
        for name in dirnames:
            entry = Path(dirpath) / name
            if entry.is_symlink():
                rel = entry.relative_to(root)
                st = entry.lstat()
                yield rel, "symlink", st.st_size, int(st.st_mtime), "", os.readlink(entry)
        for name in filenames:
            entry = Path(dirpath) / name
            rel = entry.relative_to(root)
            st = entry.lstat()
            if entry.is_symlink():
                yield rel, "symlink", st.st_size, int(st.st_mtime), "", os.readlink(entry)
            elif stat.S_ISREG(st.st_mode):
                digest = sha256_file(entry) if compute_sha256 else ""
                yield rel, "file", st.st_size, int(st.st_mtime), digest, ""
            else:
                yield rel, "other", st.st_size, int(st.st_mtime), "", ""


def write_manifest(root: Path, outdir: Path, compute_sha256: bool):
    """Write inventory.tsv incrementally (one flush per row, never held
    in memory as a full list) and return per-top-level-directory
    aggregates plus launcher/config filenames for the summary manifest."""
    outdir.mkdir(parents=True, exist_ok=True)
    top_stats = {}
    launchers = []
    total_rows = 0
    with (outdir / "inventory.tsv").open("w", encoding="utf-8") as fh:
        fh.write("path\tkind\tsize\tmtime\tsha256\ttarget\n")
        for rel, kind, size, mtime, digest, target in iter_entries(root, compute_sha256):
            fh.write(f"{rel}\t{kind}\t{size}\t{mtime}\t{digest}\t{target}\n")
            fh.flush()
            total_rows += 1
            if kind == "file":
                top = rel.parts[0] if rel.parts else str(rel)
                bucket = top_stats.setdefault(top, {"files": 0, "size": 0})
                bucket["files"] += 1
                bucket["size"] += size
                if rel.suffix.lower() in LAUNCHER_SUFFIXES:
                    launchers.append(str(rel))
    print(f"[redstone-9x-import-manifest] {total_rows} entries recorded", file=sys.stderr)
    return top_stats, launchers


def write_json(path: Path, payload):
    path.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")


def write_reference_scan(path: Path, root: Path):
    needles = ("RetroPie/roms/ports", "RetroPie/isos/ports", "RetroPie/isos/pc")
    suffixes = {".sh", ".cfg", ".xml", ".desktop", ".txt", ".org"}
    hits = []
    for candidate in sorted(root.rglob("*")):
        if candidate.is_dir() or candidate.suffix.lower() not in suffixes:
            continue
        try:
            text = candidate.read_text(encoding="utf-8", errors="ignore")
        except OSError:
            continue
        for lineno, line in enumerate(text.splitlines(), start=1):
            if any(needle in line for needle in needles):
                hits.append((str(candidate.relative_to(root)), lineno, line))
    with path.open("w", encoding="utf-8") as fh:
        for rel, lineno, line in hits:
            fh.write(f"{rel}:{lineno}:{line}\n")


def manifest_ports(compute_sha256: bool):
    logical = RETROPIE / "roms" / "ports"
    physical = logical.resolve()
    outdir = COMPAT_ROOT / "imports" / "retropie-ports" / stamp()
    print(f"[redstone-9x-import-manifest] ports: {logical} -> {physical}", file=sys.stderr)
    top_stats, launchers = write_manifest(logical, outdir, compute_sha256)
    write_json(outdir / "manifest.json", {
        "kind": "ports",
        "logical_root": str(logical),
        "physical_root": str(physical),
        "logical_is_symlink": logical.is_symlink(),
        "logical_symlink_target": os.readlink(logical) if logical.is_symlink() else "",
        "hashed": compute_sha256,
        "top_level": top_stats,
        "launcher_files": launchers,
        "notes": "EmulationStation-facing logical path with physical backing directory recorded separately. roms/ports and isos/ports are one corpus (symlink), not two imports to reconcile.",
    })
    (outdir / "logical-root.txt").write_text(str(logical) + "\n")
    (outdir / "physical-root.txt").write_text(str(physical) + "\n")
    (outdir / "symlink-topology.txt").write_text(
        f"{logical} -> {os.readlink(logical) if logical.is_symlink() else '(not a symlink)'}\n"
        f"resolved: {physical}\n"
    )
    write_reference_scan(outdir / "path-references.txt", physical)
    print(outdir)


def manifest_dosbox_pure(compute_sha256: bool):
    root = RETROPIE / "isos" / "pc"
    outdir = COMPAT_ROOT / "imports" / "retropie-dosbox-pure" / stamp()
    print(f"[redstone-9x-import-manifest] dosbox-pure: {root}", file=sys.stderr)
    top_stats, launchers = write_manifest(root, outdir, compute_sha256)
    write_json(outdir / "manifest.json", {
        "kind": "dosbox-pure",
        "source_root": str(root),
        "hashed": compute_sha256,
        "top_level": top_stats,
        "launcher_files": launchers,
        "notes": "Independent DOSBox Pure PC/DOS collection. Separate from ports topology.",
    })
    write_reference_scan(outdir / "path-references.txt", root)
    print(outdir)


def main():
    parser = argparse.ArgumentParser(
        prog="redstone-9x-import-manifest",
        description="Inventory a single Redstone 9X RetroPie import target. "
                     "Shallow metadata by default; no recursive SHA-256 unless --sha256 is passed.",
    )
    parser.add_argument(
        "target", choices=["ports", "dosbox-pure"],
        help="which corpus to inventory — always explicit, there is no 'all'",
    )
    parser.add_argument(
        "--sha256", action="store_true",
        help="compute a SHA-256 digest per file (slow, recursive; off by default)",
    )
    args = parser.parse_args()

    if args.target == "ports":
        manifest_ports(args.sha256)
    else:
        manifest_dosbox_pure(args.sha256)


if __name__ == "__main__":
    main()
