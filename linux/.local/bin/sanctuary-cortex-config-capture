#!/usr/bin/env bash
# [[file:../../../sanctuary-cortex.org::*Private migration bridges][Private migration bridges:3]]
set -euo pipefail

PRIVATE_ROOT="${SANCTUARY_CORTEX_PRIVATE_ROOT:-$HOME/HelmCortex/NEXUS/sanctuaries/sanctuary-cortex}"
SOURCE_HOME="${SANCTUARY_CORTEX_SOURCE_HOME:-$HOME/mnt/x230}"
DEST="${PRIVATE_ROOT}/xfce4-state"

command -v rsync >/dev/null 2>&1 || { echo "config-capture: rsync is required" >&2; exit 127; }
mkdir -p "$PRIVATE_ROOT" "$DEST"

paths=(
  .config/xfce4
  .config/autostart
  .config/xfce4-session
  .local/share/xfce4
  .local/share/applications
)
for rel in "${paths[@]}"; do
  source_path="$SOURCE_HOME/$rel"
  [[ -e "$source_path" || -L "$source_path" ]] || { echo "config-capture: skip absent $source_path"; continue; }
  mkdir -p "$DEST/$(dirname "$rel")"
  if [[ -d "$source_path" ]]; then
    mkdir -p "$DEST/$rel"
    rsync -a "$source_path/" "$DEST/$rel/"
  else
    rsync -a "$source_path" "$DEST/$rel"
  fi
  echo "config-capture: captured $rel"
done

find "$DEST" -type f -printf '%P\n' | sort > "$PRIVATE_ROOT/xfce4-state.files"
printf 'source=%s\ncaptured=%s\n' "$SOURCE_HOME" "$(date --iso-8601=seconds)" > "$PRIVATE_ROOT/xfce4-state.capture"
echo "config-capture: private XFCE state ready at $DEST"
# Private migration bridges:3 ends here
