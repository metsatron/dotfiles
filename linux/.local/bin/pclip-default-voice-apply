#!/usr/bin/env bash
set -euo pipefail

MODEL="en_US-lessac-medium.onnx"
PVOX="$HOME/HelmCortex/FORGE/VoxForge/bin/pvox"
MODELS_DIR="$HOME/.var/app/com.mikeasoft.pied/data/pied/models"

if [ ! -x "$PVOX" ]; then
  printf 'pclip-default-voice-apply: missing pvox: %s\n' "$PVOX" >&2
  exit 1
fi

if [ ! -f "$MODELS_DIR/$MODEL" ]; then
  printf 'pclip-default-voice-apply: missing model: %s\n' "$MODELS_DIR/$MODEL" >&2
  exit 1
fi

"$PVOX" sd-default "$MODEL" --yes
