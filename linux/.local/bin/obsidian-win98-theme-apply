#!/usr/bin/env bash


# If the candidate is wanted, update =PINNED_COMMIT= and =EXPECTED_SHA256= below,
# tangle this module, and run =loom flatpak:apply=.  That makes theme upgrades a
# reviewed declarative pin change rather than silent network drift.


# [[file:../../../package-flatpak.org::*Obsidian Windows 98 theme][Obsidian Windows 98 theme:2]]
set -euo pipefail

UPSTREAM_URL="https://github.com/SMUsamaShah/Obsidian-Win98-Edition.git"
PINNED_COMMIT="64ee60c33afac44624d2b05dbbd536907ca58ab4"
EXPECTED_SHA256="c464f54559fb21deaa8367e95e6ebd8b67eb894dfd309bd8dcaffca2a43b0bb8"
THEME_NAME="Windows 98 Edition"
HELMCORTEX_ROOT="${HELMCORTEX_ROOT:-$HOME/HelmCortex}"
VAULT_DIR="${OBSIDIAN_VAULT:-$HELMCORTEX_ROOT}"
MIRROR_DIR="${OBSIDIAN_WIN98_MIRROR:-$HELMCORTEX_ROOT/NEXUS/git/Obsidian-Win98-Edition}"
THEME_DIR="$VAULT_DIR/.obsidian/themes/$THEME_NAME"
APPEARANCE_FILE="$VAULT_DIR/.obsidian/appearance.json"

usage() {
  cat <<'EOF'
obsidian-win98-theme-apply - install the pinned Windows 98 theme into HelmCortex

Usage: obsidian-win98-theme-apply
       obsidian-win98-theme-apply --check-upstream
       obsidian-win98-theme-apply -h | --help

The default action bootstraps the NEXUS mirror if needed, verifies the pinned
CSS digest, installs the theme, and selects it without changing other Obsidian
appearance settings. --check-upstream fetches and reports the current candidate
commit and CSS digest without changing the installed theme or vault settings.
EOF
}

ensure_mirror() {
  if [[ ! -d "$MIRROR_DIR/.git" ]]; then
    mkdir -p "$(dirname "$MIRROR_DIR")"
    git clone "$UPSTREAM_URL" "$MIRROR_DIR"
  fi
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

ensure_mirror

if [[ "${1:-}" == "--check-upstream" ]]; then
  git -C "$MIRROR_DIR" fetch origin
  candidate="$(git -C "$MIRROR_DIR" rev-parse refs/remotes/origin/HEAD)"
  candidate_sha="$(git -C "$MIRROR_DIR" show "${candidate}:obsidian.css" | sha256sum | awk '{print $1}')"
  printf 'pinned commit:    %s\n' "$PINNED_COMMIT"
  printf 'candidate commit: %s\n' "$candidate"
  printf 'candidate SHA256: %s\n' "$candidate_sha"
  git -C "$MIRROR_DIR" diff --stat "$PINNED_COMMIT" "$candidate" -- obsidian.css README.md LICENSE
  exit 0
elif [[ "$#" -ne 0 ]]; then
  usage >&2
  exit 2
fi

if ! git -C "$MIRROR_DIR" cat-file -e "${PINNED_COMMIT}^{commit}" 2>/dev/null; then
  git -C "$MIRROR_DIR" fetch origin "$PINNED_COMMIT"
fi

[[ -d "$VAULT_DIR/.obsidian" ]] || {
  printf 'obsidian-win98-theme-apply: vault config not found: %s/.obsidian\n' "$VAULT_DIR" >&2
  exit 1
}
command -v jq >/dev/null 2>&1 || {
  printf 'obsidian-win98-theme-apply: jq is required\n' >&2
  exit 1
}

tmp_css="$(mktemp)"
tmp_license="$(mktemp)"
tmp_appearance=""
trap 'rm -f "$tmp_css" "$tmp_license" ${tmp_appearance:+"$tmp_appearance"}' EXIT

git -C "$MIRROR_DIR" show "${PINNED_COMMIT}:obsidian.css" >"$tmp_css"
actual_sha="$(sha256sum "$tmp_css" | awk '{print $1}')"
[[ "$actual_sha" == "$EXPECTED_SHA256" ]] || {
  printf 'obsidian-win98-theme-apply: payload digest mismatch: expected %s, got %s\n' "$EXPECTED_SHA256" "$actual_sha" >&2
  exit 1
}
git -C "$MIRROR_DIR" show "${PINNED_COMMIT}:LICENSE" >"$tmp_license"

mkdir -p "$THEME_DIR"
install -m 0644 "$tmp_css" "$THEME_DIR/theme.css"
install -m 0644 "$tmp_license" "$THEME_DIR/LICENSE"
cat >"$THEME_DIR/manifest.json" <<EOF
{
  "name": "$THEME_NAME",
  "version": "0.1.0",
  "minAppVersion": "0.12.0",
  "author": "SMUsamaShah",
  "authorUrl": "https://github.com/SMUsamaShah"
}
EOF
cat >"$THEME_DIR/.dotcortex-source" <<EOF
upstream=$UPSTREAM_URL
commit=$PINNED_COMMIT
sha256=$EXPECTED_SHA256
EOF

if [[ -f "$APPEARANCE_FILE" ]] && [[ "$(jq -r '.cssTheme // ""' "$APPEARANCE_FILE")" != "$THEME_NAME" ]]; then
  backup_dir="${XDG_STATE_HOME:-$HOME/.local/state}/dotcortex/backups/obsidian"
  mkdir -p "$backup_dir"
  cp -p "$APPEARANCE_FILE" "$backup_dir/appearance.json.$(date +%Y%m%d-%H%M%S)"
  tmp_appearance="$(mktemp "${APPEARANCE_FILE}.tmp.XXXXXX")"
  jq --arg theme "$THEME_NAME" '.cssTheme = $theme' "$APPEARANCE_FILE" >"$tmp_appearance"
  chmod --reference="$APPEARANCE_FILE" "$tmp_appearance"
  mv "$tmp_appearance" "$APPEARANCE_FILE"
  tmp_appearance=""
elif [[ ! -f "$APPEARANCE_FILE" ]]; then
  tmp_appearance="$(mktemp "${APPEARANCE_FILE}.tmp.XXXXXX")"
  jq -n --arg theme "$THEME_NAME" '{cssTheme: $theme}' >"$tmp_appearance"
  mv "$tmp_appearance" "$APPEARANCE_FILE"
  tmp_appearance=""
fi

installed_sha="$(sha256sum "$THEME_DIR/theme.css" | awk '{print $1}')"
[[ "$installed_sha" == "$EXPECTED_SHA256" ]]
[[ "$(jq -r '.cssTheme // ""' "$APPEARANCE_FILE")" == "$THEME_NAME" ]]
printf 'Obsidian theme ready: %s (%s)\n' "$THEME_NAME" "${PINNED_COMMIT:0:12}"
# Obsidian Windows 98 theme:2 ends here
