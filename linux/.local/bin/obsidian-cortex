#!/bin/env bash
# [[file:../../../sanctuary-cortex.org::*Fleet-facing launchers][Fleet-facing launchers:2]]
set -euo pipefail

if [ -x "$HOME/.local/bin/sanctuary-cortex-app" ]; then
  exec "$HOME/.local/bin/sanctuary-cortex-app" obsidian "$@"
fi
REMOTE="${SANCTUARY_CORTEX_SSH_ALIAS:-kikin}"
exec ssh "$REMOTE" sanctuary-cortex-app obsidian "$@"
