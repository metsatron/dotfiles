#!/bin/bash
# [[file:../../../sanctuary-redstone-9x.org::*Flatpak session service][Flatpak session service:2]]
set -euo pipefail

if [[ "$#" -lt 1 ]]; then
  echo "Usage: redstone-9x-flatpak-session <desktop-command> [args...]" >&2
  exit 2
fi

flatpak_bin="$(command -v flatpak 2>/dev/null || true)"
flatpak_real="$(readlink -f "${flatpak_bin}" 2>/dev/null || true)"
session_helper="${flatpak_real%/bin/flatpak}/libexec/flatpak-session-helper"
session_log="${XDG_RUNTIME_DIR:-/tmp}/redstone-9x-flatpak-session-helper.log"

if [[ -n "${flatpak_real}" && -x "${session_helper}" ]]; then
  "${session_helper}" --replace >"${session_log}" 2>&1 &
  helper_pid=$!
  helper_ready=0

  for _attempt in {1..50}; do
    if dbus-send --session --print-reply \
        --dest=org.freedesktop.Flatpak \
        /org/freedesktop/Flatpak/SessionHelper \
        org.freedesktop.Flatpak.SessionHelper.RequestSession \
        >/dev/null 2>&1; then
      helper_ready=1
      break
    fi
    kill -0 "${helper_pid}" 2>/dev/null || break
    sleep 0.1
  done

  if [[ "${helper_ready}" -ne 1 ]]; then
    echo "redstone-9x-flatpak-session: warning — Flatpak session helper unavailable; see ${session_log}" >&2
  fi
else
  echo "redstone-9x-flatpak-session: warning — flatpak-session-helper not found for ${flatpak_bin:-flatpak}" >&2
fi

handler="com.tiagopires.ObsidianRedstone.desktop"
scheme="x-scheme-handler/obsidian"
applications_dir="${XDG_DATA_HOME:-${HOME}/.local/share}/applications"
if command -v update-desktop-database >/dev/null 2>&1; then
  update-desktop-database "${applications_dir}" >/dev/null 2>&1 || true
fi
if command -v xdg-mime >/dev/null 2>&1; then
  xdg-mime default "${handler}" "${scheme}"
  actual_handler="$(xdg-mime query default "${scheme}")"
  if [[ "${actual_handler}" != "${handler}" ]]; then
    echo "redstone-9x-flatpak-session: expected ${scheme} -> ${handler}, got ${actual_handler:-none}" >&2
    exit 1
  fi
  echo "redstone-9x-flatpak-session: ${scheme} -> ${handler}"
else
  echo "redstone-9x-flatpak-session: xdg-mime not found; refusing ambiguous Obsidian URI routing" >&2
  exit 1
fi

exec "$@"
# Flatpak session service:2 ends here
