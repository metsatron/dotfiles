#!/bin/bash
# [[file:../../../sanctuary-redstone-9x-desktop.org::*DOSEMU2 bridge scaffold][DOSEMU2 bridge scaffold:2]]
set -euo pipefail

DOTCORTEX_BIN="${HOME}/.local/bin"
BIN_DIR="${REDSTONE_COMPAT_ROOT:-${HOME}/.compat}/generated/dos/c/REDSTONE/USR/BIN"

"${DOTCORTEX_BIN}/redstone-9x-dosemu2-init"

if ! command -v dosemu >/dev/null 2>&1; then
  echo "redstone-9x-dos: dosemu not found in room-windows-compat" >&2
  echo "  Current state: wrapper scaffold is ready, package provisioning is still pending." >&2
  exit 127
fi

if (( $# == 0 )); then
  # -t: S-Lang terminal mode (uses the xterm as the DOS console).
  # -K: mount the projected REDSTONE\USR\BIN tree as C:.  No -E and no -T
  # (which only means "don't exit after -E") for the interactive prompt.
  exec dosemu -t -K "${BIN_DIR}"
fi

launcher="$1"
match="$(
  find "${BIN_DIR}" -maxdepth 1 -type f \
    \( -iname "${launcher}" -o -iname "${launcher}.bat" \) \
    | sort \
    | head -n 1
)"

if [[ -z "${match}" ]]; then
  echo "redstone-9x-dos: launcher not found: ${launcher}" >&2
  echo "  Expected a .bat file under ${BIN_DIR}" >&2
  exit 1
fi

exec dosemu -t -K "${BIN_DIR}" -E "$(basename "${match}")"
# DOSEMU2 bridge scaffold:2 ends here
