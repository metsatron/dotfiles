# ── Redstone shell identity: Win9x DOS prompt + fastfetch greeting ──
# Shared sanctuary greeting grammar (mirrors sanctuary-godzilla-xs): symlink the DotCortex
# source live into the guest home so edits reflect without a relaunch. The host
# repo path is visible inside the container, so symlinks resolve. The zsh link
# REPLACES vm-homes-init's global-.zshrc symlink; the sanctuary zshrc sources the
# global one itself, so nothing global is edited.
REDSTONE_SHELL_CFG="${REPO_ROOT}/linux/.config/redstone-9x"
mkdir -p "${GUEST_HOME}/.config/fastfetch"
ln -sfnT "${REDSTONE_SHELL_CFG}/fastfetch.jsonc"     "${GUEST_HOME}/.config/fastfetch/config.jsonc"
ln -sfnT "${REDSTONE_SHELL_CFG}/shell/bashrc"        "${GUEST_HOME}/.bashrc"
ln -sfnT "${REDSTONE_SHELL_CFG}/shell/bash_profile"  "${GUEST_HOME}/.bash_profile"
ln -sfnT "${REDSTONE_SHELL_CFG}/shell/zshrc"         "${GUEST_HOME}/.zshrc"
# sanctuary-flatpak-run is the runner the flatpak game wrappers exec; project a
# COPY (the host repo path is not visible inside the container, so the
# stowed symlink would be broken there).
project_file "${REPO_ROOT}/linux/.local/bin/sanctuary-flatpak-run"  "${GUEST_HOME}/.local/bin/sanctuary-flatpak-run"
chmod +x "${GUEST_HOME}/.local/bin/sanctuary-flatpak-run"
project_file "${REPO_ROOT}/linux/.local/bin/redstone-9x-flatpak-session" "${GUEST_HOME}/.local/bin/redstone-9x-flatpak-session"
chmod +x "${GUEST_HOME}/.local/bin/redstone-9x-flatpak-session"
project_file "${REPO_ROOT}/linux/.config/redstone-9x/applications/com.tiagopires.ObsidianRedstone.desktop" \
  "${GUEST_HOME}/.local/share/applications/com.tiagopires.ObsidianRedstone.desktop"

# Obsidian stores themes per vault.  Redstone opens its own persistent vault
# under the guest home, not the host HelmCortex vault, so provision that exact
# target before the desktop starts.  The helper keeps the third-party CSS
# pinned and digest-verified from the HelmCortex NEXUS mirror and preserves all
# other appearance settings.
REDSTONE_OBSIDIAN_VAULT="${GUEST_HOME}/Redstone"
OBSIDIAN_THEME_HELPER="${REPO_ROOT}/linux/.local/bin/obsidian-win98-theme-apply"
mkdir -p "${REDSTONE_OBSIDIAN_VAULT}/.obsidian"
if [[ ! -f "${REDSTONE_OBSIDIAN_VAULT}/.obsidian/appearance.json" ]]; then
  printf '{}\n' > "${REDSTONE_OBSIDIAN_VAULT}/.obsidian/appearance.json"
fi
OBSIDIAN_VAULT="${REDSTONE_OBSIDIAN_VAULT}" \
  HELMCORTEX_ROOT="${HOME}/HelmCortex" \
  "${OBSIDIAN_THEME_HELPER}"

project_file "${REPO_ROOT}/linux/.config/redstone-9x/powershell/basic-repl.ps1"   "${GUEST_HOME}/.config/redstone-9x/powershell/basic-repl.ps1"

# My Briefcase — a real working folder (not a sync engine; true Win95 Briefcase
# sync is out of scope). Created if absent so the desktop shortcut resolves.
mkdir -p "${GUEST_HOME}/Briefcase"
# The period-appropriate Briefcase icon (BeOS 'my_briefcase') used to be
# force-copied into the projected Chicago95 theme here at runtime. It now lives
# in the repo's own Chicago95 at places/{16,32,48}, byte-identical to what this
# block produced, so Icon=my_briefcase resolves with no runtime mutation — which
# is what let Chicago95 become a symlink like every other icon theme above.

# IceWM does not resolve icon names out of the Chicago95 XDG theme — pcmanfm (GTK)
# does, which is why the DESKTOP icons render from Chicago95 while the identical name
# in the menu or the quick-launch strip comes up empty.  Worse, IceWM does not draw a
# fallback: a toolbar `prog` whose icon it cannot find is dropped from the strip
# entirely, so the failure looks like a missing BUTTON, not a missing icon, and sends
# you hunting for the wrong bug.  Every icon name that appears to "work" in the menu
# (firefox_2, multimedia, system-file-manager) is one that also exists in a theme IceWM
# does read; nothing that lives only in Chicago95 ever resolves.
#
# IceWM's own icon directory always works, so graft the sanctuary's app icons there,
# size-suffixed the way IceWM expects.  Verified inside the guest: name lookup fails,
# ~/.icewm/icons and absolute paths both succeed.  The graft is scheme-aware
# (redstone-9x-icons-graft): it sources from the ACTIVE Desktop Scheme's icon
# theme with Chicago95 fallback, and scheme-apply regrafts on every switch.
ACTIVE_SCHEME="$(cat "${GUEST_HOME}/.config/redstone-9x/scheme" 2>/dev/null || echo windows-95)"
SCHEME_SRC="${REPO_ROOT}/linux/.config/redstone-9x/schemes/${ACTIVE_SCHEME}.scheme"
if [[ ! -f "${SCHEME_SRC}" ]]; then
  echo "${SANCTUARY}: warning — persisted scheme '${ACTIVE_SCHEME}' has no declaration; falling back to windows-95" >&2
  ACTIVE_SCHEME="windows-95"
  SCHEME_SRC="${REPO_ROOT}/linux/.config/redstone-9x/schemes/windows-95.scheme"
fi
# shellcheck disable=SC1090
SCHEME_ICON_THEME="$(. "${SCHEME_SRC}"; printf %s "${ICON_THEME:-Chicago95}")"
SCHEME_CURSOR_THEME="$(. "${SCHEME_SRC}"; printf %s "${CURSOR_THEME:-Chicago95_Cursor_White}")"
SCHEME_CURSOR_SIZE="$(. "${SCHEME_SRC}"; printf %s "${CURSOR_SIZE:-24}")"
bash "${REPO_ROOT}/linux/.local/bin/redstone-9x-icons-graft" \
  "${GUEST_HOME}/.local/share/icons" "${GUEST_HOME}/.icewm/icons" "${SCHEME_ICON_THEME}"

# GTK config (settings.ini/gtkrc are projected as the Windows 95 baseline; the
# scheme-apply --boot pass below immediately re-asserts the ACTIVE scheme's
# values over them, so projection no longer resets appearance)
mkdir -p "${GUEST_HOME}/.config/gtk-3.0"
project_file "${REPO_ROOT}/linux/.config/redstone-9x/gtk-3.0/settings.ini"   "${GUEST_HOME}/.config/gtk-3.0/settings.ini"
project_file "${REPO_ROOT}/linux/.config/redstone-9x/gtk-3.0/gtk.css.in"   "${GUEST_HOME}/.config/redstone-9x/gtk-3.0/gtk.css.in"
project_file "${REPO_ROOT}/linux/.config/redstone-9x/gtk-2.0/gtkrc"   "${GUEST_HOME}/.gtkrc-2.0"

# Desktop Scheme machinery: declarations + apply/graft/host-gtk helpers
mkdir -p "${GUEST_HOME}/.config/redstone-9x/schemes"
for _scheme in "${REPO_ROOT}/linux/.config/redstone-9x/schemes/"*.scheme; do
  [[ -f "${_scheme}" ]] || continue
  project_file "${_scheme}" "${GUEST_HOME}/.config/redstone-9x/schemes/$(basename "${_scheme}")"
done
# Wine classic-colour registries, one per scheme's WINE_COLORS (or the SCHEME_ID
# fallback). Projected as managed files so a newly added palette actually reaches
# the guest — the guest home persists across launches, so an unmanaged reg dir
# would keep stale contents and silently drop every reg added after first seed.
mkdir -p "${GUEST_HOME}/.config/redstone-9x/wine"
for _reg in "${REPO_ROOT}/linux/.config/redstone-9x/wine/"*.reg; do
  [[ -f "${_reg}" ]] || continue
  project_file "${_reg}" "${GUEST_HOME}/.config/redstone-9x/wine/$(basename "${_reg}")"
done
project_file "${REPO_ROOT}/linux/.local/bin/redstone-9x-scheme-apply" "${GUEST_HOME}/.local/bin/redstone-9x-scheme-apply"
chmod +x "${GUEST_HOME}/.local/bin/redstone-9x-scheme-apply"
project_file "${REPO_ROOT}/linux/.local/bin/redstone-9x-icons-graft" "${GUEST_HOME}/.local/bin/redstone-9x-icons-graft"
chmod +x "${GUEST_HOME}/.local/bin/redstone-9x-icons-graft"
project_file "${REPO_ROOT}/linux/.local/bin/redstone-9x-host-gtk" "${GUEST_HOME}/.local/bin/redstone-9x-host-gtk"
chmod +x "${GUEST_HOME}/.local/bin/redstone-9x-host-gtk"
sed -i "s|@HOST_SESSION_BUS@|${DBUS_SESSION_BUS_ADDRESS:-}|g" "${GUEST_HOME}/.local/bin/redstone-9x-host-gtk"
# Host session bus, projected as a FILE for runtime consumers (not a sed token):
# sanctuary-flatpak-run reads it to run Lutris against the host bus (glycin's
# flatpak-spawn workers need org.freedesktop.portal.Flatpak, absent from the
# private dbus-run-session bus), and lutris-play reads it for host-spawn sync
# relays. Refreshed every launch because the address changes per host login.
mkdir -p "${GUEST_HOME}/.config/sanctuary"
printf '%s\n' "${DBUS_SESSION_BUS_ADDRESS:-}" > "${GUEST_HOME}/.config/sanctuary/host-session-bus"
# Desktop build stamp: stable command surface plus deployment-boundary identity
# generation.  The renderer itself never consults Git; it reads the persistent
# build.ini emitted here, so login cannot change the build number by wall clock.
project_file "${REPO_ROOT}/linux/.local/bin/redstone-buildstamp" "${GUEST_HOME}/.local/bin/redstone-buildstamp"
chmod +x "${GUEST_HOME}/.local/bin/redstone-buildstamp"
project_file "${REPO_ROOT}/linux/.local/bin/redstone-buildstamp-generate" "${GUEST_HOME}/.local/bin/redstone-buildstamp-generate"
chmod +x "${GUEST_HOME}/.local/bin/redstone-buildstamp-generate"
project_file "${REPO_ROOT}/linux/.config/redstone-9x/buildstamp.conf" "${GUEST_HOME}/.config/redstone-9x/buildstamp.conf"
HOME="${GUEST_HOME}" \
  XDG_DATA_HOME="${GUEST_HOME}/.local/share" \
  DOTCORTEX_ROOT="${REPO_ROOT}" \
  "${GUEST_HOME}/.local/bin/redstone-buildstamp-generate" \
  || echo "${SANCTUARY}: warning — build-stamp metadata generation failed" >&2
# PNMixer: seed the mixer command once — pnmixer rewrites its config from its
# own preferences UI, so never clobber user changes with a re-projection.
if [[ ! -f "${GUEST_HOME}/.config/pnmixer/config" ]]; then
  mkdir -p "${GUEST_HOME}/.config/pnmixer"
  project_file "${REPO_ROOT}/linux/.config/redstone-9x/pnmixer/config" "${GUEST_HOME}/.config/pnmixer/config"
fi
# Dynamic Start-menu generators (recent Documents + Desktop folder)
project_file "${REPO_ROOT}/linux/.local/bin/redstone-9x-menu-recent" "${GUEST_HOME}/.local/bin/redstone-9x-menu-recent"
chmod +x "${GUEST_HOME}/.local/bin/redstone-9x-menu-recent"
project_file "${REPO_ROOT}/linux/.local/bin/redstone-9x-menu-desktop" "${GUEST_HOME}/.local/bin/redstone-9x-menu-desktop"
chmod +x "${GUEST_HOME}/.local/bin/redstone-9x-menu-desktop"

# Re-assert the active Desktop Scheme over everything just projected.
# --boot = file effects only; runs host-side against the guest home.
HOME="${GUEST_HOME}" bash "${GUEST_HOME}/.local/bin/redstone-9x-scheme-apply" --boot "${ACTIVE_SCHEME}" \
  || echo "${SANCTUARY}: warning — scheme --boot apply failed for '${ACTIVE_SCHEME}'" >&2

# Fonts
# Redstone keeps its sanctuary-local Microsoft/period fonts in FONT_STAGE, but
# it also needs the host's merged ~/.local/share/fonts tree so families moved
# to helmstow or local font triage remain visible inside the room.
HOST_FONT_ROOT="${HOME}/.local/share/fonts"
if [[ -d "${HOST_FONT_ROOT}" ]]; then
  mkdir -p "${GUEST_HOME}/.local/share/fonts"
  ln -sfnT "${HOST_FONT_ROOT}" "${GUEST_HOME}/.local/share/fonts/host-user"
fi
if [[ -d "${FONT_STAGE}" ]]; then
  mkdir -p "${GUEST_HOME}/.local/share/fonts"
  ln -sfnT "${FONT_STAGE}" "${GUEST_HOME}/.local/share/fonts/redstone-9x"
fi
"${GUEST_HOME}/.local/bin/redstone-9x-fonts-apply"

# Audacious Winamp skins
if [[ -d "${REPO_ROOT}/linux/.local/share/audacious/Skins" ]]; then
  mkdir -p "${GUEST_HOME}/.local/share/audacious/Skins"
  cp -rn "${REPO_ROOT}/linux/.local/share/audacious/Skins/"*.wsz "${GUEST_HOME}/.local/share/audacious/Skins/" 2>/dev/null || true
fi
if [[ -d "${REPO_ROOT}/linux/.qmmp/skins" ]]; then
  for skin in "${REPO_ROOT}/linux/.qmmp/skins/"*.wsz; do
    [[ -f "${skin}" ]] || continue
    project_file "${skin}" "${GUEST_HOME}/.local/share/audacious/Skins/$(basename "${skin}")"
  done
fi
mkdir -p "${GUEST_HOME}/.config/audacious"
if [[ ! -f "${GUEST_HOME}/.config/audacious/config" ]]; then
  project_file "${REPO_ROOT}/linux/.config/redstone-9x/audacious/config"     "${GUEST_HOME}/.config/audacious/config"
fi

# Redstone runtime spine and DOS bridge.
"${GUEST_HOME}/.local/bin/redstone-9x-compat-init" --quiet
"${GUEST_HOME}/.local/bin/redstone-9x-dosemu2-init"

}
# Contract:1 ends here
