# Contract

# The sourcing adapter MUST export or set these variables before sourcing:

# | Variable                 | Example                                                    | Purpose                            |
# |--------------------------+------------------------------------------------------------+------------------------------------|
# | =DESKTOP=                | =icewm= or =fvwm95=                                       | Desktop spin                       |
# | =SANCTUARY=              | =sanctuary-redstone-9x=                                    | Guest technical ID                 |
# | =GUEST_HOME=             | =${GUESTS_DIR}/${SANCTUARY}/home=                          | Absolute path to guest home        |
# | =GUESTS_DIR=             | =${HOME}/.local/share/dotcortex/guests=                    | Guest root directory               |
# | =GUIX_PROFILES=          | =${HOME}/.guix-extra-profiles=                             | Guix extra-profiles root           |
# | =REPO_ROOT=              | =${HOME}/DotCortex=                                        | DotCortex repo root                |
# | =FONT_STAGE=             | =${GUESTS_DIR}/${SANCTUARY}/fonts=                         | Sanctuary font staging dir         |
# | =RETROPIE_HOST_ROOT=     | =${HOME}/RetroPie=                                         | Host RetroPie tree root            |
# | =RETROPIE_CONTAINER_ROOT= | =/run/dotcortex/retropie=                                 | In-container RetroPie path         |
# | =GAMES_CONTAINER_ROOT=   | =/run/dotcortex/games=                                     | In-container Games path            |

# Provided functions:

# - =project_file SRC DST [MODE]= — copy a managed file (strict: source must exist)
# - =project_dir SRC DST= — atomically replace a managed directory
# - =project_link TARGET LINK= — create or replace a managed symlink
# - =redstone_preflight_guix_profiles= — verify required Guix profiles exist
# - =prepare_retropie_tree= — prepare the RetroPie/Games bind tree in the guest
# - =redstone_check_desktop_prereqs= — verify desktop-specific prerequisites
# - =redstone_project= — project the entire Redstone desktop into the guest home


# [[file:../../../sanctuary-redstone-common.org::*Contract][Contract:1]]
# ── Utility primitives ──

project_file() {
  local src="$1" dst="$2" mode="${3:-}"
  [[ -f "${src}" ]] || { echo "redstone: managed source missing: ${src}" >&2; return 1; }
  mkdir -p "$(dirname "${dst}")"
  rm -f -- "${dst}"
  cp -f -- "${src}" "${dst}"
  [[ -z "${mode}" ]] || chmod "${mode}" "${dst}"
}

project_dir() {
  local src="$1" dst="$2" tmp="${2}.tmp"
  [[ -d "${src}" ]] || { echo "redstone: managed source directory missing: ${src}" >&2; return 1; }
  mkdir -p "$(dirname "${dst}")"
  rm -rf -- "${tmp}"
  cp -a -- "${src}" "${tmp}"
  rm -rf -- "${dst}"
  mv -- "${tmp}" "${dst}"
}

project_link() {
  local src="$1" dst="$2"
  mkdir -p "$(dirname "${dst}")"
  rm -rf "${dst}"
  ln -sfnT "${src}" "${dst}"
}

# ── Guix preflight ──

redstone_preflight_guix_profiles() {
  _missing=0
  for _prof in desktop-common room-gaming room-windows-compat; do
    _path="${GUIX_PROFILES}/${_prof}/${_prof}/etc/profile"
    if [[ ! -f "${_path}" ]]; then
      echo "${SANCTUARY}: ERROR — Guix profile not built: ${_prof}"
      echo "  Build it with: make guix-${_prof}"
      _missing=1
    fi
  done
  if [[ "${_missing}" -eq 1 ]]; then
    echo ""
    echo "Run 'make guix-room-windows-compat' (builds all sanctuary profiles) then retry."
    exit 1
  fi
}

# ── RetroPie tree preparation ──

prepare_retropie_tree() {
  local host_ports="${RETROPIE_HOST_ROOT}/roms/ports"
  local guest_link="${GUEST_HOME}/RetroPie"

  if ! stat -L -- "${host_ports}" >/dev/null 2>&1; then
    echo "${SANCTUARY}: ERROR — RetroPie tree unavailable on the host" >&2
    echo "  Expected a readable ports directory at: ${host_ports}" >&2
    echo "  The automount did not become available; container start was not attempted." >&2
    exit 1
  fi

  if [[ ! -d "${GUEST_HOME}" ]]; then
    echo "${SANCTUARY}: ERROR — guest home missing: ${GUEST_HOME}" >&2
    echo "  Run vm-homes-init first." >&2
    exit 1
  fi
  if [[ -e "${guest_link}" && ! -L "${guest_link}" ]]; then
    echo "${SANCTUARY}: ERROR — refusing to replace non-symlink guest path: ${guest_link}" >&2
    exit 1
  fi
  ln -sfnT "${RETROPIE_CONTAINER_ROOT}" "${guest_link}"

  sanctuary-retropie-bind-ensure "${SANCTUARY}" "${RETROPIE_CONTAINER_ROOT}"

  local games_link="${GUEST_HOME}/Games"
  if [[ -e "${games_link}" && ! -L "${games_link}" ]]; then
    echo "${SANCTUARY}: refusing to replace non-symlink guest path: ${games_link}" >&2
  else
    ln -sfnT "${GAMES_CONTAINER_ROOT}" "${games_link}"
  fi
}

# ── Desktop prerequisite check ──

redstone_check_desktop_prereqs() {
  if [[ "${DESKTOP}" == "fvwm95" ]]; then
    if [[ ! -x "${GUEST_HOME}/.local/fvwm95/bin/fvwm95" ]]; then
      echo "${SANCTUARY}: fvwm95 not built — run sanctuary-redstone-9x-fvwm95-build first" >&2
      exit 1
    fi
  fi
}

# ── Full guest-home projection ──

redstone_project() {


# ── Desktop-specific config projection ──
if [[ "${DESKTOP}" == "icewm" ]]; then
  mkdir -p "${GUEST_HOME}/.icewm"
  project_dir "${REPO_ROOT}/linux/.icewm/themes" "${GUEST_HOME}/.icewm/themes"
  # ice2k Win2k/XP IceWM themes, drawn once by sanctuary-redstone-9x-ice2k-build
  # into a staging dir the project_dir wipe above does not touch. Link them into
  # the themes dir so they are selectable in IceWM without being clobbered.
  if [[ -d "${GUEST_HOME}/.local/ice2k/icewm-themes" ]]; then
    for _ice2k_theme in "${GUEST_HOME}/.local/ice2k/icewm-themes"/*/; do
      [[ -d "${_ice2k_theme}" ]] || continue
      ln -sfnT "${_ice2k_theme%/}" "${GUEST_HOME}/.icewm/themes/$(basename "${_ice2k_theme}")"
    done
  fi
  project_file "${REPO_ROOT}/linux/.icewm/preferences" "${GUEST_HOME}/.icewm/preferences"
  project_file "${REPO_ROOT}/linux/.icewm/menu" "${GUEST_HOME}/.icewm/menu"
  # Per-scheme Deskbar/start buttons — redstone-9x-scheme-apply copies the
  # active scheme's MENU_BUTTON set over the theme's menuButton{A,I} at apply.
  [[ -d "${REPO_ROOT}/linux/.icewm/menu-buttons" ]] \
    && project_dir "${REPO_ROOT}/linux/.icewm/menu-buttons" "${GUEST_HOME}/.icewm/menu-buttons"
  # Zeal (Qt6) Help entry needs the room-gaming qt6 plugin dir on QT_PLUGIN_PATH
  # to find qt6ct's platformtheme plugin (the profile etc/profile does not export
  # it). Inject the absolute in-container path into the @ROOM_QT6_PLUGINS@ token.
  sed -i "s|@ROOM_QT6_PLUGINS@|${GUIX_PROFILES}/room-gaming/room-gaming/lib/qt6/plugins|g" "${GUEST_HOME}/.icewm/menu"
  # Same hole, one layer up: room-gaming's etc/profile exports no QML import
  # path either (confirmed via `guix package --search-paths`), so a QML module
  # installed in the profile is invisible to Qt. KNewStuff's "Get New ..."
  # dialog needs org.kde.kirigami from lib/qt6/qml. Both variable names are
  # read by this Qt build (6.9.2 libQt6Qml exports QML_IMPORT_PATH and the
  # legacy QML2_IMPORT_PATH), so the menu sets the modern one.
  sed -i "s|@ROOM_QT6_QML@|${GUIX_PROFILES}/room-gaming/room-gaming/lib/qt6/qml|g" "${GUEST_HOME}/.icewm/menu"
  sed -i "s|@ROOM_SHARE@|${GUIX_PROFILES}/room-gaming/room-gaming/share|g" "${GUEST_HOME}/.icewm/menu"
  # Zeal downloads docsets over HTTPS; Guix Qt/OpenSSL has no default CA path,
  # so point SSL_CERT_FILE at the desktop-common nss-certs bundle (room-gaming
  # carries no certs of its own).
  sed -i "s|@DESKTOP_COMMON_SSL_CERT@|${GUIX_PROFILES}/desktop-common/desktop-common/etc/ssl/certs/ca-certificates.crt|g" "${GUEST_HOME}/.icewm/menu"
  # Host-app bridge (Pale Moon, SeaMonkey, PeaZip): host-spawn needs the HOST
  # session bus (org.freedesktop.Flatpak). On this sysv host that is a
  # dbus-launch /tmp path socket — ephemeral per login, so it is injected here
  # from the launcher's own session env, never hardcoded. /tmp is bind-mounted
  # into the guest, so the path resolves there. -env DISPLAY on the menu
  # entries forwards the Xephyr display; without it host-spawn launches the app
  # on the HOST desktop (:0).
  sed -i "s|@HOST_SESSION_BUS@|${DBUS_SESSION_BUS_ADDRESS:-}|g" "${GUEST_HOME}/.icewm/menu"
  project_file "${REPO_ROOT}/linux/.icewm/toolbar" "${GUEST_HOME}/.icewm/toolbar"
  project_file "${REPO_ROOT}/linux/.icewm/keys" "${GUEST_HOME}/.icewm/keys"
  project_file "${REPO_ROOT}/linux/.icewm/winoptions" "${GUEST_HOME}/.icewm/winoptions"
  project_file "${REPO_ROOT}/linux/.icewm/startup" "${GUEST_HOME}/.icewm/startup"
  chmod +x "${GUEST_HOME}/.icewm/startup"
  # IceWMCP applet hide-list: seed the curated ~/.icecp_ignore ONCE. The
  # IceWMCP "hide/show icons" dialog rewrites this file in place, so a plain
  # project_file would clobber the user's live toggles every launch — seed it
  # only when the guest has none, then leave it under the user's control.
  if [[ ! -f "${GUEST_HOME}/.icecp_ignore" ]]; then
    project_file "${REPO_ROOT}/linux/.config/redstone-9x/icewmcp/icecp_ignore" "${GUEST_HOME}/.icecp_ignore"
  fi
  # Win95 desktop icons
  mkdir -p "${GUEST_HOME}/Desktop"
  # The plain PowerShell-frame Bash desktop shortcut was retired in favour of
  # the existing Bash (CMD frame) launcher.  Remove the old projected copy so
  # established guest homes converge instead of retaining a stale icon.
  rm -f "${GUEST_HOME}/Desktop/bash-ps.desktop"
  for f in "${REPO_ROOT}/linux/.icewm/desktop/"*.desktop; do
    [[ -e "$f" ]] && project_file "$f" "${GUEST_HOME}/Desktop/$(basename "$f")"
  done
  # pcmanfm desktop background
  mkdir -p "${GUEST_HOME}/.config/pcmanfm/default"
  if [[ ! -f "${GUEST_HOME}/.config/pcmanfm/default/desktop-items-0.conf" ]]; then
    printf '[*]
wallpaper_mode=color
wallpaper_bg_color=#008080
'       > "${GUEST_HOME}/.config/pcmanfm/default/desktop-items-0.conf"
  fi
  # Declarative desktop icon layout. Seeded ONCE: applied only when the conf
  # holds no per-icon groups yet, so an arrangement the user produced by
  # dragging icons is never overwritten by a launch. Re-apply deliberately with
  # `loom redstone:layout`, or freeze the current arrangement back into source
  # with `redstone-9x-desktop-layout --capture`.
  project_file "${REPO_ROOT}/linux/.config/redstone-9x/desktop-layout.ssv" \
    "${GUEST_HOME}/.config/redstone-9x/desktop-layout.ssv"
  if ! grep -q '^\[[^*]' "${GUEST_HOME}/.config/pcmanfm/default/desktop-items-0.conf" 2>/dev/null; then
    HOME="${GUEST_HOME}" bash "${REPO_ROOT}/linux/.local/bin/redstone-9x-desktop-layout" || true
  fi
  if [[ ! -f "${GUEST_HOME}/.config/pcmanfm/default/pcmanfm.conf" ]]; then
    printf '[config]
bm_open_method=0

[ui]
show_hidden=1
view_mode=icon
'       > "${GUEST_HOME}/.config/pcmanfm/default/pcmanfm.conf"
  fi
  # libfm shows an "execute this file?" confirm dialog before launching any
  # desktop-icon .desktop entry (UI policy, not a per-file trust/exec-bit
  # check). quick_exec=1 suppresses it. Upsert rather than write-once so an
  # existing guest whose libfm.conf predates this key self-heals too.
  mkdir -p "${GUEST_HOME}/.config/libfm"
  if [[ ! -f "${GUEST_HOME}/.config/libfm/libfm.conf" ]]; then
    printf '[config]
quick_exec=1
'       > "${GUEST_HOME}/.config/libfm/libfm.conf"
  elif grep -q '^quick_exec=' "${GUEST_HOME}/.config/libfm/libfm.conf"; then
    sed -i 's/^quick_exec=.*/quick_exec=1/' "${GUEST_HOME}/.config/libfm/libfm.conf"
  elif grep -q '^\[config\]$' "${GUEST_HOME}/.config/libfm/libfm.conf"; then
    sed -i '/^\[config\]$/a quick_exec=1' "${GUEST_HOME}/.config/libfm/libfm.conf"
  else
    printf '[config]\nquick_exec=1\n\n' | cat - "${GUEST_HOME}/.config/libfm/libfm.conf" > "${GUEST_HOME}/.config/libfm/libfm.conf.tmp"
    mv "${GUEST_HOME}/.config/libfm/libfm.conf.tmp" "${GUEST_HOME}/.config/libfm/libfm.conf"
  fi
  # XDG user dirs, Windows shell-folder shape. Two facts drive this design, both
  # measured with `gio info -a standard::icon` on 2026-07-26:
  #
  #   1. Without ~/.config/user-dirs.dirs, g_get_user_special_dir() returns NULL
  #      for every well-known folder, so libfm cannot tell Documents from any
  #      other directory and renders generic "folder" for all of them — even
  #      though every scheme's pack ships folder-documents/-pictures/-music/
  #      -videos/-download/-templates/-publicshare at 32px (Serenity95 gets them
  #      through Inherits=Chicago95).
  #   2. GLib picks the special-folder icon by LITERAL PATH EQUALITY against the
  #      XDG value — it does not resolve symlinks first. A symlink sitting beside
  #      the real dir gets `inode-directory`, identical to a plain folder.
  #
  # (2) is what makes the Windows layout possible. Point XDG at "My Pictures"
  # INSIDE Documents and let that name be a symlink to the real top-level dir:
  # the Windows-named entry inherits folder-pictures, content still lives at one
  # canonical Linux path, and writes through either name land in the same place.
  # The cost is that only one of the two names can carry the icon, so the
  # top-level $HOME/Pictures drops to generic — cheap here, since this is the
  # guest home, $HOME is not on the desktop, and browsing goes through My
  # Documents. Desktop, Documents and Public stay top-level: XP has no "My"
  # form for them.
  for _d in Desktop Documents Downloads Music Pictures Videos Public Templates; do
    mkdir -p "${GUEST_HOME}/${_d}"
  done
  # Shell-folder aliases. Replace only what is safe to replace: an absent entry,
  # an EMPTY directory (the 23 July skeleton), or a symlink already pointing at
  # the right target. A directory with anything in it is left exactly as found
  # and reported — never silently deleted.
  _shell_folder() {
    local _link="${GUEST_HOME}/Documents/$1" _target="../$2"
    if [[ -L "${_link}" ]]; then
      [[ "$(readlink "${_link}")" == "${_target}" ]] && return 0
      rm -f "${_link}"
    elif [[ -d "${_link}" ]]; then
      if rmdir "${_link}" 2>/dev/null; then :; else
        echo "${SANCTUARY}: Documents/$1 is a non-empty directory — left as-is, XDG will not point at it" >&2
        return 1
      fi
    elif [[ -e "${_link}" ]]; then
      echo "${SANCTUARY}: Documents/$1 exists and is not a directory — left as-is" >&2
      return 1
    fi
    ln -sfn "${_target}" "${_link}"
  }
  _shell_folder "My Pictures" Pictures
  _shell_folder "My Music"    Music
  _shell_folder "My Videos"   Videos
  _shell_folder "Downloads"   Downloads
  _shell_folder "Templates"   Templates
  # Rewritten whenever it is absent or still carries a managed marker, so an
  # existing guest migrates from the flat layout. A file the user has edited by
  # hand (marker gone) is left alone.
  if [[ ! -f "${GUEST_HOME}/.config/user-dirs.dirs" ]] \
     || grep -q "^# managed by ${SANCTUARY}" "${GUEST_HOME}/.config/user-dirs.dirs" 2>/dev/null; then
    printf '# managed by '"${SANCTUARY}"' — delete this line to take manual control
XDG_DESKTOP_DIR="$HOME/Desktop"
XDG_DOCUMENTS_DIR="$HOME/Documents"
XDG_PICTURES_DIR="$HOME/Documents/My Pictures"
XDG_MUSIC_DIR="$HOME/Documents/My Music"
XDG_VIDEOS_DIR="$HOME/Documents/My Videos"
XDG_DOWNLOAD_DIR="$HOME/Documents/Downloads"
XDG_TEMPLATES_DIR="$HOME/Documents/Templates"
XDG_PUBLICSHARE_DIR="$HOME/Public"
'       > "${GUEST_HOME}/.config/user-dirs.dirs"
  fi

  # pcmanfm's "Compress"/"Extract" context actions use libfm's selected archiver.
  # Pin it to the in-sanctuary xarchiver so archive ops stay local and never
  # fall through to a host-spawned handler. (A prior session host-installed
  # PeaZip as the archive tool and wired the host's archive MIME handlers — that
  # overreach is gone; the sanctuary owns its own archiver.)
  if grep -q '^archiver=' "${GUEST_HOME}/.config/libfm/libfm.conf"; then
    sed -i 's/^archiver=.*/archiver=xarchiver/' "${GUEST_HOME}/.config/libfm/libfm.conf"
  else
    sed -i '/^\[config\]$/a archiver=xarchiver' "${GUEST_HOME}/.config/libfm/libfm.conf"
  fi
elif [[ "${DESKTOP}" == "fvwm95" ]]; then
  # Project FVWM95 config
  project_file "${REPO_ROOT}/linux/.config/redstone-9x/fvwm95/system.fvwm95rc"     "${GUEST_HOME}/.fvwm95rc"
  # FvwmTaskBar's GoodyLoadable CopyString does not expand $HOME, so patch the
  # absolute guest plugins path into the projected config.
  sed -i "s|@GUEST_PLUGINS@|${GUEST_HOME}/.local/fvwm95/lib/X11/fvwm95/plugins|g" "${GUEST_HOME}/.fvwm95rc"

  # ── xclass custom desktop icons + native desktop objects ──
  # The 32x32 XPMs are generated reproducibly from existing canonical PNG
  # icon sources (Chicago95 / BeOS). 'documents.xpm' already ships in the
  # xclass icon pool, so My Documents reuses it.
  DC_ICON_SRC="${REPO_ROOT}/linux/.local/share/icons"
  XCLASS_POOL="${GUEST_HOME}/.local/xclass/share/xclass-icons"
  mkdir -p "${XCLASS_POOL}"
  python3 "${REPO_ROOT}/linux/.local/bin/png2xpm.py" "${DC_ICON_SRC}/Chicago95/devices/32/computer.png"        "${XCLASS_POOL}/mycomputer.xpm" mycomputer
  python3 "${REPO_ROOT}/linux/.local/bin/png2xpm.py" "${DC_ICON_SRC}/Chicago95/apps/32/firefox_2.png"          "${XCLASS_POOL}/firefox.xpm" firefox
  python3 "${REPO_ROOT}/linux/.local/bin/png2xpm.py" "${DC_ICON_SRC}/BeOS-r5-Icons/places/32/my_briefcase.png"  "${XCLASS_POOL}/briefcase.xpm" briefcase
  # P16: period-appropriate icons for New Text Document / New Bitmap Image so
  # they are not generic blank-file icons. Generated from Chicago95 mimetypes.
  python3 "${REPO_ROOT}/linux/.local/bin/png2xpm.py" "${DC_ICON_SRC}/Chicago95/mimes/32/text-plain.png"  "${XCLASS_POOL}/textdoc.xpm" textdoc
  python3 "${REPO_ROOT}/linux/.local/bin/png2xpm.py" "${DC_ICON_SRC}/Chicago95/mimes/32/image-bmp.png"   "${XCLASS_POOL}/bitmap.xpm"  bitmap

  # P16b: game + multimedia XPMs for FVWM95 menus, generated from each app's
  # own hicolor icon (no new artwork). Sources: room-gaming profile (Guix
  # games), sanctuary-godzilla-xs profile (VLC), and the host Flatpak exports.
  _RG=${GUIX_PROFILES}/room-gaming/room-gaming
  _SX=${GUIX_PROFILES}/sanctuary-godzilla-xs/sanctuary-godzilla-xs
  _FP=${HOME}/.local/share/flatpak/exports/share/icons/hicolor/48x48/apps
  _gen_icon() { # src  outname
    if [[ -f "$1" ]]; then
      python3 "${REPO_ROOT}/linux/.local/bin/png2xpm.py" "$1" "${XCLASS_POOL}/$2.xpm" "$2" 2>/dev/null || true
    fi
  }
  # corsix-th ships only an SVG; rasterise to a 48px PNG first if rsvg is available
  if [[ -f "${_RG}/share/icons/hicolor/scalable/apps/corsix-th.svg" ]] && command -v rsvg-convert >/dev/null 2>&1; then
    rsvg-convert -w 48 -h 48 "${_RG}/share/icons/hicolor/scalable/apps/corsix-th.svg" -o /tmp/corsix-th-48.png 2>/dev/null && _gen_icon /tmp/corsix-th-48.png corsixth
  fi
  _gen_icon "${_RG}/share/icons/hicolor/48x48/apps/gnubg.png"                                  gnubg
  _gen_icon "${_RG}/share/icons/hicolor/48x48/apps/freeciv-client.png"                          freeciv
  _gen_icon "${_RG}/share/icons/hicolor/48x48/apps/openttd.png"                                openttd
  _gen_icon "${_RG}/share/icons/hicolor/48x48/apps/openrct2.png"                              openrct2
  _gen_icon "${_SX}/share/icons/hicolor/48x48/apps/vlc.png"                                   vlc
  _gen_icon "${_FP}/net.openra.OpenRA.png"                                     openra
  _gen_icon "${_FP}/com.donhopkins.Micropolis.png"                              micropolis
  _gen_icon "${_FP}/com.github.k4zmu2a.spacecadetpinball.png"                  pinball
  # dsdmine: built from DragonSWDev/dsdmine GitHub source. Icon from repo assets.
  _gen_icon "${HOME}/.local/share/dsdmine/assets/icon.png"   dsdmine

  # Native desktop objects: real executable scripts, NOT symlinks, so they
  # carry no shortcut-arrow overlay (xclass draws the arrow only on symlinks).
  # Double-click of an executable runs './<name>' (OXDesktopContainer::DoAction),
  # so each script forwards to the real program. Icons come from desktoprc.
  DC_DIR="${GUEST_HOME}/.xclass/desktop"
  mkdir -p "${DC_DIR}"
  rm -f "${DC_DIR}/Home"            # _CreateDesktop no longer creates this (Patch 13)
  rm -rf "${DC_DIR}/New Folder"     # stale junk from earlier sessions
  _write_obj() { printf '#!/bin/sh\nexec %s\n' "$2" > "${DC_DIR}/$1"; chmod +x "${DC_DIR}/$1"; }
  _write_obj "My Computer" 'explorer /'
  _write_obj "My Documents" 'explorer "$HOME"'
  _write_obj "Firefox" 'firefox'

  # desktoprc: per-object icon overrides + default positions (left column).
  # Written only when absent, so user-customised positions survive later
  # runs; Save() persists current icons, keeping the overrides stable.
  DESKTOPRC="${GUEST_HOME}/.xclass/etc/desktoprc"
  if [[ ! -f "${DESKTOPRC}" ]]; then
    mkdir -p "$(dirname "${DESKTOPRC}")"
    cat > "${DESKTOPRC}" <<'RC'
[My Computer]
icon=mycomputer.xpm
position=12,12

[My Documents]
icon=documents.xpm
position=12,96

[Firefox]
icon=firefox.xpm
position=12,180

[Recycle Bin]
icon=recycle-empty.s.xpm
position=12,264
RC
  fi

  # P16/17: normalise stale generic icon= overrides for *.txt and *.bmp
  # desktop objects so the GetIconPics special-case (textdoc.xpm /
  # bitmap.xpm) wins on refresh instead of being clobbered by an older
  # desktoprc value written before these icons existed.
  python3 - "${DESKTOPRC}" <<'PY'
import sys, re
p = sys.argv[1]
try:
    s = open(p).read()
except OSError:
    sys.exit(0)
toks = re.split(r'(\[[^\]]+\])', s)
out = []
name = None
for t in toks:
    if t.startswith('[') and t.endswith(']'):
        name = t[1:-1].strip()
        out.append(t)
    elif name and '=' in t:
        if name.lower().endswith('.txt'):
            t = re.sub(r'(?m)^icon\s*=.*$', 'icon = textdoc.xpm', t)
        elif name.lower().endswith('.bmp'):
            t = re.sub(r'(?m)^icon\s*=.*$', 'icon = bitmap.xpm', t)
        out.append(t)
    else:
        out.append(t)
open(p, 'w').write(''.join(out))
PY
fi

# ── Shared projections (all desktops) ──

# GTK themes: project EVERY theme any scheme declares (a GTK theme absent
# from the guest silently falls back to Adwaita — the Windows-3.11 bug,
# found 2026-07-19; hardcoding two themes was the defect class)
mkdir -p "${GUEST_HOME}/.themes"
for _schemefile in "${REPO_ROOT}/linux/.config/redstone-9x/schemes/"*.scheme; do
  [[ -f "${_schemefile}" ]] || continue
  # shellcheck disable=SC1090
  _gtk="$(. "${_schemefile}"; printf %s "${GTK_THEME:-}")"
  if [[ -n "${_gtk}" && -d "${REPO_ROOT}/linux/.themes/${_gtk}" ]]; then
    project_dir "${REPO_ROOT}/linux/.themes/${_gtk}" "${GUEST_HOME}/.themes/${_gtk}"
  fi
done

# Icon themes: Chicago95 is the always-present base (every guest icon theme
# Inherits it). Beyond that, project EVERY theme any scheme declares —
# hardcoding Chicago95+Serenity95 was the same defect class as the GTK
# fallback above (a scheme's icons silently missing on a fresh guest, e.g.
# BeOS-r5-Icons for the BeOS R5 scheme).
#
# EVERY scheme icon theme, Chicago95 included, is a pure read-only payload —
# SYMLINK it (project_link) straight at the repo: zero copy (was ~330MB of rm+cp
# every launch across BeOS-r5 121M, Win98SE, LinXP, SE98, Irixium, Serenity95,
# Win31) and live — a repo icon edit shows in the guest immediately, no
# re-projection, so the "stale guest copy" failure mode is structurally
# impossible.
#
# Chicago95 was the last exception, COPIED because the launcher force-copied a
# my_briefcase override into it at runtime. That made it the one theme that
# COULD go stale, and it did: found 2026-07-25 sitting three weeks behind the
# repo (27 differing entries), which silently swallowed every Chicago95 icon
# committed since — the room never saw them. The override art is now folded into
# the repo's own Chicago95 (byte-identical output, pure refactor), so the runtime
# mutation is gone and this theme is read-only like the rest.
mkdir -p "${GUEST_HOME}/.local/share/icons"
project_link "${REPO_ROOT}/linux/.local/share/icons/Chicago95" "${GUEST_HOME}/.local/share/icons/Chicago95"
for _schemefile in "${REPO_ROOT}/linux/.config/redstone-9x/schemes/"*.scheme; do
  [[ -f "${_schemefile}" ]] || continue
  # shellcheck disable=SC1090
  _icon="$(. "${_schemefile}"; printf %s "${ICON_THEME:-}")"
  [[ -n "${_icon}" && "${_icon}" != "Chicago95" ]] || continue
  [[ -d "${REPO_ROOT}/linux/.local/share/icons/${_icon}" ]] \
    && project_link "${REPO_ROOT}/linux/.local/share/icons/${_icon}" "${GUEST_HOME}/.local/share/icons/${_icon}"
done

# Kvantum themes: project EVERY theme any scheme declares. QT_STYLE=kvantum
# schemes (CDE dynasty, BeOS R5) paint Qt widgets from
# linux/.config/Kvantum/<name>; nothing else placed these in the guest, so a
# fresh home carried no Kvantum theme and the Qt look silently died. Same
# scheme-driven generalization as GTK and icons above.
mkdir -p "${GUEST_HOME}/.config/Kvantum"
for _schemefile in "${REPO_ROOT}/linux/.config/redstone-9x/schemes/"*.scheme; do
  [[ -f "${_schemefile}" ]] || continue
  # shellcheck disable=SC1090
  _kv="$(. "${_schemefile}"; printf %s "${KVANTUM_THEME:-}")"
  [[ -n "${_kv}" && -d "${REPO_ROOT}/linux/.config/Kvantum/${_kv}" ]] \
    && project_dir "${REPO_ROOT}/linux/.config/Kvantum/${_kv}" "${GUEST_HOME}/.config/Kvantum/${_kv}"
done

# Cursor themes: project each scheme's CURSOR_THEME from the DotCortex-tracked
# linux/.icons/<name> into the guest ~/.icons, dereferencing the theme's
# internal name→hash symlinks (cp -L) so the guest carries real Xcursor files.
# Chicago95_Cursor_White is cloned from upstream by fvwm95-build and lives only
# as a symlink in the repo, so skip it here (the clone owns it); this loop
# carries behand and the BeOS cursor sets that DO live as real trees in the
# repo. Same scheme-driven generalization as GTK/icons/Kvantum above.
mkdir -p "${GUEST_HOME}/.icons"
for _schemefile in "${REPO_ROOT}/linux/.config/redstone-9x/schemes/"*.scheme; do
  [[ -f "${_schemefile}" ]] || continue
  # shellcheck disable=SC1090
  _cur="$(. "${_schemefile}"; printf %s "${CURSOR_THEME:-}")"
  [[ -n "${_cur}" ]] || continue
  _cursrc="${REPO_ROOT}/linux/.icons/${_cur}"
  if [[ -d "${_cursrc}/cursors" && ! -d "${GUEST_HOME}/.icons/${_cur}/cursors" ]]; then
    mkdir -p "${GUEST_HOME}/.icons/${_cur}"
    cp -rL "${_cursrc}/." "${GUEST_HOME}/.icons/${_cur}/" 2>/dev/null || true
  fi
done

# Retire ICON themes that were hand-copied into ~/.icons. Only CURSOR themes
# belong there (the loop above); an icon theme copied there outranks the managed
# symlink under $XDG_DATA_HOME/icons in GTK's search path, so a stale duplicate
# silently shadows every repo edit to that theme. Found 2026-07-25: LinXP, SE98
# and Win98SE had sat there since 18 July, 157 MB of copies missing the newer
# notepad/firefox-desktop/my_briefcase art and carrying an index.theme without
# the Inherits=Chicago95 line the desktop-icon lookup depends on.
#
# The predicate is deliberately narrow and doubly guarded: retire only a real
# directory that (a) has NO cursors/ subdir, so no cursor theme can ever match,
# and (b) has a managed counterpart already in place at
# $XDG_DATA_HOME/icons/<name>, so nothing is removed without a replacement.
# Contents are moved to a quarantine dir, never deleted -- this runs unattended
# at launch and must not be able to destroy anything.
_icon_quarantine="${GUESTS_DIR:-${HOME}/.local/share/dotcortex/guests}/${SANCTUARY}/quarantine"
for _idir in "${GUEST_HOME}/.icons/"*/; do
  [[ -d "${_idir}" ]] || continue
  _iname="$(basename "${_idir}")"
  # `if ... then continue; fi`, NOT `[[ ... ]] && continue`: under the set -e
  # this script runs with, an `&& continue` that falls through returns 1, and
  # the moment it becomes the last statement in the body it kills the loop.
  if [[ -L "${_idir%/}" ]]; then continue; fi          # already a managed link
  if [[ -d "${_idir}cursors" ]]; then continue; fi     # a cursor theme -- belongs here
  # and never retire anything without a managed replacement already in place
  if [[ ! -e "${GUEST_HOME}/.local/share/icons/${_iname}" ]]; then continue; fi
  mkdir -p "${_icon_quarantine}"
  _idest="${_icon_quarantine}/${_iname}.$(date +%Y%m%d-%H%M%S)"
  if mv "${_idir%/}" "${_idest}" 2>/dev/null; then
    echo "redstone: retired shadowing icon theme ~/.icons/${_iname} -> ${_idest}" >&2
  fi
done

# Scheme extras: SerenityOS font + wallpapers (BSD-2-Clause, repo-tracked)
if [[ -d "${REPO_ROOT}/linux/.config/redstone-9x/fonts" ]]; then
  mkdir -p "${GUEST_HOME}/.local/share/fonts/redstone-schemes"
  for _ttf in "${REPO_ROOT}/linux/.config/redstone-9x/fonts/"*.ttf; do
    [[ -f "${_ttf}" ]] && project_file "${_ttf}" "${GUEST_HOME}/.local/share/fonts/redstone-schemes/$(basename "${_ttf}")"
  done
fi
if [[ -d "${REPO_ROOT}/linux/.config/redstone-9x/wallpapers" ]]; then
  mkdir -p "${GUEST_HOME}/.local/share/redstone-9x/wallpapers"
  for _wp in "${REPO_ROOT}/linux/.config/redstone-9x/wallpapers/"*; do
    [[ -f "${_wp}" ]] && project_file "${_wp}" "${GUEST_HOME}/.local/share/redstone-9x/wallpapers/$(basename "${_wp}")"
  done
fi

# Qt CA store — the sanctuary image ships an EMPTY /etc/ssl/certs, and QSslSocket
# builds its CA store by SCANNING that directory; SSL_CERT_FILE steers only plain
# OpenSSL, which Qt bypasses. Present-but-empty means every Qt TLS chain dies with
# "issuer certificate ... could not be found" (Zeal docset downloads, 2026-07-18).
# Symlink the desktop-common bundle at the Debian-convention path Qt checks first.
# Root-side write to the container layer: idempotent, survives restarts, and is
# re-asserted here every launch so recreation heals itself.
PODMAN_BIN="$(command -v podman 2>/dev/null || true)"
if [[ -n "${PODMAN_BIN}" ]]; then
  "${PODMAN_BIN}" exec --user 0:0 "${SANCTUARY}" sh -c \
    "mkdir -p /etc/ssl/certs && ln -sfn ${GUIX_PROFILES}/desktop-common/desktop-common/etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt" \
    2>/dev/null || true
fi

# qt6ct — Win95 Qt widget theming for Zeal (a Qt6 app; qt5ct would be inert).
# color_scheme_path must be an absolute path as seen INSIDE the container, so
# sed the projected guest path into @GUEST_QT6CT_COLORS@ (same idiom as the
# FVWM95 plugins path). QT_QPA_PLATFORMTHEME=qt6ct is set per-app on the menu
# entries, never here in the session environment, so it cannot touch session
# start. The guest home is bind-mounted at its host path inside the container,
# so ${GUEST_HOME} is the correct in-container absolute path.
mkdir -p "${GUEST_HOME}/.config/qt6ct/colors"
project_file "${REPO_ROOT}/linux/.config/redstone-9x/qt6ct/qt6ct.conf"        "${GUEST_HOME}/.config/qt6ct/qt6ct.conf"
for _qtpal in "${REPO_ROOT}/linux/.config/redstone-9x/qt6ct/colors/"*.conf; do
  [[ -f "${_qtpal}" ]] && project_file "${_qtpal}" "${GUEST_HOME}/.config/qt6ct/colors/$(basename "${_qtpal}")"
done
sed -i "s|@GUEST_QT6CT_COLORS@|${GUEST_HOME}/.config/qt6ct/colors/win95.conf|g" "${GUEST_HOME}/.config/qt6ct/qt6ct.conf"

# FOX registry palette — Xfe/xfw/xfi/xfp draw their own widgets (FOX toolkit:
# GTK/Qt themes cannot reach them; their look is these registry color keys,
# the same grammar as ice2k's ~/.foxrc/Desktop). Enforce the Win95 palette in
# each app's rc without clobbering the rest of its settings (geometry,
# toolbars). A missing rc is left alone — the app writes one on first run and
# the next launch converges it.
for _foxapp in xfe/xferc xfe/xfwrc xfe/xfirc xfe/xfprc; do
  _foxrc="${GUEST_HOME}/.config/${_foxapp}"
  [[ -f "${_foxrc}" ]] || continue
  sed -i \
    -e 's|^basecolor=.*|basecolor=#c0c0c0|' \
    -e 's|^backcolor=.*|backcolor=#ffffff|' \
    -e 's|^forecolor=.*|forecolor=#000000|' \
    -e 's|^selbackcolor=.*|selbackcolor=#000080|' \
    -e 's|^selforecolor=.*|selforecolor=#ffffff|' \
    -e 's|^shadowcolor=.*|shadowcolor=#808080|' \
    -e 's|^hilitecolor=.*|hilitecolor=#ffffff|' \
    -e 's|^bordercolor=.*|bordercolor=#404040|' \
    -e 's|^pbarcolor=.*|pbarcolor=#000080|' \
    -e 's|^scrollbarcolor=.*|scrollbarcolor=#c0c0c0|' \
    "${_foxrc}"
done
# Xfe stat-probes EVERY mtab entry each refresh — in-guest that includes the
# host's fleet automounts under /run/host, so every offline machine (t480,
# x230, …) raises a modal "Mount point … is not responding" per cycle. Its
# lstatmt is a bare lstat on Linux (no timeout), so the warning is pure noise
# about mounts the sanctuary never uses. mount_warn=0 disables the dialogs.
if [[ -f "${GUEST_HOME}/.config/xfe/xferc" ]]; then
  if grep -q '^mount_warn=' "${GUEST_HOME}/.config/xfe/xferc"; then
    sed -i 's|^mount_warn=.*|mount_warn=0|' "${GUEST_HOME}/.config/xfe/xferc"
  else
    sed -i '/^\[OPTIONS\]/a mount_warn=0' "${GUEST_HOME}/.config/xfe/xferc"
  fi
fi

# ice2k Control Panel toolbar icons — its getIconPath() reads [SETTINGS]
# iconpath from xferc, else falls back to the hardcoded
# /usr/local/share/xfe/icons/windows-theme, which exists nowhere in a Guix
# sanctuary (ice2k installs its Xfe suite under ~/.local/ice2k). On a fresh
# home xferc carries no iconpath yet, so loadToolbarIcon() returns NULL and the
# Control Panel SIGSEGVs before mapping a window (it dereferences the toolbar
# icon unconditionally). Seed iconpath at ice2k's own complete windows-theme —
# the Windows toolbar icons it was built for, and the correct look for the
# sanctuary — so the very first launch resolves smallicons.png and its
# siblings. Guarded on that theme actually being built, and enforced every
# launch like the FOX palette above.
_ice2k_icons="${GUEST_HOME}/.local/ice2k/share/xfe/icons/windows-theme"
if [[ -f "${_ice2k_icons}/smallicons.png" ]]; then
  mkdir -p "${GUEST_HOME}/.config/xfe"
  _xferc="${GUEST_HOME}/.config/xfe/xferc"
  if [[ ! -f "${_xferc}" ]]; then
    printf '[SETTINGS]\niconpath=%s\n' "${_ice2k_icons}" > "${_xferc}"
  elif grep -q '^iconpath=' "${_xferc}"; then
    sed -i "s|^iconpath=.*|iconpath=${_ice2k_icons}|" "${_xferc}"
  elif grep -q '^\[SETTINGS\]' "${_xferc}"; then
    sed -i "/^\[SETTINGS\]/a iconpath=${_ice2k_icons}" "${_xferc}"
  else
    printf '[SETTINGS]\niconpath=%s\n' "${_ice2k_icons}" >> "${_xferc}"
  fi
fi

# PowerShell profile
mkdir -p "${GUEST_HOME}/.config/powershell"
project_file "${REPO_ROOT}/linux/.config/powershell/Microsoft.PowerShell_profile.ps1"   "${GUEST_HOME}/.config/powershell/Microsoft.PowerShell_profile.ps1"

