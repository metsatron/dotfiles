#!/usr/bin/env bash
set -euo pipefail

command -v plasmashell >/dev/null 2>&1 || { echo "plasmoid-reload: plasmashell not found" >&2; exit 1; }

pid="$(pgrep -x plasmashell | head -1 || true)"
if [ -n "$pid" ] && [ -r "/proc/$pid/environ" ]; then
  setsid -f bash -c 'mapfile -d "" -t E < "/proc/$1/environ"; exec env -i "${E[@]}" plasmashell --replace' \
    _ "$pid" </dev/null >/tmp/dotcortex-plasmashell.log 2>&1
elif [ -n "${DISPLAY:-}" ]; then
  setsid -f env -u LD_PRELOAD plasmashell --replace </dev/null >/tmp/dotcortex-plasmashell.log 2>&1
else
  echo "plasmoid-reload: no running plasmashell to clone env from and no DISPLAY" >&2
  exit 1
fi
echo "plasmoid-reload: plasmashell replaced (log: /tmp/dotcortex-plasmashell.log)"
