#!/usr/bin/env bash
# Source build: sanctuary-gnustep-build

# Phase B: the GNUstep runtime and GWorkspace, built from source inside the guest — =gnustep-base/gui/back= are not in Guix channels and the sanctuary has no apt (ruled 2026-07-30). Host-side driver following the =sanctuary-nscde-build= pattern: inner script heredoc through =sanctuary-exec=, sentinel-guarded stages, everything under the persistent guest home. Toolchain is *clang + libobjc2* from the Guix profile (=ng-gnu-gnu= library combo — Guix has no =gcc-objc=, so the GCC ObjC runtime is not an option). =gnustep-make= is built from source too (2.9.3) rather than taking Guix's 2.7.0 — base 1.31 wants the newer make, and one prefix-owned make keeps the whole chain coherent. Releases pinned 2026-08-01 from GitHub (=ftp.gnustep.org= was unreachable): make 2.9.3, base 1.31.1, gui 0.32.0, back 0.32.0, GWorkspace 1.0.0 — all published 2025-02. The asclock/wmmon dockapp stage is deferred until a verifiable upstream URL is pinned; it must never sit between the stages and the GWorkspace payload.


# [[file:../../../sanctuary-gnustep.org::*Source build: sanctuary-gnustep-build][Source build: sanctuary-gnustep-build:1]]
# Build the GNUstep runtime + GWorkspace from source inside sanctuary-gnustep.
# Run once from the host: sanctuary-gnustep-build
# Sources: https://github.com/gnustep/{tools-make,libs-base,libs-gui,libs-back,apps-gworkspace}
set -euo pipefail

usage() {
  cat <<EOF
sanctuary-gnustep-build - build GNUstep (make/base/gui/back) + GWorkspace inside sanctuary-gnustep

Usage: sanctuary-gnustep-build
       sanctuary-gnustep-build -h | --help

No arguments. Clones pinned release tags from github.com/gnustep and installs
into ~/.local/share/gnustep inside the persistent guest home, using the Guix
profile's clang + libobjc2 (ng-gnu-gnu runtime). Idempotent: completed stages
are skipped via sentinel files.
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if (( $# > 0 )); then
  usage >&2
  exit 1
fi

MAKE_TAG="make-2_9_3"
BASE_TAG="base-1_31_1"
GUI_TAG="gui-0_32_0"
BACK_TAG="back-0_32_0"
GWORKSPACE_TAG="gworkspace-1_0_0"
GWORKSPACE_MENU_SENTINEL=".sentinel-gworkspace-applications-menu-1"
GWORKSPACE_MENU_TOPLEVEL_SENTINEL=".sentinel-gworkspace-applications-menu-2"
GWORKSPACE_MENU_PATHS_SENTINEL=".sentinel-gworkspace-applications-menu-3"
GWORKSPACE_MENU_EMACS_SENTINEL=".sentinel-gworkspace-applications-menu-4"
GWORKSPACE_MENU_CATALOGUE_SENTINEL=".sentinel-gworkspace-applications-menu-9"
GWORKSPACE_MENU_GAMES_SENTINEL=".sentinel-gworkspace-applications-menu-10"
GWORKSPACE_LAUNCH_PATH_SENTINEL=".sentinel-gworkspace-launch-path-2"
GWORKSPACE_APP_LAUNCH_SENTINEL=".sentinel-gworkspace-app-launch-1"
GWORKSPACE_SHELF_LEVEL_SENTINEL=".sentinel-gworkspace-tabbed-shelf-level-1"
GWORKSPACE_SHELF_BOTTOM_SENTINEL=".sentinel-gworkspace-tabbed-shelf-bottom-2"
GWORKSPACE_STARTUP_VIEWER_SENTINEL=".sentinel-gworkspace-startup-viewer-5"
EMACS_NATIVE_TAG="emacs-30.2"
EMACS_NATIVE_COMMIT="636f166cfc86aa90d63f592fd99f3fdd9ef95ebd"
EMACS_NATIVE_SENTINEL=".sentinel-gnu-emacs-native-${EMACS_NATIVE_TAG}"
EMACS_DOCUMENT_TYPES_SENTINEL=".sentinel-gnu-emacs-no-document-types-1"
GNUSTEP_APP_CACHE_SENTINEL=".sentinel-gnustep-app-cache-1"
NEXTSTEP_DOCK_SENTINEL=".sentinel-nextstep-dock-21"
NEXTSPACE_COMMIT="e5d55eff8cdb4f6949e16ab45f22c504cdab4f9d"
NEXTSPACE_THEME_SENTINEL=".sentinel-nextspace-theme-${NEXTSPACE_COMMIT}"
NEXTSPACE_CURSOR_SENTINEL=".sentinel-nextspace-cursors-${NEXTSPACE_COMMIT}"
SANCTUARY="sanctuary-gnustep"
GUIX_PROFILES="${HOME}/.guix-extra-profiles"

# Heredoc builds the inner script — outer-shell vars (tags, GUIX_PROFILES)
# expand at heredoc time; inner-shell vars are deferred via \$.
INNER_SCRIPT=$(cat <<INNER_EOF
set -eo pipefail

PREFIX=\${HOME}/.local/share/gnustep
SRC=\${HOME}/.local/share/gnustep-src

# Pre-declare vars the Guix profile scripts append to — they run under set -u
# semantics in some layers and must never hit an unbound variable.
export PKG_CONFIG_PATH="\${PKG_CONFIG_PATH:-}"
export LD_LIBRARY_PATH="\${LD_LIBRARY_PATH:-}"
export CPATH="\${CPATH:-}"
export LIBRARY_PATH="\${LIBRARY_PATH:-}"

GUIX_PROFILE=${GUIX_PROFILES}/desktop-common/desktop-common
. \${GUIX_PROFILE}/etc/profile
GUIX_PROFILE=${GUIX_PROFILES}/sanctuary-gnustep/sanctuary-gnustep
. \${GUIX_PROFILE}/etc/profile
export CURL_CA_BUNDLE=\${GIT_SSL_CAINFO}
export CC=clang CXX=clang++
# libobjc2 lives in the profile's lib/ which is on no default linker path —
# configure's "whether objc really works" probe RUNS its test binary, so both
# link-time and run-time search paths must see it explicitly.
GS_PROFILE_LIB=${GUIX_PROFILES}/sanctuary-gnustep/sanctuary-gnustep/lib
export LIBRARY_PATH="\${GS_PROFILE_LIB}:\${LIBRARY_PATH}"
export LD_LIBRARY_PATH="\${GS_PROFILE_LIB}:\${LD_LIBRARY_PATH}"
export LDFLAGS="-L\${GS_PROFILE_LIB} -Wl,-rpath,\${GS_PROFILE_LIB} -Wl,--copy-dt-needed-entries \${LDFLAGS:-}"
# clang 22 hard-errors on incompatible-pointer-types; base 1.31.1's own
# configure conftests (Feb 2025, pre-clang-22) trip it. Demote back to warning.
export CFLAGS="-g -O2 -Wno-error=incompatible-pointer-types"

mkdir -p "\${SRC}" "\${PREFIX}"
cd "\${SRC}"

clone_tag() {
  # clone_tag <repo> <tag> — shallow clone of one pinned release tag
  if [ ! -d "\$1" ]; then
    git clone --depth 1 --branch "\$2" "https://github.com/gnustep/\$1.git"
  fi
}

# ── Stage 1: gnustep-make ${MAKE_TAG} ────────────────────────────────────────
if [ ! -f "\${PREFIX}/.sentinel-${MAKE_TAG}" ]; then
  echo "Building gnustep-make (${MAKE_TAG})..."
  clone_tag tools-make ${MAKE_TAG}
  cd "\${SRC}/tools-make"
  ./configure --prefix="\${PREFIX}" --with-library-combo=ng-gnu-gnu
  make && make install
  touch "\${PREFIX}/.sentinel-${MAKE_TAG}"
  cd "\${SRC}"
else
  echo "gnustep-make ${MAKE_TAG} already installed (sentinel present)"
fi

# Everything downstream builds and runs inside the GNUstep environment.
. "\${PREFIX}/share/GNUstep/Makefiles/GNUstep.sh"

# ── Stage 2: gnustep-base ${BASE_TAG} ────────────────────────────────────────
if [ ! -f "\${PREFIX}/.sentinel-${BASE_TAG}" ]; then
  echo "Building gnustep-base (${BASE_TAG})..."
  clone_tag libs-base ${BASE_TAG}
  cd "\${SRC}/libs-base"
  ./configure
  make && make install
  touch "\${PREFIX}/.sentinel-${BASE_TAG}"
  cd "\${SRC}"
else
  echo "gnustep-base ${BASE_TAG} already installed (sentinel present)"
fi

# ── Stage 3: gnustep-gui ${GUI_TAG} ──────────────────────────────────────────
if [ ! -f "\${PREFIX}/.sentinel-${GUI_TAG}" ]; then
  echo "Building gnustep-gui (${GUI_TAG})..."
  clone_tag libs-gui ${GUI_TAG}
  cd "\${SRC}/libs-gui"
  ./configure
  make && make install
  touch "\${PREFIX}/.sentinel-${GUI_TAG}"
  cd "\${SRC}"
else
  echo "gnustep-gui ${GUI_TAG} already installed (sentinel present)"
fi

# ── Stage 4: gnustep-back ${BACK_TAG} (cairo) ────────────────────────────────
if [ ! -f "\${PREFIX}/.sentinel-${BACK_TAG}" ]; then
  echo "Building gnustep-back (${BACK_TAG})..."
  clone_tag libs-back ${BACK_TAG}
  cd "\${SRC}/libs-back"
  ./configure --enable-graphics=cairo
  make && make install
  touch "\${PREFIX}/.sentinel-${BACK_TAG}"
  cd "\${SRC}"
else
  echo "gnustep-back ${BACK_TAG} already installed (sentinel present)"
fi

# ── Stage 5: GWorkspace ${GWORKSPACE_TAG} — the Workspace Manager ────────────
if [ ! -f "\${PREFIX}/.sentinel-${GWORKSPACE_TAG}" ]; then
  echo "Building GWorkspace (${GWORKSPACE_TAG})..."
  clone_tag apps-gworkspace ${GWORKSPACE_TAG}
  cd "\${SRC}/apps-gworkspace"
  ./configure
  # The ObjC EH personality symbol lives in libobjc, which is only an INDIRECT
  # dependency (via libgnustep-base's DT_NEEDED) of GWorkspace's tools — bfd ld
  # refuses that by default ("DSO missing from command line"). LDFLAGS carries
  # -Wl,--copy-dt-needed-entries to allow it. Sentinel is the LAST link of the
  # success chain: a failed make can never forge it (a fall-through here did
  # exactly that once, 2026-07-30).
  make \
    && make install \
    && touch "\${PREFIX}/.sentinel-${GWORKSPACE_TAG}" \
    || { echo "GWorkspace stage failed" >&2; exit 1; }
  cd "\${SRC}"
else
  echo "GWorkspace ${GWORKSPACE_TAG} already installed (sentinel present)"
fi

# ── Stage 6: expose the installed catalogue in GWorkspace's own menu ─────────
# GWorkspace owns the desktop menu when it is the Workspace Manager, so the
# Window Maker WMRootMenu is not the menu the user sees. Keep this as a small
# source patch with its own sentinel: it is re-applied only when this menu
# integration has not yet been installed.
if [ ! -f "\${PREFIX}/${GWORKSPACE_MENU_SENTINEL}" ]; then
  echo "Adding the GNUstep Applications submenu to GWorkspace..."
  cd "\${SRC}/apps-gworkspace"
  if ! grep -q 'launchCataloguedApplication:' GWorkspace/GWorkspace.m; then
    git apply --whitespace=nowarn - <<'PATCH_EOF'
--- a/GWorkspace/GWorkspace.m
+++ b/GWorkspace/GWorkspace.m
@@ -292,4 +292,16 @@
+  menuItem = [menu addItemWithTitle:_(@"Applications") action:NULL keyEquivalent:@""];
+  subMenu = AUTORELEASE ([NSMenu new]);
+  [menu setSubmenu: subMenu forItem: menuItem];
+  menuItem = [subMenu addItemWithTitle:_(@"GWorkspace") action:@selector(launchCataloguedApplication:) keyEquivalent:@""];
+  [menuItem setRepresentedObject:@"GWorkspace"];
+  menuItem = [subMenu addItemWithTitle:_(@"Recycler") action:@selector(launchCataloguedApplication:) keyEquivalent:@""];
+  [menuItem setRepresentedObject:@"Recycler"];
+  menuItem = [subMenu addItemWithTitle:_(@"System Preferences") action:@selector(launchCataloguedApplication:) keyEquivalent:@""];
+  [menuItem setRepresentedObject:@"SystemPreferences"];
+  menuItem = [subMenu addItemWithTitle:_(@"Gorm") action:@selector(launchCataloguedApplication:) keyEquivalent:@""];
+  [menuItem setRepresentedObject:@"Gorm"];
+  menuItem = [subMenu addItemWithTitle:_(@"ProjectCenter") action:@selector(launchCataloguedApplication:) keyEquivalent:@""];
+  [menuItem setRepresentedObject:@"ProjectCenter"];
+  menuItem = [subMenu addItemWithTitle:_(@"Emacs") action:@selector(launchCataloguedApplication:) keyEquivalent:@""];
+  [menuItem setRepresentedObject:@"Emacs"];
-
  menuItem = [menu addItemWithTitle:_(@"History") action:NULL keyEquivalent:@""];
   subMenu = AUTORELEASE ([NSMenu new]);
   [menu setSubmenu: subMenu forItem: menuItem];
@@ -2616,5 +2629,12 @@
+- (void)launchCataloguedApplication:(id)sender
+{
+  NSString *appname = [sender representedObject];
+  if ([appname length] > 0) {
+    [self launchApplication: appname showIcon: YES autolaunch: YES];
+  }
+}
-
+
 - (void)runCommand:(id)sender
 {
   [runExtController activate];
 }
PATCH_EOF
  fi
  make \
    && make install \
    && touch "\${PREFIX}/${GWORKSPACE_MENU_SENTINEL}" \
    || { echo "GWorkspace Applications menu stage failed" >&2; exit 1; }
  cd "\${SRC}"
else
  echo "GWorkspace Applications menu already installed (sentinel present)"
fi

# Promote the submenu to the GWorkspace application menu bar. The first stage
# deliberately adds the entries inside the existing Tools menu; this follow-up
# keeps the source transition safe for rooms that already received stage 1.
if [ ! -f "\${PREFIX}/${GWORKSPACE_MENU_TOPLEVEL_SENTINEL}" ]; then
  echo "Promoting GNUstep Applications to GWorkspace's top-level menu..."
  cd "\${SRC}/apps-gworkspace"
  if grep -Fq 'menuItem = [menu addItemWithTitle:_(@"Applications")' GWorkspace/GWorkspace.m; then
    sed -i '/menuItem = \[menu addItemWithTitle:_(@"Applications")/,/\[menu setSubmenu: subMenu forItem: menuItem\];/ s/\[menu /[mainMenu /' GWorkspace/GWorkspace.m
  fi
  make \
    && make install \
    && touch "\${PREFIX}/${GWORKSPACE_MENU_TOPLEVEL_SENTINEL}" \
    || { echo "GWorkspace top-level Applications menu stage failed" >&2; exit 1; }
  cd "\${SRC}"
else
  echo "GWorkspace top-level Applications menu already installed (sentinel present)"
fi

# The menu action must pass a real bundle path.  GWorkspace's application
# registry is not guaranteed to contain freshly installed local bundles, while
# launchApplication: accepts an absolute .app path and resolves its binary.
if [ ! -f "\${PREFIX}/${GWORKSPACE_MENU_PATHS_SENTINEL}" ]; then
  echo "Making GWorkspace Applications entries resolve installed bundles..."
  cd "\${SRC}/apps-gworkspace"
  if grep -q 'launchCataloguedApplication:' GWorkspace/GWorkspace.m; then
    sed -i '/^- (void)launchCataloguedApplication:/,/^}/c\
- (void)launchCataloguedApplication:(id)sender\
{\
  NSString *appname = [sender representedObject];\
  NSString *appdir = [[[NSProcessInfo processInfo] environment] objectForKey:@"GNUSTEP_LOCAL_APPS"];\
  NSString *apppath;\
  if ([appname length] > 0) {\
    if ([appdir length] == 0) {\
      appdir = [NSHomeDirectory() stringByAppendingPathComponent:@"GNUstep/Applications"];\
      if (![[NSFileManager defaultManager] fileExistsAtPath:appdir]) {\
        appdir = [NSHomeDirectory() stringByAppendingPathComponent:@".local/share/gnustep/lib/GNUstep/Applications"];\
      }\
    }\
    apppath = [appdir stringByAppendingPathComponent:[appname stringByAppendingPathExtension:@"app"]];\
    [self launchApplication: apppath showIcon: YES autolaunch: YES];\
  }\
}' GWorkspace/GWorkspace.m
  fi
  make \
    && make install \
    && touch "\${PREFIX}/${GWORKSPACE_MENU_PATHS_SENTINEL}" \
    || { echo "GWorkspace Applications path integration failed" >&2; exit 1; }
  cd "\${SRC}"
else
  echo "GWorkspace Applications path integration already installed"
fi

# Add GNU Emacs to rooms that already received the original five-entry menu
# patch. Fresh builds get this entry from Stage 6 above; this sentinel keeps
# upgrades idempotent for persistent guest source trees.
if [ ! -f "\${PREFIX}/${GWORKSPACE_MENU_EMACS_SENTINEL}" ]; then
  echo "Adding GNU Emacs to GWorkspace's Applications menu..."
  cd "\${SRC}/apps-gworkspace"
  if ! grep -Fq 'setRepresentedObject:@"Emacs"' GWorkspace/GWorkspace.m; then
    sed -i '/\[menuItem setRepresentedObject:@"ProjectCenter";\]/a\
  menuItem = [subMenu addItemWithTitle:_(@"Emacs") action:@selector(launchCataloguedApplication:) keyEquivalent:@""];\
  [menuItem setRepresentedObject:@"Emacs"];' GWorkspace/GWorkspace.m
  fi
  make \
    && make install \
    && touch "\${PREFIX}/${GWORKSPACE_MENU_EMACS_SENTINEL}" \
    || { echo "GWorkspace Emacs menu stage failed" >&2; exit 1; }
  cd "\${SRC}"
else
  echo "GWorkspace Emacs menu already installed"
fi

# Add the first verified GAP archive tranche to GWorkspace's own Applications
# submenu. These entries are deliberately added only after their bundles have
# been built; the catalogue helper remains the source of truth for future
# rows, while this small source patch keeps the live Workspace Manager menu
# usable without making GWorkspace parse a mutable runtime file.
if [ ! -f "\${PREFIX}/${GWORKSPACE_MENU_CATALOGUE_SENTINEL}" ]; then
  echo "Adding the verified GAP applications to GWorkspace's Applications menu..."
  cd "\${SRC}/apps-gworkspace"
  python3 - <<'PY_EOF'
from pathlib import Path

path = Path("GWorkspace/GWorkspace.m")
text = path.read_text()
needle = '  [menuItem setRepresentedObject:@"ProjectCenter"];\n'
if 'setRepresentedObject:@"GSPdf"' not in text:
    text = text.replace(needle, needle + (
        '  menuItem = [subMenu addItemWithTitle:_(@"GSPdf") action:@selector(launchCataloguedApplication:) keyEquivalent:@""];\n'
        '  [menuItem setRepresentedObject:@"GSPdf"];\n'
        '  menuItem = [subMenu addItemWithTitle:_(@"GMines") action:@selector(launchCataloguedApplication:) keyEquivalent:@""];\n'
        '  [menuItem setRepresentedObject:@"GMines"];\n'
        '  menuItem = [subMenu addItemWithTitle:_(@"GShisen") action:@selector(launchCataloguedApplication:) keyEquivalent:@""];\n'
        '  [menuItem setRepresentedObject:@"GShisen"];\n'
        '  menuItem = [subMenu addItemWithTitle:_(@"GMastermind") action:@selector(launchCataloguedApplication:) keyEquivalent:@""];\n'
        '  [menuItem setRepresentedObject:@"GMastermind"];\n'
    ), 1)
if 'setRepresentedObject:@"Emacs"' not in text:
    text = text.replace(needle, needle + (
        '  menuItem = [subMenu addItemWithTitle:_(@"Emacs") action:@selector(launchCataloguedApplication:) keyEquivalent:@""];\n'
        '  [menuItem setRepresentedObject:@"Emacs"];\n'
    ), 1)
path.write_text(text)
PY_EOF
  make \
    && make install \
    && touch "\${PREFIX}/${GWORKSPACE_MENU_CATALOGUE_SENTINEL}" \
    || { echo "GWorkspace verified catalogue menu stage failed" >&2; exit 1; }
  cd "\${SRC}"
else
  echo "GWorkspace verified catalogue menu already installed"
fi

# Add the newly verified GAP games to GWorkspace's own Applications submenu.
# This is a separate sentinel so the original archive tranche remains
# recoverable and persistent guest sources are upgraded exactly once.
if [ ! -f "\${PREFIX}/${GWORKSPACE_MENU_GAMES_SENTINEL}" ]; then
  echo "Adding the verified GAP games to GWorkspace's Applications menu..."
  cd "\${SRC}/apps-gworkspace"
  python3 - <<'PY_EOF'
from pathlib import Path

path = Path("GWorkspace/GWorkspace.m")
text = path.read_text()
needle = '  [menuItem setRepresentedObject:@"GMastermind"];\n'
if 'setRepresentedObject:@"Sudoku"' not in text:
    text = text.replace(needle, needle + (
        '  menuItem = [subMenu addItemWithTitle:_(@"Sudoku") action:@selector(launchCataloguedApplication:) keyEquivalent:@""];\n'
        '  [menuItem setRepresentedObject:@"Sudoku"];\n'
        '  menuItem = [subMenu addItemWithTitle:_(@"LapisPuzzle") action:@selector(launchCataloguedApplication:) keyEquivalent:@""];\n'
        '  [menuItem setRepresentedObject:@"LapisPuzzle"];\n'
        '  menuItem = [subMenu addItemWithTitle:_(@"Jigsaw") action:@selector(launchCataloguedApplication:) keyEquivalent:@""];\n'
        '  [menuItem setRepresentedObject:@"Jigsaw"];\n'
    ), 1)
path.write_text(text)
PY_EOF
  make \
    && make install \
    && touch "\${PREFIX}/${GWORKSPACE_MENU_GAMES_SENTINEL}" \
    || { echo "GWorkspace verified games menu stage failed" >&2; exit 1; }
  cd "\${SRC}"
else
  echo "GWorkspace verified games menu already installed"
fi

# GWorkspace's shelf passes absolute .app directories through
# openSelectedPaths:. NSWorkspace's application registry does not reliably
# resolve those local bundles, and GWorkspace's launcher rejected them before
# reaching its own absolute-path fallback. Teach that fallback to read the
# bundle executable, then route shelf application icons through it.
if [ ! -f "\${PREFIX}/${GWORKSPACE_LAUNCH_PATH_SENTINEL}" ]; then
  echo "Making GWorkspace launch absolute GNUstep bundles..."
  cd "\${SRC}/apps-gworkspace"
  if false; then
  git apply --whitespace=nowarn - <<'PATCH_EOF'
--- a/GWorkspace/GWorkspace.m
+++ b/GWorkspace/GWorkspace.m
@@ -1269,7 +1269,7 @@
\t\telse if (type == NSApplicationFileType)
\t\t  {
-\t\t    [ws launchApplication: apath];
+\t\t    [self launchApplication: apath showIcon: YES autolaunch: YES];
\t\t  }
--- a/GWorkspace/WorkspaceApplication.m
+++ b/GWorkspace/WorkspaceApplication.m
@@ -434,2 +434,20 @@
  path = [ws locateApplicationBinary: appname];

+  if (path == nil && [appname isAbsolutePath]) {
+    NSString *bundlePath = [appname stringByStandardizingPath];
+    NSString *infoPath = [bundlePath stringByAppendingPathComponent: @"Resources/Info-gnustep.plist"];
+    NSDictionary *info = [NSDictionary dictionaryWithContentsOfFile: infoPath];
+    NSString *executable = [info objectForKey: @"NSExecutable"];
+
+    if ([executable length] == 0) {
+      executable = [[[bundlePath lastPathComponent] stringByDeletingPathExtension] copy];
+      [executable autorelease];
+    }
+    if ([executable length] > 0) {
+      path = [bundlePath stringByAppendingPathComponent: executable];
+      if (![[NSFileManager defaultManager] fileExistsAtPath: path]) {
+        path = nil;
+      }
+    }
+  }
+
   if (path == nil) {
\t  return NO;
\t}
PATCH_EOF
  fi
  sed -i 's/\[ws launchApplication: apath\];/[self launchApplication: apath showIcon: YES autolaunch: YES];/' \
    GWorkspace/GWorkspace.m
  # getInfoForFile: returns an equivalent type string, not necessarily the
  # NSApplicationFileType constant object. Value equality is required here;
  # pointer identity made shelf .app icons silently do nothing.
  sed -i 's/type == NSApplicationFileType/([type isEqual: NSApplicationFileType])/' \
    GWorkspace/GWorkspace.m
  if false; then
  git apply --whitespace=nowarn - <<'PATCH_LAUNCH_EOF'
--- a/GWorkspace/WorkspaceApplication.m
+++ b/GWorkspace/WorkspaceApplication.m
@@ -432,6 +432,20 @@
  path = [ws locateApplicationBinary: appname];

+  if (path == nil && [appname isAbsolutePath]) {
+    NSString *bundlePath = [appname stringByStandardizingPath];
+    NSString *infoPath = [bundlePath stringByAppendingPathComponent: @"Resources/Info-gnustep.plist"];
+    NSDictionary *info = [NSDictionary dictionaryWithContentsOfFile: infoPath];
+    NSString *executable = [info objectForKey: @"NSExecutable"];
+
+    if ([executable length] == 0) {
+      executable = [[[bundlePath lastPathComponent] stringByDeletingPathExtension] copy];
+      [executable autorelease];
+    }
+    if ([executable length] > 0) {
+      path = [bundlePath stringByAppendingPathComponent: executable];
+      if (![[NSFileManager defaultManager] fileExistsAtPath: path]) {
+        path = nil;
+      }
+    }
+  }
+
PATCH_LAUNCH_EOF
  fi
  if ! grep -Fq 'bundlePath = [appname stringByStandardizingPath]' GWorkspace/WorkspaceApplication.m; then
    sed -i '/^  if (path == nil) {$/i\
  if (path == nil && [appname isAbsolutePath]) {\
    NSString *bundlePath = [appname stringByStandardizingPath];\
    NSString *infoPath = [bundlePath stringByAppendingPathComponent: @"Resources/Info-gnustep.plist"];\
    NSDictionary *info = [NSDictionary dictionaryWithContentsOfFile: infoPath];\
    NSString *executable = [info objectForKey: @"NSExecutable"];\
    if ([executable length] == 0) {\
      executable = [[[bundlePath lastPathComponent] stringByDeletingPathExtension] copy];\
      [executable autorelease];\
    }\
    if ([executable length] > 0) {\
      path = [bundlePath stringByAppendingPathComponent: executable];\
      if (![[NSFileManager defaultManager] fileExistsAtPath: path]) {\
        path = nil;\
      }\
    }\
  }' GWorkspace/WorkspaceApplication.m
  fi

  make \
    && make install \
    && touch "\${PREFIX}/${GWORKSPACE_LAUNCH_PATH_SENTINEL}" \
    || { echo "GWorkspace absolute-bundle launch stage failed" >&2; exit 1; }
  cd "\${SRC}"
else
  echo "GWorkspace absolute-bundle launch stage already installed"
fi

# GWorkspace's autolaunch argument is intended for applications that explicitly
# implement it. GAP Terminal treats every argument after its executable as a
# shell command, so the synthetic "-autolaunch YES" pair makes it run and exit
# immediately without opening its normal window. Keep GWorkspace's ordinary
# catalogue and shelf launches argument-free while retaining the absolute-bundle
# resolution above.
if [ ! -f "\${PREFIX}/${GWORKSPACE_APP_LAUNCH_SENTINEL}" ]; then
  echo "Removing synthetic GWorkspace application launch arguments..."
  cd "\${SRC}/apps-gworkspace"
  sed -i 's/\[self launchApplication: apppath showIcon: YES autolaunch: YES\];/[self launchApplication: apppath showIcon: YES autolaunch: NO];/' \
    GWorkspace/GWorkspace.m
  sed -i 's/\[self launchApplication: apath showIcon: YES autolaunch: YES\];/[self launchApplication: apath showIcon: YES autolaunch: NO];/' \
    GWorkspace/GWorkspace.m
  if ! grep -Fq '[self launchApplication: apppath showIcon: YES autolaunch: NO];' GWorkspace/GWorkspace.m \
    || ! grep -Fq '[self launchApplication: apath showIcon: YES autolaunch: NO];' GWorkspace/GWorkspace.m; then
    echo "GWorkspace launch argument compatibility patch did not apply" >&2
    exit 1
  fi
  make \
    && make install \
    && touch "\${PREFIX}/${GWORKSPACE_APP_LAUNCH_SENTINEL}" \
    || { echo "GWorkspace application launch compatibility stage failed" >&2; exit 1; }
  cd "\${SRC}"
else
  echo "GWorkspace application launch compatibility stage already installed"
fi

# GWorkspace's desktop window is intentionally assigned NSDesktopWindowLevel.
# The upstream tabbed shelf is otherwise left at the ordinary window level and
# is therefore painted underneath that full-screen desktop in Window Maker.
# Keep the shelf above the desktop so the persisted tshelf preference is
# visible and interactive at startup.
if [ ! -f "\${PREFIX}/${GWORKSPACE_SHELF_LEVEL_SENTINEL}" ]; then
  echo "Raising the GWorkspace tabbed shelf above its desktop surface..."
  cd "\${SRC}/apps-gworkspace"
  if ! grep -q 'setLevel: NSStatusWindowLevel' GWorkspace/TShelf/TShelfWin.m; then
    sed -i '/^  if (self) {$/a\
    [self setLevel: NSStatusWindowLevel];' GWorkspace/TShelf/TShelfWin.m
  fi
  make \
    && make install \
    && touch "\${PREFIX}/${GWORKSPACE_SHELF_LEVEL_SENTINEL}" \
    || { echo "GWorkspace tabbed shelf level stage failed" >&2; exit 1; }
  cd "\${SRC}"
else
  echo "GWorkspace tabbed shelf level already installed"
fi

# Window Maker can retain a manually moved dock-like window position. Reassert
# the NeXT shelf's bottom anchor every time GWorkspace activates it, including
# after a room restart or a stale WM placement has survived in the X session.
if [ ! -f "\${PREFIX}/${GWORKSPACE_SHELF_BOTTOM_SENTINEL}" ]; then
  echo "Anchoring the GWorkspace tabbed shelf to the bottom edge..."
  cd "\${SRC}/apps-gworkspace"
  if grep -Fq 'NSMaxY(screenFrame) - NSHeight(shelfFrame)' GWorkspace/TShelf/TShelfWin.m; then
    sed -i 's/NSMaxY(screenFrame) - NSHeight(shelfFrame)/NSMinY(screenFrame)/' \
      GWorkspace/TShelf/TShelfWin.m
  fi
  if ! grep -Fq 'setFrame: shelfFrame display: NO' GWorkspace/TShelf/TShelfWin.m; then
  git apply --whitespace=nowarn - <<'PATCH_SHELF_EOF'
--- a/GWorkspace/TShelf/TShelfWin.m
+++ b/GWorkspace/TShelf/TShelfWin.m
@@ -165,4 +165,9 @@
 - (void)activate
 {
+  NSRect screenFrame = [[NSScreen mainScreen] frame];
+  NSRect shelfFrame = [self frame];
+  shelfFrame.origin = NSMakePoint(NSMinX(screenFrame),
+                                  NSMinY(screenFrame));
+  [self setFrame: shelfFrame display: NO];
   [self makeKeyAndOrderFront: nil];
 }
PATCH_SHELF_EOF
  fi
  make \
    && make install \
    && touch "\${PREFIX}/${GWORKSPACE_SHELF_BOTTOM_SENTINEL}" \
    || { echo "GWorkspace tabbed shelf bottom-anchor stage failed" >&2; exit 1; }
  cd "\${SRC}"
else
  echo "GWorkspace tabbed shelf bottom anchor already installed"
fi

# GNUstep can create GWorkspace's root viewer before Window Maker has begun
# managing nested application windows.  In that race the process stays alive
# but every viewer window remains unmapped.  Re-request the root viewer after
# the application has finished launching, which is safe when the first pass
# already succeeded because GWorkspace simply activates the existing viewer.
if [ ! -f "\${PREFIX}/${GWORKSPACE_STARTUP_VIEWER_SENTINEL}" ]; then
  echo "Ensuring GWorkspace opens its root viewer after startup..."
  cd "\${SRC}/apps-gworkspace"
  if grep -Fq -- '- (void)selectionChanged:(NSArray *)newsel' GWorkspace/GWorkspace.m; then
    sed -i '/^- (void)selectionChanged:/c\\
- (void)selectionChanged:(NSArray *)newsel\
{\
  NSMutableArray *paths = [NSMutableArray arrayWithCapacity: [newsel count]];\
  NSUInteger i;\
  for (i = 0; i < [newsel count]; i++) {\
    id entry = [newsel objectAtIndex: i];\
    if ([entry isKindOfClass: [FSNode class]]) {\
      [paths addObject: [entry path]];\
    } else if ([entry isKindOfClass: [NSString class]]) {\
      [paths addObject: entry];\
    }\
  }\
  [self setSelectedPaths: paths];\
}' GWorkspace/GWorkspace.m
  else
    sed -i '/^- (NSApplicationTerminateReply)applicationShouldTerminate/i\\
- (void)selectionChanged:(NSArray *)newsel\
{\
  NSMutableArray *paths = [NSMutableArray arrayWithCapacity: [newsel count]];\
  NSUInteger i;\
  for (i = 0; i < [newsel count]; i++) {\
    id entry = [newsel objectAtIndex: i];\
    if ([entry isKindOfClass: [FSNode class]]) {\
      [paths addObject: [entry path]];\
    } else if ([entry isKindOfClass: [NSString class]]) {\
      [paths addObject: entry];\
    }\
  }\
  [self setSelectedPaths: paths];\
}\
' GWorkspace/GWorkspace.m
  fi
  if ! grep -Fq 'unhideWithoutActivation' GWorkspace/GWorkspace.m; then
    sed -i '/\[self initializeWorkspace\];/a\\
  [NSApp unhideWithoutActivation];' \
      GWorkspace/GWorkspace.m
  fi
  if ! grep -Fq 'activateIgnoringOtherApps: YES' GWorkspace/GWorkspace.m; then
    sed -i '/\[self initializeWorkspace\];/a\\
  [NSApp activateIgnoringOtherApps: YES];' \
      GWorkspace/GWorkspace.m
  fi
  if ! grep -Fq 'afterDelay: 1.0' GWorkspace/GWorkspace.m; then
    sed -i '/\[self initializeWorkspace\];/a\\
  [self performSelector: @selector(showRootViewer) withObject: nil afterDelay: 1.0];' \
      GWorkspace/GWorkspace.m
  fi
  make \
    && make install \
    && touch "\${PREFIX}/${GWORKSPACE_STARTUP_VIEWER_SENTINEL}" \
    || { echo "GWorkspace startup viewer stage failed" >&2; exit 1; }
  cd "\${SRC}"
else
  echo "GWorkspace startup viewer stage already installed"
fi

# Build GNU Emacs as a real GNUstep/NeXTstep application. The previous
# implementation exposed the ordinary Guix X/GTK Emacs binary through a tiny
# launcher bundle; that made it discoverable but could never provide the
# GNUstep application menu, native NS frames, or the NeXT/OpenStep event path.
# Emacs' supported native switch is --with-ns (GNUstep on this Linux guest),
# with --with-x=no keeping the build out of the X/GTK implementation.
if [ ! -f "\${PREFIX}/${EMACS_NATIVE_SENTINEL}" ]; then
  echo "Building GNU Emacs ${EMACS_NATIVE_TAG} with the GNUstep native UI..."
  EMACS_SRC="\${SRC}/emacs-${EMACS_NATIVE_TAG}"
  if [ ! -d "\${EMACS_SRC}/.git" ]; then
    if [ -e "\${EMACS_SRC}" ]; then
      echo "Emacs source path exists but is not a git checkout: \${EMACS_SRC}" >&2
      exit 1
    fi
    git clone --depth 1 --branch "${EMACS_NATIVE_TAG}" \
      https://git.savannah.gnu.org/git/emacs.git "\${EMACS_SRC}"
  fi
  cd "\${EMACS_SRC}"
  if [ "\$(git rev-parse HEAD)" != "${EMACS_NATIVE_COMMIT}" ]; then
    git fetch --depth 1 origin "${EMACS_NATIVE_COMMIT}"
    git checkout --detach "${EMACS_NATIVE_COMMIT}"
  fi
  [ "\$(git rev-parse HEAD)" = "${EMACS_NATIVE_COMMIT}" ] || {
    echo "Emacs checkout is not the pinned ${EMACS_NATIVE_COMMIT}" >&2
    exit 1
  }
  if [ ! -x ./configure ]; then
    ./autogen.sh
  fi
  ./configure \
    --prefix="\${PREFIX}" \
    --with-ns \
    --with-x=no \
    --with-gnustep-conf="\${PREFIX}/etc/GNUstep/GNUstep.conf" \
    --with-modules \
    --without-native-compilation \
    --disable-build-details
  make -j"\$(nproc)"
  make install
  EMACS_BUILT_APP="\${EMACS_SRC}/nextstep/Emacs.app"
  EMACS_APP="\${PREFIX}/lib/GNUstep/Applications/Emacs.app"
  [ -x "\${EMACS_BUILT_APP}/Emacs" ] || {
    echo "GNUstep Emacs build did not produce \${EMACS_BUILT_APP}/Emacs" >&2
    exit 1
  }
  [ -f "\${EMACS_BUILT_APP}/Resources/Info-gnustep.plist" ] || {
    echo "GNUstep Emacs bundle is missing Info-gnustep.plist" >&2
    exit 1
  }
  if [ -e "\${EMACS_APP}" ]; then
    EMACS_BACKUP="\${EMACS_APP}.pre-native-${EMACS_NATIVE_TAG}"
    if [ -e "\${EMACS_BACKUP}" ]; then
      echo "Refusing to overwrite existing Emacs backup: \${EMACS_BACKUP}" >&2
      exit 1
    fi
    mv "\${EMACS_APP}" "\${EMACS_BACKUP}"
  fi
  mkdir -p "\${PREFIX}/lib/GNUstep/Applications"
  cp -a "\${EMACS_BUILT_APP}" "\${EMACS_APP}"
  [ -x "\${EMACS_APP}/Emacs" ] || {
    echo "Installed GNUstep Emacs bundle is not executable" >&2
    exit 1
  }
  [ -f "\${EMACS_APP}/Resources/emacs.tiff" ] || {
    echo "Installed GNUstep Emacs bundle is missing emacs.tiff" >&2
    exit 1
  }
  touch "\${PREFIX}/${EMACS_NATIVE_SENTINEL}"
else
  echo "GNU Emacs GNUstep native bundle already installed"
fi

# Native Emacs is an application in this room, but it must not register itself
# as the workspace handler for every file.  Its upstream GNUstep plist includes
# an NSUnixExtensions wildcard; that makes GWorkspace's Open action route
# ordinary files into Emacs instead of honoring the workspace/editor choice.
# Keep the Emacs application and its explicit menu entries, while removing only
# the broad document-type registration from the installed bundle.
if [ ! -f "\${PREFIX}/${EMACS_DOCUMENT_TYPES_SENTINEL}" ]; then
  echo "Removing GNU Emacs' wildcard workspace document registration..."
  EMACS_APP="\${PREFIX}/lib/GNUstep/Applications/Emacs.app"
  EMACS_INFO="\${EMACS_APP}/Resources/Info-gnustep.plist"
  [ -f "\${EMACS_INFO}" ] || {
    echo "GNUstep Emacs plist is missing: \${EMACS_INFO}" >&2
    exit 1
  }
  python3 - "\${EMACS_INFO}" <<'PY'
import os
import sys
import tempfile

path = sys.argv[1]
with open(path, encoding="utf-8") as stream:
    text = stream.read()

if "NSUnixExtensions" not in text:
    raise SystemExit("GNUstep Emacs plist has no document-type block")

lines = text.splitlines(keepends=True)
result = []
inside = False
depth = 0
removed = False
for line in lines:
    stripped = line.strip()
    if not inside and stripped == "NSTypes = (":
        inside = True
        depth = 1
        removed = True
        continue
    if inside:
        depth += line.count("(") - line.count(")")
        if depth <= 0:
            inside = False
        continue
    result.append(line)

if inside or not removed:
    raise SystemExit("unexpected GNUstep Emacs plist NSTypes layout")

mode = os.stat(path).st_mode & 0o777
directory = os.path.dirname(path)
fd, temporary = tempfile.mkstemp(prefix=".emacs-document-types.", dir=directory)
try:
    with os.fdopen(fd, "w", encoding="utf-8") as stream:
        stream.write("".join(result))
    os.chmod(temporary, mode)
    os.replace(temporary, path)
finally:
    if os.path.exists(temporary):
        os.unlink(temporary)
PY
  touch "\${PREFIX}/${EMACS_DOCUMENT_TYPES_SENTINEL}"
else
  echo "GNU Emacs wildcard workspace document registration already removed"
fi

# ── Stage 8: a real beveled NeXTSTEP dock tile ──────────────────────────────
# Window Maker's built-in Logo.WMDock cannot consume an arbitrary XPM. Build a
# small X11 dockapp that includes the canonical NeXT logo asset, advertises the
# instance.DockApp pair used by Window Maker's dockapps, and opens GWorkspace
# on click.
if [ ! -f "\${PREFIX}/${NEXTSTEP_DOCK_SENTINEL}" ]; then
  echo "Building the NeXT logo dockapp..."
  DOCK_SRC="\${SRC}/nextstep-dock.c"
  cp /run/host/home/metsatron/DotCortex/linux/.config/gnustep-sanctuary/Icons/NeXT_logo.xpm "\${SRC}/nextstep-logo.xpm"
  cat > "\${DOCK_SRC}" <<'DOCK_EOF'
#include <X11/Xlib.h>
#include <X11/Xutil.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

#include "nextstep-logo.xpm"

#define LOGO_DRAW_SIZE 60
#define LOGO_OFFSET 2

static unsigned long
colour(Display *display, Colormap colormap, const char *spec)
{
  XColor exact;
  if (!XParseColor(display, colormap, spec, &exact) ||
      !XAllocColor(display, colormap, &exact)) {
    return BlackPixel(display, DefaultScreen(display));
  }
  return exact.pixel;
}

static void
draw_tile_background(Display *display, Window window, GC gc, Colormap colormap)
{
  unsigned long light = colour(display, colormap, "#ffffff");
  unsigned long inner_dark = colour(display, colormap, "#23242b");
  unsigned long dark = colour(display, colormap, "#000000");
  unsigned long diagonal[120] = {0};
  unsigned int x;
  unsigned int y;

  /* This is the same 64x64 common_Tile.tiff geometry shipped by the pinned
     NEXTSPACE theme: two white pixels at the upper/left edge, two near-black
     pixels at the lower/right edge, and a cool gray diagonal interpolation
     through the interior. Keep it in the dockapp so the custom tile and WM's
     tpixmap IconBack share one surface instead of drifting by a shade. */
  XSetForeground(display, gc, light);
  XFillRectangle(display, window, gc, 0, 0, 64, 64);
  for (y = 2; y < 62; y++) {
    for (x = 2; x < 62; x++) {
      unsigned int distance = x + y - 4;
      char spec[32];
      int red = 170 - (int) ((distance * 83 + 59) / 118);
      int blue = 183 - (int) ((distance * 80 + 59) / 118);
      if (diagonal[distance] == 0) {
        snprintf(spec, sizeof(spec), "#%02x%02x%02x", red, red, blue);
        diagonal[distance] = colour(display, colormap, spec);
      }
      XSetForeground(display, gc, diagonal[distance]);
      XDrawPoint(display, window, gc, x, y);
    }
  }
  XSetForeground(display, gc, inner_dark);
  XDrawLine(display, window, gc, 62, 2, 62, 61);
  XDrawLine(display, window, gc, 2, 62, 61, 62);
  XSetForeground(display, gc, dark);
  XDrawLine(display, window, gc, 63, 0, 63, 63);
  XDrawLine(display, window, gc, 0, 63, 63, 63);
}

static void
draw_logo(Display *display, Window window, GC gc, Colormap colormap)
{
  unsigned long pixels[256] = {0};
  unsigned int i;
  unsigned int x;
  unsigned int y;

  for (i = 0; i < 8; i++) {
    char symbol;
    char spec[32];
    if (sscanf(nextstep_logo[i + 1], "%c c %31s", &symbol, spec) != 2) {
      continue;
    }
    if (strcmp(spec, "None") != 0) {
      pixels[(unsigned char) symbol] = colour(display, colormap, spec);
    }
  }

  /* Fill the two-pixel bevel's interior directly from the 60px SVG-derived
     XPM. The vector source is rasterized at the display size before build;
     there is no runtime enlargement of a smaller raster. */
  for (y = 0; y < LOGO_DRAW_SIZE; y++) {
    for (x = 0; x < LOGO_DRAW_SIZE; x++) {
      unsigned char symbol =
        (unsigned char) nextstep_logo[y + 9][x];
      /* '+' is transparent; a literal space is the cube's dark fill. */
      if (symbol != '+') {
        XSetForeground(display, gc, pixels[symbol]);
        XDrawPoint(display, window, gc, x + LOGO_OFFSET, y + LOGO_OFFSET);
      }
    }
  }
}

static void
launch_gworkspace(void)
{
  pid_t child = fork();
  if (child == 0) {
    execlp("sh", "sh", "-c",
           "if ! pgrep -x GWorkspace >/dev/null 2>&1; then exec openapp GWorkspace; fi",
           "sh", (char *) 0);
    _exit(127);
  }
}

int
main(void)
{
  Display *display = XOpenDisplay(NULL);
  int screen;
  Window window;
  Window icon_window;
  GC gc;
  XEvent event;
  XClassHint class_hint;
  XSizeHints size_hints;
  XWMHints wm_hints;

  if (display == NULL) {
    return 1;
  }
  screen = DefaultScreen(display);
  window = XCreateSimpleWindow(display, RootWindow(display, screen),
                               0, 0, 64, 64, 0,
                               BlackPixel(display, screen),
                               colour(display, DefaultColormap(display, screen), "#555577"));
  icon_window = XCreateSimpleWindow(display, RootWindow(display, screen),
                                    0, 0, 64, 64, 0,
                                    BlackPixel(display, screen),
                                    colour(display, DefaultColormap(display, screen), "#555577"));
  class_hint.res_name = (char *) "nextstep-dock";
  class_hint.res_class = (char *) "DockApp";
  XSetClassHint(display, window, &class_hint);
  XSetClassHint(display, icon_window, &class_hint);
  XStoreName(display, window, "nextstep-dock");
  XStoreName(display, icon_window, "nextstep-dock");
  memset(&size_hints, 0, sizeof(size_hints));
  size_hints.flags = PMinSize | PMaxSize | PBaseSize;
  size_hints.min_width = size_hints.max_width = size_hints.base_width = 64;
  size_hints.min_height = size_hints.max_height = size_hints.base_height = 64;
  XSetWMNormalHints(display, window, &size_hints);
  memset(&wm_hints, 0, sizeof(wm_hints));
  wm_hints.flags = InputHint | StateHint | IconWindowHint |
                   IconPositionHint | WindowGroupHint;
  wm_hints.input = True;
  wm_hints.initial_state = WithdrawnState;
  wm_hints.icon_window = icon_window;
  wm_hints.icon_x = 0;
  wm_hints.icon_y = 0;
  wm_hints.window_group = window;
  XSetWMHints(display, window, &wm_hints);
  XSelectInput(display, icon_window, ExposureMask | ButtonPressMask);
  gc = XCreateGC(display, icon_window, 0, NULL);
  XMapWindow(display, window);
  draw_tile_background(display, icon_window, gc,
                       DefaultColormap(display, screen));
  draw_logo(display, icon_window, gc, DefaultColormap(display, screen));
  XFlush(display);

  for (;;) {
    XNextEvent(display, &event);
    if (event.type == Expose && event.xexpose.count == 0) {
      draw_tile_background(display, icon_window, gc,
                           DefaultColormap(display, screen));
      draw_logo(display, icon_window, gc, DefaultColormap(display, screen));
      XFlush(display);
    } else if (event.type == ButtonPress && event.xbutton.button == Button1) {
      launch_gworkspace();
    }
  }
}
DOCK_EOF
  mkdir -p "\${PREFIX}/bin"
  "\${CC}" -std=c99 -O2 -Wall -Wextra "\${DOCK_SRC}" -o "\${PREFIX}/bin/nextstep-dock" -lX11
  touch "\${PREFIX}/${NEXTSTEP_DOCK_SENTINEL}"
else
  echo "NeXT logo dockapp already installed"
fi

# ── Stage 9: compatible NEXTSPACE visual assets ─────────────────────────────
# NEXTSPACE's full Workspace session is deliberately not used here: it embeds
# its own modified Window Maker. Its GNUstep theme and Xcursor payload are
# independent assets, however. The theme compiles against this room's stock
# GNUstep Cairo headers but is not selected until its runtime rendering is
# compatible; the cursor payload is safe to project immediately. Pin the
# donor tree so a future upstream change cannot silently alter the room.
NEXTSPACE_SRC="\${SRC}/nextspace"
if [ ! -d "\${NEXTSPACE_SRC}/.git" ]; then
  if [ -e "\${NEXTSPACE_SRC}" ]; then
    echo "NEXTSPACE source path exists but is not a git checkout: \${NEXTSPACE_SRC}" >&2
    exit 1
  fi
  git clone --filter=blob:none --no-checkout \
    https://github.com/trunkmaster/nextspace.git "\${NEXTSPACE_SRC}"
fi
cd "\${NEXTSPACE_SRC}"
if ! git cat-file -e "${NEXTSPACE_COMMIT}^{commit}" 2>/dev/null; then
  git fetch --depth=1 origin "${NEXTSPACE_COMMIT}"
fi
git checkout --detach "${NEXTSPACE_COMMIT}"

if [ ! -f "\${PREFIX}/${NEXTSPACE_THEME_SENTINEL}" ]; then
  echo "Building the pinned NEXTSPACE GNUstep theme (${NEXTSPACE_COMMIT})..."
  cd "\${NEXTSPACE_SRC}/Libraries/gnustep/nextspace-theme"
  make && make install
  touch "\${PREFIX}/${NEXTSPACE_THEME_SENTINEL}"
else
  echo "NEXTSPACE GNUstep theme already installed (sentinel present)"
fi

if [ ! -f "\${PREFIX}/${NEXTSPACE_CURSOR_SENTINEL}" ]; then
  echo "Projecting the pinned NEXTSPACE cursor theme..."
  CURSOR_SRC="\${NEXTSPACE_SRC}/OS/Linux/usr/share/icons/NextSpace"
  CURSOR_PARENT="\${HOME}/.local/share/icons"
  CURSOR_DST="\${CURSOR_PARENT}/NextSpace"
  CURSOR_TMP="\${CURSOR_PARENT}/.NextSpace.${NEXTSPACE_COMMIT}.\$\$"
  mkdir -p "\${CURSOR_PARENT}"
  cp -a "\${CURSOR_SRC}" "\${CURSOR_TMP}"
  if [ -e "\${CURSOR_DST}" ] || [ -L "\${CURSOR_DST}" ]; then
    CURSOR_BACKUP="\${CURSOR_DST}.backup-\$(date +%Y%m%d-%H%M%S)"
    mv "\${CURSOR_DST}" "\${CURSOR_BACKUP}"
    echo "Previous NEXTSPACE cursor theme preserved at \${CURSOR_BACKUP}"
  fi
  mv "\${CURSOR_TMP}" "\${CURSOR_DST}"
  touch "\${PREFIX}/${NEXTSPACE_CURSOR_SENTINEL}"
else
  echo "NEXTSPACE cursor theme already projected (sentinel present)"
fi

# ── Stage 10: refresh GNUstep's application/type registry ───────────────────
# NSWorkspace reads .GNUstepAppList once per process.  Rebuild it after every
# catalogue/build run so an application that was previously installed with a
# broad NSTypes declaration cannot remain the stale default handler for files.
# Preserve the old cache before replacing it; this is a runtime cache, not a
# source file, but it is useful evidence and a reversible recovery point.
if [ ! -f "\${PREFIX}/${GNUSTEP_APP_CACHE_SENTINEL}" ]; then
  echo "Refreshing GNUstep's application registry..."
  SERVICES_DIR="\${HOME}/GNUstep/Library/Services"
  APP_CACHE="\${SERVICES_DIR}/.GNUstepAppList"
  mkdir -p "\${SERVICES_DIR}"
  if [ -f "\${APP_CACHE}" ]; then
    CACHE_BACKUP="\${APP_CACHE}.backup-\$(date +%Y%m%d-%H%M%S)"
    cp -p "\${APP_CACHE}" "\${CACHE_BACKUP}"
    echo "Previous GNUstep application registry preserved at \${CACHE_BACKUP}"
  fi
  [ -x "\${PREFIX}/bin/make_services" ] || {
    echo "GNUstep make_services is missing under \${PREFIX}/bin" >&2
    exit 1
  }
  "\${PREFIX}/bin/make_services" --quiet
  [ -s "\${APP_CACHE}" ] || {
    echo "GNUstep application registry was not generated: \${APP_CACHE}" >&2
    exit 1
  }
  touch "\${PREFIX}/${GNUSTEP_APP_CACHE_SENTINEL}"
else
  echo "GNUstep application registry already refreshed (sentinel present)"
fi

GWS_BIN=\$(find "\${PREFIX}" -type f -name GWorkspace -path '*GWorkspace.app*' | head -1)
if [ -n "\${GWS_BIN}" ] && [ -x "\${GWS_BIN}" ]; then
  echo "GNUstep + GWorkspace installed under \${PREFIX}"
  echo "GWorkspace: \${GWS_BIN}"
  echo "Launch the room with: sanctuary-enter sanctuary-gnustep"
else
  echo "Build finished but no executable GWorkspace.app found under \${PREFIX} — inspect stage 5." >&2
  exit 1
fi
INNER_EOF
)
sanctuary-exec "${SANCTUARY}" sh -c "${INNER_SCRIPT}"
# Source build: sanctuary-gnustep-build:1 ends here
