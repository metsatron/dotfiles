#!/usr/bin/env bash
# Telegram bridge
# Grant Telegram access to HelmCortex so files (invoices, attachments) can be attached directly without copying.

# [[file:../../../package-flatpak.org::*Telegram bridge][Telegram bridge:1]]
#!/usr/bin/env bash
set -euo pipefail

APP_ID="org.telegram.desktop"
HELMCORTEX_DIR="${HELMCORTEX_DIR:-$HOME/HelmCortex}"

echo "Granting $APP_ID access to $HELMCORTEX_DIR"
flatpak override --user --filesystem="$HELMCORTEX_DIR" "$APP_ID"

echo "Done."
# Telegram bridge:1 ends here
