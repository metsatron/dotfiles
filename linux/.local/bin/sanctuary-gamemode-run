#!/bin/bash
# [[file:../../../sanctuary-distrobox.org::*Sanctuary Launcher Scripts][Sanctuary Launcher Scripts:3]]
# Run a native sanctuary game through GameMode when the room profile provides it.
#
# This helper is deliberately for native Guix/emulator/port processes only.  Do
# not put it around sanctuary-flatpak-run or lutris-play: those launch through
# the host Flatpak session bus, while GameMode belongs to the sanctuary-private
# D-Bus session started by the desktop launcher.
set -euo pipefail

if (( $# == 0 )); then
  printf 'sanctuary-gamemode-run: a game command is required\n' >&2
  exit 2
fi

if command -v gamemoderun >/dev/null 2>&1; then
  # gamemoderun is a command wrapper, not an option parser; do not insert a
  # `--` delimiter because the Guix helper forwards its arguments directly.
  exec gamemoderun "$@"
fi

# Keep the launcher usable if a room is started before its shared profile has
# been rebuilt. The normal declared profiles contain GameMode, so this is a
# recovery path rather than the expected branch.
printf 'sanctuary-gamemode-run: gamemoderun unavailable; running without GameMode\n' >&2
exec "$@"
# Sanctuary Launcher Scripts:3 ends here
