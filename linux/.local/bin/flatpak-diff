#!/usr/bin/env bash
# Diff plan
# Shows what would be installed and what would be removed to match the manifest.

# [[file:../../../package-flatpak.org::*Diff plan][Diff plan:1]]
set -euo pipefail
MAN="${HOME}/DotCortex/linux/.flatpak/manifest/apps.ssv"
REL_MAN="${HOME}/DotCortex/linux/.flatpak/manifest/releases.ssv"
LOCAL_MAN="${HOME}/DotCortex/linux/.flatpak/manifest/local-derivatives.ssv"
REL_DIFF_HELPER="${HOME}/.local/bin/flatpak-release-diff"
[ -x "$REL_DIFF_HELPER" ] || REL_DIFF_HELPER="${HOME}/DotCortex/linux/.local/bin/flatpak-release-diff"
LOCAL_SYNC_HELPER="${HOME}/.local/bin/flatpak-local-derive"
[ -x "$LOCAL_SYNC_HELPER" ] || LOCAL_SYNC_HELPER="${HOME}/DotCortex/linux/.local/bin/flatpak-local-derive"

desired_repo_refs(){ awk '$0!~/^#/ && NF>=4{print $2, $3, $4}' "$MAN" | sort -u; }
desired_app_ids(){
  { awk '$0!~/^#/ && NF>=4{print $2}' "$MAN"
    [ -f "$REL_MAN" ] && awk '$0!~/^#/ && NF>=4{print $2}' "$REL_MAN" || true
    [ -f "$LOCAL_MAN" ] && awk '$0!~/^#/ && NF>=4{print $2}' "$LOCAL_MAN" || true; } \
  | sort -u
}
installed_refs(){
  { flatpak --user list --columns=application,branch | awk 'NF>=2{print $1, $2, "user"}'
    flatpak --system list --columns=application,branch | awk 'NF>=2{print $1, $2, "system"}'; } \
  | sort -u
}
installed_apps(){
  { flatpak --user list --app --columns=application | awk 'NF{print $1, "user"}'
    flatpak --system list --app --columns=application | awk 'NF{print $1, "system"}'; } \
  | sort -u
}

d="$(mktemp)"; r="$(mktemp)"; a="$(mktemp)"; ids="$(mktemp)"
trap 'rm -f "$d" "$r" "$a" "$ids"' EXIT
desired_repo_refs >"$d"; installed_refs >"$r"; installed_apps >"$a"; desired_app_ids >"$ids"

# desired minus installed -> to install
echo "[plan] to install:"
comm -23 "$d" "$r" | sed 's/^/  + /' || true

# installed applications minus desired -> to uninstall.  Implicit dependency
# runtimes are deliberately excluded from removal enforcement.
echo "[plan] to uninstall:"
while read -r id scope; do
  grep -Fxq "$id" "$ids" || printf '  - %s %s\n' "$id" "$scope"
done <"$a"

if [ -x "$REL_DIFF_HELPER" ]; then
  "$REL_DIFF_HELPER" || true
fi

if [ -x "$LOCAL_SYNC_HELPER" ]; then
  "$LOCAL_SYNC_HELPER" --check || true
fi
# Diff plan:1 ends here
