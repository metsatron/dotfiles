#!/bin/bash
# [[file:../../../sanctuary-redstone-9x-fvwm95.org::*FVWM95 configuration][FVWM95 configuration:6]]
# Emit an A-Z IceWM submenu for every deployed border theme.  Basenames are
# labels by design: ThemeDescription is free-form and may contain newlines or
# quotes that are unsafe in menu grammar.
set -euo pipefail
export LC_ALL=C

root="${HOME}/.icewm/themes"
icon="preferences-desktop-theme"

escape_menu() {
  local value="${1//\\/\\\\}"
  printf '%s' "${value//\"/\\\"}"
}

if [[ ! -d "${root}" ]]; then
  printf 'prog "(theme directory unavailable)" dialog-information true\n'
  exit 0
fi

mapfile -d '' themes < <(
  find "${root}" -mindepth 1 -maxdepth 1 -type d -print0 \
    | sort -z -f
)

bucket=""
count=0
for theme_dir in "${themes[@]}"; do
  [[ -f "${theme_dir}/default.theme" ]] || continue
  name="${theme_dir##*/}"
  case "${name}" in
    ""|"."|".."|*/*|*[!A-Za-z0-9._+\ -]*) continue ;;
  esac
  initial="${name:0:1}"
  initial="${initial^^}"
  [[ "${initial}" =~ [A-Z] ]] || initial="#"

  if [[ "${initial}" != "${bucket}" ]]; then
    [[ -z "${bucket}" ]] || printf '}\n'
    printf 'menu "%s" folder {\n' "${initial}"
    bucket="${initial}"
  fi
  label="$(escape_menu "${name}")"
  printf '  prog "%s" %s redstone-9x-border-apply "%s"\n' \
    "${label}" "${icon}" "${label}"
  count=$((count + 1))
done
[[ -z "${bucket}" ]] || printf '}\n'

if (( count == 0 )); then
  printf 'prog "(no deployed themes)" dialog-information true\n'
fi
# FVWM95 configuration:6 ends here
