#!/usr/bin/env bash
set -euo pipefail

QDBUS="${QDBUS:-qdbus6}"

run_plasma_script() {
  local script="$1"
  local pid
  pid="$(pgrep -x plasmashell | head -1 || true)"
  if [ -n "$pid" ] && [ -r "/proc/$pid/environ" ]; then
    bash -c 'mapfile -d "" -t E < "/proc/$1/environ"; shift; exec env -i "${E[@]}" "$@"' \
      _ "$pid" "$QDBUS" org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "$script"
  else
    "$QDBUS" org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "$script"
  fi
}

run_plasma_script '
var knownKeys = [
  "plugin", "wallpaperplugin", "wallpaperMode", "iconSize", "sortMode", "sortDesc",
  "sortDirsFirst", "arrangement", "alignment", "positions", "previews", "locked",
  "ItemsGeometries", "ItemGeometriesHorizontal", "ItemGeometriesVertical"
];
var out = [];
desktops().forEach(function (desktop) {
  var item = {
    id: desktop.id,
    screen: desktop.screen,
    activity: desktop.activity,
    plugin: desktop.readConfig("plugin"),
    rootKeys: {},
    keys: {}
  };
  ["plugin", "wallpaperplugin", "activityId", "formfactor", "immutability", "lastScreen", "location"].forEach(function (key) {
    item.rootKeys[key] = desktop.readConfig(key);
  });
  desktop.currentConfigGroup = ["General"];
  knownKeys.forEach(function (key) {
    try {
      item.keys[key] = desktop.readConfig(key);
    } catch (e) {
      item.keys[key] = "__ERROR__: " + e;
    }
  });
  out.push(item);
});
print(JSON.stringify(out, null, 2));
'
