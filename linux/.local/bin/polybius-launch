#!/usr/bin/env bash
# Polybius Station Four — Host Desktop Launcher
set -euo pipefail

# Ensure supervisor daemon is running if on kikin-kushi
if [ "$(hostname -s 2>/dev/null || hostname)" = "kikin-kushi" ]; then
  if ! /home/metsatron/.local/bin/polybius-ttyd --check >/dev/null 2>&1; then
    /home/metsatron/.local/bin/polybius-supervise --expected-host kikin-kushi >/dev/null 2>&1 &
    sleep 0.5
  fi
fi

# Launch console in terminal emulator
TARGET_CMD="/home/metsatron/.local/bin/polybius-bbs console"

if [ -z "${DISPLAY:-}" ]; then
  exec $TARGET_CMD "$@"
fi

if command -v kitty >/dev/null 2>&1; then
  exec kitty --title "Polybius Station Four" $TARGET_CMD "$@"
elif command -v x-terminal-emulator >/dev/null 2>&1; then
  exec x-terminal-emulator -T "Polybius Station Four" -e $TARGET_CMD "$@"
elif command -v xterm >/dev/null 2>&1; then
  exec xterm -title "Polybius Station Four" -e $TARGET_CMD "$@"
else
  exec $TARGET_CMD "$@"
fi
