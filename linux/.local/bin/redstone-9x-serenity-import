#!/bin/bash
# redstone-9x-serenity-import [serenity-checkout] [dotcortex-root]
# Generate the SerenityOS Desktop Scheme assets into the DotCortex source tree.
# Requires python3 + Pillow. See the Desktop Schemes section of
# sanctuary-redstone-9x-desktop.org for what is produced and why.
set -euo pipefail

SER="${1:?path to SerenityOS checkout (needs Base/res)}"
DC="${2:-${HOME}/DotCortex}"
RES="${SER}/Base/res"
[[ -d "${RES}/icons/16x16" ]] || { echo "not a SerenityOS checkout: ${RES}" >&2; exit 1; }

ICONS_OUT="${DC}/linux/.local/share/icons/Serenity95"
ICEWM_SRC="${DC}/linux/.icewm/themes/Windows-95"
ICEWM_OUT="${DC}/linux/.icewm/themes/Serenity"
GTK_SRC="${DC}/linux/.themes/Windows-95"
GTK_OUT="${DC}/linux/.themes/Serenity95"

python3 - "$RES" "$ICONS_OUT" <<'PYEOF'
import sys, os
from PIL import Image
res, out = sys.argv[1], sys.argv[2]

# serenity-name -> (category, xdg-name) ; sources tried at 16x16/ and 32x32/
MAP = {
    "filetype-folder":       ("places", "folder"),
    "filetype-folder-open":  ("places", "folder-open"),
    "home-directory":        ("places", "user-home"),
    "desktop":               ("places", "user-desktop"),
    "hard-disk":             ("devices", "drive-harddisk"),
    "network":               ("places", "network-workgroup"),
    "network-connected":     ("places", "network-connected"),
    "network-disconnected":  ("places", "network-disconnected"),
    "go-home":               ("actions", "go-home"),
    "app-file-manager":      ("apps", "system-file-manager"),
    "app-terminal":          ("apps", "utilities-terminal"),
    "app-text-editor":       ("apps", "accessories-text-editor"),
    "app-calculator":        ("apps", "accessories-calculator"),
    "app-browser":           ("apps", "web-browser"),
    "app-help":              ("apps", "help-browser"),
    "games":                 ("categories", "applications-games"),
    "development":           ("categories", "applications-development"),
    "graphics":              ("categories", "applications-graphics"),
    "internet":              ("categories", "applications-internet"),
    "office":                ("categories", "applications-office"),
    "multimedia":            ("categories", "applications-multimedia"),
    "utilities":             ("categories", "applications-utilities"),
    "settings":              ("categories", "preferences-desktop"),
    "filetype-image":        ("mimetypes", "image-x-generic"),
    "filetype-sound":        ("mimetypes", "audio-x-generic"),
    "filetype-video":        ("mimetypes", "video-x-generic"),
    "filetype-archive":      ("mimetypes", "package-x-generic"),
    "filetype-font":         ("mimetypes", "font-x-generic"),
    "filetype-executable":   ("mimetypes", "application-x-executable"),
    "filetype-text":         ("mimetypes", "text-x-generic"),
    "filetype-html":         ("mimetypes", "text-html"),
    "filetype-unknown":      ("mimetypes", "unknown"),
}
# Trash differs per size upstream: 16x16/trash-can.png, 32x32/recycle-bin.png.
SPECIAL_TRASH = ("places", "user-trash")

SIZES = (16, 22, 24, 32, 48)
count = 0

def emit(imgs, cat, name):
    # imgs: {16: Image|None, 32: Image|None}; nearest-neighbour resample for
    # the in-between/large sizes IceWM's graft wants (pixel-art rule).
    global count
    base32 = imgs.get(32) or (imgs.get(16).resize((32, 32), Image.NEAREST) if imgs.get(16) else None)
    base16 = imgs.get(16) or (imgs.get(32).resize((16, 16), Image.NEAREST) if imgs.get(32) else None)
    if base32 is None and base16 is None:
        return
    for size in SIZES:
        if size == 16:
            img = base16
        elif size == 32:
            img = base32
        else:
            src = base32 if base32 is not None else base16
            img = src.resize((size, size), Image.NEAREST)
        d = os.path.join(out, cat, str(size))
        os.makedirs(d, exist_ok=True)
        img.save(os.path.join(d, name + ".png"))
        count += 1

def load(rel):
    p = os.path.join(res, "icons", rel)
    return Image.open(p).convert("RGBA") if os.path.isfile(p) else None

dirs_used = set()
for ser, (cat, name) in sorted(MAP.items()):
    imgs = {16: load(f"16x16/{ser}.png"), 32: load(f"32x32/{ser}.png")}
    if imgs[16] is None and imgs[32] is None:
        print(f"  skip (absent upstream): {ser}")
        continue
    emit(imgs, cat, name)
    dirs_used.add(cat)

emit({16: load("16x16/trash-can.png"), 32: load("32x32/recycle-bin.png")}, *SPECIAL_TRASH)
dirs_used.add(SPECIAL_TRASH[0])

# index.theme — inherit everything not overlaid from Chicago95
ctx = {"apps": "Applications", "places": "Places", "devices": "Devices",
       "mimetypes": "MimeTypes", "actions": "Actions",
       "categories": "Categories", "status": "Status"}
dirlist = []
for cat in sorted(dirs_used):
    for size in SIZES:
        if os.path.isdir(os.path.join(out, cat, str(size))):
            dirlist.append(f"{cat}/{size}")
with open(os.path.join(out, "index.theme"), "w") as f:
    f.write("[Icon Theme]\nName=Serenity95\n")
    f.write("Comment=SerenityOS shell icons over the Chicago95 base (BSD-2-Clause upstream)\n")
    f.write("Inherits=Chicago95\n")
    f.write("Directories=" + ",".join(dirlist) + "\n\n")
    for d in dirlist:
        cat, size = d.split("/")
        f.write(f"[{d}]\nSize={size}\nContext={ctx[cat]}\nType=Fixed\n\n")
print(f"Serenity95 icon theme: {count} PNGs, {len(dirlist)} directories")
PYEOF

# ---- IceWM theme: Windows-95 clone, recoloured ----
rm -rf "${ICEWM_OUT}"
cp -r "${ICEWM_SRC}" "${ICEWM_OUT}"
THEME_FILE="${ICEWM_OUT}/default.theme"
# Menu personality FIRST (light tan selection, black text), then generic maps.
sed -i \
  -e 's|ColorActiveMenuItem="rgb:00/00/80"|ColorActiveMenuItem="rgb:D2/C0/B6"|' \
  -e 's|ColorActiveMenuItemText="rgb:ff/ff/ff"|ColorActiveMenuItemText="rgb:00/00/00"|' \
  -e 's|rgb:00/00/80|rgb:6E/22/09|g' \
  -e 's|rgb:C0/C0/C0|rgb:D4/D0/C8|gI' \
  -e 's|Windows 95|Serenity|g' \
  "${THEME_FILE}"

# ---- GTK theme: Windows-95 clone (gtk dirs only), recoloured ----
rm -rf "${GTK_OUT}"
mkdir -p "${GTK_OUT}"
for d in gtk-2.0 gtk-3.0 gtk-4.0; do
  [[ -d "${GTK_SRC}/${d}" ]] && cp -r "${GTK_SRC}/${d}" "${GTK_OUT}/${d}"
done
for f in index.theme LICENSE README.md; do
  [[ -f "${GTK_SRC}/${f}" ]] && cp "${GTK_SRC}/${f}" "${GTK_OUT}/${f}"
done
grep -rlZ . "${GTK_OUT}" --include='*.css' --include='*.rc' --include='gtkrc*' --include='index.theme' 2>/dev/null \
  | xargs -0 -r sed -i \
      -e 's|#000080|#84351a|g' -e 's|#00000080|#84351a|g' \
      -e 's|#c0c0c0|#d4d0c8|gI' \
      -e 's|#dfdfdf|#e8e4dc|gI' -e 's|#e0e0e0|#e8e4dc|gI' \
      -e 's|#008080|#505050|gI' \
      -e 's|Windows-95|Serenity95|g' -e 's|Windows 95|Serenity95|g'

# ---- Pixmap recolour (IceWM + GTK themes): exact-colour substitution ----
python3 - "${ICEWM_OUT}" "${GTK_OUT}" <<'PYEOF'
import sys, os
from PIL import Image
COLORMAP = {
    (0xC0, 0xC0, 0xC0): (0xD4, 0xD0, 0xC8),
    (0xDF, 0xDF, 0xDF): (0xE8, 0xE4, 0xDC),
    (0xE0, 0xE0, 0xE0): (0xE8, 0xE4, 0xDC),
    (0x00, 0x00, 0x80): (0x84, 0x35, 0x1A),
    (0x00, 0x80, 0x80): (0x50, 0x50, 0x50),
}
n = 0
for root in sys.argv[1:]:
    for dirpath, _, files in os.walk(root):
        for fn in files:
            if not fn.lower().endswith((".png", ".xpm")):
                continue
            if fn.lower().endswith(".xpm"):
                # xpm is text: colour-table substitution
                p = os.path.join(dirpath, fn)
                t = open(p, encoding="latin-1").read()
                for (r, g, b), (R, G, B) in COLORMAP.items():
                    t = t.replace(f"#{r:02x}{g:02x}{b:02x}", f"#{R:02x}{G:02x}{B:02x}")
                    t = t.replace(f"#{r:02X}{g:02X}{b:02X}", f"#{R:02X}{G:02X}{B:02X}")
                open(p, "w", encoding="latin-1").write(t)
                n += 1
                continue
            p = os.path.join(dirpath, fn)
            img = Image.open(p).convert("RGBA")
            px = img.load()
            changed = False
            for y in range(img.height):
                for x in range(img.width):
                    r, g, b, a = px[x, y]
                    m = COLORMAP.get((r, g, b))
                    if m:
                        px[x, y] = (*m, a)
                        changed = True
            if changed:
                img.save(p)
                n += 1
print(f"recoloured {n} pixmaps")
PYEOF

# ---- Font + wallpaper ----
mkdir -p "${DC}/linux/.config/redstone-9x/fonts" "${DC}/linux/.config/redstone-9x/wallpapers"
for ttf in "${RES}/fonts/SerenitySans-Regular.ttf" "${RES}/fonts"/Serenity*.ttf; do
  [[ -f "${ttf}" ]] && cp -f "${ttf}" "${DC}/linux/.config/redstone-9x/fonts/"
done
[[ -f "${RES}/wallpapers/sunset-retro.png" ]] \
  && cp -f "${RES}/wallpapers/sunset-retro.png" "${DC}/linux/.config/redstone-9x/wallpapers/serenity-sunset-retro.png"

echo "Serenity import complete:"
echo "  ${ICONS_OUT}"
echo "  ${ICEWM_OUT}"
echo "  ${GTK_OUT}"
echo "  fonts/ + wallpapers/ under linux/.config/redstone-9x/"
