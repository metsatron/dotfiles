#!/bin/bash
# redstone-9x-serenity-import [serenity-checkout] [dotcortex-root]
# Generate the SerenityOS Desktop Scheme assets into the DotCortex source tree.
# Requires python3 + Pillow. See the Desktop Schemes section of
# sanctuary-redstone-9x-desktop.org for what is produced and why.
set -euo pipefail

SER="${1:?path to SerenityOS checkout (needs Base/res)}"
DC="${2:-${HOME}/DotCortex}"
RES="${SER}/Base/res"
[[ -d "${RES}/icons/16x16" ]] || { echo "not a SerenityOS checkout: ${RES}" >&2; exit 1; }

ICONS_OUT="${DC}/linux/.local/share/icons/Serenity95"
ICEWM_SRC="${DC}/linux/.icewm/themes/Windows-95"
ICEWM_OUT="${DC}/linux/.icewm/themes/Serenity"
GTK_SRC="${DC}/linux/.themes/Windows-95"
GTK_OUT="${DC}/linux/.themes/Serenity95"

python3 - "$RES" "$ICONS_OUT" <<'PYEOF'
import sys, os
from PIL import Image
res, out = sys.argv[1], sys.argv[2]
# Full regeneration — never let a previous layout linger and haunt index.theme
# (the directory list is built by scanning what exists on disk).
import shutil as _shutil
if os.path.isdir(out):
    _shutil.rmtree(out)

# serenity-name -> [(category, xdg-name), ...] ; sources tried at 16x16/ and
# 32x32/. This is the CROSSWALK: every upstream icon that corresponds to a
# name the freedesktop world actually renders (GTK dialogs, toolbars, file
# managers, mimetype views) overwrites that name in the theme — the job is
# "Serenity art wherever Serenity has it", with Chicago95 inherited only for
# names upstream genuinely lacks.
MAP = {
    # --- places / shell ---
    "filetype-folder":       [("places", "folder"), ("mimetypes", "inode-directory")],
    "filetype-folder-open":  [("places", "folder-open")],
    "home-directory":        [("places", "user-home")],
    "desktop":               [("places", "user-desktop")],
    "hard-disk":             [("devices", "drive-harddisk")],
    "network":               [("places", "network-workgroup")],
    "network-connected":     [("places", "network-connected")],
    "network-disconnected":  [("places", "network-disconnected")],
    "downloads":             [("places", "folder-download")],
    "go-home":               [("actions", "go-home")],
    # --- dialogs (GTK message boxes) ---
    "msgbox-error":          [("status", "dialog-error")],
    "msgbox-warning":        [("status", "dialog-warning")],
    "msgbox-information":    [("status", "dialog-information")],
    "msgbox-question":       [("status", "dialog-question")],
    "key":                   [("status", "dialog-password")],
    # --- document / edit actions ---
    "new":                   [("actions", "document-new")],
    "open":                  [("actions", "document-open")],
    "open-recent":           [("actions", "document-open-recent")],
    "save":                  [("actions", "document-save")],
    "save-as":               [("actions", "document-save-as")],
    "file-export":           [("actions", "document-export")],
    "properties":            [("actions", "document-properties")],
    "delete":                [("actions", "edit-delete")],
    "edit-copy":             [("actions", "edit-copy")],
    "edit-cut":              [("actions", "edit-cut")],
    "paste":                 [("actions", "edit-paste")],
    "undo":                  [("actions", "edit-undo")],
    "redo":                  [("actions", "edit-redo")],
    "find":                  [("actions", "edit-find"), ("apps", "lxfind")],
    "select-all":            [("actions", "edit-select-all")],
    "clear-selection":       [("actions", "edit-clear")],
    "rename":                [("actions", "edit-rename")],
    "mkdir":                 [("actions", "folder-new")],
    "plus":                  [("actions", "list-add")],
    "minus":                 [("actions", "list-remove")],
    # --- navigation ---
    "go-back":               [("actions", "go-previous")],
    "go-forward":            [("actions", "go-next")],
    "go-up":                 [("actions", "go-up")],
    "go-down":               [("actions", "go-down")],
    "go-first":              [("actions", "go-first")],
    "go-last":               [("actions", "go-last")],
    "go-to":                 [("actions", "go-jump")],
    "reload":                [("actions", "view-refresh")],
    "fullscreen":            [("actions", "view-fullscreen")],
    "zoom-in":               [("actions", "zoom-in")],
    "zoom-out":              [("actions", "zoom-out")],
    "zoom-reset":            [("actions", "zoom-original")],
    "fit-image-to-view":     [("actions", "zoom-fit-best")],
    # --- media / process ---
    "play":                  [("actions", "media-playback-start")],
    "pause":                 [("actions", "media-playback-pause")],
    "stop":                  [("actions", "media-playback-stop")],
    "kill":                  [("actions", "process-stop")],
    # Exit... in the real SerenityOS System Menu renders 16x16/power.png (the
    # monitor-with-power-glyph), NOT 32x32/shutdown.png (a different,
    # larger-only computer glyph) — confirmed against the reference
    # screenshot 2026-07-19. The menu's actual icon name is "system-shut-down"
    # (hyphenated), which differs from the XDG-canonical "system-shutdown" —
    # map both so neither spelling falls back to Chicago95.
    "power":                 [("actions", "system-shutdown"), ("actions", "system-shut-down")],
    "search-engine":         [("actions", "system-search")],
    "gear":                  [("actions", "preferences-system"), ("actions", "emblem-system")],
    "new-tab":               [("actions", "tab-new")],
    "new-window":            [("actions", "window-new")],
    "window-close":          [("actions", "window-close")],
    "certificate":           [("mimetypes", "application-certificate")],
    # --- status ---
    "audio-volume-high":     [("status", "audio-volume-high")],
    "audio-volume-medium":   [("status", "audio-volume-medium")],
    "audio-volume-low":      [("status", "audio-volume-low")],
    "audio-volume-muted":    [("status", "audio-volume-muted")],
    # --- apps ---
    "app-file-manager":      [("apps", "system-file-manager")],
    "app-terminal":          [("apps", "utilities-terminal")],
    "app-text-editor":       [("apps", "accessories-text-editor")],
    "app-calculator":        [("apps", "accessories-calculator")],
    "app-character-map":     [("apps", "accessories-character-map")],
    "app-browser":           [("apps", "web-browser"), ("apps", "internet-web-browser")],
    # Run... in the real SerenityOS System Menu renders 16x16/app-run.png (a
    # program-window glyph with a cursor), NOT 16x16/run.png (a bare
    # right-pointing execute-triangle) — the previous crosswalk sourced the
    # Run-dialog icon from the wrong upstream file. Confirmed against the
    # reference screenshot 2026-07-19.
    "app-run":               [("actions", "system-run")],
    "app-help":              [("apps", "help-browser")],
    "app-mail":              [("apps", "internet-mail")],
    "app-screenshot":        [("apps", "applets-screenshooter")],
    "app-display-settings":  [("apps", "preferences-desktop-display"), ("devices", "video-display")],
    "app-keyboard-settings": [("apps", "preferences-desktop-keyboard")],
    "app-user-settings":     [("apps", "system-users")],
    # app-mouse also stands in for "Device Manager" (audio-card) — Serenity
    # ships no literal device-manager glyph; a mouse peripheral icon is the
    "app-mouse":             [("devices", "input-mouse")],
    # Device Manager (menu name audio-card, from the ice2k applet): Serenity's
    # x86 CPU-chip icon is the right "hardware" read — a mouse is not.
    "x86":                   [("devices", "audio-card")],
    "app-settings":          [("apps", "redstone-control-panel"), ("categories", "preferences-system")],
    # Paint menu entry (name applications-painting): their pixel-paint app art.
    "app-pixel-paint":       [("apps", "applications-painting")],
    "app-system-monitor":    [("apps", "utilities-system-monitor"), ("apps", "redstone-system")],
    "app-keyboard-mapper":   [("devices", "input-keyboard")],
    "app-video-player":      [("apps", "multimedia-video-player")],
    # --- categories (SystemMenu art) ---
    "games":                 [("categories", "applications-games")],
    "development":           [("categories", "applications-development")],
    "graphics":              [("categories", "applications-graphics")],
    "internet":              [("categories", "applications-internet")],
    "office":                [("categories", "applications-office")],
    "multimedia":            [("categories", "applications-multimedia")],
    # utilities.png also serves the Programs menu (name gnome-applications):
    # Mètsàtron's call 2026-07-19, replacing the earlier demos.png choice.
    "utilities":             [("categories", "applications-utilities"), ("apps", "gnome-applications")],
    # settings.png (the gear) covers every generic "preferences" spelling the
    # menu uses; control-center2 is the literal top-level "Settings" menu
    # icon name and would otherwise fall back to Chicago95 untouched.
    # preferences-system target intentionally lands in "actions" (not
    # "categories") and alphabetically AFTER "gear" in this dict, so
    # settings.png (the yellow control-panel gear, matching the reference
    # screenshot's Settings glyph) wins over gear's plainer grey cog for the
    # same XDG name — both are genuine Serenity art, this just picks the one
    # that matches what the real System Menu renders for "Settings".
    "settings":              [("categories", "preferences-desktop"), ("categories", "control-center2"), ("actions", "preferences-system")],
    # themes.png (stacked windows) is what the real System Menu renders for
    # "Themes" — the crosswalk previously only ripped it into the full-corpus
    # pass under its own upstream name, never onto the XDG name the IceWM
    # menu actually asks for (preferences-desktop-theme: Desktop Schemes,
    # Appearance, Qt Appearance, Snap Icons to Grid).
    "themes":                [("categories", "preferences-desktop-theme")],
    # No SerenityOS System Menu concept maps cleanly to Win95's "Programs"
    # flyout (Serenity's own menu lists categories directly, no umbrella
    # folder) — window.png (a plain app-window glyph) is the closest visual
    # stand-in. Judgment call, flagged per the task brief.
    "window":                [("categories", "gnome-applications")],
    # --- mimetypes ---
    "filetype-image":        [("mimetypes", "image-x-generic")],
    "filetype-sound":        [("mimetypes", "audio-x-generic")],
    "filetype-music":        [("mimetypes", "audio-x-mpeg")],
    "filetype-video":        [("mimetypes", "video-x-generic")],
    "filetype-archive":      [("mimetypes", "package-x-generic"), ("apps", "archive-manager")],
    "filetype-font":         [("mimetypes", "font-x-generic")],
    "filetype-truetype":     [("mimetypes", "application-x-font-ttf")],
    "filetype-executable":   [("mimetypes", "application-x-executable")],
    "filetype-text":         [("mimetypes", "text-x-generic")],
    "filetype-html":         [("mimetypes", "text-html")],
    "filetype-css":          [("mimetypes", "text-css")],
    "filetype-c":            [("mimetypes", "text-x-csrc")],
    "filetype-cplusplus":    [("mimetypes", "text-x-c++src")],
    "filetype-header":       [("mimetypes", "text-x-chdr")],
    "filetype-java":         [("mimetypes", "text-x-java")],
    "filetype-javascript":   [("mimetypes", "application-javascript")],
    "filetype-json":         [("mimetypes", "application-json")],
    "filetype-python":       [("mimetypes", "text-x-python")],
    "filetype-ruby":         [("mimetypes", "application-x-ruby")],
    "filetype-php":          [("mimetypes", "application-x-php")],
    "filetype-shell":        [("mimetypes", "application-x-shellscript")],
    "filetype-markdown":     [("mimetypes", "text-markdown")],
    "filetype-pdf":          [("mimetypes", "application-pdf")],
    "filetype-spreadsheet":  [("mimetypes", "x-office-spreadsheet")],
    "filetype-presenter":    [("mimetypes", "x-office-presentation")],
    "filetype-object":       [("mimetypes", "application-x-object")],
    "filetype-library":      [("mimetypes", "application-x-sharedlib")],
    "filetype-symlink":      [("mimetypes", "emblem-symbolic-link")],
    "filetype-unknown":      [("mimetypes", "unknown"), ("mimetypes", "application-octet-stream")],
}
# Trash differs per size upstream: 16x16/trash-can.png, 32x32/recycle-bin.png.
SPECIAL_TRASH = ("places", "user-trash")

SIZES = (16, 22, 24, 32, 48)
count = 0

def emit(imgs, cat, name):
    # imgs: {16: Image|None, 32: Image|None}; nearest-neighbour resample for
    # the in-between/large sizes IceWM's graft wants (pixel-art rule).
    global count
    base32 = imgs.get(32) or (imgs.get(16).resize((32, 32), Image.NEAREST) if imgs.get(16) else None)
    base16 = imgs.get(16) or (imgs.get(32).resize((16, 16), Image.NEAREST) if imgs.get(32) else None)
    if base32 is None and base16 is None:
        return
    for size in SIZES:
        if size == 16:
            img = base16
        elif size == 32:
            img = base32
        else:
            src = base32 if base32 is not None else base16
            img = src.resize((size, size), Image.NEAREST)
        d = os.path.join(out, cat, str(size))
        os.makedirs(d, exist_ok=True)
        img.save(os.path.join(d, name + ".png"))
        count += 1

def load(rel):
    p = os.path.join(res, "icons", rel)
    return Image.open(p).convert("RGBA") if os.path.isfile(p) else None

dirs_used = set()
mapped = 0
for ser, targets in sorted(MAP.items()):
    imgs = {16: load(f"16x16/{ser}.png"), 32: load(f"32x32/{ser}.png")}
    if imgs[16] is None and imgs[32] is None:
        print(f"  skip (absent upstream): {ser}")
        continue
    for cat, name in targets:
        emit(imgs, cat, name)
        dirs_used.add(cat)
        mapped += 1
print(f"crosswalk: {mapped} XDG names overwritten with Serenity art")

emit({16: load("16x16/trash-can.png"), 32: load("32x32/recycle-bin.png")}, *SPECIAL_TRASH)
dirs_used.add(SPECIAL_TRASH[0])

# Full-corpus rip: EVERY icon in the shared 16x16/ + 32x32/ sets, preserved
# under its upstream name IN ITS PROPER XDG CONTEXT — the upstream prefixes
# encode the category (app-* = Applications, filetype-* = MimeTypes), the
# shell names are Places, the SystemMenu category art is Categories, and the
# large remainder is toolbar/action glyphs (annotation-*, add-event, zoom-*).
# Icon lookup is name-based across all directories, so Icon=app-hex-editor
# resolves regardless; the categorisation is for correct modelling, not
# lookup. Mapped shell names exist twice (upstream name here, XDG name from
# MAP); files are tiny.
PLACES = {"hard-disk", "home-directory", "home-directory-open", "desktop",
          "network", "network-connected", "network-disconnected",
          "trash-can", "recycle-bin"}
CATEGORY_ART = {"games", "development", "graphics", "internet", "office",
                "settings", "multimedia", "utilities", "demos"}
def categorise(name):
    if name.startswith("app-"):
        return "apps"
    if name.startswith("filetype-"):
        return "mimetypes"
    if name in PLACES:
        return "places"
    if name in CATEGORY_ART:
        return "categories"
    if name.startswith("audio-volume") or name.startswith("network-"):
        return "status"
    return "actions"
names = set()
for d in ("16x16", "32x32"):
    p = os.path.join(res, "icons", d)
    for fn in os.listdir(p):
        if fn.endswith(".png"):
            names.add(fn[:-4])
from collections import Counter
tally = Counter()
for name in sorted(names):
    cat = categorise(name)
    emit({16: load(f"16x16/{name}.png"), 32: load(f"32x32/{name}.png")}, cat, name)
    dirs_used.add(cat)
    tally[cat] += 1
print("full corpus by context: " + ", ".join(f"{c}={n}" for c, n in tally.most_common()))

# index.theme — inherit everything not overlaid from Chicago95
ctx = {"apps": "Applications", "places": "Places", "devices": "Devices",
       "mimetypes": "MimeTypes", "actions": "Actions",
       "categories": "Categories", "status": "Status"}
dirlist = []
for cat in sorted(dirs_used):
    for size in SIZES:
        if os.path.isdir(os.path.join(out, cat, str(size))):
            dirlist.append(f"{cat}/{size}")
with open(os.path.join(out, "index.theme"), "w") as f:
    f.write("[Icon Theme]\nName=Serenity95\n")
    f.write("Comment=SerenityOS shell icons over the Chicago95 base (BSD-2-Clause upstream)\n")
    f.write("Inherits=Chicago95\n")
    f.write("Directories=" + ",".join(dirlist) + "\n\n")
    for d in dirlist:
        cat, size = d.split("/")
        f.write(f"[{d}]\nSize={size}\nContext={ctx[cat]}\nType=Fixed\n\n")
print(f"Serenity95 icon theme: {count} PNGs, {len(dirlist)} directories")
PYEOF

# ---- IceWM theme: gradient frames derived from the ice2k Win2k theme ----
# Mètsàtron 2026-07-19: the flat Windows-95 base gave Serenity no titlebar
# gradient; upstream Serenity renders #6e2209 -> #f4ca9e. The ice2k-built
# Win2kmod-xpm theme has real gradient frame pixmaps (XPM = palette-based,
# so the remap is a colour-TABLE rewrite): every blue-family palette entry
# maps by luminance onto the sienna->peach ramp. The Win2k theme is guest-
# generated (sanctuary-redstone-9x-ice2k-build), so fall back to the flat
# Windows-95 base when it is absent.
ICEWM_W2K="${ICEWM_W2K:-${HOME}/.local/share/dotcortex/guests/sanctuary-redstone-9x/home/.local/ice2k/icewm-themes/Win2kmod-xpm-og}"
if [[ -d "${ICEWM_W2K}" ]]; then
  ICEWM_BASE="${ICEWM_W2K}"
  echo "IceWM base: Win2kmod-xpm (gradient frames)"
else
  ICEWM_BASE="${ICEWM_SRC}"
  echo "IceWM base: Windows-95 (FLAT frames — run sanctuary-redstone-9x-ice2k-build for gradients)"
fi
# Minimal-touch derivation via the shared tool: exact titlebar-ramp remap
# onto the sienna->peach gradient, flat tan menu selection, buttons and
# bevels byte-identical to the tested base. Serenity drops the theme-private
# icons (scheme-aware graft owns lookups); Windows schemes keep theirs.
redstone-9x-icewm-derive "${ICEWM_BASE}" "${ICEWM_OUT}" '#6e2209' '#f4ca9e' \
  --flat-menusel '#d2c0b6' --drop-icons
THEME_FILE="${ICEWM_OUT}/default.theme"

# default.theme: explicit Serenity identity over the Win2k key set, then a
# generic blue->sienna pass for anything not explicitly pinned.
python3 - "${THEME_FILE}" <<'PYEOF'
import sys, re
p = sys.argv[1]
s = open(p, encoding='latin-1').read()
OVERRIDES = {
    "ColorActiveTitleBarText": "rgb:FF/FF/FF",
    "ColorNormalTitleBarText": "rgb:D5/D0/C7",
    "ColorActiveTitleBar": "rgb:6E/22/09",
    "ColorNormalTitleBar": "rgb:80/80/80",
    "ColorNormalMenu": "rgb:D4/D0/C8",
    "ColorActiveMenuItem": "rgb:D2/C0/B6",
    "ColorActiveMenuItemText": "rgb:00/00/00",
    "ColorNormalMenuItemText": "rgb:00/00/00",
    "ColorDisabledMenuItemText": "rgb:80/80/80",
    "ColorListBox": "rgb:FF/FF/FF",
    "ColorListBoxText": "rgb:00/00/00",
    "ColorListBoxSelection": "rgb:84/35/1A",
    "ColorListBoxSelectionText": "rgb:FF/FF/FF",
    "ColorInput": "rgb:FF/FF/FF",
    "ColorInputText": "rgb:00/00/00",
    "ColorToolTip": "rgb:FF/FF/E1",
    "ColorToolTipText": "rgb:00/00/00",
    "ColorActiveTaskBarApp": "rgb:EA/E8/E4",
}
for k, v in OVERRIDES.items():
    s, cnt = re.subn(rf'^{k}\s*=\s*"[^"]*"', f'{k}="{v}"', s, flags=re.M)
    if cnt == 0:
        s += f'\n{k}="{v}"'
def is_blue(r,g,b): return b > r + 24 and b > g + 16
def fix(m):
    val = m.group(2)
    hm = re.match(r'(?:rgb:)?#?([0-9a-fA-F]{2})/?([0-9a-fA-F]{2})/?([0-9a-fA-F]{2})$', val)
    if hm:
        r,g,b = (int(x,16) for x in hm.groups())
        if is_blue(r,g,b): return f'{m.group(1)}"rgb:84/35/1A"'
        if (r,g,b) == (0xC0,0xC0,0xC0): return f'{m.group(1)}"rgb:D4/D0/C8"'
    return m.group(0)
s = re.sub(r'^(\s*Color\w+\s*=\s*)"([^"]*)"', fix, s, flags=re.M)
s = s.replace("Windows 2000", "Serenity").replace("Win2k", "Serenity").replace("Windows 95", "Serenity")
open(p, 'w', encoding='latin-1').write(s)
print("default.theme serenity-ised")
PYEOF

# ---- SerenityOS taskbar identity (theme-level preference overrides) ----
# IceWM's precedence is preferences < THEME < prefoverride, so these live in
# the Serenity theme and the Windows 95 taskbar stays byte-authentic. The
# CPU meter comes back (disabled globally in ~/.icewm/preferences) wearing
# SerenityOS System-Monitor colours, and the tray gets its inset bevel.
if ! grep -q "SerenityOS taskbar identity" "${THEME_FILE}"; then
  cat >> "${THEME_FILE}" <<'THEOF'

# ---- SerenityOS taskbar identity (Mètsàtron 2026-07-19) ----
# COLOURS ONLY — themes cannot flip TaskBarShow* toggles (verified live);
# the layout switches ride the scheme's ICEWM_PREFS via scheme-apply's
# managed prefoverride block. System-Monitor greens on a black well.
ColorCPUStatusUser="rgb:3E/9A/06"
ColorCPUStatusSystem="rgb:CC/00/00"
ColorCPUStatusInterrupts="rgb:C4/A0/00"
ColorCPUStatusIoWait="rgb:34/65/A4"
ColorCPUStatusSoftIrq="rgb:75/50/7B"
ColorCPUStatusIdle="rgb:00/00/00"
# Clock: no bevel preference exists in IceWM 4.0 (per-applet bevels need an
# icewm patch — future item); a slightly darker well approximates the inset.
ColorClock="rgb:C9/C5/BD"
ColorClockText="rgb:00/00/00"
ColorMEMStatusUser="rgb:3E/9A/06"
ColorMEMStatusBuffers="rgb:C4/A0/00"
ColorMEMStatusCached="rgb:75/50/7B"
ColorMEMStatusFree="rgb:00/00/00"
ColorNetSend="rgb:CC/00/00"
ColorNetReceive="rgb:3E/9A/06"
ColorNetIdle="rgb:00/00/00"
THEOF
fi

# ---- IceWM theme private icons: serenity-ise where upstream has art ----
# IceWM resolves icon names from the THEME's own icons/ dir BEFORE
# ~/.icewm/icons (found live 2026-07-19: menu folders stayed Win95 because
# the cloned theme shipped its own folder_16x16/32x32). Overwrite each
# size-suffixed theme icon with the Serenity95 equivalent when one exists;
# names with no upstream art keep the Win95 original.
python3 - "${ICONS_OUT}" "${ICEWM_OUT}/icons" <<'PYEOF'
import sys, os, shutil
icons_root, theme_icons = sys.argv[1], sys.argv[2]
ALIAS = {
    "calculator": "accessories-calculator",
    "settings": "preferences-desktop",
    "document": "text-x-generic",
    "documents": "text-x-generic",
    "email": "internet-mail",
    "help": "help-browser",
    "key": "dialog-password",
    "logout": "system-shutdown",
    "reboot": "system-shutdown",
    "monitors": "preferences-desktop-display",
    "pref": "preferences-desktop",
    "programs": "gnome-applications",
    "save": "document-save",
    "terminal": "utilities-terminal",
    "themes": "preferences-desktop-theme",
    "webbrowser": "web-browser",
    # No good Serenity-art match: focus, lock, suspend, setscreen*, windows —
    # left as Win95 originals per the task brief ("names with no good match
    # stay Win95 — that is fine").
}
CATS = ("places", "apps", "actions", "devices", "mimetypes", "categories", "status")
if not os.path.isdir(theme_icons):
    sys.exit(0)
n = 0
for fn in sorted(os.listdir(theme_icons)):
    if "_" not in fn or not fn.endswith(".png"):
        continue
    name, sizepart = fn.rsplit("_", 1)
    size = sizepart.split("x")[0]
    target = ALIAS.get(name, name)
    for cat in CATS:
        src = os.path.join(icons_root, cat, size, target + ".png")
        if os.path.isfile(src):
            shutil.copyfile(src, os.path.join(theme_icons, fn))
            n += 1
            break
print(f"theme private icons serenity-ised: {n}")
PYEOF

# ---- GTK theme: Windows-95 clone (gtk dirs only), recoloured ----
rm -rf "${GTK_OUT}"
mkdir -p "${GTK_OUT}"
for d in gtk-2.0 gtk-3.0 gtk-4.0; do
  [[ -d "${GTK_SRC}/${d}" ]] && cp -r "${GTK_SRC}/${d}" "${GTK_OUT}/${d}"
done
for f in index.theme LICENSE README.md; do
  [[ -f "${GTK_SRC}/${f}" ]] && cp "${GTK_SRC}/${f}" "${GTK_OUT}/${f}"
done
# Text recolour covers BOTH notations: hex AND decimal rgb()/rgba() — a
# lone rgba(192, 192, 192, 0.999) survived the hex-only pass and put cold
# grey back on screen (found live 2026-07-19). \b guards keep the triples
# from matching inside longer numbers.
grep -rlZ . "${GTK_OUT}" --include='*.css' --include='*.rc' --include='gtkrc*' --include='index.theme' --include='*.svg' 2>/dev/null \
  | xargs -0 -r sed -i \
      -e 's|#000080|#84351a|g' -e 's|#00000080|#84351a|g' \
      -e 's|#c0c0c0|#d4d0c8|gI' \
      -e 's|#dfdfdf|#e8e4dc|gI' -e 's|#e0e0e0|#e8e4dc|gI' \
      -e 's|#008080|#505050|gI' \
      -e 's|\b192, 192, 192\b|212, 208, 200|g' -e 's|\b192,192,192\b|212,208,200|g' \
      -e 's|\b0, 0, 128\b|132, 53, 26|g' -e 's|\b0,0,128\b|132,53,26|g' \
      -e 's|\b223, 223, 223\b|232, 228, 220|g' -e 's|\b224, 224, 224\b|232, 228, 220|g' \
      -e 's|\b0, 128, 128\b|80, 80, 80|g' \
      -e 's|Windows-95|Serenity95|g' -e 's|Windows 95|Serenity95|g'

# ---- Pixmap recolour (IceWM + GTK themes): exact-colour substitution ----
python3 - "${ICEWM_OUT}" "${GTK_OUT}" <<'PYEOF'
import sys, os
from PIL import Image
COLORMAP = {
    (0xC0, 0xC0, 0xC0): (0xD4, 0xD0, 0xC8),
    # Taskbar/toolbar fill: the Windows-95 theme uses a THIRD grey (#c3c3c3,
    # +3 over chrome) in taskbarbg.xpm/toolbuttonbg.xpm — found live 2026-07-19
    # when the taskbar stayed cold grey. Keep the same +3 offset, warmed.
    (0xC3, 0xC3, 0xC3): (0xD7, 0xD3, 0xCB),
    (0xDF, 0xDF, 0xDF): (0xE8, 0xE4, 0xDC),
    (0xE0, 0xE0, 0xE0): (0xE8, 0xE4, 0xDC),
    (0x00, 0x00, 0x80): (0x84, 0x35, 0x1A),
    (0x00, 0x80, 0x80): (0x50, 0x50, 0x50),
}
n = 0
for root in sys.argv[1:]:
    for dirpath, _, files in os.walk(root):
        for fn in files:
            if not fn.lower().endswith((".png", ".xpm")):
                continue
            if fn.lower().endswith(".xpm"):
                # xpm is text: colour-table substitution
                p = os.path.join(dirpath, fn)
                t = open(p, encoding="latin-1").read()
                for (r, g, b), (R, G, B) in COLORMAP.items():
                    t = t.replace(f"#{r:02x}{g:02x}{b:02x}", f"#{R:02x}{G:02x}{B:02x}")
                    t = t.replace(f"#{r:02X}{g:02X}{b:02X}", f"#{R:02X}{G:02X}{B:02X}")
                open(p, "w", encoding="latin-1").write(t)
                n += 1
                continue
            p = os.path.join(dirpath, fn)
            img = Image.open(p).convert("RGBA")
            px = img.load()
            changed = False
            for y in range(img.height):
                for x in range(img.width):
                    r, g, b, a = px[x, y]
                    m = COLORMAP.get((r, g, b))
                    if m:
                        px[x, y] = (*m, a)
                        changed = True
            if changed:
                img.save(p)
                n += 1
print(f"recoloured {n} pixmaps")
PYEOF

