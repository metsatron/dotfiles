#!/bin/env bash
# [[file:../../../sanctuary-cortex.org::*T1700 Xpra runtime][T1700 Xpra runtime:4]]
set -euo pipefail

CONTAINER="${SANCTUARY_CORTEX_CONTAINER:-sanctuary-cortex}"
DISPLAY_NUM="${SANCTUARY_CORTEX_APPS_DISPLAY:-:100}"

case "${1:-}" in
  firedragon) APP_ID=org.garudalinux.firedragon ;;
  obsidian) APP_ID=md.obsidian.Obsidian ;;
  *) echo "Usage: sanctuary-cortex-app firedragon|obsidian [app arguments...]" >&2; exit 2 ;;
esac
shift

if ! xpra list 2>/dev/null | grep -Fq "$DISPLAY_NUM"; then
  "$HOME/.local/bin/sanctuary-cortex-xpra" start-apps
fi

XAUTHORITY_FILE="${SANCTUARY_CORTEX_XAUTHORITY:-${XAUTHORITY:-$HOME/.Xauthority}}"
[[ -r "$XAUTHORITY_FILE" ]] || {
  echo "sanctuary-cortex-app: Xauthority file is unavailable: $XAUTHORITY_FILE" >&2
  exit 1
}
GUEST_ENV=(env "DISPLAY=$DISPLAY_NUM" "XAUTHORITY=$XAUTHORITY_FILE")

exec distrobox enter "$CONTAINER" -- "${GUEST_ENV[@]}" \
  bash -lc '
    set -e
    for profile in \
      "$HOME/.guix-extra-profiles/desktop-common/desktop-common" \
      "$HOME/.guix-extra-profiles/sanctuary-cortex/sanctuary-cortex"; do
      [ -r "$profile/etc/profile" ] || continue
      export GUIX_PROFILE="$profile"
      . "$profile/etc/profile"
    done
    unset GUIX_PROFILE
    exec dbus-run-session -- sanctuary-flatpak-run "$1" -- "${@:2}"
  ' _ "$APP_ID" "$@"
# T1700 Xpra runtime:4 ends here
