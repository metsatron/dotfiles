#!/usr/bin/env bash
# Desktop launchers

# [[file:../../../package-flatpak.org::*Desktop launchers][Desktop launchers:1]]
#!/usr/bin/env bash
set -euo pipefail

# Preserve the original X230 launcher contract: the client uses its local
# FireDragon Flatpak, while the browser profile is read from the target
# machine's NFS-mounted home.  The transport is provisioned by the machine's
# NFS/autofs configuration; this launcher does not silently substitute a
# sanctuary or a local profile.
MOUNT_POINT="${FIREDRAGON_T1700_MOUNT:-$HOME/mnt/t1700}"
PROFILE_PATH="${FIREDRAGON_T1700_PROFILE:-$MOUNT_POINT/HelmCortex/NEXUS/sanctuaries/sanctuary-cortex/firefox-profile}"

if ! mountpoint -q "$MOUNT_POINT"; then
    echo "T1700 is not mounted at $MOUNT_POINT" >&2
    echo "Mount the T1700 home over NFS before launching FireDragon." >&2
    exit 1
fi

if ! stat -L -- "$PROFILE_PATH" >/dev/null 2>&1 || \
   [ ! -f "$PROFILE_PATH/prefs.js" ] || [ ! -f "$PROFILE_PATH/places.sqlite" ]; then
    echo "FireDragon profile is not accessible at $PROFILE_PATH" >&2
    echo "Check the T1700 HelmCortex export and the NFS mount." >&2
    exit 1
fi

args=(--profile "$PROFILE_PATH")
if [ "$#" -gt 0 ] && [ -n "${1:-}" ]; then
    args+=(--new-tab "$1")
fi

exec /usr/bin/flatpak run \
    --branch=stable \
    --arch=x86_64 \
    --command=/app/lib/firedragon/firedragon \
    org.garudalinux.firedragon \
    "${args[@]}"
# Desktop launchers:1 ends here
