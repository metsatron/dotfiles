#!/bin/bash
# redstone-9x-scheme-apply [--boot] <scheme-id>
# Swap every appearance layer to the named Desktop Scheme.
# --boot: file effects only (no WM restart, no daemon HUPs, no sounds) —
#         called by the launcher after projection, host-side with
#         HOME=<guest-home>, to re-assert the active scheme.
# Full mode (from the Desktop Schemes menu, in-guest): also restarts IceWM,
# HUPs xsettingsd, reconfigures pcmanfm, and plays the notify sound.
set -uo pipefail

BOOT=0
if [[ "${1:-}" == "--boot" ]]; then BOOT=1; shift; fi
SCHEME_ID="${1:?usage: redstone-9x-scheme-apply [--boot] <scheme-id>}"

CFG="${HOME}/.config/redstone-9x"
SCHEME_FILE="${CFG}/schemes/${SCHEME_ID}.scheme"
if [[ ! -f "${SCHEME_FILE}" ]]; then
  echo "scheme not found: ${SCHEME_FILE}" >&2
  ls "${CFG}/schemes/" 2>/dev/null >&2
  exit 1
fi
# shellcheck disable=SC1090
. "${SCHEME_FILE}"

: "${ICEWM_THEME:?}" "${GTK_THEME:?}" "${ICON_THEME:?}" "${CURSOR_THEME:?}"
: "${CURSOR_SIZE:=24}" "${GTK_FONT:=Sans 8}" "${DESKTOP_BG:=#008080}"
: "${SEL_BG:=#000080}" "${SEL_FG:=#ffffff}" "${QT6CT_COLORS:=win95.conf}"
: "${SOUND_SCHEME:=${SCHEME_ID}}" "${QT_STYLE:=Windows}"
: "${DESKTOP_FG:=#ffffff}" "${FOX_BASE:=#c0c0c0}"

# A host-projected private icon overlay may replace literal NeXTSTEP only for
# the real NeXTSTEP/OpenStep scheme lane. Rhapsody representatives (including
# the NeXTSTEP-geometry/Rhapsody-palette representative), GNUstep, and every
# other dynasty ignore the marker even if they use related artwork. Fail
# closed: marker, managed link, Name, and exact Inherits=NeXTSTEP must agree.
if [[ "${ICON_THEME}" == "NeXTSTEP" \
   && "${SCHEME_ID}" == nextstep-nextstep-* \
   && "${SCHEME_ID}" != *rhapsody* ]]; then
  _private_icon_marker="${CFG}/private-icon-theme"
  _private_icon_theme="$(sed -n '1p' "${_private_icon_marker}" 2>/dev/null || true)"
  _private_icon_link="${HOME}/.local/share/icons/${_private_icon_theme}"
  _private_icon_index="${_private_icon_link}/index.theme"
  if [[ "${_private_icon_theme}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ \
     && "${_private_icon_theme}" == "NeXTSTEP-Complete" \
     && -L "${_private_icon_link}" \
     && -f "${_private_icon_index}" \
     && "$(sed -n 's/^[[:space:]]*Name[[:space:]]*=[[:space:]]*//p' "${_private_icon_index}" | head -1)" == "${_private_icon_theme}" \
     && "$(sed -n 's/^[[:space:]]*Inherits[[:space:]]*=[[:space:]]*//p' "${_private_icon_index}" | head -1)" == "NeXTSTEP" ]]; then
    ICON_THEME="${_private_icon_theme}"
  else
    ICON_THEME="NeXTSTEP"
  fi
fi
# Previously generated CDE palette schemes predate the label keys. Keep those
# deployed files usable until their next normal converter run; the converter
# now emits these same values directly.
if [[ "${SCHEME_ID}" == cdep-* && -z "${DESKTOP_ICON_LABEL_MODE:-}" ]]; then
  desktop_hex="${DESKTOP_BG#\#}"
  desktop_luma=$((16#${desktop_hex:0:2} * 299
                + 16#${desktop_hex:2:2} * 587
                + 16#${desktop_hex:4:2} * 114))
  DESKTOP_ICON_LABEL_MODE="box"
  DESKTOP_ICON_LABEL_BACKGROUND="${DESKTOP_BG}"
  if (( desktop_luma >= 128000 )); then
    DESKTOP_ICON_LABEL_FOREGROUND="#000000"
  else
    DESKTOP_ICON_LABEL_FOREGROUND="#ffffff"
  fi
fi
: "${DESKTOP_ICON_LABEL_MODE:=shadow}"
: "${DESKTOP_ICON_LABEL_FOREGROUND:=${DESKTOP_FG}}"
: "${DESKTOP_ICON_LABEL_BACKGROUND:=${DESKTOP_BG}}"
: "${DESKTOP_ICON_LABEL_SHADOW_COLOR:=#000000}"
: "${DESKTOP_ICON_LABEL_SHADOW_X:=1}" "${DESKTOP_ICON_LABEL_SHADOW_Y:=1}"
: "${DESKTOP_ICON_LABEL_PADDING_X:=2}" "${DESKTOP_ICON_LABEL_PADDING_Y:=1}"
case "${DESKTOP_ICON_LABEL_MODE}" in
  shadow|box|plain) ;;
  *)
    echo "invalid desktop icon label mode: ${DESKTOP_ICON_LABEL_MODE}" >&2
    DESKTOP_ICON_LABEL_MODE="shadow"
    ;;
esac

# Keep the shared vanilla Emacs profile in the same scheme-following family as
# IceWM, GTK, Qt, FOX, Wine, Audacious, sound, and the desktop.  A scheme may
# set EMACS_THEME explicitly; otherwise the bridge maps the visual dynasty to a
# built-in Emacs theme.  The fixed display key is important for --boot, which
# runs host-side with HOME=<guest-home> before the Xephyr DISPLAY exists.
classic_emacs_theme_apply="${HOME}/.local/bin/classic-emacs-theme-apply"
if [[ -x "${classic_emacs_theme_apply}" ]]; then
  "${classic_emacs_theme_apply}" "${SCHEME_ID}" "${EMACS_THEME:-}" "93" \
    || echo "redstone-9x-scheme-apply: classic Emacs theme bridge failed" >&2
fi

# --- Shared desktop-label contrast -----------------------------------------
# PCManFM and XOSD must never resolve their text colours independently.
# redstone-buildstamp owns the backdrop sampler, so ask its non-rendering
# command for one fresh pair, then use that pair for both consumers.  The
# resolver also validates the declarative contract: both values are literal
# #rrggbb colours or both are "auto"; mixed/invalid pairs fail loudly.
_label_resolver="${HOME}/.local/bin/redstone-buildstamp"
if [[ ! -x "${_label_resolver}" ]]; then
  echo "redstone-9x-scheme-apply: shared label resolver missing: ${_label_resolver}" >&2
  exit 1
fi
if ! _label_pair="$("${_label_resolver}" label-colors "${SCHEME_ID}")"; then
  echo "redstone-9x-scheme-apply: could not resolve shared desktop-label colours" >&2
  exit 1
fi
read -r DESKTOP_ICON_LABEL_FOREGROUND DESKTOP_ICON_LABEL_SHADOW_COLOR _label_extra \
  <<< "${_label_pair}"
if [[ -n "${_label_extra:-}" \
   || ! "${DESKTOP_ICON_LABEL_FOREGROUND}" =~ ^#[0-9A-Fa-f]{6}$ \
   || ! "${DESKTOP_ICON_LABEL_SHADOW_COLOR}" =~ ^#[0-9A-Fa-f]{6}$ ]]; then
  echo "redstone-9x-scheme-apply: invalid resolved desktop-label pair: ${_label_pair}" >&2
  exit 1
fi

# --- Default terminal theme module (the sole switchable terminal layer) ---
# Fixed CMD/PowerShell/Bash/Zsh/plain-URxvt/XTerm launchers do not read this.
# redstone-9x-zsh --default-window sources it once for URxvt, then marks the
# child Zsh so the sanctuary zshrc sources the same module for prompt/modeline.
# Individual .scheme files may override any REDSTONE_TERM_* value later; these
# defaults derive a readable terminal palette from each scheme's own menu and
# selection colours, while the font family follows its visual dynasty.
: "${REDSTONE_TERM_BG:=${FOX_MENU_BG:-${DESKTOP_BG}}}"
: "${REDSTONE_TERM_FG:=${FOX_MENU_FG:-${SEL_FG}}}"
: "${REDSTONE_TERM_ACCENT:=${FOX_BASE:-${SEL_BG}}}"

# --- Readability guard -------------------------------------------------------
# The old guard here compared colours for *exact string equality* and rewrote the
# accent only when it was byte-identical to the background.  That caught exactly
# one scheme (BeOS, which really does alias FOX_BASE to FOX_MENU_BG) and silently
# passed everything else, because the failure mode is almost never equality — it
# is FOX_BASE and FOX_MENU_BG being two different tones of the same light grey or
# beige.  Measured across all 104 tangled schemes, 86 fell below the WCAG AA 4.5:1
# ratio on foreground or accent, and 79 of those put the prompt accent under 3:1
# against its own background — cde-default at 1.05:1, serenity at 1.14:1, the whole
# BeOS family at 2.02:1.  That is the "not all the colours are ideally visible"
# report, and equality could never have found it.
#
# So measure instead of compare.  _term_contrast returns the real WCAG ratio, and
# _term_readable blends a colour toward black or white — away from whichever end
# the background sits at — in small steps until it clears the threshold, keeping
# the scheme's hue rather than flattening every terminal to black-on-white.  A
# scheme that wants its own unmodified palette can set REDSTONE_TERM_CONTRAST_MIN=0.
#
# _term_contrast rounds to two decimals, which makes the threshold a tolerance
# rather than a cliff. That is deliberate: serenity-redmond-zehn puts pure white
# on #0078D7 for 4.4989:1, and bending authentic Windows-10 white off-white to
# recover 0.0011 of a ratio would cost more than it buys. Anything that misses by
# a perceptible margin still gets corrected.
: "${REDSTONE_TERM_CONTRAST_MIN:=4.5}"

# Both helpers are deliberately POSIX awk.  strtonum() is a gawk extension: the
# guest carries gawk 5.3 and would have run it, but the host runs mawk, where it
# fails at *run time* with "function strtonum never defined" while still exiting
# cleanly and emitting empty colours — a silent miscolour that a syntax check and
# a successful tangle both wave through.  Parsing the hex by hand costs four lines
# and makes a host-side test a valid statement about guest behaviour.
_term_awk_lib='
    function hx(s,   i,c,d,n){
      n=0; s=tolower(s)
      for(i=1;i<=length(s);i++){
        c=substr(s,i,1); d=index("0123456789abcdef",c)-1
        if(d<0) return -1
        n=n*16+d
      }
      return n
    }
    function chan(v){v/=255; return (v<=0.03928)? v/12.92 : ((v+0.055)/1.055)^2.4}
    function norm(c){
      gsub(/^#/,"",c)
      if (length(c)==3) c=substr(c,1,1) substr(c,1,1) substr(c,2,1) substr(c,2,1) substr(c,3,1) substr(c,3,1)
      return (length(c)==6)? c : ""
    }
    function lum(c,  n,r,g,b){
      n=norm(c); if (n=="") return -1
      r=hx(substr(n,1,2)); g=hx(substr(n,3,2)); b=hx(substr(n,5,2))
      if (r<0||g<0||b<0) return -1
      return 0.2126*chan(r) + 0.7152*chan(g) + 0.0722*chan(b)
    }
    function ratio(l1,l2,  hi,lo){hi=(l1>l2)?l1:l2; lo=(l1>l2)?l2:l1; return (hi+0.05)/(lo+0.05)}
'

_term_contrast() {
  # _term_contrast <hex-a> <hex-b> -> WCAG ratio (1.00–21.00), or 0 if unparseable
  awk -v a="${1}" -v b="${2}" "${_term_awk_lib}"'
    BEGIN{
      la=lum(a); lb=lum(b)
      if (la<0 || lb<0) { print "0"; exit }
      printf "%.2f", ratio(la,lb)
    }'
}

_term_readable() {
  # _term_readable <hex-fg> <hex-bg> <min-ratio> -> hex that clears min against bg
  #
  # Try BOTH directions rather than guessing one from a lightness threshold.  An
  # earlier cut here picked the target with `(lbg > 0.35) ? black : white`, which
  # is wrong for every mid-tone background: on serenity-nord's #7E9DBC it chose
  # white and reached 2.82:1, where black reaches 7.4:1 — and when the colour was
  # already white it blended white toward white and changed nothing at all.  That
  # single constant accounted for all 18 schemes still failing after the first
  # pass.  Whichever direction clears the threshold with the smaller blend wins,
  # so the scheme's own hue is disturbed as little as the target allows.
  awk -v fg="${1}" -v bg="${2}" -v min="${3}" "${_term_awk_lib}"'
    BEGIN{
      lbg=lum(bg); n=norm(fg)
      if (lum(fg)<0 || lbg<0) { print fg; exit }
      r=hx(substr(n,1,2)); g=hx(substr(n,3,2)); b=hx(substr(n,5,2))
      best=""; bestt=99; bestratio=-1; bestfallback=""
      split("0 255", tgts, " ")
      for (k=1; k<=2; k++) {
        tgt=tgts[k]+0
        for (t=0; t<=1.0001; t+=0.02) {
          nr=r+(tgt-r)*t; ng=g+(tgt-g)*t; nb=b+(tgt-b)*t
          c=sprintf("#%02x%02x%02x", int(nr+0.5), int(ng+0.5), int(nb+0.5))
          rr=ratio(lum(c), lbg)
          if (rr>bestratio) { bestratio=rr; bestfallback=c }
          if (rr >= min) { if (t < bestt) { bestt=t; best=c } ; break }
        }
      }
      # If neither direction can reach the threshold (a background whose luminance
      # sits too near the middle), emit the most legible colour available rather
      # than an arbitrary endpoint.
      print (best!="") ? best : bestfallback
    }'
}

if [[ "${REDSTONE_TERM_CONTRAST_MIN}" != "0" ]]; then
  # Foreground first — the cursor inherits it, so it must be settled before that.
  if awk -v a="$(_term_contrast "${REDSTONE_TERM_FG}" "${REDSTONE_TERM_BG}")" -v b="${REDSTONE_TERM_CONTRAST_MIN}" \
       'BEGIN{exit !(a+0 < b+0)}'; then
    _cand="${SEL_FG:-${REDSTONE_TERM_FG}}"
    if awk -v a="$(_term_contrast "${_cand}" "${REDSTONE_TERM_BG}")" -v b="${REDSTONE_TERM_CONTRAST_MIN}" \
         'BEGIN{exit !(a+0 >= b+0)}'; then
      REDSTONE_TERM_FG="${_cand}"
    else
      REDSTONE_TERM_FG="$(_term_readable "${REDSTONE_TERM_FG}" "${REDSTONE_TERM_BG}" "${REDSTONE_TERM_CONTRAST_MIN}")"
    fi
  fi
  # Accent next.  SEL_BG is tried first because it is the scheme's own emphasis
  # tone and usually reads as intended; only if that also fails do we bend it.
  if awk -v a="$(_term_contrast "${REDSTONE_TERM_ACCENT}" "${REDSTONE_TERM_BG}")" -v b="${REDSTONE_TERM_CONTRAST_MIN}" \
       'BEGIN{exit !(a+0 < b+0)}'; then
    if awk -v a="$(_term_contrast "${SEL_BG:-#000000}" "${REDSTONE_TERM_BG}")" -v b="${REDSTONE_TERM_CONTRAST_MIN}" \
         'BEGIN{exit !(a+0 >= b+0)}'; then
      REDSTONE_TERM_ACCENT="${SEL_BG}"
    else
      REDSTONE_TERM_ACCENT="$(_term_readable "${REDSTONE_TERM_ACCENT}" "${REDSTONE_TERM_BG}" "${REDSTONE_TERM_CONTRAST_MIN}")"
    fi
  fi
fi

: "${REDSTONE_TERM_CURSOR:=${REDSTONE_TERM_FG}}"

# --- ANSI palette (colour0–15) for the default terminal --------------------
# Fixing background/foreground/accent only got the *prompt* legible. Everything
# else a shell prints — ls, git, grep, zsh completion, diff — draws from the
# terminal's sixteen ANSI slots, and URxvt was never told what those should be,
# so it used its built-in defaults. Those defaults assume a dark background:
# on a light scheme like serenity (#d2c0b6) or the BeOS greys, ANSI yellow
# (#cdcd00) and bright yellow (#ffff00) are effectively invisible. That is the
# "some colours are still hard to see" that survived the first pass.
#
# The base row is the fleet's own canon — style.org's lc/base16
# 'dreamweaver-cc2017, the palette already behind kitty's colour0-15, Rofi,
# Emacs, nvim, ranger, yazi and superfile — mapped onto ANSI in the standard
# base16 order. Semantics stay put (red is red, green is green) instead of being
# recoloured per scheme, which would make error output change meaning between
# themes. Each slot is then pushed through the same readability guard as the
# foreground, so a light scheme darkens the row and a dark scheme lightens it.
# On a light background that legitimately flips "white" to a dark tone — which
# is what every light terminal theme does, Solarized Light included.
if [[ "${REDSTONE_TERM_CONTRAST_MIN}" != "0" ]]; then
  _ansi_src=(
    "#1f1f1f" "#dc322f" "#4caf50" "#b58900" "#268bd2" "#a681d6" "#15b8cf" "#d2d4d4"
    "#6a6a6a" "#dc322f" "#4caf50" "#b58900" "#268bd2" "#a681d6" "#15b8cf" "#ffffff"
  )
  _ansi_out=()
  for _c in "${_ansi_src[@]}"; do
    if awk -v a="$(_term_contrast "${_c}" "${REDSTONE_TERM_BG}")" -v b="${REDSTONE_TERM_CONTRAST_MIN}" \
         'BEGIN{exit !(a+0 < b+0)}'; then
      _ansi_out+=("$(_term_readable "${_c}" "${REDSTONE_TERM_BG}" "${REDSTONE_TERM_CONTRAST_MIN}")")
    else
      _ansi_out+=("${_c}")
    fi
  done
  REDSTONE_TERM_ANSI="${_ansi_out[*]}"
else
  REDSTONE_TERM_ANSI=""
fi
case "${SCHEME_ID}" in
  cde-*|cdep-*)
    : "${REDSTONE_TERM_FONT:=xft:DejaVu Sans Mono:size=10:antialias=true,xft:monospace:size=10:antialias=true}"
    ;;
  beos-*|haiku)
    : "${REDSTONE_TERM_FONT:=xft:PxPlus IBM VGA 9x14:size=14:antialias=true,xft:monospace:size=14:antialias=true}"
    ;;
  serenity*)
    : "${REDSTONE_TERM_FONT:=xft:DejaVu Sans Mono:size=11:antialias=true,xft:monospace:size=11:antialias=true}"
    ;;
  *)
    : "${REDSTONE_TERM_FONT:=xft:Cascadia Mono:size=11:antialias=true,xft:Consolas:size=11:antialias=true,xft:monospace:size=11:antialias=true}"
    ;;
esac

mkdir -p "${CFG}"
_label_state="${CFG}/desktop-label-colors.conf"
_label_state_tmp="${_label_state}.tmp.$$"
{
  printf 'LABEL_STATE_SCHEME=%s\n' "${SCHEME_ID}"
  printf 'DESKTOP_LABEL_FOREGROUND=%s\n' "${DESKTOP_ICON_LABEL_FOREGROUND}"
  printf 'DESKTOP_LABEL_SHADOW=%s\n' "${DESKTOP_ICON_LABEL_SHADOW_COLOR}"
} > "${_label_state_tmp}"
chmod 0644 "${_label_state_tmp}"
mv -f "${_label_state_tmp}" "${_label_state}"

_terminal_module="${CFG}/terminal-theme.zsh"
_terminal_module_tmp="${_terminal_module}.tmp.$$"
{
  echo '# Redstone 9X default-terminal theme — generated by redstone-9x-scheme-apply.'
  echo '# Source this module only from redstone-9x-zsh --default-window.'
  printf 'REDSTONE_TERM_SCHEME=%q\n' "${SCHEME_TITLE:-${SCHEME_ID}}"
  printf 'REDSTONE_TERM_BG=%q\n' "${REDSTONE_TERM_BG}"
  printf 'REDSTONE_TERM_FG=%q\n' "${REDSTONE_TERM_FG}"
  printf 'REDSTONE_TERM_ACCENT=%q\n' "${REDSTONE_TERM_ACCENT}"
  printf 'REDSTONE_TERM_CURSOR=%q\n' "${REDSTONE_TERM_CURSOR}"
  printf 'REDSTONE_TERM_FONT=%q\n' "${REDSTONE_TERM_FONT}"
  # Space-separated rather than a shell array: this module is sourced by the
  # launcher's /bin/sh and by the child Zsh, and array syntax is not portable
  # between them. Hex colours contain no whitespace or glob characters, so a
  # plain word-split at the consumer is safe.
  printf 'REDSTONE_TERM_ANSI=%q\n' "${REDSTONE_TERM_ANSI}"
  cat <<'TERMINAL_THEME_EOF'
REDSTONE_TERM_PROMPT="%F{${REDSTONE_TERM_ACCENT}}ZSH%f %F{${REDSTONE_TERM_FG}}%1/%f> "
REDSTONE_TERM_MODELINE="%F{${REDSTONE_TERM_ACCENT}}[${REDSTONE_TERM_SCHEME}]%f"
if [[ -n "${ZSH_VERSION:-}" ]]; then
  PROMPT="${REDSTONE_TERM_PROMPT}"
  RPROMPT="${REDSTONE_TERM_MODELINE}"
fi
TERMINAL_THEME_EOF
} > "${_terminal_module_tmp}"
chmod 0644 "${_terminal_module_tmp}"
mv -f "${_terminal_module_tmp}" "${_terminal_module}"

# --- Re-theme already-open default terminals, live -------------------------
# The module above only reaches terminals opened *after* a scheme switch, so a
# window that was already up kept the previous scheme's colours until it was
# closed and reopened. URxvt accepts OSC escapes at runtime, and writing them to
# a terminal's pts slave is exactly how that terminal receives output — so the
# repaint costs nothing but an escape string per window.
#
# Targeting is deliberately narrow. Only the scheme-aware default terminal is
# touched, identified by the -name redstone-zsh-default it is launched with. The
# fixed-identity terminals are period costumes with palettes of their own and
# must never be repainted: CMD, the CMD-themed Bash, the PowerShell frame, the
# PowerShell-themed Zsh, plain URxvt, XTerm and dosemu2 all keep their colours
# through every theme change. Matching on that one resource name is what keeps
# them out — a broader match on "urxvt" would recolour the lot.
_retheme_osc() {
  local dev="$1" i=0 _c
  # 10/11/12 = foreground / background / cursor; 4;N = ANSI slot N.
  printf '\033]10;%s\007\033]11;%s\007\033]12;%s\007' \
    "${REDSTONE_TERM_FG}" "${REDSTONE_TERM_BG}" "${REDSTONE_TERM_CURSOR}" > "${dev}" 2>/dev/null || return 1
  for _c in ${REDSTONE_TERM_ANSI}; do
    printf '\033]4;%d;%s\007' "${i}" "${_c}" > "${dev}" 2>/dev/null || return 1
    i=$((i + 1))
  done
  return 0
}

_retheme_count=0
while read -r _pid; do
  [[ -n "${_pid}" ]] || continue
  # The urxvt process owns the pty; its descendants are what hold it open as
  # their controlling terminal, which is the device that must be written to.
  while read -r _tty; do
    [[ -n "${_tty}" && "${_tty}" != "?" ]] || continue
    _dev="/dev/${_tty}"
    [[ -w "${_dev}" ]] || continue
    if _retheme_osc "${_dev}"; then
      _retheme_count=$((_retheme_count + 1))
    fi
    break
  done < <(ps -o tty= --ppid "${_pid}" 2>/dev/null)
  # Enumerate real urxvt processes by exact binary name, then confirm the
  # resource name from the cmdline. A bare `pgrep -f redstone-zsh-default` also
  # matches any shell whose own command line merely mentions the string — this
  # session hit exactly that, matching three processes where one urxvt existed.
done < <(for _p in $(pgrep -x urxvt 2>/dev/null); do
           if tr '\0' ' ' < "/proc/${_p}/cmdline" 2>/dev/null \
              | grep -q -- '-name redstone-zsh-default'; then
             echo "${_p}"
           fi
         done)

if [[ "${_retheme_count}" -gt 0 ]]; then
  echo "redstone-9x-scheme-apply: re-themed ${_retheme_count} live default terminal(s)" >&2
fi

# --- IceWM theme (the file the curated switcher always used) ---
mkdir -p "${HOME}/.icewm"
printf 'Theme="%s"\n' "${ICEWM_THEME}" > "${HOME}/.icewm/theme"

# --- Menu button (per-scheme taskbar Start button) ---
# Schemes sharing an ICEWM_THEME (the BeOS family all use BeOS-r5) can still
# carry distinct taskbar Start buttons. The Start button is the theme's
# taskbar/start.{png,xpm} pixmap (BeOS-r5 ships the deprecated taskbar/icewm.xpm
# name) — a SEPARATE image from the title-bar sysmenu button (menuButtonA/I +
# ShowMenuButtonIcon), which is left untouched. MENU_BUTTON names a set under
# ~/.icewm/menu-buttons/<id>/ holding start.png OR start.xpm, copied over the
# active theme's taskbar/ at apply time (same graft pattern as the icons). The
# Start button is not squeezed into a square slot, so a wide wordmark shows full.
if [[ -n "${MENU_BUTTON:-}" ]]; then
  _mbsrc="${HOME}/.icewm/menu-buttons/${MENU_BUTTON}"
  _tbdst="${HOME}/.icewm/themes/${ICEWM_THEME}/taskbar"
  if [[ -d "${_mbsrc}" && -d "${HOME}/.icewm/themes/${ICEWM_THEME}" ]]; then
    mkdir -p "${_tbdst}"
    rm -f "${_tbdst}/icewm.xpm" "${_tbdst}/start.png" "${_tbdst}/start.xpm"
    # A per-scheme recoloured Start button (start-<scheme-id>.png) outranks the
    # shared master: SerenityOS variants carry one per palette (baked host-side
    # by redstone-9x-start-recolour, since the guest has no Pillow), the legacy
    # grey master is the fallback for schemes whose face already matches it.
    _startsrc="${_mbsrc}/start-${SCHEME_ID}.png"
    [[ -f "${_startsrc}" ]] || _startsrc="${_mbsrc}/start.png"
    if [[ -f "${_startsrc}" ]]; then
      cp -f "${_startsrc}" "${_tbdst}/start.png"
    elif [[ -f "${_mbsrc}/start.xpm" ]]; then
      cp -f "${_mbsrc}/start.xpm" "${_tbdst}/start.xpm"
    fi
  fi
fi

# --- Desktop background colour (pre-paint, before pcmanfm loads) ---
# IceWM paints its own DesktopBackgroundColor the instant it starts, seconds
# before pcmanfm --desktop takes over. Without this the theme's hardcoded grey
# flashes before pcmanfm repaints the scheme colour. Solid colour ONLY — a
# DesktopBackgroundImage here would race pcmanfm's RENDER compositing (BadDrawable).
if [[ -n "${DESKTOP_BG:-}" ]]; then
  ICEWM_PREFS="${ICEWM_PREFS:+${ICEWM_PREFS};}DesktopBackgroundColor=\"${DESKTOP_BG}\""
fi

# --- Per-scheme titlebar colours (IceWM: Active=focused, Normal=inactive) ---
# Variants that share one IceWM theme (BeOS R5 / Personal / Max) can still carry
# distinct titlebar colours: prefoverride outranks the theme, and the metal look
# derives its titlebar gradient from these colours. Optional — a scheme without
# them keeps the shared IceWM theme's own titlebar colour.
if [[ -n "${TITLE_ACTIVE:-}" ]]; then
  ICEWM_PREFS="${ICEWM_PREFS:+${ICEWM_PREFS};}ColorActiveTitleBar=\"${TITLE_ACTIVE}\""
fi
if [[ -n "${TITLE_INACTIVE:-}" ]]; then
  ICEWM_PREFS="${ICEWM_PREFS:+${ICEWM_PREFS};}ColorNormalTitleBar=\"${TITLE_INACTIVE}\""
fi

# --- Backstop for IceWM's corrupt compiled font defaults ------------------
# icewm 4.0.0 ships a malformed default for QuickSwitchFontNameXft and
# StatusFontNameXft: two comma-separated entries lost the comma between them, so
# the chain contains the single unloadable entry
# "Sans Mono:monospace:size=12DejaVu Sans:size=12". It is wrong in the shipped
# share/icewm/preferences too (lines 1351 and 1387), which makes it upstream's
# bug rather than anything in this tree — the visible symptom is
#   IceWM: Warning: Could not load font "Sans Mono:monospace:size=12DejaVu Sans:size=12:lang=en-us"
# every time a theme that does not set those two prefs is loaded. Of the 110
# themes here exactly three qualify — BeOS-Max-Tab, BeOS-Personal-Tab and
# icedano, all of which set QuickSwitch but not Status.
#
# Rather than patch three theme files (two of which are regenerated by
# redstone-9x-icewm-derive and would lose the fix), close the hole where nothing
# can fall through it: prefoverride outranks the theme, so any font pref the
# active theme leaves unset gets filled here. A theme that sets its own value
# keeps it — this only supplies what would otherwise reach the broken default,
# and it borrows the theme's own menu/title font so typography stays per-theme
# instead of flattening every scheme to one face.
_theme_file=""
for _cand in \
  "${HOME}/.icewm/themes/${ICEWM_THEME}" \
  "${HOME}/.icewm/themes/${ICEWM_THEME}/default.theme" \
  "${HOME}/.icewm/themes/${ICEWM_THEME%%/*}/default.theme"; do
  [[ -f "${_cand}" ]] && { _theme_file="${_cand}"; break; }
done
if [[ -n "${_theme_file}" ]]; then
  _theme_font="$(sed -n 's/^[[:space:]]*MenuFontNameXft[[:space:]]*=[[:space:]]*"\(.*\)".*/\1/p' "${_theme_file}" | head -1)"
  [[ -n "${_theme_font}" ]] || _theme_font="$(sed -n 's/^[[:space:]]*TitleFontNameXft[[:space:]]*=[[:space:]]*"\(.*\)".*/\1/p' "${_theme_file}" | head -1)"
  # Last resort is a chain that is valid — the point is never to reach icewm's.
  [[ -n "${_theme_font}" ]] || _theme_font="DejaVu Sans:size=12,Sans:size=12"
  for _fp in QuickSwitchFontNameXft StatusFontNameXft; do
    if ! grep -qE "^[[:space:]]*${_fp}[[:space:]]*=" "${_theme_file}"; then
      ICEWM_PREFS="${ICEWM_PREFS:+${ICEWM_PREFS};}${_fp}=\"${_theme_font}\""
    fi
  done
fi

# --- IceWM taskbar-layout overrides (managed prefoverride block) ---
# Themes can only set colours; show/hide + placement toggles are
# preferences-level, and prefoverride outranks everything. The block is
# marked so the Focus menu's own prefoverride writes are never touched.
PREFO="${HOME}/.icewm/prefoverride"
touch "${PREFO}"
sed -i '/^# BEGIN redstone-scheme/,/^# END redstone-scheme/d' "${PREFO}"
if [[ -n "${ICEWM_PREFS:-}" ]]; then
  {
    echo "# BEGIN redstone-scheme (managed by redstone-9x-scheme-apply — do not edit)"
    IFS=';' read -ra _kvs <<< "${ICEWM_PREFS}"
    for _kv in "${_kvs[@]}"; do [[ -n "${_kv}" ]] && echo "${_kv}"; done
    echo "# END redstone-scheme"
  } >> "${PREFO}"
fi

# --- FOX toolkit registry (every FOX app: xfe, adie, PathFinder, ice2k) ---
if [[ -n "${FOX_BASE:-}" ]]; then
  mkdir -p "${HOME}/.foxrc"
  # This rewrites the shared FOX registry (Desktop) wholesale, so it MUST emit
  # EVERY section ice2k depends on — not just [SETTINGS]. Emitting colours only
  # silently dropped the [ICE2K] windows= personality that sanctuary-redstone-9x
  # -ice2k-build seeds, so after the first scheme-apply every ice2k FOX app
  # (control, deskcpl, sysdmcpl, devmgmt, winmine, …) lost its Windows-version
  # branding and fell back to the compiled default. The 3D bevel keys
  # (shadow/hilite/border/pbar/focus) are likewise scheme-owned here so the
  # raised/sunken widget look is correct per scheme instead of falling back to
  # FOX's built-in greys. ice2k only understands windows=2k|xp|srv03; schemes
  # outside that lineage inherit the 2k default (branding-only, harmless).
  cat > "${HOME}/.foxrc/Desktop" <<FOXEOF
# Written by redstone-9x-scheme-apply (Desktop Scheme: ${SCHEME_ID}).
[SETTINGS]
basecolor=${FOX_BASE}
forecolor=${FOX_FG:-#000000}
backcolor=${FOX_BG:-#ffffff}
textcolor=${FOX_FG:-#000000}
selbackcolor=${FOX_SEL_BG:-#000080}
selforecolor=${FOX_SEL_FG:-#ffffff}
selmenubackcolor=${FOX_MENU_BG:-${FOX_SEL_BG:-#000080}}
selmenutextcolor=${FOX_MENU_FG:-${FOX_SEL_FG:-#ffffff}}
shadowcolor=${FOX_SHADOW:-#808080}
hilitecolor=${FOX_HILITE:-#ffffff}
bordercolor=${FOX_BORDER:-#404040}
pbarcolor=${FOX_PBAR:-${FOX_SEL_BG:-#000080}}
focuscolor=${FOX_FOCUS:-#000000}
tipbackcolor=#ffffe1
tipforecolor=#000000
normalfont="Sans,80"

[ICE2K]
windows=${FOX_WINVER:-2k}
FOXEOF
fi

# --- GTK3 settings.ini + GTK2 rc (newly launched apps) ---
set_ini() { # file key value  (replace or append; tolerate quoted gtk2 style)
  local file="$1" key="$2" val="$3"
  if grep -q "^${key}=" "${file}" 2>/dev/null; then
    sed -i "s|^${key}=.*|${key}=${val}|" "${file}"
  else
    printf '%s=%s\n' "${key}" "${val}" >> "${file}"
  fi
}
GTK3="${HOME}/.config/gtk-3.0/settings.ini"
if [[ -f "${GTK3}" ]]; then
  set_ini "${GTK3}" gtk-theme-name "${GTK_THEME}"
  set_ini "${GTK3}" gtk-icon-theme-name "${ICON_THEME}"
  set_ini "${GTK3}" gtk-font-name "${GTK_FONT}"
  set_ini "${GTK3}" gtk-cursor-theme-name "${CURSOR_THEME}"
  set_ini "${GTK3}" gtk-cursor-theme-size "${CURSOR_SIZE}"
fi
# --- GTK4 settings.ini ---
# GTK4 apps (e.g. the pavucontrol mixer) read gtk-theme-name from THIS file, not
# reliably from XSETTINGS the way GTK3 does. It is not pre-seeded, so create it —
# without it every GTK4 app falls back to Adwaita regardless of the scheme (the
# "GTK4 not themed" mixer bug, 2026-08-01).
GTK4="${HOME}/.config/gtk-4.0/settings.ini"
mkdir -p "${HOME}/.config/gtk-4.0"
[[ -f "${GTK4}" ]] || printf '[Settings]\n' > "${GTK4}"
set_ini "${GTK4}" gtk-theme-name "${GTK_THEME}"
set_ini "${GTK4}" gtk-icon-theme-name "${ICON_THEME}"
set_ini "${GTK4}" gtk-font-name "${GTK_FONT}"
set_ini "${GTK4}" gtk-cursor-theme-name "${CURSOR_THEME}"
set_ini "${GTK4}" gtk-cursor-theme-size "${CURSOR_SIZE}"
GTK2="${HOME}/.gtkrc-2.0"
if [[ -f "${GTK2}" ]]; then
  set_ini "${GTK2}" gtk-theme-name "\"${GTK_THEME}\""
  set_ini "${GTK2}" gtk-icon-theme-name "\"${ICON_THEME}\""
  set_ini "${GTK2}" gtk-font-name "\"${GTK_FONT}\""
  set_ini "${GTK2}" gtk-cursor-theme-name "\"${CURSOR_THEME}\""
  set_ini "${GTK2}" gtk-cursor-theme-size "${CURSOR_SIZE}"
  set_ini "${GTK2}" gtk-button-images 0
  set_ini "${GTK2}" gtk-menu-images 0
fi

# --- GTK user CSS from template (selection + bevel colours) ---
if [[ -f "${CFG}/gtk-3.0/gtk.css.in" ]]; then
  r=$((16#${SEL_BG:1:2})); g=$((16#${SEL_BG:3:2})); b=$((16#${SEL_BG:5:2}))
  # Bevel colours: prefer scheme-provided keys (computed once by the converter,
  # same values as IceWM/Qt/Wine/FOX). Fall back to runtime GTK CSS extraction
  # only for .upstream vendored themes that have no converter-computed values.
  : "${BEVEL_FACE:=${FOX_BASE}}"
  if [[ -z "${BEVEL_HIGHLIGHT:-}" && -z "${BEVEL_SHADOW:-}" ]]; then
  _THEME_CSS="${HOME}/.themes/${GTK_THEME}/gtk-3.0/gtk.css"
  _THEME_CDE="${HOME}/.themes/${GTK_THEME}/gtk-3.0/cdecolors.css"
  BEVEL_HIGHLIGHT=""
  BEVEL_SHADOW=""
  BEVEL_DKSHADOW=""
  if [[ -f "${_THEME_CDE}" ]]; then
    # CDE family — palette 6 is the menu palette; Motif 2-colour bevel
    # uses bottomShadow as the dark border edge (no separate 3DDkShadow)
    BEVEL_HIGHLIGHT=$(grep -oP '@define-color\s+ts_color_6\s+\K#[0-9a-fA-F]{6}' "${_THEME_CDE}" | head -1)
    BEVEL_SHADOW=$(grep -oP '@define-color\s+bs_color_6\s+\K#[0-9a-fA-F]{6}' "${_THEME_CDE}" | head -1)
    BEVEL_DKSHADOW="${BEVEL_SHADOW}"
    _cde_bg=$(grep -oP '@define-color\s+bg_color_6\s+\K#[0-9a-fA-F]{6}' "${_THEME_CDE}" | head -1)
    [[ -n "${_cde_bg}" ]] && BEVEL_FACE="${_cde_bg}"
  elif [[ -f "${_THEME_CSS}" ]]; then
    # Chicago95 / bevel themes — pair box-shadow:inset with a nearby hex
    # border-top-color (±10 lines) to lock onto the button bevel block.
    # Check gtk.css first; split themes put widgets in gtk-widgets.css.
    _THEME_WIDGETS="${HOME}/.themes/${GTK_THEME}/gtk-3.0/gtk-widgets.css"
    _found_pair=false
    for _try_css in "${_THEME_CSS}" "${_THEME_WIDGETS}"; do
      [[ -f "${_try_css}" ]] || continue
      ${_found_pair} && break
      _count=0
      while IFS=: read -r _bsl _rest; do
        _count=$((_count + 1))
        (( _count > 5 )) && break
        _lo=$(( _bsl > 10 ? _bsl - 10 : 1 ))
        _nearby_hl=$(sed -n "${_lo},$((_bsl + 10))p" "${_try_css}" \
          | grep -oP 'border-top-color:\s*\K#[0-9a-fA-F]{6}' | head -1)
        if [[ -n "${_nearby_hl}" ]]; then
          BEVEL_HIGHLIGHT="${_nearby_hl}"
          _first_bs=$(sed -n "${_bsl}p" "${_try_css}")
          BEVEL_SHADOW=$(echo "${_first_bs}" | tr ',' '\n' | grep 'inset -[0-9]' \
            | grep -oP '#[0-9a-fA-F]{6}' | head -1)
          _found_pair=true
          break
        fi
      done < <(grep -n 'box-shadow:.*inset' "${_try_css}")
    done
    if [[ "${_found_pair}" != true ]]; then
      # Haiku/BeOS-style: no hex border-top-color, bevel in box-shadow only
      for _try_css in "${_THEME_CSS}" "${_THEME_WIDGETS}"; do
        [[ -f "${_try_css}" ]] || continue
        _bs_lineno=$(grep -n 'box-shadow:.*inset' "${_try_css}" | head -1 | cut -d: -f1)
        if [[ -n "${_bs_lineno}" ]]; then
          _first_bs=$(sed -n "${_bs_lineno}p" "${_try_css}")
          BEVEL_SHADOW=$(echo "${_first_bs}" | tr ',' '\n' | grep 'inset -[0-9]' \
            | grep -oP '#[0-9a-fA-F]{6}' | head -1)
          _hl_raw=$(echo "${_first_bs}" | tr ',' '\n' | grep 'inset [1-9]' \
            | grep -oiP '#[0-9a-fA-F]{6}\b|\bwhite\b' | head -1)
          [[ "${_hl_raw,,}" == "white" ]] && _hl_raw="#ffffff"
          BEVEL_HIGHLIGHT="${_hl_raw}"
          break
        fi
      done
    fi
  fi
  # Fallback for flat themes or failed extraction
  : "${BEVEL_DKSHADOW:=#000000}"
  if [[ -z "${BEVEL_HIGHLIGHT}" || -z "${BEVEL_SHADOW}" ]]; then
    _bh="${BEVEL_FACE#\#}"
    _br=$((16#${_bh:0:2})); _bg=$((16#${_bh:2:2})); _bb=$((16#${_bh:4:2}))
    [[ -z "${BEVEL_HIGHLIGHT}" ]] && BEVEL_HIGHLIGHT=$(printf '#%02x%02x%02x' \
      $((_br + (255 - _br) * 7 / 10)) $((_bg + (255 - _bg) * 7 / 10)) $((_bb + (255 - _bb) * 7 / 10)))
    [[ -z "${BEVEL_SHADOW}" ]] && BEVEL_SHADOW=$(printf '#%02x%02x%02x' \
      $((_br * 65 / 100)) $((_bg * 65 / 100)) $((_bb * 65 / 100)))
  fi
  fi  # end of runtime extraction fallback
  : "${BEVEL_DKSHADOW:=#000000}"
  _bh="${BEVEL_FACE#\#}"
  _br=$((16#${_bh:0:2})); _bg=$((16#${_bh:2:2})); _bb=$((16#${_bh:4:2}))
  _bevel_luma=$((_br * 299 + _bg * 587 + _bb * 114))
  if (( _bevel_luma >= 128000 )); then
    BEVEL_FG="#000000"
  else
    BEVEL_FG="#ffffff"
  fi
  mkdir -p "${HOME}/.config/gtk-3.0"
  sed -e "s|@SEL_BG@|${SEL_BG}|g" \
      -e "s|@SEL_FG@|${SEL_FG}|g" \
      -e "s|@SEL_RGBA@|rgba(${r}, ${g}, ${b}, 0.35)|g" \
      -e "s|@BEVEL_FACE@|${BEVEL_FACE}|g" \
      -e "s|@BEVEL_HIGHLIGHT@|${BEVEL_HIGHLIGHT}|g" \
      -e "s|@BEVEL_SHADOW@|${BEVEL_SHADOW}|g" \
      -e "s|@BEVEL_DKSHADOW@|${BEVEL_DKSHADOW}|g" \
      -e "s|@BEVEL_FG@|${BEVEL_FG}|g" \
      "${CFG}/gtk-3.0/gtk.css.in" > "${HOME}/.config/gtk-3.0/gtk.css"
fi

# --- Qt via qt6ct ---
QT6CT="${HOME}/.config/qt6ct/qt6ct.conf"
if [[ -f "${QT6CT}" ]]; then
  sed -i -e "s|^color_scheme_path=.*|color_scheme_path=${HOME}/.config/qt6ct/colors/${QT6CT_COLORS}|" \
         -e "s|^icon_theme=.*|icon_theme=${ICON_THEME}|" \
         -e "s|^style=.*|style=${QT_STYLE}|" "${QT6CT}"
fi

# --- Qt item-view hover text (Kvantum-only workaround) ---
# Kvantum has NO hover-text key: a hovered-but-unselected tree/list row is
# hardwired to text.normal.color (black), even though the fill drawn under it is
# the navy accent (iview-focused). Confirmed against the Kvantum ThemeConfig
# behaviour — the frame/fill and the text-colour code paths diverge, and only a
# genuinely selected/focused row escalates to text.focus.color. The one lever
# that overrides the engine for that pseudo-state is an app-level Qt stylesheet,
# which qt6ct injects on top of Kvantum. Force hovered-unselected item text to
# the scheme's selection foreground so it matches the selected row. Scoped to
# Kvantum schemes and CLEARED for others, so a light-hover Windows-style scheme
# is never handed white text it can't read.
QSSDIR="${HOME}/.config/qt6ct/qss"
QSS="${QSSDIR}/redstone-hover.qss"
if [[ "${QT_STYLE}" == "kvantum" ]]; then
  mkdir -p "${QSSDIR}"
  cat > "${QSS}" <<QSSEOF
QAbstractItemView::item:hover:!selected { color: ${SEL_FG}; }
QSSEOF
  _sheets="${QSS}"
else
  _sheets=""
fi
if [[ -f "${QT6CT}" ]]; then
  if grep -q '^style_sheets=' "${QT6CT}"; then
    sed -i -e "s|^style_sheets=.*|style_sheets=${_sheets}|" "${QT6CT}"
  else
    sed -i -e "/^\[Appearance\]/a style_sheets=${_sheets}" "${QT6CT}"
  fi
fi

# --- Kvantum (only meaningful when QT_STYLE=kvantum; harmless otherwise) ---
if [[ -n "${KVANTUM_THEME:-}" ]]; then
  mkdir -p "${HOME}/.config/Kvantum"
  cat > "${HOME}/.config/Kvantum/kvantum.kvconfig" <<KVEOF
[General]
theme=${KVANTUM_THEME}
KVEOF
fi

# --- Wine classic colours (the Wine desktop follows the scheme too) ---
WINEREG="${HOME}/.config/redstone-9x/wine/${WINE_COLORS:-${SCHEME_ID}.reg}"
if [[ -f "${WINEREG}" ]] && command -v wine >/dev/null 2>&1; then
  # Background apply; regedit is cheap, and a cold wineserver start must not
  # stall the scheme switch.
  ( wine regedit /S "${WINEREG}" >/dev/null 2>&1 & ) || true
fi

