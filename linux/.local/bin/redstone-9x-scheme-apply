#!/bin/bash
# redstone-9x-scheme-apply [--boot] <scheme-id>
# Swap every appearance layer to the named Desktop Scheme.
# --boot: file effects only (no WM restart, no daemon HUPs, no sounds) —
#         called by the launcher after projection, host-side with
#         HOME=<guest-home>, to re-assert the active scheme.
# Full mode (from the Desktop Schemes menu, in-guest): also restarts IceWM,
# HUPs xsettingsd, reconfigures pcmanfm, and plays the notify sound.
set -uo pipefail

BOOT=0
if [[ "${1:-}" == "--boot" ]]; then BOOT=1; shift; fi
SCHEME_ID="${1:?usage: redstone-9x-scheme-apply [--boot] <scheme-id>}"

CFG="${HOME}/.config/redstone-9x"
SCHEME_FILE="${CFG}/schemes/${SCHEME_ID}.scheme"
if [[ ! -f "${SCHEME_FILE}" ]]; then
  echo "scheme not found: ${SCHEME_FILE}" >&2
  ls "${CFG}/schemes/" 2>/dev/null >&2
  exit 1
fi
# shellcheck disable=SC1090
. "${SCHEME_FILE}"

: "${ICEWM_THEME:?}" "${GTK_THEME:?}" "${ICON_THEME:?}" "${CURSOR_THEME:?}"
: "${CURSOR_SIZE:=24}" "${GTK_FONT:=Sans 8}" "${DESKTOP_BG:=#008080}"
: "${SEL_BG:=#000080}" "${SEL_FG:=#ffffff}" "${QT6CT_COLORS:=win95.conf}"
: "${SOUND_SCHEME:=${SCHEME_ID}}" "${QT_STYLE:=Windows}"

# --- IceWM theme (the file the curated switcher always used) ---
mkdir -p "${HOME}/.icewm"
printf 'Theme="%s"\n' "${ICEWM_THEME}" > "${HOME}/.icewm/theme"

# --- Menu button (per-scheme taskbar Start button) ---
# Schemes sharing an ICEWM_THEME (the BeOS family all use BeOS-r5) can still
# carry distinct taskbar Start buttons. The Start button is the theme's
# taskbar/start.{png,xpm} pixmap (BeOS-r5 ships the deprecated taskbar/icewm.xpm
# name) — a SEPARATE image from the title-bar sysmenu button (menuButtonA/I +
# ShowMenuButtonIcon), which is left untouched. MENU_BUTTON names a set under
# ~/.icewm/menu-buttons/<id>/ holding start.png OR start.xpm, copied over the
# active theme's taskbar/ at apply time (same graft pattern as the icons). The
# Start button is not squeezed into a square slot, so a wide wordmark shows full.
if [[ -n "${MENU_BUTTON:-}" ]]; then
  _mbsrc="${HOME}/.icewm/menu-buttons/${MENU_BUTTON}"
  _tbdst="${HOME}/.icewm/themes/${ICEWM_THEME}/taskbar"
  if [[ -d "${_mbsrc}" && -d "${HOME}/.icewm/themes/${ICEWM_THEME}" ]]; then
    mkdir -p "${_tbdst}"
    rm -f "${_tbdst}/icewm.xpm" "${_tbdst}/start.png" "${_tbdst}/start.xpm"
    if [[ -f "${_mbsrc}/start.png" ]]; then
      cp -f "${_mbsrc}/start.png" "${_tbdst}/start.png"
    elif [[ -f "${_mbsrc}/start.xpm" ]]; then
      cp -f "${_mbsrc}/start.xpm" "${_tbdst}/start.xpm"
    fi
  fi
fi

# --- Desktop background colour (pre-paint, before pcmanfm loads) ---
# IceWM paints its own DesktopBackgroundColor the instant it starts, seconds
# before pcmanfm --desktop takes over. Without this the theme's hardcoded grey
# flashes before pcmanfm repaints the scheme colour. Solid colour ONLY — a
# DesktopBackgroundImage here would race pcmanfm's RENDER compositing (BadDrawable).
if [[ -n "${DESKTOP_BG:-}" ]]; then
  ICEWM_PREFS="${ICEWM_PREFS:+${ICEWM_PREFS};}DesktopBackgroundColor=\"${DESKTOP_BG}\""
fi

# --- Per-scheme titlebar colours (IceWM: Active=focused, Normal=inactive) ---
# Variants that share one IceWM theme (BeOS R5 / Personal / Max) can still carry
# distinct titlebar colours: prefoverride outranks the theme, and the metal look
# derives its titlebar gradient from these colours. Optional — a scheme without
# them keeps the shared IceWM theme's own titlebar colour.
if [[ -n "${TITLE_ACTIVE:-}" ]]; then
  ICEWM_PREFS="${ICEWM_PREFS:+${ICEWM_PREFS};}ColorActiveTitleBar=\"${TITLE_ACTIVE}\""
fi
if [[ -n "${TITLE_INACTIVE:-}" ]]; then
  ICEWM_PREFS="${ICEWM_PREFS:+${ICEWM_PREFS};}ColorNormalTitleBar=\"${TITLE_INACTIVE}\""
fi

# --- IceWM taskbar-layout overrides (managed prefoverride block) ---
# Themes can only set colours; show/hide + placement toggles are
# preferences-level, and prefoverride outranks everything. The block is
# marked so the Focus menu's own prefoverride writes are never touched.
PREFO="${HOME}/.icewm/prefoverride"
touch "${PREFO}"
sed -i '/^# BEGIN redstone-scheme/,/^# END redstone-scheme/d' "${PREFO}"
if [[ -n "${ICEWM_PREFS:-}" ]]; then
  {
    echo "# BEGIN redstone-scheme (managed by redstone-9x-scheme-apply — do not edit)"
    IFS=';' read -ra _kvs <<< "${ICEWM_PREFS}"
    for _kv in "${_kvs[@]}"; do [[ -n "${_kv}" ]] && echo "${_kv}"; done
    echo "# END redstone-scheme"
  } >> "${PREFO}"
fi

# --- FOX toolkit registry (every FOX app: xfe, adie, PathFinder, ice2k) ---
if [[ -n "${FOX_BASE:-}" ]]; then
  mkdir -p "${HOME}/.foxrc"
  cat > "${HOME}/.foxrc/Desktop" <<FOXEOF
# Written by redstone-9x-scheme-apply (Desktop Scheme: ${SCHEME_ID}).
[SETTINGS]
basecolor=${FOX_BASE}
forecolor=${FOX_FG:-#000000}
backcolor=${FOX_BG:-#ffffff}
textcolor=${FOX_FG:-#000000}
selbackcolor=${FOX_SEL_BG:-#000080}
selforecolor=${FOX_SEL_FG:-#ffffff}
selmenubackcolor=${FOX_MENU_BG:-${FOX_SEL_BG:-#000080}}
selmenutextcolor=${FOX_MENU_FG:-${FOX_SEL_FG:-#ffffff}}
tipbackcolor=#ffffe1
tipforecolor=#000000
normalfont="Sans,80"
FOXEOF
fi

# --- GTK3 settings.ini + GTK2 rc (newly launched apps) ---
set_ini() { # file key value  (replace or append; tolerate quoted gtk2 style)
  local file="$1" key="$2" val="$3"
  if grep -q "^${key}=" "${file}" 2>/dev/null; then
    sed -i "s|^${key}=.*|${key}=${val}|" "${file}"
  else
    printf '%s=%s\n' "${key}" "${val}" >> "${file}"
  fi
}
GTK3="${HOME}/.config/gtk-3.0/settings.ini"
if [[ -f "${GTK3}" ]]; then
  set_ini "${GTK3}" gtk-theme-name "${GTK_THEME}"
  set_ini "${GTK3}" gtk-icon-theme-name "${ICON_THEME}"
  set_ini "${GTK3}" gtk-font-name "${GTK_FONT}"
  set_ini "${GTK3}" gtk-cursor-theme-name "${CURSOR_THEME}"
  set_ini "${GTK3}" gtk-cursor-theme-size "${CURSOR_SIZE}"
fi
GTK2="${HOME}/.gtkrc-2.0"
if [[ -f "${GTK2}" ]]; then
  set_ini "${GTK2}" gtk-theme-name "\"${GTK_THEME}\""
  set_ini "${GTK2}" gtk-icon-theme-name "\"${ICON_THEME}\""
  set_ini "${GTK2}" gtk-font-name "\"${GTK_FONT}\""
  set_ini "${GTK2}" gtk-cursor-theme-name "\"${CURSOR_THEME}\""
  set_ini "${GTK2}" gtk-cursor-theme-size "${CURSOR_SIZE}"
  set_ini "${GTK2}" gtk-button-images 0
  set_ini "${GTK2}" gtk-menu-images 0
fi

# --- GTK user CSS from template (selection colours) ---
if [[ -f "${CFG}/gtk-3.0/gtk.css.in" ]]; then
  r=$((16#${SEL_BG:1:2})); g=$((16#${SEL_BG:3:2})); b=$((16#${SEL_BG:5:2}))
  mkdir -p "${HOME}/.config/gtk-3.0"
  sed -e "s|@SEL_BG@|${SEL_BG}|g" \
      -e "s|@SEL_FG@|${SEL_FG}|g" \
      -e "s|@SEL_RGBA@|rgba(${r}, ${g}, ${b}, 0.35)|g" \
      "${CFG}/gtk-3.0/gtk.css.in" > "${HOME}/.config/gtk-3.0/gtk.css"
fi

# --- Qt via qt6ct ---
QT6CT="${HOME}/.config/qt6ct/qt6ct.conf"
if [[ -f "${QT6CT}" ]]; then
  sed -i -e "s|^color_scheme_path=.*|color_scheme_path=${HOME}/.config/qt6ct/colors/${QT6CT_COLORS}|" \
         -e "s|^icon_theme=.*|icon_theme=${ICON_THEME}|" \
         -e "s|^style=.*|style=${QT_STYLE}|" "${QT6CT}"
fi

# --- Qt item-view hover text (Kvantum-only workaround) ---
# Kvantum has NO hover-text key: a hovered-but-unselected tree/list row is
# hardwired to text.normal.color (black), even though the fill drawn under it is
# the navy accent (iview-focused). Confirmed against the Kvantum ThemeConfig
# behaviour — the frame/fill and the text-colour code paths diverge, and only a
# genuinely selected/focused row escalates to text.focus.color. The one lever
# that overrides the engine for that pseudo-state is an app-level Qt stylesheet,
# which qt6ct injects on top of Kvantum. Force hovered-unselected item text to
# the scheme's selection foreground so it matches the selected row. Scoped to
# Kvantum schemes and CLEARED for others, so a light-hover Windows-style scheme
# is never handed white text it can't read.
QSSDIR="${HOME}/.config/qt6ct/qss"
QSS="${QSSDIR}/redstone-hover.qss"
if [[ "${QT_STYLE}" == "kvantum" ]]; then
  mkdir -p "${QSSDIR}"
  cat > "${QSS}" <<QSSEOF
QAbstractItemView::item:hover:!selected { color: ${SEL_FG}; }
QSSEOF
  _sheets="${QSS}"
else
  _sheets=""
fi
if [[ -f "${QT6CT}" ]]; then
  if grep -q '^style_sheets=' "${QT6CT}"; then
    sed -i -e "s|^style_sheets=.*|style_sheets=${_sheets}|" "${QT6CT}"
  else
    sed -i -e "/^\[Appearance\]/a style_sheets=${_sheets}" "${QT6CT}"
  fi
fi

# --- Kvantum (only meaningful when QT_STYLE=kvantum; harmless otherwise) ---
if [[ -n "${KVANTUM_THEME:-}" ]]; then
  mkdir -p "${HOME}/.config/Kvantum"
  cat > "${HOME}/.config/Kvantum/kvantum.kvconfig" <<KVEOF
[General]
theme=${KVANTUM_THEME}
KVEOF
fi

# --- Wine classic colours (the Wine desktop follows the scheme too) ---
WINEREG="${HOME}/.config/redstone-9x/wine/${WINE_COLORS:-${SCHEME_ID}.reg}"
if [[ -f "${WINEREG}" ]] && command -v wine >/dev/null 2>&1; then
  # Background apply; regedit is cheap, and a cold wineserver start must not
  # stall the scheme switch.
  ( wine regedit /S "${WINEREG}" >/dev/null 2>&1 & ) || true
fi

# --- Cursor fallback (libXcursor default when env is absent; also repairs
#     LXAppearance drive-by overwrites of this file) ---
mkdir -p "${HOME}/.icons/default"
printf '[Icon Theme]\nName=Default\nComment=Redstone scheme cursor fallback\nInherits=%s\n' \
  "${CURSOR_THEME}" > "${HOME}/.icons/default/index.theme"

# --- XSETTINGS (live restyle of running GTK3 apps) ---
mkdir -p "${HOME}/.config/xsettingsd"
cat > "${HOME}/.config/xsettingsd/xsettingsd.conf" <<XSEOF
Net/ThemeName "${GTK_THEME}"
Net/IconThemeName "${ICON_THEME}"
Gtk/FontName "${GTK_FONT}"
Gtk/CursorThemeName "${CURSOR_THEME}"
Gtk/CursorThemeSize ${CURSOR_SIZE}
Gtk/ButtonImages 0
Gtk/MenuImages 0
Net/EnableEventSounds 0
XSEOF

# --- Desktop background (pcmanfm owns the desktop) ---
PCMANFM_CONF="${HOME}/.config/pcmanfm/default/desktop-items-0.conf"
if [[ -f "${PCMANFM_CONF}" ]]; then
  if [[ -n "${WALLPAPER:-}" && -f "${WALLPAPER}" ]]; then
    sed -i -e "s|^wallpaper_mode=.*|wallpaper_mode=${WALLPAPER_MODE:-center}|" \
           -e "s|^wallpaper=.*|wallpaper=${WALLPAPER}|" "${PCMANFM_CONF}"
    grep -q '^wallpaper=' "${PCMANFM_CONF}" || sed -i "/^wallpaper_mode=/a wallpaper=${WALLPAPER}" "${PCMANFM_CONF}"
    # Force a live repaint on the running pcmanfm. Editing the conf alone does
    # NOT repaint the desktop (verified 2026-07-20); the --set-wallpaper CLI
    # does. Backdrops are pre-tiled full images shown with wallpaper_mode=center
    # because pcmanfm's own tile mode paints white here (flaky XRender path).
    if command -v pcmanfm >/dev/null 2>&1; then
      pcmanfm --set-wallpaper="${WALLPAPER}" --wallpaper-mode="${WALLPAPER_MODE:-center}" 2>/dev/null || true
    fi
  else
    # pcmanfm's real key is desktop_bg; the launcher's write-once seed used
    # wallpaper_bg_color and pcmanfm rewrote it (found by scratch test
    # 2026-07-19) — handle both so pristine and evolved confs both switch.
    sed -i -e "s|^wallpaper_mode=.*|wallpaper_mode=color|" \
           -e "s|^wallpaper_bg_color=.*|wallpaper_bg_color=${DESKTOP_BG}|" \
           -e "s|^desktop_bg=.*|desktop_bg=${DESKTOP_BG}|" \
           -e "s|^desktop_fg=.*|desktop_fg=${DESKTOP_FG:-#ffffff}|" "${PCMANFM_CONF}"
  fi
fi

# --- IceWM menu/toolbar icons regrafted from this scheme's icon theme ---
if command -v redstone-9x-icons-graft >/dev/null 2>&1; then
  redstone-9x-icons-graft "${HOME}/.local/share/icons:${HOME}/.icons" "${HOME}/.icewm/icons" "${ICON_THEME}"
elif [[ -x "${HOME}/.local/bin/redstone-9x-icons-graft" ]]; then
  "${HOME}/.local/bin/redstone-9x-icons-graft" "${HOME}/.local/share/icons:${HOME}/.icons" "${HOME}/.icewm/icons" "${ICON_THEME}"
fi

# --- Sound scheme (migrate the pre-scheme flat dir once, then symlink) ---
SND="${HOME}/.local/share/sounds"
mkdir -p "${SND}/schemes/${SOUND_SCHEME}"
if [[ -d "${SND}/sanctuary" && ! -L "${SND}/sanctuary" ]]; then
  # One-time migration of the original flat layout into schemes/windows-95
  # (the founding assets were the Win95 set). mv only — guest home is precious.
  mkdir -p "${SND}/schemes/windows-95"
  for f in "${SND}/sanctuary"/*; do
    [[ -e "${f}" ]] && mv -n "${f}" "${SND}/schemes/windows-95/"
  done
  rmdir "${SND}/sanctuary" 2>/dev/null || true
fi
[[ -e "${SND}/sanctuary" && ! -L "${SND}/sanctuary" ]] || ln -sfnT "${SND}/schemes/${SOUND_SCHEME}" "${SND}/sanctuary"

# --- Chime fallback (decree 2026-07-19): a scheme with no startup chime
# borrows the Windows 98 chime, materialized once into the scheme dir so
# icesound and the switch greeting both find it. Only startup — a pack's
# other missing events stay silent rather than borrowing foreign sounds. ---
if [[ "${SOUND_SCHEME}" != "windows-98" && -f "${SND}/schemes/windows-98/icewm/startup.wav" ]]; then
  mkdir -p "${SND}/schemes/${SOUND_SCHEME}/icewm"
  [[ -f "${SND}/schemes/${SOUND_SCHEME}/startup.wav" ]] \
    || cp "${SND}/schemes/windows-98/startup.wav" "${SND}/schemes/${SOUND_SCHEME}/startup.wav" 2>/dev/null || true
  [[ -f "${SND}/schemes/${SOUND_SCHEME}/icewm/startup.wav" ]] \
    || cp "${SND}/schemes/windows-98/icewm/startup.wav" "${SND}/schemes/${SOUND_SCHEME}/icewm/startup.wav"
fi

# --- Persist the choice ---
mkdir -p "${CFG}"
printf '%s\n' "${SCHEME_ID}" > "${CFG}/scheme"

if [[ "${BOOT}" -eq 1 ]]; then
  exit 0
fi

# --- Live reloads (full mode only) ---
pkill -HUP -x xsettingsd 2>/dev/null || true
pcmanfm --reconfigure 2>/dev/null || true
# pcmanfm does NOT repaint desktop_bg (or reload the selection gtk.css) on
# --reconfigure — verified live 2026-07-19, desktop stayed teal after a
# serenity switch. Bounce the desktop renderer; it re-reads both on start.
# Start it UNCONDITIONALLY (not only when already running): if a prior scheme
# crashed pcmanfm --desktop — e.g. an IceWM DesktopBackgroundImage racing it
# for the root pixmap (RENDER BadDrawable) — the desktop would otherwise stay
# icon-less for the whole session, since a dead renderer is never revived.
pkill -u "$(id -u)" -f "pcmanfm --desktop" 2>/dev/null || true
( sleep 1; pcmanfm --desktop >>"${HOME}/.cache/redstone-9x/pcmanfm-desktop.log" 2>&1 & ) &
# icesound samples live under the sanctuary symlink, but icesound scans its
# sample dir at startup — bounce it so the NEW scheme's GUI-event sounds load
# (started fresh only when the new scheme actually ships icewm/*.wav).
pkill -x icesound 2>/dev/null || true
if command -v icesound >/dev/null 2>&1 \
  && [ -n "$(ls "${HOME}/.local/share/sounds/sanctuary/icewm/"*.wav 2>/dev/null)" ]; then
  ( setsid icesound --interface=AO --sample-dir="${HOME}/.local/share/sounds/sanctuary/icewm" \
      >>"${HOME}/.cache/redstone-9x/icesound.log" 2>&1 & ) &
fi
icewm -r 2>/dev/null || true
# Greet the new scheme with ITS OWN startup sound (the sanctuary symlink
# already points at the new scheme's sound dir by this point) — per
# Mètsàtron's decree 2026-07-19. When icesound owns startup.wav the WM
# restart above does NOT replay it (icesound's startup event fires only at
# WM start, not restart... icewm -r emits restart), so this stays.
( sanctuary-sound startup >/dev/null 2>&1 & ) || true
exit 0
