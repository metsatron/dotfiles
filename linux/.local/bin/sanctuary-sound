#!/bin/sh
# Sanctuary system sounds

# Every sanctuary owns a system sound scheme — its =C:\Windows\Media=. Sound assets are *user-supplied* and live in the guest home at =~/.local/share/sounds/sanctuary/<event>.wav= (also =.ogg=, =.flac=, =.mp3=): the Win95 startup chime and its event set are copyrighted Microsoft material, so DotCortex ships no audio payloads, exactly like the ROM law. File presence is the declaration — a missing event file is a silent no-op that can never break a launch.

# Canonical event names (drop in whichever you have): =startup=, =logoff=, =error=, =question=, =notify=, =device-connect=, =device-disconnect=, =recycle-empty=. Phase 1 wires =startup= (played by each sanctuary's session hook once the desktop is visible, exactly when Win95 played it) and =logoff= (played host-side by the launcher after the session exits). Richer per-event integration — IceWM's native =icesound= GUI-event scheme for Redstone, XFCE libcanberra event sounds for Godzilla XS — is roadmapped in MetaCortex Redstone-Connective-Tissue.

# The player rides the same audio path the sanctuaries' own apps already use: the host PulseAudio socket is visible in-guest at its default =/run/user/<uid>/pulse/native= location, so plain =paplay= connects with no extra plumbing (the Flatpak =/run/flatpak/pulse= gotcha does not apply to Guix-profile players). =paplay= comes from the =pulseaudio= package in the shared =desktop-common= profile; the fallback chain covers guests whose profiles carry other players.


# [[file:../../../sanctuary-distrobox.org::*Sanctuary system sounds][Sanctuary system sounds:1]]
# sanctuary-sound — play a sanctuary system-sound event.
# Usage: sanctuary-sound <event> [sound-dir]
# Looks for <sound-dir>/<event>.{wav,ogg,flac,mp3}; first match plays.
# sound-dir defaults to $SANCTUARY_SOUND_DIR, then ~/.local/share/sounds/sanctuary.
# Assets are user-supplied (Win95 media is copyrighted — DotCortex ships none).
# Silent no-op when the event file or every player is missing: a sound must
# never break a launch. Callers background this ("sanctuary-sound startup &")
# when they must not block.
EVENT="${1:?usage: sanctuary-sound <event> [sound-dir]}"
DIR="${2:-${SANCTUARY_SOUND_DIR:-${HOME}/.local/share/sounds/sanctuary}}"

FILE=""
for ext in wav ogg flac mp3; do
  if [ -f "${DIR}/${EVENT}.${ext}" ]; then
    FILE="${DIR}/${EVENT}.${ext}"
    break
  fi
done
[ -n "${FILE}" ] || exit 0

# Player chain: try each in turn and fall through on FAILURE, not just on
# absence — a present player can still fail to reach the server (verified
# 2026-07-19: pw-play exists in the Godzilla XS profile but the host runs
# PulseAudio, not PipeWire → "Host is down"). paplay speaks the host's actual
# protocol, ffplay/sox decode anything, pw-play only helps on PipeWire hosts,
# and raw-ALSA aplay is a wav-only last resort.
if command -v paplay >/dev/null 2>&1 && [ "${FILE##*.}" != "mp3" ]; then
  paplay "${FILE}" >/dev/null 2>&1 && exit 0
fi
if command -v ffplay >/dev/null 2>&1; then
  ffplay -nodisp -autoexit -loglevel quiet "${FILE}" >/dev/null 2>&1 && exit 0
fi
if command -v play >/dev/null 2>&1; then
  play -q "${FILE}" >/dev/null 2>&1 && exit 0
fi
if command -v pw-play >/dev/null 2>&1; then
  pw-play "${FILE}" >/dev/null 2>&1 && exit 0
fi
if command -v aplay >/dev/null 2>&1 && [ "${FILE##*.}" = "wav" ]; then
  aplay -q "${FILE}" >/dev/null 2>&1 && exit 0
fi
exit 0
# Sanctuary system sounds:1 ends here
