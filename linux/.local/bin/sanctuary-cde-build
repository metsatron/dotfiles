#!/usr/bin/env bash
# [[file:../../../distrobox.org::*Sanctuary Launcher Scripts][Sanctuary Launcher Scripts:6]]
# Build CDE 2.5.3 from source inside the sanctuary-cde container.
# Run once from the host: sanctuary-cde-build
# Uses the official CDE 2.5.3 release (SourceForge, 2025-11-25).
# NOT the 2012 arcfide/CDesktopEnv clone.
set -euo pipefail

CDE_VERSION="2.5.3"
GUIX_PROFILES="${HOME}/.guix-extra-profiles"

# Use a heredoc to build the inner script — inner double-quotes in the heredoc
# body are just text (no quoting-state effects on the outer shell).
# Outer-shell vars (CDE_VERSION, GUIX_PROFILES) expand at heredoc time;
# inner-shell vars (HOME, CDE_PREFIX, etc.) are deferred via backslash-$.
INNER_SCRIPT=$(cat <<INNER_EOF
set -eo pipefail

CDE_PREFIX=\${HOME}/.local/share/cde
CDE_SRC=\${HOME}/.local/share/cde-src
CDE_TARBALL=cde-${CDE_VERSION}.tar.gz
CDE_URL=https://downloads.sourceforge.net/project/cdesktopenv/src/\${CDE_TARBALL}

GUIX_PROFILE=${GUIX_PROFILES}/desktop-common/desktop-common
. \${GUIX_PROFILE}/etc/profile
GUIX_PROFILE=${GUIX_PROFILES}/sanctuary-cde/sanctuary-cde
. \${GUIX_PROFILE}/etc/profile
export CURL_CA_BUNDLE=\${GIT_SSL_CAINFO}

if [ -x "\${CDE_PREFIX}/bin/Xsession" ]; then
  echo "CDE already installed at \${CDE_PREFIX}"
  exit 0
fi

mkdir -p "\${CDE_SRC}"
cd "\${CDE_SRC}"

if [ ! -f "\${CDE_TARBALL}" ]; then
  echo "Downloading CDE ${CDE_VERSION} from SourceForge..."
  curl -L --retry 3 -o "\${CDE_TARBALL}" "\${CDE_URL}"
fi

tar xf "\${CDE_TARBALL}"
cd "cde-${CDE_VERSION}"

mkdir -p "\${CDE_SRC}/bin"
ln -sf "\$(which oksh)" "\${CDE_SRC}/bin/ksh"
export PATH="\${CDE_SRC}/bin:\${PATH}"

./autogen.sh
./configure --prefix="\${CDE_PREFIX}" --with-tcl=\${GUIX_PROFILE}/lib \
  CFLAGS="-std=gnu17 -g -O2 -I\${GUIX_PROFILE}/include/tirpc" \
  CXXFLAGS="-std=gnu++17 -g -O2 -I\${GUIX_PROFILE}/include/tirpc"
make -j\$(nproc)
make install

echo "CDE ${CDE_VERSION} installed to \${CDE_PREFIX}"
echo "Launch with: sanctuary-cde-launch (Super+4 to reach Desktop 4 first)"
INNER_EOF
)
sanctuary-exec sanctuary-cde sh -c "${INNER_SCRIPT}"
# Sanctuary Launcher Scripts:6 ends here
