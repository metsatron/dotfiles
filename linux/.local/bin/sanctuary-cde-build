#!/usr/bin/env bash
# [[file:../../../distrobox.org::*Sanctuary Launcher Scripts][Sanctuary Launcher Scripts:17]]
# Build CDE 2.5.3 from source inside the sanctuary-cde container.
# Run once from the host: sanctuary-cde-build
# Uses the official CDE 2.5.3 release (SourceForge, 2025-11-25).
# NOT the 2012 arcfide/CDesktopEnv clone.
set -euo pipefail

CDE_VERSION="2.5.3"
GUIX_PROFILES="${HOME}/.guix-extra-profiles"

# Use a heredoc to build the inner script — inner double-quotes in the heredoc
# body are just text (no quoting-state effects on the outer shell).
# Outer-shell vars (CDE_VERSION, GUIX_PROFILES) expand at heredoc time;
# inner-shell vars (HOME, CDE_PREFIX, etc.) are deferred via backslash-$.
INNER_SCRIPT=$(cat <<INNER_EOF
set -eo pipefail

CDE_PREFIX=\${HOME}/.local/share/cde
CDE_SRC=\${HOME}/.local/share/cde-src
CDE_TARBALL=cde-${CDE_VERSION}.tar.gz
CDE_URL=https://downloads.sourceforge.net/project/cdesktopenv/src/\${CDE_TARBALL}

GUIX_PROFILE=${GUIX_PROFILES}/desktop-common/desktop-common
. \${GUIX_PROFILE}/etc/profile
GUIX_PROFILE=${GUIX_PROFILES}/sanctuary-cde/sanctuary-cde
. \${GUIX_PROFILE}/etc/profile
export CURL_CA_BUNDLE=\${GIT_SSL_CAINFO}

# Idempotent post-install fixups — run on every invocation (before early-exit).
if [ -d "\${CDE_PREFIX}/bin" ]; then
  # CDE ksh scripts hardcode /usr/bin/tr; Guix puts it at /bin/tr only.
  ln -sf /bin/tr /usr/bin/tr 2>/dev/null || true
  # Create fonts.dir so xset fp+ accepts the fontaliases directory.
  printf '0\n' > "\${CDE_PREFIX}/etc/cde/fontaliases/fonts.dir"
  # Fix hardcoded /usr/dt/bin/ paths in installed CDE action database.
  if ls "\${CDE_PREFIX}/appconfig/types/C/"*.dt >/dev/null 2>&1; then
    sed -i "s|/usr/dt/bin/|\${CDE_PREFIX}/bin/|g" \
      "\${CDE_PREFIX}"/appconfig/types/C/*.dt 2>/dev/null || true
  fi
  # Relabel the Vi text editor action to surface Neovim.
  if [ -f "\${CDE_PREFIX}/appconfig/types/C/uxstd.dt" ]; then
    sed -i 's/LABEL\s\+Vi$/LABEL           Neovim (vi)/g' \
        "\${CDE_PREFIX}/appconfig/types/C/uxstd.dt" 2>/dev/null || true
  fi
  # Write ~/.dtprofile to set DTINFOLIB for the CDE Information Manager.
  mkdir -p "\${HOME}/.dt"
  printf 'export DTINFOLIB=%s/.local/share/cde/infolib\n' "\${HOME}" \
      > "\${HOME}/.dtprofile"
  # Rebuild types.xdr with corrected dtinfo process-type start paths.
  PTYPE_DIR="\${CDE_SRC}/cde-${CDE_VERSION}/programs/tttypes"
  if [ -d "\${PTYPE_DIR}" ]; then
    sed -i "s|/usr/dt/infolib/|\${CDE_PREFIX}/infolib/|g" \
      "\${PTYPE_DIR}/dtinfo.ptype" "\${PTYPE_DIR}/dtinfo_start.ptype" 2>/dev/null || true
    sed -i "s|/usr/dt/bin/dtinfo|\${CDE_PREFIX}/bin/dtinfo|g" \
      "\${PTYPE_DIR}/dtinfo.ptype" 2>/dev/null || true
    _TTBUILD=\$(mktemp -d)
    (cd "\${PTYPE_DIR}"
     for _ptype in dtfile dticon dtpad dtcm dtmail dtdbcache dtterm dtinfo_start dtinfo; do
       [ -f "\${_ptype}.ptype" ] || continue
       TTPATH="\${_TTBUILD}" "\${CDE_PREFIX}/bin/tt_type_comp" -sd user -m "\${_ptype}.ptype" \
         2>/dev/null || true
     done)
    [ -f "\${_TTBUILD}/types.xdr" ] && \
      cp "\${_TTBUILD}/types.xdr" "\${CDE_PREFIX}/appconfig/tttypes/types.xdr"
    rm -rf "\${_TTBUILD}"
  fi
fi

if [ -f "\${CDE_PREFIX}/.dotcortex-cde-${CDE_VERSION}-complete" ]; then
  echo "CDE already installed at \${CDE_PREFIX} (fixups applied)"
  exit 0
fi

mkdir -p "\${CDE_SRC}"
cd "\${CDE_SRC}"

if [ ! -f "\${CDE_TARBALL}" ]; then
  echo "Downloading CDE ${CDE_VERSION} from SourceForge..."
  curl -L --retry 3 -o "\${CDE_TARBALL}" "\${CDE_URL}"
fi

tar xf "\${CDE_TARBALL}"
cd "cde-${CDE_VERSION}"

# GCC 15 treats 'nullptr' as a keyword even in -std=gnu17; ksh93 uses it as a variable name.
sed -i 's/\bnullptr\b/ksh_nullptr/g' \
  programs/dtksh/ksh93/src/cmd/ksh93/sh/xec.c

# CDE 2.5.3 ignores --prefix for its installation, configuration, and log roots:
# configure.ac derives them from the compiled-in /usr/dt default.  Keep the
# sanctuary build entirely in its guest home instead.  The PAM and calendar
# install rules also use absolute system paths and must follow those local roots.
sed -i \
  -e 's|CDE_INSTALLATION_TOP="\$ac_default_prefix"|CDE_INSTALLATION_TOP="\$prefix"|' \
  -e 's|CDE_LOGFILES_TOP=/var/dt|CDE_LOGFILES_TOP="\$prefix/var/dt"|' \
  -e 's|CDE_CONFIGURATION_TOP=/etc/dt|CDE_CONFIGURATION_TOP="\$prefix/etc/dt"|' \
  configure.ac
sed -i 's|pamdir = /etc/pam.d|pamdir = \$(CDE_CONFIGURATION_TOP)/pam.d|' \
  programs/dtlogin/config/Makefile.am \
  programs/dtsession/config/Makefile.am
sed -i 's|\$(DESTDIR)/var/spool/calendar|\$(DESTDIR)\$(CDE_LOGFILES_TOP)/spool/calendar|' \
  programs/dtcm/dtcm/Makefile.am
sed -i \
  -e 's|^	chown root .*$|	@echo "Skipping privileged root ownership in sanctuary build"|' \
  -e 's|^	chmod 4755 .*$|	@echo "Keeping user-owned executable mode in sanctuary build"|' \
  programs/dtterm/Makefile.am \
  programs/dtsearchpath/dtappg/Makefile.am

mkdir -p "\${CDE_SRC}/bin"
ln -sf "\$(which oksh)" "\${CDE_SRC}/bin/ksh"
export PATH="\${CDE_SRC}/bin:\${PATH}"

./autogen.sh
./configure --prefix="\${CDE_PREFIX}" --with-tcl=\${GUIX_PROFILE}/lib \
  CFLAGS="-std=gnu17 -g -O2 -I\${GUIX_PROFILE}/include/tirpc" \
  CXXFLAGS="-std=gnu++17 -g -O2 -I\${GUIX_PROFILE}/include/tirpc"
make -j\$(nproc)
make install
touch "\${CDE_PREFIX}/.dotcortex-cde-${CDE_VERSION}-complete"

echo "CDE ${CDE_VERSION} installed to \${CDE_PREFIX}"
echo "Launch with: sanctuary-cde-launch"
INNER_EOF
)
sanctuary-exec sanctuary-cde sh -c "${INNER_SCRIPT}"
# Sanctuary Launcher Scripts:17 ends here
