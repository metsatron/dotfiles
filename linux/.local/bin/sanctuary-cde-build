#!/usr/bin/env bash
# [[file:../../../sanctuary-distrobox.org::*Sanctuary Launcher Scripts][Sanctuary Launcher Scripts:23]]
# Build CDE 2.5.3 from source inside the sanctuary-cde container.
# Run once from the host: sanctuary-cde-build
# Uses the official CDE 2.5.3 release (SourceForge, 2025-11-25).
# NOT the 2012 arcfide/CDesktopEnv clone.
set -euo pipefail

usage() {
  cat <<EOF
sanctuary-cde-build - build CDE 2.5.3 inside sanctuary-cde

Usage: sanctuary-cde-build
       sanctuary-cde-build -h | --help

No arguments. Downloads, compiles, and installs the official CDE 2.5.3
release into the sanctuary-cde guest home.
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if (( $# > 0 )); then
  usage >&2
  exit 1
fi

CDE_VERSION="2.5.3"
SANCTUARY="sanctuary-cde"
GUIX_PROFILES="${HOME}/.guix-extra-profiles"

# Use a heredoc to build the inner script — inner double-quotes in the heredoc
# body are just text (no quoting-state effects on the outer shell).
# Outer-shell vars (CDE_VERSION, GUIX_PROFILES) expand at heredoc time;
# inner-shell vars (HOME, CDE_PREFIX, etc.) are deferred via backslash-$.
INNER_SCRIPT=$(cat <<INNER_EOF
set -eo pipefail

CDE_PREFIX=\${HOME}/.local/share/cde
CDE_SRC=\${HOME}/.local/share/cde-src
CDE_TARBALL=cde-${CDE_VERSION}.tar.gz
CDE_URL=https://downloads.sourceforge.net/project/cdesktopenv/src/\${CDE_TARBALL}

GUIX_PROFILE=${GUIX_PROFILES}/desktop-common/desktop-common
. \${GUIX_PROFILE}/etc/profile
GUIX_PROFILE=${GUIX_PROFILES}/sanctuary-cde/sanctuary-cde
. \${GUIX_PROFILE}/etc/profile
export CURL_CA_BUNDLE=\${GIT_SSL_CAINFO}

# Idempotent post-install fixups — run on every invocation (before early-exit).
if [ -d "\${CDE_PREFIX}/bin" ]; then
  # CDE ksh scripts hardcode /usr/bin/tr; Guix puts it at /bin/tr only.
  ln -sf /bin/tr /usr/bin/tr 2>/dev/null || true
  # Create fonts.dir so xset fp+ accepts the fontaliases directory.
  printf '0\n' > "\${CDE_PREFIX}/etc/cde/fontaliases/fonts.dir"
  # Fix hardcoded /usr/dt/bin/ paths in installed CDE action database.
  if ls "\${CDE_PREFIX}/appconfig/types/C/"*.dt >/dev/null 2>&1; then
    sed -i "s|/usr/dt/bin/|\${CDE_PREFIX}/bin/|g" \
      "\${CDE_PREFIX}"/appconfig/types/C/*.dt 2>/dev/null || true
  fi
  # Relabel the Vi text editor action to surface Neovim.
  if [ -f "\${CDE_PREFIX}/appconfig/types/C/uxstd.dt" ]; then
    sed -i 's/LABEL\s\+Vi$/LABEL           Neovim (vi)/g' \
        "\${CDE_PREFIX}/appconfig/types/C/uxstd.dt" 2>/dev/null || true
  fi
  # Write ~/.dtprofile to set DTINFOLIB for the CDE Information Manager.
  mkdir -p "\${HOME}/.dt"
  printf 'export DTINFOLIB=%s/.local/share/cde/infolib\n' "\${HOME}" \
      > "\${HOME}/.dtprofile"
  # Rebuild types.xdr with corrected dtinfo process-type start paths.
  PTYPE_DIR="\${CDE_SRC}/cde-${CDE_VERSION}/programs/tttypes"
  if [ -d "\${PTYPE_DIR}" ]; then
    sed -i "s|/usr/dt/infolib/|\${CDE_PREFIX}/infolib/|g" \
      "\${PTYPE_DIR}/dtinfo.ptype" "\${PTYPE_DIR}/dtinfo_start.ptype" 2>/dev/null || true
    sed -i "s|/usr/dt/bin/dtinfo|\${CDE_PREFIX}/bin/dtinfo|g" \
      "\${PTYPE_DIR}/dtinfo.ptype" 2>/dev/null || true
    _TTBUILD=\$(mktemp -d)
    (cd "\${PTYPE_DIR}"
     for _ptype in dtfile dticon dtpad dtcm dtmail dtdbcache dtterm dtinfo_start dtinfo; do
       [ -f "\${_ptype}.ptype" ] || continue
       TTPATH="\${_TTBUILD}" "\${CDE_PREFIX}/bin/tt_type_comp" -sd user -m "\${_ptype}.ptype" \
         2>/dev/null || true
     done)
    [ -f "\${_TTBUILD}/types.xdr" ] && \
      cp "\${_TTBUILD}/types.xdr" "\${CDE_PREFIX}/appconfig/tttypes/types.xdr"
    rm -rf "\${_TTBUILD}"
  fi
  # ── DotCortex extended fixups (idempotent, run on every invocation) ──────
  # 1. Disable CDE auto-lock: dtlock cannot authenticate in Xephyr/rootless
  #    container. saverTimeout (screen blank) is kept; lockTimeout=0 ensures
  #    the password prompt never appears.
  sed -i 's/^dtsession\*lockTimeout:.*$/dtsession*lockTimeout:   0/' \
      "\${CDE_PREFIX}/config/C/sys.resources" 2>/dev/null || true
  # 2. Replace dtlock binary with a non-locking screen blanker (idempotent).
  #    The FrontPanel Lock button calls dtlock via dtsession; this wrapper
  #    activates X11 blanking instead of demanding a password.
  if [ -f "\${CDE_PREFIX}/bin/dtlock" ] && \
     ! grep -q 'DotCortex dtlock wrapper' "\${CDE_PREFIX}/bin/dtlock" 2>/dev/null; then
    mv "\${CDE_PREFIX}/bin/dtlock" "\${CDE_PREFIX}/bin/dtlock.real"
  fi
  printf '#!/bin/sh\n# DotCortex dtlock wrapper: blank screen instead of locking.\n# PAM auth unavailable in Xephyr/rootless container.\nexec xset s activate\n' > "\${CDE_PREFIX}/bin/dtlock"
  chmod +x "\${CDE_PREFIX}/bin/dtlock"
  # 3. Guard starship init in guest ~/.bashrc (Bash is the default dtterm shell).
  if ! grep -q 'command -v starship' "\${HOME}/.bashrc" 2>/dev/null; then
    cat >> "\${HOME}/.bashrc" <<'BASHRC_STARSHIP'
command -v starship >/dev/null 2>&1 && eval "\$(starship init bash)" || true
BASHRC_STARSHIP
  fi
  # 4. CDE action binary name wrappers (idempotent).
  #    chromium.dt calls chromium-browser; ungoogled-chromium (Guix) provides chromium.
  #    thunderbird.dt calls thunderbird; icedove (Guix libre name) provides icedove.
  #    supertux.dt calls supertux; the Guix supertux package provides supertux2.
  mkdir -p "\${CDE_PREFIX}/bin"
  if command -v chromium >/dev/null 2>&1; then
cat > "\${CDE_PREFIX}/bin/chromium-browser" <<'CHROMIUM_BROWSER_WRAPPER'
#!/bin/sh
shelf="\${HOME}/.local/share/cde/extensions/chromium"
extensions=""
if [ -d "\${shelf}" ]; then
    extensions="\$(find "\${shelf}" -mindepth 2 -maxdepth 2 -name manifest.json -printf '%h\n' 2>/dev/null | sort | paste -sd, -)"
fi
if [ -n "\${extensions}" ]; then
    exec chromium --load-extension="\${extensions}" "\$@"
fi
exec chromium "\$@"
CHROMIUM_BROWSER_WRAPPER
    chmod +x "\${CDE_PREFIX}/bin/chromium-browser"
  fi
  if command -v icedove >/dev/null 2>&1; then
    printf '#!/bin/sh\nexec icedove "\$@"\n' > "\${CDE_PREFIX}/bin/thunderbird"
    chmod +x "\${CDE_PREFIX}/bin/thunderbird"
  fi
  if command -v supertux2 >/dev/null 2>&1; then
    printf '#!/bin/sh\nexec supertux2 "\$@"\n' > "\${CDE_PREFIX}/bin/supertux"
    chmod +x "\${CDE_PREFIX}/bin/supertux"
  fi
  # 5. Write sanctuary.dt — DotCortex CDE action additions (idempotent rewrite).
  cat > "\${CDE_PREFIX}/appconfig/types/C/sanctuary.dt" <<'SANCTUARY_DT'
# sanctuary.dt -- DotCortex CDE action additions.
# Managed by sanctuary-cde-build. Do not edit by hand.
ACTION ZshTerminal
{
        LABEL           Zsh Terminal
        ARG_COUNT       0
        TYPE            COMMAND
        WINDOW_TYPE     NO_STDIO
        EXEC_STRING     dtterm -title "Zsh Terminal" -e zsh -l
        DESCRIPTION     Open a Zsh terminal with Starship prompt.
}
ACTION TuxPaintWindowed
{
        LABEL           Tux Paint Windowed
        ARG_COUNT       0
        TYPE            COMMAND
        WINDOW_TYPE     NO_STDIO
        EXEC_STRING     tuxpaint-windowed
        DESCRIPTION     Tux Paint in a CDE window (quiet, windowed, no input grab).
}
ACTION GeoGebraClassic
{
        LABEL           GeoGebra Classic
        ARG_COUNT       0
        TYPE            COMMAND
        WINDOW_TYPE     NO_STDIO
        EXEC_STRING     geogebra
        DESCRIPTION     GeoGebra Classic 5 -- interactive mathematics for education.
}
ACTION CalendarNetworkSharingStatus
{
        LABEL           Calendar Network Sharing
        ARG_COUNT       0
        TYPE            COMMAND
        WINDOW_TYPE     TERMINAL
        EXEC_STRING     sh -c 'echo "UNRESOLVED: Calendar network sharing"; echo; echo "rpc.cmsd needs rpcbind on port 111 -- unavailable in rootless"; echo "container. FrontPanel Calendar opens dtcm (local mode only)."; echo; echo "Press Enter to close..."; read _'
        DESCRIPTION     Calendar network sharing (unresolved -- rpcbind not available).
}
ACTION MailerServerStatus
{
        LABEL           Mail Server Setup
        ARG_COUNT       0
        TYPE            COMMAND
        WINDOW_TYPE     TERMINAL
        EXEC_STRING     sh -c 'echo "UNRESOLVED: Mail server (MTA) not configured"; echo; echo "dtmail shows local mbox files. Sending or receiving mail requires"; echo "Sendmail, Postfix, or another MTA -- not present in this container."; echo; echo "Press Enter to close..."; read _'
        DESCRIPTION     Mailer -- dtmail works but no MTA configured in this container.
}
ACTION Dtmail
{
        LABEL           Mailer
        ICON            DtMail
        ARG_COUNT       0
        TYPE            COMMAND
        WINDOW_TYPE     NO_STDIO
        EXEC_STRING     /home/metsatron/.local/share/dotcortex/guests/sanctuary-cde/home/.local/share/cde/bin/dtmail
        DESCRIPTION     The Mailer action opens the CDE mail client (dtmail).
}
SANCTUARY_DT
fi

if [ -f "\${CDE_PREFIX}/.dotcortex-cde-${CDE_VERSION}-complete" ]; then
  echo "CDE already installed at \${CDE_PREFIX} (fixups applied)"
  exit 0
fi

mkdir -p "\${CDE_SRC}"
cd "\${CDE_SRC}"

if [ ! -f "\${CDE_TARBALL}" ]; then
  echo "Downloading CDE ${CDE_VERSION} from SourceForge..."
  curl -L --retry 3 -o "\${CDE_TARBALL}" "\${CDE_URL}"
fi

tar xf "\${CDE_TARBALL}"
cd "cde-${CDE_VERSION}"

# GCC 15 treats 'nullptr' as a keyword even in -std=gnu17; ksh93 uses it as a variable name.
sed -i 's/\bnullptr\b/ksh_nullptr/g' \
  programs/dtksh/ksh93/src/cmd/ksh93/sh/xec.c

# CDE 2.5.3 ignores --prefix for its installation, configuration, and log roots:
# configure.ac derives them from the compiled-in /usr/dt default.  Keep the
# sanctuary build entirely in its guest home instead.  The PAM and calendar
# install rules also use absolute system paths and must follow those local roots.
sed -i \
  -e 's|CDE_INSTALLATION_TOP="\$ac_default_prefix"|CDE_INSTALLATION_TOP="\$prefix"|' \
  -e 's|CDE_LOGFILES_TOP=/var/dt|CDE_LOGFILES_TOP="\$prefix/var/dt"|' \
  -e 's|CDE_CONFIGURATION_TOP=/etc/dt|CDE_CONFIGURATION_TOP="\$prefix/etc/dt"|' \
  configure.ac
sed -i 's|pamdir = /etc/pam.d|pamdir = \$(CDE_CONFIGURATION_TOP)/pam.d|' \
  programs/dtlogin/config/Makefile.am \
  programs/dtsession/config/Makefile.am
sed -i 's|\$(DESTDIR)/var/spool/calendar|\$(DESTDIR)\$(CDE_LOGFILES_TOP)/spool/calendar|' \
  programs/dtcm/dtcm/Makefile.am
sed -i \
  -e 's|^	chown root .*$|	@echo "Skipping privileged root ownership in sanctuary build"|' \
  -e 's|^	chmod 4755 .*$|	@echo "Keeping user-owned executable mode in sanctuary build"|' \
  programs/dtterm/Makefile.am \
  programs/dtsearchpath/dtappg/Makefile.am

mkdir -p "\${CDE_SRC}/bin"
ln -sf "\$(which oksh)" "\${CDE_SRC}/bin/ksh"
export PATH="\${CDE_SRC}/bin:\${PATH}"

./autogen.sh
./configure --prefix="\${CDE_PREFIX}" --with-tcl=\${GUIX_PROFILE}/lib \
  CFLAGS="-std=gnu17 -g -O2 -I\${GUIX_PROFILE}/include/tirpc" \
  CXXFLAGS="-std=gnu++17 -g -O2 -I\${GUIX_PROFILE}/include/tirpc"
make -j\$(nproc)
make install
touch "\${CDE_PREFIX}/.dotcortex-cde-${CDE_VERSION}-complete"

echo "CDE ${CDE_VERSION} installed to \${CDE_PREFIX}"
echo "Launch with: sanctuary-cde-launch"
INNER_EOF
)
sanctuary-exec sanctuary-cde sh -c "${INNER_SCRIPT}"

# Fix dtmail execution group: must be setgid mail (CDE Makefile.am:50 intent).
# sanctuary-exec runs as UID 1000 (metsatron) and cannot groupadd or chgrp to a
# group the user is not a member of, so this step runs as container root (UID 0 =
# host metsatron in rootless Podman user namespace).
podman exec --user 0 "${SANCTUARY}" sh -c "
    if ! getent group mail >/dev/null 2>&1; then
        groupadd -g 8 mail 2>/dev/null || groupadd mail 2>/dev/null || true
    fi
    CDE_BIN=\${HOME}/.local/share/cde/bin
    if [ -f \"\${CDE_BIN}/dtmail\" ]; then
        chgrp mail \"\${CDE_BIN}/dtmail\"  2>/dev/null || true
        chmod 2755 \"\${CDE_BIN}/dtmail\" 2>/dev/null || true
    fi
    install -d -o root -g mail -m 2775 /var/mail
    install -o metsatron -g mail -m 0660 /dev/null /var/mail/metsatron 2>/dev/null || true
" 2>/dev/null || true
# Sanctuary Launcher Scripts:23 ends here
