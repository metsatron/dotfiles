#!/bin/bash
# [[file:../../../distrobox.org::*xclass Explorer launcher wrapper][xclass Explorer launcher wrapper:6]]
# dsdmine expects assets/ next to the binary; cd to the install dir.
# Source room-gaming for libSDL2 (dsdmine dynamically links it).
set -eo pipefail
GP="${HOME}/.guix-extra-profiles"
GUIX_PROFILE="${GP}/room-gaming/room-gaming"
[[ -f "${GUIX_PROFILE}/etc/profile" ]] && . "${GUIX_PROFILE}/etc/profile" 2>/dev/null || true
export NO_AT_BRIDGE=1
DSDMINE_DIR="${HOME}/.local/share/dsdmine"
cd "${DSDMINE_DIR}"
exec "${DSDMINE_DIR}/dsdmine" "$@"
# xclass Explorer launcher wrapper:6 ends here
