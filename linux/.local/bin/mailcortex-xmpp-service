#!/usr/bin/env bash
set -euo pipefail

# Cron on Devuan does not include the system networking helpers by default.
PATH="${PATH:-/usr/local/bin:/usr/bin:/bin}:/usr/local/sbin:/usr/sbin:/sbin"
export PATH

usage() {
  cat <<'EOF'
Usage: mailcortex-xmpp-service {start|stop|status|ensure|renew-cert|install-cron|remove-cron|-h|--help}
       mailcortex-xmpp-service rooms ensure [--dry-run]
Own the user Prosody instance and mailcortex-xmpp-bridge on this host.
rooms ensure reconciles private squadron rooms through the local admin shell.
It never starts, restarts or connects as the bridge; --dry-run plans only.
ensure starts whatever is not running (boot and self-heal entrypoint).
renew-cert refreshes the TLS certificate named in xmpp-private/cert-domain.
Nothing starts until ~/.config/mailcortex/xmpp-private/{local.cfg.lua,bridge.json} exist.
EOF
}

base="$HOME/.config/mailcortex/xmpp"
site="$HOME/.config/mailcortex/xmpp-private"
data="$HOME/.local/share/mailcortex/xmpp"
state="$HOME/.local/state/mailcortex/xmpp"
config="$base/prosody.cfg.lua"
prosody_pid="$data/prosody.pid"
bridge_pid="$state/bridge.pid"
tag="# dotcortex:mailcortex-xmpp"

ready() {
  [ -r "$config" ] && [ -r "$site/local.cfg.lua" ] && [ -r "$site/bridge.json" ] || {
    echo "mailcortex-xmpp-service: not ready (private site files missing in $site)" >&2
    return 1
  }
}

alive() { # pidfile pattern
  local pid
  [ -r "$1" ] || return 1
  pid="$(cat "$1" 2>/dev/null)"
  case "$pid" in ''|*[!0-9]*) return 1 ;; esac
  [ -r "/proc/$pid/cmdline" ] && tr '\0' ' ' < "/proc/$pid/cmdline" | grep -q -- "$2"
}

start_prosody() {
  alive "$prosody_pid" "$config" && return 0
  install -d -m 700 "$data" "$data/data"
  nohup prosody --config "$config" >>"$data/prosody.stdout" 2>&1 &
  for _ in $(seq 1 20); do alive "$prosody_pid" "$config" && return 0; sleep 0.5; done
  echo "mailcortex-xmpp-service: prosody did not come up (see $data/prosody.err)" >&2
  return 1
}

# Read only quoted list members from one top-level Lua assignment. The output
# is consumed by a private process substitution; it never reaches this
# service's stdout, stderr or log.
private_lua_strings() {
  awk -v want="$1" '
    {
      line = $0
      if (!inside) {
        if (line !~ "^[[:space:]]*" want "[[:space:]]*=[[:space:]]*[{]") next
        inside = 1
        sub(/^[^{]*[{]/, "", line)
      }
      while (match(line, /"[^"]*"|\047[^\047]*\047/)) {
        token = substr(line, RSTART, RLENGTH)
        print substr(token, 2, RLENGTH - 2)
        line = substr(line, RSTART + RLENGTH)
      }
      if (index(line, "}") > 0) exit
    }
  ' "$site/local.cfg.lua"
}

private_lua_numbers() {
  awk -v want="$1" '
    {
      line = $0
      if (!inside) {
        if (line !~ "^[[:space:]]*" want "[[:space:]]*=[[:space:]]*[{]") next
        inside = 1
        sub(/^[^{]*[{]/, "", line)
      }
      while (match(line, /[0-9]+/)) {
        print substr(line, RSTART, RLENGTH)
        line = substr(line, RSTART + RLENGTH)
      }
      if (index(line, "}") > 0) exit
    }
  ' "$site/local.cfg.lua"
}

load_expected_listeners() {
  local -a c2s_interfaces=() c2s_ports=() https_interfaces=() https_ports=()
  local interface port
  expected_listeners=()
  while IFS= read -r interface; do
    [ -n "$interface" ] && c2s_interfaces+=("$interface")
  done < <(private_lua_strings c2s_interfaces)
  [ "${#c2s_interfaces[@]}" -gt 0 ] || {
    echo "mailcortex-xmpp-service: private c2s_interfaces is missing or empty" >&2
    return 1
  }
  while IFS= read -r port; do
    [ -n "$port" ] && c2s_ports+=("$port")
  done < <(private_lua_numbers c2s_ports)
  [ "${#c2s_ports[@]}" -gt 0 ] || c2s_ports=(5222)
  for interface in "${c2s_interfaces[@]}"; do
    for port in "${c2s_ports[@]}"; do
      expected_listeners+=("$interface|$port")
    done
  done

  while IFS= read -r interface; do
    [ -n "$interface" ] && https_interfaces+=("$interface")
  done < <(private_lua_strings https_interfaces)
  [ "${#https_interfaces[@]}" -eq 0 ] && return 0
  while IFS= read -r port; do
    [ -n "$port" ] && https_ports+=("$port")
  done < <(private_lua_numbers https_ports)
  [ "${#https_ports[@]}" -gt 0 ] || {
    echo "mailcortex-xmpp-service: private https_interfaces has no https_ports" >&2
    return 1
  }
  for interface in "${https_interfaces[@]}"; do
    for port in "${https_ports[@]}"; do
      expected_listeners+=("$interface|$port")
    done
  done
}

listener_has_endpoint() {
  local address="$1" port="$2" endpoint candidate
  while read -r _ _ _ endpoint _; do
    case "$endpoint" in
      *":$port") candidate="${endpoint%:$port}" ;;
      *) continue ;;
    esac
    candidate="${candidate#[}"
    candidate="${candidate%]}"
    [ "$candidate" = "$address" ] && return 0
  done <<< "$listener_snapshot"
  return 1
}

interface_has_address() {
  local address="$1" cidr
  while read -r _ _ _ cidr _; do
    [ "${cidr%%/*}" = "$address" ] && return 0
  done <<< "$interface_snapshot"
  return 1
}

check_prosody_listeners() {
  local expected address port missing_local=0 missing_absent=0
  load_expected_listeners || return 1
  command -v ss >/dev/null 2>&1 || {
    echo "mailcortex-xmpp-service: ss is unavailable; cannot verify Prosody listeners" >&2
    return 1
  }
  command -v ip >/dev/null 2>&1 || {
    echo "mailcortex-xmpp-service: ip is unavailable; cannot verify local interfaces" >&2
    return 1
  }
  if ! listener_snapshot="$(ss -H -ltn 2>/dev/null)"; then
    echo "mailcortex-xmpp-service: ss listener probe failed" >&2
    return 1
  fi
  if ! interface_snapshot="$(ip -o address show 2>/dev/null)"; then
    echo "mailcortex-xmpp-service: local interface probe failed" >&2
    return 1
  fi
  for expected in "${expected_listeners[@]}"; do
    address="${expected%%|*}"
    port="${expected#*|}"
    listener_has_endpoint "$address" "$port" && continue
    if interface_has_address "$address"; then
      missing_local=1
    else
      missing_absent=1
    fi
  done
  if [ "$missing_absent" -eq 1 ]; then
    echo "mailcortex-xmpp-service: expected listener address is not present yet; retrying" >&2
  fi
  [ "$missing_local" -eq 0 ] || return 11
  [ "$missing_absent" -eq 0 ] || return 10
  return 0
}

ensure_prosody() {
  local rc
  start_prosody
  if check_prosody_listeners; then
    return 0
  else
    rc=$?
  fi
  case "$rc" in
    10) return 10 ;;
    11)
      echo "mailcortex-xmpp-service: expected Prosody listener is missing; restarting Prosody" >&2
      stop_one "$prosody_pid" "$config"
      start_prosody
      if check_prosody_listeners; then
        return 0
      else
        rc=$?
      fi
      [ "$rc" -eq 10 ] && return 10
      echo "mailcortex-xmpp-service: Prosody listener check still failed after restart" >&2
      return 1
      ;;
    *) return "$rc" ;;
  esac
}

start_bridge() {
  alive "$bridge_pid" mailcortex-xmpp-bridge && return 0
  install -d -m 700 "$state"
  mailcortex-xmpp-bridge --check >/dev/null
  nohup mailcortex-xmpp-bridge >>"$state/bridge.log" 2>&1 &
  echo $! > "$bridge_pid"
  sleep 1
  alive "$bridge_pid" mailcortex-xmpp-bridge || {
    echo "mailcortex-xmpp-service: bridge exited (see $state/bridge.log)" >&2
    return 1
  }
}

stop_one() { # pidfile pattern
  if alive "$1" "$2"; then kill "$(cat "$1")"; fi
  rm -f "$1"
}

status() {
  local rc=0
  if alive "$prosody_pid" "$config"; then echo "prosody: running ($(cat "$prosody_pid"))"; else echo "prosody: stopped"; rc=1; fi
  if alive "$bridge_pid" mailcortex-xmpp-bridge; then echo "bridge: running ($(cat "$bridge_pid"))"; else echo "bridge: stopped"; rc=1; fi
  return $rc
}

case "${1:-}" in
  -h|--help) usage ;;
  rooms)
    shift
    if [ "${1:-}" != ensure ]; then usage >&2; exit 2; fi
    shift
    helper="${MAILCORTEX_XMPP_ROOMS_HELPER:-$HOME/.local/share/dotcortex/mailcortex/xmpp-rooms.py}"
    [ -r "$helper" ] || {
      echo "mailcortex-xmpp-service: room helper unavailable; tangle and stow the rooms module" >&2
      exit 1
    }
    exec python3 "$helper" --prosody-config "$config" "$@"
    ;;
  start|ensure)
    ready
    if ensure_prosody; then
      start_bridge
    else
      rc=$?
      [ "$rc" -eq 10 ] && exit 0
      exit "$rc"
    fi
    ;;
  stop) stop_one "$bridge_pid" mailcortex-xmpp-bridge; stop_one "$prosody_pid" "$config" ;;
  status) status ;;
  renew-cert)
    [ -r "$site/cert-domain" ] || { echo "mailcortex-xmpp-service: no $site/cert-domain" >&2; exit 1; }
    domain="$(tr -d '[:space:]' < "$site/cert-domain")"
    crt="$site/certs/$domain.crt"
    before="$(sha256sum "$crt" 2>/dev/null | cut -d' ' -f1 || true)"
    mailcortex-xmpp-cert "$domain"
    after="$(sha256sum "$crt" | cut -d' ' -f1)"
    if [ "$before" != "$after" ] && alive "$prosody_pid" "$config"; then
      kill -HUP "$(cat "$prosody_pid")"; echo "certificate changed; prosody reloaded"
    else
      echo "certificate unchanged"
    fi
    mailcortex-xmpp-cert "$domain" --check ;;
  install-cron)
    ready
    self="$HOME/.local/bin/mailcortex-xmpp-service"
    env="HOME=$HOME PATH=$HOME/.local/bin:/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin"
    current="$(crontab -l 2>/dev/null || true)"
    if printf '%s\n' "$current" | grep -qF "$tag"; then echo "cron already installed"; exit 0; fi
    { printf '%s\n' "$current" | sed '/^$/d'
      echo "@reboot $env $self ensure >>$state/cron.log 2>&1 $tag"
      echo "*/5 * * * * $env $self ensure >>$state/cron.log 2>&1 $tag"
      echo "23 4 * * 1 $env $self renew-cert >>$state/cron.log 2>&1 $tag"
    } | crontab -
    echo "cron installed" ;;
  remove-cron)
    (crontab -l 2>/dev/null || true) | grep -vF "$tag" | crontab -
    echo "cron removed" ;;
  *) usage >&2; exit 2 ;;
esac
