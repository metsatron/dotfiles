#!/usr/bin/env bash
# Host adb access: the Android udev rule

# The Odin is reached over USB from a Linux host (the T480s today). adb needs
# the device node writable by the operator, and the fleet's Devuan hosts run
# without systemd-logind, so the =uaccess= tag grants nothing; access comes from
# =GROUP="plugdev"= instead. The rule was hand-laid on the T480s on 2026-09-15.
# This section makes it reproducible: =android-udev-install= carries the
# canonical rule, installs it root-owned into =/etc/udev/rules.d/=, and reloads
# udev so it applies without a reboot. =--check= compares the live file byte for
# byte and confirms the operator is in =plugdev=. The deploy script above runs
# that check first, so a reimaged host fails loudly rather than with adb's bare
# "no permissions".

# It follows the fleet's =/etc= provisioning shape (=herdr-web-boot-install=,
# =storage-maintenance=): one installer in =linux/.local/bin=, =--dry-run= and
# =--check= modes, privilege only through =sudo -n=.


# [[file:../../../odin.org::*Host adb access: the Android udev rule][Host adb access: the Android udev rule:1]]
set -euo pipefail

TAG="dotcortex-android-udev"
DEFAULT_TARGET="/etc/udev/rules.d/51-android.rules"
target="${ANDROID_UDEV_TARGET:-$DEFAULT_TARGET}"
user_name="${ANDROID_UDEV_USER:-$(id -un)}"

usage() {
  cat <<'EOF'
Usage: android-udev-install [--dry-run|--check|--help]

Install the host udev rule that gives the plugdev group adb/fastboot access
to Android devices (AYN Odin Lite / MediaTek 0e8d; Google bootloader 18d1).
  (no flag)  install root-owned to /etc/udev/rules.d/51-android.rules via
             sudo -n, then reload udev rules and re-trigger USB devices
  --dry-run  print the rule; change nothing
  --check    exit 0 only if the live rule matches byte for byte and the
             operator is in plugdev; change nothing
EOF
}

mode=install
case "${1:-}" in
  --help|-h) usage; exit 0 ;;
  --dry-run) mode=dry-run ;;
  --check) mode=check ;;
  '') ;;
  *) usage >&2; exit 2 ;;
esac

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
cat >"$tmp" <<'EOF'
# Android adb/fastboot device access — DotCortex fleet (Odin-Lite-Revival, 2026-09-15)
# metsatron is in the plugdev group; Devuan has no systemd-logind, so use GROUP not uaccess.
# MediaTek (AYN Odin Lite / MT6877 — adb enumerates as VID 0e8d)
SUBSYSTEM=="usb", ATTR{idVendor}=="0e8d", MODE="0660", GROUP="plugdev"
# Google / common bootloader-fastboot VID (for the later, deferred unlock phase)
SUBSYSTEM=="usb", ATTR{idVendor}=="18d1", MODE="0660", GROUP="plugdev"
EOF

in_plugdev() {
  id -nG "$user_name" 2>/dev/null | tr ' ' '\n' | grep -qx plugdev
}

case "$mode" in
  dry-run)
    cat "$tmp"
    exit 0
    ;;
  check)
    cmp -s "$tmp" "$target" || {
      printf '%s: drift or missing target: %s\n' "$TAG" "$target" >&2
      exit 1
    }
    in_plugdev || {
      printf '%s: %s is not in plugdev; the rule grants nothing\n' "$TAG" "$user_name" >&2
      exit 1
    }
    printf '%s: installed rule matches %s\n' "$TAG" "$target"
    exit 0
    ;;
esac

if cmp -s "$tmp" "$target"; then
  printf '%s: already installed: %s\n' "$TAG" "$target"
elif [ "$target" = "$DEFAULT_TARGET" ]; then
  getent group plugdev >/dev/null || {
    printf '%s: group plugdev does not exist on this host\n' "$TAG" >&2
    exit 1
  }
  sudo -n install -m 0644 -o root -g root "$tmp" "$target"
  sudo -n udevadm control --reload-rules
  sudo -n udevadm trigger --subsystem-match=usb
  printf '%s: installed %s and reloaded udev\n' "$TAG" "$target"
else
  install -m 0644 "$tmp" "$target"
  printf '%s: installed %s\n' "$TAG" "$target"
fi
in_plugdev || printf '%s: warning: %s is not in plugdev (sudo usermod -aG plugdev %s, then log in again)\n' "$TAG" "$user_name" "$user_name" >&2
# Host adb access: the Android udev rule:1 ends here
