#!/usr/bin/env bash
set -euo pipefail
REPO="${DOTCORTEX_ROOT:-$HOME/DotCortex}"
SCHEMES="$REPO/linux/.config/redstone-9x/schemes"
gen=0 skip=0
for scheme in "$SCHEMES"/*.scheme; do
  [ -f "$scheme" ] || continue
  style="$(. "$scheme" 2>/dev/null; printf %s "${BACKDROP_STYLE:-}")"
  [ -n "$style" ] || continue
  eval "$(. "$scheme" 2>/dev/null; printf 'light=%q dark=%q palette=%q size=%q args=%q wall=%q' \
    "${BACKDROP_LIGHT:-}" "${BACKDROP_DARK:-}" "${BACKDROP_PALETTE:-}" \
    "${BACKDROP_SIZE:-1920x1080}" "${BACKDROP_ARGS:-}" "${WALLPAPER:-}")"
  if [ -z "$wall" ]; then
    echo "SKIP $(basename "$scheme"): BACKDROP_STYLE set but no WALLPAPER path" >&2
    skip=$((skip+1)); continue
  fi
  # Map the guest-home wallpaper path back to its repo source.
  dest="${wall/#$HOME\//$REPO/linux/}"
  mkdir -p "$(dirname "$dest")"
  tmp="$(mktemp --suffix=.png)"
  cmd=(dither-backdrop "$style" "$tmp" --size "$size")
  [ -z "$light" ] || cmd+=(--light "$light")
  [ -z "$dark" ] || cmd+=(--dark "$dark")
  [ -z "$palette" ] || cmd+=(--palette "$palette")
  if [ -n "$args" ]; then
    # BACKDROP_ARGS is intentionally simple whitespace-separated flags.
    # shellcheck disable=SC2206
    extra=( $args )
    cmd+=("${extra[@]}")
  fi
  "${cmd[@]}" >/dev/null
  if [ -f "$dest" ] && cmp -s "$tmp" "$dest"; then
    rm -f "$tmp"; skip=$((skip+1))
    echo "unchanged $(basename "$scheme") -> ${dest#$REPO/}"
  else
    mv -f "$tmp" "$dest"; gen=$((gen+1))
    echo "generated $(basename "$scheme") -> ${dest#$REPO/} ($style $size)"
  fi
done
echo "backdrop-gen: $gen generated, $skip unchanged/skipped"
