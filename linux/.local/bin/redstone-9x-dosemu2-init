#!/bin/bash
# DOSEMU2 bridge scaffold

# DOSEMU2 uses the Redstone runtime spine's generated DOS projection.  The mutable
# guest DOS bridge remains under =~/.dosemu/=, but =C:\REDSTONE= is backed by the
# host-visible =~/.compat/generated/dos/c/REDSTONE= tree.


# [[file:../../../sanctuary-redstone-9x-desktop.org::*DOSEMU2 bridge scaffold][DOSEMU2 bridge scaffold:1]]
set -euo pipefail

COMPAT_BIN="${HOME}/.local/bin/redstone-9x-compat-init"
[[ -x "${COMPAT_BIN}" ]] && "${COMPAT_BIN}" --quiet

DOSEMU_HOME="${HOME}/.dosemu"
DRIVE_C="${DOSEMU_HOME}/drive_c"
GENERATED_ROOT="${REDSTONE_COMPAT_ROOT:-${HOME}/.compat}/generated/dos/c/REDSTONE"
REDSTONE_LINK="${DRIVE_C}/redstone"
BIN_DIR="${GENERATED_ROOT}/USR/BIN"
ETC_DIR="${GENERATED_ROOT}/ETC"
OPT_DIR="${GENERATED_ROOT}/OPT"
SHARE_DIR="${GENERATED_ROOT}/SHARE"
HOME_DIR="${GENERATED_ROOT}/HOME"
TMP_DIR="${GENERATED_ROOT}/TMP"
VAR_DIR="${GENERATED_ROOT}/VAR"
HOOK_BAT="${DRIVE_C}/userhook.bat"
HOOK_SYS="${DRIVE_C}/userhook.sys"

mkdir -p "${DRIVE_C}" "${BIN_DIR}" "${ETC_DIR}" "${OPT_DIR}" "${SHARE_DIR}" "${HOME_DIR}" "${TMP_DIR}" "${VAR_DIR}"
if [[ ! -e "${REDSTONE_LINK}" || -L "${REDSTONE_LINK}" ]]; then
  ln -sfnT "${GENERATED_ROOT}" "${REDSTONE_LINK}"
fi

cat > "${HOOK_BAT}" <<'EOF'
@ECHO OFF
SET REDSTONE_HOME=C:\REDSTONE
SET PATH=C:\REDSTONE\USR\BIN;%PATH%
SET TEMP=C:\REDSTONE\TMP
SET TMP=C:\REDSTONE\TMP
IF EXIST C:\REDSTONE\ETC\AUTOEXEC.BAT CALL C:\REDSTONE\ETC\AUTOEXEC.BAT
EOF

if [[ ! -f "${HOOK_SYS}" ]]; then
  cat > "${HOOK_SYS}" <<'EOF'
REM Redstone 9X DOSEMU2 hook placeholder.
REM Add CONFIG.SYS-style directives here only when a DOS program needs them.
EOF
fi

if [[ ! -f "${BIN_DIR}/README.BAT" ]]; then
  cat > "${BIN_DIR}/README.BAT" <<'EOF'
@ECHO OFF
ECHO Redstone 9X DOS launchers live in C:\REDSTONE\USR\BIN
ECHO Unix-side wrappers live at ~/.local/bin/redstone-9x-dos-*
EOF
fi
# DOSEMU2 bridge scaffold:1 ends here
