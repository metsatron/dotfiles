#!/usr/bin/env bash
# [[file:../../../sanctuary-distrobox.org::*Sanctuary Launcher Scripts][Sanctuary Launcher Scripts:10]]
# One-shot: export CDE :92 PRIMARY selection to the host CLIPBOARD and PRIMARY.
# Run from any host terminal, tmux, or SSH while the CDE session is live.
# Usage: cde-copy-to-host [<cde-display>]
set -euo pipefail
CDE_DISPLAY="${1:-:92}"
HOST_DISPLAY="${DISPLAY:-:0}"
content=$(DISPLAY="${CDE_DISPLAY}" xclip -selection primary -o 2>/dev/null) \
    || { echo "cde-copy-to-host: nothing in CDE PRIMARY selection on ${CDE_DISPLAY}" >&2; exit 1; }
printf '%s' "${content}" | DISPLAY="${HOST_DISPLAY}" xclip -selection clipboard -i
printf '%s' "${content}" | DISPLAY="${HOST_DISPLAY}" xclip -selection primary   -i
printf 'Copied %d bytes from CDE:%s to host:%s clipboard.\n' \
    "${#content}" "${CDE_DISPLAY}" "${HOST_DISPLAY}"
# Sanctuary Launcher Scripts:10 ends here
