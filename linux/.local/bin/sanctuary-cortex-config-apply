#!/usr/bin/env bash
# [[file:../../../sanctuary-cortex.org::*Private migration bridges][Private migration bridges:4]]
set -euo pipefail

PRIVATE_ROOT="${SANCTUARY_CORTEX_PRIVATE_ROOT:-$HOME/HelmCortex/NEXUS/sanctuaries/sanctuary-cortex}"
SOURCE="${PRIVATE_ROOT}/xfce4-state"
GUEST_HOME="${SANCTUARY_CORTEX_GUEST_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/dotcortex/guests/sanctuary-cortex/home}"
BACKUP_ROOT="${PRIVATE_ROOT}/guest-backups/xfce4-$(date +%Y%m%d-%H%M%S)"

[[ -d "$SOURCE" ]] || { echo "config-apply: private XFCE state is not ready: $SOURCE" >&2; exit 1; }
command -v rsync >/dev/null 2>&1 || { echo "config-apply: rsync is required" >&2; exit 127; }
mkdir -p "$GUEST_HOME" "$BACKUP_ROOT"

paths=(
  .config/xfce4
  .config/autostart
  .config/xfce4-session
  .local/share/xfce4
  .local/share/applications
  .local/share/backgrounds/x230-xubuntu-wallpaper.png
)
for rel in "${paths[@]}"; do
  source_path="$SOURCE/$rel"
  [[ -e "$source_path" || -L "$source_path" ]] || continue
  target="$GUEST_HOME/$rel"
  if [[ -e "$target" || -L "$target" ]]; then
    mkdir -p "$BACKUP_ROOT/$(dirname "$rel")"
    if [[ -L "$target" ]]; then
      echo "config-apply: preserving existing symlink $target"
      continue
    fi
    if [[ -d "$target" && ! -L "$target" ]]; then
      rsync -a "$target/" "$BACKUP_ROOT/$rel/"
    else
      cp -a "$target" "$BACKUP_ROOT/$rel"
    fi
  fi
  mkdir -p "$(dirname "$target")"
  if [[ -d "$source_path" ]]; then
    mkdir -p "$target"
    rsync -a --delete "$source_path/" "$target/"
  else
    rsync -a "$source_path" "$target"
  fi
  echo "config-apply: projected $rel"
done
echo "config-apply: previous guest state preserved at $BACKUP_ROOT"
# Private migration bridges:4 ends here
