#!/bin/bash
# redstone-9x-classic-build <out-dir> <Name> <activeDark> <activeLight> <inactiveDark> <inactiveLight>
set -euo pipefail
OUT="${1:?out dir}"; TNAME="${2:?name}"; AD="${3:?}"; AL="${4:?}"; ID="${5:?}"; IL="${6:?}"
TAR="${HOME}/Downloads/IceWM/Windows-95.tar.gz"
TMP="$(mktemp -d)"; trap 'rm -rf "${TMP}"' EXIT
tar xzf "${TAR}" -C "${TMP}"
SRC="$(find "${TMP}" -maxdepth 2 -name default.theme -printf '%h' -quit)"
rm -rf "${OUT}"; cp -a "${SRC}" "${OUT}"
sed -i "s|Windows 95|${TNAME}|g" "${OUT}/default.theme"
cat >> "${OUT}/default.theme" <<EOFC

# ---- ${TNAME} (classic builder; meters in Task-Manager set) ----
ColorActiveTaskBarApp="rgb:EA/E8/E4"
ColorCPUStatusUser="rgb:00/A8/00"
ColorCPUStatusSystem="rgb:CC/00/00"
ColorCPUStatusIdle="rgb:00/00/00"
ColorMEMStatusUser="rgb:00/A8/00"
ColorMEMStatusBuffers="rgb:C4/A0/00"
ColorMEMStatusCached="rgb:80/00/80"
ColorMEMStatusFree="rgb:00/00/00"
ColorNetSend="rgb:CC/00/00"
ColorNetReceive="rgb:00/A8/00"
ColorNetIdle="rgb:00/00/00"
EOFC
# Chrome face recolour: 2000/XP-classic chrome is #d4d0c8, NOT the 95 base's
# #c0c0c0 (pixelocdguy/windows-classic themerc — the hex source Mètsàtron
# supplied: window.active.border.color / button.unpressed.bg = #d4d0c8).
FACE="${7:-}"
if [[ -n "${FACE}" ]]; then
  sed -i "s|rgb:C0/C0/C0|rgb:${FACE:1:2}/${FACE:3:2}/${FACE:5:2}|gI" "${OUT}/default.theme"
  python3 - "${OUT}" "${FACE}" <<'PYFACE'
import sys, os
from PIL import Image
out, face = sys.argv[1], sys.argv[2]
F = tuple(int(face.lstrip('#')[i:i+2],16) for i in (0,2,4))
# The pristine 95 tarball's caption buttons are #d4d0c8-faced, NOT #c0c0c0
# (found 2026-07-19 when Baseball shipped grey buttons on tan chrome) — both
# greys are ButtonFace in real Windows and both map to the theme face.
MAP = {(0xC0,0xC0,0xC0): F, (0xD4,0xD0,0xC8): F,
       (0xC3,0xC3,0xC3): tuple(min(255,c+3) for c in F)}
n = 0
for dp, _, fs in os.walk(out):
    for fn in fs:
        if not fn.lower().endswith(('.png','.xpm')): continue
        pth = os.path.join(dp, fn)
        if not os.path.isfile(pth) or os.path.islink(pth): continue
        if fn.lower().endswith('.xpm'):
            t = open(pth, encoding='latin-1').read()
            for (r,g,b),(R,G,B) in MAP.items():
                for h in (f'#{r:02x}{g:02x}{b:02x}', f'#{r:02X}{g:02X}{b:02X}'):
                    t = t.replace(h, f'#{R:02X}{G:02X}{B:02X}')
            open(pth, 'w', encoding='latin-1').write(t); n += 1
        else:
            im = Image.open(pth).convert('RGBA'); px = im.load(); ch = False
            for y in range(im.height):
                for x in range(im.width):
                    r,g,b,a = px[x,y]
                    m = MAP.get((r,g,b))
                    if m: px[x,y] = (*m, a); ch = True
            if ch: im.save(pth); n += 1
print(f"face recolour: {n} pixmaps")
PYFACE
fi
redstone-9x-title-gradient "${OUT}" "${AD}" "${AL}" "${ID}" "${IL}"

# ---- Matching GTK theme (the pipeline half Mètsàtron mandated: without it
# batch conversion is meaningless). Clone the Windows-95 GTK theme and remap
# chrome + selection in BOTH hex and decimal rgb() notations. ----
GTKSRC="${HOME}/DotCortex/linux/.themes/Windows-95"
GTKOUT="${HOME}/DotCortex/linux/.themes/$(basename "${OUT}")"
HILITE="${8:-#0a246a}"
# An .upstream marker means the GTK theme is a verbatim upstream payload
# (e.g. B00merang-Project/Windows-Classic) — never clobber it with a recolour.
if [[ -f "${GTKOUT}/.upstream" ]]; then
  echo "GTK theme ${GTKOUT} is upstream-owned (.upstream marker) — skipping emission"
elif [[ -d "${GTKSRC}" && -n "${FACE}" ]]; then
  rm -rf "${GTKOUT}"; mkdir -p "${GTKOUT}"
  for d in gtk-2.0 gtk-3.0 gtk-4.0; do
    [[ -d "${GTKSRC}/${d}" ]] && cp -r "${GTKSRC}/${d}" "${GTKOUT}/${d}"
  done
  for f in index.theme LICENSE README.md; do
    [[ -f "${GTKSRC}/${f}" ]] && cp "${GTKSRC}/${f}" "${GTKOUT}/${f}"
  done
  fr=$((16#${FACE:1:2})); fg=$((16#${FACE:3:2})); fb=$((16#${FACE:5:2}))
  hr=$((16#${HILITE:1:2})); hg=$((16#${HILITE:3:2})); hb=$((16#${HILITE:5:2}))
  grep -rlZ . "${GTKOUT}" --include='*.css' --include='gtkrc*' --include='*.rc' --include='index.theme' --include='*.svg' 2>/dev/null \
    | xargs -0 -r sed -i \
        -e "s|#c0c0c0|${FACE}|gI" \
        -e "s|\b192, 192, 192\b|${fr}, ${fg}, ${fb}|g" -e "s|\b192,192,192\b|${fr},${fg},${fb}|g" \
        -e "s|#000080|${HILITE}|gI" \
        -e "s|\b0, 0, 128\b|${hr}, ${hg}, ${hb}|g" -e "s|\b0,0,128\b|${hr},${hg},${hb}|g" \
        -e "s|Windows-95|$(basename "${OUT}")|g" -e "s|Windows 95|${TNAME}|g"
  python3 - "${GTKOUT}" "${FACE}" "${HILITE}" <<'PYGTK'
import sys, os
from PIL import Image
out, face, hilite = sys.argv[1:4]
F = tuple(int(face.lstrip('#')[i:i+2],16) for i in (0,2,4))
H = tuple(int(hilite.lstrip('#')[i:i+2],16) for i in (0,2,4))
MAP = {(0xC0,0xC0,0xC0): F, (0x00,0x00,0x80): H}
n = 0
for dp, _, fs in os.walk(out):
    for fn in fs:
        if not fn.lower().endswith('.png'): continue
        p2 = os.path.join(dp, fn)
        im = Image.open(p2).convert('RGBA'); px = im.load(); ch = False
        for y in range(im.height):
            for x in range(im.width):
                r,g,b,a = px[x,y]
                m = MAP.get((r,g,b))
                if m: px[x,y] = (*m, a); ch = True
        if ch: im.save(p2); n += 1
print(f"gtk recolour: {n} pixmaps")
PYGTK
  echo "matching GTK theme at ${GTKOUT}"
fi
echo "${TNAME} built at ${OUT}"
