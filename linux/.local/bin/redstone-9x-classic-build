#!/bin/bash
# redstone-9x-classic-build <out-dir> <Name> <activeDark> <activeLight> <inactiveDark> <inactiveLight>
set -euo pipefail
OUT="${1:?out dir}"; TNAME="${2:?name}"; AD="${3:?}"; AL="${4:?}"; ID="${5:?}"; IL="${6:?}"
TAR="${HOME}/Downloads/IceWM/Windows-95.tar.gz"
TMP="$(mktemp -d)"; trap 'rm -rf "${TMP}"' EXIT
tar xzf "${TAR}" -C "${TMP}"
SRC="$(find "${TMP}" -maxdepth 2 -name default.theme -printf '%h' -quit)"
rm -rf "${OUT}"; cp -a "${SRC}" "${OUT}"
sed -i "s|Windows 95|${TNAME}|g" "${OUT}/default.theme"
cat >> "${OUT}/default.theme" <<EOFC

# ---- ${TNAME} (classic builder; meters in Task-Manager set) ----
ColorActiveTaskBarApp="rgb:EA/E8/E4"
ColorCPUStatusUser="rgb:00/A8/00"
ColorCPUStatusSystem="rgb:CC/00/00"
ColorCPUStatusIdle="rgb:00/00/00"
ColorMEMStatusUser="rgb:00/A8/00"
ColorMEMStatusBuffers="rgb:C4/A0/00"
ColorMEMStatusCached="rgb:80/00/80"
ColorMEMStatusFree="rgb:00/00/00"
ColorNetSend="rgb:CC/00/00"
ColorNetReceive="rgb:00/A8/00"
ColorNetIdle="rgb:00/00/00"
EOFC
# Chrome face recolour: 2000/XP-classic chrome is #d4d0c8, NOT the 95 base's
# #c0c0c0 (pixelocdguy/windows-classic themerc — the hex source Mètsàtron
# supplied: window.active.border.color / button.unpressed.bg = #d4d0c8).
FACE="${7:-}"
if [[ -n "${FACE}" ]]; then
  sed -i "s|rgb:C0/C0/C0|rgb:${FACE:1:2}/${FACE:3:2}/${FACE:5:2}|gI" "${OUT}/default.theme"
  python3 - "${OUT}" "${FACE}" <<'PYFACE'
import sys, os
from PIL import Image
out, face = sys.argv[1], sys.argv[2]
F = tuple(int(face.lstrip('#')[i:i+2],16) for i in (0,2,4))
def _env_rgb(k):
    v = os.environ.get(k, '')
    return tuple(int(v.lstrip('#')[i:i+2],16) for i in (0,2,4)) if v else None
BHI = _env_rgb('BEVEL_HI') or (255,255,255)
BSH = _env_rgb('BEVEL_SH') or (128,128,128)
BDK = _env_rgb('BEVEL_DK') or (0,0,0)
MAP = {(0xC0,0xC0,0xC0): F, (0xD4,0xD0,0xC8): F,
       (0xC3,0xC3,0xC3): tuple(min(255,c+3) for c in F)}
BEVEL = {(0xFF,0xFF,0xFF): BHI, (0xEC,0xEC,0xEC): BHI,
         (0xDF,0xDF,0xDF): F, (0xE0,0xE0,0xE0): F,
         (0x80,0x80,0x80): BSH,
         (0x40,0x40,0x40): BDK}
LOGO = {'windows.png'}
n = 0
for dp, _, fs in os.walk(out):
    for fn in fs:
        if not fn.lower().endswith(('.png','.xpm')): continue
        pth = os.path.join(dp, fn)
        if not os.path.isfile(pth) or os.path.islink(pth): continue
        mapping = MAP if fn.lower() in LOGO else {**MAP, **BEVEL}
        if fn.lower().endswith('.xpm'):
            t = open(pth, encoding='latin-1').read()
            for (r,g,b),(R,G,B) in mapping.items():
                for h in (f'#{r:02x}{g:02x}{b:02x}', f'#{r:02X}{g:02X}{b:02X}'):
                    t = t.replace(h, f'#{R:02X}{G:02X}{B:02X}')
            open(pth, 'w', encoding='latin-1').write(t); n += 1
        else:
            im = Image.open(pth).convert('RGBA'); px = im.load(); ch = False
            for y in range(im.height):
                for x in range(im.width):
                    r,g,b,a = px[x,y]
                    m = mapping.get((r,g,b))
                    if m: px[x,y] = (*m, a); ch = True
            if ch: im.save(pth); n += 1
print(f"face recolour: {n} pixmaps")
PYFACE
fi
redstone-9x-title-gradient "${OUT}" "${AD}" "${AL}" "${ID}" "${IL}"

# ---- Matching GTK theme: clone Chicago95 (authentic Win95 scrollbar steppers,
# @define-color architecture) and remap colours via the named-colour header.
# Bevel values from the unified source flow into both the CSS definitions and
# the pixmap assets. ----
GTKSRC="${HOME}/DotCortex/linux/.themes/Chicago95"
GTKOUT="${HOME}/DotCortex/linux/.themes/$(basename "${OUT}")"
HILITE="${8:-#0a246a}"
if [[ -f "${GTKOUT}/.upstream" ]]; then
  echo "GTK theme ${GTKOUT} is upstream-owned (.upstream marker) — skipping emission"
elif [[ -d "${GTKSRC}" && -n "${FACE}" ]]; then
  rm -rf "${GTKOUT}"; mkdir -p "${GTKOUT}"
  for d in gtk-2.0 gtk-3.0 gtk-4.0; do
    [[ -d "${GTKSRC}/${d}" ]] && cp -r "${GTKSRC}/${d}" "${GTKOUT}/${d}"
  done
  for f in index.theme LICENSE README.md; do
    [[ -f "${GTKSRC}/${f}" ]] && cp "${GTKSRC}/${f}" "${GTKOUT}/${f}"
  done
  _bhi="${BEVEL_HI:-#ffffff}"; _bsh="${BEVEL_SH:-#808080}"; _bdk="${BEVEL_DK:-#000000}"
  _fgc="${GTKFG:-#000000}"; _basec="${GTKBASE:-#ffffff}"
  # GTK3/4: patch @define-color header — Chicago95 derives bevels from bg_color
  # via shade(); replace with the unified computed values so every consumer
  # (pixmaps, CSS, scheme file, Qt, Wine, FOX) uses the same colours.
  for _css in "${GTKOUT}"/gtk-{3.0,4.0}/gtk.css; do
    [[ -f "${_css}" ]] || continue
    sed -i \
      -e "s|@define-color bg_color .*|@define-color bg_color ${FACE};|" \
      -e "s|@define-color fg_color .*|@define-color fg_color ${_fgc};|" \
      -e "s|@define-color panel_fg_color .*|@define-color panel_fg_color ${_fgc};|" \
      -e "s|@define-color base_color .*|@define-color base_color ${_basec};|" \
      -e "s|@define-color text_color .*|@define-color text_color ${_fgc};|" \
      -e "s|@define-color selected_bg_color .*|@define-color selected_bg_color ${HILITE};|" \
      -e "s|@define-color selected_fg_color .*|@define-color selected_fg_color ${HITEXT:-#ffffff};|" \
      -e "s|@define-color bg_bright .*|@define-color bg_bright ${_bhi};|" \
      -e "s|@define-color bg_shade .*|@define-color bg_shade ${_bsh};|" \
      -e "s|@define-color bg_dark .*|@define-color bg_dark ${_bdk};|" \
      -e "s|@define-color border_bright .*|@define-color border_bright ${_bhi};|" \
      -e "s|@define-color border_dark .*|@define-color border_dark ${_bdk};|" \
      -e "s|@define-color border_shade .*|@define-color border_shade ${_bsh};|" \
      -e "s|@define-color disabled_font .*|@define-color disabled_font ${_bsh};|" \
      -e "s|@define-color font_color .*|@define-color font_color ${_fgc};|" \
      -e "s|Chicago95|$(basename "${OUT}")|g" \
      "${_css}"
  done
  # GTK2: patch gtk_color_scheme in gtkrc
  for _rc in "${GTKOUT}"/gtk-2.0/gtkrc; do
    [[ -f "${_rc}" ]] || continue
    sed -i \
      -e "s|fg_color:#[0-9a-fA-F]*|fg_color:${_fgc}|g" \
      -e "s|bg_color:#[0-9a-fA-F]*|bg_color:${FACE}|g" \
      -e "s|base_color:#[0-9a-fA-F]*|base_color:${_basec}|g" \
      -e "s|text_color:#[0-9a-fA-F]*|text_color:${_fgc}|g" \
      -e "s|selected_bg_color:#[0-9a-fA-F]*|selected_bg_color:${HILITE}|g" \
      -e "s|selected_fg_color:#[0-9a-fA-F]*|selected_fg_color:${HITEXT:-#ffffff}|g" \
      -e "s|Chicago95|$(basename "${OUT}")|g" \
      "${_rc}"
  done
  # Theme name in index.theme
  [[ -f "${GTKOUT}/index.theme" ]] && sed -i \
    -e "s|Chicago95|$(basename "${OUT}")|g" -e "s|Chicago 95|${TNAME}|g" "${GTKOUT}/index.theme"
  # Pixmap assets: recolour face + bevel + selection in scrollbar steppers,
  # buttons, arrows, checkboxes (same unified bevel values as everything else).
  python3 - "${GTKOUT}" "${FACE}" "${HILITE}" "${_bhi}" "${_bsh}" "${_bdk}" <<'PYGTK'
import sys, os
from PIL import Image
out, face, hilite, bhi_s, bsh_s, bdk_s = sys.argv[1:7]
F = tuple(int(face.lstrip('#')[i:i+2],16) for i in (0,2,4))
H = tuple(int(hilite.lstrip('#')[i:i+2],16) for i in (0,2,4))
BHI = tuple(int(bhi_s.lstrip('#')[i:i+2],16) for i in (0,2,4))
BSH = tuple(int(bsh_s.lstrip('#')[i:i+2],16) for i in (0,2,4))
BDK = tuple(int(bdk_s.lstrip('#')[i:i+2],16) for i in (0,2,4))
MAP = {(0xC0,0xC0,0xC0): F, (0x00,0x00,0x80): H,
       (0xFF,0xFF,0xFF): BHI, (0x80,0x80,0x80): BSH}
ARROWS = dict(MAP)
fgc = os.environ.get('GTKFG', '')
if fgc and fgc.lower() != '#000000':
    ARROWS[(0,0,0)] = tuple(int(fgc.lstrip('#')[i:i+2],16) for i in (0,2,4))
n = 0
for dp, _, fs in os.walk(out):
    for fn in fs:
        if not fn.lower().endswith('.png'): continue
        p2 = os.path.join(dp, fn)
        mapping = ARROWS if 'arrow' in fn.lower() or os.path.basename(dp) in ('arrows', 'scrollbar') else MAP
        im = Image.open(p2).convert('RGBA'); px = im.load(); ch = False
        for y in range(im.height):
            for x in range(im.width):
                r,g,b,a = px[x,y]
                m = mapping.get((r,g,b))
                if m: px[x,y] = (*m, a); ch = True
        if ch: im.save(p2); n += 1
print(f"gtk recolour: {n} pixmaps")
PYGTK
  echo "matching GTK theme at ${GTKOUT}"
fi
echo "${TNAME} built at ${OUT}"
