#!/bin/bash
# redstone-9x-classic-build <out-dir> <Name> <activeDark> <activeLight> <inactiveDark> <inactiveLight>
set -euo pipefail
OUT="${1:?out dir}"; TNAME="${2:?name}"; AD="${3:?}"; AL="${4:?}"; ID="${5:?}"; IL="${6:?}"
TAR="${HOME}/HelmCortex/NEXUS/sanctuaries/sanctuary-redstone-9x/donors/Windows-95.tar.gz"
[[ -f "${TAR}" ]] || { echo "ERROR: donor ${TAR} missing — NEXUS source archive not reachable" >&2; exit 1; }
TMP="$(mktemp -d)"; trap 'rm -rf "${TMP}"' EXIT
tar xzf "${TAR}" -C "${TMP}"
SRC="$(find "${TMP}" -maxdepth 2 -name default.theme -printf '%h' -quit)"
rm -rf "${OUT}"; cp -a "${SRC}" "${OUT}"
sed -i "s|Windows 95|${TNAME}|g" "${OUT}/default.theme"
cat >> "${OUT}/default.theme" <<EOFC

# ---- ${TNAME} (classic builder; meters in Task-Manager set) ----
ColorActiveTaskBarApp="rgb:EA/E8/E4"
ColorCPUStatusUser="rgb:00/A8/00"
ColorCPUStatusSystem="rgb:CC/00/00"
ColorCPUStatusIdle="rgb:00/00/00"
ColorMEMStatusUser="rgb:00/A8/00"
ColorMEMStatusBuffers="rgb:C4/A0/00"
ColorMEMStatusCached="rgb:80/00/80"
ColorMEMStatusFree="rgb:00/00/00"
ColorNetSend="rgb:CC/00/00"
ColorNetReceive="rgb:00/A8/00"
ColorNetIdle="rgb:00/00/00"
EOFC
# Chrome face recolour: 2000/XP-classic chrome is #d4d0c8, NOT the 95 base's
# #c0c0c0 (pixelocdguy/windows-classic themerc — the hex source Mètsàtron
# supplied: window.active.border.color / button.unpressed.bg = #d4d0c8).
FACE="${7:-}"
if [[ -n "${FACE}" ]]; then
  sed -i "s|rgb:C0/C0/C0|rgb:${FACE:1:2}/${FACE:3:2}/${FACE:5:2}|gI" "${OUT}/default.theme"
  python3 - "${OUT}" "${FACE}" <<'PYFACE'
import sys, os
from PIL import Image
out, face = sys.argv[1], sys.argv[2]
F = tuple(int(face.lstrip('#')[i:i+2],16) for i in (0,2,4))
def _env_rgb(k):
    v = os.environ.get(k, '')
    return tuple(int(v.lstrip('#')[i:i+2],16) for i in (0,2,4)) if v else None
BHI = _env_rgb('BEVEL_HI') or (255,255,255)
BSH = _env_rgb('BEVEL_SH') or (128,128,128)
BDK = _env_rgb('BEVEL_DK') or (0,0,0)
MAP = {(0xC0,0xC0,0xC0): F, (0xD4,0xD0,0xC8): F,
       (0xC3,0xC3,0xC3): tuple(min(255,c+3) for c in F)}
BEVEL = {(0xFF,0xFF,0xFF): BHI, (0xEC,0xEC,0xEC): BHI,
         (0xDF,0xDF,0xDF): F, (0xE0,0xE0,0xE0): F,
         (0x80,0x80,0x80): BSH,
         (0x40,0x40,0x40): BDK}
LOGO = {'windows.png'}
n = 0
for dp, _, fs in os.walk(out):
    if os.path.basename(dp) == 'cursors':
        # Cursor art ships as authored — recolouring it to the face palette
        # camouflaged the pointer against the theme (ruling 2026-08-07).
        continue
    for fn in fs:
        if not fn.lower().endswith(('.png','.xpm')): continue
        pth = os.path.join(dp, fn)
        if not os.path.isfile(pth) or os.path.islink(pth): continue
        mapping = MAP if fn.lower() in LOGO else {**MAP, **BEVEL}
        if fn.lower().endswith('.xpm'):
            t = open(pth, encoding='latin-1').read()
            for (r,g,b),(R,G,B) in mapping.items():
                for h in (f'#{r:02x}{g:02x}{b:02x}', f'#{r:02X}{g:02X}{b:02X}'):
                    t = t.replace(h, f'#{R:02X}{G:02X}{B:02X}')
            open(pth, 'w', encoding='latin-1').write(t); n += 1
        else:
            im = Image.open(pth).convert('RGBA'); px = im.load(); ch = False
            for y in range(im.height):
                for x in range(im.width):
                    r,g,b,a = px[x,y]
                    m = mapping.get((r,g,b))
                    if m: px[x,y] = (*m, a); ch = True
            if ch: im.save(pth); n += 1
print(f"face recolour: {n} pixmaps")
PYFACE
fi
redstone-9x-title-gradient "${OUT}" "${AD}" "${AL}" "${ID}" "${IL}"

# ---- Matching GTK theme: clone Chicago95 (authentic Win95 scrollbar steppers,
# @define-color architecture) and remap colours via the named-colour header.
# Bevel values from the unified source flow into both the CSS definitions and
# the pixmap assets. SerenityOS variants clone Reactionary instead (ruling
# 2026-08-07: Serenity uses Reactionary's GTK3 widgets — arrow-glyph scroll
# rockers, CSS-drawn arrows that follow fg_color so dark faces stay legible);
# Reactionary shares the same @define-color core names, so the header patch
# below applies unchanged. ----
GTKSRC="${HOME}/DotCortex/linux/.themes/Chicago95"
[[ -n "${SERENITY_FACE:-}" ]] && GTKSRC="${HOME}/DotCortex/linux/.themes/Reactionary"
GTKOUT="${HOME}/DotCortex/linux/.themes/$(basename "${OUT}")"
HILITE="${8:-#0a246a}"
if [[ -f "${GTKOUT}/.upstream" ]]; then
  echo "GTK theme ${GTKOUT} is upstream-owned (.upstream marker) — skipping emission"
elif [[ -d "${GTKSRC}" && -n "${FACE}" ]]; then
  rm -rf "${GTKOUT}"; mkdir -p "${GTKOUT}"
  for d in gtk-2.0 gtk-3.0 gtk-4.0; do
    [[ -d "${GTKSRC}/${d}" ]] && cp -r "${GTKSRC}/${d}" "${GTKOUT}/${d}"
  done
  for f in index.theme LICENSE README.md; do
    [[ -f "${GTKSRC}/${f}" ]] && cp "${GTKSRC}/${f}" "${GTKOUT}/${f}"
  done
  _bhi="${BEVEL_HI:-#ffffff}"; _bsh="${BEVEL_SH:-#808080}"; _bdk="${BEVEL_DK:-#000000}"
  _fgc="${GTKFG:-#000000}"; _basec="${GTKBASE:-#ffffff}"
  # GTK3/4: patch @define-color header — Chicago95 derives bevels from bg_color
  # via shade(); replace with the unified computed values so every consumer
  # (pixmaps, CSS, scheme file, Qt, Wine, FOX) uses the same colours.
  for _css in "${GTKOUT}"/gtk-{3.0,4.0}/gtk.css; do
    [[ -f "${_css}" ]] || continue
    sed -i \
      -e "s|@define-color bg_color .*|@define-color bg_color ${FACE};|" \
      -e "s|@define-color fg_color .*|@define-color fg_color ${_fgc};|" \
      -e "s|@define-color panel_fg_color .*|@define-color panel_fg_color ${_fgc};|" \
      -e "s|@define-color base_color .*|@define-color base_color ${_basec};|" \
      -e "s|@define-color text_color .*|@define-color text_color ${_fgc};|" \
      -e "s|@define-color selected_bg_color .*|@define-color selected_bg_color ${HILITE};|" \
      -e "s|@define-color selected_fg_color .*|@define-color selected_fg_color ${HITEXT:-#ffffff};|" \
      -e "s|@define-color bg_bright .*|@define-color bg_bright ${_bhi};|" \
      -e "s|@define-color bg_shade .*|@define-color bg_shade ${_bsh};|" \
      -e "s|@define-color bg_dark .*|@define-color bg_dark ${_bdk};|" \
      -e "s|@define-color border_bright .*|@define-color border_bright ${_bhi};|" \
      -e "s|@define-color border_dark .*|@define-color border_dark ${_bdk};|" \
      -e "s|@define-color border_shade .*|@define-color border_shade ${_bsh};|" \
      -e "s|@define-color disabled_font .*|@define-color disabled_font ${_bsh};|" \
      -e "s|@define-color font_color .*|@define-color font_color ${_fgc};|" \
      -e "s|Chicago95|$(basename "${OUT}")|g" \
      "${_css}"
  done
  # GTK2: patch gtk_color_scheme in gtkrc
  for _rc in "${GTKOUT}"/gtk-2.0/gtkrc; do
    [[ -f "${_rc}" ]] || continue
    sed -i \
      -e "s|fg_color:#[0-9a-fA-F]*|fg_color:${_fgc}|g" \
      -e "s|bg_color:#[0-9a-fA-F]*|bg_color:${FACE}|g" \
      -e "s|base_color:#[0-9a-fA-F]*|base_color:${_basec}|g" \
      -e "s|text_color:#[0-9a-fA-F]*|text_color:${_fgc}|g" \
      -e "s|selected_bg_color:#[0-9a-fA-F]*|selected_bg_color:${HILITE}|g" \
      -e "s|selected_fg_color:#[0-9a-fA-F]*|selected_fg_color:${HITEXT:-#ffffff}|g" \
      -e "s|Chicago95|$(basename "${OUT}")|g" \
      "${_rc}"
  done
  # Theme name in index.theme
  [[ -f "${GTKOUT}/index.theme" ]] && sed -i \
    -e "s|Chicago95|$(basename "${OUT}")|g" -e "s|Chicago 95|${TNAME}|g" "${GTKOUT}/index.theme"
  # ---- Serenity lane extras (Reactionary donor, ruling 2026-08-07): the
  # donor's near-white #f1f1f1 border/bevel tone and raw face grey #d3d0c7
  # sit outside the @define header and stay blinding on dark faces; the
  # dark_bg/dark_fg defines are never patched by the shared sed; and the
  # scroll rockers use icon-theme pan-*-symbolic PNGs that are black and
  # ignore fg — ship per-variant fg-coloured triangle rockers + override. ----
  if [[ -n "${SERENITY_FACE:-}" ]]; then
    for _css in "${GTKOUT}"/gtk-3.0/gtk.css "${GTKOUT}"/gtk-3.0/gtk-widgets.css "${GTKOUT}"/gtk-3.0/gtk-widgets-assets.css; do
      [[ -f "${_css}" ]] || continue
      sed -i \
        -e "s|@define-color dark_bg_color .*|@define-color dark_bg_color ${FACE};|" \
        -e "s|@define-color dark_fg_color .*|@define-color dark_fg_color ${_fgc};|" \
        -e "s|#f1f1f1|${_bhi}|gI" \
        -e "s|#d3d0c7|${FACE}|gI" \
        -e "s|border-color: @theme_fg_color|border-color: ${_bdk}|g" \
        -e "s|inset -1px -1px @theme_fg_color|inset -1px -1px ${_bdk}|g" \
        "${_css}"
    done
    python3 - "${GTKOUT}/gtk-3.0/assets" "${_fgc}" <<'PYROCK'
import sys, os
from PIL import Image
out, fg = sys.argv[1], sys.argv[2]
F = tuple(int(fg.lstrip('#')[i:i+2], 16) for i in (0, 2, 4))
os.makedirs(out, exist_ok=True)
def tri(widths, horiz=False):
    # 8x8 full-bleed: a 16px canvas scaled into Reactionary's 6px-min rocker
    # buttons collapsed the glyph to a white dot (live-caught 2026-08-08).
    im = Image.new('RGBA', (8, 8), (0, 0, 0, 0)); px = im.load()
    for i, w in enumerate(widths):
        c0 = 4 - (w + 1) // 2
        for j in range(w):
            x, y = (2 + i, c0 + j) if horiz else (c0 + j, 2 + i)
            px[x, y] = (*F, 255)
    return im
tri((7, 5, 3, 1)).save(os.path.join(out, 'rocker-down.png'))
tri((1, 3, 5, 7)).save(os.path.join(out, 'rocker-up.png'))
tri((7, 5, 3, 1), True).save(os.path.join(out, 'rocker-right.png'))
tri((1, 3, 5, 7), True).save(os.path.join(out, 'rocker-left.png'))
print("rockers drawn in", fg)
PYROCK
    cat >> "${GTKOUT}/gtk-3.0/gtk.css" <<'CSSROCK'

/* redstone: fg-coloured scroll rockers — icon-theme pan-*-symbolic PNGs are
 * black rasters that ignore the style fg (ruling 2026-08-07). */
scrollbar.vertical button.down { -gtk-icon-source: url("assets/rocker-down.png"); }
scrollbar.vertical button.up { -gtk-icon-source: url("assets/rocker-up.png"); }
scrollbar.horizontal button.down { -gtk-icon-source: url("assets/rocker-right.png"); }
scrollbar.horizontal button.up { -gtk-icon-source: url("assets/rocker-left.png"); }
CSSROCK
  fi
  # Pixmap assets: recolour face + bevel + selection in scrollbar steppers,
  # buttons, arrows, checkboxes (same unified bevel values as everything else).
  python3 - "${GTKOUT}" "${FACE}" "${HILITE}" "${_bhi}" "${_bsh}" "${_bdk}" <<'PYGTK'
import sys, os
from PIL import Image
out, face, hilite, bhi_s, bsh_s, bdk_s = sys.argv[1:7]
F = tuple(int(face.lstrip('#')[i:i+2],16) for i in (0,2,4))
H = tuple(int(hilite.lstrip('#')[i:i+2],16) for i in (0,2,4))
BHI = tuple(int(bhi_s.lstrip('#')[i:i+2],16) for i in (0,2,4))
BSH = tuple(int(bsh_s.lstrip('#')[i:i+2],16) for i in (0,2,4))
BDK = tuple(int(bdk_s.lstrip('#')[i:i+2],16) for i in (0,2,4))
MAP = {(0xC0,0xC0,0xC0): F, (0x00,0x00,0x80): H,
       (0xFF,0xFF,0xFF): BHI, (0x80,0x80,0x80): BSH,
       # Reactionary donor palette (Serenity lane): face grey + selection blue
       (0xD3,0xD0,0xC7): F, (0x56,0x8C,0xD2): H}
ARROWS = dict(MAP)
fgc = os.environ.get('GTKFG', '')
if fgc and fgc.lower() != '#000000':
    ARROWS[(0,0,0)] = tuple(int(fgc.lstrip('#')[i:i+2],16) for i in (0,2,4))
n = 0
for dp, _, fs in os.walk(out):
    for fn in fs:
        if not fn.lower().endswith('.png'): continue
        if fn.startswith('rocker-'):
            # fg-coloured glyphs drawn by the serenity lane — the white->BHI
            # bevel mapping must never touch them (clobbered once, 2026-08-07)
            continue
        p2 = os.path.join(dp, fn)
        mapping = ARROWS if 'arrow' in fn.lower() or os.path.basename(dp) in ('arrows', 'scrollbar') else MAP
        im = Image.open(p2).convert('RGBA'); px = im.load(); ch = False
        for y in range(im.height):
            for x in range(im.width):
                r,g,b,a = px[x,y]
                m = mapping.get((r,g,b))
                if m: px[x,y] = (*m, a); ch = True
        if ch: im.save(p2); n += 1
print(f"gtk recolour: {n} pixmaps")
PYGTK
  # ---- GTK4: Chicago95 carries no gtk-4.0, so every classic re-conversion was
  # silently DELETING it (caught 2026-08-07 — the "my GTK4 fixes vanished" bug).
  # Clone the Windows-95 base instead (2550-line full widget coverage, proven on
  # the Valve mixer) and recolour to the scheme — the same recipe the CDE fleet
  # uses (54eddc1b5). Bevel neutrals are remapped only inside box-shadow/border
  # declarations so data-view whites (entries, checkboxes) stay white. ----
  W95_GTK4="${HOME}/DotCortex/linux/.themes/Windows-95/gtk-4.0"
  if [[ ! -d "${W95_GTK4}" ]]; then
    echo "ERROR: ${W95_GTK4} missing (theme-windows-95 submodule not initialized?) — gtk-4.0 emission impossible" >&2
    exit 1
  fi
  rm -rf "${GTKOUT}/gtk-4.0"
  cp -r "${W95_GTK4}" "${GTKOUT}/gtk-4.0"
  python3 - "${GTKOUT}/gtk-4.0" "${FACE}" "${HILITE}" "${HITEXT:-#ffffff}" "${_bhi}" "${_bsh}" "${_bdk}" "${_fgc}" <<'PYGTK4'
import sys, os, re
from PIL import Image
g4, face, sel, seltxt, bhi, bsh, bdk, fgc = sys.argv[1:9]
def rgb(h): return tuple(int(h.lstrip('#')[i:i+2], 16) for i in (0, 2, 4))
F, S = rgb(face), rgb(sel)
def lum(c): return 0.2126*c[0] + 0.7152*c[1] + 0.0722*c[2]
def mixw(f): return '#%02x%02x%02x' % tuple(round(c + (255 - c) * f) for c in F)
# Neutral bevel ramp of the Windows-95 base -> unified bevel tokens, but ONLY on
# bevel-drawing declarations (box-shadow / border) — the same hexes elsewhere
# are backgrounds and data whites that must not turn face-coloured.
BEVLINE = {'#ececec': bhi, '#e3e3e3': bhi, '#dfdfdf': bhi, '#ffffff': bhi,
           'white': bhi, '#a3a3a3': bsh, '#7d7d7d': bsh, '#0a0a0a': bdk}
for dp, _, fs in os.walk(g4):
    for fn in fs:
        p = os.path.join(dp, fn)
        if fn.endswith('.css'):
            out = []
            for ln in open(p, encoding='latin-1').read().splitlines(True):
                if 'box-shadow' in ln or 'border' in ln:
                    for k, v in BEVLINE.items():
                        ln = re.sub(re.escape(k) + r'(?![0-9a-fA-F])', v, ln, flags=re.I)
                out.append(ln)
            t = ''.join(out)
            t = re.sub(r'#c0c0c0', face, t, flags=re.I)
            t = re.sub(r'\b192,\s*192,\s*192\b', '%d, %d, %d' % F, t)
            t = re.sub(r'#000080', sel, t, flags=re.I)
            t = re.sub(r'\b0,\s*0,\s*128\b', '%d, %d, %d' % S, t)
            t = re.sub(r'(@define-color theme(?:_unfocused)?_selected_fg_color) #FFFFFF',
                       r'\1 ' + seltxt, t, flags=re.I)
            # Notebook page + levelbar trough fixes carried over from the CDE
            # lane (the pavucontrol white-page / flat-meter defects).
            t = t.replace(
                'notebook > stack:not(:only-child) {\n  background-color: #FFFFFF; }',
                'notebook > stack:not(:only-child) {\n  background-color: ' + face + '; }')
            t = t.replace(
                'notebook > stack:not(:only-child):backdrop {\n    background-color: #FFFFFF; }',
                'notebook > stack:not(:only-child):backdrop {\n    background-color: ' + face + '; }')
            # Table/column headers: the Win95 base hardcodes WHITE header
            # buttons — the "hard highlight on tables" (ruling 2026-08-07).
            # A 95-style header is a raised face button; give it the unified
            # bevel ramp and the theme fg.
            t = t.replace(
                'columnview.view > header > button, treeview.view > header > button {\n    color: gray;\n    background-color: #FFFFFF;\n    font-weight: bold;\n    text-shadow: none;\n    box-shadow: none; }',
                'columnview.view > header > button, treeview.view > header > button {\n    color: ' + (fgc if fgc.lower() != '#000000' else '#000000') + ';\n    background-color: ' + face + ';\n    font-weight: bold;\n    text-shadow: none;\n    box-shadow: inset 1px 1px ' + bhi + ', inset -1px -1px ' + bdk + ', inset -2px -2px ' + bsh + '; }')
            # Horizontal rules / separators: hardcoded mid-grey — follow the
            # bevel shadow tone so rules sit softly on any face.
            t = t.replace(
                'separator {\n  -gtk-icon-source: none;\n  min-width: 1px;\n  min-height: 1px;\n  background-color: #7d7d7d;',
                'separator {\n  -gtk-icon-source: none;\n  min-width: 1px;\n  min-height: 1px;\n  background-color: ' + bsh + ';')
            t = t.replace(
                'levelbar trough {\n  padding: 1px;\n  border-radius: 0; }',
                'levelbar trough {\n  padding: 1px;\n  border-radius: 0;\n'
                '  border: 1px solid ' + bsh + ';\n  border-bottom-color: ' + bhi + ';\n'
                '  border-right-color: ' + bhi + ';\n  background-color: ' + face + '; }')
            if fgc.lower() != '#000000':
                t = re.sub(r'(?<![-\w])color:\s*#000000', 'color: ' + fgc, t)
                t = re.sub(r'(@define-color theme_(?:fg|text|unfocused_fg|unfocused_text)_color) #000000',
                           r'\1 ' + fgc, t)
            if lum(F) < 140:
                # Dark face: mix the base's light neutral backgrounds toward the
                # face (backdrop/insensitive tones) — same dict as the CDE lane.
                BRIGHT = {'#ececec': mixw(0.10), '#e0e0e0': mixw(0.08),
                          '#dedede': mixw(0.08), '#d5d5d5': mixw(0.06),
                          '#cccccc': mixw(0.06), '#c5c5c5': mixw(0.04),
                          '#b6b6b6': mixw(0.02), '#adadad': mixw(0.02),
                          '#f5f5f5': mixw(0.12), '#fafafa': mixw(0.12),
                          '#e8e8e8': mixw(0.09)}
                for k, v in BRIGHT.items():
                    t = re.sub(re.escape(k), v, t, flags=re.I)
            open(p, 'w', encoding='latin-1').write(t)
        elif fn.endswith('.png'):
            im = Image.open(p).convert('RGBA'); px = im.load(); ch = False
            # Sliders carry the classic white/grey bevel ramp (the unthemed
            # bevel around scale/volume sliders, ruling 2026-08-07); arrows
            # are black rasters that must follow the theme fg on dark faces.
            # Data whites (checkbox/radio interiors) stay white.
            is_slider = fn.startswith('slider')
            is_arrow = 'arrow' in fn.lower()
            BH = rgb(bhi); BS = rgb(bsh); FG = rgb(fgc)
            for y in range(im.height):
                for x in range(im.width):
                    r, g, b, a = px[x, y]
                    if (r, g, b) == (192, 192, 192):
                        px[x, y] = (*F, a); ch = True
                    elif (r, g, b) == (0, 0, 128):
                        px[x, y] = (*S, a); ch = True
                    elif is_slider and (r, g, b) == (255, 255, 255):
                        px[x, y] = (*BH, a); ch = True
                    elif is_slider and (r, g, b) == (128, 128, 128):
                        px[x, y] = (*BS, a); ch = True
                    elif is_arrow and fgc.lower() != '#000000' and (r, g, b) == (0, 0, 0):
                        px[x, y] = (*FG, a); ch = True
            if ch:
                im.save(p)
print("gtk-4.0: recoloured Windows-95 base (full widget coverage)")
PYGTK4
  echo "matching GTK theme at ${GTKOUT}"
elif [[ -n "${FACE}" ]]; then
  echo "ERROR: GTK base ${GTKSRC} missing (Chicago95 submodule not initialized?) — GTK emission impossible" >&2
  exit 1
fi
echo "${TNAME} built at ${OUT}"
