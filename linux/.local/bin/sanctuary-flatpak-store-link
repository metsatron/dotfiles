#!/usr/bin/env bash
# [[file:../../../guests.org::*Host-Visible Guest Home Layout][Host-Visible Guest Home Layout:2]]
# Restore the host Flatpak user store after a sanctuary overlay has been stowed.
# The public all/.local/share/flatpak tree carries repo-owned overrides, but it
# is not the host's app/runtime store. Keep the guest path pointed at the host
# store so unmodified desktop entries using `flatpak run` continue to work.
set -euo pipefail

GUEST_HOME=""
HOST_HOME="${SANCTUARY_HOST_HOME:-$HOME}"

usage() {
  printf 'Usage: %s --guest-home PATH [--host-home PATH]\n' "${0##*/}" >&2
}

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --guest-home)
      [[ "$#" -ge 2 ]] || { usage; exit 2; }
      GUEST_HOME="$2"
      shift 2
      ;;
    --host-home)
      [[ "$#" -ge 2 ]] || { usage; exit 2; }
      HOST_HOME="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage
      exit 2
      ;;
  esac
done

[[ -n "$GUEST_HOME" ]] || { usage; exit 2; }

HOST_STORE="${HOST_HOME%/}/.local/share/flatpak"
GUEST_STORE="${GUEST_HOME%/}/.local/share/flatpak"
[[ -d "$HOST_STORE/app" ]] || {
  echo "sanctuary-flatpak-store-link: host user store absent: $HOST_STORE" >&2
  exit 0
}

mkdir -p "$(dirname "$GUEST_STORE")"
HOST_STORE_REAL="$(readlink -f "$HOST_STORE")"
if [[ -L "$GUEST_STORE" ]]; then
  GUEST_STORE_REAL="$(readlink -f "$GUEST_STORE" 2>/dev/null || true)"
  if [[ "$GUEST_STORE_REAL" == "$HOST_STORE_REAL" ]]; then
    echo "sanctuary-flatpak-store-link: host store already projected"
    exit 0
  fi
fi

if [[ -e "$GUEST_STORE" || -L "$GUEST_STORE" ]]; then
  BACKUP="${GUEST_STORE}.before-host-flatpak.$(date +%Y%m%d-%H%M%S)"
  mv "$GUEST_STORE" "$BACKUP"
  echo "sanctuary-flatpak-store-link: preserved previous guest store at $BACKUP"
fi
ln -sfnT "$HOST_STORE" "$GUEST_STORE"
echo "sanctuary-flatpak-store-link: $GUEST_STORE -> $HOST_STORE"
# Host-Visible Guest Home Layout:2 ends here
