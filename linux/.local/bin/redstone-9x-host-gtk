#!/bin/sh
# redstone-9x-host-gtk <host-command...> — host-spawn with the active Desktop
# Scheme's GTK theme. Replaces the dead session-wide GTK_THEME export.
scheme="$(cat "${HOME}/.config/redstone-9x/scheme" 2>/dev/null || echo windows-95)"
theme="$(. "${HOME}/.config/redstone-9x/schemes/${scheme}.scheme" 2>/dev/null; printf %s "${GTK_THEME:-Windows-95}")"
export GTK_THEME="${theme}"
export DBUS_SESSION_BUS_ADDRESS='@HOST_SESSION_BUS@'
# /usr/bin/host-spawn never exists in this Guix guest: distrobox-host-exec's
# own first-use installer downloads a guest-native build to /tmp/host-spawn
# then tries `sudo`/`su -l` to relocate it to /usr/bin, which fails silently
# because the container has neither — so /tmp/host-spawn is the only copy
# that ever lands (confirmed 2026-08-11: it runs; the host's bind-mounted
# ~/.local/bin/host-spawn does not — "required file not found", wrong libc).
# Trigger the installer once if /tmp/host-spawn is not there yet, since a
# freshly created container has not staged it.
HOST_SPAWN=/tmp/host-spawn
if [ ! -x "${HOST_SPAWN}" ]; then
  distrobox-host-exec true >/dev/null 2>&1 || true
fi
if [ ! -x "${HOST_SPAWN}" ]; then
  printf 'redstone-9x-host-gtk: host-spawn unavailable in guest\n' >&2
  exit 127
fi
exec "${HOST_SPAWN}" -env DISPLAY,GTK_THEME "$@"
