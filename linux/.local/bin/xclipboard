# [[file:../../../distrobox.org::*Sanctuary Launcher Scripts][Sanctuary Launcher Scripts:13]]
#!/usr/bin/env bash
# xclipboard replacement for sanctuary-cde.
# xclipboard is not available in Guix; this stub shows clipboard contents
# in a dtterm window using xclip (which IS in the desktop-common profile).
exec dtterm -title "Clipboard Contents" -e sh -c '
echo "=== PRIMARY (last X selection) ==="
DISPLAY=:92 xclip -selection primary -o 2>/dev/null || echo "(empty)"
echo ""
echo "=== CLIPBOARD (Ctrl+C / cde-copy-to-host) ==="
DISPLAY=:92 xclip -selection clipboard -o 2>/dev/null || echo "(empty)"
echo ""
echo "Press Enter to close..."
read _dummy
'
# Sanctuary Launcher Scripts:13 ends here
