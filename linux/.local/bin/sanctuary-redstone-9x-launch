# System sound scheme: shared helper + user-supplied media dir (see
# sanctuary-distrobox.org "Sanctuary system sounds" — DotCortex ships no audio).
project_file "${HOME}/DotCortex/linux/.local/bin/sanctuary-sound" "${GUEST_HOME}/.local/bin/sanctuary-sound"
