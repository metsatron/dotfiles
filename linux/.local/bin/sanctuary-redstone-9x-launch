#!/usr/bin/env bash
# Sanctuary: sanctuary-redstone-9x — Redstone 9X IceWM

# First gaming-wing sanctuary.  IceWM with the Windows NT theme.
# Launch from the current host desktop. Xephyr display: =:93=.
# Guix profiles: =desktop-common= + =room-gaming= (icewm, pcmanfm, xterm) + =room-windows-compat= (wine64, winetricks, fontconfig, powershell, dosbox-x).

# The launcher projects =DotCortex/linux/.icewm/= directly into the isolated guest
# home before launching Xephyr — IceWM reads config, theme, and menu from org-managed
# source. =pcmanfm --desktop= (via =~/.icewm/startup=) manages Win95-style desktop
# icons (My Computer, My Documents, Recycle Bin) from =linux/.icewm/desktop/=.


# [[file:../../../distrobox.org::*Sanctuary: sanctuary-redstone-9x — Redstone 9X IceWM][Sanctuary: sanctuary-redstone-9x — Redstone 9X IceWM:1]]
# Launch sanctuary-redstone-9x: Xephyr :93 + IceWM inside the Guix container.
# Launch from the host desktop; no workspace hop is required.
# Prerequisites:
#   loom guix:sanctuary-apply   ← builds desktop-common + room-gaming + room-windows-compat
#   distrobox-sanctuaries-create
#   vm-homes-init
set -euo pipefail

DISPLAY_NUM=":93"
HOST_DISPLAY="${DISPLAY}"
SANCTUARY="sanctuary-redstone-9x"
GUESTS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/dotcortex/guests"
GUEST_HOME="${GUESTS_DIR}/${SANCTUARY}/home"
GUIX_PROFILES="${HOME}/.guix-extra-profiles"
FONT_STAGE="${GUESTS_DIR}/${SANCTUARY}/fonts"

# Preflight: verify all required Guix profiles exist before launching.
_missing=0
for _prof in desktop-common room-gaming room-windows-compat; do
  _path="${GUIX_PROFILES}/${_prof}/${_prof}/etc/profile"
  if [[ ! -f "${_path}" ]]; then
    echo "${SANCTUARY}: ERROR — Guix profile not built: ${_prof}"
    echo "  Build it with: make guix-${_prof}"
    _missing=1
  fi
done
if [[ "${_missing}" -eq 1 ]]; then
  echo ""
  echo "Run 'make guix-room-windows-compat' (builds all sanctuary profiles) then retry."
  exit 1
fi

# Project DotCortex-managed IceWM config into isolated guest home.
# Copy, do not symlink: the host repo path is not visible inside the container.
project_file() {
  local src="$1" dst="$2"
  mkdir -p "$(dirname "${dst}")"
  rm -f "${dst}"
  cp -f "${src}" "${dst}"
}

project_dir() {
  local src="$1" dst="$2" tmp="${2}.tmp"
  mkdir -p "$(dirname "${dst}")"
  rm -rf "${tmp}"
  cp -a "${src}" "${tmp}"
  rm -rf "${dst}"
  mv "${tmp}" "${dst}"
}

mkdir -p "${GUEST_HOME}/.icewm"
project_dir "${HOME}/DotCortex/linux/.icewm/themes" "${GUEST_HOME}/.icewm/themes"
project_file "${HOME}/DotCortex/linux/.icewm/preferences" "${GUEST_HOME}/.icewm/preferences"
project_file "${HOME}/DotCortex/linux/.icewm/menu" "${GUEST_HOME}/.icewm/menu"
project_file "${HOME}/DotCortex/linux/.icewm/startup" "${GUEST_HOME}/.icewm/startup"
chmod +x "${GUEST_HOME}/.icewm/startup"

# Project the DotCortex GTK theme into the guest so GTK uses the repo-owned theme
# instead of whichever host theme happens to be installed.
mkdir -p "${GUEST_HOME}/.themes"
project_dir "${HOME}/DotCortex/linux/.themes/Windows-95" "${GUEST_HOME}/.themes/Windows-95"

# Project the repo icon theme too; GTK and pcmanfm need it inside the guest home
# for desktop shortcuts and panel icons to resolve correctly.
mkdir -p "${GUEST_HOME}/.local/share/icons"
project_dir "${HOME}/DotCortex/linux/.local/share/icons/Chicago95" \
  "${GUEST_HOME}/.local/share/icons/Chicago95"

# Project DotCortex-managed PowerShell profile into guest home.
mkdir -p "${GUEST_HOME}/.config/powershell"
project_file "${HOME}/DotCortex/linux/.config/powershell/Microsoft.PowerShell_profile.ps1" \
  "${GUEST_HOME}/.config/powershell/Microsoft.PowerShell_profile.ps1"

# Project the Redstone launcher wrapper into the guest so menu items can source
# the correct Guix profiles before running PowerShell/CMD/DOS tools.
mkdir -p "${GUEST_HOME}/.local/bin"
project_file "${HOME}/DotCortex/linux/.local/bin/redstone-9x-run" \
  "${GUEST_HOME}/.local/bin/redstone-9x-run"
chmod +x "${GUEST_HOME}/.local/bin/redstone-9x-run"
project_file "${HOME}/DotCortex/linux/.local/bin/redstone-9x-pwsh" \
  "${GUEST_HOME}/.local/bin/redstone-9x-pwsh"
chmod +x "${GUEST_HOME}/.local/bin/redstone-9x-pwsh"
project_file "${HOME}/DotCortex/linux/.config/redstone-9x/powershell/basic-repl.ps1" \
  "${GUEST_HOME}/.config/redstone-9x/powershell/basic-repl.ps1"

mkdir -p "${GUEST_HOME}/.config/gtk-3.0"
project_file "${HOME}/DotCortex/linux/.config/redstone-9x/gtk-3.0/settings.ini" \
  "${GUEST_HOME}/.config/gtk-3.0/settings.ini"
project_file "${HOME}/DotCortex/linux/.config/redstone-9x/gtk-3.0/gtk.css" \
  "${GUEST_HOME}/.config/gtk-3.0/gtk.css"
project_file "${HOME}/DotCortex/linux/.config/redstone-9x/gtk-2.0/gtkrc" \
  "${GUEST_HOME}/.gtkrc-2.0"

# Project staged fonts into guest home (idempotent; absent if not yet provisioned).
if [[ -d "${FONT_STAGE}" ]]; then
  mkdir -p "${GUEST_HOME}/.local/share/fonts"
  ln -sfnT "${FONT_STAGE}" "${GUEST_HOME}/.local/share/fonts/redstone-9x"
fi

# Project managed Audacious Winamp skins into the guest.
# Use a merge instead of project_dir to avoid wiping extracted skin folders.
if [[ -d "${HOME}/DotCortex/linux/.local/share/audacious/Skins" ]]; then
  mkdir -p "${GUEST_HOME}/.local/share/audacious/Skins"
  cp -rn "${HOME}/DotCortex/linux/.local/share/audacious/Skins/"*.wsz "${GUEST_HOME}/.local/share/audacious/Skins/" 2>/dev/null || true
fi
# Reuse the managed X230/Qmmp Winamp skin corpus too.  These are standard
# Winamp .wsz archives, so Audacious can load them from its skin directory.
if [[ -d "${HOME}/DotCortex/linux/.qmmp/skins" ]]; then
  for skin in "${HOME}/DotCortex/linux/.qmmp/skins/"*.wsz; do
    [[ -f "${skin}" ]] || continue
    project_file "${skin}" "${GUEST_HOME}/.local/share/audacious/Skins/$(basename "${skin}")"
  done
fi
mkdir -p "${GUEST_HOME}/.config/audacious"
if [[ ! -f "${GUEST_HOME}/.config/audacious/config" ]]; then
  project_file "${HOME}/DotCortex/linux/.config/redstone-9x/audacious/config" \
    "${GUEST_HOME}/.config/audacious/config"
fi

# Win95 desktop icons — symlink declared .desktop files; Desktop itself stays writable
mkdir -p "${GUEST_HOME}/Desktop"
for f in "${HOME}/DotCortex/linux/.icewm/desktop/"*.desktop; do
  [[ -e "$f" ]] && project_file "$f" "${GUEST_HOME}/Desktop/$(basename "$f")"
done

# pcmanfm desktop background — written once on first launch; user can override via preferences.
# Use the default profile so desktop preferences talk to the active desktop manager.
mkdir -p "${GUEST_HOME}/.config/pcmanfm/default"
if [[ ! -f "${GUEST_HOME}/.config/pcmanfm/default/desktop-items-0.conf" ]]; then
  printf '[*]\nwallpaper_mode=color\nwallpaper_bg_color=#008080\n' \
    > "${GUEST_HOME}/.config/pcmanfm/default/desktop-items-0.conf"
fi
if [[ ! -f "${GUEST_HOME}/.config/pcmanfm/default/pcmanfm.conf" ]]; then
  printf '[config]\nbm_open_method=0\n\n[ui]\nshow_hidden=1\nview_mode=icon\n' \
    > "${GUEST_HOME}/.config/pcmanfm/default/pcmanfm.conf"
fi

Xephyr "${DISPLAY_NUM}" -fullscreen -br -ac -dpi 96 -no-host-grab &
XEPHYR_PID=$!
trap "kill ${XEPHYR_PID} 2>/dev/null || true" EXIT

timeout 10 sh -c "until DISPLAY=${DISPLAY_NUM} xdpyinfo >/dev/null 2>&1; do sleep 0.1; done" \
  || { echo "Xephyr ${DISPLAY_NUM} did not become ready"; kill "${XEPHYR_PID}"; exit 1; }

sanctuary-clip-bridge "${HOST_DISPLAY}" "${DISPLAY_NUM}" &
CLIP_BRIDGE_PID=$!
trap "kill ${XEPHYR_PID} ${CLIP_BRIDGE_PID} 2>/dev/null || true" EXIT

# Load Redstone terminal profiles (URxvt named instances) into the Xephyr display.
DISPLAY="${DISPLAY_NUM}" xrdb -merge "${HOME}/DotCortex/linux/.config/redstone-9x/Xresources" \
  2>/dev/null || echo "${SANCTUARY}: warning — Xresources not found, terminals will use defaults"
DISPLAY="${DISPLAY_NUM}" xrandr --dpi 96 2>/dev/null || true

echo "${SANCTUARY}: Xephyr ${DISPLAY_NUM} ready — sourcing Guix profiles and starting IceWM…"
DISPLAY="${DISPLAY_NUM}" sanctuary-exec "${SANCTUARY}" sh -c "
  REDSTONE_GUEST_BIN=${GUEST_HOME}/.local/bin
  GUIX_PROFILE=${GUIX_PROFILES}/desktop-common/desktop-common
  . \${GUIX_PROFILE}/etc/profile
  GUIX_PROFILE=${GUIX_PROFILES}/room-gaming/room-gaming
  . \${GUIX_PROFILE}/etc/profile
  export GTK_THEME=Windows-95
  export XCURSOR_THEME=Win95
  export XCURSOR_SIZE=24
  export GDK_PIXBUF_MODULE_FILE=\${GUIX_PROFILE}/lib/gdk-pixbuf-2.0/2.10.0/loaders.cache
  GUIX_PROFILE=${GUIX_PROFILES}/room-windows-compat/room-windows-compat
  . \${GUIX_PROFILE}/etc/profile
  export XDG_DATA_DIRS=${GUIX_PROFILES}/room-windows-compat/room-windows-compat/share:${GUIX_PROFILES}/room-gaming/room-gaming/share:${GUIX_PROFILES}/desktop-common/desktop-common/share:/usr/local/share:/usr/share
  export XDG_CONFIG_DIRS=${GUIX_PROFILES}/room-windows-compat/room-windows-compat/etc/xdg:${GUIX_PROFILES}/room-gaming/room-gaming/etc/xdg:${GUIX_PROFILES}/desktop-common/desktop-common/etc/xdg:/etc/xdg
  export GSETTINGS_SCHEMA_DIR=${GUIX_PROFILES}/room-gaming/room-gaming/share/glib-2.0/schemas
  export WINEPREFIX=${GUEST_HOME}/.wine-redstone
  export WINEARCH=win64
  export WINEDEBUG=-all
  export DOTCORTEX_DIR=${HOME}/DotCortex
  export PATH=\${REDSTONE_GUEST_BIN}:\${PATH}
  xrdb -merge ${HOME}/DotCortex/linux/.config/redstone-9x/Xresources \
    2>/dev/null || echo ${SANCTUARY}: warning — Redstone Xresources not loaded
  xrandr --dpi 96 2>/dev/null || true
  bash ${HOME}/DotCortex/linux/.local/bin/sanctuary-redstone-9x-wineprefix-init
  exec dbus-run-session icewm-session
"

kill "${XEPHYR_PID}" 2>/dev/null || true
# Sanctuary: sanctuary-redstone-9x — Redstone 9X IceWM:1 ends here
