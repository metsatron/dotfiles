# ── Wine: the IE launcher, the env-wrapped tool dispatcher, and Run-box PATH
# shims. redstone-9x-ie was referenced by the menu but never projected (broken
# Internet Explorer entry) — fixed here. The shims let a bare Win95 command name
# typed in the Run box (explorer, notepad, regedit, ...) resolve to the wine tool
# via redstone-9x-wine, which dispatches on its own invoked name.
for _wine_script in redstone-9x-ie redstone-9x-wine; do
  project_file "${HOME}/DotCortex/linux/.local/bin/${_wine_script}" "${GUEST_HOME}/.local/bin/${_wine_script}"
  chmod +x "${GUEST_HOME}/.local/bin/${_wine_script}"
done
# NB: `control` is deliberately NOT shimmed to wine. ~/.local/bin is first on the
# session PATH, so a `control -> redstone-9x-wine` symlink here would SHADOW the
# real ice2k Control Panel shell at ~/.local/ice2k/bin/control and open Wine's
# control panel instead. Wine's own control panel stays reachable via the
# explicit `redstone-9x-wine control` in the Settings > Wine menu.
for _wine_shim in explorer winefile notepad wordpad write regedit winecfg \
                  taskmgr winemine winhlp32 iexplore oleview \
                  uninstall winetricks wineboot; do
  ln -sfnT "${GUEST_HOME}/.local/bin/redstone-9x-wine" "${GUEST_HOME}/.local/bin/${_wine_shim}"
done
# Run-box shims for the styled terminals: `cmd` and `powershell` (NOT `pwsh` —
# that name is the real PowerShell binary the launcher itself calls; shadowing it
# would recurse).
ln -sfnT "${GUEST_HOME}/.local/bin/redstone-9x-cmd"        "${GUEST_HOME}/.local/bin/cmd"
ln -sfnT "${GUEST_HOME}/.local/bin/redstone-9x-powershell" "${GUEST_HOME}/.local/bin/powershell"
# `bash` and `zsh` DO shadow the real shells (~/.local/bin is first on PATH),
# but redstone-9x-bash/-zsh pass every scripted, argumented, tty, or piped
# invocation through to the real binary — only a bare GUI-context launch (the
# Run box) opens the PowerShell-frame terminal. See sanctuary-redstone-9x-desktop.org.
ln -sfnT "${GUEST_HOME}/.local/bin/redstone-9x-bash"       "${GUEST_HOME}/.local/bin/bash"
ln -sfnT "${GUEST_HOME}/.local/bin/redstone-9x-zsh"        "${GUEST_HOME}/.local/bin/zsh"
mkdir -p "${GUEST_HOME}/.config/redstone-9x/rofi"
project_file "${HOME}/DotCortex/linux/.config/redstone-9x/rofi/Windows95.rasi" "${GUEST_HOME}/.config/redstone-9x/rofi/Windows95.rasi"
project_file "${HOME}/DotCortex/linux/.config/redstone-9x/rofi/Windows95-Run.rasi" "${GUEST_HOME}/.config/redstone-9x/rofi/Windows95-Run.rasi"
project_file "${HOME}/DotCortex/linux/.config/redstone-9x/rofi/config.rasi" "${GUEST_HOME}/.config/redstone-9x/rofi/config.rasi"
for _rofi_script in \
  redstone-9x-rofi-run \
  redstone-9x-rofi-desktop \
  redstone-9x-rofi-launcher \
  redstone-9x-rofi-emoji \
  redstone-9x-rofi-clipboard \
  redstone-9x-rofi-local-bin; do
  project_file "${HOME}/DotCortex/linux/.local/bin/${_rofi_script}" "${GUEST_HOME}/.local/bin/${_rofi_script}"
  chmod +x "${GUEST_HOME}/.local/bin/${_rofi_script}"
done
project_file "${HOME}/DotCortex/linux/.local/bin/redstone-9x-vlc"        "${GUEST_HOME}/.local/bin/redstone-9x-vlc"
chmod +x "${GUEST_HOME}/.local/bin/redstone-9x-vlc"
