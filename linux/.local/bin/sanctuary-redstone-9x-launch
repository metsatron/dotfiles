#!/usr/bin/env bash
# Sanctuary: sanctuary-redstone-9x — Redstone 9X IceWM

# First gaming-wing sanctuary.  IceWM with the Windows NT theme.
# Launch from the current host desktop. Xephyr display: =:93=.
# Guix profiles: =desktop-common= + =room-gaming= (icewm, pcmanfm, xterm) + =room-windows-compat= (wine64, winetricks, fontconfig, powershell, DOS emulation tooling).

# Current DOS direction (2026-07-07): =DOSEMU2= is the terminal-clean DOS lane.
# =DOSBox-X= remains packaged in =room-windows-compat= as an integrated
# compatibility lane for mouse-heavy DOS software, Windows 3.x, and booted
# Win9x machine profiles. New Redstone DOS work uses the host-visible =.compat/=
# runtime spine and =.dosemu/= bridge declared below.

# The launcher projects =DotCortex/linux/.icewm/= directly into the isolated guest
# home before launching Xephyr — IceWM reads config, theme, and menu from org-managed
# source. =pcmanfm --desktop= (via =~/.icewm/startup=) manages Win95-style desktop
# icons (My Computer, My Documents, Recycle Bin) from =linux/.icewm/desktop/=.
# Recycle Bin opens the real on-disk Trash folder directly (no GVFS =trash://=
# URI — room-gaming deliberately has no =gvfs=; a 2026-07-07 retry leaked the
# HOST's real Trash contents into the sandboxed room via distrobox's /run/host
# bind mount, on top of the earlier libfm crash risk — see
# redstone-9x-state-digest.md) and a small poller (=redstone-9x-recycle-bin-watch=,
# launched from =~/.icewm/startup=) keeps its icon in sync with full/empty state.

# The Redstone create stanza uses Distrobox's existing =--init-hooks= mechanism to create
# =/opt/retropie/supplementary/runcommand/= and symlink =runcommand.sh= to the projected guest-home
# =~/.local/bin/runcommand-shim=. The target is projected by the launcher before either WM starts;
# the hook is scoped to =sanctuary-redstone-9x=, whose IceWM and FVWM95 menus expose the ports lane.


# [[file:../../../sanctuary-redstone-9x.org::*Sanctuary: sanctuary-redstone-9x — Redstone 9X IceWM][Sanctuary: sanctuary-redstone-9x — Redstone 9X IceWM:1]]
# Launch sanctuary-redstone-9x: Xephyr :93 + selected desktop inside the Guix container.
# Launch from the host desktop; no workspace hop is required.
# Desktop is selected via SANCTUARY_DESKTOP env var (set by sanctuary-enter).
# Prerequisites:
#   loom guix:sanctuary-apply   ← builds desktop-common + room-gaming + room-windows-compat
#   distrobox-sanctuaries-create
#   vm-homes-init
#   sanctuary-redstone-9x-fvwm95-build   ← (fvwm95 desktop only)
set -euo pipefail

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  cat <<EOF
sanctuary-redstone-9x-launch - launch sanctuary-redstone-9x (Xephyr :93 + IceWM/FVWM95, Redstone 9X)

Usage: sanctuary-redstone-9x-launch

No positional arguments. Desktop spin is selected via the SANCTUARY_DESKTOP
environment variable (icewm [default] or fvwm95) — set automatically by
sanctuary-enter, or export it yourself before calling this directly.

Prerequisites:
  loom guix:sanctuary-apply   (desktop-common + room-gaming + room-windows-compat)
  distrobox-sanctuaries-create
  vm-homes-init
  sanctuary-redstone-9x-fvwm95-build   (fvwm95 desktop only)

Normally invoked via: sanctuary-enter sanctuary-redstone-9x[:icewm|:fvwm95]
EOF
  exit 0
fi

DESKTOP="${SANCTUARY_DESKTOP:-icewm}"
DISPLAY_NUM=":93"
HOST_DISPLAY="${DISPLAY}"
SANCTUARY="sanctuary-redstone-9x"
GUESTS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/dotcortex/guests"
GUEST_HOME="${GUESTS_DIR}/${SANCTUARY}/home"
GUIX_PROFILES="${HOME}/.guix-extra-profiles"
FONT_STAGE="${GUESTS_DIR}/${SANCTUARY}/fonts"
RETROPIE_HOST_ROOT="${HOME}/RetroPie"
RETROPIE_CONTAINER_ROOT="/run/dotcortex/retropie"

# Preflight: verify all required Guix profiles exist before launching.
_missing=0
for _prof in desktop-common room-gaming room-windows-compat; do
  _path="${GUIX_PROFILES}/${_prof}/${_prof}/etc/profile"
  if [[ ! -f "${_path}" ]]; then
    echo "${SANCTUARY}: ERROR — Guix profile not built: ${_prof}"
    echo "  Build it with: make guix-${_prof}"
    _missing=1
  fi
done
if [[ "${_missing}" -eq 1 ]]; then
  echo ""
  echo "Run 'make guix-room-windows-compat' (builds all sanctuary profiles) then retry."
  exit 1
fi

prepare_retropie_tree() {
  local host_ports="${RETROPIE_HOST_ROOT}/roms/ports"
  local guest_link="${GUEST_HOME}/RetroPie"

  # Follow the host ~/RetroPie link before Podman starts. This access triggers
  # the direct autofs mount; if it cannot produce the NFS-backed ports tree,
  # stop before opening Xephyr or presenting an empty desktop menu.
  if ! stat -L -- "${host_ports}" >/dev/null 2>&1; then
    echo "${SANCTUARY}: ERROR — RetroPie tree unavailable on the host" >&2
    echo "  Expected a readable ports directory at: ${host_ports}" >&2
    echo "  The automount did not become available; container start was not attempted." >&2
    exit 1
  fi

  if [[ ! -d "${GUEST_HOME}" ]]; then
    echo "${SANCTUARY}: ERROR — guest home missing: ${GUEST_HOME}" >&2
    echo "  Run vm-homes-init first." >&2
    exit 1
  fi
  if [[ -e "${guest_link}" && ! -L "${guest_link}" ]]; then
    echo "${SANCTUARY}: ERROR — refusing to replace non-symlink guest path: ${guest_link}" >&2
    exit 1
  fi
  ln -sfnT "${RETROPIE_CONTAINER_ROOT}" "${guest_link}"

  sanctuary-retropie-bind-ensure "${SANCTUARY}" "${RETROPIE_CONTAINER_ROOT}"
}

prepare_retropie_tree

# Verify desktop-specific prerequisites.
if [[ "${DESKTOP}" == "fvwm95" ]]; then
  if [[ ! -x "${GUEST_HOME}/.local/fvwm95/bin/fvwm95" ]]; then
    echo "${SANCTUARY}: fvwm95 not built — run sanctuary-redstone-9x-fvwm95-build first" >&2
    exit 1
  fi
fi

# Project DotCortex-managed config into isolated guest home.
# Copy, do not symlink: the host repo path is not visible inside the container.
project_file() {
  local src="$1" dst="$2"
  mkdir -p "$(dirname "${dst}")"
  rm -f "${dst}"
  cp -f "${src}" "${dst}"
}

project_dir() {
  local src="$1" dst="$2" tmp="${2}.tmp"
  mkdir -p "$(dirname "${dst}")"
  rm -rf "${tmp}"
  cp -a "${src}" "${tmp}"
  rm -rf "${dst}"
  mv "${tmp}" "${dst}"
}

# ── Desktop-specific config projection ──
if [[ "${DESKTOP}" == "icewm" ]]; then
  mkdir -p "${GUEST_HOME}/.icewm"
  project_dir "${HOME}/DotCortex/linux/.icewm/themes" "${GUEST_HOME}/.icewm/themes"
  project_file "${HOME}/DotCortex/linux/.icewm/preferences" "${GUEST_HOME}/.icewm/preferences"
  project_file "${HOME}/DotCortex/linux/.icewm/menu" "${GUEST_HOME}/.icewm/menu"
  project_file "${HOME}/DotCortex/linux/.icewm/toolbar" "${GUEST_HOME}/.icewm/toolbar"
  project_file "${HOME}/DotCortex/linux/.icewm/keys" "${GUEST_HOME}/.icewm/keys"
  project_file "${HOME}/DotCortex/linux/.icewm/winoptions" "${GUEST_HOME}/.icewm/winoptions"
  project_file "${HOME}/DotCortex/linux/.icewm/startup" "${GUEST_HOME}/.icewm/startup"
  chmod +x "${GUEST_HOME}/.icewm/startup"
  # Win95 desktop icons
  mkdir -p "${GUEST_HOME}/Desktop"
  for f in "${HOME}/DotCortex/linux/.icewm/desktop/"*.desktop; do
    [[ -e "$f" ]] && project_file "$f" "${GUEST_HOME}/Desktop/$(basename "$f")"
  done
  # pcmanfm desktop background
  mkdir -p "${GUEST_HOME}/.config/pcmanfm/default"
  if [[ ! -f "${GUEST_HOME}/.config/pcmanfm/default/desktop-items-0.conf" ]]; then
    printf '[*]
wallpaper_mode=color
wallpaper_bg_color=#008080
'       > "${GUEST_HOME}/.config/pcmanfm/default/desktop-items-0.conf"
  fi
  if [[ ! -f "${GUEST_HOME}/.config/pcmanfm/default/pcmanfm.conf" ]]; then
    printf '[config]
bm_open_method=0

[ui]
show_hidden=1
view_mode=icon
'       > "${GUEST_HOME}/.config/pcmanfm/default/pcmanfm.conf"
  fi
  # libfm shows an "execute this file?" confirm dialog before launching any
  # desktop-icon .desktop entry (UI policy, not a per-file trust/exec-bit
  # check). quick_exec=1 suppresses it. Upsert rather than write-once so an
  # existing guest whose libfm.conf predates this key self-heals too.
  mkdir -p "${GUEST_HOME}/.config/libfm"
  if [[ ! -f "${GUEST_HOME}/.config/libfm/libfm.conf" ]]; then
    printf '[config]
quick_exec=1
'       > "${GUEST_HOME}/.config/libfm/libfm.conf"
  elif grep -q '^quick_exec=' "${GUEST_HOME}/.config/libfm/libfm.conf"; then
    sed -i 's/^quick_exec=.*/quick_exec=1/' "${GUEST_HOME}/.config/libfm/libfm.conf"
  elif grep -q '^\[config\]$' "${GUEST_HOME}/.config/libfm/libfm.conf"; then
    sed -i '/^\[config\]$/a quick_exec=1' "${GUEST_HOME}/.config/libfm/libfm.conf"
  else
    printf '[config]\nquick_exec=1\n\n' | cat - "${GUEST_HOME}/.config/libfm/libfm.conf" > "${GUEST_HOME}/.config/libfm/libfm.conf.tmp"
    mv "${GUEST_HOME}/.config/libfm/libfm.conf.tmp" "${GUEST_HOME}/.config/libfm/libfm.conf"
  fi
elif [[ "${DESKTOP}" == "fvwm95" ]]; then
  # Project FVWM95 config
  project_file "${HOME}/DotCortex/linux/.config/redstone-9x/fvwm95/system.fvwm95rc"     "${GUEST_HOME}/.fvwm95rc"
  # FvwmTaskBar's GoodyLoadable CopyString does not expand $HOME, so patch the
  # absolute guest plugins path into the projected config.
  sed -i "s|@GUEST_PLUGINS@|${GUEST_HOME}/.local/fvwm95/lib/X11/fvwm95/plugins|g" "${GUEST_HOME}/.fvwm95rc"

  # ── xclass custom desktop icons + native desktop objects ──
  # The 32x32 XPMs are generated reproducibly from existing canonical PNG
  # icon sources (Chicago95 / BeOS). 'documents.xpm' already ships in the
  # xclass icon pool, so My Documents reuses it.
  DC_ICON_SRC="${HOME}/DotCortex/linux/.local/share/icons"
  XCLASS_POOL="${GUEST_HOME}/.local/xclass/share/xclass-icons"
  mkdir -p "${XCLASS_POOL}"
  python3 "${HOME}/DotCortex/linux/.local/bin/png2xpm.py" "${DC_ICON_SRC}/Chicago95/devices/32/computer.png"        "${XCLASS_POOL}/mycomputer.xpm" mycomputer
  python3 "${HOME}/DotCortex/linux/.local/bin/png2xpm.py" "${DC_ICON_SRC}/Chicago95/apps/32/firefox_2.png"          "${XCLASS_POOL}/firefox.xpm" firefox
  python3 "${HOME}/DotCortex/linux/.local/bin/png2xpm.py" "${DC_ICON_SRC}/BeOS-r5-Icons/places/32/my_briefcase.png"  "${XCLASS_POOL}/briefcase.xpm" briefcase
  # P16: period-appropriate icons for New Text Document / New Bitmap Image so
  # they are not generic blank-file icons. Generated from Chicago95 mimetypes.
  python3 "${HOME}/DotCortex/linux/.local/bin/png2xpm.py" "${DC_ICON_SRC}/Chicago95/mimes/32/text-plain.png"  "${XCLASS_POOL}/textdoc.xpm" textdoc
  python3 "${HOME}/DotCortex/linux/.local/bin/png2xpm.py" "${DC_ICON_SRC}/Chicago95/mimes/32/image-bmp.png"   "${XCLASS_POOL}/bitmap.xpm"  bitmap

  # P16b: game + multimedia XPMs for FVWM95 menus, generated from each app's
  # own hicolor icon (no new artwork). Sources: room-gaming profile (Guix
  # games), sanctuary-sx profile (VLC), and the host Flatpak exports.
  _RG=${HOME}/.guix-extra-profiles/room-gaming/room-gaming
  _SX=${HOME}/.guix-extra-profiles/sanctuary-sx/sanctuary-sx
  _FP=${HOME}/.local/share/flatpak/exports/share/icons/hicolor/48x48/apps
  _gen_icon() { # src  outname
    if [[ -f "$1" ]]; then
      python3 "${HOME}/DotCortex/linux/.local/bin/png2xpm.py" "$1" "${XCLASS_POOL}/$2.xpm" "$2" 2>/dev/null || true
    fi
  }
  # corsix-th ships only an SVG; rasterise to a 48px PNG first if rsvg is available
  if [[ -f "${_RG}/share/icons/hicolor/scalable/apps/corsix-th.svg" ]] && command -v rsvg-convert >/dev/null 2>&1; then
    rsvg-convert -w 48 -h 48 "${_RG}/share/icons/hicolor/scalable/apps/corsix-th.svg" -o /tmp/corsix-th-48.png 2>/dev/null && _gen_icon /tmp/corsix-th-48.png corsixth
  fi
  _gen_icon "${_RG}/share/icons/hicolor/48x48/apps/gnubg.png"                                  gnubg
  _gen_icon "${_RG}/share/icons/hicolor/48x48/apps/freeciv-client.png"                          freeciv
  _gen_icon "${_RG}/share/icons/hicolor/48x48/apps/openttd.png"                                openttd
  _gen_icon "${_RG}/share/icons/hicolor/48x48/apps/openrct2.png"                              openrct2
  _gen_icon "${_SX}/share/icons/hicolor/48x48/apps/vlc.png"                                   vlc
  _gen_icon "${_FP}/net.openra.OpenRA.png"                                     openra
  _gen_icon "${_FP}/com.donhopkins.Micropolis.png"                              micropolis
  _gen_icon "${_FP}/com.github.k4zmu2a.spacecadetpinball.png"                  pinball
  # dsdmine: built from DragonSWDev/dsdmine GitHub source. Icon from repo assets.
  _gen_icon "${HOME}/.local/share/dsdmine/assets/icon.png"   dsdmine

  # Native desktop objects: real executable scripts, NOT symlinks, so they
  # carry no shortcut-arrow overlay (xclass draws the arrow only on symlinks).
  # Double-click of an executable runs './<name>' (OXDesktopContainer::DoAction),
  # so each script forwards to the real program. Icons come from desktoprc.
  DC_DIR="${GUEST_HOME}/.xclass/desktop"
  mkdir -p "${DC_DIR}"
  rm -f "${DC_DIR}/Home"            # _CreateDesktop no longer creates this (Patch 13)
  rm -rf "${DC_DIR}/New Folder"     # stale junk from earlier sessions
  _write_obj() { printf '#!/bin/sh\nexec %s\n' "$2" > "${DC_DIR}/$1"; chmod +x "${DC_DIR}/$1"; }
  _write_obj "My Computer" 'explorer /'
  _write_obj "My Documents" 'explorer "$HOME"'
  _write_obj "Firefox" 'firefox'

  # desktoprc: per-object icon overrides + default positions (left column).
  # Written only when absent, so user-customised positions survive later
  # runs; Save() persists current icons, keeping the overrides stable.
  DESKTOPRC="${GUEST_HOME}/.xclass/etc/desktoprc"
  if [[ ! -f "${DESKTOPRC}" ]]; then
    mkdir -p "$(dirname "${DESKTOPRC}")"
    cat > "${DESKTOPRC}" <<'RC'
[My Computer]
icon=mycomputer.xpm
position=12,12

[My Documents]
icon=documents.xpm
position=12,96

[Firefox]
icon=firefox.xpm
position=12,180

[Recycle Bin]
icon=recycle-empty.s.xpm
position=12,264
RC
  fi

  # P16/17: normalise stale generic icon= overrides for *.txt and *.bmp
  # desktop objects so the GetIconPics special-case (textdoc.xpm /
  # bitmap.xpm) wins on refresh instead of being clobbered by an older
  # desktoprc value written before these icons existed.
  python3 - "${DESKTOPRC}" <<'PY'
import sys, re
p = sys.argv[1]
try:
    s = open(p).read()
except OSError:
    sys.exit(0)
toks = re.split(r'(\[[^\]]+\])', s)
out = []
name = None
for t in toks:
    if t.startswith('[') and t.endswith(']'):
        name = t[1:-1].strip()
        out.append(t)
    elif name and '=' in t:
        if name.lower().endswith('.txt'):
            t = re.sub(r'(?m)^icon\s*=.*$', 'icon = textdoc.xpm', t)
        elif name.lower().endswith('.bmp'):
            t = re.sub(r'(?m)^icon\s*=.*$', 'icon = bitmap.xpm', t)
        out.append(t)
    else:
        out.append(t)
open(p, 'w').write(''.join(out))
PY
fi

# ── Shared projections (all desktops) ──

# GTK theme
mkdir -p "${GUEST_HOME}/.themes"
project_dir "${HOME}/DotCortex/linux/.themes/Windows-95" "${GUEST_HOME}/.themes/Windows-95"

# Icon theme
mkdir -p "${GUEST_HOME}/.local/share/icons"
project_dir "${HOME}/DotCortex/linux/.local/share/icons/Chicago95"   "${GUEST_HOME}/.local/share/icons/Chicago95"

# PowerShell profile
mkdir -p "${GUEST_HOME}/.config/powershell"
project_file "${HOME}/DotCortex/linux/.config/powershell/Microsoft.PowerShell_profile.ps1"   "${GUEST_HOME}/.config/powershell/Microsoft.PowerShell_profile.ps1"

# Redstone launcher wrappers
mkdir -p "${GUEST_HOME}/.local/bin"
project_file "${HOME}/DotCortex/linux/.local/bin/redstone-9x-run"   "${GUEST_HOME}/.local/bin/redstone-9x-run"
chmod +x "${GUEST_HOME}/.local/bin/redstone-9x-run"
project_file "${HOME}/DotCortex/linux/.local/bin/redstone-9x-compat-init"   "${GUEST_HOME}/.local/bin/redstone-9x-compat-init"
chmod +x "${GUEST_HOME}/.local/bin/redstone-9x-compat-init"
project_file "${HOME}/DotCortex/linux/.local/bin/redstone-9x-pwsh"   "${GUEST_HOME}/.local/bin/redstone-9x-pwsh"
chmod +x "${GUEST_HOME}/.local/bin/redstone-9x-pwsh"
project_file "${HOME}/DotCortex/linux/.local/bin/redstone-9x-dosemu2-init"   "${GUEST_HOME}/.local/bin/redstone-9x-dosemu2-init"
chmod +x "${GUEST_HOME}/.local/bin/redstone-9x-dosemu2-init"
project_file "${HOME}/DotCortex/linux/.local/bin/redstone-9x-dos"   "${GUEST_HOME}/.local/bin/redstone-9x-dos"
chmod +x "${GUEST_HOME}/.local/bin/redstone-9x-dos"
project_file "${HOME}/DotCortex/linux/.local/bin/redstone-9x-dosemu2-shell"   "${GUEST_HOME}/.local/bin/redstone-9x-dosemu2-shell"
chmod +x "${GUEST_HOME}/.local/bin/redstone-9x-dosemu2-shell"
project_file "${HOME}/DotCortex/linux/.local/bin/redstone-9x-dosbox-x"   "${GUEST_HOME}/.local/bin/redstone-9x-dosbox-x"
chmod +x "${GUEST_HOME}/.local/bin/redstone-9x-dosbox-x"
project_file "${HOME}/DotCortex/linux/.local/bin/redstone-9x-explorer"   "${GUEST_HOME}/.local/bin/redstone-9x-explorer"
chmod +x "${GUEST_HOME}/.local/bin/redstone-9x-explorer"
project_file "${HOME}/DotCortex/linux/.local/bin/redstone-9x-icons-grid" "${GUEST_HOME}/.local/bin/redstone-9x-icons-grid"
chmod +x "${GUEST_HOME}/.local/bin/redstone-9x-icons-grid"
mkdir -p "${GUEST_HOME}/.config/redstone-9x/rofi"
project_file "${HOME}/DotCortex/linux/.config/redstone-9x/rofi/Windows95.rasi" "${GUEST_HOME}/.config/redstone-9x/rofi/Windows95.rasi"
project_file "${HOME}/DotCortex/linux/.config/redstone-9x/rofi/Windows95-Run.rasi" "${GUEST_HOME}/.config/redstone-9x/rofi/Windows95-Run.rasi"
project_file "${HOME}/DotCortex/linux/.config/redstone-9x/rofi/config.rasi" "${GUEST_HOME}/.config/redstone-9x/rofi/config.rasi"
for _rofi_script in \
  redstone-9x-rofi-run \
  redstone-9x-rofi-desktop \
  redstone-9x-rofi-launcher \
  redstone-9x-rofi-emoji \
  redstone-9x-rofi-clipboard \
  redstone-9x-rofi-local-bin; do
  project_file "${HOME}/DotCortex/linux/.local/bin/${_rofi_script}" "${GUEST_HOME}/.local/bin/${_rofi_script}"
  chmod +x "${GUEST_HOME}/.local/bin/${_rofi_script}"
done
project_file "${HOME}/DotCortex/linux/.local/bin/redstone-9x-vlc"        "${GUEST_HOME}/.local/bin/redstone-9x-vlc"
chmod +x "${GUEST_HOME}/.local/bin/redstone-9x-vlc"
project_file "${HOME}/DotCortex/linux/.local/bin/redstone-9x-openra"     "${GUEST_HOME}/.local/bin/redstone-9x-openra"
chmod +x "${GUEST_HOME}/.local/bin/redstone-9x-openra"
project_file "${HOME}/DotCortex/linux/.local/bin/redstone-9x-micropolis"  "${GUEST_HOME}/.local/bin/redstone-9x-micropolis"
chmod +x "${GUEST_HOME}/.local/bin/redstone-9x-micropolis"
project_file "${HOME}/DotCortex/linux/.local/bin/redstone-9x-pinball"    "${GUEST_HOME}/.local/bin/redstone-9x-pinball"
chmod +x "${GUEST_HOME}/.local/bin/redstone-9x-pinball"
project_file "${HOME}/DotCortex/linux/.local/bin/redstone-9x-dsdmine"    "${GUEST_HOME}/.local/bin/redstone-9x-dsdmine"
chmod +x "${GUEST_HOME}/.local/bin/redstone-9x-dsdmine"
# RetroPie ports launch lane: the menu generator and runcommand target are
# projected before either IceWM or FVWM95 reads its menu. The create hook above
# points /opt/retropie/supplementary/runcommand/runcommand.sh at this target.
project_file "${HOME}/DotCortex/linux/.local/bin/ports-menu-gen" "${GUEST_HOME}/.local/bin/ports-menu-gen"
chmod +x "${GUEST_HOME}/.local/bin/ports-menu-gen"
project_file "${HOME}/DotCortex/linux/.local/bin/runcommand-shim" "${GUEST_HOME}/.local/bin/runcommand-shim"
chmod +x "${GUEST_HOME}/.local/bin/runcommand-shim"
project_file "${HOME}/DotCortex/linux/.local/bin/redstone-9x-recycle-bin-watch"    "${GUEST_HOME}/.local/bin/redstone-9x-recycle-bin-watch"
chmod +x "${GUEST_HOME}/.local/bin/redstone-9x-recycle-bin-watch"
# ── Redstone shell identity: Win9x DOS prompt + fastfetch greeting ──
# Shared sanctuary greeting grammar (mirrors sanctuary-sx): symlink the DotCortex
# source live into the guest home so edits reflect without a relaunch. The host
# repo path is visible inside the container, so symlinks resolve. The zsh link
# REPLACES vm-homes-init's global-.zshrc symlink; the sanctuary zshrc sources the
# global one itself, so nothing global is edited.
REDSTONE_SHELL_CFG="${HOME}/DotCortex/linux/.config/redstone-9x"
mkdir -p "${GUEST_HOME}/.config/fastfetch"
ln -sfnT "${REDSTONE_SHELL_CFG}/fastfetch.jsonc"     "${GUEST_HOME}/.config/fastfetch/config.jsonc"
ln -sfnT "${REDSTONE_SHELL_CFG}/shell/bashrc"        "${GUEST_HOME}/.bashrc"
ln -sfnT "${REDSTONE_SHELL_CFG}/shell/bash_profile"  "${GUEST_HOME}/.bash_profile"
ln -sfnT "${REDSTONE_SHELL_CFG}/shell/zshrc"         "${GUEST_HOME}/.zshrc"
# sanctuary-flatpak-run is the runner the flatpak game wrappers exec; project a
# COPY (the host repo path is not visible inside the container, so the
# stowed symlink would be broken there).
project_file "${HOME}/DotCortex/linux/.local/bin/sanctuary-flatpak-run"  "${GUEST_HOME}/.local/bin/sanctuary-flatpak-run"
chmod +x "${GUEST_HOME}/.local/bin/sanctuary-flatpak-run"
project_file "${HOME}/DotCortex/linux/.config/redstone-9x/powershell/basic-repl.ps1"   "${GUEST_HOME}/.config/redstone-9x/powershell/basic-repl.ps1"

# My Briefcase — a real working folder (not a sync engine; true Win95 Briefcase
# sync is out of scope). Created if absent so the desktop shortcut resolves.
mkdir -p "${GUEST_HOME}/Briefcase"
# Project a period-appropriate Briefcase icon (BeOS 'my_briefcase') into the
# projected Chicago95 theme so Icon=my_briefcase resolves at 16/32px.
mkdir -p "${GUEST_HOME}/.local/share/icons/Chicago95/places/16" \
         "${GUEST_HOME}/.local/share/icons/Chicago95/places/32" \
         "${GUEST_HOME}/.local/share/icons/Chicago95/places/48"
cp -f "${HOME}/DotCortex/linux/.local/share/icons/BeOS-r5-Icons/places/16/my_briefcase.png" \
      "${GUEST_HOME}/.local/share/icons/Chicago95/places/16/my_briefcase.png" 2>/dev/null || true
cp -f "${HOME}/DotCortex/linux/.local/share/icons/BeOS-r5-Icons/places/32/my_briefcase.png" \
      "${GUEST_HOME}/.local/share/icons/Chicago95/places/32/my_briefcase.png" 2>/dev/null || true
cp -f "${HOME}/DotCortex/linux/.local/share/icons/BeOS-r5-Icons/places/32/my_briefcase.png" \
      "${GUEST_HOME}/.local/share/icons/Chicago95/places/48/my_briefcase.png" 2>/dev/null || true

# IceWM does not resolve icon names out of the Chicago95 XDG theme — pcmanfm (GTK)
# does, which is why the DESKTOP icons render from Chicago95 while the identical name
# in the menu or the quick-launch strip comes up empty.  Worse, IceWM does not draw a
# fallback: a toolbar `prog` whose icon it cannot find is dropped from the strip
# entirely, so the failure looks like a missing BUTTON, not a missing icon, and sends
# you hunting for the wrong bug.  Every icon name that appears to "work" in the menu
# (firefox_2, multimedia, system-file-manager) is one that also exists in a theme IceWM
# does read; nothing that lives only in Chicago95 ever resolves.
#
# IceWM's own icon directory always works, so graft the sanctuary's app icons there,
# size-suffixed the way IceWM expects.  Verified inside the guest: name lookup fails,
# ~/.icewm/icons and absolute paths both succeed.
mkdir -p "${GUEST_HOME}/.icewm/icons"
for _icon in winamp ultimate-doom quake diablo hellfire theme-hospital duke-nukem-3d red-alert command-conquer half-life blue-shift opposing-force zsnes snes9x mupen64plus ms-dos-prompt retroarch msn inbox; do
  for _size in 16 32 48; do
    cp -f "${GUEST_HOME}/.local/share/icons/Chicago95/apps/${_size}/${_icon}.png" \
          "${GUEST_HOME}/.icewm/icons/${_icon}_${_size}x${_size}.png" 2>/dev/null || true
  done
done

# GTK config
mkdir -p "${GUEST_HOME}/.config/gtk-3.0"
project_file "${HOME}/DotCortex/linux/.config/redstone-9x/gtk-3.0/settings.ini"   "${GUEST_HOME}/.config/gtk-3.0/settings.ini"
project_file "${HOME}/DotCortex/linux/.config/redstone-9x/gtk-3.0/gtk.css"   "${GUEST_HOME}/.config/gtk-3.0/gtk.css"
project_file "${HOME}/DotCortex/linux/.config/redstone-9x/gtk-2.0/gtkrc"   "${GUEST_HOME}/.gtkrc-2.0"

# Fonts
# Redstone keeps its sanctuary-local Microsoft/period fonts in FONT_STAGE, but
# it also needs the host's merged ~/.local/share/fonts tree so families moved
# to helmstow or local font triage remain visible inside the room.
HOST_FONT_ROOT="${HOME}/.local/share/fonts"
if [[ -d "${HOST_FONT_ROOT}" ]]; then
  mkdir -p "${GUEST_HOME}/.local/share/fonts"
  ln -sfnT "${HOST_FONT_ROOT}" "${GUEST_HOME}/.local/share/fonts/host-user"
fi
if [[ -d "${FONT_STAGE}" ]]; then
  mkdir -p "${GUEST_HOME}/.local/share/fonts"
  ln -sfnT "${FONT_STAGE}" "${GUEST_HOME}/.local/share/fonts/redstone-9x"
fi

# Audacious Winamp skins
if [[ -d "${HOME}/DotCortex/linux/.local/share/audacious/Skins" ]]; then
  mkdir -p "${GUEST_HOME}/.local/share/audacious/Skins"
  cp -rn "${HOME}/DotCortex/linux/.local/share/audacious/Skins/"*.wsz "${GUEST_HOME}/.local/share/audacious/Skins/" 2>/dev/null || true
fi
if [[ -d "${HOME}/DotCortex/linux/.qmmp/skins" ]]; then
  for skin in "${HOME}/DotCortex/linux/.qmmp/skins/"*.wsz; do
    [[ -f "${skin}" ]] || continue
    project_file "${skin}" "${GUEST_HOME}/.local/share/audacious/Skins/$(basename "${skin}")"
  done
fi
mkdir -p "${GUEST_HOME}/.config/audacious"
if [[ ! -f "${GUEST_HOME}/.config/audacious/config" ]]; then
  project_file "${HOME}/DotCortex/linux/.config/redstone-9x/audacious/config"     "${GUEST_HOME}/.config/audacious/config"
fi

# Redstone runtime spine and DOS bridge.
"${GUEST_HOME}/.local/bin/redstone-9x-compat-init" --quiet
"${GUEST_HOME}/.local/bin/redstone-9x-dosemu2-init"

# ── Tear down any surviving prior session before launching fresh ──
sanctuary-teardown-stale-session "${SANCTUARY}" "${DISPLAY_NUM}"

# ── Xephyr ──
Xephyr "${DISPLAY_NUM}" -fullscreen -br -ac -dpi 96 -no-host-grab &
XEPHYR_PID=$!
trap "kill ${XEPHYR_PID} 2>/dev/null || true" EXIT

timeout 10 sh -c "until DISPLAY=${DISPLAY_NUM} xdpyinfo >/dev/null 2>&1; do sleep 0.1; done"   || { echo "Xephyr ${DISPLAY_NUM} did not become ready"; kill "${XEPHYR_PID}"; exit 1; }

sanctuary-clip-bridge "${HOST_DISPLAY}" "${DISPLAY_NUM}" &
CLIP_BRIDGE_PID=$!
trap "kill ${XEPHYR_PID} ${CLIP_BRIDGE_PID} 2>/dev/null || true" EXIT

# Load Redstone terminal profiles (URxvt named instances) into the Xephyr display.
DISPLAY="${DISPLAY_NUM}" xrdb -merge "${HOME}/DotCortex/linux/.config/redstone-9x/Xresources"   2>/dev/null || echo "${SANCTUARY}: warning — Xresources not found, terminals will use defaults"
DISPLAY="${DISPLAY_NUM}" xrandr --dpi 96 2>/dev/null || true

# Set Win95-style cursor on the Xephyr root window.
# Run on the HOST: install Chicago95 in host ~/.icons (see fvwm95-build script)
# and set XCURSOR_THEME/PATH so xsetroot's XCreateFontCursor is themed via
# libX11's dlopen of libXcursor. Without XCURSOR_PATH including ~/.icons,
# the host libXcursor searches only system dirs and falls back to the bare
# X font cursor (the plain Unix arrow).
DISPLAY="${DISPLAY_NUM}" XCURSOR_THEME=Chicago95_Cursor_White XCURSOR_SIZE=24 XCURSOR_PATH="${HOME}/.icons:/usr/share/icons" xsetroot -cursor_name top_left_arrow -solid "#008080" 2>/dev/null || true

# ── Shield trash:/// from host fleet NFS mounts (see sanctuary-trash-shield) ──
sanctuary-trash-shield "${SANCTUARY}" "${HOME}"

# ── Launch selected desktop ──
if [[ "${DESKTOP}" == "fvwm95" ]]; then
  echo "${SANCTUARY}: Xephyr ${DISPLAY_NUM} ready — starting FVWM95…"
  DISPLAY="${DISPLAY_NUM}" sanctuary-exec "${SANCTUARY}" sh -c "
    GUIX_PROFILE=${GUIX_PROFILES}/desktop-common/desktop-common
    . \${GUIX_PROFILE}/etc/profile
    GUIX_PROFILE=${GUIX_PROFILES}/room-gaming/room-gaming
    . \${GUIX_PROFILE}/etc/profile
    GUIX_PROFILE=${GUIX_PROFILES}/room-windows-compat/room-windows-compat
    . \${GUIX_PROFILE}/etc/profile
    export WINEPREFIX=${GUEST_HOME}/.wine-redstone
    export WINEARCH=win64
    export WINEDEBUG=-all
    export PATH=${GUEST_HOME}/.local/bin:${GUEST_HOME}/.local/fvwm95/bin:${GUEST_HOME}/.local/xclass/bin:\${PATH}
    export LIBRARY_PATH=${GUEST_HOME}/.local/xclass/lib:\${LIBRARY_PATH:-}
    export LD_LIBRARY_PATH=${GUEST_HOME}/.local/xclass/lib:${GUIX_PROFILES}/desktop-common/desktop-common/lib:\${LD_LIBRARY_PATH:-}
    export OX_POOL=${GUEST_HOME}/.local/xclass/share/xclass-icons
    export XDG_DATA_DIRS=${GUIX_PROFILES}/room-windows-compat/room-windows-compat/share:${GUIX_PROFILES}/room-gaming/room-gaming/share:${GUIX_PROFILES}/desktop-common/desktop-common/share:/home/metsatron/.local/share/flatpak/exports/share:/usr/local/share:/usr/share
    bash ${HOME}/DotCortex/linux/.local/bin/sanctuary-redstone-9x-wineprefix-init
    export GTK_THEME=Windows-95
    # GTK3 overlay (auto-hide fading) scrollbars — disable for classic reserved-gutter
    # scrollbars in pcmanfm and all GTK3 apps. Set before the WM starts so every
    # pcmanfm instance (desktop daemon + file-manager windows) inherits it.
    export GTK_OVERLAY_SCROLLING=0
    export GTK_CSD=0
    # Suppress the xdg-desktop-portal storm: GTK3 apps (aisleriot, gnubg, ...)
    # otherwise activate org.freedesktop.portal.Desktop + PermissionStore +
    # Documents on every launch, adding multi-second latency per app. The
    # Redstone sanctuary does not use portal file pickers.
    export GTK_USE_PORTAL=0
    export GIO_USE_PORTAL=0
    # Suppress the at-spi2 accessibility bridge: each GTK app launched inside
    # dbus-run-session otherwise spawns its own at-spi2 bus daemon (1 inotify
    # instance each, never reaped) and saturates max_user_instances=128. The
    # Redstone games/accessories do not need accessibility services.
    export NO_AT_BRIDGE=1
    export XCURSOR_THEME=Chicago95_Cursor_White
    export XCURSOR_SIZE=24
    # Guix profiles set XCURSOR_PATH to their own share/icons, which OVERRIDES
    # libXcursor's default ~/.icons search. Prepend guest ~/.icons + system
    # path so the Chicago95 theme installed there is actually found.
    export XCURSOR_PATH=\${HOME}/.icons:/usr/share/icons:\${XCURSOR_PATH}
    # Symlink icons so fvwm95's compiled-in icon path finds them
    ln -sf ${GUEST_HOME}/.local/fvwm95/lib/X11/icons ${GUEST_HOME}/.local/fvwm95/icons 2>/dev/null || true
    exec dbus-run-session sh -c 'gamemoded -d >/dev/null 2>&1 || true; exec fvwm95'
  "
else
  # Pre-warm the Ports menu cache BEFORE the WM starts.  The library is >1000 launchers
  # and a cold generation takes ~0.8s — past IceWM's menuprog timeout, so the first open
  # after a reboot would show "Ports menu is refreshing — reopen" instead of the menu.
  # Building it here, while Xephyr is already up and the user has not clicked anything,
  # costs nothing visible and means the menu is always warm (~0.13s) when it is opened.
  # Backgrounded and best-effort: it must never delay or fail the launch.
  #
  # Use the SAME path the WM menu invokes — ${HOME}/.local/bin, the stowed symlink into
  # DotCortex, which is always current.  ${GUEST_HOME}/.local/bin holds PROJECTED COPIES
  # that go stale between launches: pre-warming through those built a menu from an old
  # generator and cached 618 entries when the live one produces 1048.  A cache warmed
  # from the wrong binary is worse than no cache.
  ( sanctuary-exec "${SANCTUARY}" sh -c \
      "${HOME}/.local/bin/ports-menu-gen icewm >/dev/null 2>&1;
       ${HOME}/.local/bin/ports-menu-gen fvwm  >/dev/null 2>&1" \
    >/dev/null 2>&1 & ) || true

  echo "${SANCTUARY}: Xephyr ${DISPLAY_NUM} ready — sourcing Guix profiles and starting IceWM…"
  DISPLAY="${DISPLAY_NUM}" sanctuary-exec "${SANCTUARY}" sh -c "
    REDSTONE_GUEST_BIN=${GUEST_HOME}/.local/bin
    GUIX_PROFILE=${GUIX_PROFILES}/desktop-common/desktop-common
    . \${GUIX_PROFILE}/etc/profile
    GUIX_PROFILE=${GUIX_PROFILES}/room-gaming/room-gaming
    . \${GUIX_PROFILE}/etc/profile
    export GTK_THEME=Windows-95
    # GTK3 overlay (auto-hide fading) scrollbars — disable for classic reserved-gutter
    # scrollbars in pcmanfm. Set before icewm starts so all pcmanfm instances inherit.
    export GTK_OVERLAY_SCROLLING=0
    export GTK_CSD=0
    # Suppress the xdg-desktop-portal storm: GTK3 apps (aisleriot, gnubg, ...)
    # otherwise activate org.freedesktop.portal.Desktop + PermissionStore +
    # Documents on every launch, adding multi-second latency per app. The
    # Redstone sanctuary does not use portal file pickers.
    export GTK_USE_PORTAL=0
    export GIO_USE_PORTAL=0
    # Suppress the at-spi2 accessibility bridge: each GTK app launched inside
    # dbus-run-session otherwise spawns its own at-spi2 bus daemon (1 inotify
    # instance each, never reaped) and saturates max_user_instances=128. The
    # Redstone games/accessories do not need accessibility services.
    export NO_AT_BRIDGE=1
    export XCURSOR_THEME=Chicago95_Cursor_White
    export XCURSOR_SIZE=24
    # Guix profiles set XCURSOR_PATH to their own share/icons, OVERRIDING
    # libXcursor's default ~/.icons search. Prepend guest ~/.icons so the
    # Chicago95 cursor theme installed there is actually found.
    export XCURSOR_PATH=\${HOME}/.icons:/usr/share/icons:\${XCURSOR_PATH}
    export GDK_PIXBUF_MODULE_FILE=\${GUIX_PROFILE}/lib/gdk-pixbuf-2.0/2.10.0/loaders.cache
    GUIX_PROFILE=${GUIX_PROFILES}/room-windows-compat/room-windows-compat
    . \${GUIX_PROFILE}/etc/profile
    export XDG_DATA_DIRS=${GUIX_PROFILES}/room-windows-compat/room-windows-compat/share:${GUIX_PROFILES}/room-gaming/room-gaming/share:${GUIX_PROFILES}/desktop-common/desktop-common/share:/home/metsatron/.local/share/flatpak/exports/share:/usr/local/share:/usr/share
    export XDG_CONFIG_DIRS=${GUIX_PROFILES}/room-windows-compat/room-windows-compat/etc/xdg:${GUIX_PROFILES}/room-gaming/room-gaming/etc/xdg:${GUIX_PROFILES}/desktop-common/desktop-common/etc/xdg:/etc/xdg
    export GSETTINGS_SCHEMA_DIR=${GUIX_PROFILES}/room-gaming/room-gaming/share/glib-2.0/schemas
    export WINEPREFIX=${GUEST_HOME}/.wine-redstone
    export WINEARCH=win64
    export WINEDEBUG=-all
    export DOTCORTEX_DIR=${HOME}/DotCortex
    export PATH=\${REDSTONE_GUEST_BIN}:\${PATH}
    xrdb -merge ${HOME}/DotCortex/linux/.config/redstone-9x/Xresources       2>/dev/null || echo ${SANCTUARY}: warning — Redstone Xresources not loaded
    xrandr --dpi 96 2>/dev/null || true
    bash ${HOME}/DotCortex/linux/.local/bin/sanctuary-redstone-9x-wineprefix-init
    exec dbus-run-session sh -c 'gamemoded -d >/dev/null 2>&1 || true; exec icewm-session'
  "
fi

kill "${XEPHYR_PID}" 2>/dev/null || true
# Sanctuary: sanctuary-redstone-9x — Redstone 9X IceWM:1 ends here
