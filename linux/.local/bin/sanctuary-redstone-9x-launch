#!/usr/bin/env bash
# Sanctuary: sanctuary-redstone-9x — Redstone 9X IceWM

# First gaming-wing sanctuary.  IceWM with the Windows NT theme.
# Launch from the current host desktop. Xephyr display: =:93=.
# Guix profiles: =desktop-common= + =room-gaming= (icewm, pcmanfm, xterm) + =room-windows-compat= (wine64, winetricks, fontconfig, powershell, DOS emulation tooling).

# Current DOS direction (2026-07-07): =DOSEMU2= is the terminal-clean DOS lane.
# =DOSBox-X= remains packaged in =room-windows-compat= as an integrated
# compatibility lane for mouse-heavy DOS software, Windows 3.x, and booted
# Win9x machine profiles. New Redstone DOS work uses the host-visible =.compat/=
# runtime spine and =.dosemu/= bridge declared below.

# The launcher projects =DotCortex/linux/.icewm/= directly into the isolated guest
# home before launching Xephyr — IceWM reads config, theme, and menu from org-managed
# source. =pcmanfm --desktop= (via =~/.icewm/startup=) manages Win95-style desktop
# icons (My Computer, My Documents, Recycle Bin) from =linux/.icewm/desktop/=.
# Recycle Bin opens the real on-disk Trash folder directly (no GVFS =trash://=
# URI — room-gaming deliberately has no =gvfs=; a 2026-07-07 retry leaked the
# HOST's real Trash contents into the sandboxed room via distrobox's /run/host
# bind mount, on top of the earlier libfm crash risk — see
# redstone-9x-state-digest.md) and a small poller (=redstone-9x-recycle-bin-watch=,
# launched from =~/.icewm/startup=) keeps its icon in sync with full/empty state.

# The Redstone create stanza uses Distrobox's existing =--init-hooks= mechanism to create
# =/opt/retropie/supplementary/runcommand/= and symlink =runcommand.sh= to the projected guest-home
# =~/.local/bin/runcommand-shim=. The target is projected by the launcher before either WM starts;
# the hook is scoped to =sanctuary-redstone-9x=, whose IceWM and FVWM95 menus expose the ports lane.


# [[file:../../../sanctuary-redstone-9x.org::*Sanctuary: sanctuary-redstone-9x — Redstone 9X IceWM][Sanctuary: sanctuary-redstone-9x — Redstone 9X IceWM:1]]
# Launch sanctuary-redstone-9x: Xephyr :93 + selected desktop inside the Guix container.
# Launch from the host desktop; no workspace hop is required.
# Desktop is selected via SANCTUARY_DESKTOP env var (set by sanctuary-enter).
# Prerequisites:
#   loom guix:sanctuary-apply   ← builds desktop-common + room-gaming + room-windows-compat
#   distrobox-sanctuaries-create
#   vm-homes-init
#   sanctuary-redstone-9x-fvwm95-build   ← (fvwm95 desktop only)
set -euo pipefail

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  cat <<EOF
sanctuary-redstone-9x-launch - launch sanctuary-redstone-9x (Xephyr :93 + IceWM/FVWM95, Redstone 9X Professional Edition)

Usage: sanctuary-redstone-9x-launch

No positional arguments. Desktop spin is selected via the SANCTUARY_DESKTOP
environment variable (icewm [default] or fvwm95) — set automatically by
sanctuary-enter, or export it yourself before calling this directly.

Prerequisites:
  loom guix:sanctuary-apply   (desktop-common + room-gaming + room-windows-compat)
  distrobox-sanctuaries-create
  vm-homes-init
  sanctuary-redstone-9x-fvwm95-build   (fvwm95 desktop only)

Normally invoked via: sanctuary-enter sanctuary-redstone-9x[:icewm|:fvwm95]
EOF
  exit 0
fi

DESKTOP="${SANCTUARY_DESKTOP:-icewm}"
DISPLAY_NUM=":93"
HOST_DISPLAY="${DISPLAY}"
SANCTUARY="sanctuary-redstone-9x"
GUESTS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/dotcortex/guests"
GUEST_HOME="${GUESTS_DIR}/${SANCTUARY}/home"
GUIX_PROFILES="${HOME}/.guix-extra-profiles"
FONT_STAGE="${GUESTS_DIR}/${SANCTUARY}/fonts"
RETROPIE_HOST_ROOT="${HOME}/RetroPie"
RETROPIE_CONTAINER_ROOT="/run/dotcortex/retropie"
GAMES_CONTAINER_ROOT="/run/dotcortex/games"
REPO_ROOT="${DOTCORTEX_ROOT:-${HOME}/DotCortex}"

# Source the shared Redstone library (primitives, preflight, projection).
. "${REPO_ROOT}/linux/.local/bin/redstone-project-common"

redstone_preflight_guix_profiles
prepare_retropie_tree
redstone_check_desktop_prereqs

redstone_project

# ── Tear down any surviving prior session before launching fresh ──
sanctuary-teardown-stale-session "${SANCTUARY}" "${DISPLAY_NUM}"

# ── Xephyr ──
# -fullscreen alone takes the whole X SCREEN, which on a multi-head desktop is
# the bounding box of every output — the room then spans both monitors (found
# 2026-07-26: a 3000x1920 screen from a 1920x1080 laptop plus a portrait
# 1080x1920 external, so the room straddled both). -output restricts fullscreen
# to one RandR output's geometry, which is what "fullscreen" is meant to mean
# here. Default to the RandR primary, fall back to the first connected output,
# and fall back again to plain -fullscreen on a single-head host or if xrandr
# is unavailable. Override with REDSTONE_XEPHYR_OUTPUT=HDMI-2 to move the room.
xephyr_geometry=(-fullscreen)
if command -v xrandr >/dev/null 2>&1; then
  _xout="${REDSTONE_XEPHYR_OUTPUT:-}"
  if [[ -z "${_xout}" ]]; then
    _xout="$(xrandr --query 2>/dev/null | awk '/ connected primary/{print $1; exit}')"
    [[ -n "${_xout}" ]] || _xout="$(xrandr --query 2>/dev/null | awk '/ connected/{print $1; exit}')"
  fi
  # Only restrict when there is more than one connected output; on a single head
  # -output and -fullscreen are equivalent and -fullscreen is the safer default.
  _xcount="$(xrandr --query 2>/dev/null | grep -c ' connected')"
  if [[ -n "${_xout}" && "${_xcount}" -gt 1 ]]; then
    xephyr_geometry=(-output "${_xout}")
    echo "${SANCTUARY}: restricting Xephyr to output ${_xout} (${_xcount} outputs connected)" >&2
  fi
fi
Xephyr "${DISPLAY_NUM}" "${xephyr_geometry[@]}" -br -ac -dpi 96 -no-host-grab &
XEPHYR_PID=$!
trap "kill ${XEPHYR_PID} 2>/dev/null || true" EXIT

timeout 10 sh -c "until DISPLAY=${DISPLAY_NUM} xdpyinfo >/dev/null 2>&1; do sleep 0.1; done"   || { echo "Xephyr ${DISPLAY_NUM} did not become ready"; kill "${XEPHYR_PID}"; exit 1; }

sanctuary-clip-bridge "${HOST_DISPLAY}" "${DISPLAY_NUM}" &
CLIP_BRIDGE_PID=$!
trap "kill ${XEPHYR_PID} ${CLIP_BRIDGE_PID} 2>/dev/null || true" EXIT

# Load Redstone terminal profiles (URxvt named instances) into the Xephyr display.
DISPLAY="${DISPLAY_NUM}" xrdb -merge "${REPO_ROOT}/linux/.config/redstone-9x/Xresources"   2>/dev/null || echo "${SANCTUARY}: warning — Xresources not found, terminals will use defaults"
DISPLAY="${DISPLAY_NUM}" xrandr --dpi 96 2>/dev/null || true

# Set Win95-style cursor on the Xephyr root window.
# Run on the HOST: install Chicago95 in host ~/.icons (see fvwm95-build script)
# and set XCURSOR_THEME/PATH so xsetroot's XCreateFontCursor is themed via
# libX11's dlopen of libXcursor. Without XCURSOR_PATH including ~/.icons,
# the host libXcursor searches only system dirs and falls back to the bare
# X font cursor (the plain Unix arrow).
DISPLAY="${DISPLAY_NUM}" XCURSOR_THEME="${SCHEME_CURSOR_THEME}" XCURSOR_SIZE="${SCHEME_CURSOR_SIZE}" XCURSOR_PATH="${HOME}/.icons:/usr/share/icons" xsetroot -cursor_name top_left_arrow -solid "#008080" 2>/dev/null || true

# ── Shield trash:/// from host fleet NFS mounts (see sanctuary-trash-shield) ──
sanctuary-trash-shield "${SANCTUARY}" "${HOME}"

# ── Compositor: ARGB blending for CSD apps (Clippy) ──
# Electron CSD windows paint transparent ARGB and render BLACK without a
# compositor — IceWM ships none. Host-side picom on the Xephyr display (the
# guest may not carry picom; the host provably does); xrender backend because
# Xephyr has no GL path; full-screen windows unredirect so games keep the
# direct blit path. Silent skip when picom is absent on the host.
if command -v picom >/dev/null 2>&1; then
  mkdir -p "${HOME}/.cache/redstone-9x"
  DISPLAY="${DISPLAY_NUM}" picom --backend xrender --unredir-if-possible \
    >"${HOME}/.cache/redstone-9x/picom-host.log" 2>&1 &
  COMPOSITOR_PID=$!
  trap "kill ${XEPHYR_PID} ${CLIP_BRIDGE_PID} ${COMPOSITOR_PID} 2>/dev/null || true" EXIT
fi

# ── Launch selected desktop ──
if [[ "${DESKTOP}" == "fvwm95" ]]; then
  echo "${SANCTUARY}: Xephyr ${DISPLAY_NUM} ready — starting FVWM95…"
  DISPLAY="${DISPLAY_NUM}" sanctuary-exec "${SANCTUARY}" sh -c "
    GUIX_PROFILE=${GUIX_PROFILES}/desktop-common/desktop-common
    . \${GUIX_PROFILE}/etc/profile
    GUIX_PROFILE=${GUIX_PROFILES}/room-gaming/room-gaming
    . \${GUIX_PROFILE}/etc/profile
    GUIX_PROFILE=${GUIX_PROFILES}/room-windows-compat/room-windows-compat
    . \${GUIX_PROFILE}/etc/profile
    export WINEPREFIX=${GUEST_HOME}/.wine-redstone
    export WINEARCH=win64
    export WINEDEBUG=-all
    export PATH=${GUEST_HOME}/.local/bin:${GUEST_HOME}/.local/fvwm95/bin:${GUEST_HOME}/.local/xclass/bin:${GUEST_HOME}/.local/ice2k/bin:\${PATH}
    export LIBRARY_PATH=${GUEST_HOME}/.local/xclass/lib:\${LIBRARY_PATH:-}
    export LD_LIBRARY_PATH=${GUEST_HOME}/.local/xclass/lib:${GUIX_PROFILES}/desktop-common/desktop-common/lib:${GUEST_HOME}/.local/ice2k/lib:${GUIX_PROFILES}/room-ice2k/room-ice2k/lib:\${LD_LIBRARY_PATH:-}
    export OX_POOL=${GUEST_HOME}/.local/xclass/share/xclass-icons
    export XDG_DATA_DIRS=${GUIX_PROFILES}/room-windows-compat/room-windows-compat/share:${GUIX_PROFILES}/room-gaming/room-gaming/share:${GUIX_PROFILES}/desktop-common/desktop-common/share:/home/metsatron/.local/share/flatpak/exports/share:/usr/local/share:/usr/share
    bash ${REPO_ROOT}/linux/.local/bin/sanctuary-redstone-9x-wineprefix-init
    # (no GTK_THEME export: it would override settings.ini AND XSETTINGS and
    # freeze the Desktop Scheme at launch value — host-spawn apps get theirs
    # from redstone-9x-host-gtk instead)
    # GTK3 overlay (auto-hide fading) scrollbars — disable for classic reserved-gutter
    # scrollbars in pcmanfm and all GTK3 apps. Set before the WM starts so every
    # pcmanfm instance (desktop daemon + file-manager windows) inherits it.
    export GTK_OVERLAY_SCROLLING=0
    export GTK_CSD=0
    export GTK2_RC_FILES=${GUEST_HOME}/.gtkrc-2.0
    # Suppress the xdg-desktop-portal storm: GTK3 apps (aisleriot, gnubg, ...)
    # otherwise activate org.freedesktop.portal.Desktop + PermissionStore +
    # Documents on every launch, adding multi-second latency per app. The
    # Redstone sanctuary does not use portal file pickers.
    export GTK_USE_PORTAL=0
    export GIO_USE_PORTAL=0
    # Suppress the at-spi2 accessibility bridge: each GTK app launched inside
    # dbus-run-session otherwise spawns its own at-spi2 bus daemon (1 inotify
    # instance each, never reaped) and saturates max_user_instances=128. The
    # Redstone games/accessories do not need accessibility services.
    export NO_AT_BRIDGE=1
    export XCURSOR_THEME=${SCHEME_CURSOR_THEME}
    export XCURSOR_SIZE=${SCHEME_CURSOR_SIZE}
    # Guix profiles set XCURSOR_PATH to their own share/icons, which OVERRIDES
    # libXcursor's default ~/.icons search. Prepend guest ~/.icons + system
    # path so the Chicago95 theme installed there is actually found.
    export XCURSOR_PATH=\${HOME}/.icons:/usr/share/icons:\${XCURSOR_PATH}
    # Symlink icons so fvwm95's compiled-in icon path finds them
    ln -sf ${GUEST_HOME}/.local/fvwm95/lib/X11/icons ${GUEST_HOME}/.local/fvwm95/icons 2>/dev/null || true
    exec dbus-run-session sh -c 'gamemoded -d >/dev/null 2>&1 || true; exec ${GUEST_HOME}/.local/bin/redstone-9x-flatpak-session fvwm95'
  "
else
  # Pre-warm the Ports menu cache BEFORE the WM starts.  The library is >1000 launchers
  # and a cold generation takes ~0.8s — past IceWM's menuprog timeout, so the first open
  # after a reboot would show "Ports menu is refreshing — reopen" instead of the menu.
  # Building it here, while Xephyr is already up and the user has not clicked anything,
  # costs nothing visible and means the menu is always warm (~0.13s) when it is opened.
  # Backgrounded and best-effort: it must never delay or fail the launch.
  #
  # Use the SAME path the WM menu invokes — ${HOME}/.local/bin, the stowed symlink into
  # DotCortex, which is always current.  ${GUEST_HOME}/.local/bin holds PROJECTED COPIES
  # that go stale between launches: pre-warming through those built a menu from an old
  # generator and cached 618 entries when the live one produces 1048.  A cache warmed
  # from the wrong binary is worse than no cache.
  ( sanctuary-exec "${SANCTUARY}" sh -c \
      "${HOME}/.local/bin/ports-menu-gen icewm >/dev/null 2>&1;
       ${HOME}/.local/bin/ports-menu-gen fvwm  >/dev/null 2>&1" \
    >/dev/null 2>&1 & ) || true

  echo "${SANCTUARY}: Xephyr ${DISPLAY_NUM} ready — sourcing Guix profiles and starting IceWM…"
  DISPLAY="${DISPLAY_NUM}" sanctuary-exec "${SANCTUARY}" sh -c "
    REDSTONE_GUEST_BIN=${GUEST_HOME}/.local/bin
    GUIX_PROFILE=${GUIX_PROFILES}/desktop-common/desktop-common
    . \${GUIX_PROFILE}/etc/profile
    GUIX_PROFILE=${GUIX_PROFILES}/room-gaming/room-gaming
    . \${GUIX_PROFILE}/etc/profile
    # (no GTK_THEME export: it would override settings.ini AND XSETTINGS and
    # freeze the Desktop Scheme at launch value — host-spawn apps get theirs
    # from redstone-9x-host-gtk instead)
    # GTK3 overlay (auto-hide fading) scrollbars — disable for classic reserved-gutter
    # scrollbars in pcmanfm. Set before icewm starts so all pcmanfm instances inherit.
    export GTK_OVERLAY_SCROLLING=0
    export GTK_CSD=0
    export GTK2_RC_FILES=${GUEST_HOME}/.gtkrc-2.0
    # Suppress the xdg-desktop-portal storm: GTK3 apps (aisleriot, gnubg, ...)
    # otherwise activate org.freedesktop.portal.Desktop + PermissionStore +
    # Documents on every launch, adding multi-second latency per app. The
    # Redstone sanctuary does not use portal file pickers.
    export GTK_USE_PORTAL=0
    export GIO_USE_PORTAL=0
    # Suppress the at-spi2 accessibility bridge: each GTK app launched inside
    # dbus-run-session otherwise spawns its own at-spi2 bus daemon (1 inotify
    # instance each, never reaped) and saturates max_user_instances=128. The
    # Redstone games/accessories do not need accessibility services.
    export NO_AT_BRIDGE=1
    export XCURSOR_THEME=${SCHEME_CURSOR_THEME}
    export XCURSOR_SIZE=${SCHEME_CURSOR_SIZE}
    # Guix profiles set XCURSOR_PATH to their own share/icons, OVERRIDING
    # libXcursor's default ~/.icons search. Prepend guest ~/.icons so the
    # Chicago95 cursor theme installed there is actually found.
    export XCURSOR_PATH=\${HOME}/.icons:/usr/share/icons:\${XCURSOR_PATH}
    export GDK_PIXBUF_MODULE_FILE=\${GUIX_PROFILE}/lib/gdk-pixbuf-2.0/2.10.0/loaders.cache
    GUIX_PROFILE=${GUIX_PROFILES}/room-windows-compat/room-windows-compat
    . \${GUIX_PROFILE}/etc/profile
    export XDG_DATA_DIRS=${GUIX_PROFILES}/room-windows-compat/room-windows-compat/share:${GUIX_PROFILES}/room-gaming/room-gaming/share:${GUIX_PROFILES}/desktop-common/desktop-common/share:/home/metsatron/.local/share/flatpak/exports/share:/usr/local/share:/usr/share
    export XDG_CONFIG_DIRS=${GUIX_PROFILES}/room-windows-compat/room-windows-compat/etc/xdg:${GUIX_PROFILES}/room-gaming/room-gaming/etc/xdg:${GUIX_PROFILES}/desktop-common/desktop-common/etc/xdg:/etc/xdg
    export GSETTINGS_SCHEMA_DIR=${GUIX_PROFILES}/room-gaming/room-gaming/share/glib-2.0/schemas
    export WINEPREFIX=${GUEST_HOME}/.wine-redstone
    export WINEARCH=win64
    export WINEDEBUG=-all
    export DOTCORTEX_DIR=${REPO_ROOT}
    # SHELL arrives from the host env as a bare name (\"zsh\") through
    # sanctuary-exec's clean_env; VSCodium spawns \$SHELL to resolve the shell
    # environment and a bare name exits 127 in-guest. Pin the absolute guest-
    # valid zsh so every \$SHELL consumer works.
    export SHELL=${GUIX_PROFILES}/core/core/bin/zsh
    export PATH=\${REDSTONE_GUEST_BIN}:${GUEST_HOME}/.local/ice2k/bin:\${PATH}
    # ice2k FOX programs (runbox, devmgmt, shutdlg, control-panel applets, …) link
    # ice2ks own libs + libFOX. RUNPATH is baked at build time, but expose them on
    # LD_LIBRARY_PATH too in case fox-config injected an -rpath that suppressed it.
    export LD_LIBRARY_PATH=${GUEST_HOME}/.local/ice2k/lib:${GUIX_PROFILES}/room-ice2k/room-ice2k/lib:\${LD_LIBRARY_PATH:-}
    xrdb -merge ${REPO_ROOT}/linux/.config/redstone-9x/Xresources       2>/dev/null || echo ${SANCTUARY}: warning — Redstone Xresources not loaded
    xrandr --dpi 96 2>/dev/null || true
    bash ${REPO_ROOT}/linux/.local/bin/sanctuary-redstone-9x-wineprefix-init
    exec dbus-run-session sh -c 'gamemoded -d >/dev/null 2>&1 || true; exec ${GUEST_HOME}/.local/bin/redstone-9x-flatpak-session icewm-session'
  "
fi

# Session over — play the logoff sound host-side (host paplay, same Pulse
# server). Backgrounded subshell: the chime outlives this script; teardown
# must never wait on audio.
( sanctuary-sound logoff "${GUEST_HOME}/.local/share/sounds/sanctuary" >/dev/null 2>&1 & ) || true

kill "${XEPHYR_PID}" 2>/dev/null || true
# Sanctuary: sanctuary-redstone-9x — Redstone 9X IceWM:1 ends here
