#!/bin/bash
# redstone-9x-plus95-import — convert the 16 Plus!95/Kids themes from NEXUS.
set -euo pipefail
SRC="${HOME}/HelmCortex/NEXUS/sanctuaries/sanctuary-redstone-9x/themes/js98/desktop/Themes/Windows Official"
[[ -d "${SRC}" ]] || { echo "ERROR: ${SRC} missing — NEXUS source archive not reachable" >&2; exit 1; }
export FLAT_TITLE=1 REDSTONE_ICON_THEME=Chicago95
run() { echo "== $3"; redstone-9x-theme-convert "${SRC}/$1" "$2" "$3"; }
run "Baseball (256 color).theme"              "Baseball"             plus-baseball
run "Dangerous Creatures (256 color).theme"   "Dangerous Creatures"  plus-dangerous-creatures
run "Inside your Computer (high color).theme" "Inside your Computer" plus-inside-your-computer
run "Jungle (256 color).theme"                "Jungle"               plus-jungle
run "Leonardo da Vinci (256 color).theme"     "Leonardo da Vinci"    plus-leonardo-da-vinci
run "More Windows (high color).theme"         "More Windows"         plus-more-windows
run "Mystery (high color).theme"              "Mystery"              plus-mystery
run "Nature (high color).theme"               "Nature"               plus-nature
run "Science (256 color).theme"               "Science"              plus-science
run "Space (256 color).theme"                 "Space"                plus-space
run "Sports (256 color).theme"                "Sports"               plus-sports
run "The 60's USA (256 color).theme"          "The 60s USA"          plus-60s-usa
run "The Golden Era (high color).theme"       "The Golden Era"       plus-golden-era
run "Travel (high color).theme"               "Travel"               plus-travel
run "Underwater (high color).theme"           "Underwater"           plus-underwater
run "Windows 98 (256 color).theme"            "Windows 98 Plus"      plus-windows-98
echo "plus95 themes imported (flat titles, Chicago95 icons)"
