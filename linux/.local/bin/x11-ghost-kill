#!/usr/bin/env bash
# x11-ghost-kill — find and destroy invisible fullscreen InputOnly windows that
# swallow all desktop input (crashed screenshot region-select, abnormal Xephyr
# exit). Designed to run from SSH or a bare TTY where DISPLAY/XAUTHORITY are
# unset. See x11.org and the sanctuary-gotchas skill.
set -euo pipefail

DRY_RUN=0
case "${1-}" in
  -n|--dry-run) DRY_RUN=1 ;;
  -h|--help)
    cat <<'EOF'
x11-ghost-kill [-n|--dry-run]

Finds invisible fullscreen InputOnly + Override Redirect windows on the local
X display and destroys them, restoring input to the desktop. Safe to run over
SSH or from a TTY. With -n, reports what it would kill without touching
anything.
EOF
    exit 0 ;;
  "") ;;
  *) echo "x11-ghost-kill: unknown option: $1" >&2; exit 2 ;;
esac

for tool in xdpyinfo xwininfo xdotool xsetroot; do
  command -v "$tool" >/dev/null 2>&1 \
    || { echo "x11-ghost-kill: required tool not found: $tool" >&2; exit 1; }
done

export DISPLAY="${DISPLAY:-:0}"

x_ok() { xdpyinfo >/dev/null 2>&1; }

# From SSH/TTY no auth is exported. Try, in order: whatever XAUTHORITY was
# inherited, ~/.Xauthority, then the -auth file the running X server was
# actually started with (display managers often use a private cookie file).
if ! x_ok; then
  export XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}"
  if ! x_ok; then
    server_auth="$(ps -eo args= \
      | awk '$1 ~ /(^|\/)(Xorg|Xlibre|X)$/ { for (i = 2; i < NF; i++) if ($i == "-auth") { print $(i+1); exit } }')"
    if [ -n "$server_auth" ] && [ -r "$server_auth" ]; then
      export XAUTHORITY="$server_auth"
    fi
  fi
fi

if ! x_ok; then
  echo "x11-ghost-kill: cannot reach display $DISPLAY (tried XAUTHORITY=${XAUTHORITY:-unset})" >&2
  exit 1
fi

geo="$(xdpyinfo | awk '/dimensions:/ { print $2; exit }')"
if [ -z "$geo" ]; then
  echo "x11-ghost-kill: could not read screen dimensions from xdpyinfo" >&2
  exit 1
fi

# Candidates: root children at full-screen geometry anchored at +0+0. Geometry
# alone is NOT the verdict — a legitimately fullscreen app matches too — each
# candidate must also prove the ghost signature below before it is touched.
mapfile -t candidates < <(xwininfo -root -children \
  | awk -v g="${geo}+0+0 " 'index($0, " " g) { print $1 }')

ghosts=()
for wid in "${candidates[@]}"; do
  info="$(xwininfo -id "$wid" 2>/dev/null)" || continue
  grep -q 'Class: InputOnly' <<<"$info" || continue
  grep -q 'Override Redirect State: yes' <<<"$info" || continue
  grep -q 'Map State: IsViewable' <<<"$info" || continue
  ghosts+=("$wid")
done

if [ "${#ghosts[@]}" -eq 0 ]; then
  echo "x11-ghost-kill: no ghost windows on $DISPLAY (${geo}) — input layer looks healthy"
  exit 0
fi

for wid in "${ghosts[@]}"; do
  if [ "$DRY_RUN" -eq 1 ]; then
    echo "x11-ghost-kill: would kill $wid (${geo} InputOnly, override-redirect, viewable)"
  else
    xdotool windowkill "$wid"
    echo "x11-ghost-kill: killed $wid (${geo} InputOnly, override-redirect, viewable)"
  fi
done

if [ "$DRY_RUN" -eq 0 ]; then
  xsetroot -cursor_name left_ptr
  echo "x11-ghost-kill: cursor restored — desktop input should be back"
fi
