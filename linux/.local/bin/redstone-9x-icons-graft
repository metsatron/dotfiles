#!/bin/bash
# redstone-9x-icons-graft <icons-root> <dest-dir> <icon-theme>
# Graft the curated Redstone icon set into an IceWM icons dir from the given
# XDG-layout icon theme, following its index.theme Inherits= chain before the
# final Chicago95 safety net. IceWM cannot resolve XDG icon-theme names itself
# — a missing name silently drops the menu button — so this graft is the only
# bridge between icon themes and IceWM-drawn UI.
#
# THE GRAFT ONLY COVERS ICEWM. Desktop icons (pcmanfm ~/Desktop) resolve via
# real GTK icon-theme lookup, which follows the scheme theme's index.theme
# Inherits= chain and never sees this graft or its Chicago95 fallback. Every
# installed guest scheme icon theme (Win98SE, LinXP, SE98 in guest ~/.icons)
# must therefore declare "Inherits=Chicago95,..." or desktop-only names (games,
# briefcase, inbox) silently render blank/modern (sealed 2026-07-19 after the
# 98 desktop shipped with blank game icons twice).
set -uo pipefail

# Roots may be colon-separated: XDG icon dirs AND legacy ~/.icons both count
# (SE98/LinXP live in ~/.icons — found 2026-07-19).
ICONS_ROOT="${1:?icons roots required (colon-separated)}"
DEST="${2:?dest dir required (e.g. \$HOME/.icewm/icons)}"
THEME="${3:-Chicago95}"

NAMES="winamp ultimate-doom quake diablo hellfire theme-hospital duke-nukem-3d
red-alert command-conquer dune-2000 net.openra.OpenRA-d2k half-life blue-shift opposing-force zsnes snes9x
mupen64plus ms-dos-prompt retroarch msn inbox my_briefcase internet-web-browser
help-browser lxfind vlc
seamonkey palemoon redstone-system smplayer redstone-control-panel
system-file-manager emacs obsidian user-home system-run archive-manager
preferences-desktop-theme gnome-applications libreoffice-startcenter gimp
inkscape com.visualstudio.code postscript-viewer audio-card video-display
folder accessories-text-editor notepad accessories-calculator firefox_2 utilities-terminal
control-center2 system-shut-down preferences-system preferences-desktop
system-search edit-paste accessories-character-map applications-system
text-editor reload web-browser user-desktop text-x-generic image-x-generic
audio-x-generic video-x-generic application-pdf package-x-generic unknown
applications-utilities applications-development applications-games
applications-graphics applications-internet applications-multimedia
applications-office wine lutris applications-painting eom corsix-th abiword gnumeric
libreoffice-writer libreoffice-calc libreoffice-impress libreoffice-draw
libreoffice-base libreoffice-math
kmahjongg kshisen kpat kreversi bovo kfourinline ksquares knights kigo
lskat kajongg katomic klines kmines picmi kblocks
kbounce kbreakout "
SIZES="16 22 24 32 48"
CATEGORIES="apps places actions devices mimes mimetypes status categories"

# Per-name theme pins (Mètsàtron's standing picks): VLC always wears his
# BeOS-r5 art — VLC is not Media-Player-Classic-like. quake/zsnes are pinned
# to Chicago95 because Win98SE ships its own art for both names that reads
# worse than the Windows-95 set (confirmed by contact-sheet comparison
# 2026-07-19: Win98SE's quake.png is a flat dark crescent with no logotype,
# Chicago95's is the branded rune-sigil box art; Win98SE's zsnes.png is an
# unbranded grey console silhouette, Chicago95's is the recognizable ZSNES
# multicolor logo) — every other game name in NAMES has no Win98SE art at
# all, so it already falls through to Chicago95 without needing a pin.
override_theme() {
  local active_theme="$1" name="$2"
  if [ "${active_theme}" = "KDE-1-Classic-Silver-MacOS" ]; then
    case "${name}" in
      msn|ms-dos-prompt|my_briefcase)
        echo "Chicago95"; return ;;
    esac
  fi
  case "${name}" in
    vlc) echo "BeOS-r5-Icons" ;;
    quake|zsnes) echo "Chicago95" ;;
    *) echo "" ;;
  esac
}

# Per-theme source-name remap. A handful of Start-menu icon names (Win95-era
# freedesktop names) have no art under that exact name in Irixium, so CDE
# schemes fell back to the Chicago95 Win95 icons. Irixium DOES carry the right
# IRIX-native art under its own names — map the menu names onto it so CDE wears
# real Irixium Start-menu icons. Scoped to Irixium by design: Chicago95 and
# every other theme keep the literal menu name (Windows dynasty is untouched).
resolve_name() {
  if [ "$1" = "KDE-Classic" ]; then
    case "$2" in
      internet-web-browser|web-browser|firefox_2|seamonkey|palemoon)
        echo "netscape"; return ;;
      abiword|libreoffice-writer)
        echo "kword"; return ;;
      accessories-character-map)
        echo "kcharselect"; return ;;
      application-pdf)
        echo "kghostview"; return ;;
      bovo|kfourinline)
        echo "kwin4"; return ;;
      com.visualstudio.code)
        echo "kdevelop"; return ;;
      eom)
        echo "kview"; return ;;
      gnumeric|libreoffice-calc)
        echo "kspread"; return ;;
      inkscape|libreoffice-draw)
        echo "karbon"; return ;;
      kajongg)
        echo "kmahjongg"; return ;;
      kblocks)
        echo "ksirtet"; return ;;
      kbreakout)
        echo "kbounce"; return ;;
      kigo)
        echo "go"; return ;;
      libreoffice-base)
        echo "access"; return ;;
      libreoffice-impress)
        echo "kpresenter"; return ;;
      libreoffice-math)
        echo "kformula"; return ;;
      libreoffice-startcenter)
        echo "kmenu"; return ;;
      package-x-generic)
        echo "kpackage"; return ;;
      smplayer)
        echo "noatun"; return ;;
      utilities-terminal|ms-dos-prompt)
        echo "konsole"; return ;;
      accessories-text-editor|text-editor|notepad)
        echo "kedit"; return ;;
      lxfind|system-search)
        echo "kfind"; return ;;
      preferences-desktop-theme|control-center2|preferences-system|preferences-desktop)
        echo "looknfeel"; return ;;
      gnome-applications|applications-system)
        echo "kmenu"; return ;;
      archive-manager)
        echo "ark"; return ;;
      help-browser)
        echo "help"; return ;;
      system-run)
        echo "exec"; return ;;
      system-shut-down)
        echo "application-exit"; return ;;
    esac
  fi
  if [ "$1" = "Irixium" ]; then
    case "$2" in
      gnome-applications) echo "applications-all"; return ;;   # Programs
      control-center2)    echo "preferences-system"; return ;; # Settings
      lxfind)             echo "folder-saved-search"; return ;;# Find
      system-shut-down)   echo "system-shutdown"; return ;;    # Shut Down
    esac
  fi
  echo "$2"
}

# Reproduce XDG icon-theme inheritance for IceWM's private flat icon dir.
# Depth-first order matters: A -> B,hicolor and B -> Chicago95,hicolor must
# search A, B, Chicago95, hicolor (not A, B, hicolor, Chicago95).
THEME_CHAIN=()
SEEN_THEMES=" "
add_theme_chain() {
  local theme="$1" root index inherits="" parent
  local -a parents
  [ -n "${theme}" ] || return
  case "${SEEN_THEMES}" in
    *" ${theme} "*) return ;;
  esac
  SEEN_THEMES="${SEEN_THEMES}${theme} "
  THEME_CHAIN+=("${theme}")
  for root in ${ICONS_ROOT//:/ }; do
    index="${root}/${theme}/index.theme"
    if [ -f "${index}" ]; then
      inherits="$(sed -n 's/^[[:space:]]*Inherits[[:space:]]*=[[:space:]]*//p' "${index}" | head -1)"
      break
    fi
  done
  IFS=',' read -ra parents <<< "${inherits}"
  for parent in "${parents[@]}"; do
    parent="${parent//[[:space:]]/}"
    [ -n "${parent}" ] && add_theme_chain "${parent}"
  done
}
add_theme_chain "${THEME}"
add_theme_chain "Chicago95"

mkdir -p "${DEST}"
for name in ${NAMES}; do
  for size in ${SIZES}; do
    src=""
    _source_size="${size}"
    _pin="$(override_theme "${THEME}" "${name}")"
    for theme in ${_pin} "${THEME_CHAIN[@]}"; do
      _resolved="$(resolve_name "${theme}" "${name}")"
      for sname in "${name}" "${_resolved}"; do
        for root in ${ICONS_ROOT//:/ }; do
          for cat in ${CATEGORIES}; do
            cand="${root}/${theme}/${cat}/${size}/${sname}.png"
            [ -f "${cand}" ] && { src="${cand}"; break 4; }
            # Sized-dir grammar (e.g. Irixium:
            # <theme>/<S>x<S>/<cat>/<name>.png).
            cand="${root}/${theme}/${size}x${size}/${cat}/${sname}.png"
            [ -f "${cand}" ] && { src="${cand}"; break 4; }
          done
        done
      done
    done
    # OpenRA's Flatpak exports a distinct Dune 2000 icon, but it is outside
    # the sanctuary's projected XDG theme roots.  Graft it from the active
    # host deployment so the IceWM menu and toolbar use the same art as the
    # desktop .desktop entry.  The file is optional: a missing/removed
    # Flatpak simply leaves the normal theme fallback in place.
    if [ -z "${src}" ] && {
      [ "${name}" = "dune-2000" ] || [ "${name}" = "net.openra.OpenRA-d2k" ];
    }; then
      for flatpak_root in \
        "${HOME}/.local/share/flatpak/app/net.openra.OpenRA/x86_64/stable/active/export/share/icons/hicolor" \
        "/home/metsatron/.local/share/flatpak/app/net.openra.OpenRA/x86_64/stable/active/export/share/icons/hicolor"; do
        # The Flatpak ships 16/32/48px art.  Use the crisp 32px source for
        # IceWM's 22/24px slots and reduce it with nearest-neighbour when the
        # host has ImageMagick available.
        case "${size}" in
          22|24) _source_size=32 ;;
        esac
        cand="${flatpak_root}/${_source_size}x${_source_size}/apps/net.openra.OpenRA-d2k.png"
        if [ -f "${cand}" ]; then
          src="${cand}"
          break
        fi
      done
    fi
    if [ -n "${src}" ]; then
      target="${DEST}/${name}_${size}x${size}.png"
      if [ "${_source_size}" != "${size}" ] && command -v convert >/dev/null 2>&1; then
        convert "${src}" -filter point -resize "${size}x${size}" "${target}" 2>/dev/null || cp -f "${src}" "${target}"
      else
        cp -f "${src}" "${target}"
      fi
    fi
  done
done
exit 0
