#!/usr/bin/env python3
"""Generate QTStep-DarkAdobe Kvantum theme from QTStep.source.

Palette: OneStepBack Adobe Highlights (adobe-cc-dark, style.org).
Locates DotCortex root via .git ancestor search; safe to run from any path.
"""
import pathlib
import sys


def find_dotcortex():
    here = pathlib.Path(__file__).resolve().parent
    for p in [here, *here.parents]:
        if (p / ".git").exists():
            return p
    sys.exit("qtstepadobe-gen: cannot find DotCortex root (no .git ancestor found)")


ROOT = find_dotcortex()
SRC_DIR = ROOT / "linux/.config/Kvantum/QTStep.source/kvantum/QTStep.source"
OUT_DIR = ROOT / "linux/.config/Kvantum/QTStep-DarkAdobe"

if not (SRC_DIR / "QTStep.source.kvconfig").exists():
    sys.exit(f"qtstepadobe-gen: submodule not initialised: {SRC_DIR}")

OUT_DIR.mkdir(exist_ok=True)

colors_base = {}
for line in (SRC_DIR / "colors").read_text().splitlines():
    parts = line.split()
    if len(parts) == 2:
        colors_base[parts[0]] = parts[1]

# Target palette — shadesimple-derived from base inputs listed in the org header.
# k factors: border=0.333, highlight=1.333, innerdark=0.833, hover=1.042
# pressed=0.833, gradients=[1.242, 1.022, 1.022, 1.014, 0.962, 0.982, 0.962, 1.242]
colors_target = {
    "active":                        "#454545",
    "active-border":                 "#000000",
    "active-highlight":              "#9a9a9a",
    "active-innerdark":              "#1a1a1a",
    "active-highlight-innerdark":    "#5a5a5a",
    "active-hover":                  "#505050",
    "active-pressed":                "#1a1a1a",
    "active-gradient-1":             "#838383",
    "active-gradient-2":             "#4a4a4a",
    "active-gradient-3":             "#4a4a4a",
    "active-gradient-4":             "#494949",
    "active-gradient-5":             "#3b3b3b",
    "active-gradient-6":             "#404040",
    "active-gradient-7":             "#3b3b3b",
    "active-gradient-8":             "#838383",
    "active-gradient-1-highlight":   "#d8d8d8",
    "active-gradient-2-highlight":   "#9f9f9f",
    "active-gradient-3-highlight":   "#9f9f9f",
    "active-gradient-4-highlight":   "#9e9e9e",
    "active-gradient-5-highlight":   "#909090",
    "active-gradient-6-highlight":   "#959595",
    "active-gradient-7-highlight":   "#909090",
    "active-gradient-8-highlight":   "#d8d8d8",
    "active-gradient-1-innerdark":   "#585858",
    "active-gradient-2-innerdark":   "#1f1f1f",
    "active-gradient-3-innerdark":   "#1f1f1f",
    "active-gradient-4-innerdark":   "#1e1e1e",
    "active-gradient-5-innerdark":   "#101010",
    "active-gradient-6-innerdark":   "#151515",
    "active-gradient-7-innerdark":   "#101010",
    "active-gradient-8-innerdark":   "#585858",
    "inactive":                      "#303030",
    "inactive-border":               "#000000",
    "inactive-highlight":            "#858585",
    "inactive-innerdark":            "#000000",
    "inactive-highlight-innerdark":  "#434343",
    "inactive-hover":                "#3b3b3b",
    "inactive-pressed":              "#050505",
    "selection":                     "#4b6983",
    "selection-border":              "#000000",
    "selection-highlight":           "#a0bed8",
    "selection-innerdark":           "#203e58",
    "selection-hover":               "#56748e",
    "selection-pressed":             "#203e58",
    "bg":                            "#454545",
    "bg-border":                     "#000000",
    "bg-highlight":                  "#9a9a9a",
    "bg-innerdark":                  "#000000",
    "bg-hover":                      "#505050",
    "bg-pressed":                    "#1a1a1a",
    "button":                        "#414141",
    "button-border":                 "#000000",
    "button-highlight":              "#969696",
    "button-innerdark":              "#000000",
    "button-hover":                  "#4c4c4c",
    "button-pressed":                "#161616",
    "view":                          "#1f1f1f",
    "view-hover":                    "#2a2a2a",
    "text-active":                   "#d2d4d4",
    "text-inactive":                 "#d2d4d4",
    "text-selection":                "#ffffff",
    "text-bg":                       "#d2d4d4",
    "text-button":                   "#d2d4d4",
    "text-button-semi":              "#8a8b8b",
    "text-view":                     "#d2d4d4",
}

import re as _re

def _patch_scrollbar_fills(svg, fill_map):
    # Walk every scrollbarslider-* group and replace fill colors in visible
    # (opacity:1) rects inside it, using fill_map (old → new).
    # The slider body tile uses button (#414141), the highlight tiles use
    # button-highlight (#969696), hover/pressed tiles use their own values;
    # all must be remapped to give a visually blue slider.
    group_pat = _re.compile(r'<g\b[^>]*id="scrollbarslider[^"]*"[^>]*>', _re.DOTALL)

    def _patch_rect(m):
        rect = m.group(0)
        if "opacity:1" in rect:
            for old_fill, new_fill in fill_map.items():
                if f"fill:{old_fill}" in rect:
                    rect = rect.replace(f"fill:{old_fill}", f"fill:{new_fill}")
        return rect

    result = []
    cursor = 0
    for gm in group_pat.finditer(svg):
        if gm.start() < cursor:
            continue  # already consumed by an enclosing group
        result.append(svg[cursor:gm.start()])
        # find matching </g> by tracking <g> depth
        pos = gm.end()
        depth = 1
        while depth > 0 and pos < len(svg):
            o = svg.find("<g", pos)
            c = svg.find("</g>", pos)
            if c == -1:
                break
            if o != -1 and o < c:
                depth += 1
                pos = o + 2
            else:
                depth -= 1
                pos = c + 4
        group_text = _re.sub(r"<rect\b[^>]*/?>", _patch_rect, svg[gm.start():pos], flags=_re.DOTALL)
        result.append(group_text)
        cursor = pos
    result.append(svg[cursor:])
    return "".join(result)

for tpl in ("QTStep.source.kvconfig", "QTStep.source.svg"):
    content = (SRC_DIR / tpl).read_text()
    # Two-pass: replace base hex with unique placeholders, then place target hex.
    # Prevents a target colour from being re-substituted by a later iteration.
    for key, base_hex in colors_base.items():
        content = content.replace(base_hex, f"PLACEHOLDER-{key}-PLACEHOLDER")
    for key, base_hex in colors_base.items():
        tgt = colors_target.get(key, base_hex)
        content = content.replace(f"PLACEHOLDER-{key}-PLACEHOLDER", tgt)
    if tpl.endswith(".svg"):
        # Remap the full button palette → selection palette inside scrollbarslider
        # groups.  The dominant BODY tile uses button (#414141), not button-highlight
        # (#969696); patching only button-highlight leaves the slider visually grey.
        scrollbar_fill_map = {
            colors_target.get("button",           "#414141"): colors_target.get("selection",           "#4b6983"),
            colors_target.get("button-highlight",  "#969696"): colors_target.get("selection-highlight",  "#a0bed8"),
            colors_target.get("button-hover",      "#4c4c4c"): colors_target.get("selection-hover",      "#56748e"),
            colors_target.get("button-pressed",    "#161616"): colors_target.get("selection-pressed",    "#203e58"),
        }
        content = _patch_scrollbar_fills(content, scrollbar_fill_map)
    out_name = tpl.replace("QTStep.source", "QTStep-DarkAdobe")
    (OUT_DIR / out_name).write_text(content)
    print(f"  {(OUT_DIR / out_name).relative_to(ROOT)}")

print("QTStep-DarkAdobe generated.")
