#!/bin/bash
# redstone-9x-theme-convert <file.theme> <ThemeName> <scheme-id>
# Windows .theme -> IceWM theme + matching GTK theme + Desktop Scheme file.
set -euo pipefail
SRC="${1:?path to .theme file}"; TNAME="${2:?theme display name}"; SID="${3:?scheme id (e.g. plus-baseball)}"
OUT="${HOME}/DotCortex/linux/.icewm/themes/${TNAME// /-}"
SCHEME="${HOME}/DotCortex/linux/.config/redstone-9x/schemes/${SID}.scheme"

eval "$(python3 - "$SRC" "$SID" <<'PYPARSE'
import sys, re
text = open(sys.argv[1], encoding='latin-1').read()
def hx(c): return '#%02X%02X%02X' % c
def lum(c): return 0.299*c[0] + 0.587*c[1] + 0.114*c[2]
def blend_white(c, f=0.5): return tuple(round(x + (255 - x) * f) for x in c)

m = re.search(r'\[Control Panel\\Colors\](.*?)(?:\n\[|\Z)', text, re.S)
if m:
    # --- Windows .theme: decimal "R G B", gradients synthesized when absent ---
    colors = {}
    for line in m.group(1).splitlines():
        if '=' in line:
            k, v = line.split('=', 1)
            p = v.split()
            if len(p) == 3 and all(x.isdigit() for x in p):
                colors[k.strip()] = tuple(int(x) for x in p)
    need = ['ActiveTitle', 'InactiveTitle', 'ButtonFace', 'Background', 'Hilight', 'HilightText']
    missing = [k for k in need if k not in colors]
    if missing:
        print(f'echo "MISSING KEYS: {missing}"; exit 1'); sys.exit()
    at, it = colors['ActiveTitle'], colors['InactiveTitle']
    ag = colors.get('GradientActiveTitle') or blend_white(at)
    ig = colors.get('GradientInactiveTitle') or blend_white(it)
    bg = colors['Background']
    if lum(bg) < 25:
        # Plus! themes carried their look in a wallpaper we don't ship, leaving
        # Background near-black. Decree 2026-07-19: desktop becomes the titlebar's
        # dark accent, slightly muted (30% toward grey). Black titles mute the
        # LIGHT endpoint instead so the desktop never collapses to black.
        base = at if lum(at) >= 25 else ag
        bg = tuple(round(c + (128 - c) * 0.30) for c in base)
    face, hil, hit = colors['ButtonFace'], colors['Hilight'], colors['HilightText']
    ttl_a = colors.get('TitleText', (255,255,255))
    ttl_i = colors.get('InactiveTitleText') or blend_white(it, 0.6)
    fg = colors.get('ButtonText', (0,0,0))
    basec, basetxt = colors.get('Window', (255,255,255)), colors.get('WindowText', (0,0,0))
    icon, snd = 'Win98SE', ''
    regmap = dict(colors)
    regmap.setdefault('GradientActiveTitle', ag)
    regmap.setdefault('GradientInactiveTitle', ig)
else:
    # --- SerenityOS theme .ini: [Colors] with explicit two-stop gradients,
    # values are hex or the names white/black. No synthesis needed — Serenity
    # declares both endpoints of both states. ---
    m = re.search(r'\[Colors\](.*?)(?:\n\[|\Z)', text, re.S)
    NAMES = {'white': (255,255,255), 'black': (0,0,0)}
    colors = {}
    for line in m.group(1).splitlines():
        if '=' in line:
            k, v = line.split('=', 1)
            v = v.strip()
            if v.lower() in NAMES:
                colors[k.strip()] = NAMES[v.lower()]
            elif re.fullmatch(r'#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?', v):
                # newer Serenity themes write #RRGGBBAA — alpha dropped
                colors[k.strip()] = tuple(int(v[i:i+2], 16) for i in (1, 3, 5))
    need = ['ActiveWindowBorder1', 'ActiveWindowBorder2', 'InactiveWindowBorder1',
            'InactiveWindowBorder2', 'Button', 'DesktopBackground', 'Selection', 'SelectionText']
    missing = [k for k in need if k not in colors]
    if missing:
        print(f'echo "MISSING KEYS: {missing}"; exit 1'); sys.exit()
    at, ag = colors['ActiveWindowBorder1'], colors['ActiveWindowBorder2']
    it, ig = colors['InactiveWindowBorder1'], colors['InactiveWindowBorder2']
    face, bg = colors['Button'], colors['DesktopBackground']
    hil, hit = colors['Selection'], colors['SelectionText']
    ttl_a = colors.get('ActiveWindowTitle', (255,255,255))
    ttl_i = colors.get('InactiveWindowTitle') or blend_white(it, 0.6)
    fg = colors.get('ButtonText', (0,0,0))
    basec, basetxt = colors.get('Base', (255,255,255)), colors.get('BaseText', (0,0,0))
    icon, snd = 'Serenity95', 'serenity'
    def dk(c, f): return tuple(round(x * (1 - f)) for x in c)
    regmap = {
        'ActiveTitle': at, 'GradientActiveTitle': ag, 'TitleText': ttl_a,
        'InactiveTitle': it, 'GradientInactiveTitle': ig, 'InactiveTitleText': ttl_i,
        'ButtonFace': face, 'ButtonText': fg,
        'ButtonHilight': blend_white(face, 0.6), 'ButtonShadow': dk(face, 0.4),
        'ButtonDkShadow': (0,0,0), 'ButtonLight': face,
        'Window': basec, 'WindowText': basetxt,
        'Menu': colors.get('MenuBase', face), 'MenuText': colors.get('MenuBaseText', fg),
        'Hilight': hil, 'HilightText': hit,
        'Background': bg, 'AppWorkspace': (128,128,128),
        'ActiveBorder': face, 'InactiveBorder': face,
        'Scrollbar': blend_white(face, 0.3), 'GrayText': (128,128,128),
        'InfoWindow': (255,255,225), 'InfoText': (0,0,0),
        'WindowFrame': (0,0,0),
    }
# Wine classic colors: the same [Control Panel\Colors] namespace Windows
# .theme files use IS the Wine registry key — emit a ready .reg per scheme.
import os
sid = sys.argv[2]
regdir = os.path.expanduser('~/DotCortex/linux/.config/redstone-9x/wine')
os.makedirs(regdir, exist_ok=True)
with open(os.path.join(regdir, sid + '.reg'), 'w', newline='\r\n') as f:
    f.write('REGEDIT4\n\n[HKEY_CURRENT_USER\\Control Panel\\Colors]\n')
    for k in sorted(regmap):
        r, g, b = regmap[k]
        f.write(f'"{k}"="{r} {g} {b}"\n')
# Dark faces need light caption glyphs (the X / _ / [] strokes are pure-black
# pixmap art) — GLYPH is consumed by title-gradient as the stroke colour.
glyph = hx(fg) if lum(face) < 96 else ''
print(f"AD={hx(at)} AL={hx(ag)} ID2={hx(it)} IL={hx(ig)} "
      f"FACE={hx(face)} HILITE={hx(hil)} "
      f"BG={hx(bg)} HITEXT={hx(hit)} ICON={icon} SND={snd} "
      f"TITLEA={hx(ttl_a)} TITLEI={hx(ttl_i)} FG={hx(fg)} "
      f"BASEC={hx(basec)} BASETXT={hx(basetxt)} GLYPH={glyph}")
PYPARSE
)"
export GLYPH_FG="${GLYPH:-}"
echo "parsed: title ${AD}->${AL} inactive ${ID2}->${IL} face ${FACE} sel ${HILITE} desktop ${BG} fg ${FG}"
GTKFG="${FG}" redstone-9x-classic-build "${OUT}" "${TNAME}" "${AD}" "${AL}" "${ID2}" "${IL}" "${FACE}" "${HILITE}"
# Title text from the theme file itself (dark themes need light text and
# vice versa — the file always knows; base default.theme values are wrong
# the moment the palette diverges from the 95 base). Menu hover accent was
# the 95 base's hardcoded navy until 2026-07-19 — now the theme's Hilight.
# Tahoma8pt is an ice2k bitmap-font name; sans-serif resolves everywhere.
sed -i -e "s|^ColorActiveTitleBarText=.*|ColorActiveTitleBarText=\"${TITLEA}\"|" \
       -e "s|^ColorNormalTitleBarText=.*|ColorNormalTitleBarText=\"${TITLEI}\"|" \
       -e "s|^ColorActiveMenuItem=.*|ColorActiveMenuItem=\"${HILITE}\"|" \
       -e "s|^ColorActiveMenuItemText=.*|ColorActiveMenuItemText=\"${HITEXT}\"|" \
       -e "s|^ColorNormalMenuItemText=.*|ColorNormalMenuItemText=\"${FG}\"|" \
       -e "s|^ColorNormalTaskBarAppText=.*|ColorNormalTaskBarAppText=\"${FG}\"|" \
       -e "s|^ColorNormalButtonText=.*|ColorNormalButtonText=\"${FG}\"|" \
       -e "s|^ColorActiveButtonText=.*|ColorActiveButtonText=\"${FG}\"|" \
       -e "s|^ColorNormalLabelText=.*|ColorNormalLabelText=\"${FG}\"|" \
       -e "s|^ColorToolButtonText=.*|ColorToolButtonText=\"${FG}\"|" \
       -e "s|Tahoma8pt|sans-serif|g" "${OUT}/default.theme"

# --- Matching qt6ct palette (Zeal and every Qt app follow the scheme) ---
QTDIR="${HOME}/DotCortex/linux/.config/redstone-9x/qt6ct/colors"
mkdir -p "${QTDIR}"
python3 - "${QTDIR}/${SID}.conf" "${FACE}" "${HILITE}" "${HITEXT}" "${FG}" "${BASEC}" "${BASETXT}" <<'PYQT'
import sys
out, face, hilite, hitext, fg, basec, basetxt = sys.argv[1:8]
F = tuple(int(face.lstrip('#')[i:i+2],16) for i in (0,2,4))
def hx(c): return '#ff%02x%02x%02x' % c
def mix(c, t, f): return tuple(round(a + (b - a) * f) for a, b in zip(c, t))
def a8(h): return '#ff' + h.lstrip('#').lower()
W, K = (255,255,255), (0,0,0)
FACEX = hx(F)
LIGHT = hx(W)
MIDL  = hx(mix(F, W, 0.50))
MID   = hx(mix(F, K, 0.22))
DARK  = hx(mix(F, K, 0.40))
ALT   = hx(mix(F, W, 0.65))
HI, HT = a8(hilite), a8(hitext)
FG2, BASE, BASET = a8(fg), a8(basec), a8(basetxt)
BLACK, WHITE = '#ff000000', '#ffffffff'
# Role order mirrors the hand-made win95.conf (Qt palette serialization):
# WindowText Button Light Midlight Dark Mid Text BrightText ButtonText Base
# Window Shadow Highlight HighlightedText Link LinkVisited AlternateBase
# NoRole ToolTipBase ToolTipText PlaceholderText Accent
active = [FG2, FACEX, LIGHT, MIDL, DARK, MID, BASET, WHITE, FG2, BASE,
          FACEX, BLACK, HI, HT, '#ff0000ff', '#ff800080', ALT, BLACK,
          '#ffffffe1', BLACK, DARK, HI]
disabled = list(active)
disabled[0] = disabled[6] = disabled[8] = DARK
disabled[9] = FACEX
disabled[12] = DARK
disabled[13] = WHITE
disabled[21] = DARK
with open(out, 'w') as f:
    f.write('[ColorScheme]\n')
    f.write('active_colors='   + ', '.join(active)   + '\n')
    f.write('disabled_colors=' + ', '.join(disabled) + '\n')
    f.write('inactive_colors=' + ', '.join(active)   + '\n')
print(f"qt6ct palette: {out}")
PYQT

cat > "${SCHEME}" <<EOFS
# Redstone 9X Desktop Scheme — ${TNAME} (converted from official .theme by
# redstone-9x-theme-convert; colours are the file's own, gradient endpoints
# synthesized 50%-to-white when the file predates gradient keys).
SCHEME_TITLE="${TNAME}"
ICEWM_THEME="${TNAME// /-}"
GTK_THEME="${TNAME// /-}"
ICON_THEME="${ICON}"
CURSOR_THEME="Chicago95_Cursor_White"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="${BG}"
SEL_BG="${HILITE}"
SEL_FG="${HITEXT}"
QT6CT_COLORS="${SID}.conf"
SOUND_SCHEME="${SND:-${SID}}"
WINE_COLORS="${SID}.reg"
FOX_BASE="${FACE}"
FOX_FG="${FG}"
FOX_BG="${BASEC}"
FOX_SEL_BG="${HILITE}"
FOX_SEL_FG="${HITEXT}"
FOX_MENU_BG="${HILITE}"
FOX_MENU_FG="${HITEXT}"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
EOFS
echo "scheme written: ${SCHEME}"
