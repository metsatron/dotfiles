#!/bin/bash
# redstone-9x-theme-convert <file.theme> <ThemeName> <scheme-id>
# Windows .theme -> IceWM theme + matching GTK theme + Desktop Scheme file.
set -euo pipefail
SRC="${1:?path to .theme file}"; TNAME="${2:?theme display name}"; SID="${3:?scheme id (e.g. plus-baseball)}"
OUT="${HOME}/DotCortex/linux/.icewm/themes/${TNAME// /-}"
SCHEME="${HOME}/DotCortex/linux/.config/redstone-9x/schemes/${SID}.scheme"

eval "$(python3 - "$SRC" "$SID" <<'PYPARSE'
import sys, re, os
text = open(sys.argv[1], encoding='latin-1').read()
def hx(c): return '#%02X%02X%02X' % c
def lum(c): return 0.299*c[0] + 0.587*c[1] + 0.114*c[2]
def blend_white(c, f=0.5): return tuple(round(x + (255 - x) * f) for x in c)
def dk(c, f): return tuple(round(x * (1 - f)) for x in c)
def contrast_guard(txt, c1, c2):
    # Valve declares InactiveWindowTitle=black on a flat olive bar — Serenity
    # renders title shadows, IceWM doesn't, so low-contrast text goes
    # unreadable here. Within 50 luminance of the bar midpoint: flip.
    barl = (lum(c1) + lum(c2)) / 2
    if abs(lum(txt) - barl) < 90:
        return (0, 0, 0) if barl >= 128 else (255, 255, 255)
    return txt

m = re.search(r'\[Control Panel\\Colors\](.*?)(?:\n\[|\Z)', text, re.S)
if m:
    # --- Windows .theme: decimal "R G B", gradients synthesized when absent ---
    colors = {}
    for line in m.group(1).splitlines():
        if '=' in line:
            k, v = line.split('=', 1)
            p = v.split()
            if len(p) == 3 and all(x.isdigit() for x in p):
                colors[k.strip()] = tuple(int(x) for x in p)
    need = ['ActiveTitle', 'InactiveTitle', 'ButtonFace', 'Background', 'Hilight', 'HilightText']
    missing = [k for k in need if k not in colors]
    if missing:
        print(f'echo "MISSING KEYS: {missing}"; exit 1'); sys.exit()
    at, it = colors['ActiveTitle'], colors['InactiveTitle']
    _flat = os.environ.get('FLAT_TITLE', '') == '1'
    ag = colors.get('GradientActiveTitle') or (at if _flat else blend_white(at))
    ig = colors.get('GradientInactiveTitle') or (it if _flat else blend_white(it))
    bg = colors['Background']
    if lum(bg) < 25:
        # Plus! themes carried their look in a wallpaper we don't ship, leaving
        # Background near-black. Decree 2026-07-19: desktop becomes the titlebar's
        # dark accent, slightly muted (30% toward grey). Black titles mute the
        # LIGHT endpoint instead so the desktop never collapses to black.
        base = at if lum(at) >= 25 else ag
        bg = tuple(round(c + (128 - c) * 0.30) for c in base)
    face, hil, hit = colors['ButtonFace'], colors['Hilight'], colors['HilightText']
    ttl_a = contrast_guard(colors.get('TitleText', (255,255,255)), at, ag)
    ttl_i = contrast_guard(colors.get('InactiveTitleText') or blend_white(it, 0.6), it, ig)
    fg = colors.get('ButtonText', (0,0,0))
    basec, basetxt = colors.get('Window', (255,255,255)), colors.get('WindowText', (0,0,0))
    # REDSTONE_ICON_THEME overrides the default per family: the Plus!95/Kids
    # packs are Win95-era and take Chicago95 (matching the windows-95 scheme);
    # unset keeps the 98-era default.
    icon, snd = os.environ.get('REDSTONE_ICON_THEME', 'Win98SE'), ''
    regmap = dict(colors)
    regmap.setdefault('GradientActiveTitle', ag)
    regmap.setdefault('GradientInactiveTitle', ig)
    _face_dark = 0.2126*face[0] + 0.7152*face[1] + 0.0722*face[2] < 140
    regmap.setdefault('ButtonHilight', blend_white(face, 0.25 if _face_dark else 0.6))
    regmap.setdefault('ButtonShadow', dk(face, 0.5 if _face_dark else 0.4))
    regmap.setdefault('ButtonDkShadow', (0,0,0))
    regmap.setdefault('ButtonLight', face)
else:
    # --- SerenityOS theme .ini: [Colors] with explicit two-stop gradients,
    # values are hex or the names white/black. No synthesis needed — Serenity
    # declares both endpoints of both states. ---
    m = re.search(r'\[Colors\](.*?)(?:\n\[|\Z)', text, re.S)
    # CSS named colours — Hotdog Stand ships 'yellow'/'red' (found 2026-07-19)
    NAMES = {'white': (255,255,255), 'black': (0,0,0), 'red': (255,0,0),
             'yellow': (255,255,0), 'green': (0,128,0), 'lime': (0,255,0),
             'blue': (0,0,255), 'cyan': (0,255,255), 'magenta': (255,0,255),
             'gray': (128,128,128), 'grey': (128,128,128),
             'silver': (192,192,192), 'maroon': (128,0,0), 'navy': (0,0,128),
             'teal': (0,128,128), 'olive': (128,128,0), 'purple': (128,0,128)}
    colors = {}
    for line in m.group(1).splitlines():
        if '=' in line:
            k, v = line.split('=', 1)
            v = v.strip()
            if v.lower() in NAMES:
                colors[k.strip()] = NAMES[v.lower()]
            elif re.fullmatch(r'#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?', v):
                # newer Serenity themes write #RRGGBBAA — alpha dropped
                colors[k.strip()] = tuple(int(v[i:i+2], 16) for i in (1, 3, 5))
    need = ['ActiveWindowBorder1', 'ActiveWindowBorder2', 'InactiveWindowBorder1',
            'InactiveWindowBorder2', 'Button', 'DesktopBackground', 'Selection', 'SelectionText']
    missing = [k for k in need if k not in colors]
    if missing:
        print(f'echo "MISSING KEYS: {missing}"; exit 1'); sys.exit()
    at, ag = colors['ActiveWindowBorder1'], colors['ActiveWindowBorder2']
    it, ig = colors['InactiveWindowBorder1'], colors['InactiveWindowBorder2']
    face, bg = colors['Button'], colors['DesktopBackground']
    hil, hit = colors['Selection'], colors['SelectionText']
    ttl_a = contrast_guard(colors.get('ActiveWindowTitle', (255,255,255)), at, ag)
    ttl_i = contrast_guard(colors.get('InactiveWindowTitle') or blend_white(it, 0.6), it, ig)
    fg = colors.get('ButtonText', (0,0,0))
    basec, basetxt = colors.get('Base', (255,255,255)), colors.get('BaseText', (0,0,0))
    icon, snd = 'Serenity95', 'serenity'
    # Dark bevel law (2026-07-30): subtle highlight + deep shadow on dark faces
    _face_dark = 0.2126*face[0] + 0.7152*face[1] + 0.0722*face[2] < 140
    regmap = {
        'ActiveTitle': at, 'GradientActiveTitle': ag, 'TitleText': ttl_a,
        'InactiveTitle': it, 'GradientInactiveTitle': ig, 'InactiveTitleText': ttl_i,
        'ButtonFace': face, 'ButtonText': fg,
        'ButtonHilight': blend_white(face, 0.25 if _face_dark else 0.6),
        'ButtonShadow': dk(face, 0.5 if _face_dark else 0.4),
        'ButtonDkShadow': (0,0,0), 'ButtonLight': face,
        'Window': basec, 'WindowText': basetxt,
        'Menu': colors.get('MenuBase', face), 'MenuText': colors.get('MenuBaseText', fg),
        'Hilight': hil, 'HilightText': hit,
        'Background': bg, 'AppWorkspace': (128,128,128),
        'ActiveBorder': face, 'InactiveBorder': face,
        'Scrollbar': blend_white(face, 0.3), 'GrayText': (128,128,128),
        'InfoWindow': (255,255,225), 'InfoText': (0,0,0),
        'WindowFrame': (0,0,0),
    }
# Wine classic colors: the same [Control Panel\Colors] namespace Windows
# .theme files use IS the Wine registry key — emit a ready .reg per scheme.
import os
sid = sys.argv[2]
regdir = os.path.expanduser('~/DotCortex/linux/.config/redstone-9x/wine')
os.makedirs(regdir, exist_ok=True)
with open(os.path.join(regdir, sid + '.reg'), 'w', newline='\r\n') as f:
    f.write('REGEDIT4\n\n[HKEY_CURRENT_USER\\Control Panel\\Colors]\n')
    for k in sorted(regmap):
        r, g, b = regmap[k]
        f.write(f'"{k}"="{r} {g} {b}"\n')
# Dark faces need light caption glyphs (the X / _ / [] strokes are pure-black
# pixmap art) — GLYPH is consumed by title-gradient as the stroke colour.
glyph = hx(fg) if lum(face) < 96 else ''
bhi = regmap.get('ButtonHilight', (255,255,255))
bsh = regmap.get('ButtonShadow', (128,128,128))
bdk = regmap.get('ButtonDkShadow', (0,0,0))
print(f"AD={hx(at)} AL={hx(ag)} ID2={hx(it)} IL={hx(ig)} "
      f"FACE={hx(face)} HILITE={hx(hil)} "
      f"BG={hx(bg)} HITEXT={hx(hit)} ICON={icon} SND={snd} "
      f"TITLEA={hx(ttl_a)} TITLEI={hx(ttl_i)} FG={hx(fg)} "
      f"BASEC={hx(basec)} BASETXT={hx(basetxt)} GLYPH={glyph} "
      f"BEVEL_HI={hx(bhi)} BEVEL_SH={hx(bsh)} BEVEL_DK={hx(bdk)}")
PYPARSE
)"
export GLYPH_FG="${GLYPH:-}"
# SerenityOS-sourced conversions (icon==Serenity95, set above from the .ini
# branch — never the Windows .theme/Plus! branch) get SerenityOS's own
# triangle minimize/maximize glyphs instead of the 95 donor's bar/square,
# via redstone-9x-title-gradient (called inside classic-build). See that
# script for the shape swap; SERENITY_FACE lets it erase the donor glyph
# regardless of this variant's own recoloured button-face shade.
if [[ "${ICON}" == "Serenity95" ]]; then
  export SERENITY_FACE="${FACE}"
  # SerenityOS variants share the legacy scheme's taskbar Start button
  # (menu-buttons/serenity/start.png, the LadyBall mascot); Plus!/CDE do not.
  MENU_BUTTON="serenity"
else
  unset SERENITY_FACE
  MENU_BUTTON=""
fi
echo "parsed: title ${AD}->${AL} inactive ${ID2}->${IL} face ${FACE} sel ${HILITE} desktop ${BG} fg ${FG}"
GTKFG="${FG}" GTKBASE="${BASEC}" BEVEL_HI="${BEVEL_HI}" BEVEL_SH="${BEVEL_SH}" BEVEL_DK="${BEVEL_DK}" redstone-9x-classic-build "${OUT}" "${TNAME}" "${AD}" "${AL}" "${ID2}" "${IL}" "${FACE}" "${HILITE}"
# Title bar colours from the source .THE: background (ActiveTitle/InactiveTitle)
# and text (TitleText/InactiveTitleText). The base default.theme values (navy/grey)
# are wrong the moment the palette diverges from the 95 base. Menu hover accent was
# the 95 base's hardcoded navy until 2026-07-19 — now the theme's Hilight.
# Tahoma8pt is an ice2k bitmap-font name; sans-serif resolves everywhere.
sed -i -e "s|^ColorActiveTitleBar=.*|ColorActiveTitleBar=\"${AD}\"|" \
       -e "s|^ColorNormalTitleBar=.*|ColorNormalTitleBar=\"${ID2}\"|" \
       -e "s|^ColorActiveTitleBarText=.*|ColorActiveTitleBarText=\"${TITLEA}\"|" \
       -e "s|^ColorNormalTitleBarText=.*|ColorNormalTitleBarText=\"${TITLEI}\"|" \
       -e "s|^ColorActiveMenuItem=.*|ColorActiveMenuItem=\"${HILITE}\"|" \
       -e "s|^ColorActiveMenuItemText=.*|ColorActiveMenuItemText=\"${HITEXT}\"|" \
       -e "s|^ColorNormalMenuItemText=.*|ColorNormalMenuItemText=\"${FG}\"|" \
       -e "s|^ColorNormalTaskBarAppText=.*|ColorNormalTaskBarAppText=\"${FG}\"|" \
       -e "s|^ColorMinimizedTaskBarAppText=.*|ColorMinimizedTaskBarAppText=\"${FG}\"|" \
       -e "s|^ColorNormalButtonText=.*|ColorNormalButtonText=\"${FG}\"|" \
       -e "s|^ColorActiveButtonText=.*|ColorActiveButtonText=\"${FG}\"|" \
       -e "s|^ColorNormalLabelText=.*|ColorNormalLabelText=\"${FG}\"|" \
       -e "s|^ColorToolButtonText=.*|ColorToolButtonText=\"${FG}\"|" \
       -e "s|^ColorClockText=.*|ColorClockText=\"${FG}\"|" \
       -e "s|Tahoma8pt|sans-serif|g" "${OUT}/default.theme"
# LED clock renders from ledclock/*.png digit pixmaps with BLACK baked-in
# art — ignoring ColorClockText entirely (the invisible-clock mystery,
# 2026-07-19). Text mode obeys colour + font and centres by font metrics.
sed -i -e "s|^TaskBarClockLeds=1|TaskBarClockLeds=0|" \
       -e "s|^\(ClockFontNameXft *= *\"sans-serif:size=\)8|\110|" "${OUT}/default.theme"

# --- Matching qt6ct palette (Zeal and every Qt app follow the scheme) ---
QTDIR="${HOME}/DotCortex/linux/.config/redstone-9x/qt6ct/colors"
mkdir -p "${QTDIR}"
python3 - "${QTDIR}/${SID}.conf" "${FACE}" "${HILITE}" "${HITEXT}" "${FG}" "${BASEC}" "${BASETXT}" "${BEVEL_HI}" "${BEVEL_SH}" "${BEVEL_DK}" <<'PYQT'
import sys
out, face, hilite, hitext, fg, basec, basetxt, bhi, bsh, bdk = sys.argv[1:11]
F = tuple(int(face.lstrip('#')[i:i+2],16) for i in (0,2,4))
BHI = tuple(int(bhi.lstrip('#')[i:i+2],16) for i in (0,2,4))
BSH = tuple(int(bsh.lstrip('#')[i:i+2],16) for i in (0,2,4))
def hx(c): return '#ff%02x%02x%02x' % c
def mix(c, t, f): return tuple(round(a + (b - a) * f) for a, b in zip(c, t))
def a8(h): return '#ff' + h.lstrip('#').lower()
W, K = (255,255,255), (0,0,0)
FACEX = hx(F)
LIGHT = hx(BHI)
MIDL  = hx(mix(F, BHI, 0.50))
MID   = hx(mix(F, BSH, 0.50))
DARK  = hx(BSH)
ALT   = hx(mix(F, W, 0.65))
HI, HT = a8(hilite), a8(hitext)
FG2, BASE, BASET = a8(fg), a8(basec), a8(basetxt)
BLACK, WHITE = '#ff000000', '#ffffffff'
# Role order mirrors the hand-made win95.conf (Qt palette serialization):
# WindowText Button Light Midlight Dark Mid Text BrightText ButtonText Base
# Window Shadow Highlight HighlightedText Link LinkVisited AlternateBase
# NoRole ToolTipBase ToolTipText PlaceholderText Accent
active = [FG2, FACEX, LIGHT, MIDL, DARK, MID, BASET, WHITE, FG2, BASE,
          FACEX, BLACK, HI, HT, '#ff0000ff', '#ff800080', ALT, BLACK,
          '#ffffffe1', BLACK, DARK, HI]
disabled = list(active)
disabled[0] = disabled[6] = disabled[8] = DARK
disabled[9] = FACEX
disabled[12] = DARK
disabled[13] = WHITE
disabled[21] = DARK
with open(out, 'w') as f:
    f.write('[ColorScheme]\n')
    f.write('active_colors='   + ', '.join(active)   + '\n')
    f.write('disabled_colors=' + ', '.join(disabled) + '\n')
    f.write('inactive_colors=' + ', '.join(active)   + '\n')
print(f"qt6ct palette: {out}")
PYQT

## Per-scheme icon/cursor overrides: set ICON_OVERRIDE / CURSOR_OVERRIDE in
## the environment before calling this script to replace the auto-detected
## ICON_THEME / CURSOR_THEME in the emitted scheme file (e.g. wiring a
## community icon or cursor theme to its own matching scheme).
SCHEME_ICON="${ICON_OVERRIDE:-${ICON}}"
SCHEME_CURSOR="${CURSOR_OVERRIDE:-Chicago95_Cursor_White}"
BG_HEX="${BG#\#}"
BG_LUMA=$((16#${BG_HEX:0:2} * 299
         + 16#${BG_HEX:2:2} * 587
         + 16#${BG_HEX:4:2} * 114))
if (( BG_LUMA >= 128000 )); then
  DESKTOP_LABEL_FG="#000000"
else
  DESKTOP_LABEL_FG="#ffffff"
fi

cat > "${SCHEME}" <<EOFS
# Redstone 9X Desktop Scheme — ${TNAME} (converted from official .theme by
# redstone-9x-theme-convert; colours are the file's own).
SCHEME_TITLE="${TNAME}"
ICEWM_THEME="${TNAME// /-}"
MENU_BUTTON="${MENU_BUTTON}"
GTK_THEME="${TNAME// /-}"
ICON_THEME="${SCHEME_ICON}"
CURSOR_THEME="${SCHEME_CURSOR}"
CURSOR_SIZE="24"
GTK_FONT="Sans 8"
DESKTOP_BG="${BG}"
DESKTOP_ICON_LABEL_MODE="box"
DESKTOP_ICON_LABEL_FOREGROUND="${DESKTOP_LABEL_FG}"
DESKTOP_ICON_LABEL_BACKGROUND="${BG}"
SEL_BG="${HILITE}"
SEL_FG="${HITEXT}"
QT6CT_COLORS="${SID}.conf"
SOUND_SCHEME="${SND:-${SID}}"
WINE_COLORS="${SID}.reg"
FOX_BASE="${FACE}"
FOX_FG="${FG}"
FOX_BG="${BASEC}"
FOX_SEL_BG="${HILITE}"
FOX_SEL_FG="${HITEXT}"
FOX_MENU_BG="${HILITE}"
FOX_MENU_FG="${HITEXT}"
FOX_SHADOW="${BEVEL_SH}"
FOX_HILITE="${BEVEL_HI}"
FOX_BORDER="${BEVEL_DK}"
BEVEL_HIGHLIGHT="${BEVEL_HI}"
BEVEL_SHADOW="${BEVEL_SH}"
BEVEL_DKSHADOW="${BEVEL_DK}"
ICEWM_PREFS="TaskBarShowCPUStatus=1;TaskBarShowMEMStatus=1;TaskBarShowNetStatus=1;NetDevice=\"wlan0 eth0\";TaskBarShowShowDesktopButton=2;TrayDrawBevel=1;ClockCommand=\"i2kcal\";CPUStatusCommand=\"dbus-run-session mate-system-monitor\";NetStatusCommand=\"netactview\""
EOFS
echo "scheme written: ${SCHEME}"
# SerenityOS variants: bake a per-palette recoloured Start button so the taskbar
# Start button tracks this scheme's face instead of the shared grey master
# (delivered via menu-buttons/, preferred by scheme-apply as start-<id>.png).
if [[ "${ICON}" == "Serenity95" ]]; then
  redstone-9x-start-recolor "${FACE}" \
    "${HOME}/DotCortex/linux/.icewm/menu-buttons/serenity/start-${SID}.png" \
    || echo "warn: start-button recolour failed for ${SID}" >&2
fi
