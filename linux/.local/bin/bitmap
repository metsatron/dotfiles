#!/usr/bin/env bash
# bitmap replacement: the X11 bitmap editor is not in Guix; redirect to dticon.
exec dtterm -title "Bitmap Editor" -e sh -c '
echo "The X11 bitmap editor is not available in Guix."
echo "Use the CDE Icon Editor (dticon) instead:"
echo "  - FrontPanel → Icon Editor"
echo "  - Or run: dticon"
echo ""
echo "Press Enter to close..."
read _dummy
'
