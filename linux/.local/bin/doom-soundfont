#!/bin/bash
# doom-soundfont — pick which of the curated soundfonts dsda-doom renders MIDI with

# Mètsàtron keeps a curated soundfont collection in =~/RetroPie/BIOS= (26 of them: a
# purpose-built =Doom.sf2=, several Roland SC-55 recreations — the hardware the Doom
# MIDIs were actually composed on — Arachno, FluidR3, and a pile of console fonts).

# dsda-doom renders MIDI through fluidsynth and reads =snd_soundfont= from its config
# **at startup only** — it does not hot-reload.  This picks the font; =runcommand-shim=
# applies it on the next launch.


# [[file:../../../retropie.org::*doom-soundfont — pick which of the curated soundfonts dsda-doom renders MIDI with][doom-soundfont — pick which of the curated soundfonts dsda-doom renders MIDI with:1]]
# Choose the soundfont dsda-doom renders MIDI with.
set -euo pipefail

BIOS="${RETROPIE_BIOS_DIR:-${HOME}/RetroPie/BIOS}"
STATE="${XDG_CONFIG_HOME:-${HOME}/.config}/dotcortex/dsda-soundfont"
DSDA_CFG="${XDG_DATA_HOME:-${HOME}/.local/share}/dsda-doom/dsda-doom.cfg"

usage() {
  cat <<'EOF'
doom-soundfont - choose the soundfont dsda-doom renders MIDI with

Usage:
  doom-soundfont                 show the current choice
  doom-soundfont list            list the curated soundfonts in ~/RetroPie/BIOS
  doom-soundfont set <name>      choose one (bare filename, or a fuzzy fragment)
  doom-soundfont reset           fall back to the shim's default preference order

Takes effect on the NEXT launch — dsda reads its config at startup and does not
hot-reload, so quit the game before switching.
EOF
}

current() {
  local c=''
  [[ -r "${STATE}" ]] && c="$(head -n1 "${STATE}" 2>/dev/null || true)"
  if [[ -n "${c}" ]]; then
    printf 'chosen : %s\n' "${c}"
  else
    printf 'chosen : (none — shim picks its default, currently Doom.sf2 if present)\n'
  fi
  if [[ -r "${DSDA_CFG}" ]]; then
    printf 'in use : %s\n' "$(grep -m1 '^snd_soundfont' "${DSDA_CFG}" 2>/dev/null | sed 's/.*"\(.*\)"/\1/' | sed 's|.*/||')"
  fi
}

case "${1:-show}" in
  -h|--help) usage; exit 0 ;;
  show) current ;;
  list)
    [[ -d "${BIOS}" ]] || { echo "doom-soundfont: no BIOS dir: ${BIOS}" >&2; exit 1; }
    find "${BIOS}" -maxdepth 1 \( -iname '*.sf2' -o -iname '*.sf3' \) -printf '%s\t%f\n' 2>/dev/null \
      | sort -t"$(printf '\t')" -k2 \
      | awk -F'\t' '{ printf "  %7.1f MB  %s\n", $1/1048576, $2 }'
    ;;
  set)
    want="${2:-}"
    [[ -n "${want}" ]] || { usage >&2; exit 2; }
    # exact filename, else a case-insensitive fragment — one unambiguous hit required
    if [[ -r "${BIOS}/${want}" ]]; then
      hit="${want}"
    else
      mapfile -t hits < <(find "${BIOS}" -maxdepth 1 \( -iname '*.sf2' -o -iname '*.sf3' \) -printf '%f\n' 2>/dev/null \
                            | grep -i -- "${want}" || true)
      if (( ${#hits[@]} == 0 )); then
        echo "doom-soundfont: no soundfont matching '${want}' in ${BIOS}" >&2
        echo "  try: doom-soundfont list" >&2
        exit 1
      elif (( ${#hits[@]} > 1 )); then
        echo "doom-soundfont: '${want}' is ambiguous:" >&2
        printf '  %s\n' "${hits[@]}" >&2
        exit 1
      fi
      hit="${hits[0]}"
    fi
    mkdir -p "$(dirname -- "${STATE}")"
    printf '%s\n' "${hit}" > "${STATE}"
    printf 'soundfont set: %s\n' "${hit}"
    printf 'takes effect on the next launch of a (dsda) port.\n'
    ;;
  reset)
    rm -f "${STATE}"
    echo "soundfont choice cleared — the shim's default order applies again."
    ;;
  *) usage >&2; exit 2 ;;
esac
# doom-soundfont — pick which of the curated soundfonts dsda-doom renders MIDI with:1 ends here
