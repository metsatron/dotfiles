#!/bin/bash
# [[file:../../../sanctuary-redstone-9x-desktop.org::*=Exec=" must be QUOTED when the path contains spaces][=Exec=" must be QUOTED when the path contains spaces:13]]
set -euo pipefail

# PCManFM's Redstone GDK-Pixbuf profile does not ship a WebP loader.  Keep the
# original TRX title art in the shared game runtime, but materialise a small
# PNG projection in the guest home for the desktop shell.  This is regenerated
# from the runtime on refresh; no hand-copied icon payload is authoritative.
TRX_ROOT="${TRX_ROOT:-/run/dotcortex/games/tomb-raider-trx/runtime}"
ICON_DIR="${HOME}/.local/share/icons/redstone-9x"

converter="${REDSTONE_ICON_CONVERTER:-}"
if [[ -z "${converter}" ]]; then
  converter="$(command -v convert 2>/dev/null || true)"
fi
if [[ -z "${converter}" ]]; then
  for candidate in /gnu/store/*-imagemagick-*/bin/convert \
                   /run/host/gnu/store/*-imagemagick-*/bin/convert; do
    if [[ -x "${candidate}" ]]; then
      converter="${candidate}"
      break
    fi
  done
fi
if [[ -z "${converter}" ]]; then
  echo "redstone-9x-trx-icons: ImageMagick convert is unavailable; leaving icons untouched" >&2
  exit 0
fi

mkdir -p "${ICON_DIR}"
while IFS=: read -r source_name icon_name; do
  source="${TRX_ROOT}/${source_name}"
  destination="${ICON_DIR}/${icon_name}.png"
  [[ -f "${source}" ]] || continue
  temporary="${destination}.tmp"
  # Force the output codec: ImageMagick can otherwise preserve WebP while
  # merely changing the filename suffix, which makes PCManFM fall back to a
  # generic desktop icon.
  "${converter}" "${source}" -resize '256x256>' -strip "PNG:${temporary}"
  mv -f -- "${temporary}" "${destination}"
done <<'EOF'
games/tr1/images/title.webp:tomb-raider-1
games/tr2/images/title_us.webp:tomb-raider-2
games/tr3/images/title_us.webp:tomb-raider-3
EOF
# =Exec=" must be QUOTED when the path contains spaces:13 ends here
