#!/usr/bin/env python3
"""Recolour the SerenityOS Start button per Desktop-Scheme face colour.

Usage:
  redstone-9x-start-recolor --all                 regenerate all serenity-*.scheme buttons
  redstone-9x-start-recolor <face_hex> <out_png>  recolour one button to <face_hex>

Env: DOTCORTEX_ROOT (default ~/DotCortex). Requires Pillow (host-side build tool).
"""
import os, sys, glob, re
from PIL import Image

ROOT     = os.environ.get("DOTCORTEX_ROOT", os.path.expanduser("~/DotCortex"))
MENUDIR  = os.path.join(ROOT, "linux/.icewm/menu-buttons/serenity")
MASTER   = os.path.join(MENUDIR, "start.png")
SCHEMES  = os.path.join(ROOT, "linux/.config/redstone-9x/schemes")

MASTER_FACE = (212, 208, 200)          # #d4d0c8 — the master button's flat face
SAT_MIN     = 28                        # >this chroma => mascot colour, never tinted
ART_L_MAX   = 40                        # <this luma  => dark art (wordmark/outline)
DARK_FACE_L = 96                        # face luma <this => light art on dark button

def lum(c):   return 0.299*c[0] + 0.587*c[1] + 0.114*c[2]
def blend(a, b, t): return tuple(round(a[i] + (b[i]-a[i])*t) for i in range(3))
def hx(s):
    s = s.lstrip("#")
    return (int(s[0:2],16), int(s[2:4],16), int(s[4:6],16))

LFACE = lum(MASTER_FACE)

def recolour(face, bhi=None, bsh=None):
    """Return a recoloured copy of the master button for the given face RGB.

    Bevel blend TARGETS are the scheme's unified BEVEL_HIGHLIGHT/BEVEL_SHADOW
    (ruling 2026-08-08: blending to pure white/black reproduced the master's
    harsh ramp on every face — the Start button never got the soft-bevel
    treatment its theme chrome did). Fallback mirrors the converter's law."""
    if bhi is None or bsh is None:
        dark = lum(face) < 140
        f_hi, f_sh = (0.25, 0.5) if dark else (0.6, 0.4)
        bhi = bhi or blend(face, (255, 255, 255), f_hi)
        bsh = bsh or tuple(round(c * (1 - f_sh)) for c in face)
    im = Image.open(MASTER).convert("RGBA")
    px = im.load(); w, h = im.size
    dark = lum(face) < DARK_FACE_L
    art  = (255, 255, 255) if dark else (0, 0, 0)
    for y in range(h):
        for x in range(w):
            r, g, b, a = px[x, y]
            if a == 0:
                continue
            sat = max(r, g, b) - min(r, g, b)
            if sat > SAT_MIN:                      # LadyBall colour: leave it
                continue
            L = lum((r, g, b))
            if L < ART_L_MAX:                      # dark art: invert only on dark faces
                if dark:
                    px[x, y] = (art[0], art[1], art[2], a)
                continue
            if L >= LFACE:                         # highlight side of the bevel
                t  = (L - LFACE) / (255 - LFACE) if LFACE < 255 else 0.0
                nc = blend(face, bhi, t)
            else:                                  # shadow side of the bevel
                t  = (LFACE - L) / LFACE
                nc = blend(face, bsh, t)
            px[x, y] = (nc[0], nc[1], nc[2], a)
    return im

def face_of(scheme_file):
    m = re.search(r'^FOX_BASE="?(#[0-9A-Fa-f]{6})"?', open(scheme_file).read(), re.M)
    return m.group(1) if m else None

def bevels_of(scheme_file):
    txt = open(scheme_file).read()
    out = []
    for key in ("BEVEL_HIGHLIGHT", "BEVEL_SHADOW"):
        m = re.search(r'^%s="?(#[0-9A-Fa-f]{6})"?' % key, txt, re.M)
        out.append(hx(m.group(1)) if m else None)
    return out

def do_all():
    n = 0
    for sf in sorted(glob.glob(os.path.join(SCHEMES, "serenity-*.scheme"))):
        sid  = os.path.basename(sf)[:-len(".scheme")]
        face = face_of(sf)
        if not face:
            print(f"  skip {sid}: no FOX_BASE", file=sys.stderr); continue
        out = os.path.join(MENUDIR, f"start-{sid}.png")
        bhi, bsh = bevels_of(sf)
        recolour(hx(face), bhi, bsh).save(out)
        n += 1
        print(f"  {sid}  face={face} -> {os.path.relpath(out, ROOT)}")
    print(f"recoloured {n} SerenityOS Start buttons")

def main(argv):
    if not os.path.isfile(MASTER):
        sys.exit(f"master button missing: {MASTER}")
    if len(argv) == 1 and argv[0] == "--all":
        do_all()
    elif len(argv) == 2:
        face_hex, out_png = argv
        recolour(hx(face_hex)).save(out_png)
        print(f"recoloured -> {out_png}")
    else:
        sys.exit(__doc__)

if __name__ == "__main__":
    main(sys.argv[1:])
