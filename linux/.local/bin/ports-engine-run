#!/bin/bash
# Ports Engine Resolver

# The single in-guest mechanism both consumers share — the Lutris bridge (below) and the Redstone Ports menu (=ports-menu-gen=, =sanctuary-redstone-9x-fvwm95.org=). Given a ports =.sh= script, it resolves which engine to run it with and execs it, assuming the guest session environment is already set by the caller.

# Resolution is pure *identity lookup*, and that is deliberate: the pinned Guix engines are named to match the scripts' own =./bin/<enginedir>/= directory names exactly (=gzdoom-4.10.0=, =gzdoom-4.5.0= — see =make-gzdoom= in =package-guix-habitat.org=). So the whole test is "does the room-gaming profile carry a binary named after this script's engine dir?" If yes, rewrite the launch to that binary and drop the bundle's =LD_LIBRARY_PATH= (its front-loaded legacy libc/libs poison the Guix binary's RUNPATH); the game's own =-iwad=/=-file= args pass through untouched. If no, run the script *raw*, exactly as the tree intends — so every engine that already works in-guest is unchanged (no regression), and only the GL-bound gzdoom family that needs a version-exact Guix engine is redirected. GL engines without a Guix pin yet stay raw (still broken, not newly broken) until their version is built. The obsolete paired-loader lane is retired: it cleared engine init but hit the GLX wall, which only a Guix-linked Mesa binary passes (proven 2026-07-23).


# [[file:../../../lutris.org::*Ports Engine Resolver][Ports Engine Resolver:1]]
set -u

script="${1:?ports-engine-run: script path required}"
shift || true
[[ -f "$script" ]] || { echo "ports-engine-run: no such script: $script" >&2; exit 9; }

room_gaming="${HOME}/.guix-extra-profiles/room-gaming/room-gaming"

# The engine directory the script execs, e.g. gzdoom-4.10.0 from a
# `./bin/gzdoom-4.10.0/gzdoom …` line. First match wins; the profile-existence
# check below is what makes acting on it safe.
enginedir="$(grep -oE '\./bin/[^/ ]+/' "$script" 2>/dev/null | head -1 | sed -E 's#^\./bin/##; s#/$##')"

# Some scripts rely on being run from their own directory (relative asset
# paths); replicate the Ports menu's cd. Scripts that cd into the roms tree
# themselves simply override this.
cd "$(dirname "$script")" 2>/dev/null || true

if [[ -n "$enginedir" && -x "${room_gaming}/bin/${enginedir}" ]]; then
  # Version-exact Guix engine matches the pinned dir name — redirect to it.
  tmp="$(mktemp /tmp/ports-engine-XXXXXX.sh)"
  sed -E \
    -e "s#\./bin/${enginedir}/[^ ]+#${enginedir}#" \
    -e "/^LD_LIBRARY_PATH=/d" \
    -e "/^export LD_LIBRARY_PATH/d" \
    "$script" > "$tmp"
  PATH="${room_gaming}/bin:${PATH}" exec bash "$tmp" "$@"
fi

# No Guix engine for this script — run it exactly as the tree intends.
exec bash "$script" "$@"
# Ports Engine Resolver:1 ends here
