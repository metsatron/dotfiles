#!/usr/bin/env bash
# [[file:../../../retropie.org::*Ports launch scripts][Ports launch scripts:2]]
# Generate IceWM or FVWM95 menu entries for the ports launcher scripts.
# Deliberately glob only ROOT/*.sh and ROOT/*/*.sh; do not crawl game content.
set -euo pipefail

usage() {
  cat <<'EOF'
ports-menu-gen - generate a dynamic source-ports menu

Usage:
  ports-menu-gen icewm
  ports-menu-gen fvwm
  ports-menu-gen -h | --help

The default root is ~/RetroPie/roms/ports. Set RETROPIE_PORTS_DIR to use
another ports root for a bounded test. Only *.sh at depth one and two match.
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if (( $# != 1 )) || [[ "$1" != "icewm" && "$1" != "fvwm" ]]; then
  usage >&2
  exit 2
fi

MODE="$1"
ROOT="${RETROPIE_PORTS_DIR:-${HOME}/RetroPie/roms/ports}"

shopt -s nullglob
top_level=("$ROOT"/*.sh)
nested_level=("$ROOT"/*/*.sh)

top_scripts=()
utility_scripts=()
for script in "${top_level[@]}"; do
  [[ -f "$script" ]] || continue
  name="${script##*/}"
  if [[ "$name" == +* ]]; then
    utility_scripts+=("$script")
  else
    top_scripts+=("$script")
  fi
done

declare -A seen_dirs=()
nested_dirs=()
for script in "${nested_level[@]}"; do
  [[ -f "$script" ]] || continue
  dir="${script%/*}"
  if [[ -z "${seen_dirs[${dir}]+present}" ]]; then
    seen_dirs["$dir"]=1
    nested_dirs+=("$dir")
  fi
done

if (( ${#top_scripts[@]} + ${#utility_scripts[@]} + ${#nested_level[@]} == 0 )); then
  printf 'ports-menu-gen: no .sh launchers found at depth 1 or 2 below %s\n' "$ROOT" >&2
  exit 1
fi

menu_quote() {
  printf '"%s"' "$1"
}

shell_quote() {
  printf '%q' "$1"
}

launch_command() {
  local script="$1"
  local quoted
  quoted="$(shell_quote "$script")"
  printf -v command "sh -c 'cd -- \"\$(dirname \"\$1\")\" && exec \"\$1\"' ports-menu-entry %s" "$quoted"
  printf '%s' "$command"
}

icewm_entry() {
  local script="$1"
  local label="${script##*/}"
  label="${label%.sh}"
  printf '  prog %s application-x-executable %s\n' "$(menu_quote "$label")" "$(launch_command "$script")"
}

fvwm_entry() {
  local script="$1"
  local label="${script##*/}"
  label="${label%.sh}"
  printf '+ %s Exec %s &\n' "$(menu_quote "$label")" "$(launch_command "$script")"
}

emit_icewm() {
  local script dir label
  for script in "${top_scripts[@]}"; do icewm_entry "$script"; done
  if (( ${#utility_scripts[@]} )); then
    printf '  separator\n  menu %s preferences-system {\n' "$(menu_quote '+ Utilities')"
    for script in "${utility_scripts[@]}"; do icewm_entry "$script"; done
    printf '  }\n'
  fi
  while IFS= read -r dir; do
    [[ -n "$dir" ]] || continue
    label="${dir##*/}"
    printf '  menu %s folder {\n' "$(menu_quote "$label")"
    for script in "${nested_level[@]}"; do
      [[ "${script%/*}" == "$dir" ]] || continue
      icewm_entry "$script"
    done
    printf '  }\n'
  done < <(printf '%s\n' "${nested_dirs[@]}" | LC_ALL=C sort)
}

emit_fvwm() {
  local script dir label menu_id index=0
  printf 'DestroyMenu "Ports"\nAddToMenu "Ports" "Ports" Title\n'
  for script in "${top_scripts[@]}"; do fvwm_entry "$script"; done
  if (( ${#utility_scripts[@]} )); then
    printf '+ "+ Utilities" Popup PortsUtilities\n'
  fi
  while IFS= read -r dir; do
    [[ -n "$dir" ]] || continue
    index=$((index + 1))
    label="${dir##*/}"
    menu_id="PortsGame${index}"
    printf '+ %s Popup %s\n' "$(menu_quote "$label")" "$menu_id"
  done < <(printf '%s\n' "${nested_dirs[@]}" | LC_ALL=C sort)
  if (( ${#utility_scripts[@]} )); then
    printf 'DestroyMenu "PortsUtilities"\nAddToMenu "PortsUtilities" "+ Utilities" Title\n'
    for script in "${utility_scripts[@]}"; do fvwm_entry "$script"; done
  fi
  index=0
  while IFS= read -r dir; do
    [[ -n "$dir" ]] || continue
    index=$((index + 1))
    label="${dir##*/}"
    menu_id="PortsGame${index}"
    printf 'DestroyMenu "%s"\nAddToMenu "%s" %s Title\n' "$menu_id" "$menu_id" "$(menu_quote "$label")"
    for script in "${nested_level[@]}"; do
      [[ "${script%/*}" == "$dir" ]] || continue
      fvwm_entry "$script"
    done
  done < <(printf '%s\n' "${nested_dirs[@]}" | LC_ALL=C sort)
}

if [[ "$MODE" == "icewm" ]]; then
  emit_icewm
else
  emit_fvwm
fi
# Ports launch scripts:2 ends here
