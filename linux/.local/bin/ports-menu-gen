#!/bin/bash
# [[file:../../../retropie.org::*Ports launch scripts][Ports launch scripts:2]]
# Generate IceWM or FVWM95 menu entries for the ports launcher scripts.
# Deliberately glob only ROOT/*.sh and ROOT/*/*.sh; do not crawl game content.
set -euo pipefail

# Ordered first-match classification table. Patterns match the launcher path
# relative to ROOT, in lowercase. Keep engine-specific paths before the broad
# name rules so a future launcher can be retuned in this one place.
GROUP_RULES=(
  '+*.sh|Utilities'
  'buildgdx/*.sh|Build Engine'
  'eduke32/*.sh|Build Engine'
  'nblood/*.sh|Build Engine'
  'raze/*.sh|Build Engine'
  'duke nukem 3d*.sh|Build Engine'
  'ion fury*.sh|Build Engine'
  'blood.sh|Build Engine'
  'nblood*.sh|Build Engine'
  'powerslave exhumed*.sh|Build Engine'
  'shadow warrior*.sh|Build Engine'
  'redneck rampage*.sh|Build Engine'
  'buildgdx*.sh|Build Engine'
  'quake/*.sh|Quake family'
  'quake2/*.sh|Quake family'
  'quake3/*.sh|Quake family'
  '*quake*.sh|Quake family'
  'prboom*.sh|Doom'
  '*prboom*.sh|Doom'
  'zandronum/*.sh|Doom'
  'doom/*.sh|Doom'
  'doom2/*.sh|Doom'
  'gzdoom/*.sh|Doom'
  'gzdoom-games/*.sh|Doom'
  'gzdoom-tc/*.sh|Doom'
  'rbdoom-3-bfg/*.sh|Doom'
  'edge/*.sh|Doom'
  '*zandronum*.sh|Doom'
  '*freedoom*.sh|Doom'
  '*doom*.sh|Doom'
)

GROUP_ORDER=(
  'Build Engine'
  'Doom'
  'Quake family'
  'Standalone'
  'Utilities'
)

declare -A GROUP_LABELS=(
  ["Build Engine"]='Build Engine'
  ["Doom"]='Doom'
  ["Quake family"]='Quake family'
  ["Standalone"]='Standalone'
  ["Utilities"]='+ Utilities'
)

declare -A GROUP_ICONS=(
  ["Build Engine"]='folder'
  ["Doom"]='folder'
  ["Quake family"]='folder'
  ["Standalone"]='folder'
  ["Utilities"]='preferences-system'
)

declare -A GROUP_MENU_IDS=(
  ["Build Engine"]='PortsBuildEngine'
  ["Doom"]='PortsDoom'
  ["Quake family"]='PortsQuakeFamily'
  ["Standalone"]='PortsStandalone'
  ["Utilities"]='PortsUtilities'
)

usage() {
  cat <<'EOF'
ports-menu-gen - generate a dynamic source-ports menu

Usage:
  ports-menu-gen icewm
  ports-menu-gen fvwm
  ports-menu-gen -h | --help

Set RETROPIE_PORTS_DIR to force one root for a bounded test. Otherwise the
guest ~/RetroPie/roms/ports root is tried first, then the real host-home path
/home/metsatron/RetroPie/roms/ports. Only *.sh at depth one and two match.
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if (( $# != 1 )) || [[ "$1" != "icewm" && "$1" != "fvwm" ]]; then
  usage >&2
  exit 2
fi

MODE="$1"

emit_unavailable() {
  if [[ "${MODE}" == "icewm" ]]; then
    printf '  prog "Ports unavailable — RetroPie tree not mounted" dialog-warning true\n'
  else
    printf 'DestroyMenu "Ports"\n'
    printf 'AddToMenu "Ports" "Ports" Title\n'
    printf '+ "Ports unavailable — RetroPie tree not mounted" Nop\n'
  fi
}

# All normal-operation output is staged first. If any runtime error occurs
# after argument validation, the EXIT trap discards partial output, emits one
# valid unavailable menu, and forces status 0 so a menuprog/PipeRead caller can
# never be killed by missing media or an incidental generator failure.
OUTPUT_FILE="$(mktemp "${TMPDIR:-/tmp}/ports-menu-gen.XXXXXX")" || {
  emit_unavailable
  exit 0
}
PUBLISHED=0
runtime_cleanup() {
  local status=$?
  trap - EXIT
  rm -f -- "${OUTPUT_FILE}"
  if (( status != 0 )); then
    printf 'ports-menu-gen: runtime failure; emitting unavailable menu\n' >&2
    if (( PUBLISHED == 0 )); then
      emit_unavailable || true
    fi
  fi
  exit 0
}
trap runtime_cleanup EXIT

shopt -s nullglob
top_scripts=()
nested_level=()
ROOT=""

load_scripts() {
  local candidate="$1"
  local script
  local top_level=("${candidate}"/*.sh)
  local nested_candidates=("${candidate}"/*/*.sh)

  top_scripts=()
  nested_level=()
  for script in "${top_level[@]}"; do
    [[ -f "${script}" ]] || continue
    top_scripts+=("${script}")
  done
  for script in "${nested_candidates[@]}"; do
    [[ -f "${script}" ]] || continue
    nested_level+=("${script}")
  done

  if (( ${#top_scripts[@]} + ${#nested_level[@]} > 0 )); then
    ROOT="${candidate}"
    return 0
  fi
  return 1
}

if [[ -v RETROPIE_PORTS_DIR ]]; then
  candidate_roots=("${RETROPIE_PORTS_DIR}")
else
  candidate_roots=(
    "${HOME}/RetroPie/roms/ports"
    "/home/metsatron/RetroPie/roms/ports"
  )
fi

for candidate in "${candidate_roots[@]}"; do
  [[ -n "${candidate}" && -d "${candidate}" ]] || continue
  resolved_candidate="$(readlink -f -- "${candidate}" 2>/dev/null)" || continue
  if load_scripts "${resolved_candidate}"; then
    break
  fi
done

declare -A seen_dirs=()
nested_dirs=()
for script in "${nested_level[@]}"; do
  dir="${script%/*}"
  if [[ -z "${seen_dirs[${dir}]+present}" ]]; then
    seen_dirs["$dir"]=1
    nested_dirs+=("$dir")
  fi
done

if [[ -z "${ROOT}" ]]; then
  if [[ -v RETROPIE_PORTS_DIR ]]; then
    printf 'ports-menu-gen: no .sh launchers found at depth 1 or 2 below explicit root: %s\n' \
      "${RETROPIE_PORTS_DIR:-<empty>}" >&2
  else
    printf 'ports-menu-gen: no .sh launchers found in guest or host RetroPie roots\n' >&2
  fi
  emit_unavailable > "${OUTPUT_FILE}"
  cat -- "${OUTPUT_FILE}"
  PUBLISHED=1
  exit 0
fi

classify_script() {
  local script="$1"
  local relative="${script#"${ROOT}"/}"
  local lower="${relative,,}"
  local rule pattern group

  for rule in "${GROUP_RULES[@]}"; do
    pattern="${rule%%|*}"
    group="${rule#*|}"
    if [[ "${lower}" == ${pattern} ]]; then
      printf '%s' "${group}"
      return 0
    fi
  done

  # Never drop a launcher that has not been added to the table yet.
  printf '%s' 'Standalone'
}

menu_quote() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf '"%s"' "$value"
}

declare -A SCRIPT_GROUPS=()
all_scripts=("${top_scripts[@]}" "${nested_level[@]}")
for script in "${all_scripts[@]}"; do
  SCRIPT_GROUPS["${script}"]="$(classify_script "${script}")"
done

group_has_scripts() {
  local group="$1"
  local script
  for script in "${all_scripts[@]}"; do
    [[ "${SCRIPT_GROUPS[${script}]}" == "${group}" ]] && return 0
  done
  return 1
}

nested_dir_has_group() {
  local dir="$1"
  local group="$2"
  local script
  for script in "${nested_level[@]}"; do
    [[ "${script%/*}" == "${dir}" && "${SCRIPT_GROUPS[${script}]}" == "${group}" ]] && return 0
  done
  return 1
}

shell_quote() {
  printf '%q' "$1"
}

launch_command() {
  local script="$1"
  local quoted
  quoted="$(shell_quote "$script")"
  printf -v command "sh -c 'cd -- \"\$(dirname \"\$1\")\" && exec \"\$1\"' ports-menu-entry %s" "$quoted"
  printf '%s' "$command"
}

icewm_entry() {
  local script="$1"
  local label="${script##*/}"
  label="${label%.sh}"
  printf '  prog %s application-x-executable %s\n' "$(menu_quote "$label")" "$(launch_command "$script")"
}

fvwm_entry() {
  local script="$1"
  local label="${script##*/}"
  label="${label%.sh}"
  printf '+ %s Exec %s &\n' "$(menu_quote "$label")" "$(launch_command "$script")"
}

emit_icewm() {
  local group script dir label
  for group in "${GROUP_ORDER[@]}"; do
    group_has_scripts "${group}" || continue
    [[ "${group}" == 'Utilities' ]] && printf '  separator\n'
    printf '  menu %s %s {\n' \
      "$(menu_quote "${GROUP_LABELS[${group}]}")" "${GROUP_ICONS[${group}]}"
    for script in "${top_scripts[@]}"; do
      [[ "${SCRIPT_GROUPS[${script}]}" == "${group}" ]] || continue
      icewm_entry "${script}"
    done
    while IFS= read -r dir; do
      [[ -n "${dir}" ]] || continue
      nested_dir_has_group "${dir}" "${group}" || continue
      label="${dir##*/}"
      printf '    menu %s folder {\n' "$(menu_quote "${label}")"
      for script in "${nested_level[@]}"; do
        [[ "${script%/*}" == "${dir}" ]] || continue
        [[ "${SCRIPT_GROUPS[${script}]}" == "${group}" ]] || continue
        icewm_entry "${script}"
      done
      printf '    }\n'
    done < <(printf '%s\n' "${nested_dirs[@]}" | LC_ALL=C sort)
    printf '  }\n'
  done
}

emit_fvwm() {
  local group script dir label group_id menu_id index=0
  printf 'DestroyMenu "Ports"\nAddToMenu "Ports" "Ports" Title\n'
  for group in "${GROUP_ORDER[@]}"; do
    group_has_scripts "${group}" || continue
    group_id="${GROUP_MENU_IDS[${group}]}"
    printf '+ %s Popup %s\n' "$(menu_quote "${GROUP_LABELS[${group}]}")" "${group_id}"
  done
  for group in "${GROUP_ORDER[@]}"; do
    group_has_scripts "${group}" || continue
    group_id="${GROUP_MENU_IDS[${group}]}"
    printf 'DestroyMenu "%s"\nAddToMenu "%s" %s Title\n' \
      "${group_id}" "${group_id}" "$(menu_quote "${GROUP_LABELS[${group}]}")"
    for script in "${top_scripts[@]}"; do
      [[ "${SCRIPT_GROUPS[${script}]}" == "${group}" ]] || continue
      fvwm_entry "${script}"
    done
    index=0
    while IFS= read -r dir; do
      [[ -n "${dir}" ]] || continue
      nested_dir_has_group "${dir}" "${group}" || continue
      index=$((index + 1))
      label="${dir##*/}"
      menu_id="${group_id}Dir${index}"
      printf '+ %s Popup %s\n' "$(menu_quote "${label}")" "${menu_id}"
      printf 'DestroyMenu "%s"\nAddToMenu "%s" %s Title\n' \
        "${menu_id}" "${menu_id}" "$(menu_quote "${label}")"
      for script in "${nested_level[@]}"; do
        [[ "${script%/*}" == "${dir}" ]] || continue
        [[ "${SCRIPT_GROUPS[${script}]}" == "${group}" ]] || continue
        fvwm_entry "${script}"
      done
    done < <(printf '%s\n' "${nested_dirs[@]}" | LC_ALL=C sort)
  done
}

if [[ "$MODE" == "icewm" ]]; then
  emit_icewm > "${OUTPUT_FILE}"
else
  emit_fvwm > "${OUTPUT_FILE}"
fi

cat -- "${OUTPUT_FILE}"
PUBLISHED=1
exit 0
# Ports launch scripts:2 ends here
