#!/bin/bash


# Clippy host bridge.  The packaged Electron Forge directory lives in the host
# Applications tree, outside the public DotCortex repository.  This small
# Redstone command is the stable guest-side target used by both the IceWM menu
# and startup hook.


# [[file:../../../sanctuary-redstone-9x-fvwm95.org::*Dynamic menus — recent Documents + Desktop folder][Dynamic menus — recent Documents + Desktop folder:15]]
# redstone-9x-clippy — Redstone's guest-side Clippy host bridge.
set -euo pipefail

# Host path to the Clippy Electron binary. The /run/host prefix is the
# container's view of the host filesystem — used only for -x presence checks.
# host-spawn receives the plain host path so the host kernel finds the ELF
# interpreter (the container's ld-linux cannot exec host Electron binaries).
CLIPPY_BIN="${REDSTONE_CLIPPY_BIN:-/home/metsatron/Applications/Clippy-linux-x64/Clippy}"

# Clippy's ruled resting spot (captured 2026-08-08). The IceWM winoptions pin
# (clippy.Clippy.startX/startY in linux/.icewm/winoptions) sets the WM's
# initial-placement hint, but Electron BrowserWindows position themselves
# from their own x/y constructor options AFTER map, silently overriding any
# WM placement hint — confirmed live 2026-08-11: a winoptions-only launch
# landed at 897,476, not the ruled spot. This active mover is the one shared
# placement mechanism both launch paths (autostart + menu) use, since both
# call this one script.
CLIPPY_X="${REDSTONE_CLIPPY_X:-1114}"
CLIPPY_Y="${REDSTONE_CLIPPY_Y:-330}"

# Waits for Clippy's main assistant window (title "Clippy" exactly — NOT the
# "Clippy Chat" child window Electron opens via window.open(), which shares
# the same WM_CLASS so winoptions class-matching cannot tell them apart) to
# map, then pins it with icesh (ships with IceWM; no wmctrl/xdotool in this
# guest). Moved a second time a beat later in case Clippy's own init nudges
# it once more after first paint (observed harmless either way in testing).
# Best-effort and silent: a slow or headless GPU init must never block the
# rest of the desktop startup.
redstone_9x_clippy_place() {
  local tries=0
  while (( tries < 40 )); do
    if icesh -name '^Clippy$' move "${CLIPPY_X}" "${CLIPPY_Y}" >/dev/null 2>&1; then
      sleep 0.5
      icesh -name '^Clippy$' move "${CLIPPY_X}" "${CLIPPY_Y}" >/dev/null 2>&1 || true
      return 0
    fi
    sleep 0.5
    (( tries += 1 ))
  done
}

case "${1:-}" in
  --check)
    [[ -x "/run/host${CLIPPY_BIN}" ]]
    ;;
  --autostart|"")
    if [[ ! -x "/run/host${CLIPPY_BIN}" ]]; then
      printf 'redstone-9x-clippy: missing executable: %s\n' "${CLIPPY_BIN}" >&2
      exit 127
    fi
    redstone_9x_clippy_place &
    disown
    exec redstone-9x-host-gtk "${CLIPPY_BIN}"
    ;;
  -h|--help)
    printf 'Usage: redstone-9x-clippy [--check|--autostart]\n'
    ;;
  *)
    printf 'Usage: redstone-9x-clippy [--check|--autostart]\n' >&2
    exit 2
    ;;
esac
# Dynamic menus — recent Documents + Desktop folder:15 ends here
