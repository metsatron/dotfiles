#!/bin/bash


# Clippy launcher.  The packaged Electron Forge directory lives in the host
# Applications tree, outside the public DotCortex repository.  This wrapper is
# the stable guest-side target used by both the IceWM menu and startup hook.


# [[file:../../../sanctuary-redstone-9x-fvwm95.org::*Dynamic menus — recent Documents + Desktop folder][Dynamic menus — recent Documents + Desktop folder:15]]
# redstone-9x-clippy — launch Clippy from the host Applications tree.
set -euo pipefail

CLIPPY_BIN="${REDSTONE_CLIPPY_BIN:-/run/host/home/metsatron/Applications/Clippy-linux-x64/Clippy}"

case "${1:-}" in
  --check)
    [[ -x "${CLIPPY_BIN}" ]]
    ;;
  --autostart|"")
    if [[ ! -x "${CLIPPY_BIN}" ]]; then
      printf 'redstone-9x-clippy: missing executable: %s\n' "${CLIPPY_BIN}" >&2
      exit 127
    fi
    exec "${CLIPPY_BIN}"
    ;;
  -h|--help)
    printf 'Usage: redstone-9x-clippy [--check|--autostart]\n'
    ;;
  *)
    printf 'Usage: redstone-9x-clippy [--check|--autostart]\n' >&2
    exit 2
    ;;
esac
# Dynamic menus — recent Documents + Desktop folder:15 ends here
