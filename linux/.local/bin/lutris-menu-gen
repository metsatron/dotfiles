#!/bin/bash


# Lutris game-library menu generator.

# The =Lutris= entry directly under the Wine menu is an IceWM =menuprog= — IceWM runs this generator on every open and consumes its stdout as the submenu body (the same dynamic-menu mechanism the =Ports= entry uses). It reads the shared Lutris =pga.db= sqlite catalogue **directly** — never spawning the Lutris Flatpak — so it stays far inside the menuprog budget (≈50 ms for a 400-game library; the bash-loop first draft took 1 s, hence the awk emitter). Only =installed=1= and non-hidden games are listed. The library is large, so it is grouped: a *Recently Played* submenu (the ten most-recent by =lastplayed=) followed by =A–Z= letter folders (a =#= folder collects non-alphabetic titles). Each game launches through =sanctuary-flatpak-run= so it inherits the sanctuary home and the shared Lutris config/data links, via Lutris's own =lutris:rungameid/<id>= URI. Absent DB or sqlite degrades to a single informational entry rather than an error. The =MODE= argument (only =icewm= today) leaves room to add an XFCE emitter when this is ported to Godzilla XS.


# [[file:../../../sanctuary-redstone-9x-fvwm95.org::*FVWM95 configuration][FVWM95 configuration:4]]
# lutris-menu-gen — emit a Lutris game submenu for a running sanctuary.
# Reads the shared Lutris pga.db directly (no flatpak spawn) so it stays well
# within IceWM's menuprog budget. Games launch through sanctuary-flatpak-run so
# they inherit the sanctuary home and the shared Lutris library links.
#
# Usage: lutris-menu-gen icewm
set -euo pipefail

MODE="${1:-icewm}"
DB="${HOME}/RetroPie/stow/.local/share/lutris/pga.db"
WRAPPER="${HOME}/.local/bin/sanctuary-flatpak-run"
APP="net.lutris.Lutris"
ICON="lutris"
US=$'\x1f'   # unit separator — never appears in a game name

msg() { printf '  prog "%s" dialog-information true\n' "${1//\"/\\\"}"; }

if [[ "${MODE}" != icewm ]]; then echo "lutris-menu-gen: only icewm mode implemented" >&2; exit 2; fi
if [[ ! -f "${DB}" ]] || ! command -v sqlite3 >/dev/null 2>&1; then
  msg "Lutris library unavailable"; exit 0
fi

# awk emitter: FLAT=1 emits a flat list; FLAT=0 groups into A–Z / # folders.
AWK='
BEGIN { FS="\x1f" }
function q(s){ gsub(/\\/,"\\\\",s); gsub(/"/,"\\\"",s); return s }
{
  name=$2; id=$1
  if (!FLAT) {
    L=toupper(substr(name,1,1)); if (L !~ /[A-Z]/) L="#"
    if (L!=cur){ if(cur!="") print "  }"; printf "  menu \"%s\" folder {\n", L; cur=L }
  }
  printf "  prog \"%s\" %s %s %s lutris:rungameid/%s\n", q(name), ICON, WRAPPER, APP, id
}
END { if (!FLAT && cur!="") print "  }" }
'

# ---- Recently Played (top 10 actually-played) ----
recent="$(sqlite3 -separator "${US}" "${DB}" \
  "SELECT id,name FROM games WHERE installed=1 AND (hidden IS NULL OR hidden=0) AND COALESCE(lastplayed,0)>0 ORDER BY lastplayed DESC LIMIT 10;" 2>/dev/null || true)"
if [[ -n "${recent}" ]]; then
  printf '  menu "Recently Played" %s {\n' "${ICON}"
  printf '%s\n' "${recent}" | awk -v FLAT=1 -v ICON="${ICON}" -v WRAPPER="${WRAPPER}" -v APP="${APP}" "${AWK}"
  printf '  }\n  separator\n'
fi

# ---- A–Z letter groups over the whole installed library ----
all="$(sqlite3 -separator "${US}" "${DB}" \
  "SELECT id,name FROM games WHERE installed=1 AND (hidden IS NULL OR hidden=0) ORDER BY name COLLATE NOCASE;" 2>/dev/null || true)"
if [[ -z "${all}" ]]; then msg "No installed Lutris games"; exit 0; fi
printf '%s\n' "${all}" | awk -v FLAT=0 -v ICON="${ICON}" -v WRAPPER="${WRAPPER}" -v APP="${APP}" "${AWK}"
# FVWM95 configuration:4 ends here
