#!/usr/bin/env bash
# FVWM95 build script

# Compiles FVWM95 (mintsuki fork) from source inside the
# =sanctuary-redstone-9x= container.  Run once from the host:
# =make guix-room-fvwm95= then =sanctuary-redstone-9x-fvwm95-build=.

# Uses the =room-fvwm95= Guix profile for build tools (gcc, autoconf, etc.)
# and installs the compiled FVWM95 to =~/.local/fvwm95/= inside the guest home.


# [[file:../../../distrobox.org::*FVWM95 build script][FVWM95 build script:1]]
# Build FVWM95 from source inside sanctuary-redstone-9x.
# Prerequisites:
#   make guix-room-fvwm95   ← build the build-tools Guix profile
#   distrobox-sanctuaries-create
#   vm-homes-init
set -euo pipefail

SANCTUARY="sanctuary-redstone-9x"
GUIX_PROFILES="${HOME}/.guix-extra-profiles"
FVWM95_REPO="https://github.com/mintsuki/fvwm95.git"
INSTALL_PREFIX="\${HOME}/.local/fvwm95"

# Verify the build profile exists on the host.
if [[ ! -f "${GUIX_PROFILES}/room-fvwm95/room-fvwm95/etc/profile" ]]; then
  echo "fvwm95-build: ERROR — room-fvwm95 profile not built" >&2
  echo "  Run: make guix-room-fvwm95" >&2
  exit 1
fi

echo "fvwm95-build: cloning and building FVWM95 inside ${SANCTUARY}…"
sanctuary-exec "${SANCTUARY}" bash -c "
set -euo pipefail

# Guix etc/profile uses set -u and references env vars that may be unset.
# Pre-declare them so sourcing the profile doesn't fail.
export LIBRARY_PATH=\${LIBRARY_PATH:-}
export CPATH=\${CPATH:-}
export C_INCLUDE_PATH=\${C_INCLUDE_PATH:-}
export CPLUS_INCLUDE_PATH=\${CPLUS_INCLUDE_PATH:-}
export ACLOCAL_PATH=\${ACLOCAL_PATH:-}
export PKG_CONFIG_PATH=\${PKG_CONFIG_PATH:-}
export GI_TYPELIB_PATH=\${GI_TYPELIB_PATH:-}
export OBJCPLUS_INCLUDE_PATH=\${OBJCPLUS_INCLUDE_PATH:-}
export OBJC_INCLUDE_PATH=\${OBJC_INCLUDE_PATH:-}

GUIX_PROFILE=${GUIX_PROFILES}/room-fvwm95/room-fvwm95
. \${GUIX_PROFILE}/etc/profile

BUILD_DIR=\${HOME}/.cache/fvwm95-build
INSTALL_DIR=${INSTALL_PREFIX}

# Clone or update.
if [[ -d \${BUILD_DIR}/.git ]]; then
  echo '→ Updating fvwm95 repo…'
  git -C \${BUILD_DIR} pull --ff-only
else
  echo '→ Cloning fvwm95…'
  rm -rf \${BUILD_DIR}
  git clone --depth 1 ${FVWM95_REPO} \${BUILD_DIR}
fi

cd \${BUILD_DIR}

# Bootstrap, configure, build, install.
echo '→ Bootstrapping…'
./bootstrap
echo '→ Configuring…'
./configure --prefix=\${INSTALL_DIR}
echo '→ Building…'
make -j\$(nproc 2>/dev/null || echo 4)
echo '→ Installing…'
make install

# Remove the upstream sample config from the module dir so fvwm95
# doesn't accidentally read it alongside our custom ~/.fvwm95rc.
rm -f \${INSTALL_DIR}/lib/X11/fvwm95/.fvwm95rc
rm -f \${INSTALL_DIR}/lib/X11/fvwm95/system.fvwm95rc

echo '→ FVWM95 installed to \${INSTALL_DIR}'
echo '  Binary: \${INSTALL_DIR}/bin/fvwm95'
"

# Install the Chicago95 Win95 cursor theme into the guest home.
# libX11 dlopens libXcursor (from the desktop-common profile) to render
# these themed cursors when XCURSOR_THEME is set.
echo "fvwm95-build: installing Chicago95 cursor theme…"
GUEST_HOME=$(eval echo "~${SANCTUARY_USER:-metsatron}/.local/share/dotcortex/guests/${SANCTUARY}/home")
CHICAGO95_DIR="${GUEST_HOME}/.icons/Chicago95_Cursor_White"
if [[ -d "${CHICAGO95_DIR}/cursors" && -f "${CHICAGO95_DIR}/index.theme" ]]; then
  echo "fvwm95-build: Chicago95 cursor theme already installed"
else
  CURSOR_SRC=$(mktemp -d)
  git clone --depth 1 --filter=blob:none --sparse https://github.com/grassmunk/Chicago95.git "${CURSOR_SRC}" \
    && (cd "${CURSOR_SRC}" && git sparse-checkout set Cursors) \
    && mkdir -p "${GUEST_HOME}/.icons" \
    && cp -r "${CURSOR_SRC}/Cursors/Chicago95_Cursor_White" "${GUEST_HOME}/.icons/" \
    && rm -rf "${CURSOR_SRC}"
  # Set as default cursor theme (fallback when XCURSOR_THEME unset)
  mkdir -p "${GUEST_HOME}/.icons/default"
  printf '[Icon Theme]\nInherits=Chicago95_Cursor_White\n' > "${GUEST_HOME}/.icons/default/index.theme"
fi

# Also install on the HOST ~/.icons — needed for the host-side xsetroot call
# in the launch script (which sets the Xephyr root cursor before the container
# starts). The host libXcursor searches the host ~/.icons, not the guest's.
HOST_ICONS="$(eval echo "~${SANCTUARY_USER:-metsatron}/.icons")"
if [[ ! -d "${HOST_ICONS}/Chicago95_Cursor_White/cursors" ]]; then
  CURSOR_SRC2=$(mktemp -d)
  git clone --depth 1 --filter=blob:none --sparse https://github.com/grassmunk/Chicago95.git "${CURSOR_SRC2}" \
    && (cd "${CURSOR_SRC2}" && git sparse-checkout set Cursors) \
    && mkdir -p "${HOST_ICONS}" \
    && cp -r "${CURSOR_SRC2}/Cursors/Chicago95_Cursor_White" "${HOST_ICONS}/" \
    && rm -rf "${CURSOR_SRC2}"
  mkdir -p "${HOST_ICONS}/default"
  printf '[Icon Theme]\nInherits=Chicago95_Cursor_White\n' > "${HOST_ICONS}/default/index.theme"
fi

echo "fvwm95-build: done. Launch with: sanctuary-enter sanctuary-redstone-9x:fvwm95"
# FVWM95 build script:1 ends here
