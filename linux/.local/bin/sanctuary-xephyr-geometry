#!/usr/bin/env bash
# [[file:../../../sanctuary-distrobox.org::*Sanctuary Launcher Scripts][Sanctuary Launcher Scripts:8]]
# sanctuary-xephyr-geometry — print the Xephyr geometry arguments for this host,
# one per line (consume with: mapfile -t XEPHYR_GEOMETRY < <(sanctuary-xephyr-geometry)).
#
# Xephyr -fullscreen sizes itself to the WHOLE X screen — the bounding box of
# every connected output — so on a multi-head host the room spans all monitors
# (found 2026-07-26 on Redstone: a 3000x1920 screen from a 1920x1080 laptop
# panel plus a portrait 1080x1920 external straddled both; re-confirmed
# 2026-07-30 when GNUstep and MiDesktop did the same, and MiDesktop's
# Xinerama-unaware 1998-era kwm aborted outright on the spanning root).
# -output restricts fullscreen to ONE RandR output's geometry. The shared
# output policy prefers the built-in laptop panel so portrait side panels are
# never selected implicitly. sanctuary-xephyr-place corrects the host window
# after Xephyr starts because some builds misplace fullscreen windows with
# rotation.
set -euo pipefail

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  cat <<EOF
sanctuary-xephyr-geometry - print Xephyr geometry args for this host, one per line

Usage: mapfile -t XEPHYR_GEOMETRY < <(sanctuary-xephyr-geometry)
       Xephyr :NN "\${XEPHYR_GEOMETRY[@]}" -br -ac -glamor -no-host-grab &

Prints '-output <head>' on a multi-head host using the shared built-in-panel-first
policy; override with SANCTUARY_XEPHYR_OUTPUT, else '-fullscreen'.
EOF
  exit 0
fi

if command -v xrandr >/dev/null 2>&1; then
  _xout="$(sanctuary-xephyr-output "${DISPLAY:-}" 2>/dev/null || true)"
  _xcount="$(xrandr --query 2>/dev/null | awk '$2 == "connected" { count++ } END { print count + 0 }')" || _xcount=0
  if [[ -n "${_xout}" && "${_xcount}" -gt 1 ]]; then
    echo "sanctuary-xephyr-geometry: restricting Xephyr to output ${_xout} (${_xcount} outputs connected)" >&2
    printf -- '-output\n%s\n' "${_xout}"
    exit 0
  fi
fi
printf -- '-fullscreen\n'
# Sanctuary Launcher Scripts:8 ends here
