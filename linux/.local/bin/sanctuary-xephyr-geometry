#!/usr/bin/env bash
# [[file:../../../sanctuary-distrobox.org::*Sanctuary Launcher Scripts][Sanctuary Launcher Scripts:6]]
# sanctuary-xephyr-geometry — print the Xephyr geometry arguments for this host,
# one per line (consume with: mapfile -t XEPHYR_GEOMETRY < <(sanctuary-xephyr-geometry)).
#
# Xephyr -fullscreen sizes itself to the WHOLE X screen — the bounding box of
# every connected output — so on a multi-head host the room spans all monitors
# (found 2026-07-26 on Redstone: a 3000x1920 screen from a 1920x1080 laptop
# panel plus a portrait 1080x1920 external straddled both; re-confirmed
# 2026-07-30 when GNUstep and MiDesktop did the same, and MiDesktop's
# Xinerama-unaware 1998-era kwm aborted outright on the spanning root).
# -output restricts fullscreen to ONE RandR output's geometry, which is what
# "fullscreen" is meant to mean here. Default to the RandR primary, fall back
# to the first connected output, and fall back again to plain -fullscreen on a
# single-head host or when xrandr is unavailable.
# Override the chosen head with SANCTUARY_XEPHYR_OUTPUT=HDMI-2.
# (sanctuary-redstone-9x-launch predates this helper and carries its own copy
# of the same logic with the REDSTONE_XEPHYR_OUTPUT override.)
set -euo pipefail

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  cat <<EOF
sanctuary-xephyr-geometry - print Xephyr geometry args for this host, one per line

Usage: mapfile -t XEPHYR_GEOMETRY < <(sanctuary-xephyr-geometry)
       Xephyr :NN "\${XEPHYR_GEOMETRY[@]}" -br -ac -no-host-grab &

Prints '-output <head>' on a multi-head host (RandR primary, else first
connected; override with SANCTUARY_XEPHYR_OUTPUT), else '-fullscreen'.
EOF
  exit 0
fi

_xout="${SANCTUARY_XEPHYR_OUTPUT:-}"
if command -v xrandr >/dev/null 2>&1; then
  if [[ -z "${_xout}" ]]; then
    _xout="$(xrandr --query 2>/dev/null | awk '/ connected primary/{print $1; exit}')" || _xout=""
    [[ -n "${_xout}" ]] || _xout="$(xrandr --query 2>/dev/null | awk '/ connected/{print $1; exit}')" || _xout=""
  fi
  _xcount="$(xrandr --query 2>/dev/null | grep -c ' connected')" || _xcount=0
  if [[ -n "${_xout}" && "${_xcount}" -gt 1 ]]; then
    echo "sanctuary-xephyr-geometry: restricting Xephyr to output ${_xout} (${_xcount} outputs connected)" >&2
    printf -- '-output\n%s\n' "${_xout}"
    exit 0
  fi
fi
printf -- '-fullscreen\n'
# Sanctuary Launcher Scripts:6 ends here
