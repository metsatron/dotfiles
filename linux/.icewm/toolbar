# File Manager / Editor / Web Browser, SerenityOS-style). Four items is canon.
# One File Manager only (pcmanfm). xclass Explorer lives in the Start menu,
# not here, to avoid a redundant second file-manager button.
prog "Terminal"       utilities-terminal    /home/metsatron/.local/bin/redstone-9x-zsh --default-window
prog "File Manager"   system-file-manager   pcmanfm -n
prog "Text Editor"    text-editor           mousepad
prog "Web Browser"    web-browser           firefox
