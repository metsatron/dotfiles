# Redstone 9X — IceWM quick-launch strip
# One File Manager only (pcmanfm). xclass Explorer lives in the Start menu,
# not here, to avoid a redundant second file-manager button.
prog "File Manager"   system-file-manager   pcmanfm
prog "Text Editor"    text-editor           mousepad
prog "Web Browser"    firefox_2             firefox
prog "Music Player"   multimedia            audacious
