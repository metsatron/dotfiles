# KDE Games — every KF6 game in one submenu, grouped the way KDE's own menu
# does (board/logic, puzzle, arcade). Each carries the full Qt env: qt6ct for
# theming, QT_PLUGIN_PATH for its platform-theme plugin, and QML_IMPORT_PATH so
# the KNewStuff "Get New ..." dialogs can find org.kde.kirigami/kcmutils — none
# of which room-gaming's etc/profile exports.
menu "KDE Games" applications-games {
  menu "Board" applications-games {
    prog "KReversi"      kreversi     env QT_QPA_PLATFORMTHEME=qt6ct QT_PLUGIN_PATH=@ROOM_QT6_PLUGINS@ QML_IMPORT_PATH=@ROOM_QT6_QML@ QML2_IMPORT_PATH=@ROOM_QT6_QML@ kreversi
    prog "Bovo"          bovo         env QT_QPA_PLATFORMTHEME=qt6ct QT_PLUGIN_PATH=@ROOM_QT6_PLUGINS@ QML_IMPORT_PATH=@ROOM_QT6_QML@ QML2_IMPORT_PATH=@ROOM_QT6_QML@ bovo
    prog "KFourInLine"   kfourinline  env QT_QPA_PLATFORMTHEME=qt6ct QT_PLUGIN_PATH=@ROOM_QT6_PLUGINS@ QML_IMPORT_PATH=@ROOM_QT6_QML@ QML2_IMPORT_PATH=@ROOM_QT6_QML@ kfourinline
    prog "KSquares"      ksquares     env QT_QPA_PLATFORMTHEME=qt6ct QT_PLUGIN_PATH=@ROOM_QT6_PLUGINS@ QML_IMPORT_PATH=@ROOM_QT6_QML@ QML2_IMPORT_PATH=@ROOM_QT6_QML@ ksquares
    prog "KNights"       knights      env QT_QPA_PLATFORMTHEME=qt6ct QT_PLUGIN_PATH=@ROOM_QT6_PLUGINS@ QML_IMPORT_PATH=@ROOM_QT6_QML@ QML2_IMPORT_PATH=@ROOM_QT6_QML@ knights
    prog "Kigo"          kigo         env QT_QPA_PLATFORMTHEME=qt6ct QT_PLUGIN_PATH=@ROOM_QT6_PLUGINS@ QML_IMPORT_PATH=@ROOM_QT6_QML@ QML2_IMPORT_PATH=@ROOM_QT6_QML@ kigo
  }
  menu "Cards & Tiles" applications-games {
    prog "KPatience"     kpat         env QT_QPA_PLATFORMTHEME=qt6ct QT_PLUGIN_PATH=@ROOM_QT6_PLUGINS@ QML_IMPORT_PATH=@ROOM_QT6_QML@ QML2_IMPORT_PATH=@ROOM_QT6_QML@ kpat
    prog "LSkat"         lskat        env QT_QPA_PLATFORMTHEME=qt6ct QT_PLUGIN_PATH=@ROOM_QT6_PLUGINS@ QML_IMPORT_PATH=@ROOM_QT6_QML@ QML2_IMPORT_PATH=@ROOM_QT6_QML@ lskat
    prog "KMahjongg"     kmahjongg    env QT_QPA_PLATFORMTHEME=qt6ct QT_PLUGIN_PATH=@ROOM_QT6_PLUGINS@ QML_IMPORT_PATH=@ROOM_QT6_QML@ QML2_IMPORT_PATH=@ROOM_QT6_QML@ kmahjongg
    prog "KShisen"       kshisen      env QT_QPA_PLATFORMTHEME=qt6ct QT_PLUGIN_PATH=@ROOM_QT6_PLUGINS@ QML_IMPORT_PATH=@ROOM_QT6_QML@ QML2_IMPORT_PATH=@ROOM_QT6_QML@ kshisen
    # Kajongg alone needs XDG_DATA_DIRS extended. It is the Python game, and its
    # mjresource.py __directories() does:
    #     result = QStandardPaths.locateAll(GenericDataLocation, 'kmahjongglib/...')
    #     if not result: logError('cannot find kmahjongg resources...'); sys.exit(1)
    #     result.insert(0, '<libkmahjongg store path>/kmahjongglib/...')
    # Guix patches in the store fallback AFTER the guard, so an empty locateAll
    # exits before the fallback it just added is ever used. Its wrapper only adds
    # kajongg's own share, so the tilesets have to arrive via inherited env — and
    # relying on that is what left it broken. sh -c because IceWM does not expand
    # $VAR, and we must APPEND rather than replace the session's value.
    prog "Kajongg"       kajongg      sh -c 'XDG_DATA_DIRS="${XDG_DATA_DIRS}:@ROOM_SHARE@" QT_QPA_PLATFORMTHEME=qt6ct QT_PLUGIN_PATH=@ROOM_QT6_PLUGINS@ QML_IMPORT_PATH=@ROOM_QT6_QML@ QML2_IMPORT_PATH=@ROOM_QT6_QML@ exec kajongg'
  }
  menu "Puzzle" applications-games {
    prog "KMines"        kmines       env QT_QPA_PLATFORMTHEME=qt6ct QT_PLUGIN_PATH=@ROOM_QT6_PLUGINS@ QML_IMPORT_PATH=@ROOM_QT6_QML@ QML2_IMPORT_PATH=@ROOM_QT6_QML@ kmines
    prog "KAtomic"       katomic      env QT_QPA_PLATFORMTHEME=qt6ct QT_PLUGIN_PATH=@ROOM_QT6_PLUGINS@ QML_IMPORT_PATH=@ROOM_QT6_QML@ QML2_IMPORT_PATH=@ROOM_QT6_QML@ katomic
    prog "Kolor Lines"   klines       env QT_QPA_PLATFORMTHEME=qt6ct QT_PLUGIN_PATH=@ROOM_QT6_PLUGINS@ QML_IMPORT_PATH=@ROOM_QT6_QML@ QML2_IMPORT_PATH=@ROOM_QT6_QML@ klines
    prog "Picmi"         picmi        env QT_QPA_PLATFORMTHEME=qt6ct QT_PLUGIN_PATH=@ROOM_QT6_PLUGINS@ QML_IMPORT_PATH=@ROOM_QT6_QML@ QML2_IMPORT_PATH=@ROOM_QT6_QML@ picmi
    prog "KBlocks"       kblocks      env QT_QPA_PLATFORMTHEME=qt6ct QT_PLUGIN_PATH=@ROOM_QT6_PLUGINS@ QML_IMPORT_PATH=@ROOM_QT6_QML@ QML2_IMPORT_PATH=@ROOM_QT6_QML@ kblocks
  }
  menu "Arcade" applications-games {
    prog "KBounce"       kbounce      env QT_QPA_PLATFORMTHEME=qt6ct QT_PLUGIN_PATH=@ROOM_QT6_PLUGINS@ QML_IMPORT_PATH=@ROOM_QT6_QML@ QML2_IMPORT_PATH=@ROOM_QT6_QML@ kbounce
    prog "KBreakOut"     kbreakout    env QT_QPA_PLATFORMTHEME=qt6ct QT_PLUGIN_PATH=@ROOM_QT6_PLUGINS@ QML_IMPORT_PATH=@ROOM_QT6_QML@ QML2_IMPORT_PATH=@ROOM_QT6_QML@ kbreakout
  }
}

