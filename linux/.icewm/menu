menu "IceWM" preferences-desktop {
  menu "Themes" preferences-desktop-theme {
    prog "Windows 95"           preferences-desktop-theme  sh -c 'echo "Theme=\"Windows-95\"" > ~/.icewm/theme; icewm -r'
    prog "Windows NT"           preferences-desktop-theme  sh -c 'echo "Theme=\"WindowsNT\"" > ~/.icewm/theme; icewm -r'
    prog "Windows 2000"         preferences-desktop-theme  sh -c 'echo "Theme=\"Win2kmod-xpm\"" > ~/.icewm/theme; icewm -r'
    prog "Windows 2000 (XP)"    preferences-desktop-theme  sh -c 'echo "Theme=\"Win2kmod-xpm-xp\"" > ~/.icewm/theme; icewm -r'
    prog "Win2k (mod colours)"  preferences-desktop-theme  sh -c 'echo "Theme=\"Win2kmod-xpm-modcolors\"" > ~/.icewm/theme; icewm -r'
    prog "Win2k (dark borders)" preferences-desktop-theme  sh -c 'echo "Theme=\"Win2kmod-xpm-dborders\"" > ~/.icewm/theme; icewm -r'
    prog "Win2k (original)"     preferences-desktop-theme  sh -c 'echo "Theme=\"Win2kmod-xpm-og\"" > ~/.icewm/theme; icewm -r'
  }
  menu "Focus" preferences-desktop {
    prog "Click to Focus"     preferences-desktop  sh -c 'sed -i /^FocusMode=/d ~/.icewm/prefoverride 2>/dev/null; echo FocusMode=1 >> ~/.icewm/prefoverride; icewm -r'
    prog "Sloppy Mouse Focus" preferences-desktop  sh -c 'sed -i /^FocusMode=/d ~/.icewm/prefoverride 2>/dev/null; echo FocusMode=2 >> ~/.icewm/prefoverride; icewm -r'
    prog "Explicit Focus"     preferences-desktop  sh -c 'sed -i /^FocusMode=/d ~/.icewm/prefoverride 2>/dev/null; echo FocusMode=3 >> ~/.icewm/prefoverride; icewm -r'
  }
  prog "Appearance"        preferences-desktop-theme  lxappearance
