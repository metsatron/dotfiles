# Redstone 9X — IceWM desktop right-click menu

menu "Programs" applications-system {
prog "File Manager"   folder   pcmanfm
prog "Snap Icons to Grid" preferences-desktop-theme redstone-9x-icons-grid
prog "xclass Explorer"  system-file-manager  redstone-9x-explorer
prog "Text Editor"    text-editor mousepad
prog "Web Browser"    firefox_2 firefox
prog "Music Player"   winamp    audacious
prog "Appearance"     preferences-desktop-theme lxappearance

menu "Rofi Tools" system-search {
  prog "Run command" system-search redstone-9x-rofi-run
  prog "Desktop apps" applications-system redstone-9x-rofi-desktop
  prog "PCManFM" system-file-manager pcmanfm
  prog "Application launcher" applications-system redstone-9x-rofi-launcher
  prog "Emoji" face-smile redstone-9x-rofi-emoji
  prog "Clipboard" edit-paste redstone-9x-rofi-clipboard
  prog "Local executables" system-run redstone-9x-rofi-local-bin
}

separator

menu "Accessories" accessories-text-editor {
  prog "Mousepad"      accessories-text-editor   mousepad
  prog "Paint"         gpaint                    gpaint
  prog "AbiWord"       abiword                   abiword
  prog "Calculator"    accessories-calculator   xterm -name redstone-calc -title "Calculator" -e tcalc
}

menu "Games" applications-games {
  prog "Minesweeper"    dsdmine            redstone-9x-dsdmine
  prog "Minesweeper (ice2k)" dsdmine       winmine
  prog "Solitaire"      gnome-aisleriot   sol
  prog "FreeCell"       gnome-aisleriot   sol --variation=freecell
  prog "GNU Backgammon" gnubg             gnubg
  prog "FreeCiv"        freeciv-client    freeciv-gtk3.22
  prog "CorsixTH"       corsix-th         corsix-th
  prog "OpenTTD"        openttd           openttd
  prog "OpenRCT2"       openrct2          openrct2
  prog "OpenRA"         net.openra.OpenRA            redstone-9x-openra
  prog "Micropolis"     com.donhopkins.Micropolis     redstone-9x-micropolis
  prog "Space Cadet Pinball" com.github.k4zmu2a.spacecadetpinball  redstone-9x-pinball
}

menuprog "Ports" applications-games /home/metsatron/.local/bin/ports-menu-gen icewm

menu "Multimedia" multimedia {
  prog "VLC"          vlc     redstone-9x-vlc
  prog "Music Player" winamp  audacious
}

separator

menu "Terminals" utilities-terminal {
  prog "Windows PowerShell"  utilities-terminal  bash /home/metsatron/.local/bin/redstone-9x-run xterm -class redstone-powershell -title PowerShell -geometry 80x25 -fa "Consolas" -fs 11 -bg "#012456" -fg "#EEEDF0" -cr "#EEEDF0" -e /home/metsatron/.local/bin/redstone-9x-pwsh
  prog "PowerShell (Bash)"   utilities-terminal  bash /home/metsatron/.local/bin/redstone-9x-run urxvt -name redstone-bash-powershell -title "Windows PowerShell" -geometry 80x25 +sb -bg rgb:01/24/56 -fg rgb:ee/ed/f0 -cr rgb:ee/ed/f0 -fn "xft:Cascadia Mono:size=11:antialias=true,xft:Consolas:size=11:antialias=true" -e bash
  prog "Command Prompt"      utilities-terminal  bash /home/metsatron/.local/bin/redstone-9x-run urxvt -hold -name redstone-bash-cmd -title "Command Prompt" -geometry 80x25 +sb -bg rgb:0c/0c/0c -fg rgb:cc/cc/cc -cr rgb:cc/cc/cc -fn "xft:Lucida Console:pixelsize=14:antialias=true" -e bash -lc 'exec wine cmd.exe'
  prog "Bash (CMD frame)"    utilities-terminal  bash /home/metsatron/.local/bin/redstone-9x-run urxvt -name redstone-bash-cmd -title "Command Prompt" -geometry 80x25 +sb -bg rgb:0c/0c/0c -fg rgb:cc/cc/cc -cr rgb:cc/cc/cc -fn "xft:Lucida Console:pixelsize=14:antialias=true" -e bash
  prog "URxVT"               utilities-terminal  bash /home/metsatron/.local/bin/redstone-9x-run urxvt -name redstone-plain-urxvt -title "URxVT" -geometry 80x25 +sb -bg rgb:00/00/00 -fg rgb:d6/d3/ce -cr rgb:d6/d3/ce -fn "xft:Courier New:size=11:antialias=true,xft:monospace:size=11:antialias=true"
  prog "XTerm"               utilities-terminal  bash /home/metsatron/.local/bin/redstone-9x-run xterm -title "XTerm" -geometry 80x25
}

menu "DOS Compatibility" ms-dos-prompt {
  prog "MS-DOS Prompt"  ms-dos-prompt  bash /home/metsatron/.local/bin/redstone-9x-run xterm -title "MS-DOS Prompt" -geometry 80x25 -fa "Perfect DOS VGA 437 Win" -fs 11 -bg black -fg "#c0c0c0" -e /home/metsatron/.local/bin/redstone-9x-dosemu2-shell
  prog "DOSBox-X"       ms-dos-prompt  /home/metsatron/.local/bin/redstone-9x-dosbox-x
}

menu "Wine" wine {
  menu "Accessories" wine {
    prog "Windows Explorer"   wine  redstone-9x-wine explorer
    prog "File Manager"       wine  redstone-9x-wine winefile
    prog "Notepad"            wine  redstone-9x-wine notepad
    prog "WordPad"            wine  redstone-9x-wine wordpad
    prog "Command Prompt"     wine  redstone-9x-wine cmd
    prog "Minesweeper (Wine)" wine  redstone-9x-wine winemine
    prog "Windows Help"       wine  redstone-9x-wine winhlp32
  }
  menu "Internet" wine {
    prog "Internet Explorer"  wine  redstone-9x-ie
  }
  prog "Control Panel"          wine  redstone-9x-wine control
  prog "Task Manager"           wine  redstone-9x-wine taskmgr
  prog "Registry Editor"        wine  redstone-9x-wine regedit
  prog "OLE/COM Object Viewer"  wine  redstone-9x-wine oleview
  separator
  prog "Configure Wine"         wine  redstone-9x-wine winecfg
  prog "Winetricks"             wine  redstone-9x-wine winetricks
  prog "Add/Remove Programs"    wine  redstone-9x-wine uninstall
  prog "Restart Wine (wineboot)" wine redstone-9x-wine wineboot
}
}

separator

prog "Documents" folder pcmanfm /home/metsatron/Documents

menu "Control Panel" preferences-system {
  prog "Device Manager"  preferences-system         devmgmt
  prog "System"          preferences-system         sysdmcpl
  prog "Display"         preferences-desktop-theme  deskcpl
}

menu "Settings" preferences-system {
  prog "Appearance" preferences-desktop-theme lxappearance
  prog "Desktop Preferences" preferences-desktop pcmanfm --desktop-pref
  prog "Snap Icons to Grid" preferences-desktop-theme redstone-9x-icons-grid
  prog "Reload Menu" icerun icewm --rewrite-menu
  prog "Restart IceWM" icerun icewm --restart
}

prog "Find..." system-search redstone-9x-rofi-desktop
prog "Help" help-browser xterm -title "Redstone 9X Help" -e man icewm
prog "About Windows" help-browser ice2kver

separator

prog "Run..." system-run redstone-9x-rofi-run
prog "Run (ice2k)..." system-run runbox

separator

menu "Shut Down..." system-shutdown {
  prog "Restart IceWM" icerun icewm --restart
  prog "Exit Redstone 9X" system-log-out icewm --shutdown
  prog "Shut Down (ice2k)" system-shutdown shutdlg
}
