# Redstone 9X — IceWM desktop right-click menu

prog "File Manager"   folder   pcmanfm

separator

menu "Terminals" utilities-terminal {
  prog "Windows PowerShell"  utilities-terminal  bash /home/metsatron/.local/bin/redstone-9x-run urxvt -name redstone-powershell -title "Windows PowerShell" -e pwsh
  prog "PowerShell (Bash)"   utilities-terminal  bash /home/metsatron/.local/bin/redstone-9x-run urxvt -name redstone-bash-powershell -title "Windows PowerShell" -e bash
  prog "Command Prompt"      utilities-terminal  bash /home/metsatron/.local/bin/redstone-9x-run wineconsole --backend=user cmd.exe
  prog "Bash (CMD frame)"    utilities-terminal  bash /home/metsatron/.local/bin/redstone-9x-run urxvt -name redstone-bash-cmd -title "Command Prompt" -e bash
  prog "URxVT"               utilities-terminal  bash /home/metsatron/.local/bin/redstone-9x-run urxvt -name redstone-plain-urxvt -title "URxVT"
}

menu "Wine Tools" wine {
  prog "Wine Configurator"   wine   wine64 winecfg
  prog "Registry Editor"     wine   wine64 regedit
  prog "Windows Explorer"    wine   wine64 explorer
  prog "Notepad"             wine   wine64 notepad
}

prog "DOSBox-X"  terminal  dosbox-x

separator

menu "System" folder {
  prog "Reload menu"    icerun   icewm --rewrite-menu
  prog "Restart IceWM"  icerun   icewm --restart
}
