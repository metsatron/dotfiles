# Redstone 9X — IceWM per-window options for the Rofi Win95 dialogs.
# Match on the Rofi window class (instance "rofi", class "Rofi").
Rofi.dTitleBar: 1
Rofi.dSysMenu: 1
Rofi.dClose: 1
Rofi.dBorder: 1
Rofi.dResize: 0
Rofi.dMaximize: 0
Rofi.dMinimize: 0
Rofi.dDepth: 0
Rofi.dRollup: 0
Rofi.fResize: 0
Rofi.fMaximize: 0
Rofi.fMinimize: 0

# Clippy — pin to its natural resting spot (captured 2026-08-08). This hint
# is a best-effort backstop only: Electron's BrowserWindow sets its own x/y
# after map and silently overrides it (confirmed live 2026-08-11). The real
# placement mechanism is redstone-9x-place, driven by the captured-position
# table in ~/.config/redstone-9x/placements.conf and launched by both the
# autostart hook and the menu entry through redstone-9x-clippy. Keep the table
# entry in sync with these backstop values if the ruling ever changes.
clippy.Clippy.startX: 1114
clippy.Clippy.startY: 330
