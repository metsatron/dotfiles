# Redstone 9X — IceWM per-window options for the Rofi Win95 dialogs.
# Match on the Rofi window class (instance "rofi", class "Rofi").
Rofi.dTitleBar: 1
Rofi.dSysMenu: 1
Rofi.dClose: 1
Rofi.dBorder: 1
Rofi.dResize: 0
Rofi.dMaximize: 0
Rofi.dMinimize: 0
Rofi.dDepth: 0
Rofi.dRollup: 0
Rofi.fResize: 0
Rofi.fMaximize: 0
Rofi.fMinimize: 0

# The patched room-local XOSD renderer is a managed desktop accessory with
# WM_CLASS instance "redstone-buildstamp", class "RedstoneBuildstamp".
# This exact class.instance match keeps the stamp above PCManFM's desktop but
# below ordinary windows, and excludes it from every interactive WM surface.
RedstoneBuildstamp.redstone-buildstamp.layer: Below
RedstoneBuildstamp.redstone-buildstamp.doNotFocus: 1
RedstoneBuildstamp.redstone-buildstamp.ignoreQuickSwitch: 1
RedstoneBuildstamp.redstone-buildstamp.ignoreTaskBar: 1
RedstoneBuildstamp.redstone-buildstamp.ignoreWinList: 1
RedstoneBuildstamp.redstone-buildstamp.ignorePagerPreview: 1
RedstoneBuildstamp.redstone-buildstamp.allWorkspaces: 1
RedstoneBuildstamp.redstone-buildstamp.dTitleBar: 0
RedstoneBuildstamp.redstone-buildstamp.dSysMenu: 0
RedstoneBuildstamp.redstone-buildstamp.dClose: 0
RedstoneBuildstamp.redstone-buildstamp.dBorder: 0
RedstoneBuildstamp.redstone-buildstamp.dResize: 0
RedstoneBuildstamp.redstone-buildstamp.dMaximize: 0
RedstoneBuildstamp.redstone-buildstamp.dMinimize: 0
RedstoneBuildstamp.redstone-buildstamp.dDepth: 0
RedstoneBuildstamp.redstone-buildstamp.dRollup: 0
RedstoneBuildstamp.redstone-buildstamp.fResize: 0
RedstoneBuildstamp.redstone-buildstamp.fMaximize: 0
RedstoneBuildstamp.redstone-buildstamp.fMinimize: 0
