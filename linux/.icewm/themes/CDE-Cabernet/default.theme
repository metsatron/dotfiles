# This theme is a modification of the Windows 2000 / ME theme
# by PixelOCDGuy (https://www.box-look.org/p/1648821). The icons were 
# sourced from the Chicago95 theme (https://github.com/grassmunk/Chicago95)
# The Tux Start button was sourced from screenshots of FVWM95.

ThemeDescription="Windows 98 Plus"
ThemeAuthor=bongo
Look="flat"

DesktopBackgroundColor="rgb:00/80/80"
TaskBarClockLeds=0
TrayDrawBevel=1
TaskbuttonIconOffset=5

TitleButtonsLeft="s"
TitleButtonsRight="xmi"
TitleButtonsSupported="xmis"
TitleBarHeight=18

TitleBarJoinRight=1

BorderSizeX=4
BorderSizeY=4
CornerSizeX=24
CornerSizeY=24
DlgBorderSizeX=3
DlgBorderSizeY=3

ColorNormalButton="rgb:B4/C3/DC"
ColorNormalButtonText="#000000"
ColorActiveButton="rgb:B4/C3/DC"
ColorActiveButtonText="#000000"

ColorNormalTitleBarText="#000080"
ColorActiveTitleBarText="#FFFFFF"
ColorActiveBorder="rgb:B4/C3/DC"
ColorNormalBorder="rgb:B4/C3/DC"
ColorNormalTitleBar="rgb:80/80/80"
ColorActiveTitleBar="rgb:00/00/80"

ColorDialog="rgb:B4/C3/DC"
ColorListBox="rgb:ff/ff/ff"
ColorListBoxText="rgb:00/00/00"
ColorListBoxSelection="rgb:00/00/80"
ColorListBoxSelectionText="rgb:ff/ff/ff"
ColorScrollBar="rgb:B4/C3/DC"
ColorScrollBarSlider="rgb:B4/C3/DC"
ColorScrollBarButton="rgb:B4/C3/DC"
ColorScrollBarButtonArrow="rgb:00/00/00"
ColorLabel="rgb:B4/C3/DC"
ColorLabelText="rgb:00/00/00"

ColorNormalMenu="rgb:B4/C3/DC"
ColorActiveMenuItem="#008080"
ColorNormalMenuItemText="#000000"
ColorActiveMenuItemText="#FFFFFF"
ColorDisabledMenuItemText="rgb:80/80/80"

ColorDefaultTaskBar="rgb:B4/C3/DC"
ColorNormalTaskBarApp="rgb:B4/C3/DC"
ColorNormalTaskBarAppText="#000000"
ColorActiveTaskBarApp="rgb:ea/e8/e4"
ColorActiveTaskBarAppText="rgb:00/00/00"
ColorMinimizedTaskBarApp="rgb:B4/C3/DC"
ColorMinimizedTaskBarAppText="#000000"

ColorInput="rgb:ff/ff/ff"
ColorInputText="rgb:00/00/00"
ColorClock="rgb:B4/C3/DC"
ColorClockText="#000000"

ColorToolTip="rgb:ff/ff/e1"
ColorToolTipText="rgb:00/00/00"
ColorMoveSizeStatus="rgb:B4/C3/DC"
ColorMoveSizeStatusText="rgb:00/00/00"
ColorQuickSwitch="rgb:B4/C3/DC"
ColorQuickSwitchText="rgb:00/00/00"

# Font Specification
# Please refer to the font instructions in the extras folder if you want
# a more authentic-looking font. Otherwise, modify the values below
# to a font of your choice.
TitleFontNameXft	   = 	"sans-serif:size=8:bold"
MenuFontNameXft	           =    "sans-serif:size=8"
MinimizedWindowFontNameXft =    "sans-serif:size=8"
ActiveButtonFontNameXft    =    "sans-serif:size=8"
NormalButtonFontNameXft    =    "sans-serif:size=8"
QuickSwitchFontNameXft     =    "sans-serif:size=8"
ListBoxFontNameXft         =    "sans-serif:size=8"
StatusFontNameXft          =    "sans-serif:size=8"
ToolTipFontNameXft         =    "sans-serif:size=8"
ActiveTaskBarFontNameXft   =    "sans-serif:size=8:bold"
NormalTaskBarFontNameXft   =    "sans-serif:size=8"
ClockFontNameXft           =    "sans-serif:size=10"
ApmFontNameXft             =    "sans-serif:size=8"
LabelFontNameXft             =    "sans-serif:size=8"


# ---- Windows 98 Plus (classic builder; meters in Task-Manager set) ----
ColorActiveTaskBarApp="rgb:EA/E8/E4"
ColorCPUStatusUser="rgb:00/A8/00"
ColorCPUStatusSystem="rgb:CC/00/00"
ColorCPUStatusIdle="rgb:00/00/00"
ColorMEMStatusUser="rgb:00/A8/00"
ColorMEMStatusBuffers="rgb:C4/A0/00"
ColorMEMStatusCached="rgb:80/00/80"
ColorMEMStatusFree="rgb:00/00/00"
ColorNetSend="rgb:CC/00/00"
ColorNetReceive="rgb:00/A8/00"
ColorNetIdle="rgb:00/00/00"

Gradients="titleAT.xpm titleIT.xpm titleAB.xpm titleIB.xpm"


# ==== CDE Motif chrome grafted over the Windows-98-Plus taskbar base ====
# Base swapped from nIceCDE (2026-07-20): nIceCDE's taskbar TILES the app-button
# pixmap into a repeating grid; the Windows base renders it clean. Window chrome
# + palette + serif fonts below restore the CDE look. Taskbar geometry untouched.
Look="flat"
TitleBarHeight=24
TitleBarJustify=50
BorderSizeX=6
BorderSizeY=6
DlgBorderSizeX=6
DlgBorderSizeY=6
TitleButtonsLeft="s"
TitleButtonsRight="mi"
TitleButtonsSupported="xmirs"
Gradients="menusel.xpm"
ColorActiveTitleBar="#d88775"
ColorNormalTitleBar="#3d564c"
ColorActiveTitleBarText="#000000"
ColorNormalTitleBarText="#ffffff"
ColorActiveBorder="#638a7a"
ColorNormalBorder="#638a7a"
ColorNormalButton="#638a7a"
ColorActiveButton="#d88775"
ColorNormalButtonText="#ffffff"
ColorActiveButtonText="#000000"
ColorNormalMenu="#638a7a"
ColorActiveMenuItem="#d88775"
ColorNormalMenuItemText="#ffffff"
ColorActiveMenuItemText="#000000"
ColorDefaultTaskBar="#638a7a"
ColorNormalTaskBarApp="#638a7a"
ColorActiveTaskBarApp="#d88775"
ColorNormalTaskBarAppText="#ffffff"
ColorActiveTaskBarAppText="#000000"
ColorMinimizedTaskBarApp="#638a7a"
ColorMinimizedTaskBarAppText="#ffffff"
ColorClock="#638a7a"
ColorClockText="#ffffff"
TitleFontNameXft="serif:size=10:bold"
MenuFontNameXft="serif:size=10"
NormalTaskBarFontNameXft="serif:size=12"
ActiveTaskBarFontNameXft="serif:size=12:bold"
ClockFontNameXft="serif:size=11"
DesktopBackgroundColor="#495c65"
DesktopBackgroundImage="~/.icewm/themes/CDE-Cabernet/backgrounds/Toronto.png"
DesktopBackgroundScaled=0
