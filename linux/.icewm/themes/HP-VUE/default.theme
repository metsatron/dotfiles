# PROOF OF CONCEPT — HP-UX VUE desktop scheme, forked from nIceCDE.Default.
# Original base: FMotif icewm theme by Alexander Voigt, adapted for CDE by
# Stéphane Lassalvy (LGPL-3). This fork hue-shifts the tan/orange CDE bevel
# palette toward HP VUE's muted plum/grey and stacks a double-height taskbar
# on top — see the accompanying HPUX-VUE-NOTES.md for the exact palette
# derivation and IceWM 4.0.0 taskbar-row feasibility findings.
ThemeDescripton = "HP-UX VUE proof-of-concept (nIceCDE.Default fork, plum/grey hue-shift, double-height taskbar)"
ThemeAuthor = "Stéphane Lassalvy + missTell (base FMotif/CDE); VUE PoC recolour by Redstone 9X"

Look = metal
Gradients="workspacebuttonbg.xpm workspacebuttonactive.xpm menusel.xpm"


TitleButtonsLeft="s"
TitleButtonsRight="mi"
TitleButtonsSupported="sxmihrd"
TitleBarJustify=50

# Active titlebar text: real Motif/CDE/VUE window headers put DARK text on a
# light-to-mid warm chrome (mwm/dtwm convention), not white-on-midtone —
# icewm's own default is white (ColorActiveTitleBarText="rgb:FF/FF/FF"), which
# read soft against this theme's #a385a3 plum body in the first headless PoC
# render. Darkening the text (rather than lightening the whole titlebar band)
# keeps the plum bevel palette derived from the CDE original intact and is
# the more period-accurate fix of the two.
ColorActiveTitleBarText = "#2b1f2d"

BorderSizeX = 6
BorderSizeY = 6
DlgBorderSizeX = 6
DlgBorderSizeY = 6
TitleBarHeight = 24
TitleBarJustify = 50
TitleButtonsSupported = "xmirs"
CornerSizeX = 6
CornerSizeY = 6
DlgBorderSizeX=6
DlgBorderSizeY=6
ShowMenuButtonIcon = 0
MenuIconSize = 22
CenterTransientsOnOwner=1
TaskBarShowTransientWindows=0

# --- HP-UX VUE PoC: two-row taskbar ---
# See HPUX-VUE-NOTES.md Phase 1 for the source evidence behind every one of
# these. Only TaskBarDoubleHeight and TaskBarWorkspacesTop actually move an
# applet between rows; everything else (clock, CPU/MEM/Net meters, windows
# button, menu button) is hardcoded per-row in IceWM 4.0.0's own
# src/wmtaskbar.cc and cannot be reassigned from prefs.
TaskBarDoubleHeight = 1
TaskBarWorkspacesTop = 1
TaskBarShowWorkspaces = 1
TaskBarShowShowDesktopButton = 2
TaskBarShowCPUStatus = 1
TaskBarShowMEMStatus = 1
TaskBarShowNetStatus = 1
TaskBarShowClock = 1
TaskBarShowWindows = 1
TaskBarEnableSystemTray = 1
TaskbarButtonWidthDivisor = 3

# Fonts
# Name of the title bar font.
#TitleFontName    = "-bitstream-*-medium-*-*-*-*-120-*-*-*-*-*-*"
TitleFontNameXft = "serif:size=12"

# Name of the menu font.
#MenuFontName    = "-bitstream-*-medium-*-*-*-*-80-*-*-*-*-*-*"
MenuFontNameXft = "serif:size=9"

# Name of the status display font.
#StatusFontName    = "-bitstream-*-medium-*-*-*-*-120-*-*-*-*-*-*"
StatusFontNameXft = "serif:size=12:italic"

# Name of the font for Alt+Tab switcher window.
#QuickSwitchFontName    = "-bitstream-*-bold-*-*-*-*-120-*-*-*-*-*-*"
QuickSwitchFontNameXft = "serif:size=12:bold"

# Name of the normal button font.
#NormalButtonFontName    = "-bitstream-*-medium-*-*-*-*-120-*-*-*-*-*-*"
NormalButtonFontNameXft = "serif:size=12"

# Name of the active button font.
#ActiveButtonFontName     = "-bitstream-*-medium-*-*-*-*-120-*-*-*-*-*-*"
ActiveButtonFontNameXft  = "sans:size=12"

# Name of the normal task bar item font.
#NormalTaskBarFontName     = "-bitstream-*-medium-*-*-*-*-120-*-*-*-*-*-*"
NormalTaskBarFontNameXft  = "serif:size=12"

# Name of the active task bar item font.
#ActiveTaskBarFontName    = "-bitstream-*-bold-*-*-*-*-120-*-*-*-*-*-*" 
ActiveTaskBarFontNameXft = "serif:size=12:bold"

# Name of the tool button font (fall
back: NormalButtonFontName).
#ToolButtonFontName    = "-bitstream-*-medium-*-*-*-*-120-*-*-*-*-*-*"
ToolButtonFontNameXft ="sans-serif:size=12"

# Name of the normal workspace button font (fallback: NormalButtonFontName).
#NormalWorkspaceFontName    = "-bitstream-*-medium-*-*-*-*-120-*-*-*-*-*-*"
NormalWorkspaceFontNameXft = "serif:size=12"

# Name of the active workspace button font (fallback: ActiveButtonFontName).
#ActiveWorkspaceFontName = "-bitstream-*-bold-*-*-*-*-120-*-*-*-*-*-*"
ActiveWorkspaceFontNameXft = "serif:size=12:bold"

# Name of the mini-window font.
#MinimizedWindowFontName    = "-bitstream-*-medium-*-*-*-*-120-*-*-*-*-*-*"
MinimizedWindowFontNameXft = "serif:size=12"

#Name of the window list font.
#ListBoxFontName    = "-bitstream-*-medium-*-*-*-*-120-*-*-*-*-*-*"
ListBoxFontNameXft = "serif:size=12"

#Name of the tool tip font.
#ToolTipFontName    = "-bitstream-*-medium-*-*-*-*-120-*-*-*-*-*-*"
ToolTipFontNameXft = "serif:size=10"

#Name of the task bar clock font.
#ClockFontName   = "-bitstream-*-medium-*-*-*-*-140-*-*-*-*-*-*"
ClockFontNameXft = "serif:size=12"

#Name of the task bar temperature font.
#TempFontName    = "-bitstream-*-medium-*-*-*-*-140-*-*-*-*-*-*"
TempFontNameXft = "serif:size=12"

#Name of the task bar battery font.
#ApmFontName    = "-bitstream-*-medium-*-*-*-*-140-*-*-*-*-*-*"
ApmFontNameXft = "monospace:size=12"

#Name of the input field font.
#InputFontName    = "-bitstream-*-medium-*-*-*-*-140-*-*-*-*-*-*"
InputFontNameXft = "serif:size=12"

# Labels
#LabelFontName    = "-bitstream-*-medium-*-*-*-*-140-*-*-*-*-*-*"
LabelFontNameXft = "serif:size=12"

#Place new mini-icons from bottom to top
MiniIconsBottomToTop = 1

# Colors — HP-UX VUE PoC palette (hue-shifted from CDE tan/orange to plum/
# grey; derivation: same lightness+saturation, hue rotated to ~300°, see
# HPUX-VUE-NOTES.md). Body plum #a385a3, highlight #d2c6d2, shadow #604360
# mirror the bevel pixmaps recoloured with the same three swaps.
# Workspace
ColorNormalWorkspaceButton        = "#b988b9"
ColorNormalWorkspaceButtonText    = "#000000"
ColorActiveWorkspaceButton        = "#806580"
ColorActiveWorkspaceButtonText    = "#ffffff"

# Taskbar
ColorDefaultTaskBar               = "#beaabe"
ColorNormalTaskBarApp             = "#beaabe"
ColorActiveTaskBarApp             = "#806580"
ColorActiveTaskBarAppText         = "#ffffff"
ColorMinimizedTaskBarApp          = "#beaabe"
ColorInvisibleTaskBarApp          = "#beaabe"

# Buttons
ColorToolButton                   = "#beaabe"

ColorNormalButton                 = "#beaabe"
ColorNormalButtonText             = "#000000"
ColorActiveButton                 = "#a385a3"
ColorActiveButtonText             = "#000000"

# Dialog boxes
ColorDialog                       = "beaabe"

# Menu
ColorNormalMenu                   = "#beaabe"
ColorActiveMenuItem               = "#a385a3"
ColorNormalMenuItemText           = "#000000"
ColorActiveMenuItemText           = "#ffffff"

# Tarkbar justification
TaskBarJustify="center"

# Bitmask of buttons that raise the window when pressedButtonRaiseMask=1 # [0-255]

# Background centered
DesktopBackgroundCenter = 0
my_ice_ux/background/
# Background scaled
DesktopBackgroundScaled = 0

# Background Tiled
DesktopBackgroundTiled = 1

# Choose background
DesktopBackgroundImage = ""
DesktopBackgroundColor = ""

# Taskbar height
TrayIconMaxHeight = 32

# Width of APM Monitor
TaskBarApmGraphWidth = 60 # [1-1000]

# Height of taskbar monitoring applets — this is THE lever for the top row's
# height, not a coincidence: YClock::autoSize() (src/aclock.cc:131) calls
# setSize(maxWidth, taskBarGraphHeight) for the digital clock, and the CPU/
# MEM/Net graphs each call setSize(N, taskBarGraphHeight) too (acpustatus.cc,
# amemstatus.cc, apppstatus.cc). Every one of these widgets is hardcoded to
# the TOP row in TaskBar::updateLayout() (src/wmtaskbar.cc), so a single
# global TaskBarGraphHeight drives the top row's content height directly —
# TaskBarDoubleHeight's h[1] becomes max(clock, CPU, MEM, Net heights) which
# all equal this value. Set to 80 for Mètsàtron's target top-row height (see
# HPUX-VUE-NOTES.md for the measured render that confirms this).
TaskBarGraphHeight = 80 # [16-1000]

# Bottom row (32px target) has no equivalent single global lever — nothing
# else on that row is driven by a shared pref. It is set instead by padding
# the Start button's own pixmap: YButton::updateSize() (src/ybutton.cc:361-
# 378) sizes an ObjectButton to `image.height() + 3 + 2 - LOOK(lookMetal|
# lookFlat)`, i.e. +4 for this theme's Look=metal. menu-buttons/hp-vue/
# start.png is 108×28 (25px real art + 3px padding) so the button widget
# lands at exactly 32px tall. The window-list/task-pane buttons on this row
# floor out lower (YIcon::smallSize()+8 = 24, from wmtaskbar.cc) so they
# never override this.
#
# TaskBarWidthPercentage / TaskBarJustify / EnableAddressBar are deliberately
# NOT set here even though src/wmtaskbar.cc (lines 562, 723-730) and
# src/wmtaskbar.cc:376 prove all three exist and apply in double-height mode.
# Empirically (headless :97 render, both with and without these three lines
# present in this file) they are silently ignored when set in the THEME
# file — TaskBarGraphHeight/TaskBarDoubleHeight/TaskBarWorkspacesTop above
# DO take effect from here, these three do not. They only took effect once
# moved into the live preferences file, which is exactly where this scheme's
# ICEWM_PREFS (sanctuary-redstone-9x-schemes.org) already carries them via
# the normal scheme-apply pipeline — nothing else to do, just don't
# duplicate them here where they're dead weight.

# Clock
ColorClock     = "#beaabe"
ColorClockText = "#000000"

#CPU
ColorCPUStatusUser   = "#beaabe"
ColorCPUStatusSystem = "#beaabe"

# Tooltips
ColorToolTip     = "#b988b9"
ColorToolTipText = "#000000"

# Labels
ColorLabel              = "#beaabe"
ColorLabelText          = "#000000"

# Keyboard layout
ColorKeyboardLayoutText = “#000000”
