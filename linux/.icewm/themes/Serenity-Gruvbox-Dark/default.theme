# This theme is a modification of the Windows 2000 / ME theme
# by PixelOCDGuy (https://www.box-look.org/p/1648821). The icons were 
# sourced from the Chicago95 theme (https://github.com/grassmunk/Chicago95)
# The Tux Start button was sourced from screenshots of FVWM95.

ThemeDescription="Serenity Gruvbox Dark"
ThemeAuthor=bongo
Look="flat"

DesktopBackgroundColor="rgb:00/80/80"
TaskBarClockLeds=1
TrayDrawBevel=1
TaskbuttonIconOffset=5

TitleButtonsLeft="s"
TitleButtonsRight="xmi"
TitleButtonsSupported="xmis"
TitleBarHeight=18

TitleBarJoinRight=1

BorderSizeX=4
BorderSizeY=4
CornerSizeX=24
CornerSizeY=24
DlgBorderSizeX=3
DlgBorderSizeY=3

ColorNormalButton="rgb:32/30/2F"
ColorNormalButtonText="#EBDBB2"
ColorActiveButton="rgb:32/30/2F"
ColorActiveButtonText="#EBDBB2"

ColorNormalTitleBarText="#BDAE93"
ColorActiveTitleBarText="#EBDBB2"
ColorActiveBorder="rgb:32/30/2F"
ColorNormalBorder="rgb:32/30/2F"
ColorNormalTitleBar="rgb:80/80/80"
ColorActiveTitleBar="rgb:00/00/80"

ColorDialog="rgb:32/30/2F"
ColorListBox="rgb:ff/ff/ff"
ColorListBoxText="rgb:00/00/00"
ColorListBoxSelection="rgb:00/00/80"
ColorListBoxSelectionText="rgb:ff/ff/ff"
ColorScrollBar="rgb:32/30/2F"
ColorScrollBarSlider="rgb:32/30/2F"
ColorScrollBarButton="rgb:32/30/2F"
ColorScrollBarButtonArrow="rgb:00/00/00"
ColorLabel="rgb:32/30/2F"
ColorLabelText="rgb:00/00/00"

ColorNormalMenu="rgb:32/30/2F"
ColorActiveMenuItem="#98971A"
ColorNormalMenuItemText="#EBDBB2"
ColorActiveMenuItemText="#282828"
ColorDisabledMenuItemText="rgb:80/80/80"

ColorDefaultTaskBar="rgb:32/30/2F"
ColorNormalTaskBarApp="rgb:32/30/2F"
ColorNormalTaskBarAppText="#EBDBB2"
ColorActiveTaskBarApp="rgb:ea/e8/e4"
ColorActiveTaskBarAppText="rgb:00/00/00"
ColorMinimizedTaskBarApp="rgb:32/30/2F"
ColorMinimizedTaskBarAppText="rgb:00/00/00"

ColorInput="rgb:ff/ff/ff"
ColorInputText="rgb:00/00/00"
ColorClock="rgb:32/30/2F"
ColorClockText="#EBDBB2"

ColorToolTip="rgb:ff/ff/e1"
ColorToolTipText="rgb:00/00/00"
ColorMoveSizeStatus="rgb:32/30/2F"
ColorMoveSizeStatusText="rgb:00/00/00"
ColorQuickSwitch="rgb:32/30/2F"
ColorQuickSwitchText="rgb:00/00/00"

# Font Specification
# Please refer to the font instructions in the extras folder if you want
# a more authentic-looking font. Otherwise, modify the values below
# to a font of your choice.
TitleFontNameXft	   = 	"sans-serif:size=8:bold"
MenuFontNameXft	           =    "sans-serif:size=8"
MinimizedWindowFontNameXft =    "sans-serif:size=8"
ActiveButtonFontNameXft    =    "sans-serif:size=8"
NormalButtonFontNameXft    =    "sans-serif:size=8"
QuickSwitchFontNameXft     =    "sans-serif:size=8"
ListBoxFontNameXft         =    "sans-serif:size=8"
StatusFontNameXft          =    "sans-serif:size=8"
ToolTipFontNameXft         =    "sans-serif:size=8"
ActiveTaskBarFontNameXft   =    "sans-serif:size=8:bold"
NormalTaskBarFontNameXft   =    "sans-serif:size=8"
ClockFontNameXft           =    "sans-serif:size=8"
ApmFontNameXft             =    "sans-serif:size=8"
LabelFontNameXft             =    "sans-serif:size=8"


# ---- Serenity Gruvbox Dark (classic builder; meters in Task-Manager set) ----
ColorActiveTaskBarApp="rgb:EA/E8/E4"
ColorCPUStatusUser="rgb:00/A8/00"
ColorCPUStatusSystem="rgb:CC/00/00"
ColorCPUStatusIdle="rgb:00/00/00"
ColorMEMStatusUser="rgb:00/A8/00"
ColorMEMStatusBuffers="rgb:C4/A0/00"
ColorMEMStatusCached="rgb:80/00/80"
ColorMEMStatusFree="rgb:00/00/00"
ColorNetSend="rgb:CC/00/00"
ColorNetReceive="rgb:00/A8/00"
ColorNetIdle="rgb:00/00/00"

Gradients="titleAT.xpm titleIT.xpm titleAB.xpm titleIB.xpm"
