# My favourite OS theme ever is Serenity.
# This was later used by Microsoft for Windows ME as well. AFAIK, the only difference is WinME
# didn't support shadows or fading. It used the Win98 "scroll" effect by default.
# Finally, it was used as the base for "Windows Classic" theme in Windows XP.
# There were some minor diffences, the Start Menu button size/icon come to mind.
# Windows Vista/7 had a inaccurate implementation that was a "Software Rendered" port
# however, it didn't use the native engine like XP did so was slower.


ThemeDescription="Serenity / ME"
ThemeAuthor="PixelOCDGuy, modified by tf and enfaun"
Look="flat"
TaskbuttonIconOffset=6

#DesktopBackgroundColor="#3a/6e/a5"
TaskBarClockLeds=0
TrayDrawBevel=1

TitleButtonsLeft="s"
TitleButtonsRight="xmi"
TitleButtonsSupported="xmis"
TitleBarHeight=19
Gradients="titleAB.xpm titleAT.xpm titleIB.xpm titleIT.xpm separator.xpm buttonI.xpm buttonA.xpm switchbg.xpm dialogbg.xpm"
TitleBarJoinRight=1

BorderSizeX=4
BorderSizeY=4
CornerSizeX=4
CornerSizeY=4
DlgBorderSizeX=3
DlgBorderSizeY=3

ColorNormalButton="#d4d0c8"
ColorNormalButtonText="#000000"
ColorActiveButton="#d4d0c8"
ColorActiveButtonText="#000000"

ColorNormalTitleBarText="rgb:D5/D0/C7"
ColorActiveTitleBarText="rgb:FF/FF/FF"
ColorActiveBorder="#d4d0c8"
ColorInactiveBorder="#d4d0c8"
ColorNormalBorder="#d4d0c8"

ColorDialog="#d4d0c8"
ColorListBox="rgb:FF/FF/FF"
ColorListBoxText="rgb:00/00/00"
ColorListBoxSelection="rgb:84/35/1A"
ColorListBoxSelectionText="rgb:FF/FF/FF"
ColorScrollBar="#d4d0c8"
ColorScrollBarSlider="#d4d0c8"
ColorScrollBarButton="#d4d0c8"
ColorScrollBarButtonArrow="#000000"
ColorLabel="#d4d0c8"
ColorLabelText="#000000"

ColorNormalMenu="rgb:D4/D0/C8"
ColorActiveMenuItem="rgb:D2/C0/B6"
ColorNormalMenuItemText="rgb:00/00/00"
ColorActiveMenuItemText="rgb:00/00/00"
ColorDisabledMenuItemText="rgb:80/80/80"

ColorDefaultTaskBar="#d4d0c8"
ColorNormalTaskBarApp="#d4d0c8"
ColorNormalTaskBarAppText="#000000"
ColorActiveTaskBarApp="rgb:EA/E8/E4"
ColorActiveTaskBarAppText="#000000"
ColorMinimizedTaskBarApp="#d4d0c8"
ColorMinimizedTaskBarAppText="#000000"

ColorInput="rgb:FF/FF/FF"
ColorInputText="rgb:00/00/00"
ColorClock="#d4d0c8"
ColorClockText="#000000"

ColorToolTip="rgb:FF/FF/E1"
ColorToolTipText="rgb:00/00/00"
ColorMoveSizeStatus="#d4d0c8"
ColorMoveSizeStatusText="#000000"
ColorQuickSwitch="#d4d0c8"
ColorQuickSwitchText="#000000"
ColorQuickSwitchActive="rgb:84/35/1A"

ColorActiveWorkspaceButton="rgb:84/35/1A"
ColorActiveWorkspaceButtonText="#ffffff"

#PreferFreetypeFonts=1

# Font Specification
TitleFontNameXft	   =	"Tahoma:size=8:bold"
MenuFontNameXft	           =    "tahoma:size=8"
MinimizedWindowFontNameXft =    "tahoma:size=8"
ActiveButtonFontNameXft    =    "tahoma:size=8"
NormalButtonFontNameXft    =    "tahoma:size=8"
QuickSwitchFontNameXft     =    "tahoma:size=8:bold"
ListBoxFontNameXft         =    "tahoma:size=8"
StatusFontNameXft          =    "tahoma:size=8"
ToolTipFontNameXft         =    "tahoma:size=8"
ActiveTaskBarFontNameXft   =    "tahoma:size=8:bold"
NormalTaskBarFontNameXft   =    "tahoma:size=8"
ClockFontNameXft           =    "tahoma:size=8"
ApmFontNameXft             =    "tahoma:size=8"
LabelFontNameXft	   =    "tahoma:size=8"
NormalWorkspaceFontNameXft =    "tahoma:size=8"
ActiveWorkspaceFontNameXft =    "tahoma:size=8:bold"

TitleFontName		=	"-*-tahoma-bold-r-*-*-11-*-*-*-*-*-*-*"
MenuFontName		=	"-*-tahoma-medium-r-*-*-11-*-*-*-*-*-*-*"
MinimizedWindowFontName	=	"-*-tahoma-medium-r-*-*-11-*-*-*-*-*-*-*"
ActiveButtonFontName	=	"-*-tahoma-medium-r-*-*-11-*-*-*-*-*-*-*"
NormalButtonFontName	=	"-*-tahoma-medium-r-*-*-11-*-*-*-*-*-*-*"
QuickSwitchFontName	=	"-*-tahoma-bold-r-*-*-11-*-*-*-*-*-*-*"
ListBoxFontName		=	"-*-tahoma-medium-r-*-*-11-*-*-*-*-*-*-*"
StatusFontName		=	"-*-tahoma-medium-r-*-*-11-*-*-*-*-*-*-*"
ToolTipFontName		=	"-*-tahoma-medium-r-*-*-11-*-*-*-*-*-*-*"
ActiveTaskBarFontName	=	"-*-tahoma-bold-r-*-*-11-*-*-*-*-*-*-*"
NormalTaskBarFontName	=	"-*-tahoma-medium-r-*-*-11-*-*-*-*-*-*-*"
ClockFontName		=	"-*-tahoma-medium-r-*-*-11-*-*-*-*-*-*-*"
ApmFontName		=	"-*-tahoma-medium-r-*-*-11-*-*-*-*-*-*-*"
LabelFontName		=	"-*-tahoma-medium-r-*-*-11-*-*-*-*-*-*-*"
NormalWorkspaceFontName	=	"-*-tahoma-medium-r-*-*-11-*-*-*-*-*-*-*"
ActiveWorkspaceFontName	=	"-*-tahoma-bold-r-*-*-11-*-*-*-*-*-*-*"

#TitleFontName		=	"-cronyx-helvetica-bold-r-normal-*-11-80-100-100-p-46-iso10646-1"
#MenuFontName		=	"-cronyx-helvetica-medium-r-normal-*-11-80-100-100-p-46-iso10646-1"
#MinimizedWindowFontName	=	"-cronyx-helvetica-medium-r-normal-*-11-80-100-100-p-46-iso10646-1"
#ActiveButtonFontName	=	"-cronyx-helvetica-medium-r-normal-*-11-80-100-100-p-46-iso10646-1"
#NormalButtonFontName	=	"-cronyx-helvetica-medium-r-normal-*-11-80-100-100-p-46-iso10646-1"
#QuickSwitchFontName	=	"-cronyx-helvetica-medium-r-normal-*-11-80-100-100-p-46-iso10646-1"
#ListBoxFontName		=	"-cronyx-helvetica-medium-r-normal-*-11-80-100-100-p-46-iso10646-1"
#StatusFontName		=	"-cronyx-helvetica-medium-r-normal-*-11-80-100-100-p-46-iso10646-1"
#ToolTipFontName		=	"-cronyx-helvetica-medium-r-normal-*-11-80-100-100-p-46-iso10646-1"
#ActiveTaskBarFontName	=	"-cronyx-helvetica-medium-r-normal-*-11-80-100-100-p-46-iso10646-1"
#NormalTaskBarFontName	=	"-cronyx-helvetica-medium-r-normal-*-11-80-100-100-p-46-iso10646-1"
#ClockFontName		=	"-cronyx-helvetica-medium-r-normal-*-11-80-100-100-p-46-iso10646-1"
#ApmFontName		=	"-cronyx-helvetica-medium-r-normal-*-11-80-100-100-p-46-iso10646-1"
#LabelFontName		=	"-cronyx-helvetica-medium-r-normal-*-11-80-100-100-p-46-iso10646-1"
#NormalWorkspaceFontName	=	"-cronyx-helvetica-medium-r-normal-*-11-80-100-100-p-46-iso10646-1"
#ActiveWorkspaceFontName	=	"-cronyx-helvetica-medium-r-normal-*-11-80-100-100-p-46-iso10646-1"


MenuButtonIconVertOffset=-1

#[taskbar]
#TaskBarHeight=1
#TaskBarEdgeTop=5
#TaskBarEdgeBottom=5

TitleBarHorzOffset=1
TitleBarVertOffset=0

ColorActiveTitleBar="rgb:6E/22/09"
ColorNormalTitleBar="rgb:80/80/80"
# ---- SerenityOS taskbar identity (Mètsàtron 2026-07-19) ----
# COLOURS ONLY — themes cannot flip TaskBarShow* toggles (verified live);
# the layout switches ride the scheme's ICEWM_PREFS via scheme-apply's
# managed prefoverride block. System-Monitor greens on a black well.
ColorCPUStatusUser="rgb:3E/9A/06"
ColorCPUStatusSystem="rgb:CC/00/00"
ColorCPUStatusInterrupts="rgb:C4/A0/00"
ColorCPUStatusIoWait="rgb:34/65/A4"
ColorCPUStatusSoftIrq="rgb:75/50/7B"
ColorCPUStatusIdle="rgb:00/00/00"
# Clock: no bevel preference exists in IceWM 4.0 (per-applet bevels need an
# icewm patch — future item); a slightly darker well approximates the inset.
ColorClock="rgb:C9/C5/BD"
ColorClockText="rgb:00/00/00"
ColorMEMStatusUser="rgb:3E/9A/06"
ColorMEMStatusBuffers="rgb:C4/A0/00"
ColorMEMStatusCached="rgb:75/50/7B"
ColorMEMStatusFree="rgb:00/00/00"
ColorNetSend="rgb:CC/00/00"
ColorNetReceive="rgb:3E/9A/06"
ColorNetIdle="rgb:00/00/00"
