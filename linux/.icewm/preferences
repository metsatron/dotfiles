Theme="WindowsNT/default.theme"

# ── Taskbar: authentic Windows 95/2000 layout (ice2k convention) ──
# A real Win9x taskbar is only  Start | quick-launch | task buttons | tray |
# clock.  IceWM's Linux system-monitor applets (CPU / MEM / Net / APM graphs),
# the workspace pager and the show-desktop button were the "non-conforming"
# widgets — all switched OFF here.  Workspaces still work by keybind; only the
# pager buttons leave the taskbar.
ShowTaskBar=1
TaskBarAtTop=0
TaskBarShowClock=1
TaskBarShowWindows=1
TaskBarShowWindowIcons=1
TaskBarShowWorkspaces=0
TaskBarShowShowDesktopButton=1
TaskBarShowCPUStatus=0
TaskBarShowMEMStatus=0
TaskBarShowNetStatus=0
TaskBarShowAPMStatus=0
TaskBarShowAPMAuto=0
TaskBarShowAPMGraph=0
TaskBarShowMailboxStatus=0
TaskBarDoubleHeight=0
TaskbarButtonWidthDivisor=9
TaskBarShowWindowListMenu=0
TaskBarShowCollapseButton=0

# ── System tray: enabled, sized to the Win9x tray (ice2k values) ──
TaskBarShowTray=1
TaskBarEnableSystemTray=1
TrayIconMaxWidth=20
TrayIconMaxHeight=20
TrayDrawBevel=1

# ── Suppress IceWM's built-in appended Start-menu items ──
# Without these, IceWM appends its OWN "Settings", "Windows" (window list) and
# "Logout" entries beneath our menu — that is the duplicate-Settings /
# stray-Logout / stray-Windows seen in the wild.  ice2k disables every one and
# hand-builds the whole menu; so do we (see ~/.icewm/menu).  This is what makes
# the Start menu read exactly:
#   Programs / Documents / Settings / Find / Help / Run... / Shut Down...
ShowProgramsMenu=0
ShowSettingsMenu=0
ShowFocusModeMenu=0
ShowThemesMenu=0
ShowLogoutMenu=0
ShowLogoutSubMenu=0
ShowHelp=0
ShowAbout=0
ShowRun=0
ShowWindowList=0

# Icon sizing for the Windows NT theme pixmaps
MenuIconSize=16
ShowMenuButtonIcon=1

# Mouse-driven menu tracking (Windows 9x convention)
MenuMouseTracking=1

# Clock: authentic Windows 95 "h:mm AM/PM" tray clock (hover = full date).
TimeFormat=" %l:%M %p "
