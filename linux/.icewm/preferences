Theme="WindowsNT/default.theme"

# Taskbar, tray, status widgets, and icon sizing for the Redstone profile.
ShowTaskBar=1
TaskBarAtTop=0
TaskBarShowClock=1
TaskBarShowWorkspaces=1
TaskBarShowWindows=1
TaskBarShowShowDesktopButton=1
TaskBarShowTray=1
TaskBarEnableSystemTray=1
TrayShowAllWindows=1
TaskBarShowCPUStatus=1
CPUStatusShowRamUsage=1
CPUStatusShowSwapUsage=1
CPUStatusShowAcpiTemp=1
CPUStatusShowCpuFreq=1
TaskBarShowMEMStatus=1
TaskBarShowNetStatus=1
NetStatusShowOnlyRunning=1
NetworkStatusDevice="eth0"
TaskBarShowAPMAuto=1
TaskBarShowAPMTime=1
TaskBarShowAPMGraph=1
TaskBarDoubleHeight=0
TaskBarCPUSamples=20
TaskBarMEMSamples=20
TaskBarNetSamples=20
TaskbarButtonWidthDivisor=3

# Taskbar and icon sizing required by the Windows NT theme pixmaps
TaskBarGraphHeight=27
TrayIconMaxHeight=16
MenuIconSize=16

# Mouse-driven menu tracking (Windows 9x convention)
MenuMouseTracking=1

# Time format matches Windows 95 clock appearance; hover for full date
TimeFormat="%d.%m %R"

# Suppress only the taskbar controls that clash with the Win95 layout.
TaskBarShowWindowListMenu=0
TaskBarShowCollapseButton=0
