Theme="Windows-95/default.theme"

# Taskbar and icon sizing required by Windows-95 theme pixmaps
TaskBarGraphHeight=27
TrayIconMaxHeight=16
MenuIconSize=16

# Mouse-driven menu tracking (Windows 9x convention)
MenuMouseTracking=1

# Time format matches Windows 95 clock appearance; hover for full date
TimeFormat="%d.%m %R"

# Suppress taskbar elements absent from Windows 95 stock layout
TaskBarShowWindowListMenu=0
TaskBarShowWorkspaces=0
TaskBarShowCollapseButton=0
