#!/bin/sh


# IceWM startup hook.  Runs after =icewm-session= initialises the WM.  Starts
# =pcmanfm= in desktop mode which draws Win95-style desktop icons from =~/Desktop/=.


# [[file:../../sanctuary-redstone-9x-desktop.org::*Dynamic menus — recent Documents + Desktop folder][Dynamic menus — recent Documents + Desktop folder:14]]
# Redstone 9X — Win95 desktop manager
if command -v xrdb >/dev/null 2>&1; then
  xrdb -merge /home/metsatron/DotCortex/linux/.config/redstone-9x/Xresources \
    2>/dev/null || true
fi
mkdir -p "${HOME}/Desktop" "${HOME}/.cache/redstone-9x"
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-LXDE}"
export GDK_BACKEND="${GDK_BACKEND:-x11}"
pcmanfm --desktop >"${HOME}/.cache/redstone-9x/pcmanfm-desktop.log" 2>&1 &

# IceWM GUI-event sounds — icesound (ships in our IceWM 4.0 build, AO backend
# with a libao pulse plugin, verified 2026-07-19). Sample dir rides the active
# sound scheme: ~/.local/share/sounds/sanctuary/icewm/ (the sanctuary symlink
# retargets per scheme; scheme-apply restarts icesound on switch). Recognised
# filenames: startup shutdown restart launchApp workspaceChange windowOpen
# windowClose dialogOpen dialogClose windowMax windowMin windowRestore
# windowRollup windowMoved windowSized windowLower windowHide (.wav each).
ICEWM_SOUNDS="${HOME}/.local/share/sounds/sanctuary/icewm"
if command -v icesound >/dev/null 2>&1 \
  && [ -n "$(ls "${ICEWM_SOUNDS}"/*.wav 2>/dev/null)" ] \
  && ! pgrep -xu "$(id -u)" icesound >/dev/null 2>&1; then
  icesound --interface=AO --sample-dir="${ICEWM_SOUNDS}" \
    >"${HOME}/.cache/redstone-9x/icesound.log" 2>&1 &
fi

# Startup chime — the desktop is coming up, which is exactly when Win95 played
# it. When the scheme ships icewm/startup.wav, icesound owns the boot chime
# and this hook yields (no double-play); otherwise sanctuary-sound covers it.
# User-supplied media in ~/.local/share/sounds/sanctuary/; silent no-op when
# absent (see sanctuary-distrobox.org "Sanctuary system sounds").
if command -v sanctuary-sound >/dev/null 2>&1 \
  && [ ! -f "${ICEWM_SOUNDS}/startup.wav" ]; then
  sanctuary-sound startup >"${HOME}/.cache/redstone-9x/sanctuary-sound.log" 2>&1 &
fi

# XSETTINGS manager — lets redstone-9x-scheme-apply restyle RUNNING GTK3 apps
# (theme/icons/cursor/font) with a SIGHUP instead of requiring relaunches.
# Config is written by scheme-apply before the session starts (--boot mode).
if command -v xsettingsd >/dev/null 2>&1 \
  && [ -f "${HOME}/.config/xsettingsd/xsettingsd.conf" ] \
  && ! pgrep -xu "$(id -u)" xsettingsd >/dev/null 2>&1; then
  xsettingsd >"${HOME}/.cache/redstone-9x/xsettingsd.log" 2>&1 &
fi

# Clipboard history daemon for the Rofi Shortcuts menu.
if command -v clipmenud >/dev/null 2>&1 \
  && ! pgrep -xu "$(id -u)" clipmenud >/dev/null 2>&1; then
  clipmenud >"${HOME}/.cache/redstone-9x/clipmenud.log" 2>&1 &
fi

# Tray inhabitants: start only when available and not already running.
# PCManFM remains the desktop/background owner; these only occupy IceWM's tray.
if command -v nm-applet >/dev/null 2>&1 \
  && pgrep -x NetworkManager >/dev/null 2>&1 \
  && ! pgrep -xu "$(id -u)" nm-applet >/dev/null 2>&1; then
  nm-applet >"${HOME}/.cache/redstone-9x/nm-applet.log" 2>&1 &
fi

if command -v pnmixer >/dev/null 2>&1 \
  && ! pgrep -xu "$(id -u)" pnmixer >/dev/null 2>&1; then
  pnmixer >"${HOME}/.cache/redstone-9x/pnmixer.log" 2>&1 &
fi

# Recycle Bin icon state watcher: the static ~/Desktop/recycle-bin.desktop
# launcher has no dynamic full/empty state on its own (GVFS's native trash
# object would give us that for free, but room-gaming has no gvfs — a
# 2026-07-07 retry of plain gvfs leaked the HOST's real Trash contents into
# the sandboxed room via distrobox's /run/host bind mount — see
# redstone-9x-state-digest.md). Poll the on-disk Trash folder instead and
# rewrite Icon= directly; no new package required.
if [ -x "${HOME}/.local/bin/redstone-9x-recycle-bin-watch" ] \
  && ! pgrep -fu "$(id -u)" "redstone-9x-recycle-bin-watch" >/dev/null 2>&1; then
  "${HOME}/.local/bin/redstone-9x-recycle-bin-watch" \
    >"${HOME}/.cache/redstone-9x/recycle-bin-watch.log" 2>&1 &
fi
# Dynamic menus — recent Documents + Desktop folder:14 ends here
