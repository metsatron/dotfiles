.directory
.vorg.db

# editor backups and accidental backup files
*~
*.orig
*.rej
*.swp
*.swo
*.bak
*.bak2
*.bak.*
.nvimlog

# generated cache files (sublime-text, editor caches, etc.)
*.cache
__pycache__/
*.pyc
*.pyo
all/.spacemacs.d.claude/.cache/

# Mutable package-manager homes must stay in $HOME, not DotCortex
all/.cargo/
all/.bun/
all/.bunx/
all/.zplug/

# Emacs build/package caches
all/.emacs.d/eln-cache/
all/.emacs.d/elpa/
all/.config/emacs/.local/
all/.emacs.profiles/**/.cache/
all/.emacs.profiles/**/.spacemacs.d.claude/.cache/
.eask/

# Desktop icon caches and temp files
*.icon-theme.cache
*/icon-theme.cache

# Goneovim sessions
linux/.config/goneovim/sessions/

# Local app caches that should not be canon
linux/.qmmp/playlist.txt
linux/.qmmp/cache/
linux/.themes/**/CdePanel/cache/
.#*
#*#
*~
.#*
#*#
*~

# Fonts Cache
*.uuid

# OpenCode runtime state
.opencode/opencode.db
# Written by herdr through the stow symlink, overwritten on every integration
# update. Tool-managed, no .org source — never commit it.
all/.config/opencode/plugins/herdr-agent-state.js

# Claude runtime state
.claude/stop_count
all/.claude/stop_count
all/.claude/settings.json
all/.claude/skills/skill-creator
all/.claude/.credentials.json
all/.claude/.last-cleanup
all/.claude/.last-update-result.json
all/.claude/backups/
all/.claude/cache/
all/.claude/file-history/
all/.claude/history.jsonl
all/.claude/mcp-needs-auth-cache.json
all/.claude/paste-cache/
all/.claude/plans/
all/.claude/plugins/
all/.claude/projects/
all/.claude/session-env/
all/.claude/sessions/
all/.claude/shell-snapshots/
.claude/plans/

# npm runtime cache/state
all/.npm/_cacache/
all/.npm/_logs/
all/.npm/_prebuilds/
all/.npm/_update-notifier-last-checked

# Hermes runtime state
all/.hermes/channel_directory.json
all/.hermes/cron/

# Guix live profile symlink — machine-specific, points into /var/guix/
all/.config/guix/current

# TPM runtime plugins — installed by tmux-bootstrap, not repo-managed
all/.config/tmux/plugins/

# OpenCode Telegram Bot config — contains bot token and user credentials
.config/opencode-telegram-bot/

# Telegram agents state (runtime logs)
.local/state/telegram-agents/

# Stow artifacts — identical copies created when stow target is /
home/

# helmstow operation backups
*.bak-helmstow-*

# APT keyring and sources files — should live in /usr/share/keyrings and /etc/apt, never in repo
*.gpg
*.sources

# Logseq config is private mutable app state; HelmCortex/NEXUS/stow owns it.
all/.config/Logseq/

# NFS runtime files — generated from nfs.env, contain real IPs, never commit
**/nfs/hosts-nfs*.conf
**/nfs/nfs.env
