#!/data/data/com.termux/files/usr/bin/bash
# Detached S24 WAV player with truthful receipts

# SSH success means the complete WAV was received and a detached child was
# launched. The child alone emits player-start and player-exit receipts while
# holding the same persistent queue lock as termux-kitten-say.


# [[file:../../../package-termux.org::*Detached S24 WAV player with truthful receipts][Detached S24 WAV player with truthful receipts:1]]
set -euo pipefail
[ "$#" -eq 2 ] || exit 2
SPEAKER="$1"; PLAYBACK="$2"
# Validate the identity before accepting any audio.
command -v pvox-speech-receipt >/dev/null 2>&1 || exit 2
F="$(mktemp "${TMPDIR:-/tmp}/pvox-reply-XXXXXX.wav")" || exit 1
if ! cat > "$F" || [ ! -s "$F" ]; then rm -f "$F"; exit 1; fi
pvox-speech-receipt queued "$SPEAKER" "$PLAYBACK" || { rm -f "$F"; exit 2; }
nohup bash -c '
  F="$1"; SPEAKER="$2"; PLAYBACK="$3"
  cleanup() {
    pvox-speech-receipt player_exited "$SPEAKER" "$PLAYBACK" >/dev/null 2>&1 || true
    command -v termux-wake-unlock >/dev/null 2>&1 && termux-wake-unlock >/dev/null 2>&1 || true
    rm -f "$F"
  }
  trap cleanup EXIT
  command -v termux-wake-lock >/dev/null 2>&1 && termux-wake-lock >/dev/null 2>&1 || true
  exec 9>"$HOME/.pvox-reply-play.lock"
  flock -w 120 9 || exit 0
  pvox-speech-receipt player_started "$SPEAKER" "$PLAYBACK" >/dev/null 2>&1 || true
  if command -v sox >/dev/null 2>&1; then sox -q "$F" -d
  else exit 9; fi
' _ "$F" "$SPEAKER" "$PLAYBACK" </dev/null >/dev/null 2>&1 &
# Detached S24 WAV player with truthful receipts:1 ends here
