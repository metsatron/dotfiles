#!/data/data/com.termux/files/usr/bin/bash
# Android kill-vector check (Q5 requirement)
# Android will kill long-running relays unless defused: the phantom process killer, battery optimization, and Doze. None of these are scriptable from inside unrooted Termux — the phantom killer needs =adb shell settings put global settings_enable_monitor_phantom_procs false= from a trusted PC, and the battery exemption is a Settings-app toggle. This check REPORTS the state honestly so a silent future kill is never a mystery.


# [[file:../../../package-termux.org::*Android kill-vector check (Q5 requirement)][Android kill-vector check (Q5 requirement):1]]
# ~/DotCortex/termux/.local/bin/termux-defuse-check
set -euo pipefail

echo "== android kill-vector check =="
if command -v settings >/dev/null 2>&1; then
  v="$(settings get global settings_enable_monitor_phantom_procs 2>/dev/null || echo unreadable)"
  echo "phantom process killer: $v (want: false — set via adb from a PC)"
else
  echo "phantom process killer: unreadable from Termux — verify via adb: settings get global settings_enable_monitor_phantom_procs"
fi
if command -v termux-battery-status >/dev/null 2>&1; then
  termux-battery-status 2>/dev/null | head -5 || true
fi
echo "battery optimization: confirm Termux is set to Unrestricted in Settings > Apps > Termux > Battery"
echo "wake lock: termux-wake-lock while a relay runs; termux-wake-unlock to release"
# Android kill-vector check (Q5 requirement):1 ends here
