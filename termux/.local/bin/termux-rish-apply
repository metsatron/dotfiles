#!/data/data/com.termux/files/usr/bin/bash
# Shizuku rish lane + phantom-killer defusal
# Shizuku (started by Mètsàtron at every boot, alongside the tailnet) exposes ADB-shell power to authorized apps; =rish= is its shell client. Prerequisites, each bitten live 2026-08-17: the Shizuku SERVICE must be running (the app's front card says so), Shizuku must be battery-Unrestricted (else the binder freezes and every rish call times out), and Termux must be authorized in Shizuku (the approval dialog fires on first use). The rish files come from the Shizuku app's "Use Shizuku in terminal apps" export to shared storage; the apply below installs them properly: dex beside the script in app-private storage with the write bit removed (Android 14+ refuses writable dex — and shared storage cannot drop the write bit, which is why the export must be COPIED in, never run in place), =PKG= patched to =com.termux=, and a PATH wrapper that execs the real script so =dirname $0= still finds the dex.


# [[file:../../../package-termux.org::*Shizuku rish lane + phantom-killer defusal][Shizuku rish lane + phantom-killer defusal:1]]
# ~/DotCortex/termux/.local/bin/termux-rish-apply
set -euo pipefail

echo "== termux rish apply =="
SRC="$HOME/storage/shared/rish"
DST="$HOME/.local/share/rish"

if [ ! -f "$DST/rish_shizuku.dex" ] && [ ! -f "$SRC/rish_shizuku.dex" ]; then
  echo "!! no rish export found at $SRC — in Shizuku: Use Shizuku in terminal apps > Export files (needs termux-setup-storage granted)"
  exit 1
fi

mkdir -p "$DST"
if [ -f "$SRC/rish_shizuku.dex" ]; then
  cp "$SRC/rish_shizuku.dex" "$DST/"
  sed 's/"PKG"/"com.termux"/' "$SRC/rish" > "$DST/rish"
fi
chmod 700 "$DST/rish"
chmod 400 "$DST/rish_shizuku.dex"
printf '%s\n' '#!/data/data/com.termux/files/usr/bin/sh' 'exec $HOME/.local/share/rish/rish "$@"' > "$HOME/.local/bin/rish.real"
mv "$HOME/.local/bin/rish.real" "$HOME/.local/bin/rish"
chmod 700 "$HOME/.local/bin/rish"

if rish -c id 2>/dev/null | grep -q uid=; then
  echo "rish OK: $(rish -c id 2>/dev/null | cut -d" " -f1)"
else
  echo "!! rish installed but Shizuku not answering — check: service running, battery Unrestricted, Termux authorized"
  exit 1
fi
# Shizuku rish lane + phantom-killer defusal:1 ends here
