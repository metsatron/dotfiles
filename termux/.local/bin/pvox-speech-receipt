#!/data/data/com.termux/files/usr/bin/bash
# Phone-local playback receipts for the read-only StarFox HUD

# The caller supplies a generated opaque ID and a known speaker slug. This
# helper appends only lifecycle metadata, never voice text or audio. The fleet
# observes the phone-local journal by read-only SSH pull; no phone credential
# or inbound HTTP endpoint is needed.


# [[file:../../../package-termux.org::*Phone-local playback receipts for the read-only StarFox HUD][Phone-local playback receipts for the read-only StarFox HUD:1]]
set -euo pipefail
[ "$#" -eq 3 ] || exit 2
KIND="$1"; SPEAKER="$2"; PLAYBACK="$3"
case "$KIND" in queued|player_started|player_exited) ;; *) exit 2 ;; esac
case "$SPEAKER" in
  helmastra|helmductor|auryn|fable|claudeificus|haiku|orcinus-orca|ecco-dolphinus|hermes-agent|gemma|pclip) ;;
  *) exit 2 ;;
esac
case "$PLAYBACK" in ""|*[!A-Za-z0-9_-]*) exit 2 ;; esac
[ "${#PLAYBACK}" -le 96 ] || exit 2
umask 077
RECEIPT_DIR="${PVOX_RECEIPT_DIR:-$HOME/.cache}"
mkdir -p "$RECEIPT_DIR"
JOURNAL="$RECEIPT_DIR/pvox-speech-events.jsonl"
[ ! -L "$JOURNAL" ] || exit 1
printf '{"kind":"%s","agent":"%s","playback_id":"%s","recorded_at":%s}\n' \
  "$KIND" "$SPEAKER" "$PLAYBACK" "$(date +%s)" >> "$JOURNAL"
# Phone-local playback receipts for the read-only StarFox HUD:1 ends here
