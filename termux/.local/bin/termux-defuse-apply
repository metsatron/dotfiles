#!/data/data/com.termux/files/usr/bin/bash


# The defusal itself, ruled 2026-08-17 (Android had eaten sshd twice in one night): sync-disable set to =persistent= first so Google's config push cannot re-arm the killer, then the phantom-process ceiling maxed, then the monitor switched off. =device_config= values can still reset on reboot on some builds — re-run this after OS updates and verify with =termux-defuse-check= after any reboot.


# [[file:../../../package-termux.org::*Shizuku rish lane + phantom-killer defusal][Shizuku rish lane + phantom-killer defusal:2]]
# ~/DotCortex/termux/.local/bin/termux-defuse-apply
set -euo pipefail

echo "== android phantom-killer defusal =="
rish -c id 2>/dev/null | grep -q uid= || { echo "!! rish/Shizuku not answering — run termux-rish-apply first"; exit 1; }

rish -c 'device_config set_sync_disabled_for_tests persistent'
rish -c 'device_config put activity_manager max_phantom_processes 2147483647'
rish -c 'settings put global settings_enable_monitor_phantom_procs false'

v="$(rish -c 'settings get global settings_enable_monitor_phantom_procs')"
p="$(rish -c 'device_config get activity_manager max_phantom_processes')"
echo "monitor_phantom_procs: $v (want false)"
echo "max_phantom_processes: $p (want 2147483647)"
[ "$v" = "false" ] && [ "$p" = "2147483647" ] && echo "DEFUSED" || { echo "!! defusal incomplete"; exit 1; }
# Shizuku rish lane + phantom-killer defusal:2 ends here
