#!/data/data/com.termux/files/usr/bin/bash
# Debian enclave (Q2 verdict: BRIDGE-NEEDED)
# Claude Code and other glibc-native agents cannot run on Bionic; the ruled architecture is Termux as host/control plane plus ONE Debian ARM64 proot-distro enclave as the compatibility bridge. This bootstraps the enclave to the door of =claude= — the login into Anthropic is Mètsàtron's interactive step, never scripted. proot is a ptrace translator, not a container: no PID/network isolation, no systemd inside; supervision stays Termux-side (runit/tmux).


# [[file:../../../package-termux.org::*Debian enclave (Q2 verdict: BRIDGE-NEEDED)][Debian enclave (Q2 verdict: BRIDGE-NEEDED):1]]
# ~/DotCortex/termux/.local/bin/termux-enclave-apply
set -euo pipefail

echo "== termux enclave apply (debian proot) =="
command -v proot-distro >/dev/null || { echo "!! proot-distro missing — run termux-pkg-apply"; exit 1; }

proot-distro list 2>/dev/null | grep -q 'debian.*installed' || proot-distro install debian

proot-distro login debian -- bash -lc '
  set -e
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -qq
  apt-get install -y -qq curl git ca-certificates
  command -v node >/dev/null || {
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash -
    apt-get install -y -qq nodejs
  }
  command -v claude >/dev/null || npm install -g @anthropic-ai/claude-code
  echo "enclave ready: node $(node --version), claude $(claude --version 2>/dev/null || echo "installed — run claude login interactively")"
'
# Debian enclave (Q2 verdict: BRIDGE-NEEDED):1 ends here
