#!/data/data/com.termux/files/usr/bin/python3
"""Forward signed 16-bit PCM and announce the first audible sample."""

import os
import subprocess
import sys


def main():
    speaker = os.environ.get("PVOX_SPEAKER_ID")
    playback = os.environ.get("PVOX_PLAYBACK_ID")
    started = False
    # read1 returns the first available chunk; read(4096) could wait for a
    # full buffer and add visible latency to short streamed sentences.
    while chunk := sys.stdin.buffer.read1(4096):
        if not started and len(chunk) >= 2:
            # PCM is little-endian, but zero is zero in either byte order.
            # Ignore digital silence; do not delay or alter the audio stream.
            for offset in range(0, len(chunk) - 1, 2):
                if chunk[offset] or chunk[offset + 1]:
                    started = True
                    if speaker and playback:
                        try:
                            subprocess.run(
                                ["pvox-speech-receipt", "player_started", speaker, playback],
                                check=False,
                                stdout=subprocess.DEVNULL,
                                stderr=subprocess.DEVNULL,
                            )
                        except OSError:
                            pass
                    break
        sys.stdout.buffer.write(chunk)
        sys.stdout.buffer.flush()


if __name__ == "__main__":
    main()
